edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Card.obend as Card
import ./Relation.obend as Relations
import ./Text.obend as Text
# The root menu's data and its rendering (docs/MENU.md): the directory's doors, what changed at
# each, where each reader last went, and the trie they render to. Pure; the Directory keeps the
# rows and the subscriptions that feed them.
# A spell a door offers, as the menu prints it: `example`, typed back whole in the host's
# inline grammar (`delvetalk tide subscribe / every: 3 / note: first light`), and `comes`, the
# owner's words for what comes back ("" for none; never the model's).
record Example:
  example: String
  comes: String
type Examples = Lists.List<Example>
# A door: its word, its object (nobody for a link door, whose description is its line), the
# spells the menu prints under it, and `watch`, the field of its object whose changes the menu
# counts (`children`, `ticks`, `proposals`, `held`, `presence`; "" for none). A door whose object
# is a card under another door's (`garden/bell/1`) is an arc: the menu prints its spells under
# that door, until the owner removes it.
record Door:
  label: String
  description: String
  to: Plans.Reference
  examples: Examples
  watch: String
# What a door's object holds now, as its subscription last reported it: the count of the
# watched field's rows (a tick count for `ticks`), the newest row's name ("" for none) and the
# clock of that change. Keyed {card}, one row a watched door.
record News:
  card: String
  count: Nat
  newest: String
  at: Nat
# The door a principal's reply last went through, keyed {principal}.
record Visit:
  principal: String
  door: String
  at: Nat
def newsKey(news: News) -> {card: String}:
  {card: news.card}
def visitKey(visit: Visit) -> {principal: String}:
  {principal: visit.principal}
# The receiver for a watched field's rows ("" for a field the menu does not count).
def receiverOf(field: String) -> String:
  if field == "children" then "changedChildren" else if field == "ticks" then "changedNat" else if field == "proposals" then "changedProposals" else if field == "held" then "changedHeld" else if field == "presence" then "changedPresence" else ""
# The count as the door line says it.
def counted(field: String, count: Nat) -> String:
  if field == "ticks" then "tick {natText(count)}" else if field == "children" then "{natText(count)} planted" else if field == "proposals" then "{natText(count)} lines" else if field == "held" then "{natText(count)} held" else if field == "presence" then "{natText(count)} here" else natText(count)
def newestOf(names: Lists.List<String>) -> String:
  Lists.fold(names, "", fn(name: String) -> String -> String: fn(later: String) -> String: if later == "" then name else later)
# "Six doors.": the count in words to twelve, as the voice writes it (docs/VOICE.md).
def doorCount(n: Nat) -> String:
  if n == 1n then "One door" else "{countWord(n)} doors"
def countWord(n: Nat) -> String:
  match Lists.at(Text.words("No One Two Three Four Five Six Seven Eight Nine Ten Eleven Twelve"), n):
    case some(w): w.value
    case none(_): natText(n)
# The menu as a trie (docs/MENU.md section 1): per door, `DOOR · <count>`, then each spell
# indented, typed back whole, and `» <what comes back>`, then its arcs' spells. `first` names
# the door that leads ("" for place order); the head and the tail are said once, and the
# branches get what they leave of the clip (a clipped reader sees whole branches). `all` is
# every door in place order.
def trie(all: Lists.List<Door>, news: Relations.Relation<News>, context: Abi.Context, first: String) -> Document.Document:
  let top = firstOf(Lists.filter(all, fn(d: Door) -> Bool: isArc(all, d) == false), first)
  framed(trieHead(Lists.length(top)), Lists.map(top, fn(d: Door) -> Document.Document: branch(d, all, news, context)), trieTail())
# The trie pruned to some doors under another head, and no tail: a second miss's card.
def pruned(head: String, doors: Lists.List<Door>, all: Lists.List<Door>, news: Relations.Relation<News>, context: Abi.Context) -> Document.Document:
  framed("{head}\n", Lists.map(doors, fn(d: Door) -> Document.Document: branch(d, all, news, context)), "")
def trieHead(count: Nat) -> String:
  "✾ DELVETALK · ROOT\n\n{doorCount(count)}. Indented lines are typed back whole; » is what comes back. Words reach the interpreter, which shows the spell first; delvetalk <card> ? lists its spells.\n\n"
def trieTail() -> String:
  "\n  delvetalk env observe\n  » what addressed you since you last looked\nEvery reply is a receipt, admitted or refused <clause>: <reading>. No reply: ask for the receipt; never repost.\n"
def framed(head: String, branches: Document.Documents, tail: String) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text(head), tail: Lists.append(Card.clippedWithin(branches, 64n, Card.left(textLength(head) + textLength(tail))), Document.text(tail))})})
def firstOf(top: Lists.List<Door>, first: String) -> Lists.List<Door>:
  match Lists.find(top, fn(d: Door) -> Bool: first != "" && d.label == first):
    case some(d): Lists.List.cons({head: d.value, tail: Lists.filter(top, fn(o: Door) -> Bool: o.label != first)})
    case none(_): top
# An arc: a door whose object is a card under another door's object.
def arcOf(parent: Door, door: Door) -> Bool:
  Plans.isNobody(parent.to) == false && Text.starts(door.to.object, "{parent.to.object}/")
def isArc(all: Lists.List<Door>, door: Door) -> Bool:
  Lists.any(all, fn(p: Door) -> Bool: arcOf(p, door))
def branch(door: Door, all: Lists.List<Door>, news: Relations.Relation<News>, context: Abi.Context) -> Document.Document:
  let arcs = textJoin(Lists.map(Lists.filter(all, fn(a: Door) -> Bool: arcOf(door, a)), fn(a: Door) -> String: spellLines(a.examples)), "")
  Document.text("{door.label}{countLine(door, news, context)}\n{spellLines(door.examples)}{arcs}")
def spellLines(examples: Examples) -> String:
  textJoin(Lists.map(examples, fn(e: Example) -> String: if e.comes == "" then "  {e.example}\n" else "  {e.example}\n  » {e.comes}\n"), "")
# The door line's live part: a watched door's count, with its newest row's name for a day
# (1,440 clock minutes) after it came; a link door's description.
def countLine(door: Door, news: Relations.Relation<News>, context: Abi.Context) -> String:
  if Plans.isNobody(door.to) then linkLine(door) else newsLine(door, Relations.lookup(news, {card: door.to.object}, newsKey), context)
def linkLine(door: Door) -> String:
  if door.description == "" then "" else " · {door.description}"
def newsLine(door: Door, found: Lists.Maybe<News>, context: Abi.Context) -> String:
  match found:
    case none(_): ""
    case some(n): " · {counted(door.watch, n.value.count)}{fresh(n.value, context)}"
def fresh(news: News, context: Abi.Context) -> String:
  if news.newest != "" && context.clock < news.at + 1440n then ", newest {news.newest}" else ""
# Several spells' card: each spell said, with what came of it.
def ran(lines: Examples) -> Document.Document:
  Document.text("✾ DELVETALK · ROOT\n\n{countWord(Lists.length(lines))} spells, in the order said:\n{spellLines(lines)}")
def refusedLine(clause: String, reading: String, object: String) -> String:
  if reading == "" then "refused {clause}: Not done at {object}." else "refused {clause}: {reading}"
