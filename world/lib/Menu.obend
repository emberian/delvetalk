edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Text.obend as Text
# The commonplace's card (docs/MENU.md, docs/METAPHYSICS.md §5, §7.5): what changed in the
# town, newest first, then the doors the hand named, each a trie branch. Pure; the commonplace
# (world/bodies/commonplace.obend) asks the world what changed and keeps the doors as its
# `cites` (Card.Doorway: a door's spells are its `examples`).
type Door = Card.Doorway
# "Six doors.": the count in words to twelve, as the voice writes it (docs/VOICE.md).
def doorCount(n: Nat) -> String:
  if n == 1n then "One door" else "{Text.counted(n)} doors"
# What changed (World.changed), at most eight, each `<id> v<n> by <handle>, entry N`; then the
# first spell, a thing made, and how any card shows its spells, on the newest id.
def changes(items: Lists.List<World.Change>) -> String:
  let shown = Lists.take(items, 8n)
  let listed = if Lists.length(shown) == 0n then "Nothing has changed yet.\n" else "What changed, newest first:\n{textJoin(Lists.map(shown, changeLine), \"\")}"
  "{listed}  delvetalk kinds make / name: lamp / of: record\n  » kind/lamp, a kind anyone makes\n  delvetalk {newestId(shown)} ?\n  » that card and its spells\n"
def newestId(items: Lists.List<World.Change>) -> String:
  match Lists.at(items, 0n):
    case some(c): c.value.object.object
    case none(_): "commonplace"
def changeLine(c: World.Change) -> String:
  "{c.object.object} v{natText(c.version)} by {Card.handle(c.by)}, entry {natText(c.height)}\n"
# The doors as a trie (docs/MENU.md section 1): per door its word, then each spell indented,
# typed back whole, and `» <what comes back>`, then its arcs' spells. `first` names the door
# that leads ("" for the owner's order); the head, what changed and the tail are said once, and
# the branches get what they leave of the card's room (Card.left, the receipt line under it
# counted) (a clipped reader sees whole branches). A link
# door (STUDIO) is never clipped: it is said after the clipped branches, before the tail.
def trie(all: Lists.List<Door>, changed: String, first: String, context: Abi.Context) -> Document.Document:
  trieUnder("", all, changed, first, context)
def trieUnder(line: String, all: Lists.List<Door>, changed: String, first: String, context: Abi.Context) -> Document.Document:
  let top = firstOf(Lists.filter(all, fn(d: Door) -> Bool: isArc(all, d) == false), first)
  let links = textJoin(Lists.map(Lists.filter(top, fn(d: Door) -> Bool: Plans.isNobody(d.to)), fn(d: Door) -> String: Document.plain(branch(d, all))), "")
  let head = if line == "" then trieHead(Lists.length(top)) else "{line}\n{greetedHead(Lists.length(top))}"
  framed("{head}{changed}", Lists.map(Lists.filter(top, fn(d: Door) -> Bool: Plans.isNobody(d.to) == false), fn(d: Door) -> Document.Document: branch(d, all)), "{links}{trieTail()}", context)
# hob's greeting, above the card a principal's first words get (docs/VOICE.md, the surfaces).
def greetingLine() -> String:
  "hob: words reach me, spells reach the cards. The doors:"
# The trie pruned to some doors under another head, and no tail: hob's question's card.
def pruned(head: String, doors: Lists.List<Door>, all: Lists.List<Door>, context: Abi.Context) -> Document.Document:
  framed("{head}\n", Lists.map(doors, fn(d: Door) -> Document.Document: branch(d, all)), "", context)
def title() -> String:
  "✾ DELVETALK · THE COMMONPLACE"
def trieHead(count: Nat) -> String:
  "{title()}\n\n{doorCount(count)}. Indented lines are typed back whole; » is what comes back; words reach hob; its spell runs unless the card asks first.\n"
# Under hob's greeting the head leaves out what hob's line says.
def greetedHead(count: Nat) -> String:
  "{title()}\n\n{doorCount(count)}. Indented lines are typed back whole; » is what comes back.\n"
def trieTail() -> String:
  "\n  delvetalk env observe\n  » what addressed you since you looked\nEvery reply is a receipt: admitted, or refused <clause>: <reading>. No reply: ask for it; never repost.\n"
# The card for words that named nothing.
def nothingHead() -> String:
  "{title()}\n\nI heard no door, spell or field in that.\n"
def framed(head: String, branches: Document.Documents, tail: String, context: Abi.Context) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text(head), tail: Lists.append(Card.clippedWithin(branches, 64n, Card.left(context, textLength(head) + textLength(tail))), Document.text(tail))})})
def firstOf(top: Lists.List<Door>, first: String) -> Lists.List<Door>:
  match Lists.find(top, fn(d: Door) -> Bool: first != "" && d.label == first):
    case some(d): Lists.List.cons({head: d.value, tail: Lists.filter(top, fn(o: Door) -> Bool: o.label != first)})
    case none(_): top
# An arc: a door whose object is a card under another door's object.
def arcOf(parent: Door, door: Door) -> Bool:
  Plans.isNobody(parent.to) == false && Text.starts(door.to.object, "{parent.to.object}/")
def isArc(all: Lists.List<Door>, door: Door) -> Bool:
  Lists.any(all, fn(p: Door) -> Bool: arcOf(p, door))
def branch(door: Door, all: Lists.List<Door>) -> Document.Document:
  let arcs = textJoin(Lists.map(Lists.filter(all, fn(a: Door) -> Bool: arcOf(door, a)), fn(a: Door) -> String: spellLines(a.examples)), "")
  Document.text("{door.label}{linkLine(door)}\n{spellLines(door.examples)}{arcs}")
def spellLines(examples: Card.Examples) -> String:
  textJoin(Lists.map(examples, fn(e: Card.Example) -> String: if e.comes == "" then "  {e.example}\n" else "  {e.example}\n  » {e.comes}\n"), "")
def linkLine(door: Door) -> String:
  if door.description == "" then "" else " · {door.description}"
# Several spells' card: each spell said, with what came of it.
def ran(lines: Card.Examples) -> Document.Document:
  Document.text("{title()}\n\n{Text.counted(Lists.length(lines))} spells, in the order said:\n{spellLines(lines)}")
def refusedLine(clause: String, reading: String, object: String) -> String:
  if reading == "" then "refused {clause}: Not done at {object}." else "refused {clause}: {reading}"
