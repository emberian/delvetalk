edition ObjectiveBend 1
import ./List.obend as Lists
# What a card's receive is handed of a spell: the host parses a reply, fits it to the card's
# forms and runs the method (spec/Delvetalk/Host/Spell.lean, op `spell-parse`; FOUNDATION
# section 5 has the grammar). What runs no method reaches `receive` with the reply's
# `name: value` lines as bindings and the spell the host read (`Card.Cast`: the card and action
# as written when it lacked fields, both "" for prose). Bend reads no spell itself.
record Binding:
  name: String
  value: String
type Bindings = Lists.List<Binding>
# A field's value by name, "" when absent.
def valueOf(bindings: Bindings, name: String) -> String:
  match bindings:
    case nil(_): ""
    case cons(c): if c.head.name == name then c.head.value else valueOf(c.tail, name)
