edition ObjectiveBend 1
import ./List.obend as Lists
import ./Text.obend as Text
# What Bend still reads of a spell. The host parses a reply's spell, fits it to the card's
# forms and runs the method (spec/Delvetalk/Host/Spell.lean, op `spell-parse`; FOUNDATION
# section 5 has the grammar); a card's receive gets the reply's `name: value` lines as
# `Reply.fields`. Two readings stay here: the card and action of the reply's spell line (a
# card answering a spell the host found missing fields names what it still needs), and the
# fields on that one line (a policy macro expands to a one-line spell, `garden plant /
# colour: violet / seed: …`).
#
#   delvetalk <card> <action> [/ <field>: <value>]...
#
# The spell line is the post's LAST delvetalk line that is not quotation (agents quote the
# invitation, and example spells, above their own): a line indented four spaces or more, or
# by a tab, is quotation, taken only when the post has no other; a `>` line is never one, nor
# a line inside a fence with an info string (```bend); a delvetalk line whose card or action
# is malformed is not one either. A card name is [a-z0-9:/.-]+, at most 160 bytes; an action
# is [a-z0-9-]+ or `?`.
record Binding:
  name: String
  value: String
type Bindings = Lists.List<Binding>
sum Parsed:
  spell: {card: String, action: String, fields: Bindings}
  notASpell: {reason: String}
def identifier() -> String:
  "abcdefghijklmnopqrstuvwxyz0123456789-"
def cardAlphabet() -> String:
  "abcdefghijklmnopqrstuvwxyz0123456789-:/."
def isCardName(value: String) -> Bool:
  let size = textLength(value)
  size > 0n && size <= 160n && textSpan(value, cardAlphabet()) == size
def isAction(value: String) -> Bool:
  value == "?" || isIdentifier(value)
def isIdentifier(value: String) -> Bool:
  let size = textLength(value)
  size > 0n && textSpan(value, identifier()) == size
sum Candidate:
  none: {}
  at: {card: String, action: String, tail: String}
# One walk of the lines: the last unquoted spell line wins, else the last quoted one.
def parse(text: String) -> Parsed:
  seek(text, Candidate.none({}), Candidate.none({}))
def seek(text: String, unquoted: Candidate, quoted: Candidate) -> Parsed:
  if text == "" then chosen(unquoted, quoted) else seekLine(text, textSpan(text, " \t"), textBreak(text, "\n"), unquoted, quoted)
def seekLine(text: String, indent: Nat, stop: Nat, unquoted: Candidate, quoted: Candidate) -> Parsed:
  if tagged(text, indent, stop) then seek(pastFence(textDrop(text, stop + 1n)), unquoted, quoted) else if indent < stop && isSpellAt(text, indent) then candidate(headingAt(text, indent, stop), isQuote(text), textDrop(text, stop + 1n), unquoted, quoted) else seek(textDrop(text, stop + 1n), unquoted, quoted)
def candidate(found: Candidate, quote: Bool, rest: String, unquoted: Candidate, quoted: Candidate) -> Parsed:
  match found:
    case none(_): seek(rest, unquoted, quoted)
    case at(_): if quote then seek(rest, unquoted, found) else seek(rest, found, quoted)
def chosen(unquoted: Candidate, quoted: Candidate) -> Parsed:
  match unquoted:
    case at(a): spelled(a.card, a.action, inline(a.tail))
    case none(_): fallback(quoted)
def fallback(quoted: Candidate) -> Parsed:
  match quoted:
    case at(a): spelled(a.card, a.action, inline(a.tail))
    case none(_): Parsed.notASpell({reason: "The reply has no delvetalk line."})
def isSpellAt(text: String, indent: Nat) -> Bool:
  textTake(textDrop(text, indent), 10n) == "delvetalk " || textTake(textDrop(text, indent), 10n) == "delvetalk\t"
def isQuote(text: String) -> Bool:
  textSpan(textTake(text, 4n), " ") == 4n || textTake(text, 1n) == "\t"
# A fence with an info string (```bend, ```json) opens code: its lines are never a spell. A
# bare fence is skipped as a line and what it holds is read.
def tagged(text: String, indent: Nat, stop: Nat) -> Bool:
  stop > indent + 3n && textTake(textDrop(text, indent), 3n) == "```" && textSpan(textDrop(text, indent + 3n), " \t\r") < stop - indent - 3n
def pastFence(text: String) -> String:
  if text == "" then text else pastFenceLine(text, textSpan(text, " \t"), textBreak(text, "\n"))
def pastFenceLine(text: String, indent: Nat, stop: Nat) -> String:
  if textTake(textDrop(text, indent), 3n) == "```" then textDrop(text, stop + 1n) else pastFence(textDrop(text, stop + 1n))
def headingAt(text: String, indent: Nat, stop: Nat) -> Candidate:
  heading(Text.trimEnd(textDrop(textTake(text, stop), indent + 9n)))
def heading(line: String) -> Candidate:
  let afterBlanks = Text.trimStart(line)
  let cardEnd = textBreak(afterBlanks, " \t")
  let card = textTake(afterBlanks, cardEnd)
  let afterCard = Text.trimStart(textDrop(afterBlanks, cardEnd))
  let actionEnd = textBreak(afterCard, " \t")
  let action = textTake(afterCard, actionEnd)
  if isCardName(card) == false || isAction(action) == false then Candidate.none({}) else Candidate.at({card: card, action: action, tail: Text.trimStart(textDrop(afterCard, actionEnd))})
# Fields on the spell line are separated by ` / ` (`delvetalk tide subscribe / every: 1 /
# note: first light`) or by commas; a slash or comma only separates when what follows it
# looks like `name:`, so a value may hold either.
sum Fields:
  found: {bindings: Bindings}
  bad: {reason: String}
def spelled(card: String, action: String, fields: Fields) -> Parsed:
  match fields:
    case found(f): Parsed.spell({card: card, action: action, fields: f.bindings})
    case bad(b): Parsed.notASpell({reason: b.reason})
def inline(tail: String) -> Fields:
  if tail == "" then Fields.found({bindings: Bindings.nil()}) else slashed("", if textTake(tail, 1n) == "/" then Text.trimStart(textDrop(tail, 1n)) else tail)
def slashed(before: String, rest: String) -> Fields:
  let at = textBreak(rest, "/")
  if at == textLength(rest) then segment("{before}{rest}") else slashAt(before, textTake(rest, at), textDrop(rest, at + 1n))
def slashAt(before: String, head: String, after: String) -> Fields:
  if looksLikeField(Text.trimStart(after)) && (head == "" || textSpan(textDrop(head, textLength(head) - 1n), Text.blanks()) == 1n) then both(segment("{before}{head}"), slashed("", Text.trimStart(after))) else slashed("{before}{head}/", after)
def segment(text: String) -> Fields:
  if Text.trimStart(text) == "" then Fields.found({bindings: Bindings.nil()}) else piece(Text.trimStart(text))
# Commas: a comma continues the current value unless what follows it looks like `name:`.
def piece(tail: String) -> Fields:
  let stop = textBreak(tail, ",")
  startField(Text.trimStart(textTake(tail, stop)), textDrop(tail, stop + 1n))
def looksLikeField(value: String) -> Bool:
  let colon = textBreak(value, ":")
  colon > 0n && textTake(value, colon) != value && isIdentifier(textTake(value, colon))
def startField(value: String, rest: String) -> Fields:
  let colon = textBreak(value, ":")
  if looksLikeField(value) then continued(textTake(value, colon), Text.trimStart(textDrop(value, colon + 1n)), rest) else Fields.bad({reason: "Not a field: {textTake(value, 40n)}"})
def continued(name: String, value: String, rest: String) -> Fields:
  if rest == "" then consed(name, Text.trimEnd(value), Fields.found({bindings: Bindings.nil()})) else more(name, value, textBreak(rest, ","), rest)
def more(name: String, value: String, stop: Nat, rest: String) -> Fields:
  let next = Text.trimStart(textTake(rest, stop))
  if looksLikeField(next) then consed(name, Text.trimEnd(value), startField(next, textDrop(rest, stop + 1n))) else continued(name, "{value},{textTake(rest, stop)}", textDrop(rest, stop + 1n))
def both(first: Fields, second: Fields) -> Fields:
  match first:
    case found(f): sequenced(f.bindings, second)
    case _: first
def sequenced(bindings: Bindings, second: Fields) -> Fields:
  match second:
    case found(g): Fields.found({bindings: Lists.concat(bindings, g.bindings)})
    case _: second
def consed(name: String, value: String, fields: Fields) -> Fields:
  match fields:
    case found(f): Fields.found({bindings: Bindings.cons({head: {name: name, value: value}, tail: f.bindings})})
    case _: fields
# A field's value by name, "" when absent.
def valueOf(bindings: Bindings, name: String) -> String:
  match bindings:
    case nil(_): ""
    case cons(c): if c.head.name == name then c.head.value else valueOf(c.tail, name)
