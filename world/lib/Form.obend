edition ObjectiveBend 1
import ./List.obend as Lists
# The form a card offers, as data: the fields a spell must supply and their kinds.
# Spell checks replies against it; Plan carries it to the interpreter.
type Names = Lists.List<String>
sum Kind:
  text: {min: Nat, max: Nat}
  natural: {min: Nat, max: Nat}
  choice: {options: Names}
record Field:
  name: String
  kind: Kind
type Fields = Lists.List<Field>
record Form:
  card: String
  action: String
  fields: Fields
# A field's value, typed by its Kind (what `set` receives for a lens).
sum Value:
  text: {value: String}
  natural: {value: Nat}
  choice: {value: String}
# A lens is one exposed scalar field of an object's State and the kind of value it takes: an
# object's `lenses()` lists them as Fields, the host answers `delvetalk <card> set` with one
# `<field>: <value>` line by judging the value against the kind and running the object's
# `set {field, value}`, and `?` lists them.
