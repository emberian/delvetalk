edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
# The data every object's writes and references are made of (docs/FOUNDATION.md section 3).
# An activity asks the world through World.obend's protocol; this module gives what those
# messages carry: references, per-field edits and receipts.
#
# A write is a record of per-field edits, never a whole state: the host judges each field
# against the law. An object's `Edits` has one field per state field, each an Edit<T, D>
# (scalars) or Entries<D, U> (lists and relations); `write {field: op value, ...}` builds a
# self-write from them, and the type arguments of keep and append are inferred from the
# field's declared type (`Plans.Edit.keep({})` in a keep() record).
#
# Payloads are Data. What a call, send or create carries (an argument, a message, a child's
# seed) is the value itself where Data is expected (the compiler injects it): first-order
# data that Bend never takes apart and the host checks against the callee's input or the
# child's state. The host's create lays a seed (a record of some of the State's fields) over
# the child's initial().
#
# Effects are never in a closure: fan-out is explicit recursion in the activity. An activity
# composes only in tail position, so a method another activity reuses takes its finish as a
# pure function `then: Result -> T`.
#
# Writes are staged. A self-write is answered `written`; whether the law admits it is decided
# once, at commit, and a refusal there ends the whole turn. List fields are edited one item at
# a time, by its bytes, so the host judges one item.
record Reference:
  world: String
  object: String
sum Edit<T, D>:
  keep: {}
  set: {value: T}
  add: {delta: D}
# A list-valued field: append an item; amendItem replaces, and removeItem removes, the
# first item whose canonical bytes equal `item` (refused absentItem when none does; the
# host stores `change` as the item, so U is the item type). A write of only keep, add and
# append commits even if its object moved since the turn read it.
# A relation field (Relation.obend, declared in the object's `relations()`) is edited by
# key (docs/RELATIONAL.md section 3): insert adds a row whose key is absent (the same row
# again changes nothing; another row of that key is refused keyTaken), upsert adds or
# replaces the row of its key, retract removes the row whose key projection, a record of
# the key columns, is `key` (none: no change). An insert commits against a moved root; an
# upsert or retract does when no admitted write since touched its key.
sum Entries<D, U>:
  keep: {}
  append: {item: D}
  amendItem: {item: D, change: U}
  removeItem: {item: D}
  insert: {row: D}
  upsert: {row: D}
  retract: {key: Data}
# The identity of a turn, (principal, intent): what an await names.
record Slot:
  principal: String
  intent: String
sum Outcome:
  admitted: {}
  refused: {class: String, root: String}
record Receipt:
  slot: Slot
  height: Nat
  outcome: Outcome
# The empty payload, for a method that takes no input.
def nothing() -> Data:
  {}
# The reference of the running object, in the world the context carries (the empty world is
# the world the turn runs in).
def self(context: Abi.Context) -> Reference:
  {world: context.world, object: context.object}
# References compare by world and object. The empty reference (object "") names
# nothing: a thing nobody holds has the empty reference as its holder.
def nobody() -> Reference:
  {world: "", object: ""}
def same(left: Reference, right: Reference) -> Bool:
  left.world == right.world && left.object == right.object
def isNobody(reference: Reference) -> Bool:
  reference.object == ""
# The index of a reference in a list, by world and object; none when absent.
def indexOf(items: Lists.List<Reference>, target: Reference) -> Lists.Maybe<Nat>:
  Lists.indexWhere(items, fn(item: Reference) -> Bool: same(item, target))
