edition ObjectiveBend 1
import ./List.obend as Lists
import ./Encounter.obend as Encounter
type Pages = Lists.List<Encounter.Children>
record Offered:
  accepted: Bool
  reason: String
  pages: Pages
def length(pages: Pages) -> Nat:
  match pages:
    case nil(_): 0n
    case cons(p): Encounter.childrenLength(p.head) + length(p.tail)
def pageCount(pages: Pages) -> Nat:
  Lists.length(pages)
def contains(pages: Pages, key: String) -> Bool:
  Lists.any(pages, fn(items: Encounter.Children) -> Bool: Encounter.childrenContains(items, key))
def append(pages: Pages, child: Encounter.Child) -> Pages:
  match pages:
    case nil(_): Pages.cons({head: Encounter.Children.cons({head: child, tail: Encounter.Children.nil()}), tail: Pages.nil()})
    case cons(p):
      match p.tail:
        case nil(_): if Encounter.childrenLength(p.head) < 16n then Pages.cons({head: Encounter.childrenAppend(p.head, child), tail: Pages.nil()}) else Pages.cons({head: p.head, tail: append(Pages.nil(), child)})
        case cons(_): Pages.cons({head: p.head, tail: append(p.tail, child)})
def offer(pages: Pages, child: Encounter.Child, capacity: Nat) -> Offered:
  if contains(pages, child.key) then {accepted: false, reason: "That key is already present.", pages: pages} else if length(pages) >= capacity then {accepted: false, reason: "This collection is full.", pages: pages} else {accepted: true, reason: "", pages: append(pages, child)}
def remove(pages: Pages, key: String) -> Pages:
  match pages:
    case nil(_): Pages.nil()
    case cons(p):
      let items = Encounter.childrenRemove(p.head, key)
      let tail = remove(p.tail, key)
      if Encounter.childrenLength(items) == 0n then tail else Pages.cons({head: items, tail: tail})
def page(pages: Pages, index: Nat) -> Encounter.Children:
  match pages:
    case nil(_): Encounter.Children.nil()
    case cons(p): if index == 0n then p.head else page(p.tail, index - 1n)
