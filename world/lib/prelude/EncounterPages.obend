edition ObjectiveBend 1
import ./Encounter.obend as Encounter
sum Pages:
  nil: {}
  cons: {items: Encounter.Children, tail: Pages}
record Offered:
  accepted: Bool
  reason: String
  pages: Pages
def length(pages: Pages) -> Nat:
  match pages:
    case nil(_): 0n
    case cons(p): Encounter.childrenLength(p.items) + length(p.tail)
def pageCount(pages: Pages) -> Nat:
  match pages:
    case nil(_): 0n
    case cons(p): 1n + pageCount(p.tail)
def contains(pages: Pages, key: String) -> Bool:
  match pages:
    case nil(_): false
    case cons(p): Encounter.childrenContains(p.items, key) || contains(p.tail, key)
def append(pages: Pages, child: Encounter.Child) -> Pages:
  match pages:
    case nil(_): Pages.cons({items: Encounter.Children.cons({head: child, tail: Encounter.Children.nil()}), tail: Pages.nil()})
    case cons(p):
      match p.tail:
        case nil(_): if Encounter.childrenLength(p.items) < 16n then Pages.cons({items: Encounter.childrenAppend(p.items, child), tail: Pages.nil()}) else Pages.cons({items: p.items, tail: append(Pages.nil(), child)})
        case cons(_): Pages.cons({items: p.items, tail: append(p.tail, child)})
def offer(pages: Pages, child: Encounter.Child, capacity: Nat) -> Offered:
  if contains(pages, child.key) then {accepted: false, reason: "That key is already present.", pages: pages} else if length(pages) >= capacity then {accepted: false, reason: "This collection is full.", pages: pages} else {accepted: true, reason: "", pages: append(pages, child)}
def remove(pages: Pages, key: String) -> Pages:
  match pages:
    case nil(_): Pages.nil()
    case cons(p):
      let items = Encounter.childrenRemove(p.items, key)
      let tail = remove(p.tail, key)
      if Encounter.childrenLength(items) == 0n then tail else Pages.cons({items: items, tail: tail})
def page(pages: Pages, index: Nat) -> Encounter.Children:
  match pages:
    case nil(_): Encounter.Children.nil()
    case cons(p): if index == 0n then p.items else page(p.tail, index - 1n)
