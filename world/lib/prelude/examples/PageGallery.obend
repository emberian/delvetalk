edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Encounter.obend as E
import ./EncounterPages.obend as P
record State:
  pages: P.Pages
  current: Nat
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Nat
def offer(state: State, input: E.Child, context: Abi.Context) -> Decision:
  let offered = P.offer(state.pages, input, 200n)
  {accepted: offered.accepted, reason: offered.reason, state: {pages: offered.pages, current: state.current}, result: P.length(offered.pages)}
def remove(state: State, input: {key: String}, context: Abi.Context) -> Decision:
  let pages = P.remove(state.pages, input.key)
  {accepted: true, reason: "", state: {pages: pages, current: if state.current < P.pageCount(pages) then state.current else 0n}, result: P.length(pages)}
def page(state: State, input: {index: Nat}, context: Abi.Context) -> Decision:
  let valid = input.index < P.pageCount(state.pages) || input.index == 0n
  {accepted: valid, reason: if valid then "" else "There is no such page.", state: {pages: state.pages, current: if valid then input.index else state.current}, result: P.pageCount(state.pages)}
record Description:
  name: String
  initial: State
  methods: {offer: {label: String, fields: {key: Abi.StringField, label: Abi.StringField, object: Abi.StringField, panel: Abi.StringField}}, remove: {label: String, fields: {key: Abi.StringField}}, page: {label: String, fields: {index: Abi.NatField}}}
  panels: {}
def describe() -> Description:
  {name: "Page gallery", initial: {pages: P.Pages.nil(), current: 0n}, methods: {offer: {label: "offer an exhibit", fields: {key: {type: "string", minLength: 1, maxLength: 64}, label: {type: "string", minLength: 1, maxLength: 128}, object: {type: "string", minLength: 1, maxLength: 128}, panel: {type: "string", minLength: 1, maxLength: 64}}}, remove: {label: "remove an exhibit", fields: {key: {type: "string", minLength: 1, maxLength: 64}}}, page: {label: "turn to page", fields: {index: {type: "nat", minimum: 0, maximum: 199}}}}, panels: {}}
record Action:
  visible: Bool
  text: String
  command: String
  input: {}
record PageAction:
  visible: Bool
  text: String
  command: String
  input: {index: Nat}
record View:
  title: String
  prose: String
  actions: {offer: Action, remove: Action, previous: PageAction, next: PageAction}
  children: E.Children
def view(state: State, panel: String) -> View:
  {title: "Page gallery", prose: "Sixteen exhibits fit on a page. Offer an exhibit, remove its key, or turn to a numbered page; everyone shares the selected page.", actions: {offer: {visible: P.length(state.pages) < 200n, text: "Offer an exhibit", command: "offer", input: {}}, remove: {visible: P.length(state.pages) > 0n, text: "Remove an exhibit", command: "remove", input: {}}, previous: {visible: state.current > 0n, text: "Previous page", command: "page", input: {index: state.current - 1n}}, next: {visible: state.current + 1n < P.pageCount(state.pages), text: "Next page", command: "page", input: {index: state.current + 1n}}}, children: P.page(state.pages, state.current)}
