edition ObjectiveBend 1
import ./List.obend as Lists
import ./Preparation.obend as P
import ./Document.obend as D
# Definitions are selected exact source tables of captured readable roots.
# The native boundary supplies this fifth preparation argument only on request.
record Request:
  object: String
  package: String
type Requests = Lists.List<Request>
record Module:
  name: String
  source: String
type Modules = Lists.List<Module>
record Definition:
  object: String
  version: Nat
  program: String
  package: String
  modules: Modules
type Definitions = Lists.List<Definition>
sum Lookup:
  missing: {}
  found: {value: Definition}
def lookup(xs: Definitions, object: String, package: String) -> Lookup:
  match xs:
    case nil(_): Lookup.missing()
    case cons(c): if c.head.object == object && c.head.package == package then Lookup.found({value: c.head}) else lookup(c.tail, object, package)
# Read-only source-authored responses carry ordinary logical values. They cannot
# become a turn or acquire authority merely by being shown.
sum Inspection:
  inspection: {message: String, value: P.Value, document: D.Document}
def moduleDocuments(xs: Modules, revision: String) -> D.Documents:
  match xs:
    case nil(_): D.Documents.nil()
    case cons(c): D.Documents.cons({head: D.quote(c.head.name, D.Document.source({language: "ObjectiveBend", code: c.head.source, revision: revision})), tail: moduleDocuments(c.tail, revision)})
def document(definition: Definition) -> D.Document:
  D.quote(definition.object, D.Document.sequence({items: moduleDocuments(definition.modules, natText(definition.version))}))

sum Revision:
  missing: {}
  found: {modules: Modules}
def prepended(module: Module, revision: Revision) -> Revision:
  match revision:
    case missing(_): Revision.missing()
    case found(r): Revision.found({modules: Modules.cons({head: module, tail: r.modules})})
def revisedModules(xs: Modules, name: String, source: String) -> Revision:
  match xs:
    case nil(_): Revision.missing()
    case cons(c): if c.head.name == name then Revision.found({modules: Modules.cons({head: {name: name, source: source}, tail: c.tail})}) else prepended(c.head, revisedModules(c.tail, name, source))
def moduleValues(xs: Modules) -> P.Values:
  match xs:
    case nil(_): P.Values.nil()
    case cons(c): P.Values.cons({head: P.Value.record({fields: P.Fields.cons({head: {name: "name", value: P.Value.text({value: c.head.name})}, tail: P.Fields.cons({head: {name: "source", value: P.Value.text({value: c.head.source})}, tail: P.Fields.nil()})})}), tail: moduleValues(c.tail)})

# Inspect proposed source through the same Document algebra as installed source.
def moduleValueSource(name: String, source: P.TextLookup) -> D.Document:
  match source:
    case missing(_): D.text("The retained module has no source text.")
    case wrongKind(_): D.text("The retained module source is not text.")
    case found(s): D.quote(name, D.Document.source({language: "ObjectiveBend", code: s.value, revision: "proposed"}))
def moduleValueDocument(value: P.Value) -> D.Document:
  match P.textField(value, "name"):
    case missing(_): D.text("The retained module has no name.")
    case wrongKind(_): D.text("The retained module name is not text.")
    case found(n): moduleValueSource(n.value, P.textField(value, "source"))
def moduleValueDocuments(values: P.Values) -> D.Documents:
  match values:
    case nil(_): D.Documents.nil()
    case cons(c): D.Documents.cons({head: moduleValueDocument(c.head), tail: moduleValueDocuments(c.tail)})
def sourceTextDocument(source: P.TextLookup) -> D.Document:
  match source:
    case missing(_): D.text("This proposal retains source references rather than inline source.")
    case wrongKind(_): D.text("The retained source is not text.")
    case found(s): D.Document.source({language: "ObjectiveBend", code: s.value, revision: "proposed"})
def proposalSource(proposal: P.Value) -> D.Document:
  match P.get(proposal, "modules"):
    case array(a): D.Document.sequence({items: moduleValueDocuments(a.values)})
    case none(_): sourceTextDocument(P.textField(proposal, "source"))
    case retained(_): D.text("The proposal modules are retained by reference.")
    case boolean(_): D.text("The retained module table is not an array.")
    case natural(_): D.text("The retained module table is not an array.")
    case number(_): D.text("The retained module table is not an array.")
    case text(_): D.text("The retained module table is not an array.")
    case record(_): D.text("The retained module table is not an array.")
def proposalExamples(examples: P.TextLookup) -> D.Document:
  match examples:
    case missing(_): D.text("This proposal retains its examples by reference.")
    case wrongKind(_): D.text("The retained examples are not text.")
    case found(e): D.Document.source({language: "DelveTalk examples", code: e.value, revision: "proposed"})
def proposalDocument(proposal: P.Value) -> D.Document:
  D.concat(D.quote("Proposed source", proposalSource(proposal)), D.quote("Authored examples", proposalExamples(P.textField(proposal, "scenarios"))))
