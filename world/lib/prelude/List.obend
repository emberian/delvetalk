edition ObjectiveBend 1
sum List<T>:
  nil: {}
  cons: {head: T, tail: List<T>}
def length<T>(items: List<T>) -> Nat:
  match items:
    case nil(_): 0n
    case cons(c): 1n + length::<T>(c.tail)
def append<T>(items: List<T>, value: T) -> List<T>:
  match items:
    case nil(_): List::<T>.cons({head: value, tail: List::<T>.nil()})
    case cons(c): List::<T>.cons({head: c.head, tail: append::<T>(c.tail, value)})
def concat<T>(left: List<T>, right: List<T>) -> List<T>:
  match left:
    case nil(_): right
    case cons(c): List::<T>.cons({head: c.head, tail: concat::<T>(c.tail, right)})
def any<T>(items: List<T>, predicate: T -> Bool) -> Bool:
  match items:
    case nil(_): false
    case cons(c): predicate(c.head) || any::<T>(c.tail, predicate)
def filter<T>(items: List<T>, predicate: T -> Bool) -> List<T>:
  match items:
    case nil(_): List::<T>.nil()
    case cons(c): if predicate(c.head) then List::<T>.cons({head: c.head, tail: filter::<T>(c.tail, predicate)}) else filter::<T>(c.tail, predicate)
def map<T, U>(items: List<T>, transform: T -> U) -> List<U>:
  match items:
    case nil(_): List::<U>.nil()
    case cons(c): List::<U>.cons({head: transform(c.head), tail: map::<T, U>(c.tail, transform)})
def fold<T, U>(items: List<T>, initial: U, combine: T -> U -> U) -> U:
  match items:
    case nil(_): initial
    case cons(c): combine(c.head)(fold::<T, U>(c.tail, initial, combine))
