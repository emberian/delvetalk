edition ObjectiveBend 1
sum List<T>:
  nil: {}
  cons: {head: T, tail: List<T>}
def length<T>(items: List<T>) -> Nat:
  match items:
    case nil(_): 0n
    case cons(c): 1n + length(c.tail)
def append<T>(items: List<T>, value: T) -> List<T>:
  match items:
    case nil(_): List.cons({head: value, tail: List.nil()})
    case cons(c): List.cons({head: c.head, tail: append(c.tail, value)})
def concat<T>(left: List<T>, right: List<T>) -> List<T>:
  match left:
    case nil(_): right
    case cons(c): List.cons({head: c.head, tail: concat(c.tail, right)})
def any<T>(items: List<T>, predicate: T -> Bool) -> Bool:
  match items:
    case nil(_): false
    case cons(c): predicate(c.head) || any(c.tail, predicate)
def filter<T>(items: List<T>, predicate: T -> Bool) -> List<T>:
  match items:
    case nil(_): List.nil()
    case cons(c): if predicate(c.head) then List.cons({head: c.head, tail: filter(c.tail, predicate)}) else filter(c.tail, predicate)
def map<T, U>(items: List<T>, transform: T -> U) -> List<U>:
  match items:
    case nil(_): List.nil()
    case cons(c): List.cons({head: transform(c.head), tail: map(c.tail, transform)})
def fold<T, U>(items: List<T>, initial: U, combine: T -> U -> U) -> U:
  match items:
    case nil(_): initial
    case cons(c): combine(c.head)(fold(c.tail, initial, combine))
# An optional value: what a search finds, or nothing.
sum Maybe<T>:
  none: {}
  some: {value: T}
def find<T>(items: List<T>, predicate: T -> Bool) -> Maybe<T>:
  match items:
    case nil(_): Maybe.none({})
    case cons(c): if predicate(c.head) then Maybe.some({value: c.head}) else find(c.tail, predicate)
# The item at a 0-based index, if the list is that long.
def at<T>(items: List<T>, index: Nat) -> Maybe<T>:
  match items:
    case nil(_): Maybe.none({})
    case cons(c): if index == 0n then Maybe.some({value: c.head}) else at(c.tail, index - 1n)
def filterMap<T, U>(items: List<T>, transform: T -> Maybe<U>) -> List<U>:
  match items:
    case nil(_): List.nil()
    case cons(c): kept(transform(c.head), filterMap(c.tail, transform))
def kept<U>(found: Maybe<U>, rest: List<U>) -> List<U>:
  match found:
    case none(_): rest
    case some(s): List.cons({head: s.value, tail: rest})
# The index of the first item the predicate holds for: what an Entries edit names.
def indexWhere<T>(items: List<T>, predicate: T -> Bool) -> Maybe<Nat>:
  indexFrom(items, predicate, 0n)
def indexFrom<T>(items: List<T>, predicate: T -> Bool, index: Nat) -> Maybe<Nat>:
  match items:
    case nil(_): Maybe.none({})
    case cons(c): if predicate(c.head) then Maybe.some({value: index}) else indexFrom(c.tail, predicate, index + 1n)
# The list without every item the predicate holds for.
def removeWhere<T>(items: List<T>, predicate: T -> Bool) -> List<T>:
  match items:
    case nil(_): List.nil()
    case cons(c): if predicate(c.head) then removeWhere(c.tail, predicate) else List.cons({head: c.head, tail: removeWhere(c.tail, predicate)})
def take<T>(items: List<T>, count: Nat) -> List<T>:
  match items:
    case nil(_): List.nil()
    case cons(c): if count == 0n then List.nil() else List.cons({head: c.head, tail: take(c.tail, count - 1n)})
def reverse<T>(items: List<T>) -> List<T>:
  reverseOnto(items, List.nil())
def reverseOnto<T>(items: List<T>, onto: List<T>) -> List<T>:
  match items:
    case nil(_): onto
    case cons(c): reverseOnto(c.tail, List.cons({head: c.head, tail: onto}))
