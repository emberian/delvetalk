edition ObjectiveBend 1
import ./List.obend as Lists
import ./Preparation.obend as P
# Source data for the receiving host's bounded addressed-message capability.
# Empty collection means no emission; no padded or disabled slots.
record Emission:
  to: String
  command: String
  recipientProgram: String
  payload: P.Value
type Emissions = Lists.List<Emission>
# These roles stay distinct: originatingPrincipal admitted the immediate source
# emission; rootPrincipal admitted the root turn. Context.principal is the caller
# asking to deliver this event under the recipient's current law.
record CausalEvent:
  id: String
  source: String
  sourceProgram: String
  originatingPrincipal: String
  root: String
  parent: String
  depth: Nat
  rootPrincipal: String
def empty() -> Emissions:
  Emissions.nil()
def one(emission: Emission) -> Emissions:
  Emissions.cons({head: emission, tail: Emissions.nil()})
def length(items: Emissions) -> Nat:
  Lists.length::<Emission>(items)
def within(items: Emissions, budget: Nat) -> Bool:
  match items:
    case nil(_): true
    case cons(c): if budget == 0n then false else within(c.tail, budget - 1n)
def append(left: Emissions, right: Emissions) -> Emissions:
  Lists.concat::<Emission>(left, right)
# The caller owns its smaller musical/workflow bound; native admission independently
# bounds collection size and cumulative descendants. No truncation on overflow.
def repeat(count: Nat, emission: Emission) -> Emissions:
  if count == 0n then Emissions.nil() else Emissions.cons({head: emission, tail: repeat(count - 1n, emission)})
