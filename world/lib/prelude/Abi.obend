edition ObjectiveBend 1
import ./List.obend as Lists
record Origin:
  kind: String
  object: String
  command: String
  program: String
  immediatelyPrevious: Bool
  post: String
record Context:
  world: String
  object: String
  principal: String
  handle: String
  caller: String
  intent: String
  height: Nat
  clock: Nat
  inputOrigin: Origin
record Event:
  id: String
  source: String
  sourceProgram: String
  originatingPrincipal: String
record StringField:
  type: String
  minLength: Nat
  maxLength: Nat
record NatField:
  type: String
  minimum: Nat
  maximum: Nat
# The two-tier law: a package's optional pure predicate
#   def law(old: State, new: State, request: Abi.Request) -> Abi.Verdict
# judged by the host beside the law text (FOUNDATION section 13). A refusal names its
# clause and gives its reading, as a law text's does (the host copies it into the receipt's
# `reason`).
sum Verdict:
  admitted: {}
  refused: {clause: String, reading: String}
record Read:
  object: String
  version: Nat
  state: Data
record Request:
  context: Context
  method: String
  argument: Data
  kind: Nat
  pin: String
  reads: Lists.List<Read>
