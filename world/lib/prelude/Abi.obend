edition ObjectiveBend 1
record Origin:
  kind: String
  object: String
  command: String
  program: String
  immediatelyPrevious: Bool
record Context:
  world: String
  object: String
  principal: String
  caller: String
  intent: String
  height: Nat
  inputOrigin: Origin
record Event:
  id: String
  source: String
  sourceProgram: String
  originatingPrincipal: String
record StringField:
  type: String
  minLength: Nat
  maxLength: Nat
record NatField:
  type: String
  minimum: Nat
  maximum: Nat
