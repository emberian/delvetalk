edition ObjectiveBend 1
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
# The world as an object (docs/WHOLENESS.md section 1): the controller every object's
# activity asks, by one message type, through the methods of `protocol world` below. An
# activity is `Activity<A>` and calls `world.X(arg)`, or `world.X::<T>(arg)` where the
# result's type parameter cannot be inferred (`view`, `call` when its result is read,
# `interpret`); `write {f: op v}` is `world.write(edits)`. Each method's result is a closed
# sum of its own, so the response type belongs to the call site, as a function's result
# does. `interpret` asks `policy` (the world's one) to read the utterance against the forms offered
# (`model` "" for the policy's own).
record Message:
  object: Plans.Reference
  method: String
  argument: Data
type Forms = Lists.List<Form.Form>
sum Viewed<S>:
  viewed: {version: Nat, state: S}
  denied: {}
  refused: {clause: String}
# A derived view (`viewDerived`): the value of the target's pure `view`, typed at the call site; a refusal
# says what the target lacks (`noView`: the views() line to write).
sum Derived<T>:
  derived: {version: Nat, value: T}
  denied: {}
  refused: {clause: String, reading: String}
sum Written:
  written: {}
  refused: {clause: String}
sum Judged:
  judged: {admitted: Bool, clause: String}
  refused: {clause: String}
# A refused call says why: the host's voiced reading of its refusal (HOST-HANDOFF 5.77).
sum Returned<R>:
  returned: {result: R}
  denied: {}
  refused: {clause: String, reading: String}
sum Sent:
  delivery: {id: String}
  refused: {clause: String}
sum Created:
  created: {object: Plans.Reference}
  refused: {clause: String, reading: String}
sum Awaited:
  reply: {receipt: Plans.Receipt}
  unknown: {}
  timedOut: {}
  broken: {}
  refused: {clause: String}
# A proposal names the object whose offered form the model's spell fits (an interpreting card
# may offer other cards' forms, as the commonplace offers its doors'), that object's method, and
# the spell it stands for ("" when a field has no spell form), for a card asking first to print back.
# An answer with several spells is `proposals`, each item fitted as one spell is, in the order
# said (at most three; HOST-HANDOFF 106).
sum Proposed<R>:
  proposal: {object: String, method: String, argument: R, spell: String}
  unclear: {reasons: Document.Names}
sum Interpreted<R>:
  proposal: {object: String, method: String, argument: R, spell: String}
  proposals: {items: Lists.List<Proposed<R>>}
  unclear: {needs: Document.Names}
  timedOut: {}
  denied: {}
  refused: {clause: String}
sum Offered:
  offered: {}
  refused: {clause: String}
sum Published:
  published: {post: String}
  refused: {clause: String}
sum Programmed:
  reprogrammed: {pin: String}
  refused: {clause: String, reading: String}
record Stack:
  package: String
  layers: Lists.List<String>
  form: String
  head: String
  voice: String
  law: String
sum Stacked:
  stacked: Stack
  refused: {clause: String, reading: String}
sum Amended:
  amended: {}
  refused: {clause: String, reading: String}
# A law clause as `inspect` answers it: its name, its expression, its reading ("" for none).
record LawRow:
  name: String
  clause: String
  reading: String
# `source` is "" when `inspect` was asked with `source: false`; `offered` names the actions the
# asking principal is offered (the host's `offeredTo`).
sum Inspected:
  inspected: {pin: String, law: String, source: String, methods: Forms, laws: Lists.List<LawRow>, offered: Document.Names}
  denied: {}
  refused: {clause: String}
# `reaches`: what compiled answers spells (it has a `receive`); false when it did not compile.
sum Checked:
  checked: {diagnostics: Document.Names, reaches: Bool}
  refused: {clause: String}
sum Granted:
  granted: {id: String}
  refused: {clause: String}
sum Revoked:
  revoked: {}
  refused: {clause: String}
# The principal a handle names in the registry (`me`: the asker), or none.
sum Named:
  named: {principal: String}
  unknown: {}
sum Listed:
  listed: {ids: Document.Names, more: Bool}
  refused: {clause: String}
# The cards a turn may read under a prefix with their names (`heads {prefix, after}`): each card's `head` and
# `owner` as its state keeps them ("" where it keeps none), a page as `objects` gives, `after` the last id. A
# derived read: it records no root.
record Head:
  id: String
  head: String
  owner: String
sum Headed:
  headed: {items: Lists.List<Head>, more: Bool}
  refused: {clause: String}
# What changed since a height (docs/METAPHYSICS.md §5): the newest change of each object the asker
# may read under the prefix, newest first, 64 a page (`after`: the last object of the page before),
# with the version it reached, the height, and who made it (a handle when known). A derived read:
# it records no root, so a later change does not make the asking turn stale.
record Change:
  object: Plans.Reference
  version: Nat
  height: Nat
  by: String
sum Since:
  changed: {items: Lists.List<Change>, more: Bool}
  denied: {}
# A rule, a want or a grown verb placed on a thing or taken off it (OVERHAUL §2): judged by the
# thing's law as a request of kind `rule`, the verb naming which (`rule`, `want`, `grow`).
# `ungrow` with `check: true` judges the same removal without staging it for the commit.
sum Placed:
  placed: {}
  refused: {clause: String, reading: String}
# One clock day of the journal folded into lines (`chronicle {day}`): made, grown, fired, wanted,
# refusals by class and who; derived, nothing kept to say it.
sum Chronicled:
  chronicled: {day: Nat, lines: Document.Names}
  refused: {clause: String}
# What wants a hand across the world (`wanting {after, limit}`): each want that holds now, the thing's
# own and the ones it follows, answerable by this hand. `oldest` rotates the oldest-first list by
# clock day; `after`/`next` is its offset. Newest-first pages keep whole heights and `next` is the last
# height. `waiting` counts visible held wants that ask another hand; derived, no root.
record Want:
  object: String
  name: String
  reading: String
  asks: String
  since: Nat
record WantPage:
  rows: Lists.List<Want>
  more: Bool
  waiting: Nat
  next: Nat
sum Wanting:
  wanting: WantPage
  refused: {clause: String}
# A condition in the law's grammar judged of a thing as it stands, the turn's subject reading it (`holds
# {object, when}`): no `old`, nothing written; what it cites are roots (a scene's guard, Scenes.obend).
sum Held:
  held: {value: Bool}
  refused: {clause: String, reading: String}
# The indexes the host hands a card's read (spec/Delvetalk/Host/Surfaces.lean; docs/VOICE.md "The book, the
# history, the map"): derived at the read from the store and the journal as the reader may view them, never
# kept. A Deed is what a hand did that the store still shows: `made` (name: what it is, text: its coiner, when another's
# post coined it), `grew` (name: the verb,
# text: its reading), `rule` and `want` (name, text: the reading), `wrote` (name: the verb that wrote the line,
# text: the line), `visited` (name: `here` while present); `at` the entry, 0 when the world before a carry made it.
record Deed:
  what: String
  object: String
  name: String
  text: String
  at: Nat
record Deeds:
  page: Nat
  rows: Lists.List<Deed>
# The first of a kind of act the world holds: `rain`, `room`, `verb` (grown), `rule` (fired), `coinage`; who did
# it by handle (the rainer, the maker, the grower, the rule's writer, the coiner), what (the verb, the rule).
record First:
  what: String
  object: String
  who: String
  name: String
  at: Nat
# A clock day of the town for the chronicle: the day and its date, today, the first day the journal holds, the
# range asked (from, to: a page a day), the page of the day, its exact lines (`chronicle {day}`), the firsts.
record Annal:
  day: Nat
  date: String
  today: Nat
  first: Nat
  from: Nat
  to: Nat
  page: Nat
  lines: Document.Names
  firsts: Lists.List<First>
# A card's Bend as the host hands its `source` read (Surfaces.sourceData): its pin's slug, its maker, the line saying
# what it came after, what a kind is over (`of`), its law text, whether its code is a kind's body, and the page asked
# for of that code (`text`, its lines indented, cut by the host within the world's room; `page` 0 is all of it) of
# `pages`; "" for what the reader may not see.
record Source:
  object: String
  page: Nat
  pages: Nat
  pin: String
  maker: String
  after: String
  of: String
  law: String
  body: Bool
  text: String
# What a resident made that others may read and fork (Surfaces.makings): `kind` (name: what it is over, from: the
# kind it came after), `body` (a kind with Bend of its own), `verb` (grown on `object`; name: the verb); `who` by
# handle, `at` the entry. Newest first.
record Making:
  what: String
  object: String
  name: String
  who: String
  from: String
  at: Nat
record Makings:
  page: Nat
  rows: Lists.List<Making>
# A door as the map draws it: the card it is on, its label, the card it opens onto.
record Way:
  from: String
  label: String
  to: String
record Lying:
  object: String
  count: Nat
# The map from `root`: the shortest way to it from the commonplace (`path`, the commonplace first; empty when no
# door leads there), every door the reader may follow, how many things lie in each place, the page.
record Ways:
  root: String
  path: Document.Names
  ways: Lists.List<Way>
  lying: Lists.List<Lying>
  page: Nat
# A receipt of this town's journal named by its CID or its slug (`receipt {name}`): the entry's CID, its height and
# whose turn it was (`principal`, "" for an entry of a world this one was carried from); `ambiguous` for a slug that
# names two or more entries; `unknown`. Read from the chain the turn reads, which only grows: no root.
sum Receipted:
  found: {cid: String, height: Nat, principal: String}
  ambiguous: {count: Nat}
  unknown: {}
sum Carded:
  carded: {document: Document.Document}
  denied: {}
  refused: {clause: String}
protocol world:
  view<S>({object: Plans.Reference}) -> Viewed<S>
  viewField<S>({object: Plans.Reference, field: String}) -> Viewed<S>
  viewAt<S>({object: Plans.Reference, version: Nat}) -> Viewed<S>
  viewDerived<T>({object: Plans.Reference, view: String}) -> Derived<T>
  write<E>(E) -> Written
  judge<E>(E) -> Judged
  call<R>({object: Plans.Reference, method: String, argument: Data}) -> Returned<R>
  callVia<R>({object: Plans.Reference, method: String, argument: Data, via: String}) -> Returned<R>
  run<R>({object: Plans.Reference, method: String, argument: Data, handler: Plans.Reference}) -> Returned<R>
  send({object: Plans.Reference, method: String, argument: Data}) -> Sent
  sendVia({object: Plans.Reference, method: String, argument: Data, via: String}) -> Sent
  create({package: String, seed: Data, law: String, requireAbsent: Plans.Reference}) -> Created
  createUnder({package: String, seed: Data, law: String, requireAbsent: Plans.Reference, supervisor: Plans.Reference}) -> Created
  make({package: String, seed: Data, law: String, requireAbsent: Plans.Reference, madeFrom: Plans.MadeFrom}) -> Created
  await({slot: Plans.Slot, patience: Nat}) -> Awaited
  awaitUntil({slot: Plans.Slot, until: Nat}) -> Awaited
  interpret<R>({utterance: String, offers: Forms, policy: Plans.Reference, model: String}) -> Interpreted<R>
  offer({to: String, document: Document.Document}) -> Offered
  publish({page: String, section: String, body: String}) -> Published
  reprogram({object: Plans.Reference, package: String, migration: String}) -> Programmed
  extend({object: Plans.Reference, package: String, migration: String}) -> Programmed
  compose({object: Plans.Reference, kind: String}) -> Programmed
  kindStack({of: String, body: String, depth: Nat, kind: String}) -> Stacked
  amend({object: Plans.Reference, law: String}) -> Amended
  inspect({object: Plans.Reference, source: Bool}) -> Inspected
  check({package: String, layers: Lists.List<String>}) -> Checked
  checkObject({object: Plans.Reference, layers: Lists.List<String>}) -> Checked
  grant({to: String, object: Plans.Reference, method: String, until: Nat}) -> Granted
  grantWith({to: String, object: Plans.Reference, method: String, until: Nat, fixed: Data, uses: Nat}) -> Granted
  revoke({id: String}) -> Revoked
  objects({prefix: String, after: String}) -> Listed
  heads({prefix: String, after: String}) -> Headed
  changed({since: Nat, prefix: String, after: String}) -> Since
  card({object: Plans.Reference}) -> Carded
  rule({object: Plans.Reference, name: String, when: String, then: String}) -> Placed
  unrule({object: Plans.Reference, name: String}) -> Placed
  want({object: Plans.Reference, name: String, when: String, asks: String}) -> Placed
  unwant({object: Plans.Reference, name: String}) -> Placed
  grow({object: Plans.Reference, name: String, reading: String, takes: String, does: String}) -> Placed
  ungrow({object: Plans.Reference, name: String, check: Bool}) -> Placed
  act<R>({object: Plans.Reference, verb: String, text: String}) -> Returned<R>
  chronicle({day: Nat}) -> Chronicled
  wanting({after: Nat, limit: Nat, oldest: Bool}) -> Wanting
  holds({object: Plans.Reference, when: String}) -> Held
  principal({handle: String}) -> Named
  receipt({name: String}) -> Receipted
