edition ObjectiveBend 1
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Spell.obend as Spell
import ./Card.obend as Card
import ./Text.obend as Text
# A door word is short: only the first 65 scalars are looked at (measuring and trimming a
# long reply would cost its bytes).
def doorWord(text: String) -> String:
  short(textTake(Text.trimStart(text), 65n))
def short(head: String) -> String:
  if textLength(head) > 64n then "" else Text.trimEnd(head)
# What the commonplace learns of its doors, once a turn and only when a reply needs it: each
# door's forms, and the forms of the first cards listed under it (a garden's bells), by
# inspect. Field lines are read against them; they are what the model is offered.
record Learned:
  card: String
  child: Bool
  form: Form.Form
type Learning = Lists.List<Learned>
# Only what a card offers a reader counts: inspect lists the forms the host offers this reader
# (the law and the card's `actions` leave them: a bell's `door` is its planter's alone) and
# `receive`, which no reader names as an action.
def learnedOf(card: String, child: Bool, forms: Lists.List<Form.Form>) -> Learning:
  Lists.map(Lists.filter(forms, fn(f: Form.Form) -> Bool: f.action != "receive"), fn(f: Form.Form) -> Learned: {card: card, child: child, form: f})
# The spell the field lines mean for a form: the action line as it was written (the
# door's own fit gives its value to the form's first open text field) and every
# line naming one of the form's fields.
def spellFor(card: String, form: Form.Form, fields: Spell.Bindings) -> String:
  let lines = textJoin(Lists.map(Lists.filter(fields, fn(b: Spell.Binding) -> Bool: b.name == form.action || Card.hasField(form, b.name)), fn(b: Spell.Binding) -> String: "{b.name}: {b.value}"), "\n")
  "delvetalk {card} {form.action}\n{lines}"
# What the model is offered at the root: the doors' forms and those of the first card under each
# (a bell's rain under the garden: the arc the menu shows), each under the card it belongs to.
def doorForms(learned: Learning) -> Lists.List<Form.Form>:
  Lists.map(learned, fn(l: Learned) -> Form.Form: {card: l.card, action: l.form.action, fields: l.form.fields})
# An action the policy confirms (a give, an offer, a reprogram) is not run from prose: the
# speaker is shown the door's spell with its blanks, and sending it is the yes.
def askedFirst(card: String, forms: Lists.List<Form.Form>) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text("hob: that asks first; send it filled:\n"), tail: Lists.map(forms, fn(f: Form.Form) -> Document.Document: Card.template(card, f))})})
