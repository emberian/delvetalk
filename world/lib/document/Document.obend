edition ObjectiveBend 1
import ./List.obend as Lists
# What a card's `render` returns: text, and sequences of documents.
sum Document:
  text: {value: String}
  sequence: {items: Documents}
type Documents = Lists.List<Document>
type Names = Lists.List<String>
def empty() -> Document:
  Document.sequence({items: Documents.nil()})
def text(value: String) -> Document:
  Document.text({value: value})
def concat(left: Document, right: Document) -> Document:
  Document.sequence({items: Documents.cons({head: left, tail: Documents.cons({head: right, tail: Documents.nil()})})})
# Read-only text projection; callers retain the original structured value.
# The leaves are flattened once (linear) and joined by the textJoin primitive,
# which appends onto one accumulator and is charged by the bytes it adds:
# linear in the output. (A left or right fold of textConcat re-reads its
# accumulator and is quadratic.)
def plain(document: Document) -> String:
  textJoin(leaves(document, Strings.nil()), "")
type Strings = Lists.List<String>
def leaves(document: Document, rest: Strings) -> Strings:
  match document:
    case text(t): Strings.cons({head: t.value, tail: rest})
    case sequence(s): leavesItems(s.items, rest)
def leavesItems(items: Documents, rest: Strings) -> Strings:
  match items:
    case nil(_): rest
    case cons(c): leaves(c.head, leavesItems(c.tail, rest))
def joinAll(items: Strings) -> String:
  textJoin(items, "")
# Linear measure of the text a document carries; unlike plain, it never copies
# the accumulated text, so it stays cheap on long sequences.
def size(document: Document) -> Nat:
  match document:
    case text(t): textLength(t.value)
    case sequence(s): sizeItems(s.items)
def sizeItems(items: Documents) -> Nat:
  Lists.fold(items, 0n, fn(document: Document) -> Nat -> Nat: fn(rest: Nat) -> Nat: size(document) + rest)
# One string per rendered line, without the newline; a final empty line (text
# ending in a newline) is dropped. Leaves are split where they stand and a
# leaf's last fragment is glued only to the first line of what lies to its
# right, so no accumulator that grows with the document is ever concatenated.
def lines(document: Document) -> Names:
  withoutTrailingEmpty(linesOf(document, Names.cons({head: "", tail: Names.nil()})))
def linesOf(document: Document, rest: Names) -> Names:
  match document:
    case text(t): splitOnto(t.value, rest)
    case sequence(s): linesOfItems(s.items, rest)
def linesOfItems(items: Documents, rest: Names) -> Names:
  match items:
    case nil(_): rest
    case cons(c): linesOf(c.head, linesOfItems(c.tail, rest))
def splitOnto(value: String, rest: Names) -> Names:
  let stop = textBreak(value, "\n")
  if stop >= textLength(value) then glue(value, rest) else Names.cons({head: textTake(value, stop), tail: splitOnto(textDrop(value, stop + 1n), rest)})
def glue(value: String, rest: Names) -> Names:
  match rest:
    case nil(_): Names.cons({head: value, tail: Names.nil()})
    case cons(c): Names.cons({head: "{value}{c.head}", tail: c.tail})
def withoutTrailingEmpty(items: Names) -> Names:
  match items:
    case nil(_): items
    case cons(c):
      match c.tail:
        case nil(_): if c.head == "" then Names.nil() else items
        case cons(_): Names.cons({head: c.head, tail: withoutTrailingEmpty(c.tail)})
