edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Document.obend as Document
record Brief:
  context: Abi.Context
  subject: String
  count: Nat
  detailed: Bool
  utterance: String
  capture: Document.Capture
# Named sections are ordinary function-valued fields, so callers can pass,
# replace, return and specialize them without a separate template environment.
record Sections:
  heading: Brief -> Document.Document
  examples: Brief -> Document.Document
  body: Brief -> Document.Document
record Item:
  index: Nat
  brief: Brief
def item(value: Item) -> Document.Document:
  doc"""• {{ value.brief.subject }} {{ natText(value.index) }}
"""
def each(index: Nat, count: Nat, brief: Brief, partial: Item -> Document.Document) -> Document.Document:
  if index > count then Document.empty() else Document.concat(partial({index: index, brief: brief}), each(index + 1, count, brief, partial))
def numbered(brief: Brief) -> Document.Document:
  each(1, brief.count, brief, item)
def invitation(brief: Brief) -> Document.Document:
  Document.Document.offer({label: "Lend this moth", capture: brief.capture})
extension Base(self: Sections, super: {}) -> Sections:
  {heading: fn(brief: Brief) -> Document.Document: doc"""Hello, {{ brief.context.principal }}.
""", examples: fn(brief: Brief) -> Document.Document: numbered(brief), body: fn(brief: Brief) -> Document.Document: doc"""{% self.heading(brief) %}{% if brief.detailed then self.examples(brief) else Document.text("Details folded.\n") %}{% invitation(brief) %}"""}
extension Workshop[Self has {heading: Brief -> Document.Document, examples: Brief -> Document.Document, body: Brief -> Document.Document}, Super has {heading: Brief -> Document.Document, examples: Brief -> Document.Document, body: Brief -> Document.Document}](self: Self, super: Super) -> Super with {heading: Brief -> Document.Document, examples: Brief -> Document.Document}:
  extend(super, {heading: fn(brief: Brief) -> Document.Document: doc"""Workshop · {% super.heading(brief) %}""", examples: fn(brief: Brief) -> Document.Document: doc"""{% super.examples(brief) %}Bring your own impossible example.
"""})
def sections() -> Sections:
  fix(compose(Base, Workshop), {})
def render(brief: Brief) -> Document.Document:
  sections().body(brief)
def plain(brief: Brief) -> String:
  Document.plain(render(brief))
def quotation(brief: Brief) -> Document.Document:
  Document.quote("Participant data", doc"""{{ brief.utterance }}""")
# A template can return another template, closing only over explicit arguments.
def withHeading(heading: Document.Document) -> Brief -> Document.Document:
  fn(brief: Brief) -> Document.Document: doc"""{% heading %}{% render(brief) %}"""
def headed(brief: Brief) -> String:
  Document.plain(withHeading(doc"""A shared preface.
""")(brief))
def countSummary(count: Nat) -> Document.Document:
  match count:
    case 0: doc"""No examples supplied.
"""
    case 1+previous: doc"""{{ natText(previous + 1) }} examples supplied.
"""
def sourcePrompt(brief: Brief) -> Document.Document:
  let policy = doc"""Interpret the participant's request using the captured offer below.
Retain unresolved names. A proposal does not execute an action.
"""
  doc"""{% policy %}{% countSummary(brief.count) %}{% quotation(brief) %}
Available operation: {% invitation(brief) %}"""
def literal() -> String:
  Document.plain(doc"""  🌙 é "quoted" 'single'
	keep this tab; \{{not a hole}}; \{%not a splice%}; \"""; \\.
""")
