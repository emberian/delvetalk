edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Spell.obend as Spell
import ./Plan.obend as Plans
import ./Policies.obend as Policies
import ./Relation.obend as Relations
import ./World.obend as World
# The uniform card protocol. Every object has a pure render(state, context) ->
# Document (its card as the reader in the context sees it: a member may see more than a
# stranger; the host's `card {object}` passes the reader's context), exports forms() (the
# actions its card offers, as data) and door() (its line in a directory), and takes
# receive {text, post} as the one message the town sends (the host owns the slot).
# route reads a reply: a spell naming this object and one of its forms becomes
# `act` with typed fields; the object matches the action to its own method. What
# is not acted on is answered by `answer`, which offers the card with its forms.
# `delvetalk <card> set` with one `<field>: <value>` line routes to `set`, which
# `answerLensed` performs through the object's lenses (Form.Lens); `delvetalk <card> ?`
# routes to `help`, answered with the usage card: every form and every lens.
#
# A form's card is "" in forms(): the card a spell names is the object's id, which
# route and usage take from the context.
record Heard:
  text: String
  post: String
record Door:
  word: String
  blurb: String
type Forms = Lists.List<Form.Form>
# A refusal names its clause (an object's `Why` arm, or the protocol's own: otherCard,
# noAction, oneField, spell, notSettable, noField, notOwner, badValue, noPost) and gives its
# reading; a card shows it as `refused <clause>: <reading>`.
record Refusal:
  clause: String
  reading: String
# The typed fields of an acted spell.
type Fields = Spell.Entries
sum Routed:
  act: {action: String, fields: Fields}
  usage: {}
  unclear: {action: String, needs: Form.Names}
  refused: Refusal
  set: {field: String, value: String}
  help: {}
  quiet: {text: String, post: String}
# What receive answers when no method was acted on (in either dialect).
sum Replied:
  done: {action: String}
  usage: {}
  unclear: {needs: Form.Names}
  refused: Refusal
  silent: {}
def named(form: Form.Form, card: String) -> Form.Form:
  {card: card, action: form.action, fields: form.fields}
# Prose that names none of the card's forms, fields or actions is not addressed to it:
# `quiet`, answered with no offer at all (the bridge drafts nothing) and handed to the
# directory's reading (`forwarded`). An empty reply still asks for the card. routeHeard
# keeps the post the reply is in, for that hand-off.
def route(text: String, context: Abi.Context, forms: Forms) -> Routed:
  routeHeard({text: text, post: ""}, context, forms)
def routeHeard(input: Heard, context: Abi.Context, forms: Forms) -> Routed:
  heardAs(withBare(Spell.parse(input.text), input.text, context, forms), input, context, forms)
# Whether text is only blanks (without measuring all of it: textLength costs its bytes).
def blank(text: String) -> Bool:
  textDrop(text, textSpan(text, " \n\t\r")) == ""
def heardAs(parsed: Spell.Parsed, input: Heard, context: Abi.Context, forms: Forms) -> Routed:
  match parsed:
    case notASpell(_): if blank(input.text) then Routed.usage({}) else Routed.quiet({text: input.text, post: input.post})
    case spell(_): routeParsed(parsed, context, forms)
# A reply with no delvetalk line whose first `name: value` line names an action or a
# field of one of this card's forms is that form's spell (a bell reads a fenced `rain:
# a drizzle` as rain; Spell.fit gives an action-named line to the form's open text field).
def withBare(parsed: Spell.Parsed, text: String, context: Abi.Context, forms: Forms) -> Spell.Parsed:
  match parsed:
    case spell(_): parsed
    case notASpell(n): if n.fielded then bareSpell(Spell.bare(text), context.object, forms, parsed) else parsed
def bareSpell(bindings: Spell.Bindings, card: String, forms: Forms, otherwise: Spell.Parsed) -> Spell.Parsed:
  match bindings:
    case nil(_): otherwise
    case cons(c): bareFor(Lists.find(forms, fn(f: Form.Form) -> Bool: f.action == c.head.name || hasField(f, c.head.name)), bindings, card, otherwise)
def hasField(form: Form.Form, name: String) -> Bool:
  Lists.any(form.fields, fn(f: Form.Field) -> Bool: f.name == name)
def bareFor(found: Lists.Maybe<Form.Form>, bindings: Spell.Bindings, card: String, otherwise: Spell.Parsed) -> Spell.Parsed:
  match found:
    case none(_): otherwise
    case some(f): Spell.Parsed.spell({card: card, action: f.value.action, fields: Lists.filter(bindings, fn(b: Spell.Binding) -> Bool: b.name == f.value.action || hasField(f.value, b.name))})
def routeParsed(parsed: Spell.Parsed, context: Abi.Context, forms: Forms) -> Routed:
  match parsed:
    case notASpell(_): Routed.usage({})
    case spell(s): if names(s.card, context) == false then Routed.refused({clause: "otherCard", reading: "This card is {context.object}"}) else chosen(parsed, s.card, s.action, s.fields, Lists.find(forms, fn(form: Form.Form) -> Bool: form.action == s.action), context)
# A spell names this card by its id, or, for the speaker's own env/<did> and wake/<did>,
# by the bare word the town writes (`delvetalk env subscribe`).
def names(card: String, context: Abi.Context) -> Bool:
  card == context.object || (card == "env" || card == "wake") && context.object == own(card, context)
def own(card: String, context: Abi.Context) -> String:
  "{card}/{context.principal}"
# An object's own form wins; otherwise `set` and `?` are the protocol's.
def chosen(parsed: Spell.Parsed, card: String, action: String, bindings: Spell.Bindings, found: Lists.Maybe<Form.Form>, context: Abi.Context) -> Routed:
  match found:
    case none(_): if action == "set" then setting(bindings) else if action == "?" then Routed.help({}) else Routed.refused({clause: "noAction", reading: "No action called {action}"})
    case some(f): fitted(action, Spell.fit(parsed, named(f.value, card)))
def setting(bindings: Spell.Bindings) -> Routed:
  match bindings:
    case cons(c): if Lists.length(c.tail) == 0n then Routed.set({field: c.head.name, value: c.head.value}) else Routed.refused({clause: "oneField", reading: "set takes one field: value line."})
    case nil(_): Routed.refused({clause: "oneField", reading: "set takes one field: value line."})
def fitted(action: String, fit: Spell.Fit) -> Routed:
  match fit:
    case proposal(p): Routed.act({action: action, fields: p.bindings})
    case unclear(u): Routed.unclear({action: action, needs: u.needs})
    case refused(r): Routed.refused({clause: "spell", reading: r.reason})
# Typed field values of an acted spell; a field the form does not have is "" or 0.
def text(fields: Spell.Entries, name: String) -> String:
  match Lists.find(fields, fn(entry: Spell.Entry) -> Bool: entry.name == name):
    case none(_): ""
    case some(s):
      match s.value.value:
        case text(t): t.value
        case choice(c): c.value
        case natural(n): natText(n.value)
def natural(fields: Spell.Entries, name: String) -> Nat:
  match Lists.find(fields, fn(entry: Spell.Entry) -> Bool: entry.name == name):
    case none(_): 0n
    case some(s):
      match s.value.value:
        case natural(n): n.value
        case _: 0n
def hint(kind: Form.Kind) -> String:
  match kind:
    case text(t): "<text, {natText(t.min)} to {natText(t.max)} characters>"
    case natural(n): "<a number from {natText(n.min)} to {natText(n.max)}>"
    case choice(c): "<{Spell.joined(c.options)}>"
# One form as the spell a reader copies.
def template(card: String, form: Form.Form) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text("\n    delvetalk {card} {form.action}\n"), tail: Lists.map(form.fields, fn(field: Form.Field) -> Document.Document: Document.text("    {field.name}: {hint(field.kind)}\n"))})})
def usage(card: String, forms: Forms) -> Document.Document:
  if Lists.length(forms) == 0n then Document.text("") else Document.Document.sequence({items: Document.Documents.cons({head: Document.text("\nReply with a spell:\n"), tail: Lists.map(forms, fn(form: Form.Form) -> Document.Document: template(card, form))})})
# One lens as the set spell a reader copies.
def lensTemplate<E>(card: String, lens: Form.Lens<E>) -> Document.Document:
  match lens:
    case lens(l): Document.text("\n    delvetalk {card} set\n    {l.field}: {hint(l.form)}\n")
def lensUsage<E>(card: String, lenses: Lists.List<Form.Lens<E>>) -> Document.Document:
  if Lists.length(lenses) == 0n then Document.text("") else Document.Document.sequence({items: Document.Documents.cons({head: Document.text("\nTo change a field, reply (one field a spell):\n"), tail: Lists.map(lenses, fn(lens: Form.Lens<E>) -> Document.Document: lensTemplate(card, lens))})})
# The usage card `?` answers: every form, then every lens.
def help<E>(card: String, forms: Forms, lenses: Lists.List<Form.Lens<E>>) -> Document.Document:
  Document.concat(usage(card, forms), lensUsage(card, lenses))
# The card a non-acting reply gets: the object's card, then why, then its forms.
def why(routed: Routed) -> String:
  match routed:
    case act(a): ""
    case usage(_): ""
    case refused(r): "\nrefused {r.clause}: {r.reading}\n"
    case _: "\nNot done: {reason(routed)}\n"
def replyOf(routed: Routed) -> Replied:
  match routed:
    case act(a): Replied.done({action: a.action})
    case unclear(u): Replied.unclear({needs: u.needs})
    case refused(r): Replied.refused(r)
    case usage(_): Replied.usage({})
    case help(_): Replied.usage({})
    case quiet(_): Replied.silent({})
    case set(_): Replied.refused({clause: "notSettable", reading: "Nothing here can be set."})
def answered(routed: Routed, context: Abi.Context, forms: Forms, card: Document.Document) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: card, tail: Document.Documents.cons({head: Document.text(why(routed)), tail: Document.Documents.cons({head: usage(context.object, forms), tail: Document.Documents.nil()})})})})
def answerPlan<E, S, R>(routed: Routed, context: Abi.Context, forms: Forms, card: Document.Document) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, Replied>:
  answerAsPlan(routed, context, forms, card, replyOf(routed))
# `?` gets the usage card alone; anything else the card, why, and the forms.
def answeredOrHelp(routed: Routed, context: Abi.Context, forms: Forms, card: Document.Document) -> Document.Document:
  match routed:
    case help(_): usage(context.object, forms)
    case _: answered(routed, context, forms, card)
# The same answer for an object whose receive finishes with its methods' own result
# type: `result` is what a non-acting reply finishes with.
def answerAsPlan<E, S, R, T>(routed: Routed, context: Abi.Context, forms: Forms, card: Document.Document, result: T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match routed:
    case quiet(q): forwarded(q.text, q.post, context, result)
    case _: offering(routed, context, forms, card, result)
# The directory reads prose a card without a policy could not place: the card sends it
# the reply (`receive {text, post}`, under the speaker) and offers nothing itself, so an
# anthology line posted under a bell still reaches the anthology. A turn some object
# started (context.caller) forwards nothing: the directory itself passes replies on.
def directory(context: Abi.Context) -> Plans.Reference:
  {world: context.world, object: "directory"}
def forwarding<E>(text: String, post: String, context: Abi.Context) -> Plans.Plan<E>:
  Plans.Plan.send({object: directory(context), method: "receive", argument: {text: text, post: post}})
def forwarded<E, S, R, T>(text: String, post: String, context: Abi.Context, result: T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  if handsOn(text, context) == false then result else sending(text, post, context, result)
# A turn some object started, and the directory itself, hand nothing on. Whether the prose
# names anything is the directory's to judge from what it learned of its doors (`mentions`),
# before any model call: a card holds no word list (rehearsal run 7 counted 127 of 132
# hand-ons "not addressed"), and a new door needs no edit here.
def handsOn(text: String, context: Abi.Context) -> Bool:
  context.caller == "" && context.object != directory(context).object
# Whether prose names one of `words` (door words and form actions, each a whole word) or,
# as a `name:` line, one of `words` or `fields`. One pass: the text is split at blanks
# once, and a word of three or more letters (a leading and a trailing mark dropped) is
# looked up among the words of its own length (a 1,788-character reply costs about
# 20,000 ticks, where a walk of the text for each word cost a million).
def mentions(text: String, bindings: Spell.Bindings, words: Lists.List<String>, fields: Lists.List<String>) -> Bool:
  let v = vocabulary(words)
  let first = firsts(words)
  fieldNamed(bindings, v, vocabulary(fields)) || scanned(text, v, first)
def fieldNamed(bindings: Spell.Bindings, words: Vocabulary, fields: Vocabulary) -> Bool:
  Lists.any(bindings, fn(b: Spell.Binding) -> Bool: known(words, b.name) || known(fields, b.name))
# Words by length: the first list holds the one-letter words, and so on to 24.
type Vocabulary = Lists.List<Lists.List<String>>
def vocabulary(words: Lists.List<String>) -> Vocabulary:
  Lists.fold(words, empty(24n), fn(word: String) -> Vocabulary -> Vocabulary: fn(v: Vocabulary) -> Vocabulary: inserted(v, word, textLength(word)))
def empty(n: Nat) -> Vocabulary:
  if n == 0n then Lists.List.nil({}) else Lists.List.cons({head: Lists.List.nil({}), tail: empty(n - 1n)})
def inserted(v: Vocabulary, word: String, n: Nat) -> Vocabulary:
  match v:
    case nil(_): v
    case cons(c): if n <= 1n then Lists.List.cons({head: Lists.List.cons({head: word, tail: c.head}), tail: c.tail}) else Lists.List.cons({head: c.head, tail: inserted(c.tail, word, n - 1n)})
def known(v: Vocabulary, word: String) -> Bool:
  Lists.any(bucket(v, textLength(word)), fn(w: String) -> Bool: w == word)
def bucket(v: Vocabulary, n: Nat) -> Lists.List<String>:
  match v:
    case nil(_): Lists.List.nil({})
    case cons(c): if n <= 1n then c.head else bucket(c.tail, n - 1n)
def scanned(text: String, v: Vocabulary, first: String) -> Bool:
  if text == "" then false else cut(text, textBreak(text, " \n"), v, first)
def cut(text: String, at: Nat, v: Vocabulary, first: String) -> Bool:
  if at >= 3n && textSpan(textTake(text, 1n), first) == 1n && worded(textTake(text, at), v) then true else scanned(textDrop(text, at + 1n), v, first)
# The letters the words start with, and the marks a word may open with: a word starting
# with anything else is not looked up.
def firsts(words: Lists.List<String>) -> String:
  Lists.fold(words, marks(), fn(w: String) -> String -> String: fn(acc: String) -> String: if textSpan(textTake(w, 1n), acc) == 1n then acc else textConcat(acc, textTake(w, 1n)))
def worded(word: String, v: Vocabulary) -> Bool:
  let n = textLength(word)
  if n > 24n then false else known(v, stripped(word, n))
# A word without one run of marks at its end and one at its start ("anthology," "(play").
def stripped(word: String, n: Nat) -> String:
  let core = textTake(word, n - textSpan(textDrop(word, n - 1n), marks()))
  textDrop(core, textSpan(core, marks()))
def marks() -> String:
  ".,:;!?\"')(*`"
# A space-separated list of words as a list ("" between two spaces is skipped).
def wordList(text: String) -> Lists.List<String>:
  if text == "" then Lists.List.nil({}) else listed(textTake(text, textBreak(text, " ")), textDrop(text, textBreak(text, " ") + 1n))
def listed(word: String, rest: String) -> Lists.List<String>:
  if word == "" then wordList(rest) else Lists.List.cons({head: word, tail: wordList(rest)})
# Whether `needle` stands in `text`.
def contains(text: String, needle: String) -> Bool:
  containsFrom(textDrop(text, textBreak(text, textTake(needle, 1n))), needle)
def containsFrom(rest: String, needle: String) -> Bool:
  if textLength(rest) < textLength(needle) then false else if textTake(rest, textLength(needle)) == needle then true else contains(textDrop(rest, 1n), needle)
def sending<E, S, R, T>(text: String, post: String, context: Abi.Context, result: T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match perform(forwarding(text, post, context)):
    case _: result
def offering<E, S, R, T>(routed: Routed, context: Abi.Context, forms: Forms, card: Document.Document, result: T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match perform(Plans.Plan.offer({to: "", document: answeredOrHelp(routed, context, forms, card)})):
    case _: result
def reason(routed: Routed) -> String:
  match routed:
    case act(a): ""
    case usage(_): "Reply with a spell."
    case unclear(u): "Almost. I still need: {Spell.joined(u.needs)}."
    case refused(r): "refused {r.clause}: {r.reading}"
    case help(_): ""
    case set(_): "Nothing here can be set."
    case quiet(_): ""
# Lenses. answerLensed is answer for an object with lenses: a `set` is judged against
# the lens's kind and written through its put (the object's law judges the write; a
# non-empty guard refuses first, by name), `?` offers the usage card with the lenses.
def lensNamed<E>(lenses: Lists.List<Form.Lens<E>>, field: String) -> Lists.Maybe<Form.Lens<E>>:
  Lists.find(lenses, fn(lens: Form.Lens<E>) -> Bool: lensField(lens) == field)
def lensField<E>(lens: Form.Lens<E>) -> String:
  match lens:
    case lens(l): l.field
def answerLensed<E, S, R>(routed: Routed, context: Abi.Context, forms: Forms, lenses: Lists.List<Form.Lens<E>>, guard: String, card: Document.Document) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, Replied>:
  answerLensedAs(routed, context, forms, lenses, guard, card, fn(reply: Replied) -> Replied: reply)
# The same for an object whose receive finishes with its own result type: `as` maps the
# protocol's Replied to it.
def answerLensedAs<E, S, R, T>(routed: Routed, context: Abi.Context, forms: Forms, lenses: Lists.List<Form.Lens<E>>, guard: String, card: Document.Document, as: Replied -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match routed:
    case set(s): putting(s.field, s.value, lensNamed(lenses, s.field), guard, context, forms, card, as)
    case help(_): tellPlan(as(Replied.usage({})), help(context.object, forms, lenses))
    case _: answerAsPlan(routed, context, forms, card, as(replyOf(routed)))
def refusing<E, S, R, T>(refusal: Refusal, context: Abi.Context, forms: Forms, card: Document.Document, as: Replied -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  answerAsPlan(Routed.refused(refusal), context, forms, card, as(Replied.refused(refusal)))
def putting<E, S, R, T>(field: String, value: String, found: Lists.Maybe<Form.Lens<E>>, guard: String, context: Abi.Context, forms: Forms, card: Document.Document, as: Replied -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match found:
    case none(_): refusing({clause: "noField", reading: "No field called {field} can be set here."}, context, forms, card, as)
    case some(f): if guard != "" then refusing({clause: "notOwner", reading: guard}, context, forms, card, as) else judgedPut(f.value, value, context, forms, card, as)
def judgedPut<E, S, R, T>(lens: Form.Lens<E>, value: String, context: Abi.Context, forms: Forms, card: Document.Document, as: Replied -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match lens:
    case lens(l): verdictPut(Spell.judge({name: l.field, kind: l.form}, value), l.put(Spell.typed(l.form, value)), l.field, value, context, forms, card, as)
def verdictPut<E, S, R, T>(verdict: Spell.Verdict, edits: E, field: String, value: String, context: Abi.Context, forms: Forms, card: Document.Document, as: Replied -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match verdict:
    case wrong(w): refusing({clause: "badValue", reading: w.reason}, context, forms, card, as)
    case fine(_): put(edits, field, value, context, as)
def put<E, S, R, T>(edits: E, field: String, value: String, context: Abi.Context, as: Replied -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  let written(_) = perform(Plans.Plan.write({object: Plans.self(context), edits: edits}))
  tellPlan(as(Replied.done({action: "set"})), Document.text("Set {field} to {value}.\n"))
# A lens's value as text or as a natural (0 when the kind is not a number).
def valueText(value: Form.Value) -> String:
  match value:
    case text(t): t.value
    case choice(c): c.value
    case natural(n): natText(n.value)
def valueNatural(value: Form.Value) -> Nat:
  match value:
    case natural(n): n.value
    case _: 0n
# The context of a reader nobody is: what a card shows a
# stranger. Mine is "(yours)" when the principal is the reader.
def stranger() -> Abi.Context:
  {world: "", object: "", principal: "", handle: "", caller: "", intent: "", height: 0n, clock: 0n, inputOrigin: {kind: "", object: "", command: "", program: "", immediatelyPrevious: false}}
def reads(principal: String, context: Abi.Context) -> Bool:
  principal != "" && principal == context.principal
def mine(principal: String, context: Abi.Context) -> String:
  if reads(principal, context) then " (yours)" else ""
# Offers a document addressed to one principal and finishes with the given result.
def tellToPlan<E, S, R, T>(result: T, to: String, document: Document.Document) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match perform(Plans.Plan.offer({to: to, document: document})):
    case _: result
# Offers a document and finishes with the given result.
def tellPlan<E, S, R, T>(result: T, document: Document.Document) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match perform(Plans.Plan.offer({to: "", document: document})):
    case _: result
# Observers: the objects told when something happens here, each by the method it
# names. An object keeps `observers: Observers` in state and exposes observe and
# unobserve by calling these with the Edits builder for that one field.
record Observer:
  object: Plans.Reference
  method: String
type Observers = Lists.List<Observer>
def sameObserver(left: Observer, right: Observer) -> Bool:
  Plans.same(left.object, right.object) && left.method == right.method
# What an observe or unobserve changes: nothing, one edit of the observers field, or
# a refusal. The object performs the write itself (a generic activity over the
# object's Edits nests the object's types past the packet's capacity when another
# object imports it).
sum Change:
  unchanged: {count: Nat}
  edit: {entries: Plans.Entries<Observer, {}>, count: Nat}
  refused: {reason: String}
def observing(observers: Observers, input: Observer) -> Change:
  observingUpTo(observers, input, 16n)
# The same with the object's own bound (an Avatar's mailing list holds as many as one
# turn may send).
def observingUpTo(observers: Observers, input: Observer, cap: Nat) -> Change:
  if Lists.any(observers, fn(o: Observer) -> Bool: sameObserver(o, input)) then Change.unchanged({count: Lists.length(observers)}) else adding(Lists.length(observers), input, cap)
def adding(count: Nat, input: Observer, cap: Nat) -> Change:
  if count < cap then Change.edit({entries: Plans.Entries.append({item: input}), count: count + 1n}) else Change.refused({reason: "Too many observers."})
def unobserving(observers: Observers, input: Observer) -> Change:
  match Lists.find(observers, fn(o: Observer) -> Bool: sameObserver(o, input)):
    case none(_): Change.refused({reason: "Not observing."})
    case some(s): Change.edit({entries: Plans.Entries.removeItem({item: s.value}), count: Lists.length(observers) - 1n})
# broadcast sends the argument to every observer by its method, then finishes with `then` of
# how many sends the host accepted (an activity composes only in tail position).
def broadcast<E, S, R, T>(observers: Observers, argument: Data, sent: Nat, then: Nat -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match observers:
    case nil(_): then(sent)
    case cons(c): notified(c.head, c.tail, argument, sent, then)
def notified<E, S, R, T>(head: Observer, tail: Observers, argument: Data, sent: Nat, then: Nat -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match perform(Plans.Plan.send({object: head.object, method: head.method, argument: argument})):
    case delivery(_): broadcast(tail, argument, sent + 1n, then)
    case _: broadcast(tail, argument, sent, then)
# Rows as observers read them (docs/RELATIONAL.md section 7). An observer whose method is
# `rows` is told the rows a write inserted into a relation, `{field, rows}`, each row its
# columns by name with natural or text values (Data cannot be read in Bend, so the observed
# object projects its own rows to this shape); every other observer gets the object's own
# message (`ownObservers`), so a door told on a ring is never sent rows.
record Column:
  column: String
  value: Relations.Cell
type Row = Lists.List<Column>
type Rows = Lists.List<Row>
def column(name: String, value: Relations.Cell) -> Column:
  {column: name, value: value}
def rowObservers(observers: Observers) -> Observers:
  Lists.filter(observers, fn(o: Observer) -> Bool: o.method == "rows")
def ownObservers(observers: Observers) -> Observers:
  Lists.filter(observers, fn(o: Observer) -> Bool: o.method != "rows")
def notifyRows<E, S, R, T>(observers: Observers, field: String, inserted: Rows, then: Nat -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  broadcast(rowObservers(observers), {field: field, rows: inserted}, 0n, then)
# A principal's name on a card: the reader's own observed handle (context.handle, which
# the host fills from its registry) when the principal is the reader, else handle(did).
def name(did: String, context: Abi.Context) -> String:
  if did == context.principal && context.handle != "" then context.handle else handle(did)
# A principal's name when the object stored the handle the host knew at the time
# (planterHandle, a rain's handle): that, else name().
def shown(did: String, handle: String, context: Abi.Context) -> String:
  if handle != "" then handle else name(did, context)
# What a card shows for a principal, never the raw DID: the last segment of the DID,
# and of a long one (a real did:plc is 24 characters) only its last eight after "…".
# The host will put the observed handle in the Context; until then this is the name.
def handle(did: String) -> String:
  if textTake(did, 4n) == "did:" then shortened(segment(did)) else did
def segment(did: String) -> String:
  let at = textBreak(did, ":")
  if at == textLength(did) then did else segment(textDrop(did, at + 1n))
def shortened(fragment: String) -> String:
  if textLength(fragment) > 8n then "…{textDrop(fragment, textLength(fragment) - 8n)}" else fragment
# The first `shown` lines, then "… and N more".
def clipped(lines: Document.Documents, shown: Nat) -> Document.Documents:
  let total = Lists.length(lines)
  if total > shown then Lists.concat(Lists.take(lines, shown), Document.Documents.cons({head: Document.text("… and {natText(total - shown)} more\n"), tail: Document.Documents.nil()})) else lines
# Doors on any card (the convention): an object keeps `doors: Doorways` in its state and
# its Edits (`Plans.Entries<Doorway, {}>`), offers the `door {label, to}` and `undoor
# {label}` forms to its owner (refused by name to anyone else, and by its owner law where
# it has one), and lists them on its card as the directory does (`doorLines`).
record Doorway:
  label: String
  to: Plans.Reference
type Doorways = Lists.List<Doorway>
sum DoorEdit:
  edit: {entries: Plans.Entries<Doorway, {}>}
  refused: Refusal
def doorForm() -> Form.Form:
  {card: "", action: "door", fields: Form.Fields.cons({head: {name: "label", kind: Form.Kind.text({min: 1n, max: 32n})}, tail: Form.Fields.cons({head: {name: "to", kind: Form.Kind.text({min: 1n, max: 160n})}, tail: Form.Fields.nil()})})}
def undoorForm() -> Form.Form:
  {card: "", action: "undoor", fields: Form.Fields.cons({head: {name: "label", kind: Form.Kind.text({min: 1n, max: 32n})}, tail: Form.Fields.nil()})}
def dooring(doors: Doorways, owner: String, action: String, fields: Fields, context: Abi.Context) -> DoorEdit:
  if context.principal != owner then DoorEdit.refused({clause: "notOwner", reading: "Only {name(owner, context)} changes this card's doors"}) else if action == "door" then added(doors, {label: text(fields, "label"), to: {world: context.world, object: text(fields, "to")}}) else removed(doors, text(fields, "label"))
def added(doors: Doorways, door: Doorway) -> DoorEdit:
  if Lists.any(doors, fn(d: Doorway) -> Bool: d.label == door.label) then DoorEdit.refused({clause: "doorTaken", reading: "There is already a door called {door.label}"}) else if Lists.length(doors) >= 8n then DoorEdit.refused({clause: "doorsFull", reading: "A card holds eight doors"}) else DoorEdit.edit({entries: Plans.Entries.append({item: door})})
def removed(doors: Doorways, label: String) -> DoorEdit:
  match Lists.find(doors, fn(d: Doorway) -> Bool: d.label == label):
    case some(d): DoorEdit.edit({entries: Plans.Entries.removeItem({item: d.value})})
    case none(_): DoorEdit.refused({clause: "noDoor", reading: "There is no door called {label}"})
def doorLines(doors: Doorways) -> Document.Documents:
  Lists.map(doors, fn(d: Doorway) -> Document.Document: Document.text("{d.label}: {d.to.object}\n"))
# The page's merge (FOUNDATION section 4): its human owner replies `merge` to the
# posted page or an edit, and the object records that post as its page checkpoint. An
# object with a page keeps `owner` and `pageCheckpoint` in state and, before routing,
# answers isMerge(text) with merge, giving the Edits that set its checkpoint (put).
def isMerge(text: String) -> Bool:
  let rest = textDrop(text, textSpan(text, " \n\t\r"))
  textTake(rest, 5n) == "merge" && textSpan(textDrop(rest, 5n), " \n\t\r") == textLength(rest) - 5n
def merge<E, S, R, T>(post: String, owner: String, context: Abi.Context, put: String -> E, done: T, refused: Refusal -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  if owner == "" || context.principal != owner then tellPlan(refused({clause: "notOwner", reading: notOwner(owner)}), Document.text("Not merged: {notOwner(owner)}\n")) else if post == "" then tellPlan(refused({clause: "noPost", reading: "A merge names the post it answers."}), Document.text("Not merged: a merge names the post it answers.\n")) else checkpointed(post, put(post), context, done)
def notOwner(owner: String) -> String:
  if owner == "" then "This page has no owner to merge it." else "Only the page's owner, {handle(owner)}, merges it."
def checkpointed<E, S, R, T>(post: String, edits: E, context: Abi.Context, done: T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  let written(_) = perform(Plans.Plan.write({object: Plans.self(context), edits: edits}))
  tellPlan(done, Document.text("Page checkpointed at {post}.\n"))
# The card's line for it: "" before the first merge.
def checkpointLine(post: String) -> String:
  if post == "" then "" else "page checkpointed at {post}\n"
# The object-owned wiki page (FOUNDATION section 4): a list of sections, each a title
# and a Document. The default is the card, then how to reply; an object overrides
# page(state, context) to add its own sections. pageText renders the agentwiki body:
# each section as "## Title" and its text.
record Section:
  title: String
  body: Document.Document
type Page = Lists.List<Section>
def defaultPage(card: Document.Document, context: Abi.Context, forms: Forms) -> Page:
  Page.cons({head: {title: "Card", body: card}, tail: Page.cons({head: {title: "How to reply", body: usage(context.object, forms)}, tail: Page.nil()})})
# The context a public page is rendered for: nobody's, at the publishing object.
def public(context: Abi.Context) -> Abi.Context:
  extend(stranger(), {object: context.object, world: context.world})
# Posts an object's page as its door word's wiki page (genesis posts one card per door):
# `publish {page: blurb().word, section: "", body}`; the post, or the refusal's clause.
# The page's name: the one given, else the door word (genesis posts the Scene as `rooms`).
def pageName(page: String, word: String) -> String:
  if page == "" then word else page
def publishPagePlan<E, S, R>(word: String, page: Page) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, String>:
  match perform(Plans.Plan.publish({page: word, section: "", body: pageText(page)})):
    case published(p): p.post
    case refused(r): r.clause
    case _: ""
def pageText(page: Page) -> String:
  textJoin(Lists.map(page, fn(section: Section) -> String: "## {section.title}\n\n{Document.plain(section.body)}"), "\n")
# Interpretation, the card default (FOUNDATION section 5). A card with a policy views it
# (its Response's state type is Policies.State) and asks the model with `asking`, offering
# its forms. It reads the model's words (`replied {text}`) with `fitting`: a spell that fits
# an offered form is a hit; `unclear: not addressed` (or an empty `unclear:`) is silence; a
# spell that does not fit, any other `unclear: <need>` and words that are no spell are a
# miss with the needs computed. A miss is asked ONCE more: the utterance with
# "missing: <needs>", naming the policy's escalate model. A second miss is answered with
# the needs card to the speaker (none when nothing is named) and, when the policy has an
# escalateTo principal, a short copy to that principal (`escalation`, `unfit`).
sum Fitted:
  hit: {card: String, parsed: Spell.Parsed}
  miss: {needs: Form.Names}
  silent: {}
def fitting(text: String, forms: Forms) -> Fitted:
  fittedSpell(Spell.parse(text), textDrop(text, textSpan(text, " \n\t\r")), forms)
def fittedSpell(parsed: Spell.Parsed, text: String, forms: Forms) -> Fitted:
  match parsed:
    case spell(s): fittedForm(parsed, s.card, s.action, Lists.find(forms, fn(f: Form.Form) -> Bool: f.card == s.card && f.action == s.action))
    case notASpell(_): if textTake(text, 8n) == "unclear:" then needOf(Spell.trimEnd(Spell.trimStart(textTake(textDrop(text, 8n), textBreak(textDrop(text, 8n), "\n"))))) else Fitted.miss({needs: Form.Names.nil()})
def fittedForm(parsed: Spell.Parsed, card: String, action: String, found: Lists.Maybe<Form.Form>) -> Fitted:
  match found:
    case none(_): Fitted.miss({needs: one("{card} {action} is not offered")})
    case some(f): fitOf(card, parsed, Spell.fit(parsed, f.value))
def fitOf(card: String, parsed: Spell.Parsed, fit: Spell.Fit) -> Fitted:
  match fit:
    case proposal(_): Fitted.hit({card: card, parsed: parsed})
    case unclear(u): Fitted.miss({needs: u.needs})
    case refused(r): Fitted.miss({needs: one(r.reason)})
def needOf(need: String) -> Fitted:
  if need == "" || need == "not addressed" then Fitted.silent({}) else Fitted.miss({needs: one(need)})
def one(need: String) -> Form.Names:
  Form.Names.cons({head: need, tail: Form.Names.nil()})
# Completing a spell (the card default): a reply that is only `name: value` lines (blank
# lines aside) fills the open fields of the spell a card holds for its speaker, so "I still
# need: colour" is answered by `colour: silver`. spellText is a parsed spell as text again.
def onlyFields(text: String) -> Bool:
  Lists.length(Spell.bare(text)) > 0n && fieldLinesOnly(text)
def fieldLinesOnly(text: String) -> Bool:
  if text == "" then true else fieldLineAt(Spell.trimStart(Spell.trimEnd(textTake(text, textBreak(text, "\n")))), textDrop(text, textBreak(text, "\n") + 1n))
def fieldLineAt(line: String, rest: String) -> Bool:
  (line == "" || textTake(line, 3n) == "```" || Spell.looksLikeField(line)) && fieldLinesOnly(rest)
def spellText(card: String, action: String, bindings: Spell.Bindings) -> String:
  textJoin(Lists.List.cons({head: "delvetalk {card} {action}", tail: Lists.map(bindings, fn(b: Spell.Binding) -> String: "{b.name}: {b.value}")}), "\n")
def completed(held: String, text: String) -> String:
  "{held}\n{text}"
# Whether an interpreted proposal of this action waits for the speaker's yes.
def confirms(policy: Policies.State, action: String) -> Bool:
  Lists.any(policy.confirmFor, fn(a: String) -> Bool: a == action)
# A bare answer to a card that asked first: yes, no, or anything else. Only a short reply is
# read (64 scalars), blanks around it and a closing . or ! aside, as one of the common words
# (there is no case folding, so each is listed as people write it). A card holding a
# proposal for the speaker reads this before anything else, and never asks a model about it.
sum Answer:
  yes: {}
  no: {}
  other: {}
def answerOf(text: String) -> Answer:
  if textLength(textTake(text, 65n)) > 64n then Answer.other({}) else answerWord(endTrimmed(textDrop(text, textSpan(text, " \t\r\n"))))
def answerWord(word: String) -> Answer:
  if Lists.any(yesWords(), fn(w: String) -> Bool: w == word) then Answer.yes({}) else if Lists.any(noWords(), fn(w: String) -> Bool: w == word) then Answer.no({}) else Answer.other({})
def yesWords() -> Lists.List<String>:
  Lists.concat(wordList("yes Yes YES y Y yeah Yeah yep Yep ok Ok OK okay Okay sure Sure"), Lists.List.cons({head: "go ahead", tail: Lists.List.cons({head: "Go ahead", tail: Lists.List.cons({head: "do it", tail: Lists.List.cons({head: "Do it", tail: Lists.List.nil({})})})})}))
def noWords() -> Lists.List<String>:
  Lists.concat(wordList("no No NO n N nope Nope cancel Cancel"), Lists.List.cons({head: "never mind", tail: Lists.List.cons({head: "Never mind", tail: Lists.List.nil({})})}))
# Whether a host verdict `unclear {needs}` says the prose was addressed to nobody.
def notAddressed(needs: Form.Names) -> Bool:
  Lists.any(needs, fn(need: String) -> Bool: need == "not addressed")
# The interpret Plan of attempt 0 (the utterance, the policy's model) or 1 (the utterance
# with what the first answer missed, the policy's escalate model).
def asking<E>(utterance: String, forms: Forms, reference: Plans.Reference, policy: Policies.State, attempt: Nat, needs: Form.Names) -> Plans.Plan<E>:
  if attempt == 0n then Plans.Plan.interpret({utterance: utterance, offers: forms, policy: reference, model: ""}) else Plans.Plan.interpret({utterance: retried(utterance, needs), offers: forms, policy: reference, model: policy.escalate})
def retried(utterance: String, needs: Form.Names) -> String:
  "{utterance}\n\nmissing: {missing(needs)}"
def missing(needs: Form.Names) -> String:
  match needs:
    case nil(_): "one spell for an offered form, or unclear: <what is missing>"
    case cons(_): Spell.joined(needs)
# The short copy for the policy's escalateTo principal.
def escalation<E>(policy: Policies.State, utterance: String, context: Abi.Context) -> Plans.Plan<E>:
  Plans.Plan.offer({to: policy.escalateTo, document: Document.text("{name(context.principal, context)} said: {utterance}; I could not fit it ({context.object}).\n")})
# The second miss of a card with no writes of its own to make: the copy to escalateTo (when
# the policy names one), then the needs card to the speaker (when a need is named).
def unfit<E, R, T>(policy: Policies.State, utterance: String, needs: Form.Names, context: Abi.Context, card: Document.Document, result: T) -> Activity<Plans.Plan<E>, Plans.Response<Policies.State, R>, T>:
  if policy.escalateTo == "" then needed(needs, card, result) else escalating(policy, utterance, needs, context, card, result)
def escalating<E, R, T>(policy: Policies.State, utterance: String, needs: Form.Names, context: Abi.Context, card: Document.Document, result: T) -> Activity<Plans.Plan<E>, Plans.Response<Policies.State, R>, T>:
  match perform(escalation(policy, utterance, context)):
    case _: needed(needs, card, result)
def needed<E, S, R, T>(needs: Form.Names, card: Document.Document, result: T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match needs:
    case nil(_): result
    case cons(_): tellPlan(result, card)
# Macros (the policy's, checked before the model): `expanded` is the spell text of the first
# macro whose pattern the utterance matches (blanks and a trailing . ! or ? aside), none when
# none does. Patterns and utterances are compared word by word; a hole takes the shortest run
# of words that lets the rest match.
record Capture:
  hole: String
  text: String
type Captures = Lists.List<Capture>
def expanded(text: String, policy: Policies.State) -> Lists.Maybe<String>:
  expandedBy(words(endTrimmed(text)), policy.macros)
def expandedBy(said: Lists.List<String>, macros: Lists.List<Policies.Macro>) -> Lists.Maybe<String>:
  match macros:
    case nil(_): Lists.Maybe.none({})
    case cons(c): expandedWith(c.head, matched(words(c.head.pattern), said), said, c.tail)
def expandedWith(macro: Policies.Macro, found: Lists.Maybe<Captures>, said: Lists.List<String>, rest: Lists.List<Policies.Macro>) -> Lists.Maybe<String>:
  match found:
    case some(f): Lists.Maybe.some({value: "delvetalk {filled(macro.expansion, f.value)}"})
    case none(_): expandedBy(said, rest)
def endTrimmed(text: String) -> String:
  let size = textLength(text)
  if size == 0n then text else if textSpan(textDrop(text, size - 1n), " \t\r\n.!?") == 1n then endTrimmed(textTake(text, size - 1n)) else text
def words(text: String) -> Lists.List<String>:
  wordsFrom(textDrop(text, textSpan(text, " \t\r\n")))
def wordsFrom(text: String) -> Lists.List<String>:
  if text == "" then Lists.List.nil({}) else Lists.List.cons({head: textTake(text, textBreak(text, " \t\r\n")), tail: words(textDrop(text, textBreak(text, " \t\r\n")))})
def isHole(word: String) -> Bool:
  textLength(word) > 2n && textTake(word, 1n) == "{{" && textDrop(word, textLength(word) - 1n) == "}}"
def holeName(word: String) -> String:
  textTake(textDrop(word, 1n), textLength(word) - 2n)
def matched(pattern: Lists.List<String>, said: Lists.List<String>) -> Lists.Maybe<Captures>:
  match pattern:
    case nil(_): if Lists.length(said) == 0n then Lists.Maybe.some({value: Captures.nil({})}) else Lists.Maybe.none({})
    case cons(p): if isHole(p.head) then captured(holeName(p.head), "", p.tail, said) else literal(p.head, p.tail, said)
def literal(word: String, pattern: Lists.List<String>, said: Lists.List<String>) -> Lists.Maybe<Captures>:
  match said:
    case nil(_): Lists.Maybe.none({})
    case cons(s): if s.head == word then matched(pattern, s.tail) else Lists.Maybe.none({})
def captured(hole: String, sofar: String, pattern: Lists.List<String>, said: Lists.List<String>) -> Lists.Maybe<Captures>:
  match said:
    case nil(_): Lists.Maybe.none({})
    case cons(s): capturedAt(hole, if sofar == "" then s.head else "{sofar} {s.head}", pattern, s.tail)
def capturedAt(hole: String, text: String, pattern: Lists.List<String>, rest: Lists.List<String>) -> Lists.Maybe<Captures>:
  match matched(pattern, rest):
    case some(m): Lists.Maybe.some({value: Captures.cons({head: {hole: hole, text: text}, tail: m.value})})
    case none(_): captured(hole, text, pattern, rest)
# The expansion with each `{hole}` replaced by its capture (an unknown hole stays as written).
def filled(expansion: String, captures: Captures) -> String:
  let open = textBreak(expansion, "{{")
  if open == textLength(expansion) then expansion else holeAt(textTake(expansion, open), textDrop(expansion, open + 1n), captures)
def holeAt(before: String, after: String, captures: Captures) -> String:
  let close = textBreak(after, "}}")
  if close == textLength(after) then "{before}{{{after}" else "{before}{captureOf(textTake(after, close), captures)}{filled(textDrop(after, close + 1n), captures)}"
def captureOf(hole: String, captures: Captures) -> String:
  match Lists.find(captures, fn(c: Capture) -> Bool: c.hole == hole):
    case some(c): c.value.text
    case none(_): "{{{hole}}}"
# The policy's macros on a usage card.
def macroUsage(policy: Policies.State) -> Document.Document:
  if Lists.length(policy.macros) == 0n then Document.text("") else Document.Document.sequence({items: Document.Documents.cons({head: Document.text("\nShortcuts (no model is asked):\n"), tail: Lists.map(policy.macros, macroLine)})})
def macroLine(macro: Policies.Macro) -> Document.Document:
  Document.text("    {macro.pattern}\n      means: delvetalk {macro.expansion}\n")
# The message dialect (docs/WHOLENESS.md section 2; root decisions, second set, item 4).
# A card in the message dialect has, for each action it offers, a method of that name whose
# input is a record of text, natural and empty-payload sum fields: the host reads a reply's
# spell, fits it against the method table and runs the method; a spell that does not fit is
# refused `badSpell` with its clause, reason and hint, and `?` is answered by the host. What
# runs no method reaches `receive(state, input: Reply, context)`: blank text, prose, a spell
# missing fields and field lines naming none of the card's forms, with the reply's
# `name: value` lines in `fields`. `answer` is the default for those.
record Reply:
  text: String
  post: String
  fields: Spell.Bindings
# Offers a document (to the replier, or to one principal) and finishes with the given result.
def tell<T>(result: T, document: Document.Document) -> Activity<T>:
  match world.offer({to: "", document: document}):
    case _: result
def tellTo<T>(result: T, to: String, document: Document.Document) -> Activity<T>:
  match world.offer({to: to, document: document}):
    case _: result
# The default receive. Blank text gets the card and its forms; a spell the host found missing
# fields gets the card with what it still needs; anything else is not addressed to the card
# (the quiet rule: no offer at all, so the bridge drafts nothing) and is handed on to the
# directory. `answerAs` finishes with the object's own result type: `as` maps the Replied.
def answer(input: Reply, context: Abi.Context, forms: Forms, card: Document.Document) -> Activity<Replied>:
  answerAs(input, context, forms, card, fn(replied: Replied) -> Replied: replied)
def answerAs<T>(input: Reply, context: Abi.Context, forms: Forms, card: Document.Document, as: Replied -> T) -> Activity<T>:
  let replied = unanswered(input, forms)
  if quietly(replied) then handOn(input, context, as(replied)) else tell(as(replied), answerCard(card, whyNot(replied), context, forms))
def unanswered(input: Reply, forms: Forms) -> Replied:
  if blank(input.text) then Replied.usage({}) else spellMissing(Spell.parse(input.text), input.fields, forms)
# A spell line in a reply that ran no method is one the host found missing fields (it refuses
# every other misfit): the card names what it still needs.
def spellMissing(parsed: Spell.Parsed, fields: Spell.Bindings, forms: Forms) -> Replied:
  match parsed:
    case notASpell(_): Replied.silent({})
    case spell(s): needing(Lists.find(forms, fn(f: Form.Form) -> Bool: f.action == s.action), fields)
def needing(form: Lists.Maybe<Form.Form>, fields: Spell.Bindings) -> Replied:
  match form:
    case none(_): Replied.usage({})
    case some(f): unclearOf(Lists.map(Lists.filter(f.value.fields, fn(x: Form.Field) -> Bool: Lists.any(fields, fn(b: Spell.Binding) -> Bool: b.name == x.name) == false), fn(x: Form.Field) -> String: x.name))
def unclearOf(needs: Form.Names) -> Replied:
  if Lists.length(needs) == 0n then Replied.usage({}) else Replied.unclear({needs: needs})
# The action of the reply's spell line, "" when it has none: what a card completes from its
# own policy (a Deal's countersign cites the reply's post).
def spellAction(text: String) -> String:
  match Spell.parse(text):
    case spell(s): s.action
    case notASpell(_): ""
def quietly(replied: Replied) -> Bool:
  match replied:
    case silent(_): true
    case _: false
# Why a card answered without acting, as its card shows it ("" for the plain usage).
def whyNot(replied: Replied) -> String:
  match replied:
    case unclear(u): "\nNot done: Almost. I still need: {Spell.joined(u.needs)}.\n"
    case refused(r): "\nrefused {r.clause}: {r.reading}\n"
    case _: ""
# The card a reply that ran no method gets: the object's card, then why, then its forms.
def answerCard(card: Document.Document, why: String, context: Abi.Context, forms: Forms) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: card, tail: Document.Documents.cons({head: Document.text(why), tail: Document.Documents.cons({head: usage(context.object, forms), tail: Document.Documents.nil()})})})})
# Refuses by name: the card with `refused <clause>: <reading>` and its forms.
def answerRefused<T>(refusal: Refusal, context: Abi.Context, forms: Forms, card: Document.Document, as: Replied -> T) -> Activity<T>:
  tell(as(Replied.refused(refusal)), answerCard(card, whyNot(Replied.refused(refusal)), context, forms))
# Prose a card does not take is sent to the directory (`receive {text, post}`, under the
# speaker), which judges whether it names any door; the card offers nothing itself. A turn
# some object started, and the directory itself, hand nothing on (`handsOn`).
# TODO(directory): send `fields` too when the Directory's receive takes a Reply.
def handOn<T>(input: Reply, context: Abi.Context, result: T) -> Activity<T>:
  if handsOn(input.text, context) then handingOn(input, context, result) else result
def handingOn<T>(input: Reply, context: Abi.Context, result: T) -> Activity<T>:
  match world.send({object: directory(context), method: "receive", argument: {text: input.text, post: input.post}}):
    case _: result
# Posts an object's page as its door word's wiki page; the post, or the refusal's clause.
def publishPage(word: String, page: Page) -> Activity<String>:
  match world.publish({page: word, section: "", body: pageText(page)}):
    case published(p): p.post
    case refused(r): r.clause
# Subscriptions (WHOLENESS section 3; root decisions, second set, item 3): a standing request
# that the host deliver `changed` to the named receiver of this object after each admitted
# write of the object's field, with the rows or items inserted and retracted (a scalar's new
# and old value as one-item lists), typed by the receiver's input. `subscribing` finishes with
# `result` whatever the host answered; `subscribed` with whether it holds.
def subscribing<T>(object: Plans.Reference, field: String, method: String, result: T) -> Activity<T>:
  match world.subscribe({object: object, field: field, method: method}):
    case _: result
def subscribed(object: Plans.Reference, field: String, method: String) -> Activity<Bool>:
  match world.subscribe({object: object, field: field, method: method}):
    case subscribed(_): true
    case _: false
