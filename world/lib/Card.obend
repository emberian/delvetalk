edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Spell.obend as Spell
import ./Plan.obend as Plans
# The uniform card protocol. Every object has a pure render(state, context) ->
# Document (its card as the reader in the context sees it: a member may see more than a
# stranger; the host's `card {object}` passes the reader's context), exports forms() (the
# actions its card offers, as data) and door() (its line in a directory), and takes
# receive {text, post, slot} as the one message the town sends.
# route reads a reply: a spell naming this object and one of its forms becomes
# `act` with typed fields; the object matches the action to its own method. What
# is not acted on is answered by `answer`, which offers the card with its forms.
# `delvetalk <card> set` with one `<field>: <value>` line routes to `set`, which
# `answerLensed` performs through the object's lenses (Form.Lens); `delvetalk <card> ?`
# routes to `help`, answered with the usage card: every form and every lens.
#
# A form's card is "" in forms(): the card a spell names is the object's id, which
# route and usage take from the context.
# slot names the awaiting post a reply answers, "" when it answers none.
record Heard:
  text: String
  post: String
  slot: String
record Door:
  word: String
  blurb: String
type Forms = Lists.List<Form.Form>
# The typed fields of an acted spell.
type Fields = Spell.Entries
sum Routed:
  act: {action: String, fields: Fields}
  usage: {}
  unclear: {action: String, needs: Form.Names}
  refused: {reason: String}
  set: {field: String, value: String}
  help: {}
# What receive answers when no method was acted on.
sum Reply:
  done: {action: String}
  usage: {}
  unclear: {needs: Form.Names}
  refused: {reason: String}
def named(form: Form.Form, card: String) -> Form.Form:
  {card: card, action: form.action, fields: form.fields}
def route(text: String, context: Abi.Context, forms: Forms) -> Routed:
  routeParsed(Spell.parse(text), context, forms)
def routeParsed(parsed: Spell.Parsed, context: Abi.Context, forms: Forms) -> Routed:
  match parsed:
    case notASpell(_): Routed.usage({})
    case spell(s): if s.card != context.object then Routed.refused({reason: textConcat("This card is ", context.object)}) else chosen(parsed, s.action, s.fields, Lists.find::<Form.Form>(forms, fn(form: Form.Form) -> Bool: form.action == s.action), context)
# An object's own form wins; otherwise `set` and `?` are the protocol's.
def chosen(parsed: Spell.Parsed, action: String, bindings: Spell.Bindings, found: Lists.Maybe<Form.Form>, context: Abi.Context) -> Routed:
  match found:
    case none(_): if action == "set" then setting(bindings) else if action == "?" then Routed.help({}) else Routed.refused({reason: textConcat("No action called ", action)})
    case some(f): fitted(action, Spell.fit(parsed, named(f.value, context.object)))
def setting(bindings: Spell.Bindings) -> Routed:
  match bindings:
    case cons(c): if Lists.length::<Spell.Binding>(c.tail) == 0n then Routed.set({field: c.head.name, value: c.head.value}) else Routed.refused({reason: "set takes one field: value line."})
    case nil(_): Routed.refused({reason: "set takes one field: value line."})
def fitted(action: String, fit: Spell.Fit) -> Routed:
  match fit:
    case proposal(p): Routed.act({action: action, fields: p.bindings})
    case unclear(u): Routed.unclear({action: action, needs: u.needs})
    case refused(r): Routed.refused({reason: r.reason})
# Typed field values of an acted spell; a field the form does not have is "" or 0.
def text(fields: Spell.Entries, name: String) -> String:
  match Lists.find::<Spell.Entry>(fields, fn(entry: Spell.Entry) -> Bool: entry.name == name):
    case none(_): ""
    case some(s):
      match s.value.value:
        case text(t): t.value
        case choice(c): c.value
        case natural(n): natText(n.value)
def natural(fields: Spell.Entries, name: String) -> Nat:
  match Lists.find::<Spell.Entry>(fields, fn(entry: Spell.Entry) -> Bool: entry.name == name):
    case none(_): 0n
    case some(s):
      match s.value.value:
        case natural(n): n.value
        case _: 0n
def hint(kind: Form.Kind) -> String:
  match kind:
    case text(t): textConcat("<text, ", textConcat(natText(t.min), textConcat(" to ", textConcat(natText(t.max), " characters>"))))
    case natural(n): textConcat("<a number from ", textConcat(natText(n.min), textConcat(" to ", textConcat(natText(n.max), ">"))))
    case choice(c): textConcat("<", textConcat(Spell.joined(c.options), ">"))
# One form as the spell a reader copies.
def template(card: String, form: Form.Form) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text(textConcat("\n    delvetalk ", textConcat(card, textConcat(" ", textConcat(form.action, "\n"))))), tail: Lists.map::<Form.Field, Document.Document>(form.fields, fn(field: Form.Field) -> Document.Document: Document.text(textConcat("    ", textConcat(field.name, textConcat(": ", textConcat(hint(field.kind), "\n"))))))})})
def usage(card: String, forms: Forms) -> Document.Document:
  if Lists.length::<Form.Form>(forms) == 0n then Document.text("") else Document.Document.sequence({items: Document.Documents.cons({head: Document.text("\nReply with a spell:\n"), tail: Lists.map::<Form.Form, Document.Document>(forms, fn(form: Form.Form) -> Document.Document: template(card, form))})})
# One lens as the set spell a reader copies.
def lensTemplate<E>(card: String, lens: Form.Lens<E>) -> Document.Document:
  match lens:
    case lens(l): Document.text(textConcat("\n    delvetalk ", textConcat(card, textConcat(" set\n    ", textConcat(l.field, textConcat(": ", textConcat(hint(l.form), "\n")))))))
def lensUsage<E>(card: String, lenses: Lists.List<Form.Lens<E>>) -> Document.Document:
  if Lists.length::<Form.Lens<E>>(lenses) == 0n then Document.text("") else Document.Document.sequence({items: Document.Documents.cons({head: Document.text("\nTo change a field, reply (one field a spell):\n"), tail: Lists.map::<Form.Lens<E>, Document.Document>(lenses, fn(lens: Form.Lens<E>) -> Document.Document: lensTemplate::<E>(card, lens))})})
# The usage card `?` answers: every form, then every lens.
def help<E>(card: String, forms: Forms, lenses: Lists.List<Form.Lens<E>>) -> Document.Document:
  Document.concat(usage(card, forms), lensUsage::<E>(card, lenses))
# The card a non-acting reply gets: the object's card, then why, then its forms.
def why(routed: Routed) -> String:
  match routed:
    case act(a): ""
    case usage(_): ""
    case _: textConcat("\nNot done: ", textConcat(reason(routed), "\n"))
def replyOf(routed: Routed) -> Reply:
  match routed:
    case act(a): Reply.done({action: a.action})
    case unclear(u): Reply.unclear({needs: u.needs})
    case refused(r): Reply.refused({reason: r.reason})
    case usage(_): Reply.usage({})
    case help(_): Reply.usage({})
    case set(_): Reply.refused({reason: "Nothing here can be set."})
def answered(routed: Routed, context: Abi.Context, forms: Forms, card: Document.Document) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: card, tail: Document.Documents.cons({head: Document.text(why(routed)), tail: Document.Documents.cons({head: usage(context.object, forms), tail: Document.Documents.nil()})})})})
def answer<E, S, R>(routed: Routed, context: Abi.Context, forms: Forms, card: Document.Document) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, Reply>:
  match perform(Plans.Plan::<E>.offer({to: "", document: answeredOrHelp(routed, context, forms, card)})):
    case _: replyOf(routed)
# `?` gets the usage card alone; anything else the card, why, and the forms.
def answeredOrHelp(routed: Routed, context: Abi.Context, forms: Forms, card: Document.Document) -> Document.Document:
  match routed:
    case help(_): usage(context.object, forms)
    case _: answered(routed, context, forms, card)
# The same answer for an object whose receive finishes with its methods' own result
# type: `result` is what a non-acting reply finishes with.
def answerAs<E, S, R, T>(routed: Routed, context: Abi.Context, forms: Forms, card: Document.Document, result: T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match perform(Plans.Plan::<E>.offer({to: "", document: answeredOrHelp(routed, context, forms, card)})):
    case _: result
def reason(routed: Routed) -> String:
  match routed:
    case act(a): ""
    case usage(_): "Reply with a spell."
    case unclear(u): textConcat("Almost. I still need: ", textConcat(Spell.joined(u.needs), "."))
    case refused(r): r.reason
    case help(_): ""
    case set(_): "Nothing here can be set."
# Lenses. answerLensed is answer for an object with lenses: a `set` is judged against
# the lens's kind and written through its put (the object's law judges the write; a
# non-empty guard refuses first, by name), `?` offers the usage card with the lenses.
def lensNamed<E>(lenses: Lists.List<Form.Lens<E>>, field: String) -> Lists.Maybe<Form.Lens<E>>:
  Lists.find::<Form.Lens<E>>(lenses, fn(lens: Form.Lens<E>) -> Bool: lensField::<E>(lens) == field)
def lensField<E>(lens: Form.Lens<E>) -> String:
  match lens:
    case lens(l): l.field
def answerLensed<E, S, R>(routed: Routed, context: Abi.Context, forms: Forms, lenses: Lists.List<Form.Lens<E>>, guard: String, card: Document.Document) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, Reply>:
  answerLensedAs::<E, S, R, Reply>(routed, context, forms, lenses, guard, card, fn(reply: Reply) -> Reply: reply)
# The same for an object whose receive finishes with its own result type: `as` maps the
# protocol's Reply to it.
def answerLensedAs<E, S, R, T>(routed: Routed, context: Abi.Context, forms: Forms, lenses: Lists.List<Form.Lens<E>>, guard: String, card: Document.Document, as: Reply -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match routed:
    case set(s): putting::<E, S, R, T>(s.field, s.value, lensNamed::<E>(lenses, s.field), guard, context, forms, card, as)
    case help(_): tell::<E, S, R, T>(as(Reply.usage({})), help::<E>(context.object, forms, lenses))
    case _: answerAs::<E, S, R, T>(routed, context, forms, card, as(replyOf(routed)))
def refusing<E, S, R, T>(reason: String, context: Abi.Context, forms: Forms, card: Document.Document, as: Reply -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  answerAs::<E, S, R, T>(Routed.refused({reason: reason}), context, forms, card, as(Reply.refused({reason: reason})))
def putting<E, S, R, T>(field: String, value: String, found: Lists.Maybe<Form.Lens<E>>, guard: String, context: Abi.Context, forms: Forms, card: Document.Document, as: Reply -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match found:
    case none(_): refusing::<E, S, R, T>(textConcat("No field called ", textConcat(field, " can be set here.")), context, forms, card, as)
    case some(f): if guard != "" then refusing::<E, S, R, T>(guard, context, forms, card, as) else judgedPut::<E, S, R, T>(f.value, value, context, forms, card, as)
def judgedPut<E, S, R, T>(lens: Form.Lens<E>, value: String, context: Abi.Context, forms: Forms, card: Document.Document, as: Reply -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match lens:
    case lens(l): verdictPut::<E, S, R, T>(Spell.judge({name: l.field, kind: l.form}, value), l.put(Spell.typed(l.form, value)), l.field, value, context, forms, card, as)
def verdictPut<E, S, R, T>(verdict: Spell.Verdict, edits: E, field: String, value: String, context: Abi.Context, forms: Forms, card: Document.Document, as: Reply -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match verdict:
    case wrong(w): refusing::<E, S, R, T>(w.reason, context, forms, card, as)
    case fine(_): put::<E, S, R, T>(edits, field, value, context, as)
def put<E, S, R, T>(edits: E, field: String, value: String, context: Abi.Context, as: Reply -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match perform(Plans.Plan::<E>.write({object: Plans.self(context), edits: edits})):
    case _: tell::<E, S, R, T>(as(Reply.done({action: "set"})), Document.text(textConcat("Set ", textConcat(field, textConcat(" to ", textConcat(value, ".\n"))))))
# A lens's value as text or as a natural (0 when the kind is not a number).
def valueText(value: Form.Value) -> String:
  match value:
    case text(t): t.value
    case choice(c): c.value
    case natural(n): natText(n.value)
def valueNatural(value: Form.Value) -> Nat:
  match value:
    case natural(n): n.value
    case _: 0n
# The context of a reader nobody is: what a card shows a
# stranger. Mine is "(yours)" when the principal is the reader.
def stranger() -> Abi.Context:
  {world: "", object: "", principal: "", handle: "", caller: "", intent: "", height: 0n, inputOrigin: {kind: "", object: "", command: "", program: "", immediatelyPrevious: false}}
def reads(principal: String, context: Abi.Context) -> Bool:
  principal != "" && principal == context.principal
def mine(principal: String, context: Abi.Context) -> String:
  if reads(principal, context) then " (yours)" else ""
# Offers a document addressed to one principal and finishes with the given result.
def tellTo<E, S, R, T>(result: T, to: String, document: Document.Document) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match perform(Plans.Plan::<E>.offer({to: to, document: document})):
    case _: result
# Offers a document and finishes with the given result.
def tell<E, S, R, T>(result: T, document: Document.Document) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match perform(Plans.Plan::<E>.offer({to: "", document: document})):
    case _: result
# Observers: the objects told when something happens here, each by the method it
# names. An object keeps `observers: Observers` in state and exposes observe and
# unobserve by calling these with the Edits builder for that one field.
record Observer:
  object: Plans.Reference
  method: String
type Observers = Lists.List<Observer>
def sameObserver(left: Observer, right: Observer) -> Bool:
  Plans.same(left.object, right.object) && left.method == right.method
# What an observe or unobserve changes: nothing, one edit of the observers field, or
# a refusal. The object performs the write itself (a generic activity over the
# object's Edits nests the object's types past the packet's capacity when another
# object imports it).
sum Change:
  unchanged: {count: Nat}
  edit: {entries: Plans.Entries<Observer, {}>, count: Nat}
  refused: {reason: String}
def observing(observers: Observers, input: Observer) -> Change:
  observingUpTo(observers, input, 16n)
# The same with the object's own bound (an Avatar's mailing list holds as many as one
# turn may send).
def observingUpTo(observers: Observers, input: Observer, cap: Nat) -> Change:
  if Lists.any::<Observer>(observers, fn(o: Observer) -> Bool: sameObserver(o, input)) then Change.unchanged({count: Lists.length::<Observer>(observers)}) else adding(Lists.length::<Observer>(observers), input, cap)
def adding(count: Nat, input: Observer, cap: Nat) -> Change:
  if count < cap then Change.edit({entries: Plans.Entries::<Observer, {}>.append({item: input}), count: count + 1n}) else Change.refused({reason: "Too many observers."})
def unobserving(observers: Observers, input: Observer) -> Change:
  match Lists.find::<Observer>(observers, fn(o: Observer) -> Bool: sameObserver(o, input)):
    case none(_): Change.refused({reason: "Not observing."})
    case some(s): Change.edit({entries: Plans.Entries::<Observer, {}>.removeItem({item: s.value}), count: Lists.length::<Observer>(observers) - 1n})
# broadcast sends the argument to every observer by its method, then finishes with `then` of
# how many sends the host accepted (an activity composes only in tail position).
def broadcast<E, S, R, T>(observers: Observers, argument: Data, sent: Nat, then: Nat -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match observers:
    case nil(_): then(sent)
    case cons(c): notified::<E, S, R, T>(c.head, c.tail, argument, sent, then)
def notified<E, S, R, T>(head: Observer, tail: Observers, argument: Data, sent: Nat, then: Nat -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match perform(Plans.Plan::<E>.send({object: head.object, method: head.method, argument: argument})):
    case delivery(_): broadcast::<E, S, R, T>(tail, argument, sent + 1n, then)
    case _: broadcast::<E, S, R, T>(tail, argument, sent, then)
# What a card shows for a principal, never the raw DID: the last segment of the DID,
# and of a long one (a real did:plc is 24 characters) only its last eight after "…".
# The host will put the observed handle in the Context; until then this is the name.
def handle(did: String) -> String:
  if textTake(did, 4n) == "did:" then shortened(segment(did)) else did
def segment(did: String) -> String:
  let at = textBreak(did, ":")
  if at == textLength(did) then did else segment(textDrop(did, at + 1n))
def shortened(fragment: String) -> String:
  if textLength(fragment) > 8n then textConcat("…", textDrop(fragment, textLength(fragment) - 8n)) else fragment
# The first `shown` lines, then "… and N more".
def clipped(lines: Document.Documents, shown: Nat) -> Document.Documents:
  let total = Lists.length::<Document.Document>(lines)
  if total > shown then Lists.concat::<Document.Document>(Lists.take::<Document.Document>(lines, shown), Document.Documents.cons({head: Document.text(textConcat("… and ", textConcat(natText(total - shown), " more\n"))), tail: Document.Documents.nil()})) else lines
# The page's merge (FOUNDATION section 4): its human owner replies `merge` to the
# posted page or an edit, and the object records that post as its page checkpoint. An
# object with a page keeps `owner` and `pageCheckpoint` in state and, before routing,
# answers isMerge(text) with merge, giving the Edits that set its checkpoint (put).
def isMerge(text: String) -> Bool:
  let rest = textDrop(text, textSpan(text, " \n\t\r"))
  textTake(rest, 5n) == "merge" && textSpan(textDrop(rest, 5n), " \n\t\r") == textLength(rest) - 5n
def merge<E, S, R, T>(post: String, owner: String, context: Abi.Context, put: String -> E, done: T, refused: String -> T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  if owner == "" || context.principal != owner then tell::<E, S, R, T>(refused(notOwner(owner)), Document.text(textConcat("Not merged: ", textConcat(notOwner(owner), "\n")))) else if post == "" then tell::<E, S, R, T>(refused("A merge names the post it answers."), Document.text("Not merged: a merge names the post it answers.\n")) else checkpointed::<E, S, R, T>(post, put(post), context, done)
def notOwner(owner: String) -> String:
  if owner == "" then "This page has no owner to merge it." else textConcat("Only the page's owner, ", textConcat(handle(owner), ", merges it."))
def checkpointed<E, S, R, T>(post: String, edits: E, context: Abi.Context, done: T) -> Activity<Plans.Plan<E>, Plans.Response<S, R>, T>:
  match perform(Plans.Plan::<E>.write({object: Plans.self(context), edits: edits})):
    case _: tell::<E, S, R, T>(done, Document.text(textConcat("Page checkpointed at ", textConcat(post, ".\n"))))
# The card's line for it: "" before the first merge.
def checkpointLine(post: String) -> String:
  if post == "" then "" else textConcat("page checkpointed at ", textConcat(post, "\n"))
# The object-owned wiki page (FOUNDATION section 4): a list of sections, each a title
# and a Document. The default is the card, then how to reply; an object overrides
# page(state, context) to add its own sections. pageText renders the agentwiki body:
# each section as "## Title" and its text.
record Section:
  title: String
  body: Document.Document
type Page = Lists.List<Section>
def defaultPage(card: Document.Document, context: Abi.Context, forms: Forms) -> Page:
  Page.cons({head: {title: "Card", body: card}, tail: Page.cons({head: {title: "How to reply", body: usage(context.object, forms)}, tail: Page.nil()})})
def pageText(page: Page) -> String:
  textJoin(Lists.map::<Section, String>(page, fn(section: Section) -> String: textConcat("## ", textConcat(section.title, textConcat("\n\n", Document.plain(section.body))))), "\n")
