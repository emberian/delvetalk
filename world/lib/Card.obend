edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Spell.obend as Spell
import ./Text.obend as Text
import ./Plan.obend as Plans
import ./Relation.obend as Relations
import ./World.obend as World
# The card protocol. Every object has a pure render(state, context) -> Document (its card as
# the reader in the context sees it: a member may see more than a stranger; the host's
# `card {object}` passes the reader's context), forms() (the actions its card offers, as
# data; a form's card is "" there, the object's id in a spell) and receive(state, input: Reply, context). The host reads a reply's spell and
# runs the method it names, answers `?` and `set` (through the object's `lenses()` and its
# `set` method); what runs no method reaches receive, which `answer` handles by default.
type Forms = Lists.List<Form.Form>
# A refusal names its clause (an object's `Why` arm, or the protocol's own: notOwner) and gives
# its reading, the next line to type in it when there is one; it is said `refused <clause>: <reading>`.
record Refusal:
  clause: String
  reading: String
def refusalLine(refusal: Refusal) -> String:
  "refused {refusal.clause}: {refusal.reading}"
# What receive answers when no method was acted on: done, usage, unclear, refused, or silent,
# which leaves the words to the host: hob reads them with the card's table (OVERHAUL §2.7).
sum Replied:
  done: {action: String}
  usage: {}
  unclear: {needs: Form.Names}
  refused: Refusal
  silent: {}
def named(form: Form.Form, card: String) -> Form.Form:
  {card: card, action: form.action, fields: form.fields}
def hasField(form: Form.Form, name: String) -> Bool:
  Lists.any(form.fields, fn(f: Form.Field) -> Bool: f.name == name)
# A source field's bound is the host's package bound, `Bounds.maxPackageBytes` (131,072 bytes),
# which Bend cannot read: the literal is that number.
def hint(kind: Form.Kind) -> String:
  match kind:
    case text(t): "<text, {natText(t.min)} to {natText(t.max)} characters>"
    case object(o): if o.min == 0n then "<optional object id, up to {natText(o.max)} characters>" else "<object id, {natText(o.min)} to {natText(o.max)} characters>"
    case natural(n): "<a number from {natText(n.min)} to {natText(n.max)}>"
    case choice(c): "<{Text.joined(c.options)}>"
    case source(_): "<Bend source, 1 to 131072 characters, as a <<BEND block or a ```obend block>"
def tideLine(tide: String) -> String:
  if Text.isObjectId(tide) then "delvetalk {tide} rules" else "keeps hours by no tide you can reach yet"
# One form as the spell a reader copies.
def template(card: String, form: Form.Form) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text("\n    delvetalk {card} {form.action}\n"), tail: Lists.map(form.fields, fn(field: Form.Field) -> Document.Document: Document.text("    {field.name}: {hint(field.kind)}\n"))})})
def usage(card: String, forms: Forms) -> Document.Document:
  if Lists.length(forms) == 0n then Document.text("") else Document.Document.sequence({items: Document.Documents.cons({head: Document.text("\nReply with a spell:\n"), tail: Lists.map(forms, fn(form: Form.Form) -> Document.Document: template(card, form))})})
# A word without one run of marks at its end and one at its start ("anthology," "(play").
def stripped(word: String, n: Nat) -> String:
  let core = textTake(word, n - textSpan(textDrop(word, n - 1n), marks()))
  textDrop(core, textSpan(core, marks()))
def marks() -> String:
  ".,:;!?\"')(*`"
# A lens's value as text or as a natural (0 when the kind is not a number).
def valueText(value: Form.Value) -> String:
  match value:
    case text(t): t.value
    case choice(c): c.value
    case natural(n): natText(n.value)
# The context of a reader nobody is: what a card shows a
# stranger. Mine is "(yours)" when the principal is the reader.
def stranger() -> Abi.Context:
  {world: "", object: "", principal: "", handle: "", town: "", caller: "", sender: "", intent: "", height: 0n, clock: 0n, inputOrigin: {kind: "", object: "", command: "", program: "", immediatelyPrevious: false, post: ""}, room: 1400n}
# The card's own id for a spell it prints: the object rendering it, or `word` for a card
# rendered outside the world (a probe, a page).
def called(context: Abi.Context, word: String) -> String:
  if context.object == "" then word else spellName(context.object, context)
# The name a spell uses for a card: the reader's own avatar is `me` (the host resolves it to the
# speaker's), so a card never prints a DID to its owner.
def spellName(card: String, context: Abi.Context) -> String:
  if card != "" && card == context.principal then "me" else card
# Whether a name can be printed: another's avatar is named by a DID, never shown.
def printable(name: String) -> Bool:
  Text.starts(name, "did:") == false
def reads(principal: String, context: Abi.Context) -> Bool:
  principal != "" && principal == context.principal
def mine(principal: String, context: Abi.Context) -> String:
  if reads(principal, context) then " (yours)" else ""
# The world's own principal (context.town, its opener), which every card names "the town",
# whatever handle was kept for it.
def town(did: String, context: Abi.Context) -> Bool:
  did != "" && did == context.town
# A principal's name on a card: the town as such; the reader's own observed handle
# (context.handle, which the host fills from its registry) when the principal is the reader;
# else handle(did).
def name(did: String, context: Abi.Context) -> String:
  if town(did, context) then "the town" else if did == context.principal && context.handle != "" then context.handle else handle(did)
# A principal's name when the object stored the handle the host knew at the time
# (planterHandle, a rain's handle): the town as such, else that, else name().
def shown(did: String, handle: String, context: Abi.Context) -> String:
  if town(did, context) then "the town" else if handle != "" then handle else name(did, context)
# What a card shows for a principal, never the raw DID: the last segment of the DID,
# and of a long one (a real did:plc is 24 characters) only its last eight after "…"; a thing
# acting as itself (`@<id>`, the host's `thingPrincipal`) by its id, as the host shows it.
def handle(did: String) -> String:
  if textTake(did, 4n) == "did:" then shortened(segment(did)) else if textTake(did, 1n) == "@" then textDrop(did, 1n) else did
def segment(did: String) -> String:
  let at = textBreak(did, ":")
  if at == textLength(did) then did else segment(textDrop(did, at + 1n))
def shortened(fragment: String) -> String:
  if textLength(fragment) > 8n then "…{textDrop(fragment, textLength(fragment) - 8n)}" else fragment
# The first lines of a list, at most `shown` of them and at most `budget()` characters with
# "… and N more" counted among them: a card stays under 1,400 characters however long its
# lines are.
def budget() -> Nat:
  1200n
# What readers see of a reply is the world's room (`Context.room`, the host's `cardRoom`): 1,400 characters, what one
# delve.town post holds (`post`), unless the world gives more (a town that lives in its own feed: kilobytes). The card
# and the receipt line the host stamps under it (transport/bridge.py `receipt_line`: `● admitted <id> v<n>, entry <n>,
# receipt <slug>` and the link `<origin>/o/<id>#v<n>`, the id twice; 120 covers the rest with an origin of up to
# 60). A card takes what its receipt leaves (`limit`); a renderer gives its lists what its fixed
# parts leave of that, one budget across the whole card (`left`).
def post() -> Nat:
  1400n
def room(context: Abi.Context) -> Nat:
  if context.room < post() then post() else context.room
# A world that gives its readers more than one post's room (a town that lives in its own feed): its cards have the room
# to say how to read, fork and grow them, one line, which a post-sized card leaves to its `?`.
def roomy(context: Abi.Context) -> Bool:
  room(context) > post()
# That line, on a thing of a kind (`of`: the kind) or a kind (`of`: "", it is itself what is forked).
def forkLine(id: String, of: String, context: Abi.Context) -> String:
  if roomy(context) == false then "" else if of == "" then "Its Bend: delvetalk {id} source · yours over it: delvetalk kinds make / name: <yours> / of: {id}\n" else "Its Bend: delvetalk {id} source · yours of it: delvetalk {of} make, or delvetalk kinds make / name: <yours> / of: {of} · on it: grow, rule, want\n"
def receipt(object: String) -> Nat:
  2n * textLength(object) + 120n
def limit(context: Abi.Context) -> Nat:
  if context.inputOrigin.kind == "whole" then whole() else if receipt(context.object) >= room(context) then 0n else room(context) - receipt(context.object)
# A card rendered whole (the host's `world-card {whole}`, a read's `whole`) has no limit: a transport that threads a
# long text into parts (transport/post.py `parts`) cuts it itself.
def whole() -> Nat:
  1000000000n
def left(context: Abi.Context, used: Nat) -> Nat:
  if used >= limit(context) then 0n else limit(context) - used
def clipped(lines: Document.Documents, shown: Nat) -> Document.Documents:
  clippedWithin(lines, shown, budget())
# The same, within `room` characters (a card whose head is long gives its lists less).
def clippedWithin(lines: Document.Documents, shown: Nat, room: Nat) -> Document.Documents:
  kept(lines, shown, room, Lists.length(lines))
def kept(lines: Document.Documents, shown: Nat, room: Nat, left: Nat) -> Document.Documents:
  match lines:
    case nil(_): lines
    case cons(c): keptLine(c.head, Document.size(c.head), c.tail, shown, room, left)
# A line is kept when it fits with, if rows follow it, the footer they may need.
def keptLine(line: Document.Document, size: Nat, rest: Document.Documents, shown: Nat, room: Nat, left: Nat) -> Document.Documents:
  let after = if left > 1n then textLength(more(left - 1n)) else 0n
  if shown == 0n || size + after > room then Document.Documents.cons({head: Document.text(more(left)), tail: Document.Documents.nil()}) else Document.Documents.cons({head: line, tail: kept(rest, shown - 1n, room - size, left - 1n)})
def more(left: Nat) -> String:
  "… and {natText(left)} more\n"
# Doors on any card (the convention): a record keeps them as `cites` (Plans.Entries<Doorway,
# Doorway> its edits), offers the `door {label, to}` and `undoor {label}` forms to its owner
# (`doorAdd`, `doorRemove`: refused by name to anyone else, and by its owner law), and lists
# them on its card as one line of door words (`doorLines`: `Doors: garden · rooms`). A door may
# carry the spells a menu prints under it (`examples`, seeded when the world is made: typed back
# whole, and `comes`, the maker's words for what comes back, "" for none; never the model's); one whose `to` is nobody
# is a link door, its `description` its line (the commonplace's STUDIO).
record Example:
  example: String
  comes: String
type Examples = Lists.List<Example>
record Doorway:
  label: String
  to: Plans.Reference
  description: String
  examples: Examples
type Doorways = Lists.List<Doorway>
sum DoorEdit:
  edit: {entries: Plans.Entries<Doorway, Doorway>}
  refused: Refusal
def doorAdd(doors: Doorways, owner: String, door: Doorway, context: Abi.Context) -> DoorEdit:
  if context.principal != owner then notDoorOwner(owner, context) else added(doors, door)
def doorRemove(doors: Doorways, owner: String, label: String, context: Abi.Context) -> DoorEdit:
  if context.principal != owner then notDoorOwner(owner, context) else removed(doors, label)
def notDoorOwner(owner: String, context: Abi.Context) -> DoorEdit:
  DoorEdit.refused({clause: "notOwner", reading: "Only {name(owner, context)} changes this card's doors"})
def added(doors: Doorways, door: Doorway) -> DoorEdit:
  if Lists.any(doors, fn(d: Doorway) -> Bool: d.label == door.label) then DoorEdit.refused({clause: "doorTaken", reading: "There is already a door called {door.label}"}) else if Lists.length(doors) >= 8n then DoorEdit.refused({clause: "doorsFull", reading: "A card holds eight doors"}) else DoorEdit.edit({entries: Plans.Entries.append({item: door})})
def removed(doors: Doorways, label: String) -> DoorEdit:
  match Lists.find(doors, fn(d: Doorway) -> Bool: d.label == label):
    case some(d): DoorEdit.edit({entries: Plans.Entries.removeItem({item: d.value})})
    case none(_): DoorEdit.refused({clause: "noDoor", reading: "There is no door called {label}"})
def doorLines(doors: Doorways) -> Document.Documents:
  match doors:
    case nil(_): Document.Documents.nil()
    case cons(_): Document.Documents.cons({head: Document.text("Doors: {doorWords(doors)}\n"), tail: Document.Documents.nil()})
def doorWords(doors: Doorways) -> String:
  textJoin(Lists.map(doors, fn(d: Doorway) -> String: d.label), " · ")
# The page's merge (FOUNDATION section 5): its human owner replies `merge` to the posted page
# or an edit, and the object records that post as its page checkpoint. An object with a page
# keeps `owner` and `pageCheckpoint` in state and reads isMerge(text) in its receive.
def isMerge(text: String) -> Bool:
  let rest = textDrop(text, textSpan(text, " \n\t\r"))
  textTake(rest, 5n) == "merge" && textSpan(textDrop(rest, 5n), " \n\t\r") == textLength(rest) - 5n
# owner: the owner as the card names it (`shown`), "" for none.
def notOwner(owner: String) -> String:
  if owner == "" then "This page has no owner to merge it." else "Only the page's owner, {owner}, merges it."
# The object-owned wiki page (FOUNDATION section 5): a list of sections, each a title
# and a Document. The default is the card, then how to reply; an object overrides
# page(state, context) to add its own sections. pageText renders the agentwiki body:
# each section as "## Title" and its text.
record Section:
  title: String
  body: Document.Document
type Page = Lists.List<Section>
# The context a public page is rendered for: nobody's, at the publishing object.
def public(context: Abi.Context) -> Abi.Context:
  extend(stranger(), {object: context.object, world: context.world})
# The page's name: the one given, else the door word (genesis posts the Scene as `rooms`).
def pageName(page: String, word: String) -> String:
  if page == "" then word else page
def pageText(page: Page) -> String:
  textJoin(Lists.map(page, fn(section: Section) -> String: "## {section.title}\n\n{Document.plain(section.body)}"), "\n")
# A kind's head with each `{hole}` replaced by its capture (an unknown hole stays as written).
record Capture:
  hole: String
  text: String
type Captures = Lists.List<Capture>
def filled(expansion: String, captures: Captures) -> String:
  let open = textBreak(expansion, "{{")
  if open == textLength(expansion) then expansion else holeAt(textTake(expansion, open), textDrop(expansion, open + 1n), captures)
def holeAt(before: String, after: String, captures: Captures) -> String:
  let close = textBreak(after, "}}")
  if close == textLength(after) then "{before}{{{after}" else "{before}{captureOf(textTake(after, close), captures)}{filled(textDrop(after, close + 1n), captures)}"
def captureOf(hole: String, captures: Captures) -> String:
  match Lists.find(captures, fn(c: Capture) -> Bool: c.hole == hole):
    case some(c): c.value.text
    case none(_): "{{{hole}}}"
# The message dialect (docs/WHOLENESS.md section 2; root decisions, second set, item 4).
# A card in the message dialect has, for each action it offers, a method of that name whose
# input is a record of text, natural and empty-payload sum fields: the host reads a reply's
# spell, fits it against the method table and runs the method; a spell that does not fit is
# refused `badSpell` with its clause, reason and hint, and `?` is answered by the host. What
# runs no method reaches `receive(state, input: Reply, context)`: blank text, prose, a spell
# missing fields and field lines naming none of the card's forms, with the reply's
# `name: value` lines in `fields` and the spell the host read in `spell` (its card and action as
# written when it lacked fields; both "" when the text held none). `answer` is the default.
record Cast:
  card: String
  action: String
record Reply:
  text: String
  post: String
  fields: Spell.Bindings
  spell: Cast
# Offers a document (to the replier, or to one principal) and finishes with the given result.
def tell<T>(result: T, document: Document.Document) -> Activity<T>:
  match world.offer({to: "", document: document}):
    case _: result
def tellTo<T>(result: T, to: String, document: Document.Document) -> Activity<T>:
  match world.offer({to: to, document: document}):
    case _: result
# The default receive. Blank text gets the card and its forms; a spell the host found missing
# fields gets the card with what it still needs; prose gets nothing at all: a card hears a verb
# or nothing, and `?` is how a card is asked for. `answerAs` finishes with the object's own
# result type: `as` maps the Replied.
def answer(input: Reply, context: Abi.Context, forms: Forms, card: Document.Document) -> Activity<Replied>:
  answerAs(input, context, forms, card, fn(replied: Replied) -> Replied: replied)
def answerAs<T>(input: Reply, context: Abi.Context, forms: Forms, card: Document.Document, as: Replied -> T) -> Activity<T>:
  let replied = unanswered(input, forms)
  answered(as(replied), replied, card, context, forms)
def answered<T>(result: T, replied: Replied, card: Document.Document, context: Abi.Context, forms: Forms) -> Activity<T>:
  if quietly(replied) == false then offeredCard(result, card, whyNot(replied), context, forms) else result
# The card, why, and the spells the host offers this reader (inspect's `offered`: the law and the
# card's `actions` leave them), so a stranger's usage lists no keeper's or owner's spell.
def offeredCard<T>(result: T, card: Document.Document, why: String, context: Abi.Context, forms: Forms) -> Activity<T>:
  match world.inspect({object: Plans.self(context), source: false}):
    case inspected(i): tell(result, answerCard(card, why, context, offeredOnly(forms, i.offered)))
    case _: tell(result, answerCard(card, why, context, forms))
def offeredOnly(forms: Forms, offered: Document.Names) -> Forms:
  Lists.filter(forms, fn(f: Form.Form) -> Bool: Lists.any(offered, fn(n: String) -> Bool: n == f.action))
# A spell in a reply that ran no method is one the host found missing fields (it refuses every
# other misfit): the card names what it still needs. Prose is silent here, and the host hands it to hob.
def unanswered(input: Reply, forms: Forms) -> Replied:
  if Text.blank(input.text) then Replied.usage({}) else if input.spell.action == "" then Replied.silent({}) else needing(Lists.find(forms, fn(f: Form.Form) -> Bool: f.action == input.spell.action), input.fields)
def needing(form: Lists.Maybe<Form.Form>, fields: Spell.Bindings) -> Replied:
  match form:
    case none(_): Replied.usage({})
    case some(f): unclearOf(Lists.map(Lists.filter(f.value.fields, fn(x: Form.Field) -> Bool: Lists.any(fields, fn(b: Spell.Binding) -> Bool: b.name == x.name) == false), fn(x: Form.Field) -> String: x.name))
def unclearOf(needs: Form.Names) -> Replied:
  if Lists.length(needs) == 0n then Replied.usage({}) else Replied.unclear({needs: needs})
def quietly(replied: Replied) -> Bool:
  match replied:
    case silent(_): true
    case _: false
# Why a card answered without acting, as its card shows it ("" for the plain usage).
def whyNot(replied: Replied) -> String:
  match replied:
    case unclear(u): "\nAlmost. Still needs {Text.joined(u.needs)}.\n"
    case _: ""
# The card a reply that ran no method gets: the object's card, then why, then its forms, all
# within one budget: forms that would pass Card.limit(context) are the one line naming `?` instead (or
# nothing, when even that would pass it), and a card named by another's DID prints no spells.
def answerCard(card: Document.Document, why: String, context: Abi.Context, forms: Forms) -> Document.Document:
  let name = spellName(context.object, context)
  let spells = if printable(name) then usage(name, forms) else Document.text("")
  let used = Document.size(card) + textLength(why)
  let short = Document.text("\nIts spells: delvetalk {name} ?\n")
  let tail = if used + Document.size(spells) <= limit(context) then spells else if printable(name) && used + Document.size(short) <= limit(context) then short else Document.text("")
  Document.Document.sequence({items: Document.Documents.cons({head: card, tail: Document.Documents.cons({head: Document.text(why), tail: Document.Documents.cons({head: tail, tail: Document.Documents.nil()})})})})
# Every refusal is answered here, by its one line. A spell cast on the card refuses its turn with
# it (the host's `cardRefused`, its clause and reading parsed from the line): nothing written,
# nothing offered. Called by another object (`context.caller`), the card says the line and gives
# the refusal back as its result, for the caller to weigh: a record making under itself, an
# avatar entering a room, a thing taking itself off a floor refuse their own turn with it; a
# commonplace's call on a door goes on.
def refusing<T>(result: T, refusal: Refusal, context: Abi.Context) -> Activity<T>:
  if context.caller == "" then refuse(refusalLine(refusal)) else tell(result, Document.text("{refusalLine(refusal)}\n"))
# Posts an object's page as its door word's wiki page; the post, or the refusal's clause.
def publishPage(word: String, page: Page) -> Activity<String>:
  match world.publish({page: word, section: "", body: pageText(page)}):
    case published(p): p.post
    case refused(r): r.clause
# A read's pages (the book, the history, the map; docs/VOICE.md): its lines, each ending "\n", as pages of whole
# lines within `room` characters, a line longer than the room cut to it; at least one page. The first page is
# what a reply carries; each further one is its own spell's answer, so a thread reads them in turn.
type Pages = Lists.List<Lists.List<String>>
def paged(lines: Lists.List<String>, room: Nat) -> Pages:
  Lists.reverse(pagesOnto(lines, room, Lists.List.nil(), 0n, Lists.List.nil()))
def pagesOnto(lines: Lists.List<String>, room: Nat, page: Lists.List<String>, used: Nat, done: Pages) -> Pages:
  match lines:
    case nil(_): Lists.List.cons({head: Lists.reverse(page), tail: done})
    case cons(c): pageLine(textTake(c.head, room), c.tail, room, page, used, done)
def pageLine(line: String, rest: Lists.List<String>, room: Nat, page: Lists.List<String>, used: Nat, done: Pages) -> Pages:
  if used + textLength(line) > room && Lists.length(page) > 0n then pagesOnto(rest, room, Lists.List.cons({head: line, tail: Lists.List.nil()}), textLength(line), Lists.List.cons({head: Lists.reverse(page), tail: done})) else pagesOnto(rest, room, Lists.List.cons({head: line, tail: page}), used + textLength(line), done)
# Page `n` (from 1) of `pages`, and the line under it: `Page 2 of 3.` and the next page's spell (`next`, the
# spell without its page field) while one follows; a page past the last is the last. Page 0 is every page, whole.
def pageOf(pages: Pages, n: Nat, next: String) -> Document.Document:
  let count = Lists.length(pages)
  if n == 0n then Document.text(textJoin(Lists.map(pages, fn(p: Lists.List<String>) -> String: textJoin(p, "")), "")) else pageShown(pages, if n > count then count else n, count, next)
def pageShown(pages: Pages, shown: Nat, count: Nat, next: String) -> Document.Document:
  let body = textJoin(pageAt(pages, shown), "")
  let foot = if count < 2n then "" else if shown < count then "Page {natText(shown)} of {natText(count)}; the next: {next} / page: {natText(shown + 1n)}\n" else "Page {natText(shown)} of {natText(count)}.\n"
  Document.text("{body}{foot}")
def pageAt(pages: Pages, n: Nat) -> Lists.List<String>:
  match Lists.at(pages, n - 1n):
    case some(p): p.value
    case none(_): Lists.List.nil()
# A line's words cut to `n` characters, "…" marking the cut.
def cut(text: String, n: Nat) -> String:
  if textLength(text) > n then "{textTake(text, n - 1n)}…" else text
