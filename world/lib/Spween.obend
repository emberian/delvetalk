edition ObjectiveBend 1
import ./List.obend as Lists
import ./Scenes.obend as Scenes
import ./Text.obend as Text
# spween (a narrative DSL for games: ~/dev/spween) lowered to a Scene's seed.
#
#   ---                       frontmatter: id (the scene's name), title, cooldown,
#   id: well                  requires (min, max, flags, not); tags and custom fields
#   title: The Well           are spween's runtime's and are skipped
#   cooldown: 3
#   ---
#   === passage               a passage; the first is where a reader starts
#   Prose lines.              its text (a blank line keeps a paragraph)
#   * [Label] { a >= 1, !b }  a choice, guarded (or `when a >= 1, !b`)
#     ~ key = value           its effects: = sets, += and -= add and subtract naturals
#     -> target               where it goes (a passage or END; none is END)
#   -> target                 unindented, outside a choice: a "Continue" choice to there
#   // comment                skipped
#
# Refused by name: `weight` (a scene is entered by name, never drawn), `~ call` and the
# `~ name args` call form (a scene changes only its own variables), `has:` and
# `category.key` conditions (a scene cannot see what a reader holds), an effect outside a
# choice, and a target no passage answers. Sixteen passages of eight choices, as a card
# shows them.
sum Parsed:
  parsed: {seed: Scenes.Seed, id: String}
  refused: {reason: String}
def parse(text: String) -> Parsed:
  fronted(front(lines(text)))
# The text of the first ```spween block in a post, if any.
def block(text: String) -> Lists.Maybe<String>:
  let at = indexOf(text, "```spween")
  if at == textLength(text) then Lists.Maybe.none({}) else Lists.Maybe.some({value: fenced(textDrop(textDrop(text, at), textBreak(textDrop(text, at), "\n") + 1n))})
def fenced(inner: String) -> String:
  let stop = indexOf(inner, "\n```")
  if stop == textLength(inner) then inner else textTake(inner, stop + 1n)
# --- text ---------------------------------------------------------------------------
def lines(text: String) -> Lists.List<String>:
  if text == "" then Lists.List.nil({}) else Lists.List.cons({head: Text.trimEnd(textTake(text, textBreak(text, "\n"))), tail: lines(textDrop(text, textBreak(text, "\n") + 1n))})
def trim(text: String) -> String:
  Text.trimEnd(Text.trimStart(text))
def indent(line: String) -> Nat:
  textSpan(line, " \t")
def starts(text: String, prefix: String) -> Bool:
  textTake(text, textLength(prefix)) == prefix
# Where `needle` first stands in `text` (its length when nowhere).
def indexOf(text: String, needle: String) -> Nat:
  indexFrom(text, needle, 0n)
def indexFrom(text: String, needle: String, at: Nat) -> Nat:
  let skip = textBreak(text, textTake(needle, 1n))
  if skip == textLength(text) then at + skip else if textTake(textDrop(text, skip), textLength(needle)) == needle then at + skip else indexFrom(textDrop(text, skip + 1n), needle, at + skip + 1n)
def has(text: String, needle: String) -> Bool:
  indexOf(text, needle) < textLength(text)
def keyChars() -> String:
  "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
def isKey(text: String) -> Bool:
  text != "" && textSpan(text, keyChars()) == textLength(text)
def unquoted(text: String) -> String:
  if textLength(text) >= 2n && starts(text, "\"") && textDrop(text, textLength(text) - 1n) == "\"" then textTake(textDrop(text, 1n), textLength(text) - 2n) else text
def keyOf(line: String) -> String:
  trim(textTake(line, textBreak(line, ":")))
def valueOf(line: String) -> String:
  trim(textDrop(line, textBreak(line, ":") + 1n))
# The lines indented past `depth` (blank lines among them included), and what follows.
def deeper(ls: Lists.List<String>, depth: Nat) -> Lists.List<String>:
  match ls:
    case nil(_): ls
    case cons(c): if trim(c.head) == "" || indent(c.head) > depth then Lists.List.cons({head: c.head, tail: deeper(c.tail, depth)}) else Lists.List.nil({})
def beyond(ls: Lists.List<String>, depth: Nat) -> Lists.List<String>:
  match ls:
    case nil(_): ls
    case cons(c): if trim(c.head) == "" || indent(c.head) > depth then beyond(c.tail, depth) else ls
def hyphenated(text: String) -> String:
  let at = textBreak(text, "_")
  if at == textLength(text) then text else "{textTake(text, at)}-{hyphenated(textDrop(text, at + 1n))}"
# --- frontmatter --------------------------------------------------------------------
record Meta:
  id: String
  title: String
  cooldown: Nat
  requires: Scenes.Guard
sum Front:
  meta: {lines: Lists.List<String>, rest: Lists.List<String>}
  bare: {rest: Lists.List<String>}
  bad: {reason: String}
def front(ls: Lists.List<String>) -> Front:
  match ls:
    case nil(_): Front.bare({rest: ls})
    case cons(c): if trim(c.head) == "" then front(c.tail) else if trim(c.head) == "---" then closing(c.tail, Lists.List.nil({})) else Front.bare({rest: ls})
def closing(ls: Lists.List<String>, seen: Lists.List<String>) -> Front:
  match ls:
    case nil(_): Front.bad({reason: "the frontmatter has no closing ---"})
    case cons(c): if trim(c.head) == "---" then Front.meta({lines: Lists.reverse(seen), rest: c.tail}) else closing(c.tail, Lists.List.cons({head: c.head, tail: seen}))
def noMeta() -> Meta:
  {id: "", title: "", cooldown: 0n, requires: Lists.List.nil({})}
def fronted(f: Front) -> Parsed:
  match f:
    case bad(b): Parsed.refused({reason: b.reason})
    case bare(b): Parsed.refused({reason: "a scene starts with frontmatter naming its id: ---, id: <name>, ---"})
    case meta(m): metaRead(readMeta(m.lines, noMeta()), m.rest)
sum MetaRead:
  ok: {meta: Meta}
  bad: {reason: String}
def metaRead(read: MetaRead, rest: Lists.List<String>) -> Parsed:
  match read:
    case bad(b): Parsed.refused({reason: b.reason})
    case ok(o): if isKey(o.meta.id) == false then Parsed.refused({reason: "the frontmatter's id is letters, digits and _"}) else finished(o.meta, body(rest, Lists.Maybe.none({}), Lists.Maybe.none({}), Lists.List.nil({})))
def readMeta(ls: Lists.List<String>, meta: Meta) -> MetaRead:
  match ls:
    case nil(_): MetaRead.ok({meta: meta})
    case cons(c): if trim(c.head) == "" || starts(trim(c.head), "#") then readMeta(c.tail, meta) else if indent(c.head) > 0n then MetaRead.bad({reason: "unexpected indentation in the frontmatter: {trim(c.head)}"}) else metaKey(keyOf(trim(c.head)), valueOf(trim(c.head)), c.tail, meta)
def metaKey(key: String, value: String, rest: Lists.List<String>, meta: Meta) -> MetaRead:
  if key == "id" then readMeta(rest, extend(meta, {id: unquoted(value)})) else if key == "title" then readMeta(rest, extend(meta, {title: unquoted(value)})) else if key == "cooldown" then cooled(Text.number(value), rest, meta) else if key == "weight" then MetaRead.bad({reason: "weight: a scene is entered by name here, never drawn by weight"}) else if key == "requires" then required(value, deeper(rest, 0n), beyond(rest, 0n), meta) else readMeta(beyond(rest, 0n), meta)
def cooled(number: Text.Number, rest: Lists.List<String>, meta: Meta) -> MetaRead:
  match number:
    case yes(y): readMeta(rest, extend(meta, {cooldown: y.value}))
    case no(_): MetaRead.bad({reason: "cooldown takes a natural number"})
def required(inline: String, block: Lists.List<String>, rest: Lists.List<String>, meta: Meta) -> MetaRead:
  if inline != "" then MetaRead.bad({reason: "requires takes an indented block: min, max, flags, not"}) else requiredBy(requirements(block, Lists.List.nil({})), rest, meta)
def requiredBy(read: GuardRead, rest: Lists.List<String>, meta: Meta) -> MetaRead:
  match read:
    case bad(b): MetaRead.bad({reason: b.reason})
    case ok(o): readMeta(rest, extend(meta, {requires: o.guard}))
sum GuardRead:
  ok: {guard: Scenes.Guard}
  bad: {reason: String}
def requirements(ls: Lists.List<String>, guard: Scenes.Guard) -> GuardRead:
  match ls:
    case nil(_): GuardRead.ok({guard: guard})
    case cons(c): if trim(c.head) == "" then requirements(c.tail, guard) else requirement(keyOf(trim(c.head)), valueOf(trim(c.head)), deeper(c.tail, indent(c.head)), beyond(c.tail, indent(c.head)), guard)
def requirement(key: String, value: String, nested: Lists.List<String>, rest: Lists.List<String>, guard: Scenes.Guard) -> GuardRead:
  if key == "has" then GuardRead.bad({reason: "has: a scene cannot see what a reader holds; name a variable with flags"}) else if key == "min" || key == "max" then bounded(if key == "min" then ">=" else "<=", pairs(value, nested), rest, guard) else if key == "flags" || key == "not" then flagged(if key == "flags" then "truthy" else "falsy", items(value, nested), rest, guard) else GuardRead.bad({reason: "requires knows min, max, flags and not, not {key}"})
# `{ a: 1, b: 2 }` inline, or one `a: 1` line each beneath.
def pairs(value: String, nested: Lists.List<String>) -> Lists.List<String>:
  if starts(value, "{{") then pieces(textTake(textDrop(value, 1n), textBreak(textDrop(value, 1n), "}}"))) else Lists.filter(Lists.map(nested, trim), fn(t: String) -> Bool: t != "")
# `[a, b]` inline, or one `- a` line each beneath.
def items(value: String, nested: Lists.List<String>) -> Lists.List<String>:
  if starts(value, "[") then pieces(textTake(textDrop(value, 1n), textBreak(textDrop(value, 1n), "]"))) else Lists.map(Lists.filter(Lists.map(nested, trim), fn(t: String) -> Bool: t != ""), fn(t: String) -> String: if starts(t, "-") then trim(textDrop(t, 1n)) else t)
def pieces(text: String) -> Lists.List<String>:
  if trim(text) == "" then Lists.List.nil({}) else Lists.List.cons({head: trim(textTake(text, textBreak(text, ","))), tail: pieces(textDrop(text, textBreak(text, ",") + 1n))})
def bounded(op: String, entries: Lists.List<String>, rest: Lists.List<String>, guard: Scenes.Guard) -> GuardRead:
  match entries:
    case nil(_): requirements(rest, guard)
    case cons(c): if isKey(keyOf(c.head)) then bounded(op, c.tail, rest, Lists.append(guard, {key: keyOf(c.head), op: op, value: unquoted(valueOf(c.head))})) else keyRefused(keyOf(c.head))
def flagged(op: String, names: Lists.List<String>, rest: Lists.List<String>, guard: Scenes.Guard) -> GuardRead:
  match names:
    case nil(_): requirements(rest, guard)
    case cons(c): if isKey(c.head) then flagged(op, c.tail, rest, Lists.append(guard, {key: c.head, op: op, value: ""})) else keyRefused(c.head)
def keyRefused(key: String) -> GuardRead:
  if has(key, ".") then GuardRead.bad({reason: "has: {key} asks what a reader holds; a scene sees only its own variables"}) else GuardRead.bad({reason: "not a variable: {key}"})
# --- conditions ---------------------------------------------------------------------
def conditions(text: String) -> GuardRead:
  conditionsFrom(pieces(text), Lists.List.nil({}))
def conditionsFrom(texts: Lists.List<String>, guard: Scenes.Guard) -> GuardRead:
  match texts:
    case nil(_): GuardRead.ok({guard: guard})
    case cons(c): conditioned(condition(c.head), c.tail, guard)
sum ClauseRead:
  ok: {clause: Scenes.Clause}
  bad: {reason: String}
def conditioned(read: ClauseRead, rest: Lists.List<String>, guard: Scenes.Guard) -> GuardRead:
  match read:
    case bad(b): GuardRead.bad({reason: b.reason})
    case ok(o): conditionsFrom(rest, Lists.append(guard, o.clause))
def operators() -> Lists.List<String>:
  Lists.List.cons({head: ">=", tail: Lists.List.cons({head: "<=", tail: Lists.List.cons({head: "!=", tail: Lists.List.cons({head: "==", tail: Lists.List.cons({head: ">", tail: Lists.List.cons({head: "<", tail: Lists.List.nil({})})})})})})})
def condition(text: String) -> ClauseRead:
  match Lists.find(operators(), fn(op: String) -> Bool: has(text, op)):
    case some(o): compared(trim(textTake(text, indexOf(text, o.value))), o.value, trim(textDrop(text, indexOf(text, o.value) + textLength(o.value))))
    case none(_): if starts(text, "!") then bare(trim(textDrop(text, 1n)), "falsy") else bare(text, "truthy")
def compared(key: String, op: String, value: String) -> ClauseRead:
  if isKey(key) then ClauseRead.ok({clause: {key: key, op: op, value: unquoted(value)}}) else clauseRefused(key)
def bare(key: String, op: String) -> ClauseRead:
  if isKey(key) then ClauseRead.ok({clause: {key: key, op: op, value: ""}}) else clauseRefused(key)
def clauseRefused(key: String) -> ClauseRead:
  if has(key, ".") then ClauseRead.bad({reason: "has: {key} asks what a reader holds; a scene sees only its own variables"}) else ClauseRead.bad({reason: "not a condition: {key}"})
# --- passages -----------------------------------------------------------------------
record Open:
  id: String
  prose: String
  choices: Lists.List<Scenes.Choice>
sum Body:
  ok: {passages: Lists.List<Scenes.Passage>}
  bad: {reason: String}
def body(ls: Lists.List<String>, at: Lists.Maybe<Open>, choice: Lists.Maybe<Scenes.Choice>, done: Lists.List<Scenes.Passage>) -> Body:
  match ls:
    case nil(_): Body.ok({passages: closed(at, choice, done)})
    case cons(c): line(trim(c.head), indent(c.head), c.tail, at, choice, done)
# An unindented ~ or -> line belongs to the passage, not to the choice above it.
def line(t: String, depth: Nat, rest: Lists.List<String>, at: Lists.Maybe<Open>, choice: Lists.Maybe<Scenes.Choice>, done: Lists.List<Scenes.Passage>) -> Body:
  if starts(t, "//") then body(rest, at, choice, done) else if starts(t, "===") then opened(trim(passageName(textDrop(t, 3n))), rest, closed(at, choice, done)) else if depth == 0n && (starts(t, "~") || starts(t, "->")) then inPassage(t, rest, closedChoice(at, choice), Lists.Maybe.none({}), done) else inPassage(t, rest, at, choice, done)
def closedChoice(at: Lists.Maybe<Open>, choice: Lists.Maybe<Scenes.Choice>) -> Lists.Maybe<Open>:
  match at:
    case none(_): at
    case some(o): Lists.Maybe.some({value: withChoice(o.value, choice)})
def passageName(text: String) -> String:
  let name = trim(text)
  if textLength(name) >= 3n && textDrop(name, textLength(name) - 3n) == "===" then textTake(name, textLength(name) - 3n) else name
def opened(name: String, rest: Lists.List<String>, done: Lists.List<Scenes.Passage>) -> Body:
  if isKey(name) == false then Body.bad({reason: "a passage name is letters, digits and _: {name}"}) else body(rest, Lists.Maybe.some({value: {id: name, prose: "", choices: Lists.List.nil({})}}), Lists.Maybe.none({}), done)
def inPassage(t: String, rest: Lists.List<String>, at: Lists.Maybe<Open>, choice: Lists.Maybe<Scenes.Choice>, done: Lists.List<Scenes.Passage>) -> Body:
  match at:
    case none(_): if t == "" then body(rest, at, choice, done) else Body.bad({reason: "text before the first === passage: {textTake(t, 40n)}"})
    case some(o): passageLine(t, rest, o.value, choice, done)
def passageLine(t: String, rest: Lists.List<String>, open: Open, choice: Lists.Maybe<Scenes.Choice>, done: Lists.List<Scenes.Passage>) -> Body:
  if starts(t, "*") then chosen(header(trim(textDrop(t, 1n))), rest, withChoice(open, choice), done) else if starts(t, "~") then effected(t, rest, open, choice, done) else if starts(t, "->") then diverted(trim(textDrop(t, 2n)), rest, open, choice, done) else if t == "" then blank(rest, open, choice, done) else body(rest, Lists.Maybe.some({value: extend(withChoice(open, choice), {prose: prosed(withChoice(open, choice).prose, t)})}), Lists.Maybe.none({}), done)
def blank(rest: Lists.List<String>, open: Open, choice: Lists.Maybe<Scenes.Choice>, done: Lists.List<Scenes.Passage>) -> Body:
  match choice:
    case some(_): body(rest, Lists.Maybe.some({value: open}), choice, done)
    case none(_): body(rest, Lists.Maybe.some({value: extend(open, {prose: if open.prose == "" then "" else "{open.prose}\n"})}), choice, done)
def prosed(prose: String, t: String) -> String:
  if prose == "" then t else "{prose}\n{t}"
# The open passage with its open choice, if any, closed into its choices.
def withChoice(open: Open, choice: Lists.Maybe<Scenes.Choice>) -> Open:
  match choice:
    case none(_): open
    case some(c): extend(open, {choices: Lists.append(open.choices, c.value)})
def closed(at: Lists.Maybe<Open>, choice: Lists.Maybe<Scenes.Choice>, done: Lists.List<Scenes.Passage>) -> Lists.List<Scenes.Passage>:
  match at:
    case none(_): done
    case some(o): Lists.append(done, passageOf(withChoice(o.value, choice)))
def passageOf(open: Open) -> Scenes.Passage:
  {id: open.id, text: trimmedLines(open.prose), choices: open.choices}
def trimmedLines(text: String) -> String:
  if textLength(text) > 0n && textDrop(text, textLength(text) - 1n) == "\n" then trimmedLines(textTake(text, textLength(text) - 1n)) else text
sum Header:
  ok: {choice: Scenes.Choice}
  bad: {reason: String}
def header(t: String) -> Header:
  if starts(t, "[") == false || has(t, "]") == false then Header.bad({reason: "a choice is * [label]: {textTake(t, 40n)}"}) else labelled(trim(textTake(textDrop(t, 1n), textBreak(textDrop(t, 1n), "]"))), trim(textDrop(t, textBreak(t, "]") + 1n)))
def labelled(label: String, after: String) -> Header:
  if after == "" then Header.ok({choice: {label: label, to: Scenes.ending(), effects: Lists.List.nil({}), guard: Lists.List.nil({})}}) else if starts(after, "{{") && has(after, "}}") then guarded(label, conditions(textTake(textDrop(after, 1n), textBreak(textDrop(after, 1n), "}}")))) else if starts(after, "when ") then guarded(label, conditions(textDrop(after, 5n))) else Header.bad({reason: "after a choice's [label] comes {{ condition }} or when condition: {textTake(after, 40n)}"})
def guarded(label: String, read: GuardRead) -> Header:
  match read:
    case bad(b): Header.bad({reason: b.reason})
    case ok(o): Header.ok({choice: {label: label, to: Scenes.ending(), effects: Lists.List.nil({}), guard: o.guard}})
def chosen(header: Header, rest: Lists.List<String>, open: Open, done: Lists.List<Scenes.Passage>) -> Body:
  match header:
    case bad(b): Body.bad({reason: b.reason})
    case ok(o): body(rest, Lists.Maybe.some({value: open}), Lists.Maybe.some({value: o.choice}), done)
def diverted(target: String, rest: Lists.List<String>, open: Open, choice: Lists.Maybe<Scenes.Choice>, done: Lists.List<Scenes.Passage>) -> Body:
  match choice:
    case some(c): body(rest, Lists.Maybe.some({value: open}), Lists.Maybe.some({value: extend(c.value, {to: target})}), done)
    case none(_): body(rest, Lists.Maybe.some({value: extend(open, {choices: Lists.append(open.choices, {label: "Continue", to: target, effects: Lists.List.nil({}), guard: Lists.List.nil({})})})}), choice, done)
sum EffectRead:
  ok: {effect: Scenes.Effect}
  bad: {reason: String}
def effected(t: String, rest: Lists.List<String>, open: Open, choice: Lists.Maybe<Scenes.Choice>, done: Lists.List<Scenes.Passage>) -> Body:
  match choice:
    case none(_): Body.bad({reason: "an effect outside a choice: {textTake(t, 40n)}"})
    case some(c): withEffect(effect(trim(textDrop(t, 1n))), rest, open, c.value, done)
def withEffect(read: EffectRead, rest: Lists.List<String>, open: Open, choice: Scenes.Choice, done: Lists.List<Scenes.Passage>) -> Body:
  match read:
    case bad(b): Body.bad({reason: b.reason})
    case ok(o): body(rest, Lists.Maybe.some({value: open}), Lists.Maybe.some({value: extend(choice, {effects: Lists.append(choice.effects, o.effect)})}), done)
def callRefused(t: String) -> EffectRead:
  EffectRead.bad({reason: "~ call: {textTake(t, 40n)}: a scene changes only its own variables; no game function runs here"})
def effect(t: String) -> EffectRead:
  if starts(t, "call(") then callRefused(t) else assigned(textTake(t, textSpan(t, keyChars())), trim(textDrop(t, textSpan(t, keyChars()))), t)
def assigned(key: String, rest: String, t: String) -> EffectRead:
  if key == "" || starts(rest, ".") then EffectRead.bad({reason: "an effect sets a variable of the scene: {textTake(t, 40n)}"}) else if starts(rest, "+=") then counted(key, "add", unquoted(trim(textDrop(rest, 2n)))) else if starts(rest, "-=") then counted(key, "sub", unquoted(trim(textDrop(rest, 2n)))) else if starts(rest, "=") && starts(rest, "==") == false then EffectRead.ok({effect: {key: key, op: "set", value: unquoted(trim(textDrop(rest, 1n)))}}) else callRefused(t)
def counted(key: String, op: String, value: String) -> EffectRead:
  if Scenes.isNatural(value) then EffectRead.ok({effect: {key: key, op: op, value: value}}) else EffectRead.bad({reason: "{key} += and -= take a natural number, not {value}"})
# --- the seed -----------------------------------------------------------------------
def finished(meta: Meta, read: Body) -> Parsed:
  match read:
    case bad(b): Parsed.refused({reason: b.reason})
    case ok(o): checked(meta, o.passages, problem(o.passages))
def problem(passages: Lists.List<Scenes.Passage>) -> String:
  if Lists.length(passages) == 0n then "a scene has at least one === passage" else if Lists.length(passages) > 16n then "a scene holds sixteen passages" else if Lists.any(passages, fn(p: Scenes.Passage) -> Bool: Lists.length(p.choices) > 8n) then "a passage offers at most eight choices" else unknownTarget(passages, Lists.filterMap(passages, fn(p: Scenes.Passage) -> Lists.Maybe<String>: missing(passages, p.choices)))
def missing(passages: Lists.List<Scenes.Passage>, choices: Lists.List<Scenes.Choice>) -> Lists.Maybe<String>:
  match Lists.find(choices, fn(c: Scenes.Choice) -> Bool: c.to != Scenes.ending() && Lists.any(passages, fn(p: Scenes.Passage) -> Bool: p.id == c.to) == false):
    case some(c): Lists.Maybe.some({value: c.value.to})
    case none(_): Lists.Maybe.none({})
def unknownTarget(passages: Lists.List<Scenes.Passage>, unknown: Lists.List<String>) -> String:
  match unknown:
    case cons(c): "-> {c.head}: no passage of that name"
    case nil(_): ""
def checked(meta: Meta, passages: Lists.List<Scenes.Passage>, problem: String) -> Parsed:
  match passages:
    case cons(c): if problem != "" then Parsed.refused({reason: problem}) else Parsed.parsed({seed: {title: if meta.title == "" then meta.id else meta.title, start: c.head.id, passages: passages, cooldown: meta.cooldown, requires: meta.requires}, id: hyphenated(meta.id)})
    case nil(_): Parsed.refused({reason: if problem == "" then "a scene has at least one === passage" else problem})
