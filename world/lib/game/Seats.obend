edition ObjectiveBend 1
import ./Plan.obend as Plans
import ./Card.obend as Card
# A seat at a commit-reveal table, as data: what the Table views. The table and each
# seat are separate objects, so a reveal awaiting the opponent's commitment waits on a
# turn that writes another object, and resumes on roots that are still current.
record State:
  table: fixed Plans.Reference
  seat: fixed Nat
  owner: fixed String
  opponent: fixed String
  rival: fixed Plans.Reference
  round: Nat
  digest: String
  opened: Bool
  source: Nat
  target: Nat
# What a seat's methods answer; the table's calls of next return it.
sum Done:
  committed: {}
  opened: {}
  next: {round: Nat}
  refused: Card.Refusal
# The intent a seat's commitment turn carries, so the opponent can name its slot.
def commitIntent(table: String, round: Nat) -> String:
  "{table}/{natText(round)}/commit"
