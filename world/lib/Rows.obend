edition ObjectiveBend 1
import ./List.obend as Lists
import ./Relation.obend as Relations
import ./Event.obend as Events
# The row types of the relations other objects read (WHOLENESS, root decisions, second set,
# item 3): a subscriber's typed receiver takes `inserted` and `retracted` as lists of one of
# these, so a Wake imports this module rather than the object that keeps the rows. Each
# relation's key and limit are its object's (`relations()`); RELATIONAL §12 has the ordering.
#
# A line in a record (Record.obend), keyed {author, n}: `n` the record's `next` when it was
# written, so key order (n first) is the order of writing; `at` the height its turn read.
record Line:
  author: String
  handle: String
  text: String
  at: Nat
  n: Nat
# A record's keeper admitted line `n` at height `at`, keyed {n}.
record Admission:
  n: Nat
  at: Nat
# A record's named moment (a bell's `rung`), once each, keyed {name}.
record Mark:
  name: String
  who: String
  handle: String
  at: Nat
# A value a kind's form took when a thing was made, by name.
record Field:
  name: String
  value: String
# A bell's colour, and a bell a garden planted (its `children`, keyed {object}).
sum Colour:
  amber: {}
  violet: {}
  silver: {}
record Child:
  world: String
  object: String
  colour: Colour
# A proposal a workshop's target refused, held for the target's owner, or a draft made from a
# description (`target` "", `name` the id it is made at), held for its describer (its `held`,
# keyed {n}, numbered in order). `intent` is the holding turn's, for the made thing's lineage.
record Held:
  n: Nat
  target: String
  package: String
  migration: String
  proposer: String
  proposerHandle: String
  name: String
  intent: String
# A principal the commonplace has greeted once, keyed {principal}.
record Greeting:
  principal: String
# When a reader was last answered for words that named nothing, keyed {principal}: the
# commonplace's hourly bound (its `due`).
record Missed:
  principal: String
  at: Nat
# A line an avatar's principal sent (its `outbox`, which followers subscribe to), keyed {at, n}:
# `at` the height its turn read, `n` the outbox's count then.
record Letter:
  handle: String
  text: String
  at: Nat
  n: Nat
# A principal's subscription to a tide, keyed {who}: woken every `every` ticks from `since`.
record Subscription:
  who: String
  every: Nat
  note: String
  since: Nat
  handle: String
# When a reader last left a room, keyed {at, who}: key order is the order of leaving.
record Departure:
  who: String
  at: Nat
# Who is in a room and at which passage ("" for a room without passages), keyed {who}.
record Presence:
  who: String
  at: String
def presenceKey(p: Presence) -> {who: String}:
  {who: p.who}
def presentAs(presence: Relations.Relation<Presence>, who: String) -> Lists.Maybe<Presence>:
  Relations.lookup(presence, {who: who})
def isPresent(presence: Relations.Relation<Presence>, who: String) -> Bool:
  Relations.has(presence, {who: who})
# A row as a rule reads it (a Wake's `On.rows`, RELATIONAL section 7): its columns by name, each
# a natural or a text (Relations.Cell), since Bend cannot read Data. One projection per row type.
record Column:
  column: String
  value: Relations.Cell
type Columns = Lists.List<Column>
def column(name: String, value: Relations.Cell) -> Column:
  {column: name, value: value}
def text(name: String, value: String) -> Column:
  column(name, Relations.text(value))
def nat(name: String, value: Nat) -> Column:
  column(name, Relations.nat(value))
def one(c: Column, rest: Columns) -> Columns:
  Lists.List.cons({head: c, tail: rest})
def none() -> Columns:
  Lists.List.nil({})
def lineColumns(r: Line) -> Columns:
  one(text("author", r.author), one(text("handle", r.handle), one(text("text", r.text), one(nat("at", r.at), one(nat("n", r.n), none())))))
def sensedColumns(s: Events.Event) -> Columns:
  one(text("kind", s.kind), one(text("actor", s.actor), one(text("handle", s.handle), one(text("uri", s.uri), one(text("cid", s.cid), one(text("text", s.text), one(text("replyTo", s.replyTo), one(nat("at", s.at), one(nat("n", s.n), none())))))))))
def markColumns(m: Mark) -> Columns:
  one(text("name", m.name), one(text("who", m.who), one(text("handle", m.handle), one(nat("at", m.at), none()))))
def greetingColumns(g: Greeting) -> Columns:
  one(text("principal", g.principal), none())
def presenceColumns(p: Presence) -> Columns:
  one(text("who", p.who), one(text("at", p.at), none()))
def subscriptionColumns(s: Subscription) -> Columns:
  one(text("who", s.who), one(nat("every", s.every), one(text("note", s.note), one(nat("since", s.since), one(text("handle", s.handle), none())))))
