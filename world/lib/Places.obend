edition ObjectiveBend 1
import ./List.obend as Lists
import ./Plan.obend as Plans
import ./Card.obend as Card
import ./Relation.obend as Relations
import ./Rows.obend as Rows
# PLACE's state as data (world/objects/Place.obend): what a thing and an avatar view, and what a
# place's methods answer. Place.obend is lawless and could be imported itself, but arrival's sealed
# library holds Avatar, Env and Wake beside world/lib (the host's `arrival`), so what an avatar
# imports lives here.
type Exit = Card.Doorway
# What a place made under itself, keyed {object}: the kind's id (kind/bell) and `n` the count then.
record Made:
  object: String
  kind: String
  n: Nat
# A half-made thing held for a principal, keyed {principal} (a body's; one a principal, so holding
# another replaces it).
record Pending:
  principal: String
  kind: String
  fields: Lists.List<Rows.Field>
  needs: Lists.List<String>
# owner: who renames and redescribes the room (its lenses) and changes its doors. Who is here and
# what lies here are keyed by object id; `traces` are Rows.Trace, keyed {at, who, action, n}, and
# written only while `keep` is above 0 (the card shows the last min(8, keep)). `makes`: the kinds
# whose instances hang here; `made` what was made, `count` how many.
record State:
  owner: String
  ownerHandle: String
  name: String
  description: String
  exits: Card.Doorways
  present: Relations.Relation<Plans.Reference>
  things: Relations.Relation<Plans.Reference>
  traces: Relations.Relation<Rows.Trace>
  keep: Nat
  makes: Lists.List<Plans.Reference>
  made: Relations.Relation<Made>
  count: Nat
  policy: Plans.Reference
  confirmFor: Lists.List<String>
  held: Relations.Relation<Pending>
  pageCheckpoint: String
# What a place's, a thing's and an avatar's methods answer: done, or a refusal by name.
sum Done:
  done: {}
  refused: Card.Refusal
def objectKey(reference: Plans.Reference) -> {object: String}:
  {object: reference.object}
def holds(relation: Relations.Relation<Plans.Reference>, reference: Plans.Reference) -> Bool:
  match Relations.lookup(relation, objectKey(reference), objectKey):
    case some(_): true
    case none(_): false
