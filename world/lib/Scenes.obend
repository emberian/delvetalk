edition ObjectiveBend 1
import ./List.obend as Lists
import ./Text.obend as Text
import ./Card.obend as Card
# A scene as data: passages, choices with their effects and guards, the scene's own
# requirements and cooldown. A room (world/bodies/room.obend over RECORD) keeps one;
# world/lib/Spween.obend lowers spween's text to its Seed.
#
# The inside and the outside, one grammar each (docs/OVERHAUL.md §2). Inside, an effect sets a variable
# of the room (`set`), adds to it or subtracts from it (`add`, `sub`, on naturals; a missing or
# non-numeric value counts 0, a subtraction stops at 0), and a clause tests one: against a value (atLeast,
# above, atMost, below on naturals, a variable never set counting 0; equals and differs on the text), or whether it is truthy or falsy
# ("", "0" and "false" are falsy, as is a variable never set). Outside, an effect casts a spell (`cast`,
# `value` the spell): the room's text holds it as a rule, `rule <passage>_<n>: request.method == "choose" and
# new.chose == "<passage>.<n>" then SPELL`, so it fires as any rule fires, under the room's owner, judged
# by its target's law, journaled, eight a commit and four deep (`ruleText`). An outside clause is a
# condition in the law's grammar (`law`, `value` the condition), judged by the host of the room as it
# stands with the reader as `request.subject` (`world.holds`), or what the reader keeps or holds
# (`holding`, `lacking`: `key` holds, keeps or has, `value` the thing's id). A guard holds when every
# clause does; a pure read of a card judges the inside alone and shows the outside beside the choice.
sum Op:
  set: {}
  add: {}
  sub: {}
  cast: {}
sum Test:
  truthy: {}
  falsy: {}
  equals: {}
  differs: {}
  atLeast: {}
  above: {}
  atMost: {}
  below: {}
  law: {}
  holding: {}
  lacking: {}
record Effect:
  key: String
  op: Op
  value: String
record Clause:
  key: String
  test: Test
  value: String
type Guard = Lists.List<Clause>
# A choice's `text` is shown to the reader who takes it, before the passage it leads to (spween's prose indented
# under a choice; "" for none). `among`: the targets a choice draws between, each with its weight (spween's
# `weight`), two or more, `to` the first of them; none for a choice with one target.
record Choice:
  label: String
  to: String
  effects: Lists.List<Effect>
  guard: Guard
  text: String
  among: Lists.List<Weighed>
# An alternative of a draw, a target or a text, and its weight (spween's default, 10).
record Weighed:
  value: String
  weight: Nat
record Passage:
  id: String
  text: String
  guard: Guard
  choices: Lists.List<Choice>
# cooldown: the clock units a reader waits after leaving (or reaching END) before entering
# again (0 for none). requires: what the scene's variables must hold for anyone to enter.
record Seed:
  title: String
  start: String
  passages: Lists.List<Passage>
  cooldown: Nat
  requires: Guard
record Var:
  name: String
  value: String
type Vars = Lists.List<Var>
# What a room answers to enter, choose, leave, take and put, and what a thing and an avatar
# answer of their own: a refusal by name, or what happened.
sum Done:
  done: {}
  entered: {at: String}
  moved: {to: String}
  left: {}
  refused: Card.Refusal
# A reader's own variable is written `my.<name>`: kept for each reader apart (Record's `mine`), read and set as the
# room's are, a guard judging the room's and the reader's together (`readerVars`).
def isMine(key: String) -> Bool:
  Text.starts(key, "my.")
def ownName(key: String) -> String:
  textDrop(key, 3n)
def mine(name: String) -> String:
  "my.{name}"
# The variables a guard reads for one reader: the room's, then the reader's own as `my.<name>`.
def readerVars(vars: Vars, own: Vars) -> Vars:
  Lists.concat(vars, Lists.map(own, fn(v: Var) -> Var: {name: mine(v.name), value: v.value}))
# A draw (docs: world/lib/Spween.obend) is made from the turn's own entry, never a clock or a generator the
# journal does not hold: `turnDraw` hashes the turn's own identity, the height it read (its entry's less one), its
# principal and its intent (`Plans.Slot`, unique in the journal), which replay and a carry
# reproduce, and each draw of the turn hashes that with the choice it is for (`chose`) or the place of the text's
# alternatives, so one turn's draws differ and the same turn draws the same again.
def turnDraw(height: Nat, principal: String, intent: String) -> Nat:
  hashed("{natText(height)} {principal} {intent}")
def drawFor(draw: Nat, what: String) -> Nat:
  hashed("{natText(draw)} {what}")
# FNV-1a over the text's printable ASCII (any other character counts alike), modulo the largest prime below 2^32.
def hashed(text: String) -> Nat:
  hashFrom(text, 2166136261n)
def hashFrom(text: String, h: Nat) -> Nat:
  if text == "" then h else hashFrom(textDrop(text, 1n), (h * 16777619n + textBreak(printable(), textTake(text, 1n)) + 1n) % 4294967291n)
def printable() -> String:
  " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{{|}}~"
# The alternative a draw `n` lands on, by weight: alternative k for n modulo the total within its share.
def drawn(alternatives: Lists.List<Weighed>, n: Nat) -> String:
  let total = weights(alternatives)
  if total == 0n then "" else picked(alternatives, n % total)
def weights(alternatives: Lists.List<Weighed>) -> Nat:
  match alternatives:
    case nil(_): 0n
    case cons(c): c.head.weight + weights(c.tail)
def picked(alternatives: Lists.List<Weighed>, r: Nat) -> String:
  match alternatives:
    case nil(_): ""
    case cons(c): if r < c.head.weight then c.head.value else picked(c.tail, r - c.head.weight)
# The passages a choice may lead to: its target, or each it draws between.
def targets(c: Choice) -> Lists.List<String>:
  match c.among:
    case nil(_): Lists.List.cons({head: c.to, tail: Lists.List.nil()})
    case cons(_): Lists.map(c.among, fn(w: Weighed) -> String: w.value)
# A choice whose target is END ends the reader's visit.
def ending() -> String:
  "END"
def valueOf(vars: Vars, key: String) -> String:
  match Lists.find(vars, fn(v: Var) -> Bool: v.name == key):
    case some(v): v.value.value
    case none(_): ""
def truthy(value: String) -> Bool:
  value != "" && value != "0" && value != "false"
def natural(value: String) -> Nat:
  match Text.number(value):
    case yes(y): y.value
    case no(_): 0n
def isNatural(value: String) -> Bool:
  match Text.number(value):
    case yes(_): true
    case no(_): false
def holdsClause(clause: Clause, vars: Vars) -> Bool:
  let have = valueOf(vars, clause.key)
  match clause.test:
    case truthy(_): truthy(have)
    case falsy(_): truthy(have) == false
    case equals(_): have == clause.value
    case differs(_): have != clause.value
    case atLeast(_): numbers(have, clause.value) && natural(have) >= natural(clause.value)
    case above(_): numbers(have, clause.value) && natural(have) > natural(clause.value)
    case atMost(_): numbers(have, clause.value) && natural(have) <= natural(clause.value)
    case below(_): numbers(have, clause.value) && natural(have) < natural(clause.value)
    case _: true
# A variable never set counts 0 against a number, as an effect counts it: glm's `{ wound < 12 }` holds
# before anyone has wound the clock.
def numbers(have: String, want: String) -> Bool:
  (have == "" || isNatural(have)) && isNatural(want)
# A clause the room's own variables answer; the rest are the outside's.
def inside(clause: Clause) -> Bool:
  match clause.test:
    case law(_): false
    case holding(_): false
    case lacking(_): false
    case _: true
def outside(guard: Guard) -> Guard:
  Lists.filter(guard, fn(c: Clause) -> Bool: inside(c) == false)
# The first inside clause of a guard that does not hold, if any.
def failing(guard: Guard, vars: Vars) -> Lists.Maybe<Clause>:
  Lists.find(guard, fn(c: Clause) -> Bool: holdsClause(c, vars) == false)
def holds(guard: Guard, vars: Vars) -> Bool:
  Lists.any(guard, fn(c: Clause) -> Bool: holdsClause(c, vars) == false) == false
def clauseText(clause: Clause) -> String:
  match clause.test:
    case truthy(_): clause.key
    case falsy(_): "!{clause.key}"
    case law(_): clause.value
    case holding(_): "{clause.key}.{clause.value}"
    case lacking(_): "!{clause.key}.{clause.value}"
    case _: "{clause.key} {symbol(clause.test)} {clause.value}"
# How spween writes a test.
def symbol(test: Test) -> String:
  match test:
    case equals(_): "=="
    case differs(_): "!="
    case atLeast(_): ">="
    case above(_): ">"
    case atMost(_): "<="
    case below(_): "<"
    case _: ""
# A variable's value after an effect.
def applied(effect: Effect, old: String) -> String:
  match effect.op:
    case set(_): effect.value
    case cast(_): old
    case add(_): natText(natural(old) + natural(effect.value))
    case sub(_): natText(less(natural(old), natural(effect.value)))
def less(have: Nat, by: Nat) -> Nat:
  if have > by then have - by else 0n
# Whether an effect sets one of the room's variables (a cast reaches outside it).
def varies(effect: Effect) -> Bool:
  match effect.op:
    case cast(_): false
    case _: true
def casts(effects: Lists.List<Effect>) -> Lists.List<String>:
  Lists.map(Lists.filter(effects, fn(e: Effect) -> Bool: varies(e) == false), fn(e: Effect) -> String: e.value)
# What `chose` holds after a reader takes the `n`th choice (from 1) of passage `id`.
def chosen(id: String, n: Nat) -> String:
  "{id}.{natText(n)}"
# The rule lines a scene's casts are, one a spell, for the room's text: named by the first passage and
# choice that casts it (a second cast of one choice `b`, then `c`), read by that choice's label; a spell
# cast by several choices is one rule whose condition names each (`new.chose == "a.1" or new.chose ==
# "b.2"`), so a text's sixteen lines hold more choices (fluonaut's touch rings the bell glm's door does).
def ruleText(passages: Lists.List<Passage>) -> String:
  textJoin(sceneRules(passages), "")
record Cast:
  id: String
  n: Nat
  label: String
  spell: String
  k: Nat
def sceneRules(passages: Lists.List<Passage>) -> Lists.List<String>:
  rulesOf(castsOf(passages), Lists.List::<String>.nil())
def castsOf(passages: Lists.List<Passage>) -> Lists.List<Cast>:
  match passages:
    case nil(_): Lists.List::<Cast>.nil()
    case cons(c): Lists.concat(choiceCasts(c.head.id, c.head.choices, 1n), castsOf(c.tail))
def choiceCasts(id: String, choices: Lists.List<Choice>, n: Nat) -> Lists.List<Cast>:
  match choices:
    case nil(_): Lists.List::<Cast>.nil()
    case cons(c): Lists.concat(spellCasts(id, n, c.head.label, casts(c.head.effects), 0n), choiceCasts(id, c.tail, n + 1n))
def spellCasts(id: String, n: Nat, label: String, spells: Lists.List<String>, k: Nat) -> Lists.List<Cast>:
  match spells:
    case nil(_): Lists.List::<Cast>.nil()
    case cons(c): Lists.List.cons({head: {id: id, n: n, label: label, spell: c.head, k: k}, tail: spellCasts(id, n, label, c.tail, k + 1n)})
def rulesOf(casts: Lists.List<Cast>, seen: Lists.List<String>) -> Lists.List<String>:
  match casts:
    case nil(_): Lists.List::<String>.nil()
    case cons(c): if Lists.any(seen, fn(s: String) -> Bool: s == c.head.spell) then rulesOf(c.tail, seen) else Lists.List.cons({head: ruleLine(c.head, Lists.filter(c.tail, fn(d: Cast) -> Bool: d.spell == c.head.spell)), tail: rulesOf(c.tail, Lists.append(seen, c.head.spell))})
def ruleLine(c: Cast, more: Lists.List<Cast>) -> String:
  "\nrule {c.id}_{natText(c.n)}{suffix(c.k)} \"{readable(c.label)}\": request.method == \"choose\" and {chosenWhen(c, more)} then {c.spell}"
def chosenWhen(c: Cast, more: Lists.List<Cast>) -> String:
  match more:
    case nil(_): choseIs(c)
    case cons(_): "({choseIs(c)}{textJoin(Lists.map(more, orIs), \"\")})"
def choseIs(c: Cast) -> String:
  "new.chose == \"{chosen(c.id, c.n)}\""
def orIs(c: Cast) -> String:
  " or {choseIs(c)}"
def suffix(k: Nat) -> String:
  if k == 0n then "" else textTake(textDrop("bcdefghijklmnop", k - 1n), 1n)
# A label as a reading: no quote or backslash.
def readable(label: String) -> String:
  let at = textBreak(label, "\"\\")
  if at == textLength(label) then label else "{textTake(label, at)}'{readable(textDrop(label, at + 1n))}"
def castCount(passages: Lists.List<Passage>) -> Nat:
  Lists.length(sceneRules(passages))
# Every law condition of a scene's requirements, passages and choices, for the host to read once at making.
def conditions(seed: Seed) -> Lists.List<String>:
  Lists.map(Lists.filter(Lists.concat(seed.requires, guards(seed.passages)), isLaw), fn(c: Clause) -> String: c.value)
def guards(passages: Lists.List<Passage>) -> Guard:
  match passages:
    case nil(_): Lists.List.nil()
    case cons(c): Lists.concat(c.head.guard, Lists.concat(choiceGuards(c.head.choices), guards(c.tail)))
def choiceGuards(choices: Lists.List<Choice>) -> Guard:
  match choices:
    case nil(_): Lists.List.nil()
    case cons(c): Lists.concat(c.head.guard, choiceGuards(c.tail))
def isLaw(c: Clause) -> Bool:
  match c.test:
    case law(_): true
    case _: false
