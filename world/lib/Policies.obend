edition ObjectiveBend 1
import ./List.obend as Lists
# The interpretation policy's state, as data: what a card with a policy views. It lives apart from
# world/objects/Policy.obend because a module that declares a law cannot be imported.
record Example:
  utterance: String
  spell: String
# model: the model the host asks. examples: what is said, and the spell it means, in every model
# call. confirmFor: the actions an interpreted proposal waits for the speaker's yes before
# (Card.confirms); every other action runs at once and its receipt is the answer.
record State:
  owner: String
  ownerHandle: String
  model: String
  examples: Lists.List<Example>
  confirmFor: Lists.List<String>
