edition ObjectiveBend 1
import ./List.obend as Lists
# The interpretation policy's state, as data: what a card with a policy views (Garden and
# Directory read its escalation before they answer a second miss). It lives apart from
# world/objects/Policy.obend because a module that declares a law cannot be imported.
record Term:
  word: String
  meaning: String
record Example:
  utterance: String
  spell: String
# model: the model the host asks first. escalate: the stronger model a second attempt names
# ("" for the same). escalateTo: the principal (a DID) a card tells, in a short copy, what it
# could not fit after two attempts ("" for nobody).
record State:
  owner: String
  model: String
  system: String
  lexicon: Lists.List<Term>
  examples: Lists.List<Example>
  escalate: String
  escalateTo: String
