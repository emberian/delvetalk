of: record
form: <<END
name: text 1..64
spween: text 0..16384
END
head: {name}
voice: dusk-light and stone dust; a place where nobody has decided yet; there is no rush
about: a place to enter and talk in, walked by choices
text: want company "a room nobody is in": count(new.presence) == 0 asks delvetalk {request.object} enter
body: room
