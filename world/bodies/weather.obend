layer over ./Record.obend
edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Scenes.obend as Scenes
import ./Rows.obend as Rows
import ./Relation.obend as Relations
import ./Text.obend as Text
# The weather's body, over RECORD (docs/METAPHYSICS.md §7.2, §7.4 "feed"; TENURE §2): a record made
# over a place and the tide it reads (`over`, `tide`, fixed). As its kind finishes it, it places a rule
# on its tide under its maker (`made`): at every twenty-fourth tick, a clock day, while someone has
# been at the place within the day (it was tended: a garden's planting, a room's entering), the tide
# casts `delvetalk <weather> rain`. A rain writes the weather's line, the place's weather line when the
# place hangs a door to it (Record.forecast), and sends a rain to each bell the place holds or hangs a
# door to, the first 32 (one turn sends at most 32). A bell takes the weather's rain as the weather's
# line and is not tended by it, so a bell nobody has been near goes quiet and takes nothing. Only the
# tide's rule rains: a hand's `rain` is refused by name.
type State = Super.State
form rain:
form write:
  text: text 1..280
form lines:
  from: natural 1..1000000000
form door:
  label: text 1..32
  to: text 1..128
form undoor:
  label: text 1..32
def write(state: State, input: WriteInput, context: Abi.Context) -> Activity<Nat>:
  Super.write(state, {text: input.text}, context)
def lines(state: State, input: LinesInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.lines(state, {from: input.from}, context)
def door(state: State, input: DoorInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.door(state, {label: input.label, to: input.to}, context)
def undoor(state: State, input: UndoorInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.undoor(state, {label: input.label}, context)
def actions(state: State, context: Abi.Context) -> Lists.List<String>:
  if context.principal == state.owner then Text.words("rain write lines door undoor") else Text.words("rain write lines")
def methods() -> Lists.List<String>:
  Text.words("~made ~act")
def over(state: State) -> String:
  Super.field(state, "over")
def tide(state: State) -> String:
  Super.field(state, "tide")
# How often it rains, in ticks of its tide (an hour each): once a clock day.
def every() -> Nat:
  24n
# The rule on the tide, as its kind finishes it: named for the weather, cast under its maker.
def made(state: State, input: {}, context: Abi.Context) -> Activity<Bool>:
  if context.caller != state.kind then false else placing(state, context)
def placing(state: State, context: Abi.Context) -> Activity<Bool>:
  match world.rule({object: {world: context.world, object: tide(state)}, name: Text.identifier(context.object), when: "request.method == \"tick\" and new.ticks % {natText(every())} == 0 and request.clock <= \"{over(state)}\".tended + 1440", then: "delvetalk {context.object} rain"}):
    case placed(_): true
    case refused(_): false
# The tide's rule rains; anyone else is told what does.
def rain(state: State, context: Abi.Context) -> Activity<Nat>:
  if context.sender != tide(state) then Card.refusing(0n, {clause: "ruled", reading: "the weather rains by its rule on {tide(state)}, once a clock day while someone has been at {over(state)}: delvetalk {tide(state)} rules"}, context) else reaching(state, context)
def placeOf(state: State, context: Abi.Context) -> Plans.Reference:
  {world: context.world, object: over(state)}
# What the place holds, then what it hangs doors to; whether one of its doors is to this weather.
def reaching(state: State, context: Abi.Context) -> Activity<Nat>:
  match world.viewField::<Relations.Relation<Plans.Reference>>({object: placeOf(state, context), field: "things"}):
    case viewed(v): opened(Relations.rows(v.state), state, context)
    case _: opened(Lists.List.nil(), state, context)
def opened(things: Lists.List<Plans.Reference>, state: State, context: Abi.Context) -> Activity<Nat>:
  match world.viewField::<Card.Doorways>({object: placeOf(state, context), field: "cites"}):
    case viewed(v): sorting(Lists.take(Lists.concat(things, Lists.map(v.state, fn(d: Card.Doorway) -> Plans.Reference: d.to)), 48n), Lists.List.nil(), Lists.any(v.state, fn(d: Card.Doorway) -> Bool: d.to.object == context.object), state, context)
    case _: sorting(Lists.take(things, 48n), Lists.List.nil(), false, state, context)
# The bells among them, by their kind.
def sorting(candidates: Lists.List<Plans.Reference>, bells: Lists.List<Plans.Reference>, cited: Bool, state: State, context: Abi.Context) -> Activity<Nat>:
  match candidates:
    case nil(_): forecasting(Lists.take(Lists.reverse(bells), 32n), cited, state, context)
    case cons(c): kinded(c.head, c.tail, bells, cited, state, context)
def kinded(thing: Plans.Reference, rest: Lists.List<Plans.Reference>, bells: Lists.List<Plans.Reference>, cited: Bool, state: State, context: Abi.Context) -> Activity<Nat>:
  match world.viewField::<String>({object: thing, field: "kind"}):
    case viewed(v): sorting(rest, if v.state == "kind/bell" then Lists.List.cons({head: thing, tail: bells}) else bells, cited, state, context)
    case _: sorting(rest, bells, cited, state, context)
def rainText(context: Abi.Context) -> String:
  "{context.object}'s rain, clock {natText(context.clock)}"
def forecasting(things: Lists.List<Plans.Reference>, cited: Bool, state: State, context: Abi.Context) -> Activity<Nat>:
  let written(_) = write {lines: insert {author: context.principal, handle: context.handle, verb: "rain", text: "rain at clock {natText(context.clock)} on {natText(Lists.length(things))}", at: context.height, n: state.next}, next: add 1n}
  if cited then forecastSent(things, state, context) else raining(things, 0n, context)
def forecastSent(things: Lists.List<Plans.Reference>, state: State, context: Abi.Context) -> Activity<Nat>:
  match world.send({object: placeOf(state, context), method: "forecast", argument: {line: "rain at clock {natText(context.clock)}, on {natText(Lists.length(things))}"}}):
    case _: raining(things, 0n, context)
def raining(things: Lists.List<Plans.Reference>, sent: Nat, context: Abi.Context) -> Activity<Nat>:
  match things:
    case nil(_): sent
    case cons(c): rained(c.head, c.tail, sent, context)
def rained(thing: Plans.Reference, rest: Lists.List<Plans.Reference>, sent: Nat, context: Abi.Context) -> Activity<Nat>:
  match world.send({object: thing, method: "rain", argument: {text: rainText(context)}}):
    case delivery(_): raining(rest, sent + 1n, context)
    case _: raining(rest, sent, context)
def headLine(state: State, context: Abi.Context, id: String) -> Document.Document:
  let rains = if Relations.count(state.lines) == 0n then "; it has not rained yet." else ". Its rains:"
  Document.text("WEATHER over {over(state)}, made by {Card.shown(state.maker, state.makerHandle, context)}{Card.mine(state.maker, context)}: once a clock day, while someone has been at {over(state)} that day, it rains on every bell {over(state)} holds or hangs a door to, by its rule on {tide(state)}:\n  delvetalk {tide(state)} rules\nA bell nobody has been near takes nothing{rains}\n")
