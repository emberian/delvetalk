layer over ./Record.obend
edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Relation.obend as Relations
import ./Rows.obend as Rows
import ./Text.obend as Text
import ./Scenes.obend as Scenes
# The weather's body, over RECORD (docs/METAPHYSICS.md §7.2, §7.4 "feed"): a record that watches a
# tide's `ticks` and, at each tick, rains on every thing its garden holds (the garden's `things`,
# the first 32: one turn sends at most 32) and writes the garden's weather line, so rain falls with
# nobody posting (a rain is the ticker's turn, and says whose weather it is). It is made with the garden and the tide it serves (`garden`, `tide`, fixed) and
# watches from the moment its kind finishes it (`made`); the garden cites it, which is what lets it
# write the garden's weather (Record.forecast). Each tick it watched is a line of its own.
type State = Super.State
form write:
  text: text 1..280
form lines:
  from: natural 1..1000000000
form door:
  label: text 1..32
  to: text 1..128
form undoor:
  label: text 1..32
form example:
  label: text 1..32
  spell: text 1..280
  comes: text 0..200
def write(state: State, input: WriteInput, context: Abi.Context) -> Activity<Nat>:
  Super.write(state, {text: input.text}, context)
def lines(state: State, input: LinesInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.lines(state, {from: input.from}, context)
def door(state: State, input: DoorInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.door(state, {label: input.label, to: input.to}, context)
def undoor(state: State, input: UndoorInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.undoor(state, {label: input.label}, context)
def example(state: State, input: ExampleInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.example(state, {label: input.label, spell: input.spell, comes: input.comes}, context)
def actions(state: State, context: Abi.Context) -> Lists.List<String>:
  if context.principal == state.owner then Text.words("lines door undoor example") else Text.words("lines")
def blurb() -> Card.Door:
  {word: "weather", blurb: "Rain that falls by itself: at each tide tick, on every bell its garden holds."}
def methods() -> Lists.List<String>:
  Text.words("~changedNat")
def garden(state: State) -> String:
  Super.field(state, "garden")
def tide(state: State) -> String:
  Super.field(state, "tide")
# As its kind finishes it: watch the tide's ticks.
def made(state: State, input: {}, context: Abi.Context) -> Activity<Bool>:
  if context.caller != state.kind then false else watching(tide(state), context)
def watching(tide: String, context: Abi.Context) -> Activity<Bool>:
  match world.subscribe({object: {world: context.world, object: tide}, field: "ticks", method: "changedNat"}):
    case subscribed(_): true
    case _: false
# A tick, delivered by the host with the tide as caller: the garden's things, then a rain on each.
def changedNat(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Nat>, retracted: Lists.List<Nat>}, context: Abi.Context) -> Activity<Nat>:
  if context.caller != tide(state) || input.object.object != tide(state) then 0n else ticked(tickOf(input.inserted), state, context)
def tickOf(values: Lists.List<Nat>) -> Nat:
  match values:
    case nil(_): 0n
    case cons(c): c.head
def ticked(tick: Nat, state: State, context: Abi.Context) -> Activity<Nat>:
  match world.viewField::<Relations.Relation<Plans.Reference>>({object: {world: context.world, object: garden(state)}, field: "things"}):
    case viewed(v): forecasting(Lists.take(Lists.filter(Relations.rows(v.state), fn(t: Plans.Reference) -> Bool: Text.contains(t.object, "/bell/")), 32n), tick, state, context)
    case _: 0n
def rainText(tick: Nat, context: Abi.Context) -> String:
  "{context.object}'s rain, tide tick {natText(tick)}"
def forecasting(things: Lists.List<Plans.Reference>, tick: Nat, state: State, context: Abi.Context) -> Activity<Nat>:
  let written(_) = write {lines: insert {author: context.principal, handle: context.handle, text: "tick {natText(tick)}: rain on {natText(Lists.length(things))}", at: context.height, n: state.next}, next: add 1n}
  match world.send({object: {world: context.world, object: garden(state)}, method: "forecast", argument: {line: "rain at tide tick {natText(tick)}, on {natText(Lists.length(things))}"}}):
    case _: raining(things, tick, 0n, context)
def raining(things: Lists.List<Plans.Reference>, tick: Nat, sent: Nat, context: Abi.Context) -> Activity<Nat>:
  match things:
    case nil(_): sent
    case cons(c): rained(c.head, c.tail, tick, sent, context)
def rained(thing: Plans.Reference, rest: Lists.List<Plans.Reference>, tick: Nat, sent: Nat, context: Abi.Context) -> Activity<Nat>:
  match world.send({object: thing, method: "rain", argument: {text: rainText(tick, context)}}):
    case delivery(_): raining(rest, tick, sent + 1n, context)
    case _: raining(rest, tick, sent, context)
def headLine(state: State, context: Abi.Context, id: String) -> Document.Document:
  Document.text("WEATHER over {garden(state)}, made by {Card.shown(state.maker, state.makerHandle, context)}{Card.mine(state.maker, context)}: at each tick of {tide(state)} it rains on every bell {garden(state)} holds. Ticks it rained on:\n")
