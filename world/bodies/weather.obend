layer over ./Record.obend
edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Scenes.obend as Scenes
import ./Rows.obend as Rows
import ./Relation.obend as Relations
import ./Text.obend as Text
# The weather's body, over RECORD (docs/METAPHYSICS.md §7.2, §7.4 "feed"; TENURE §2): a record made
# with the garden and the tide it serves (`garden`, `tide`, fixed). As its kind finishes it, it
# places a rule on its tide under its maker (`made`): at every twenty-fourth tick, a clock day,
# while the garden was tended within the day, the tide casts `delvetalk <weather> rain`. A rain
# writes the weather's line and the garden's (the garden cites it, which lets it: Record.forecast)
# and sends a rain to each bell the garden holds: thirty in the rain's own turn (it also sends the
# forecast, and one turn sends at most 32), then a `drizzle` it sends itself carries on, thirty-one
# bells to a turn, until none remain. A bell takes the weather's rain as the weather's line and is
# not tended by it, so a bell nobody visits still goes quiet; a quiet bell takes nothing. Only its maker's rule on the tide rains: a hand's `rain` is
# refused by name.
type State = Super.State
form rain:
form arm:
form drizzle:
  from: natural 0..1000000000
form write:
  text: text 1..280
form lines:
  from: natural 1..1000000000
form door:
  label: text 1..32
  to: text 1..128
form undoor:
  label: text 1..32
def write(state: State, input: WriteInput, context: Abi.Context) -> Activity<Nat>:
  Super.write(state, {text: input.text}, context)
def lines(state: State, input: LinesInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.lines(state, {from: input.from}, context)
def door(state: State, input: DoorInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.door(state, {label: input.label, to: input.to}, context)
def undoor(state: State, input: UndoorInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.undoor(state, {label: input.label}, context)
def actions(state: State, context: Abi.Context) -> Lists.List<String>:
  Lists.concat(if context.principal == state.owner then Text.words("rain write lines door undoor") else Text.words("rain write lines"), if context.principal == state.maker then Text.words("arm") else Text.words(""))
def methods() -> Lists.List<String>:
  Text.words("~made ~act ~drizzle")
def garden(state: State) -> String:
  Super.field(state, "garden")
def tide(state: State) -> String:
  Super.field(state, "tide")
# How often it rains, in ticks of its tide (an hour each): once a clock day.
def every() -> Nat:
  24n
# The rule on the tide, as its kind finishes it: named for the weather, cast under its maker.
def made(state: State, input: {}, context: Abi.Context) -> Activity<Bool>:
  if context.caller != state.kind then false else placing(state, context)
def placing(state: State, context: Abi.Context) -> Activity<Bool>:
  match world.rule({object: {world: context.world, object: tide(state)}, name: Text.identifier(context.object), when: "request.method == \"tick\" and new.ticks % {natText(every())} == 0 and request.clock <= \"{garden(state)}\".tended + 1440", then: "delvetalk {context.object} rain"}):
    case placed(_): Super.armedNow(state, context)
    case refused(r): Super.unarmed(state, tide(state), r.clause, r.reading, context)
# Its maker places its rule again (taken off first, if it stood).
def arm(state: State, context: Abi.Context) -> Activity<Bool>:
  if context.principal != state.maker then Super.armRefused(state, context) else rearming(state, context)
def rearming(state: State, context: Abi.Context) -> Activity<Bool>:
  match world.unrule({object: {world: context.world, object: tide(state)}, name: Text.identifier(context.object)}):
    case _: placing(state, context)
# Its maker's rule on the tide rains, while the garden was tended within the day; anyone else, or
# another's rule there, is told what does.
def rain(state: State, context: Abi.Context) -> Activity<Nat>:
  if Super.ruledFrom(state, tide(state), context) == false then unruled(state, context) else tended(state, context)
def unruled(state: State, context: Abi.Context) -> Activity<Nat>:
  Card.refusing(0n, {clause: "ruled", reading: "the weather rains by its rule on {tide(state)}, once a clock day while {garden(state)} is tended: delvetalk {tide(state)} rules"}, context)
# Its garden was tended within the day, read again as the rain comes.
def tended(state: State, context: Abi.Context) -> Activity<Nat>:
  match world.viewField::<Nat>({object: {world: context.world, object: garden(state)}, field: "tended"}):
    case viewed(v): if context.clock <= v.state + 1440n then gardened(state, context) else unruled(state, context)
    case _: unruled(state, context)
def gardened(state: State, context: Abi.Context) -> Activity<Nat>:
  match world.viewField::<Relations.Relation<Plans.Reference>>({object: {world: context.world, object: garden(state)}, field: "things"}):
    case viewed(v): forecasting(bells(v.state), state, context)
    case _: 0n
def bells(things: Relations.Relation<Plans.Reference>) -> Lists.List<Plans.Reference>:
  Lists.filter(Relations.rows(things), fn(t: Plans.Reference) -> Bool: Text.contains(t.object, "/bell/"))
def skipping(things: Lists.List<Plans.Reference>, count: Nat) -> Lists.List<Plans.Reference>:
  match things:
    case nil(_): things
    case cons(c): if count == 0n then things else skipping(c.tail, count - 1n)
def rainText(context: Abi.Context) -> String:
  "{context.object}'s rain, clock {natText(context.clock)}"
def forecasting(things: Lists.List<Plans.Reference>, state: State, context: Abi.Context) -> Activity<Nat>:
  let written(_) = write {lines: insert {author: context.principal, handle: context.handle, verb: "rain", text: "rain at clock {natText(context.clock)} on {natText(Lists.length(things))}", at: context.height, n: state.next}, next: add 1n}
  match world.send({object: {world: context.world, object: garden(state)}, method: "forecast", argument: {line: "rain at clock {natText(context.clock)}, on {natText(Lists.length(things))}"}}):
    case _: raining(things, 30n, 0n, 0n, state, context)
# Sends a rain to the bells in turn while `room` sends remain; bells left over are the next drizzle's, from
# `start` plus those sent.
def raining(things: Lists.List<Plans.Reference>, room: Nat, sent: Nat, start: Nat, state: State, context: Abi.Context) -> Activity<Nat>:
  match things:
    case nil(_): sent
    case cons(c): if room == 0n then continuing(start + sent, sent, context) else rained(c.head, c.tail, room, sent, start, state, context)
def rained(thing: Plans.Reference, rest: Lists.List<Plans.Reference>, room: Nat, sent: Nat, start: Nat, state: State, context: Abi.Context) -> Activity<Nat>:
  match world.send({object: thing, method: "rain", argument: {text: rainText(context)}}):
    case delivery(_): raining(rest, room - 1n, sent + 1n, start, state, context)
    case _: raining(rest, room, sent, start, state, context)
def continuing(from: Nat, sent: Nat, context: Abi.Context) -> Activity<Nat>:
  match world.send({object: {world: context.world, object: context.object}, method: "drizzle", argument: {from: from}}):
    case _: sent
# The rain's own continuation, sent by the weather to itself: the bells from `from`, thirty-one of them.
def drizzle(state: State, input: DrizzleInput, context: Abi.Context) -> Activity<Nat>:
  if context.sender != context.object then Card.refusing(0n, {clause: "ruled", reading: "the drizzle is the weather's own; delvetalk {context.object} rain"}, context) else drizzling(input.from, state, context)
def drizzling(from: Nat, state: State, context: Abi.Context) -> Activity<Nat>:
  match world.viewField::<Relations.Relation<Plans.Reference>>({object: {world: context.world, object: garden(state)}, field: "things"}):
    case viewed(v): raining(skipping(bells(v.state), from), 31n, 0n, from, state, context)
    case _: 0n
def headLine(state: State, context: Abi.Context, id: String) -> Document.Document:
  let rained = if Relations.count(state.lines) == 0n then "; it has not rained yet.\n" else ".\n"
  let rains = if Relations.count(state.lines) == 0n then "" else "Its rains:\n"
  Document.text("WEATHER over {garden(state)}, made by {Card.shown(state.maker, state.makerHandle, context)}{Card.mine(state.maker, context)}: it rains on every bell {garden(state)} holds once a clock day, by its rule on {tide(state)}, while someone has tended {garden(state)} that day{rained}{Super.inactiveLine(state, id)}{rains}")
