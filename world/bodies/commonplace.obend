layer over ./Record.obend
edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Form.obend as Form
import ./Spell.obend as Spell
import ./World.obend as World
import ./Card.obend as Card
import ./Policies.obend as Policies
import ./Relation.obend as Relations
import ./Rows.obend as Rows
import ./Text.obend as Text
import ./Menu.obend as Menu
import ./Mentions.obend as Mentions
import ./Scenes.obend as Scenes
# The commonplace's body, over RECORD (docs/METAPHYSICS.md §5, §7.5): the town's first card.
# What changed in the town, newest first (World.changed, read when the card is asked for, so
# nothing is kept to say it), then the doors the hand named (the record's `cites`, each with
# the spells the card prints under it), then the tail. The opener keeps it: a line written
# here is [pending] until admitted, as in any kept record.
#
# It is where words go that no card took: a door word gets that door's card; field lines go to
# the door whose form names them; prose is hob's to read with the record's `policy` (macros
# first, then one reading against the doors' forms), each principal's first words get hob's
# greeting over this card (`greeted`, only added to), and words naming nothing get the doors
# pruned to what they touched, at most hourly per speaker (`missed`, which every card's owed
# usage asks through `due`).
type State = Super.State
type Door = Card.Doorway
type Learned = Mentions.Learned
type Learning = Mentions.Learning
def doors(state: State) -> Lists.List<Door>:
  state.cites
def menu(state: State) -> Lists.List<Door>:
  state.cites
def greetingKey(greeting: Rows.Greeting) -> Rows.Greeting:
  greeting
def missedKey(m: Rows.Missed) -> {principal: String}:
  {principal: m.principal}
def greetedBefore(principal: String, state: State) -> Bool:
  match Relations.lookup(state.greeted, greetingKey({principal: principal}), greetingKey):
    case some(_): true
    case none(_): false
# The card without what changed (render is pure): the doors, with the spell that asks.
def render(state: State, context: Abi.Context) -> Document.Document:
  Menu.trie(state.cites, "  delvetalk commonplace since / entry: 0\n  » what changed since that entry, newest first\n", "", context)
# What changed since an entry, over the doors.
def since(state: State, input: SinceInput, context: Abi.Context) -> Activity<Card.Replied>:
  withChanges(Card.Replied.done({action: "since"}), "", input.entry, "", context, state)
form since:
  entry: natural 0..1000000000
form write:
  text: text 1..280
form admit:
  number: natural 1..1000000000
form lines:
  from: natural 1..1000000000
form door:
  label: text 1..32
  to: text 1..128
form undoor:
  label: text 1..32
form example:
  label: text 1..32
  spell: text 1..280
  comes: text 0..200
def write(state: State, input: WriteInput, context: Abi.Context) -> Activity<Nat>:
  Super.write(state, {text: input.text}, context)
def admit(state: State, input: AdmitInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.admit(state, {number: input.number}, context)
def lines(state: State, input: LinesInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.lines(state, {from: input.from}, context)
def door(state: State, input: DoorInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.door(state, {label: input.label, to: input.to}, context)
def undoor(state: State, input: UndoorInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.undoor(state, {label: input.label}, context)
def example(state: State, input: ExampleInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.example(state, {label: input.label, spell: input.spell, comes: input.comes}, context)
def actions(state: State, context: Abi.Context) -> Lists.List<String>:
  Lists.concat(Text.words("since write lines"), Lists.concat(if state.keeper != "" && context.principal == state.keeper then Text.words("admit") else Text.words(""), if context.principal == state.owner then Text.words("door undoor example") else Text.words("")))
def methods() -> Lists.List<String>:
  Text.words("due")
def blurb() -> Card.Door:
  {word: "commonplace", blurb: "What changed in the town, and its doors."}
def refusing(clause: String, reading: String, greet: Bool, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  toldThen(Document.text("{Menu.title()}\n\nrefused {clause}: {reading}\n"), Card.Replied.refused({clause: clause, reading: reading}), greet, context, state)
# The hub's reply (a spell naming another card never reaches here: the host runs it there). A
# door word gets that door's card; the menu goes to each principal once, under hob's greeting.
# A misfit spell addressed here comes with its clause and reason, which hob is shown; with no
# policy it is refused by its clause.
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Card.Replied>:
  if Text.blank(input.text) && Lists.length(input.fields) == 0n then withChanges(Card.Replied.usage({}), "", 0n, "", context, state) else if input.misfit.clause != "" && Plans.isNobody(state.policy) then refusing(input.misfit.clause, input.misfit.reason, false, context, state) else worded(input, doorFor(doors(state), Mentions.doorWord(input.text)), context, state)
# Calls a door's receive with a reply, as this turn; the door reads it as its own. `greet`: the
# reply is a principal's first (`greeting`), whose menu follows whatever the reply drew.
def passOn(card: String, input: {text: String, post: String}, greet: Bool, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match world.call::<Data>({object: {world: context.world, object: card}, method: "receive", argument: input}):
    case returned(_): visited(card, Card.Replied.passed({card: card}), greet, context, state)
    case denied(_): refusing("notVisible", "The card {card} is not visible to you.", greet, context, state)
    case refused(r): refusing(r.clause, if r.reading == "" then "Not passed to {card}." else r.reading, greet, context, state)
# The door a reply went through leads the card a first reply gets (an arc's, its parent door).
def visited(card: String, result: Card.Replied, greet: Bool, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match topDoorOf(card, state):
    case some(d): welcomed(greet, d.value.label, result, context, state)
    case none(_): welcomed(greet, "", result, context, state)
# A first reply's card comes after what the reply drew: hob's greeting over what changed and the
# doors, opening on the door it went through (`first`, "" for none).
def welcomed(greet: Bool, first: String, result: Card.Replied, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  if greet then withChanges(result, Menu.greetingLine(), 0n, first, context, state) else result
# The card over what changed since an entry (World.changed; a derived read, no root): `line`,
# hob's above it ("" for none). Left out: the commonplace's own change (a greeting writes one;
# its lines are on its own card) and a principal's own cards (an id holding a DID: avatars,
# envs, wakes), which a card never names.
def withChanges(result: Card.Replied, line: String, since: Nat, first: String, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match world.changed({since: since, prefix: "", after: ""}):
    case changed(c): Card.tell(result, Menu.trieUnder(line, state.cites, Menu.changes(Lists.filter(c.items, fn(i: World.Change) -> Bool: i.object.object != context.object && Text.contains(i.object.object, "did:") == false)), first, context))
    case denied(_): Card.tell(result, Menu.trieUnder(line, state.cites, Menu.changes(Lists.List.nil()), first, context))
def toldThen(document: Document.Document, result: Card.Replied, greet: Bool, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match world.offer({to: "", document: document}):
    case _: welcomed(greet, "", result, context, state)
def topDoorOf(card: String, state: State) -> Lists.Maybe<Door>:
  let all = menu(state)
  Lists.find(all, fn(d: Door) -> Bool: Plans.isNobody(d.to) == false && Menu.isArc(all, d) == false && (card == d.to.object || Text.starts(card, "{d.to.object}/")))
def doorFor(doors: Lists.List<Door>, word: String) -> Lists.Maybe<Door>:
  Lists.find(doors, fn(door: Door) -> Bool: word != "" && (door.label == word || door.to.object == word))
def worded(input: Card.Heard, found: Lists.Maybe<Door>, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match found:
    case some(d): if Plans.isNobody(d.value.to) then linkDoor(d.value) else doorCard(d.value.to, context)
    case none(_): fieldsOrProse(input, context, state)
# Where the walk goes once the doors' forms are learned: the field lines' door, or hob.
sum Next:
  fielded: {first: Spell.Binding}
  read: {greet: Bool}
def fieldsOrProse(input: Card.Heard, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match input.fields:
    case cons(c): learning(input, Next.fielded({first: c.head}), Lists.List.nil(), doors(state), context, state)
    case nil(_): unaddressed(input, context, state)
# What is learned of the doors: each door's offered forms, and those of the first card under it
# (a garden's bell), which field lines and the pruned menu read; hob at the root is offered the
# doors' own (`Mentions.doorForms`), and for a reply a card handed on, that card's.
def learning(input: Card.Heard, next: Next, learned: Learning, doors: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match doors:
    case nil(_): learnedAll(input, next, learned, context, state)
    case cons(c): if Plans.isNobody(c.head.to) then learning(input, next, learned, c.tail, context, state) else doorLearned(input, next, learned, c.head.to.object, c.tail, context, state)
def doorLearned(input: Card.Heard, next: Next, learned: Learning, door: String, rest: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match world.inspect({object: {world: context.world, object: door}, source: false}):
    case inspected(i): childListed(input, next, Lists.concat(learned, Mentions.learnedOf(door, door, false, Card.offeredOnly(i.methods, i.offered))), door, rest, context, state)
    case _: childListed(input, next, learned, door, rest, context, state)
def childListed(input: Card.Heard, next: Next, learned: Learning, door: String, rest: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match world.objects({prefix: "{door}/", after: ""}):
    case listed(l): childLearned(input, next, learned, door, Lists.at(l.ids, 0n), rest, context, state)
    case refused(_): learning(input, next, learned, rest, context, state)
def childLearned(input: Card.Heard, next: Next, learned: Learning, door: String, child: Lists.Maybe<String>, rest: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match child:
    case none(_): learning(input, next, learned, rest, context, state)
    case some(c): childInspected(input, next, learned, door, c.value, rest, context, state)
def childInspected(input: Card.Heard, next: Next, learned: Learning, door: String, child: String, rest: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match world.inspect({object: {world: context.world, object: child}, source: false}):
    case inspected(i): learning(input, next, Lists.concat(learned, Mentions.learnedOf(child, door, true, Card.offeredOnly(i.methods, i.offered))), rest, context, state)
    case _: learning(input, next, learned, rest, context, state)
def learnedAll(input: Card.Heard, next: Next, learned: Learning, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match next:
    case fielded(f): fielded(input, f.first, Lists.find(learned, fn(l: Learned) -> Bool: l.child == false && (l.form.action == f.first.name || Card.hasField(l.form, f.first.name))), context, state)
    case read(r): consulted(input, {card: "", forms: Mentions.doorForms(learned), learned: learned}, r.greet, context, state)
# Field lines with no delvetalk line: when the first names an action a door offers (`plant:
# …`), the lines become that door's spell; when it names a field of a door's form (`colour:
# violet`), they go to that door as they are, to complete the spell it holds.
def fielded(input: Card.Heard, first: Spell.Binding, found: Lists.Maybe<Learned>, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match found:
    case some(l): passOn(l.value.card, {text: if l.value.form.action == first.name then Mentions.spellFor(l.value.card, l.value.form, input.fields) else input.text, post: input.post}, false, context, state)
    case none(_): unaddressed(input, context, state)
# Prose, which hob reads when there is a policy (the host's reach decides whether it was
# addressed at all: unaddressed prose is hob's `none` at once, with no model call). A principal's
# first reply is greeted, and its menu follows whatever hob drew.
def unaddressed(input: Card.Heard, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  if context.caller != "" then handedOn(input, context, state) else if greetedBefore(context.principal, state) == false then greeting(input, context, state) else reading(input, false, context, state)
def reading(input: Card.Heard, greet: Bool, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  if Plans.isNobody(state.policy) then quiet(greet, input, Lists.List.nil(), context, state) else learning(input, Next.read({greet: greet}), Lists.List.nil(), doors(state), context, state)
# A reply a card handed on (it has no policy of its own) is read against that card's forms.
def handedOn(input: Card.Heard, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  if Plans.isNobody(state.policy) then Card.Replied.silent({}) else callerRead(input, context, state)
def callerRead(input: Card.Heard, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match world.inspect({object: {world: context.world, object: context.caller}, source: false}):
    case inspected(i): consulted(input, {card: context.caller, forms: Lists.map(Card.offeredOnly(i.methods, i.offered), fn(f: Form.Form) -> Form.Form: Card.named(f, context.caller)), learned: Lists.List.nil()}, false, context, state)
    case _: Card.Replied.silent({})
# What hob reads against: the card the words answered ("" for the root), its forms, and what was
# learned of the doors (to prune a menu).
record Reading:
  card: String
  forms: Lists.List<Form.Form>
  learned: Learning
def consulted(input: Card.Heard, read: Reading, greet: Bool, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match world.view::<Policies.State>({object: state.policy}):
    case viewed(v): macroOr(input, v.state, Card.expanded(input.text, v.state), read, greet, context, state)
    case _: welcomed(greet, "", Card.Replied.silent({}), context, state)
# A macro of the policy's that the prose matches goes to the card its expansion names (its
# second word), with no model call.
def macroOr(input: Card.Heard, policy: Policies.State, expanded: Lists.Maybe<String>, read: Reading, greet: Bool, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match expanded:
    case some(e): byMacro(Mentions.wordAt(Text.words(e.value), 1n), e.value, input, greet, context, state)
    case none(_): interpreting(input, read, policy, greet, context, state)
def byMacro(card: String, text: String, input: Card.Heard, greet: Bool, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  if card == "" || card == context.object then welcomed(greet, "", Card.Replied.silent({}), context, state) else passOn(card, {text: text, post: input.post}, greet, context, state)
# hob reads the words once against the forms; the host fits its spell and answers the proposal
# with the card it names, or hob's `none`, `card` or `ask`.
def interpreting(input: Card.Heard, read: Reading, policy: Policies.State, greet: Bool, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match world.interpret::<Data>(Card.interpretation(input.text, read.forms, state.policy, "", Card.misfitLine(input.misfit))):
    case proposal(p): proposed(p.object, p.method, p.argument, read.forms, policy, greet, context, state)
    case proposals(p): folding(p.items, Lists.List.nil(), "", policy, greet, context, state)
    case unclear(u): hobbed(Card.hobNeeds(u.needs, read.forms), input, read, policy, greet, context, state)
    case replied(r): hobbed(Card.hobSaid(r.text), input, read, policy, greet, context, state)
    case denied(_): refusing("policy", "The policy is not visible to you.", greet, context, state)
    case _: welcomed(greet, "", Card.Replied.silent({}), context, state)
# hob's answer that is no spell: none is quiet (the hourly menu for a reply to the root itself),
# card the card answered (the menu at the root), ask hob's question over the nearest doors
# (at the root) or the card's first spell.
def hobbed(hob: Card.Hob, input: Card.Heard, read: Reading, policy: Policies.State, greet: Bool, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match hob:
    case none(_): quiet(greet, input, read.learned, context, state)
    case card(_): if read.card == "" then withChanges(Card.Replied.usage({}), "", 0n, "", context, state) else doorCard({world: context.world, object: read.card}, context)
    case ask(a): toldThen(asking(a.needs, input, read, context, state), Card.Replied.unclear({needs: a.needs}), greet, context, state)
# hob's lines are fixed (VOICE's second miss), with only the fields the forms name.
def asking(needs: Form.Names, input: Card.Heard, read: Reading, context: Abi.Context, state: State) -> Document.Document:
  if read.card == "" then Menu.pruned(missLine(needs), nearest(input, read.learned, state), menu(state), context) else Card.askCard(needs, read.card, read.forms)
def missLine(needs: Form.Names) -> String:
  if Lists.length(needs) == 0n then "hob: no door takes that as said. The nearest:" else "hob: no door takes that as said; still needs {Text.joined(needs)}. The nearest:"
def nearest(input: Card.Heard, learned: Learning, state: State) -> Lists.List<Door>:
  let all = menu(state)
  let touched = touchedDoors(input, learned, state)
  if Lists.length(touched) == 0n then Lists.filter(all, fn(d: Door) -> Bool: Plans.isNobody(d.to) == false && Menu.isArc(all, d) == false) else touched
# A proposal runs on its door as this turn, unless the policy confirms that action first: then
# the speaker is shown the spell to send.
def proposed(object: String, method: String, argument: Data, forms: Lists.List<Form.Form>, policy: Policies.State, greet: Bool, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  if Card.confirms(policy, method) then toldThen(Mentions.askedFirst(object, Lists.filter(forms, fn(f: Form.Form) -> Bool: f.card == object && f.action == method)), Card.Replied.asked({card: object}), greet, context, state) else callingDoor(object, method, argument, greet, context, state)
def callingDoor(object: String, method: String, argument: Data, greet: Bool, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match world.call::<Data>({object: {world: context.world, object: object}, method: method, argument: argument}):
    case returned(_): visited(object, Card.Replied.passed({card: object}), greet, context, state)
    case denied(_): refusing("notVisible", "The card {object} is not visible to you.", greet, context, state)
    case refused(r): refusing(r.clause, if r.reading == "" then "Not done at {object}." else r.reading, greet, context, state)
# Several spells (docs/MENU.md §2.2): each item in order, as this turn, its call admitted or
# refused on its own (one the policy confirms is not run); the card lists each spell with what
# came of it, and the reader's door is the first admitted one's.
def folding(items: Lists.List<World.Proposed<Data>>, ran: Card.Examples, first: String, policy: Policies.State, greet: Bool, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match items:
    case nil(_): folded(ran, first, greet, context, state)
    case cons(c): foldOne(c.head, c.tail, ran, first, policy, greet, context, state)
def foldOne(item: World.Proposed<Data>, rest: Lists.List<World.Proposed<Data>>, ran: Card.Examples, first: String, policy: Policies.State, greet: Bool, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match item:
    case proposal(p): if Card.confirms(policy, p.method) then folding(rest, Lists.append(ran, {example: "delvetalk {p.object} {p.method}", comes: "asks first: reply with it filled in"}), first, policy, greet, context, state) else foldCall(p.object, p.method, p.argument, rest, ran, first, policy, greet, context, state)
    case unclear(u): folding(rest, Lists.append(ran, {example: "(spell {natText(Lists.length(ran) + 1n)})", comes: "unclear: {Text.joined(u.reasons)}"}), first, policy, greet, context, state)
def foldCall(object: String, method: String, argument: Data, rest: Lists.List<World.Proposed<Data>>, ran: Card.Examples, first: String, policy: Policies.State, greet: Bool, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  let spell = "delvetalk {object} {method}"
  match world.call::<Data>({object: {world: context.world, object: object}, method: method, argument: argument}):
    case returned(_): folding(rest, Lists.append(ran, {example: spell, comes: "admitted"}), if first == "" then object else first, policy, greet, context, state)
    case denied(_): folding(rest, Lists.append(ran, {example: spell, comes: "refused notVisible: The card {object} is not visible to you."}), first, policy, greet, context, state)
    case refused(r): folding(rest, Lists.append(ran, {example: spell, comes: Menu.refusedLine(r.clause, r.reading, object)}), first, policy, greet, context, state)
def folded(ran: Card.Examples, first: String, greet: Bool, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match world.offer({to: "", document: Menu.ran(ran)}):
    case _: visited(first, Card.Replied.several({count: Lists.length(ran)}), greet, context, state)
def touchedDoors(input: Card.Heard, learned: Learning, state: State) -> Lists.List<Door>:
  let all = menu(state)
  Lists.filter(all, fn(d: Door) -> Bool: Plans.isNobody(d.to) == false && Menu.isArc(all, d) == false && Mentions.touches(Card.heard(input), d, learned))
# Nothing came of a reply: a first reply's card; a reply to the commonplace itself, the doors
# pruned to the doors it named (all when none) under one line, once an hour per speaker
# (`missed`, 60 clock minutes), then quiet: a conversation in its thread costs at most one card
# an hour; a reply a card handed on, nothing.
def quiet(greet: Bool, input: Card.Heard, learned: Learning, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  if greet || context.caller != "" || missedLately(context, state) then welcomed(greet, "", Card.Replied.silent({}), context, state) else heardNothing(touchedDoors(input, learned, state), context, state)
def heardNothing(touched: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  let all = menu(state)
  let written(_) = write {missed: upsert {principal: context.principal, at: context.clock}}
  Card.tell(Card.Replied.usage({}), Menu.pruned(Menu.nothingHead(), if Lists.length(touched) == 0n then Lists.filter(all, fn(d: Door) -> Bool: Menu.isArc(all, d) == false) else touched, all, context))
def missedLately(context: Abi.Context, state: State) -> Bool:
  match Relations.lookup(state.missed, {principal: context.principal}, missedKey):
    case some(m): context.clock < m.value.at + 60n
    case none(_): false
# For a card's default receive (Card.answerAs): whether a reply to it that fits no form is owed
# its usage card, under the same hourly bound; asking marks it.
def due(state: State, input: {}, context: Abi.Context) -> Activity<Bool>:
  if missedLately(context, state) then false else dueMarked(context)
def dueMarked(context: Abi.Context) -> Activity<Bool>:
  let written(_) = write {missed: upsert {principal: context.principal, at: context.clock}}
  true
# A link door (no object) answers with its description.
def linkDoor(door: Door) -> Activity<Card.Replied>:
  Card.tell(Card.Replied.usage({}), Document.text("{door.label}\n{door.description}\n"))
def doorCard(to: Plans.Reference, context: Abi.Context) -> Activity<Card.Replied>:
  match world.card({object: to}):
    case carded(c): Card.tell(Card.Replied.usage({}), c.document)
    case _: Card.tell(Card.Replied.refused({clause: "noCard", reading: "No card at {to.object}"}), Document.text("The door to {to.object} opens on nothing yet.\n"))
# The menu once per principal (the newest 2,048), under hob's greeting: with no policy at once;
# with one, after hob read the words.
def greeting(input: Card.Heard, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  let written(_) = write {greeted: insert {principal: context.principal}, missed: upsert {principal: context.principal, at: context.clock}}
  if Plans.isNobody(state.policy) then welcomed(true, "", Card.Replied.usage({}), context, state) else reading(input, true, context, state)
