layer over ./Record.obend
edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Rows.obend as Rows
import ./Text.obend as Text
import ./Menu.obend as Menu
import ./Scenes.obend as Scenes
# The commonplace's body, over RECORD (docs/METAPHYSICS.md §5, §7.5): the town's first card.
# What changed in the town, newest first (World.changed, read when the card is asked for, so
# nothing is kept to say it), then the doors the hand named (the record's `cites`, each with
# the spells the card prints under it), then the tail. The opener keeps it: a line written
# here is [pending] until admitted, as in any kept record.
#
# A door's word gets that door's card. Any other words are the host's: hob reads them against
# the commonplace's forms and its doors' (OVERHAUL §2.7), and runs what it reads as the speaker's
# turn; the commonplace answers them with silence.
type State = Super.State
type Door = Card.Doorway
def doors(state: State) -> Lists.List<Door>:
  state.cites
# The card without what changed (a card is pure): what wants a hand, which the host hands it as it
# hands it the reader (`wanting`, the daily rotated page this reader may answer), then the doors, with the
# spell that asks what changed.
def renderWanting(state: State, context: Abi.Context, wanting: World.WantPage) -> Document.Document:
  Menu.trie(state.cites, Menu.unread("  delvetalk commonplace since / entry: 0\n  » what changed since that entry, newest first\n"), wantLines(wanting), context)
# What changed since an entry, over the doors.
def since(state: State, input: SinceInput, context: Abi.Context) -> Activity<Card.Replied>:
  withChanges(Card.Replied.done({action: "since"}), input.entry, context, state)
form since:
  entry: natural 0..1000000000
form write:
  text: text 1..280
form admit:
  number: natural 1..1000000000
form lines:
  from: natural 1..1000000000
form door:
  label: text 1..32
  to: text 1..128
form undoor:
  label: text 1..32
def write(state: State, input: WriteInput, context: Abi.Context) -> Activity<Nat>:
  Super.write(state, {text: input.text}, context)
def admit(state: State, input: AdmitInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.admit(state, {number: input.number}, context)
def lines(state: State, input: LinesInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.lines(state, {from: input.from}, context)
def door(state: State, input: DoorInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.door(state, {label: input.label, to: input.to}, context)
def undoor(state: State, input: UndoorInput, context: Abi.Context) -> Activity<Card.Replied>:
  Super.undoor(state, {label: input.label}, context)
def actions(state: State, context: Abi.Context) -> Lists.List<String>:
  Lists.concat(Text.words("since write lines"), Lists.concat(if state.keeper != "" && context.principal == state.keeper then Text.words("admit") else Text.words(""), if context.principal == state.owner then Text.words("door undoor") else Text.words("")))
def methods() -> Lists.List<String>:
  Text.words("")
def refusing(clause: String, reading: String, context: Abi.Context) -> Activity<Card.Replied>:
  Card.refusing(Card.Replied.refused({clause: clause, reading: reading}), {clause: clause, reading: reading}, context)
# The reply to the commonplace (a spell naming another card never reaches here: the host runs it
# there). Blank words get the card over what changed; a door word gets that door's card.
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  if Text.blank(input.text) && Lists.length(input.fields) == 0n then withChanges(Card.Replied.usage({}), 0n, context, state) else worded(doorFor(doors(state), doorWord(input.text)), context)
# A door word is short: only the first 65 scalars are looked at.
def doorWord(text: String) -> String:
  let head = textTake(Text.trimStart(text), 65n)
  if textLength(head) > 64n then "" else Text.trimEnd(head)
# The card over what changed since an entry (World.changed; a derived read, no root). Left out: the
# commonplace's own change (its lines are on its own card) and a principal's own avatar, which a
# card never names (whatever names the principal: a DID, a Zulip id).
def ownCard(id: String) -> Bool:
  Text.contains(textTake(id, Text.indexOf(id, "/")), ":")
def withChanges(result: Card.Replied, since: Nat, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match world.changed({since: since, prefix: "", after: ""}):
    case changed(c): wanted(result, Menu.changes(Lists.filter(c.items, fn(i: World.Change) -> Bool: i.object.object != context.object && ownCard(i.object.object) == false)), context, state)
    case denied(_): wanted(result, Menu.changes(Lists.List.nil()), context, state)
# The answerable page rotates daily through the oldest-first wants; held wants for other hands
# are counted. It leads the card, and what changed yields it room (Menu.trie).
def wanted(result: Card.Replied, changes: Menu.Changed, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match world.wanting({after: 0n, limit: 8n, oldest: true}):
    case wanting(w): Card.tell(result, Menu.trie(state.cites, changes, wantLines(w), context))
    case refused(_): Card.tell(result, Menu.trie(state.cites, changes, Lists.List.nil(), context))
def wantLines(page: World.WantPage) -> Lists.List<String>:
  let held = if page.waiting == 0n then Lists.List::<String>.nil() else Lists.List.cons({head: "{natText(page.waiting)} more wait on other hands\n", tail: Lists.List.nil()})
  Lists.concat(held, Lists.map(page.rows, wantLine))
def wantLine(row: World.Want) -> String:
  "{row.object}: {row.reading}\n  {row.asks}\n"
def doorFor(doors: Lists.List<Door>, word: String) -> Lists.Maybe<Door>:
  Lists.find(doors, fn(door: Door) -> Bool: word != "" && (door.label == word || door.to.object == word))
def worded(found: Lists.Maybe<Door>, context: Abi.Context) -> Activity<Card.Replied>:
  match found:
    case some(d): if Plans.isNobody(d.value.to) then linkDoor(d.value) else doorCard(d.value.to, context)
    case none(_): Card.Replied.silent({})
# A link door (no object) answers with its description.
def linkDoor(door: Door) -> Activity<Card.Replied>:
  Card.tell(Card.Replied.usage({}), Document.text("{door.label}\n{door.description}\n"))
def doorCard(to: Plans.Reference, context: Abi.Context) -> Activity<Card.Replied>:
  match world.card({object: to}):
    case carded(c): Card.tell(Card.Replied.usage({}), c.document)
    case _: refusing("noCard", "The door to {to.object} opens on nothing yet", context)
# --- The town's history ------------------------------------------------------------------
# A clock day of the town (docs/VOICE.md "The book, the history, the map"): its date, the chronicle's exact lines
# (`chronicle {day}`), and the town's firsts credited to who did each; read by `delvetalk chronicle` (today), `/ day: N`,
# `/ from: N / to: M` (a day a page, each naming the next) and the page /history. The host hands it the day
# (`World.Annal`) and paints the day above it where a transport shows paint; it writes nothing. Its pages leave the
# day's paint room in a reply.
def chronicle(state: State, context: Abi.Context, annal: World.Annal) -> Document.Document:
  let spell = if annal.from == annal.to then "delvetalk chronicle / day: {natText(annal.day)}" else "delvetalk chronicle / from: {natText(annal.day)} / to: {natText(annal.to)}"
  let pages = Card.paged(Lists.concat(Lists.List.cons({head: historyHead(annal), tail: Lists.map(annal.lines, fn(l: String) -> String: "{l}\n")}), firstsLines(annal.firsts)), historyRoom(context))
  let shown = Card.pageOf(pages, annal.page, spell)
  let last = annal.page == 0n || annal.page >= Lists.length(pages)
  Document.Document.sequence({items: Document.Documents.cons({head: shown, tail: Document.Documents.cons({head: Document.text(if last then onward(annal) else ""), tail: Document.Documents.nil()})})})
# A reply's characters less the day's paint above it (at most 600) and the lines under it.
def historyRoom(context: Abi.Context) -> Nat:
  Card.room(context) - 600n - 180n
def historyHead(annal: World.Annal) -> String:
  let of = if annal.from == annal.to then "" else ", {natText(annal.day - annal.from + 1n)} of {natText(annal.to - annal.from + 1n)} days"
  "THE TOWN'S HISTORY · day {natText(annal.day)}, {annal.date}{of}\n"
# The next day of a range, else the day before (while the journal holds one).
def onward(annal: World.Annal) -> String:
  if annal.day < annal.to then "The next day: delvetalk chronicle / from: {natText(annal.day + 1n)} / to: {natText(annal.to)}\n" else if annal.from == annal.to && annal.day > annal.first then "The day before: delvetalk chronicle / day: {natText(annal.day - 1n)}\n" else ""
# Who did each of the town's first acts.
def firstsLines(firsts: Lists.List<World.First>) -> Lists.List<String>:
  if Lists.length(firsts) == 0n then Lists.List.nil() else Lists.List.cons({head: "Firsts:\n", tail: Lists.map(firsts, firstLine)})
def firstLine(f: World.First) -> String:
  let entry = if f.at == 0n then "" else ", entry {natText(f.at)}"
  if f.what == "rain" then "  the first rain: {f.who} on {f.object}{entry}\n" else if f.what == "room" then "  the first room: {f.object}, made by {f.who}{entry}\n" else if f.what == "verb" then "  the first grown verb: {f.name} on {f.object}, grown by {f.who}{entry}\n" else if f.what == "rule" then "  the first rule fired: {f.name} on {f.object}, written by {f.who}{entry}\n" else "  the first coinage: {f.object}, coined by {f.who}{entry}\n"
# --- The door map ---------------------------------------------------------------------------
# Geography here is citation (docs/METAPHYSICS.md §7): which cards open onto which, as a compact indented tree from
# the commonplace, or from any card (`delvetalk map`, `delvetalk <card> map`, the page /map); the host hands every door
# the reader may follow (`World.Ways`). Three levels drawn, a card met before said `(above)`, the doors past the third
# counted; a card's map says the way to it from the commonplace and which doors open onto it. Writes nothing.
record Drawn:
  lines: Lists.List<String>
  seen: Lists.List<String>
def map(state: State, context: Abi.Context, ways: World.Ways) -> Document.Document:
  let spell = if ways.root == "commonplace" then "delvetalk map" else "delvetalk {ways.root} map"
  let tree = drawnFrom(ways.root, 2n, "  ", ways, {lines: Lists.List.nil(), seen: Lists.List.cons({head: ways.root, tail: Lists.List.nil()})})
  let body = if Lists.length(tree.lines) == 0n then Lists.List.cons({head: "  It opens onto no card yet.\n", tail: Lists.List.nil()}) else tree.lines
  Card.pageOf(Card.paged(Lists.concat(Lists.concat(mapHead(ways), Lists.List.cons({head: "{ways.root}{lying(ways, ways.root)}\n", tail: body})), mapFoot(ways)), Card.room(context) - 160n), ways.page, spell)
def mapHead(ways: World.Ways) -> Lists.List<String>:
  if ways.root == "commonplace" then Lists.List.cons({head: "THE DOOR MAP · from the commonplace\n", tail: Lists.List.nil()}) else Lists.List.cons({head: "THE DOOR MAP · from {ways.root}\n", tail: Lists.List.cons({head: wayHere(ways), tail: Lists.List.nil()})})
def wayHere(ways: World.Ways) -> String:
  let path = textJoin(ways.path, " › ")
  if Lists.length(ways.path) > 1n then "The way here: {path}\n" else "No door leads here from the commonplace.\n"
# Which doors open onto a card that is not the commonplace; how to draw another's.
def mapFoot(ways: World.Ways) -> Lists.List<String>:
  let into = Lists.filter(ways.ways, fn(w: World.Way) -> Bool: w.to == ways.root)
  let opened = textJoin(Lists.map(into, fn(w: World.Way) -> String: "{w.from} ({w.label})"), ", ")
  let onto = if ways.root == "commonplace" || Lists.length(into) == 0n then Lists.List::<String>.nil({}) else Lists.List.cons({head: "Doors onto it: {opened}\n", tail: Lists.List.nil()})
  Lists.append(onto, "A card's own map: delvetalk <card> map\n")
def outOf(ways: World.Ways, node: String) -> Lists.List<World.Way>:
  Lists.filter(ways.ways, fn(w: World.Way) -> Bool: w.from == node)
def drawnFrom(node: String, depth: Nat, indent: String, ways: World.Ways, acc: Drawn) -> Drawn:
  doorsOut(outOf(ways, node), depth, indent, ways, acc)
def doorsOut(doors: Lists.List<World.Way>, depth: Nat, indent: String, ways: World.Ways, acc: Drawn) -> Drawn:
  match doors:
    case nil(_): acc
    case cons(c): doorsOut(c.tail, depth, indent, ways, wayDrawn(c.head, depth, indent, ways, acc))
def wayDrawn(way: World.Way, depth: Nat, indent: String, ways: World.Ways, acc: Drawn) -> Drawn:
  let head = "{indent}{wayLabel(way)}"
  let seen = Lists.List.cons({head: way.to, tail: acc.seen})
  if Lists.any(acc.seen, fn(s: String) -> Bool: s == way.to) then {lines: Lists.append(acc.lines, "{head} (above)\n"), seen: acc.seen} else if depth == 0n then {lines: Lists.append(acc.lines, "{head}{lying(ways, way.to)}{beyond(ways, way.to)}\n"), seen: seen} else drawnFrom(way.to, depth - 1n, "{indent}  ", ways, {lines: Lists.append(acc.lines, "{head}{lying(ways, way.to)}\n"), seen: seen})
def wayLabel(way: World.Way) -> String:
  if way.label == way.to then "→ {way.to}" else "{way.label} → {way.to}"
def lying(ways: World.Ways, node: String) -> String:
  match Lists.find(ways.lying, fn(l: World.Lying) -> Bool: l.object == node):
    case some(l): " · {natText(l.value.count)} lying here"
    case none(_): ""
def beyond(ways: World.Ways, node: String) -> String:
  let n = Lists.length(outOf(ways, node))
  if n == 0n then "" else if n == 1n then " · 1 door beyond" else " · {natText(n)} doors beyond"
