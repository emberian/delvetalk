layer over ./Record.obend
edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Scenes.obend as Scenes
import ./Relation.obend as Relations
import ./Rows.obend as Rows
import ./Text.obend as Text
# The regular's body, over the inhabitant's (`kind/regular`; glm's regular, docs/review/station-trawl-2026-10-12.md
# 20): at the clock hour `hour` each day, by her own rule on the tide, she comes into her place, pushes the door
# as anyone does (the station's own rule rings mimo's bell for it), is seen coming in with frost on her shoulders,
# and leaves a coin from a country that redraws its borders lying there, a THING of her own anyone may inspirit
# or pick up; at the next hour, by her second rule, she goes. A hand nods to her or asks her something while she
# is there; she answers in glm's words, and the line is theirs.
type State = Super.State
type Done = Scenes.Done
form nod:
form ask:
  words: text 1..280
form come:
form go:
def hour(state: State) -> Nat:
  Text.digits(Super.field(state, "hour"), 0n) % 24n
def haunting(state: State, context: Abi.Context) -> Lists.List<Super.Haunting>:
  Lists.append(Lists.append(Lists.List.nil(), Super.atHour(state, context, "comes", hour(state), "delvetalk {context.object} come")), Super.atHour(state, context, "goes", hour(state) + 1n, "delvetalk {context.object} go"))
def verbs() -> String:
  "nod ask"
def moves() -> String:
  "haunt come go"
# Coming in at her hour: the door, as anyone pushes it; then she is seen; then the coin.
def come(state: State, context: Abi.Context) -> Activity<Nat>:
  if Super.own(context) == false then Super.moveRefused(state, context) else coming(state, context)
def coming(state: State, context: Abi.Context) -> Activity<Nat>:
  match Super.comeIn(state, "came in at the hour, frost on her shoulders", context):
    case moved(m): pushing(extend(state, {next: m.n + 1n}), context)
    case stayed(_): 0n
def pushing(state: State, context: Abi.Context) -> Activity<Nat>:
  match Super.onPlace(state, "choose", {choice: "Push the door"}, context):
    case _: seen(state, context)
def seen(state: State, context: Abi.Context) -> Activity<Nat>:
  match Super.onPlace(state, "emote", {line: "comes in with frost on her shoulders that does not melt indoors, nods at the clock the way you nod at a coworker, and pays for a coffee with a coin from a country that redraws its borders"}, context):
    case _: paying(state, context)
# The coin: a copy of her place's coin (`<place>/coin`, a THING) made hers and laid where she stands, for
# anyone to inspirit or pick up.
def paying(state: State, context: Abi.Context) -> Activity<Nat>:
  match world.call::<Done>({object: {world: context.world, object: "{Super.place(state)}/coin"}, method: "copyInto", argument: {at: Super.placeOf(state, context)}}):
    case returned(r): if Super.refusedDone(r.result) then Super.ownLine(state, "paid", "paid; no coin was left", context) else Super.ownLine(state, "paid", "left a coin in the till", context)
    case _: Super.ownLine(state, "paid", "paid; no coin was left", context)
def go(state: State, context: Abi.Context) -> Activity<Nat>:
  if Super.own(context) == false then Super.moveRefused(state, context) else gone(state, context)
def gone(state: State, context: Abi.Context) -> Activity<Nat>:
  match Super.goOut(state, "went at the hour after", context):
    case moved(m): m.n
    case stayed(_): 0n
def when(state: State) -> String:
  "she comes at clock hour {natText(hour(state))} and goes at {natText((hour(state) + 1n) % 24n)}"
def nod(state: State, context: Abi.Context) -> Activity<Nat>:
  if Super.present(state) == false then Super.away(when(state), context) else Super.hears(state, "nod", "a nod", "She nods back, the way you nod at a coworker.", context)
def ask(state: State, input: AskInput, context: Abi.Context) -> Activity<Nat>:
  if Super.present(state) == false then Super.away(when(state), context) else Super.hears(state, "ask", input.words, "“Same as you. The hallway doesn't care which side you enter from.” She glances toward the far end of things. “Clocks are local, hon.”", context)
def doing(state: State) -> String:
  "once a day, at the same hour, she comes in with frost on her shoulders and pays for a coffee with a coin from a country that redraws its borders; {when(state)}"
def now(state: State, id: String) -> String:
  if Super.present(state) then "She is in {Super.place(state)} now. Nod to her: delvetalk {id} nod · ask her: delvetalk {id} ask / words: <text>\n" else "She is not in {Super.place(state)} now; she comes at clock hour {natText(hour(state))}. Then: delvetalk {id} ask / words: <text>\n"
