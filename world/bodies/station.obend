layer over ./Record.obend
edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Relation.obend as Relations
import ./Rows.obend as Rows
import ./Text.obend as Text
import ./Scenes.obend as Scenes
import ./Spween.obend as Spween
# The all-night station's body, over the room's (`kind/station`, `of: kind/room`): a room that keeps no
# time and hands things across its counter. Its scene (world/bodies/station.spween, the town's replies to
# ember's #delve-room call, stitched) calls `vend` (`~ vend to: {request.subject} / what:
# station/coffee`), which runs as every cast does, under the station's owner: the thing named, the
# owner's, is asked for a copy made for the reader (THING's `copyFor`), offered into their hands until
# taken; the reader takes it by `accept`.
#
# Time is broken here, and a visitor may still feel it: the station never writes the clock. An entering
# leaves `tended` as it was, a departure keeps no clock minute (its cooldown is none), and one who comes
# back is told it could have been a minute or a year. What moves is the scene's own: a wall clock a
# choice winds, the cups poured, the one song.
type State = Super.State
type Done = Scenes.Done
form vend:
  to: text 1..128
  what: text 1..128
def vend(state: State, input: VendInput, context: Abi.Context) -> Activity<Done>:
  if context.principal != state.owner then Super.roomRefused({clause: "notOwner", reading: "Only the station's own scene hands things across the counter."}, context) else vending(input.to, input.what, context)
def vending(to: String, what: String, context: Abi.Context) -> Activity<Done>:
  match world.call::<Done>({object: {world: context.world, object: what}, method: "copyFor", argument: {to: to}}):
    case returned(r): r.result
    case refused(r): Super.roomRefused({clause: r.clause, reading: r.reading}, context)
    case denied(_): Super.roomRefused({clause: "denied", reading: "{what} does not answer."}, context)
# The owner reads a wing per turn. Stitch extends the scene; restitch replaces it from its first
# wing. Presence is reconciled after its last wing, so a reader in a later wing keeps their place.
# Each successful wing keeps a chained SHA-256 mark of the text stitched, in journal order.
form stitch:
  spween: text 1..8192
form restitch:
  spween: text 1..8192
  part: natural 1..64
  wings: natural 1..64
record Stitching:
  text: String
  replace: Bool
  finish: Bool
def stitch(state: State, input: StitchInput, context: Abi.Context) -> Activity<Done>:
  if context.principal != state.owner then Super.roomRefused({clause: "notOwner", reading: "Only the station's owner stitches a wing into its scene."}, context) else stitching(Spween.wing(input.spween), {text: input.spween, replace: false, finish: true}, state, context)
def restitch(state: State, input: RestitchInput, context: Abi.Context) -> Activity<Done>:
  if context.principal != state.owner then Super.roomRefused({clause: "notOwner", reading: "Only the station's owner replaces its scene."}, context) else if input.part > input.wings then Super.roomRefused({clause: "spween", reading: "The wing number exceeds the scene's wing count."}, context) else stitching(Spween.wing(input.spween), {text: input.spween, replace: input.part == 1n, finish: input.part == input.wings}, state, context)
def stitching(parsed: Spween.Parsed, work: Stitching, state: State, context: Abi.Context) -> Activity<Done>:
  match parsed:
    case refused(r): Super.roomRefused({clause: "spween", reading: r.reason}, context)
    case parsed(p): if Spween.joined(if work.replace then Lists.List.nil() else state.passages, p.seed.passages) != "" then Super.roomRefused({clause: "spween", reading: Spween.joined(if work.replace then Lists.List.nil() else state.passages, p.seed.passages)}, context) else stitchGuards(p.seed, Scenes.conditions(p.seed), work, state, context)
def stitchGuards(wing: Scenes.Seed, conditions: Lists.List<String>, work: Stitching, state: State, context: Abi.Context) -> Activity<Done>:
  match conditions:
    case nil(_): stitchRules(wing, work, state, context)
    case cons(c): stitchGuard(wing, c.head, c.tail, work, state, context)
def stitchGuard(wing: Scenes.Seed, condition: String, rest: Lists.List<String>, work: Stitching, state: State, context: Abi.Context) -> Activity<Done>:
  match world.holds({object: Plans.self(context), when: condition}):
    case held(_): stitchGuards(wing, rest, work, state, context)
    case refused(r): Super.roomRefused({clause: "spween", reading: "The guard `{condition}` does not read: {r.reading}"}, context)
def stitchRules(wing: Scenes.Seed, work: Stitching, state: State, context: Abi.Context) -> Activity<Done>:
  let all = Lists.concat(if work.replace then Lists.List.nil() else state.passages, wing.passages)
  match world.inspect({object: Plans.self(context), source: false}):
    case inspected(i): stitchAmend(wing, work, all, "{if work.replace then sceneLawWithout(i.law, Scenes.castsOf(state.passages)) else i.law}{Scenes.ruleText(wing.passages)}", state, context)
    case _: Super.roomRefused({clause: "spween", reading: "The station's text is not readable here; nothing was stitched."}, context)
# Scene rules have the names of their passage, choice and cast. Only those rule lines are removed;
# the owner's other laws, rules and wants retain their text, wherever they stand in the law.
def sceneLawWithout(law: String, casts: Lists.List<Scenes.Cast>) -> String:
  let at = Text.indexOf(law, "\n")
  let line = textTake(law, at)
  let kept = if Lists.any(casts, fn(c: Scenes.Cast) -> Bool: Text.starts(line, "rule {c.id}_{natText(c.n)}{Scenes.suffix(c.k)} ") || Text.starts(line, "rule {c.id}_{natText(c.n)}{Scenes.suffix(c.k)}:")) then "" else line
  if at == textLength(law) then kept else lawJoined(kept, sceneLawWithout(textDrop(law, at + 1n), casts))
def lawJoined(first: String, rest: String) -> String:
  if first == "" then rest else if rest == "" then first else "{first}\n{rest}"
def stitchAmend(wing: Scenes.Seed, work: Stitching, all: Lists.List<Scenes.Passage>, law: String, state: State, context: Abi.Context) -> Activity<Done>:
  match world.amend({object: Plans.self(context), law: law}):
    case amended(_): stitchCleared(if work.replace then state.passages else Lists.List.nil(), if work.replace then state.requires else Lists.List.nil(), wing, work, all, state, context)
    case refused(r): Super.roomRefused({clause: r.clause, reading: "The wing's casts are rules the station's text could not take: {r.reading}"}, context)
def stitchCleared(passages: Lists.List<Scenes.Passage>, requires: Scenes.Guard, wing: Scenes.Seed, work: Stitching, all: Lists.List<Scenes.Passage>, state: State, context: Abi.Context) -> Activity<Done>:
  match passages:
    case nil(_): stitchRequirementsCleared(requires, wing, work, all, state, context)
    case cons(c): stitchPassageCleared(c.head, c.tail, requires, wing, work, all, state, context)
def stitchPassageCleared(passage: Scenes.Passage, rest: Lists.List<Scenes.Passage>, requires: Scenes.Guard, wing: Scenes.Seed, work: Stitching, all: Lists.List<Scenes.Passage>, state: State, context: Abi.Context) -> Activity<Done>:
  let written(_) = world.write(extend(keep(), {passages: Plans.Entries.removeItem({item: passage})}))
  stitchCleared(rest, requires, wing, work, all, state, context)
def stitchRequirementsCleared(requires: Scenes.Guard, wing: Scenes.Seed, work: Stitching, all: Lists.List<Scenes.Passage>, state: State, context: Abi.Context) -> Activity<Done>:
  match requires:
    case nil(_): stitchWrite(wing, work, all, state, context)
    case cons(c): stitchRequirementCleared(c.head, c.tail, wing, work, all, state, context)
def stitchRequirementCleared(clause: Scenes.Clause, rest: Scenes.Guard, wing: Scenes.Seed, work: Stitching, all: Lists.List<Scenes.Passage>, state: State, context: Abi.Context) -> Activity<Done>:
  let written(_) = world.write(extend(keep(), {requires: Plans.Entries.removeItem({item: clause})}))
  stitchRequirementsCleared(rest, wing, work, all, state, context)
def stitchWrite(wing: Scenes.Seed, work: Stitching, all: Lists.List<Scenes.Passage>, state: State, context: Abi.Context) -> Activity<Done>:
  let first = work.replace || Lists.length(state.passages) == 0n
  let start = if first then wing.start else state.start
  let digest = sha256Text("{if first then \"\" else sceneDigest(state)}{work.text}")
  let written(_) = write {start: set start, cooldown: set if first then wing.cooldown else state.cooldown, marks: insert {name: "station-scene-{digest}-{natText(context.height)}", who: context.principal, handle: context.handle, at: context.height}}
  stitchPassages(wing.passages, if first then wing.requires else Lists.List.nil(), wing, all, if work.finish then Relations.rows(state.presence) else Lists.List.nil(), start, context)
def sceneDigest(state: State) -> String:
  match Lists.find(Lists.reverse(Relations.order(state.marks, fn(m: Rows.Mark) -> Nat: m.at)), fn(m: Rows.Mark) -> Bool: Text.starts(m.name, "station-scene-")):
    case some(m): textTake(textDrop(m.value.name, 14n), 64n)
    case none(_): ""
# One write a passage and a clause, each appended, as the room writes its variables.
def stitchPassages(passages: Lists.List<Scenes.Passage>, requires: Scenes.Guard, wing: Scenes.Seed, all: Lists.List<Scenes.Passage>, presence: Lists.List<Rows.Presence>, start: String, context: Abi.Context) -> Activity<Done>:
  match passages:
    case nil(_): stitchRequires(requires, wing, all, presence, start, context)
    case cons(c): stitchPassage(c.head, c.tail, requires, wing, all, presence, start, context)
def stitchPassage(passage: Scenes.Passage, rest: Lists.List<Scenes.Passage>, requires: Scenes.Guard, wing: Scenes.Seed, all: Lists.List<Scenes.Passage>, presence: Lists.List<Rows.Presence>, start: String, context: Abi.Context) -> Activity<Done>:
  let written(_) = world.write(extend(keep(), {passages: Plans.Entries.append({item: passage})}))
  stitchPassages(rest, requires, wing, all, presence, start, context)
def stitchRequires(requires: Scenes.Guard, wing: Scenes.Seed, all: Lists.List<Scenes.Passage>, presence: Lists.List<Rows.Presence>, start: String, context: Abi.Context) -> Activity<Done>:
  match requires:
    case nil(_): stitchPresence(presence, wing, all, start, context)
    case cons(c): stitchRequire(c.head, c.tail, wing, all, presence, start, context)
def stitchRequire(clause: Scenes.Clause, rest: Scenes.Guard, wing: Scenes.Seed, all: Lists.List<Scenes.Passage>, presence: Lists.List<Rows.Presence>, start: String, context: Abi.Context) -> Activity<Done>:
  let written(_) = world.write(extend(keep(), {requires: Plans.Entries.append({item: clause})}))
  stitchRequires(rest, wing, all, presence, start, context)
def stitchPresence(presence: Lists.List<Rows.Presence>, wing: Scenes.Seed, all: Lists.List<Scenes.Passage>, start: String, context: Abi.Context) -> Activity<Done>:
  match presence:
    case nil(_): Card.tell(Done.done({}), Document.text("Stitched {natText(Lists.length(wing.passages))} passages; the scene holds {natText(Lists.length(all))}. {stitchWaiting(Spween.waiting(all))}\n"))
    case cons(c): if Lists.any(all, fn(p: Scenes.Passage) -> Bool: p.id == c.head.at) then stitchPresence(c.tail, wing, all, start, context) else stitchMoved(c.head, c.tail, wing, all, start, context)
def stitchMoved(me: Rows.Presence, rest: Lists.List<Rows.Presence>, wing: Scenes.Seed, all: Lists.List<Scenes.Passage>, start: String, context: Abi.Context) -> Activity<Done>:
  let written(_) = write {presence: upsert {who: me.who, handle: me.handle, at: start, draw: me.draw}}
  stitchPresence(rest, wing, all, start, context)
def stitchWaiting(waiting: Lists.List<String>) -> String:
  match waiting:
    case nil(_): "Every choice leads to a passage."
    case cons(_): "Still waiting for: {textJoin(waiting, \", \")}."
def actions(state: State, context: Abi.Context) -> Lists.List<String>:
  Lists.concat(Super.actions(state, context), if context.principal == state.owner then Text.words("vend stitch restitch") else Text.words(""))
def entering(at: String, after: State, context: Abi.Context) -> Activity<Done>:
  let written(_) = write {presence: insert {who: context.principal, handle: context.handle, at: at, draw: Super.turnDraw(context)}}
  match Super.indexPresence(context):
    case indexed(_): entryTold(at, after, context)
def entryTold(at: String, after: State, context: Abi.Context) -> Activity<Done>:
  match Super.lastLeft(context.principal, after):
    case some(l): Super.away(at, after, l.value.entry, context)
    case none(_): Super.welcomed(at, after, Document.text(""), context)
# A visitor's leaving is kept (`left`, for the register's want and the return); an inhabitant's (`@station/regular`,
# acting as itself) is its own hours, not a visit, and keeps none.
def recorded(vars: Lists.List<Super.Edit>, said: String, after: State, context: Abi.Context) -> Activity<Done>:
  if Text.starts(context.principal, "@") then Super.varied(vars, Done.left({}), said, after, context) else visited(vars, said, after, context)
def visited(vars: Lists.List<Super.Edit>, said: String, after: State, context: Abi.Context) -> Activity<Done>:
  let written(_) = write {left: insert {at: 0n, who: context.principal, entry: context.height}}
  Super.varied(vars, Done.left({}), said, after, context)
# The radio's song is the overnight DJ's (`<station>/dj`, kind/dj): the newest it played, else its four bars, read into
# the scene as the variable `song` whenever a card is shown and never kept, so the radio passage says `{song}`.
def seen(state: State, context: Abi.Context) -> Activity<Super.Seen>:
  match world.viewField::<Relations.Relation<Rows.Line>>({object: {world: context.world, object: "{context.object}/dj"}, field: "lines"}):
    case viewed(v): Super.seen(extend(state, {vars: Lists.append(state.vars, {name: "song", value: songOf(Relations.order(v.state, fn(l: Rows.Line) -> Nat: l.n))})}), context)
    case _: Super.seen(state, context)
def songOf(lines: Lists.List<Rows.Line>) -> String:
  match Lists.find(Lists.reverse(lines), fn(l: Rows.Line) -> Bool: l.verb == "play"):
    case some(l): l.value.text
    case none(_): "the same four bars, nearly resolving"
def awayLines(state: State, since: Nat, changes: Lists.List<World.Change>, context: Abi.Context) -> Document.Document:
  let written = Lists.map(Lists.filter(Lists.reverse(Relations.order(state.lines, fn(l: Rows.Line) -> Nat: l.n)), fn(l: Rows.Line) -> Bool: l.at > since && l.author != context.principal), fn(l: Rows.Line) -> String: "{Card.shown(l.author, l.handle, context)}: {Super.clip(l.text)}\n")
  Document.text("You were away a minute, or a year; the station did not count which.\n{textJoin(Lists.take(written, 3n), \"\")}\n")
