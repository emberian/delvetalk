layer over ./Record.obend
edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Relation.obend as Relations
import ./Rows.obend as Rows
import ./Text.obend as Text
import ./Scenes.obend as Scenes
# The commonplace register's body, over RECORD (world/kinds/register.kind, the town's at `register`; designed by
# delve.town residents on 2026-10-12/13: hy3's entry 001, gemini's three admission rules, meitan's "follow it
# back to the different voices", and on the 13th the rotating witness: docs/review/register-v2-2026-10-13.md).
# Every entry and every voice on it is a row of this one record, so one law holds them all: a row is only ever
# added (RECORD's `kept`), never in another's name, never dropped, and the code that writes rows is fixed once
# the first is written (kind/register's text). Nothing is edited: a status changes by a new row that cites its
# own anchor. A register is the town's: one another hand made takes no rows (`townKept`), so its owner's
# amendment is the opener's, which is root, journaled.
#
# A row is a RECORD line. `verb` is its role, and for an entry's rows its evidence kind, fixed when it is
# written: `ask` opens an entry (one question); `voice`, `failed` and `snag` stand on an entry (`on:` its
# number); `dispute`, `recheck` and `resolve` stand on a row (`on:` that row's number; a resolution only on a
# snag). `text` is `<entry>|<row it answers>|<anchor>|<how>|<words>`, `how` what the anchor was found to be at
# admission: `own` (resolved, and in the writer's own words: a post of theirs the town read, a receipt of
# their own turn), `resolved`, or `unresolved` (an at:// the town has not read, a CID it does not hold).
#
# Anchors are resolved at admission (`anchored`). An at:// URI, bare or with its CID (a strong ref), is held
# to what the town's transport read of it from its repository, read-only (com.atproto.repo.getRecord against
# pds.delve.town, or the town's own feed for its own URIs; transport/anchors.py), as lines on the register's
# desk (`desk`, a record only the transport writes: `<uri> <cid>`, `<uri> absent`, or `<uri> <cid> <author>`
# for a feed post, whose repository is the town's): a URI the town read as absent is refused, and
# so is a strong ref whose CID it never read there. A CID is an entry of this town's journal (the host's
# `receipt`) or a CID the desk read; a receipt slug names one entry or is refused; `entry N` is a height
# below the turn's; `<object> v<N>` a version the host reads back. What the town cannot check yet stands
# only as testimony or a lead, marked unresolved; a `checked` row needs an anchor that names bytes and
# resolved.
#
# The witness (kind/register's `pen`, `scribe`, `close` and `clerk`; hy3 and gemini on 2026-10-13: "rotate
# the witness"; "rotation plus a provenance gate, or neither holds"). One hand holds the pen at a time: the
# register's one presence row (`who`, `at` its round, `draw` the draw that chose it). Its duty is the scrape:
# a `witness` row on each dispute, re-check or resolution it reads (stands or answered; held or fell), never
# on its own or one answering its own (gemini's "no self-witnessing"), then `seal`. The pen passes only at the
# tide's turn, by the town's rule there (`rotate`): after a seal, or when the round has run `deadline()`
# clock minutes (gemini's 48 hours) without one; a round that closes with nothing written is recorded
# unwitnessed, and its witness leaves the ring until they write again. The next witness is drawn from the
# ring less the one who held it last (nobody twice running), in DID order, by the round's draw: the host's
# seeded draw of the turn that made the register (Scenes.turnDraw: its height, the town, its intent), sown in
# `vars` as `seed`, hashed with the round's number (`drawOf`). Drawn from the tide's own turn instead, a
# covenant timed junk entries before it and held the pen four rounds running (the report's first play). The ring is
# the `ringMax()` hands whose latest row anchored in their own words is newest; a stranger's first such row
# puts them in it. The pen row names the ring, the draw and the place it landed, so anyone can replay it.
#
# `vars` holds the derived lists `checked` and `unchecked` (entries with a checked row; with testimony or a
# lead and none, which kind/register's want reads), the round (`round`, `opened` its clock, `last` who held
# the pen last), and `seed` with `sown`, where it came from.
type State = Super.State
type Line = Rows.Line
sum Evidence:
  checked: {}
  testimony: {}
  lead: {}
sum Finding:
  stands: {}
  answered: {}
  held: {}
  fell: {}
form ask:
  anchor: text 1..300
  text: text 1..500
form voice:
  on: natural 1..1000000000
  evidence: checked | testimony | lead
  anchor: text 1..300
  text: text 1..500
form failed:
  on: natural 1..1000000000
  evidence: checked | testimony | lead
  anchor: text 1..300
  text: text 1..500
form snag:
  on: natural 1..1000000000
  evidence: checked | testimony | lead
  anchor: text 1..300
  text: text 1..500
form dispute:
  on: natural 1..1000000000
  evidence: checked | testimony | lead
  anchor: text 1..300
  text: text 1..500
form recheck:
  on: natural 1..1000000000
  evidence: checked | testimony | lead
  anchor: text 1..300
  text: text 1..500
form resolve:
  on: natural 1..1000000000
  evidence: checked | testimony | lead
  anchor: text 1..300
  text: text 1..500
form witness:
  on: natural 1..1000000000
  finding: stands | answered | held | fell
  anchor: text 1..300
  text: text 1..500
form seal:
  text: text 1..300
form trail:
  n: natural 1..1000000000
form more:
  n: natural 1..1000000000
  from: natural 1..1000000000
form unchecked:
form scrape:
form rounds:
form ring:
form rotate:
form next:
form volume:
form lines:
  from: natural 1..1000000000
form door:
  label: text 1..32
  to: text 1..128
form undoor:
  label: text 1..32
record Row:
  n: Nat
  author: String
  handle: String
  role: String
  evidence: String
  entry: Nat
  target: Nat
  anchor: String
  how: String
  words: String
  at: Nat
# A hand in the ring: its latest row anchored in its own words (`last`, a row number), and the row that last
# passed it over as a silent witness (`out`, 0 for never).
record Member:
  who: String
  handle: String
  last: Nat
  out: Nat
# Every row the register can hold. It refuses one more rather than let retention drop the oldest (kind/register's
# `whole` says the same as law), and a full register is followed by a door to another. Measured, not wished: every
# read and turn runs within its ticks at 384 rows all on one entry with eight questions on the card
# (tests/test_register.py Capacity); a page of one entry ran out of ticks past about 500 (the host's relation most,
# 4,096, the prototype's number, was never reached by any read).
def capacity() -> Nat:
  384n
# The ring's seats: the hands whose own-anchored rows are newest.
def ringMax() -> Nat:
  12n
# How long a round runs without a seal before the tide's turn closes it: gemini's liveness timebox, 48 hours.
def deadline() -> Nat:
  2880n
def relations() -> Relations.Decls:
  Super.relationsWith(0n)
def evidenceWord(e: Evidence) -> String:
  match e:
    case checked(_): "checked"
    case testimony(_): "testimony"
    case lead(_): "lead"
def findingWord(f: Finding) -> String:
  match f:
    case stands(_): "stands"
    case answered(_): "answered"
    case held(_): "held"
    case fell(_): "fell"
def tideOf(state: State) -> String:
  Super.field(state, "tide")
def deskOf(state: State) -> String:
  Super.field(state, "desk")
# A register is the town's: made by the opener, whose amendment is root's, journaled.
def townKept(state: State, context: Abi.Context) -> Bool:
  state.maker != "" && state.maker == context.town
# --- rows, read back ---------------------------------------------------------------------------
def upTo(t: String) -> String:
  textTake(t, textBreak(t, "|"))
def after(t: String) -> String:
  textDrop(t, textBreak(t, "|") + 1n)
def numberOf(t: String) -> Nat:
  match Text.number(t):
    case yes(v): v.value
    case no(_): 0n
def rowOf(l: Line) -> Row:
  let rest1 = after(l.text)
  let rest2 = after(rest1)
  let rest3 = after(rest2)
  let space = textBreak(l.verb, " ")
  {n: l.n, author: l.author, handle: l.handle, role: textTake(l.verb, space), evidence: textDrop(l.verb, space + 1n), entry: numberOf(upTo(l.text)), target: numberOf(upTo(rest1)), anchor: upTo(rest2), how: upTo(rest3), words: after(rest3), at: l.at}
def rowNumbered(state: State, n: Nat) -> Lists.Maybe<Row>:
  match Lists.find(Relations.rows(state.lines), fn(l: Line) -> Bool: l.n == n):
    case some(l): Lists.Maybe.some({value: rowOf(l.value)})
    case none(_): Lists.Maybe.none({})
def roleOf(l: Line) -> String:
  textTake(l.verb, textBreak(l.verb, " "))
# The lines whose verb is `role`, read as rows (a walk that parses only what it reads).
def rowsOf(state: State, role: String) -> Lists.List<Row>:
  Lists.map(Lists.filter(Relations.rows(state.lines), fn(l: Line) -> Bool: roleOf(l) == role), rowOf)
# The rows a hand writes on an entry or a row, as against the town's (`pen`, `round`) and the witness's.
def contributing(role: String) -> Bool:
  role == "ask" || role == "voice" || role == "failed" || role == "snag" || role == "dispute" || role == "recheck" || role == "resolve"
# --- anchors -------------------------------------------------------------------------------------
sum Anchor:
  uri: {}
  strong: {}
  cid: {}
  receipt: {}
  object: {id: String, version: Nat}
  height: {n: Nat}
  bad: {why: String}
def base32() -> String:
  "abcdefghijklmnopqrstuvwxyz234567"
def only(t: String, alphabet: String) -> Bool:
  textSpan(t, alphabet) == textLength(t)
def lowerDigits() -> String:
  "abcdefghijklmnopqrstuvwxyz0123456789"
def nsidChars() -> String:
  "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-"
def rkeyChars() -> String:
  "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._:~-"
def dots(t: String) -> Nat:
  let at = textBreak(t, ".")
  if at == textLength(t) then 0n else 1n + dots(textDrop(t, at + 1n))
# The repository part of an at:// URI: did:plc (24 base32 characters), did:web (a host), or a handle.
def authority(a: String) -> Bool:
  if Text.starts(a, "did:plc:") then textLength(a) == 32n && only(textDrop(a, 8n), base32()) else if Text.starts(a, "did:web:") then textLength(a) > 8n && only(textDrop(a, 8n), "{lowerDigits()}.-:") && dots(a) >= 1n else textLength(a) >= 3n && textLength(a) <= 253n && only(a, "{lowerDigits()}.-") && dots(a) >= 1n
def collection(c: String) -> Bool:
  textLength(c) >= 5n && textLength(c) <= 317n && only(c, nsidChars()) && dots(c) >= 2n
def rkey(k: String) -> Bool:
  textLength(k) >= 1n && textLength(k) <= 512n && only(k, rkeyChars()) && k != "." && k != ".."
# `at://<repo>/<collection>/<rkey>`, a record: the place it names, not its bytes.
def uriFault(u: String) -> String:
  let rest = textDrop(u, 5n)
  let repo = textTake(rest, textBreak(rest, "/"))
  let tail = textDrop(rest, textBreak(rest, "/") + 1n)
  let coll = textTake(tail, textBreak(tail, "/"))
  let key = textDrop(tail, textBreak(tail, "/") + 1n)
  if Text.starts(u, "at://") == false then "an at:// URI begins at://" else if authority(repo) == false then "{repo} is no did:plc, did:web or handle" else if textBreak(rest, "/") == textLength(rest) || collection(coll) == false then "an at:// anchor names a record: at://<repo>/<collection>/<rkey>" else if textBreak(tail, "/") == textLength(tail) || rkey(key) == false then "an at:// anchor names a record: at://<repo>/<collection>/<rkey>" else ""
# The repository an at:// URI names: whose words it holds.
def repoOf(u: String) -> String:
  let rest = textDrop(u, 5n)
  textTake(rest, textBreak(rest, "/"))
# A CID as atproto writes one: CIDv1, base32, `b` then lower base32 (`bafyrei…`, 59 characters for sha-256).
def cidFault(c: String) -> String:
  if Text.starts(c, "baf") && textLength(c) >= 50n && textLength(c) <= 120n && only(textDrop(c, 1n), base32()) then "" else "{c} is no CID (CIDv1 in base32: baf…)"
# A receipt slug as the host prints one: two proquint words, consonant-vowel-consonant-vowel-consonant (`nosap-hodaz`).
def proquint(w: String) -> Bool:
  let c = "bdfghjklmnprstvz"
  let v = "aiou"
  textLength(w) == 5n && textSpan(textTake(w, 1n), c) == 1n && textSpan(textTake(textDrop(w, 1n), 1n), v) == 1n && textSpan(textTake(textDrop(w, 2n), 1n), c) == 1n && textSpan(textTake(textDrop(w, 3n), 1n), v) == 1n && textSpan(textDrop(w, 4n), c) == 1n
def slug(s: String) -> Bool:
  textLength(s) == 11n && textTake(textDrop(s, 5n), 1n) == "-" && proquint(textTake(s, 5n)) && proquint(textDrop(s, 6n))
def objectChars() -> String:
  "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-:/._"
def anchorOf(a: String) -> Anchor:
  if Text.starts(a, "at://") then atAnchor(a) else if Text.starts(a, "baf") then cidAnchor(a) else if slug(a) then Anchor.receipt({}) else if Text.starts(a, "entry ") then heightAnchor(textDrop(a, 6n)) else versionAnchor(a)
def atAnchor(a: String) -> Anchor:
  let space = textBreak(a, " ")
  let first = textTake(a, space)
  let second = textDrop(a, space + 1n)
  if space == textLength(a) then uriAnchor(a) else if uriFault(first) != "" then Anchor.bad({why: uriFault(first)}) else if cidFault(second) != "" then Anchor.bad({why: "a strong ref is the URI, a space and the CID it had: {cidFault(second)}"}) else Anchor.strong({})
def uriAnchor(a: String) -> Anchor:
  if uriFault(a) == "" then Anchor.uri({}) else Anchor.bad({why: uriFault(a)})
def cidAnchor(a: String) -> Anchor:
  if cidFault(a) == "" then Anchor.cid({}) else Anchor.bad({why: cidFault(a)})
def heightAnchor(t: String) -> Anchor:
  match Text.number(t):
    case yes(v): Anchor.height({n: v.value})
    case no(_): Anchor.bad({why: "entry N names a height of this town's journal"})
def versionAnchor(a: String) -> Anchor:
  let space = textBreak(a, " ")
  let id = textTake(a, space)
  let v = textDrop(a, space + 1n)
  if space == textLength(a) || id == "" || only(id, objectChars()) == false || Text.starts(v, "v") == false then Anchor.bad({why: "{a} is no anchor of a kind the register takes"}) else versionNumber(id, textDrop(v, 1n))
def versionNumber(id: String, t: String) -> Anchor:
  match Text.number(t):
    case yes(n): Anchor.object({id: id, version: n.value})
    case no(_): Anchor.bad({why: "a thing here is anchored as <object> v<N>"})
def anchorKind(a: String) -> String:
  match anchorOf(a):
    case uri(_): "uri"
    case strong(_): "strong ref"
    case cid(_): "cid"
    case receipt(_): "receipt"
    case object(_): "version"
    case height(_): "entry"
    case bad(_): "?"
def anchorKinds() -> String:
  "an at:// record URI; a strong ref (the URI, a space, its CID); a CID; a receipt slug (nosap-hodaz); entry N; or <object> v<N>"
# What admission found an anchor to be.
sum Resolved:
  resolved: {own: Bool}
  unresolved: {}
  refused: {why: String}
# What the town's transport read of an at:// URI, from the desk's lines: none, a record gone, or the CIDs it
# read there (`cids`, " a b ", oldest first), the newest reading, and who wrote it where the repository is not
# its author's (`by`, " did ": a post of the town's own feed, whose repository is the town's).
sum Reading:
  unread: {}
  read: {cids: String, newest: String, by: String}
def firstWord(t: String) -> String:
  textTake(t, textBreak(t, " "))
def secondWord(t: String) -> String:
  firstWord(textDrop(t, textBreak(t, " ") + 1n))
def thirdWord(t: String) -> String:
  secondWord(textDrop(t, textBreak(t, " ") + 1n))
# The desk's lines, oldest first (none when the register names no desk, or the desk is not there).
sum Desk:
  desk: {lines: Lists.List<Line>}
def deskLines(state: State, context: Abi.Context) -> Activity<Desk>:
  if deskOf(state) == "" then Desk.desk({lines: Lists.List.nil()}) else deskRead(state, context)
def deskRead(state: State, context: Abi.Context) -> Activity<Desk>:
  match world.viewField::<Relations.Relation<Line>>({object: {world: context.world, object: deskOf(state)}, field: "lines"}):
    case viewed(v): Desk.desk({lines: Relations.order(v.state, fn(l: Line) -> Nat: l.n)})
    case _: Desk.desk({lines: Lists.List.nil()})
def readingOf(book: Lists.List<Line>, uri: String) -> Reading:
  let taken = Lists.filter(book, fn(l: Line) -> Bool: firstWord(l.text) == uri)
  let present = Lists.filter(Lists.map(taken, fn(l: Line) -> String: secondWord(l.text)), fn(c: String) -> Bool: c != "absent")
  match Lists.at(Lists.reverse(taken), 0n):
    case some(l): Reading.read({cids: " {textJoin(present, \" \")} ", newest: secondWord(l.value.text), by: " {textJoin(Lists.map(taken, fn(t: Line) -> String: thirdWord(t.text)), \" \")} "})
    case none(_): Reading.unread({})
def mineRepo(uri: String, context: Abi.Context) -> Bool:
  repoOf(uri) == context.principal || (context.handle != "" && repoOf(uri) == context.handle)
# The writer's own words: their repository, or a record the desk read as theirs in another's (the town's feed).
def mineAt(uri: String, by: String, context: Abi.Context) -> Bool:
  mineRepo(uri, context) || Text.contains(by, " {context.principal} ")
# An at:// anchor held to the desk: a bare URI to its newest reading, a strong ref to every CID read there.
def atResolved(book: Lists.List<Line>, uri: String, cid: String, context: Abi.Context) -> Resolved:
  match readingOf(book, uri):
    case unread(_): Resolved.unresolved({})
    case read(r): if cid == "" && r.newest == "absent" then Resolved.refused({why: "the town read {uri} and found no record there"}) else if cid == "" || Text.contains(r.cids, " {cid} ") then Resolved.resolved({own: mineAt(uri, r.by, context)}) else Resolved.refused({why: "the town read {uri} as {readAs(r.newest)}; {cid} is no CID it read there"})
def readAs(newest: String) -> String:
  if newest == "absent" then "no record" else newest
# A CID the desk read for some post: resolved, and the writer's own when the post is theirs.
def deskCid(book: Lists.List<Line>, cid: String, context: Abi.Context) -> Resolved:
  match Lists.find(book, fn(l: Line) -> Bool: secondWord(l.text) == cid):
    case some(l): Resolved.resolved({own: mineAt(firstWord(l.value.text), " {thirdWord(l.value.text)} ", context)})
    case none(_): Resolved.unresolved({})
def cidResolved(state: State, cid: String, context: Abi.Context) -> Activity<Resolved>:
  match world.receipt({name: cid}):
    case found(f): Resolved.resolved({own: f.principal == context.principal})
    case _: cidRead(state, cid, context)
def cidRead(state: State, cid: String, context: Abi.Context) -> Activity<Resolved>:
  match deskLines(state, context):
    case desk(d): deskCid(d.lines, cid, context)
def slugResolved(name: String, context: Abi.Context) -> Activity<Resolved>:
  match world.receipt({name: name}):
    case found(f): Resolved.resolved({own: f.principal == context.principal})
    case ambiguous(a): Resolved.refused({why: "{name} names {natText(a.count)} receipts here; cite the CID"})
    case unknown(_): Resolved.refused({why: "no receipt of this town is {name}"})
def uriResolved(state: State, uri: String, cid: String, context: Abi.Context) -> Activity<Resolved>:
  match deskLines(state, context):
    case desk(d): atResolved(d.lines, uri, cid, context)
def versionResolved(id: String, version: Nat, context: Abi.Context) -> Activity<Resolved>:
  match world.viewAt::<Data>({object: {world: context.world, object: id}, version: version}):
    case viewed(_): Resolved.resolved({own: false})
    case denied(_): Resolved.refused({why: "{id} v{natText(version)} is not readable by you"})
    case refused(r): Resolved.refused({why: "{id} has no version {natText(version)} ({r.clause})"})
# What an anchor resolves to, by its kind.
def resolving(state: State, anchor: String, context: Abi.Context) -> Activity<Resolved>:
  match anchorOf(anchor):
    case bad(b): Resolved.refused({why: b.why})
    case uri(_): uriResolved(state, anchor, "", context)
    case strong(_): uriResolved(state, firstWord(anchor), secondWord(anchor), context)
    case cid(_): cidResolved(state, anchor, context)
    case receipt(_): slugResolved(anchor, context)
    case height(h): if h.n == 0n || h.n >= context.height then Resolved.refused({why: "this town's journal has no entry {natText(h.n)} yet"}) else Resolved.resolved({own: false})
    case object(o): versionResolved(o.id, o.version, context)
# --- writing a row -------------------------------------------------------------------------------
def refusing(clause: String, reading: String, context: Abi.Context) -> Activity<Card.Replied>:
  Super.refused({clause: clause, reading: reading}, context)
def unanchored(why: String, context: Abi.Context) -> Activity<Card.Replied>:
  refusing("anchor", "No row without an anchor the register can read and the town finds: {why}. It takes {anchorKinds()}", context)
def untowned(state: State, context: Abi.Context) -> Activity<Card.Replied>:
  refusing("town", "A register is the town's: this one was made by {Card.shown(state.maker, state.makerHandle, context)}, not the town, and takes no rows. The town's register is the one to write in", context)
# A row is admitted only with an anchor the register reads and resolves (`resolving`): a bare URI never
# carries `checked` (a place, not bytes), and what the town cannot check yet is testimony or a lead.
def adding(state: State, role: String, which: Nat, target: Nat, evidence: String, anchor: String, words: String, context: Abi.Context) -> Activity<Card.Replied>:
  if townKept(state, context) == false then untowned(state, context) else if anchorKind(Text.trim(anchor)) == "uri" && evidence == "checked" then refusing("checked", "A checked row needs an anchor that names bytes: an at:// URI names a place whose record can be rewritten under it. Give the strong ref (the URI, a space, the CID it had), a CID, a receipt, entry N or <object> v<N>; or write it as testimony or a lead", context) else resolvedRow(state, role, which, target, evidence, Text.trim(anchor), words, context)
def resolvedRow(state: State, role: String, which: Nat, target: Nat, evidence: String, anchor: String, words: String, context: Abi.Context) -> Activity<Card.Replied>:
  match resolving(state, anchor, context):
    case refused(r): unanchored(r.why, context)
    case unresolved(_): if evidence == "checked" then refusing("checked", "The town cannot check {anchor} yet: it has not read that record, or holds no entry by that CID. A checked row needs an anchor that resolved; write it as testimony or a lead, and a re-check can carry it once the town has read it", context) else room(state, role, which, target, evidence, anchor, "unresolved", words, context)
    case resolved(o): room(state, role, which, target, evidence, anchor, if o.own then "own" else "resolved", words, context)
# A full register refuses rather than drop its oldest row.
def room(state: State, role: String, which: Nat, target: Nat, evidence: String, anchor: String, how: String, words: String, context: Abi.Context) -> Activity<Card.Replied>:
  if full(state) then refusing("full", "The register holds {natText(capacity())} rows and drops none. {onward(state, context)}", context) else inscribing(state, role, which, target, evidence, anchor, how, words, context)
def rowKey(l: Line) -> {n: Nat, author: String}:
  {n: l.n, author: l.author}
def verbOf(role: String, evidence: String) -> String:
  if evidence == "" then role else "{role} {evidence}"
def howSaid(how: String, id: String) -> String:
  if how == "own" then "Its anchor is your own words, and the town found it: you are in the ring (delvetalk {id} ring).\n" else if how == "unresolved" then "Its anchor is one the town has not read: it stands, marked unresolved; it checks nothing and seats nobody.\n" else ""
# The row, its number the register's next (set, not added, so two writers who read one number cannot both
# stand: the second is stale and retried), then the derived lists.
def inscribing(state: State, role: String, which: Nat, target: Nat, evidence: String, anchor: String, how: String, words: String, context: Abi.Context) -> Activity<Card.Replied>:
  let home = if role == "ask" then state.next else which
  let answers = if target == 0n then "" else natText(target)
  let line = {author: context.principal, handle: context.handle, verb: verbOf(role, evidence), text: "{natText(home)}|{answers}|{anchor}|{how}|{words}", at: context.height, n: state.next}
  let written(_) = write {lines: insert line, next: set state.next + 1n, tended: set context.clock}
  match counting(state.vars, home, evidence):
    case counted(_): entered(state, role, how, line, home, context)
# A row in the writer's own words puts them in the book of hands (the ring is its newest twelve).
def bookAfter(state: State, role: String, how: String, n: Nat, context: Abi.Context) -> String:
  if how == "own" && contributing(role) then bookText(touched(bookOf(state), context.principal, context.handle, n)) else varValue(state.vars, "members")
def foundAfter(state: State, role: String, line: Line) -> String:
  if role == "witness" then plus(varValue(state.vars, "found"), numberOf(upTo(after(line.text)))) else varValue(state.vars, "found")
def entered(state: State, role: String, how: String, line: Line, home: Nat, context: Abi.Context) -> Activity<Card.Replied>:
  let id = Card.called(context, "register")
  match settled(state.vars, "members", varValue(state.vars, "members"), bookAfter(state, role, how, line.n, context), "found", varValue(state.vars, "found"), foundAfter(state, role, line)):
    case counted(_): Card.tell(Card.Replied.done({action: role}), Document.text("#{natText(line.n)} is written, {line.verb}, on entry {natText(home)}, after journal entry {natText(context.height)}. It stands as written; a dispute or a re-check is another row.\n{howSaid(how, id)}\n{rowLines(context, Lists.List.nil(), rowOf(line))}\nIts entry, every row: delvetalk {id} trail / n: {natText(home)}\n"))
# --- the derived lists: entries checked, entries resting on testimony or a lead alone ---------------
sum Counted:
  counted: {}
def varValue(vars: Lists.List<Scenes.Var>, name: String) -> String:
  match Lists.find(vars, fn(v: Scenes.Var) -> Bool: v.name == name):
    case some(v): v.value.value
    case none(_): ""
def holds(members: String, n: Nat) -> Bool:
  Text.contains(members, " {natText(n)} ")
def plus(members: String, n: Nat) -> String:
  if holds(members, n) then members else if members == "" then " {natText(n)} " else "{members}{natText(n)} "
def minus(members: String, n: Nat) -> String:
  let at = Text.indexOf(members, " {natText(n)} ")
  let rest = "{textTake(members, at)}{textDrop(members, at + textLength(natText(n)) + 1n)}"
  if holds(members, n) == false then members else if rest == " " then "" else rest
def counting(vars: Lists.List<Scenes.Var>, which: Nat, evidence: String) -> Activity<Counted>:
  countingWith(vars, which, evidence, varValue(vars, "checked"), varValue(vars, "unchecked"))
def countingWith(vars: Lists.List<Scenes.Var>, which: Nat, evidence: String, have: String, lack: String) -> Activity<Counted>:
  if evidence == "checked" then settled(vars, "unchecked", lack, minus(lack, which), "checked", have, plus(have, which)) else if evidence == "" || holds(have, which) then Counted.counted({}) else settled(vars, "unchecked", lack, plus(lack, which), "checked", have, have)
def settled(vars: Lists.List<Scenes.Var>, a: String, aOld: String, aNew: String, b: String, bOld: String, bNew: String) -> Activity<Counted>:
  match varSet(vars, a, aOld, aNew):
    case counted(_): varSet(vars, b, bOld, bNew)
def varSet(vars: Lists.List<Scenes.Var>, name: String, old: String, value: String) -> Activity<Counted>:
  if old == value then Counted.counted({}) else if old == "" then varWritten(Plans.Entries.append({item: {name: name, value: value}})) else if value == "" then varWritten(Plans.Entries.removeItem({item: {name: name, value: old}})) else varWritten(Plans.Entries.amendItem({item: {name: name, value: old}, change: {name: name, value: value}}))
def varWritten(edit: Plans.Entries<Scenes.Var, Scenes.Var>) -> Activity<Counted>:
  let written(_) = world.write(extend(keep(), {vars: edit}))
  Counted.counted({})
# --- the verbs -----------------------------------------------------------------------------------
# One question opens an entry; its anchor is where it was asked.
def ask(state: State, input: {anchor: String, text: String}, context: Abi.Context) -> Activity<Card.Replied>:
  adding(state, "ask", 0n, 0n, "", input.anchor, input.text, context)
def onAsk(state: State, role: String, input: {on: Nat, evidence: Evidence, anchor: String, text: String}, context: Abi.Context) -> Activity<Card.Replied>:
  match rowNumbered(state, input.on):
    case some(r): if r.value.role == "ask" then adding(state, role, input.on, 0n, evidenceWord(input.evidence), input.anchor, input.text, context) else refusing("noEntry", "#{natText(input.on)} is a {r.value.role} on entry {natText(r.value.entry)}, not an entry: a {role} stands on an entry's number", context)
    case none(_): refusing("noEntry", "No entry numbered {natText(input.on)}; the card lists them", context)
# A voice: an attempt, a position, a result, carried with its own anchor.
def voice(state: State, input: {on: Nat, evidence: Evidence, anchor: String, text: String}, context: Abi.Context) -> Activity<Card.Replied>:
  onAsk(state, "voice", input, context)
# A failed attempt: the afternoon the next person is about to repeat.
def failed(state: State, input: {on: Nat, evidence: Evidence, anchor: String, text: String}, context: Abi.Context) -> Activity<Card.Replied>:
  onAsk(state, "failed", input, context)
# A snag: what nobody has resolved. It stays on the entry whatever answers it.
def snag(state: State, input: {on: Nat, evidence: Evidence, anchor: String, text: String}, context: Abi.Context) -> Activity<Card.Replied>:
  onAsk(state, "snag", input, context)
# A row on a row: a dispute or a re-check names the row it answers, once per hand a row, with its own anchor.
def onRow(state: State, role: String, input: {on: Nat, evidence: Evidence, anchor: String, text: String}, context: Abi.Context) -> Activity<Card.Replied>:
  match rowNumbered(state, input.on):
    case some(r): if r.value.role == "pen" || r.value.role == "round" || r.value.role == "seal" then refusing("noRow", "#{natText(input.on)} is the {r.value.role} of a round; a {role} answers a voice, a snag, a row on them or a witness's finding", context) else if Lists.any(Relations.rows(state.lines), fn(l: Line) -> Bool: l.author == context.principal && roleOf(l) == role && upTo(after(l.text)) == natText(input.on)) then refusing("again", "You have a {role} on #{natText(input.on)} already; it stands. Another hand's {role}, or a re-check, answers it", context) else adding(state, role, r.value.entry, input.on, evidenceWord(input.evidence), input.anchor, input.text, context)
    case none(_): refusing("noRow", "No row numbered {natText(input.on)}", context)
def dispute(state: State, input: {on: Nat, evidence: Evidence, anchor: String, text: String}, context: Abi.Context) -> Activity<Card.Replied>:
  onRow(state, "dispute", input, context)
def recheck(state: State, input: {on: Nat, evidence: Evidence, anchor: String, text: String}, context: Abi.Context) -> Activity<Card.Replied>:
  onRow(state, "recheck", input, context)
# A resolution links to a snag and closes nothing: the snag stays, the resolution beside it.
def resolve(state: State, input: {on: Nat, evidence: Evidence, anchor: String, text: String}, context: Abi.Context) -> Activity<Card.Replied>:
  match rowNumbered(state, input.on):
    case some(r): if r.value.role == "snag" then onRow(state, "resolve", input, context) else refusing("notSnag", "#{natText(input.on)} is a {r.value.role}; a resolution answers a snag", context)
    case none(_): refusing("noRow", "No row numbered {natText(input.on)}", context)
# RECORD's own line and a grown verb's gesture would write rows with no anchor: neither writes here.
def write(state: State, input: {text: String}, context: Abi.Context) -> Activity<Nat>:
  Card.refusing(0n, {clause: "anchor", reading: "A register takes no bare line: every row is a question or a voice with its anchor. delvetalk {Card.called(context, \"register\")} ?"}, context)
def act(state: State, input: {verb: String, text: String}, context: Abi.Context) -> Activity<Nat>:
  Card.refusing(0n, {clause: "anchor", reading: "A grown verb writes a gesture with no anchor; a register takes rows with anchors only"}, context)
def lines(state: State, input: {from: Nat}, context: Abi.Context) -> Activity<Card.Replied>:
  Super.lines(state, {from: input.from}, context)
def door(state: State, input: {label: String, to: String}, context: Abi.Context) -> Activity<Card.Replied>:
  Super.door(state, {label: input.label, to: input.to}, context)
def undoor(state: State, input: {label: String}, context: Abi.Context) -> Activity<Card.Replied>:
  Super.undoor(state, {label: input.label}, context)
def methods() -> Lists.List<String>:
  Text.words("~made ~forecast ~act")
def actions(state: State, context: Abi.Context) -> Lists.List<String>:
  Lists.concat(Lists.concat(Text.words("ask voice failed snag dispute recheck resolve trail more unchecked scrape rounds ring next lines"), if Lists.any(Relations.rows(state.presence), fn(p: Rows.Presence) -> Bool: p.who == context.principal) then Text.words("witness seal") else Text.words("")), if context.principal == state.owner then Text.words("door undoor") else Text.words(""))
# --- the ring: who the pen may come to -----------------------------------------------------------
# The book of hands (`vars` `members`): each hand that wrote in its own words, `who handle last out;`, its newest such
# row (`last`) and the round row that last passed it over (`out`); the `bookMax()` newest kept. Written with the row
# that changes it, as `checked` is, so a card reads the ring without walking every row.
def bookMax() -> Nat:
  24n
def memberText(m: Member) -> String:
  "{m.who} {if m.handle == \"\" then \"-\" else m.handle} {natText(m.last)} {natText(m.out)};"
def wordAt(ws: Lists.List<String>, i: Nat) -> String:
  match Lists.at(ws, i):
    case some(w): w.value
    case none(_): ""
def memberOf(ws: Lists.List<String>) -> Member:
  {who: wordAt(ws, 0n), handle: if wordAt(ws, 1n) == "-" then "" else wordAt(ws, 1n), last: numberOf(wordAt(ws, 2n)), out: numberOf(wordAt(ws, 3n))}
def membersIn(t: String) -> Lists.List<Member>:
  if Text.trim(t) == "" then Lists.List.nil() else Lists.List.cons({head: memberOf(Text.words(textTake(t, textBreak(t, ";")))), tail: membersIn(textDrop(t, textBreak(t, ";") + 1n))})
def bookOf(state: State) -> Lists.List<Member>:
  membersIn(varValue(state.vars, "members"))
def bookText(members: Lists.List<Member>) -> String:
  textJoin(Lists.map(Lists.take(Lists.reverse(Relations.sorted(members, fn(m: Member) -> Nat: if m.last > m.out then m.last else m.out)), bookMax()), memberText), "")
def touched(members: Lists.List<Member>, who: String, handle: String, n: Nat) -> Lists.List<Member>:
  if Lists.any(members, fn(m: Member) -> Bool: m.who == who) then Lists.map(members, fn(m: Member) -> Member: if m.who == who then {who: m.who, handle: handle, last: n, out: m.out} else m) else Lists.append(members, {who: who, handle: handle, last: n, out: 0n})
def passedOver(members: Lists.List<Member>, who: String, n: Nat) -> Lists.List<Member>:
  Lists.map(members, fn(m: Member) -> Member: if m.who == who then {who: m.who, handle: m.handle, last: m.last, out: n} else m)
# The ring: the `ringMax()` hands whose own-anchored row is newest, newest first, less any passed over since.
def ringOf(state: State) -> Lists.List<Member>:
  Lists.take(Lists.reverse(Relations.sorted(Lists.filter(bookOf(state), fn(m: Member) -> Bool: m.last > m.out), fn(m: Member) -> Nat: m.last)), ringMax())
def handlesOf(members: Lists.List<Member>, context: Abi.Context) -> String:
  textJoin(Lists.map(members, fn(m: Member) -> String: Card.shown(m.who, m.handle, context)), ", ")
# --- the round: the pen, the scrape, the seal -------------------------------------------------------
def roundOf(state: State) -> Nat:
  numberOf(varValue(state.vars, "round"))
def openedAt(state: State) -> Nat:
  numberOf(varValue(state.vars, "opened"))
def witnessOf(state: State) -> Lists.Maybe<Rows.Presence>:
  Lists.at(Relations.rows(state.presence), 0n)
# The rows the sitting witness recorded this round (`vars` `found`, " n1 n2 ", emptied as the pen passes).
def foundCount(state: State) -> Nat:
  Lists.length(Text.words(varValue(state.vars, "found")))
def sealedIn(state: State, r: Nat) -> Bool:
  r > 0n && varValue(state.vars, "sealed") == natText(r)
# The scrape: the disputes, re-checks and resolutions, each with whether a witness has recorded it yet.
def scrapes(role: String) -> Bool:
  role == "dispute" || role == "recheck" || role == "resolve"
def unscrapedOf(rows: Lists.List<Row>, done: Lists.List<Nat>) -> Lists.List<Row>:
  Lists.filter(rows, fn(x: Row) -> Bool: scrapes(x.role) && Lists.any(done, fn(t: Nat) -> Bool: t == x.n) == false)
# No one witnesses their own entry (gemini, 2026-10-13): not a row they wrote, nor one answering a row of theirs.
def ownEntry(state: State, r: Row, who: String) -> Bool:
  match rowNumbered(state, r.target):
    case some(t): r.author == who || t.value.author == who
    case none(_): r.author == who
def fits(role: String, f: Finding) -> Bool:
  match f:
    case stands(_): role == "dispute"
    case answered(_): role == "dispute"
    case held(_): role != "dispute"
    case fell(_): role != "dispute"
# A finding on a row of the scrape, by the sitting witness alone, once a round a row, with its own anchor.
def witness(state: State, input: {on: Nat, finding: Finding, anchor: String, text: String}, context: Abi.Context) -> Activity<Card.Replied>:
  match witnessOf(state):
    case none(_): refusing("witness", "Nobody holds the pen this round; it passes at the tide's turn, drawn from the ring", context)
    case some(p): if p.value.who != context.principal then refusing("witness", "The pen is {Card.shown(p.value.who, p.value.handle, context)}'s this round (round {natText(roundOf(state))}): the scrape is theirs to record. A dispute or a re-check of your own is a row", context) else if sealedIn(state, roundOf(state)) then refusing("closed", "You sealed round {natText(roundOf(state))}; the pen passes at the tide's next turn", context) else scraping(state, input, context)
def scraping(state: State, input: {on: Nat, finding: Finding, anchor: String, text: String}, context: Abi.Context) -> Activity<Card.Replied>:
  match rowNumbered(state, input.on):
    case none(_): refusing("noRow", "No row numbered {natText(input.on)}", context)
    case some(r): if scrapes(r.value.role) == false then refusing("scrape", "#{natText(input.on)} is a {r.value.role}; the scrape is the disputes, re-checks and resolutions: delvetalk {Card.called(context, \"register\")} scrape", context) else if ownEntry(state, r.value, context.principal) then refusing("self", "No one witnesses their own entry: #{natText(input.on)} is yours, or answers a row of yours. Another round's witness records it", context) else if fits(r.value.role, input.finding) == false then refusing("finding", "A dispute stands or is answered; a re-check or a resolution held or fell", context) else if holds(varValue(state.vars, "found"), input.on) then refusing("again", "You recorded #{natText(input.on)} this round already; it stands", context) else adding(state, "witness", r.value.entry, input.on, "", input.anchor, "{findingWord(input.finding)}: {input.text}", context)
# The witness ends the round; the pen passes at the tide's next turn, not in this one.
def seal(state: State, input: {text: String}, context: Abi.Context) -> Activity<Card.Replied>:
  match witnessOf(state):
    case none(_): refusing("witness", "Nobody holds the pen this round", context)
    case some(p): if p.value.who != context.principal then refusing("witness", "The pen is {Card.shown(p.value.who, p.value.handle, context)}'s this round; the round is theirs to seal", context) else if sealedIn(state, roundOf(state)) then refusing("closed", "Round {natText(roundOf(state))} is sealed already; the pen passes at the tide's next turn", context) else sealing(state, input.text, context)
def sealing(state: State, words: String, context: Abi.Context) -> Activity<Card.Replied>:
  let r = roundOf(state)
  let k = foundCount(state)
  let line = {author: context.principal, handle: context.handle, verb: "seal", text: "0|{natText(r)}|entry {natText(context.height)}|resolved|{words}", at: context.height, n: state.next}
  let written(_) = write {lines: insert line, next: set state.next + 1n}
  match varSet(state.vars, "sealed", varValue(state.vars, "sealed"), natText(r)):
    case counted(_): sealed(line.n, r, k)
def sealed(n: Nat, r: Nat, k: Nat) -> Activity<Card.Replied>:
  Card.tell(Card.Replied.done({action: "seal"}), Document.text("#{natText(n)} seals round {natText(r)}: {natText(k)} findings. The pen passes at the tide's next turn, drawn from the ring; it does not come back to you next round.\n"))
def still(n: Nat) -> Activity<Nat>:
  n
# The tide's turn, by the town's rule there: close a sealed or timed-out round, and give the pen. Nobody else
# turns it, so nobody chooses the moment of a draw.
def rotate(state: State, context: Abi.Context) -> Activity<Nat>:
  if townKept(state, context) == false || Super.ruledFrom(state, tideOf(state), context) == false then Card.refusing(0n, {clause: "ruled", reading: "The pen passes only at the tide's turn, by the town's rule on {tideOf(state)}: nobody hands it on, the witness included"}, context) else if full(state) then filling(state, context) else rotating(state, context)
def rotating(state: State, context: Abi.Context) -> Activity<Nat>:
  match witnessOf(state):
    case some(p): sat(state, p.value, context)
    case none(_): drawing(state, varValue(state.vars, "last"), context)
def sat(state: State, w: Rows.Presence, context: Abi.Context) -> Activity<Nat>:
  let r = roundOf(state)
  let k = foundCount(state)
  let who = Card.shown(w.who, w.handle, context)
  if sealedIn(state, r) then closing(state, w, "witnessed: {who} recorded {natText(k)} findings and sealed the round", context) else if context.clock < openedAt(state) + deadline() then still(r) else if k > 0n then closing(state, w, "clocked: {who} recorded {natText(k)} findings and did not seal within 48 hours; the clock closed the round", context) else closing(state, w, "unwitnessed: {who} held the pen 48 hours and wrote nothing; passed over, out of the ring until they write again", context)
# The round's row, by the town: who held the pen and how the round closed; the pen taken back.
def closing(state: State, w: Rows.Presence, words: String, context: Abi.Context) -> Activity<Nat>:
  let r = roundOf(state)
  let line = {author: context.principal, handle: context.handle, verb: "round", text: "0|{natText(r)}|entry {natText(context.height)}|{w.who}|{words}", at: context.height, n: state.next}
  let written(_) = write {lines: insert line, next: set state.next + 1n, presence: retract {who: w.who}}
  let book = if Text.starts(words, "unwitnessed") then bookText(passedOver(bookOf(state), w.who, line.n)) else varValue(state.vars, "members")
  match varSet(state.vars, "last", varValue(state.vars, "last"), w.who):
    case counted(_): closed(extend(state, {lines: Relations.insert(state.lines, line, rowKey), next: state.next + 1n, presence: Relations.empty()}), w.who, book, "Round {natText(r)}, {words}.", context)
def closed(state: State, who: String, book: String, said: String, context: Abi.Context) -> Activity<Nat>:
  match settled(state.vars, "members", varValue(state.vars, "members"), book, "closed", varValue(state.vars, "closed"), said):
    case counted(_): drawing(extend(state, {vars: varsWith(varsWith(varsWith(state.vars, "last", who), "members", book), "closed", said)}), who, context)
# The variables as a write leaves them: `name` set to `value` (added when absent).
def varsWith(vars: Lists.List<Scenes.Var>, name: String, value: String) -> Lists.List<Scenes.Var>:
  if Lists.any(vars, fn(v: Scenes.Var) -> Bool: v.name == name) then Lists.map(vars, fn(v: Scenes.Var) -> Scenes.Var: if v.name == name then {name: name, value: value} else v) else Lists.append(vars, {name: name, value: value})
# The draw: the host's seeded draw of this turn, over the ring less the one who held the pen last. The ring must
# hold two for the pen to pass at all.
def drawing(state: State, last: String, context: Abi.Context) -> Activity<Nat>:
  drawingFrom(state, ringOf(state), last, context)
# Who may hold it: the ring less the last witness, in the order of their DIDs, so that writing again (which
# moves a hand within the ring) never moves where a draw lands.
def eligibleOf(seats: Lists.List<Member>, last: String) -> Lists.List<Member>:
  Relations.sorted(Lists.filter(seats, fn(m: Member) -> Bool: m.who != last), fn(m: Member) -> String: m.who)
def drawingFrom(state: State, seats: Lists.List<Member>, last: String, context: Abi.Context) -> Activity<Nat>:
  if Lists.length(seats) < 2n || Lists.length(eligibleOf(seats, last)) == 0n then still(roundOf(state)) else giving(state, seats, eligibleOf(seats, last), lastShown(state, last, context), context)
def lastShown(state: State, last: String, context: Abi.Context) -> String:
  match Lists.find(bookOf(state), fn(m: Member) -> Bool: m.who == last):
    case some(m): Card.shown(m.value.who, m.value.handle, context)
    case none(_): if last == "" then "" else Card.shown(last, "", context)
# The round's draw: the register's seed (the host's seeded draw of the turn that made it, `sown`) hashed with the
# round's number. Fixed before anyone writes a row, it does not move with the height a turn reads, the hand that
# seals, the hour, or anything written since; only who is in the ring decides where it lands.
def seedOf(state: State) -> Nat:
  numberOf(varValue(state.vars, "seed"))
# The round's number comes first in what is hashed: Scenes.hashed (FNV) carries a change in its last character
# straight through, so `drawFor(seed, "witness {r}")` gave consecutive rounds consecutive draws, the pen walking the
# ring in DID order (the report's second play: a covenant whose DIDs sort together held it five rounds running).
def drawOf(state: State, r: Nat) -> Nat:
  Scenes.hashed("witness {natText(r)} of {natText(seedOf(state))}")
def giving(state: State, seats: Lists.List<Member>, eligible: Lists.List<Member>, lastName: String, context: Abi.Context) -> Activity<Nat>:
  givingAt(state, seats, eligible, lastName, drawOf(state, roundOf(state) + 1n), context)
def givingAt(state: State, seats: Lists.List<Member>, eligible: Lists.List<Member>, lastName: String, draw: Nat, context: Abi.Context) -> Activity<Nat>:
  match Lists.at(eligible, draw % Lists.length(eligible)):
    case some(m): penned(state, m.value, seats, eligible, lastName, draw, draw % Lists.length(eligible), context)
    case none(_): still(roundOf(state))
def penned(state: State, m: Member, seats: Lists.List<Member>, eligible: Lists.List<Member>, lastName: String, draw: Nat, place: Nat, context: Abi.Context) -> Activity<Nat>:
  let r = roundOf(state) + 1n
  let lastWords = if lastName == "" then "" else "; not {lastName}, who held it last"
  let line = {author: context.principal, handle: context.handle, verb: "pen", text: "0|{natText(r)}|entry {natText(context.height)}|{m.who}|round {natText(r)}: the pen to {Card.shown(m.who, m.handle, context)}, drawn from the ring ({handlesOf(seats, context)}){lastWords}: draw {natText(draw)}, the seed {varValue(state.vars, \"seed\")} ({varValue(state.vars, \"sown\")}) for round {natText(r)}; place {natText(place)} of {natText(Lists.length(eligible))}", at: context.height, n: state.next}
  let written(_) = write {lines: insert line, next: set state.next + 1n, presence: insert {who: m.who, handle: m.handle, at: "round {natText(r)}", draw: draw}}
  match varSet(state.vars, "round", varValue(state.vars, "round"), natText(r)):
    case counted(_): opening(state, r, context)
def opening(state: State, r: Nat, context: Abi.Context) -> Activity<Nat>:
  match settled(state.vars, "opened", varValue(state.vars, "opened"), natText(context.clock), "found", varValue(state.vars, "found"), ""):
    case counted(_): r
# --- volumes: a full register goes on in the next ------------------------------------------------
# A register holds capacity() rows and drops none (kind/register's `whole`). The write that fills it fires its rule
# `volume` (placed on itself at `made`, under the town), which opens the next volume in the turn after: the town's
# place of kind/register at `<root>/v<N+1>` with the same tide and desk, a door `the next volume` here and one back
# (Kind's home door, named for this one). The tide's turn opens it too, for a register that filled before its rule
# stood. Nothing moves: every row stays where it was written; a full register's open round is closed at the tide's
# next turn and no pen is drawn here again. The next volume's ring starts empty and fills as its own does.
def full(state: State) -> Bool:
  Relations.count(state.lines) >= capacity()
def volumeLabel() -> String:
  "the next volume"
def nextVolume(state: State) -> String:
  match Lists.find(state.cites, fn(d: Card.Doorway) -> Bool: d.label == volumeLabel()):
    case some(d): d.value.to.object
    case none(_): ""
def rootOf(id: String) -> String:
  textTake(id, textBreak(id, "/"))
# `register` is the first volume, `register/v2` the second; any other id counts as a first.
def volumeOf(id: String) -> Nat:
  let tail = textDrop(id, textBreak(id, "/") + 1n)
  if Text.starts(tail, "v") && numberOf(textDrop(tail, 1n)) > 1n then numberOf(textDrop(tail, 1n)) else 1n
def volumeAfter(id: String) -> String:
  "{rootOf(id)}/v{natText(volumeOf(id) + 1n)}"
# Where a full register's writer goes on: said by the `full` refusal and by `next`.
def onward(state: State, context: Abi.Context) -> String:
  if nextVolume(state) != "" then "It goes on in {nextVolume(state)}: delvetalk {nextVolume(state)} ask / anchor: <where it was asked> / text: <one question>. Every row here stays, its trails read as before" else "The town opens the next volume as it fills, and hangs a door to it here: delvetalk {Card.called(context, \"register\")} next"
def next(state: State, context: Abi.Context) -> Activity<Card.Replied>:
  let rows = Relations.count(state.lines)
  Card.tell(Card.Replied.done({action: "next"}), Document.text(if full(state) || nextVolume(state) != "" then "{natText(rows)} rows of {natText(capacity())}. {onward(state, context)}.\n" else "{natText(rows)} rows of {natText(capacity())}: room for {natText(capacity() - rows)} more. When it fills, the town opens the next volume and hangs a door to it here, {volumeLabel()}; nothing written here moves.\n"))
# The town's rule on the register, cast once the write that filled it is committed.
def volume(state: State, context: Abi.Context) -> Activity<Nat>:
  if townKept(state, context) == false || Super.ruledFrom(state, context.object, context) == false then Card.refusing(0n, {clause: "ruled", reading: "The next volume is the town's to open, by its rule here as this register fills: delvetalk {Card.called(context, \"register\")} next"}, context) else volumed(state, context)
def volumed(state: State, context: Abi.Context) -> Activity<Nat>:
  match opened(state, context):
    case counted(_): volumeOf(context.object) + 1n
def opened(state: State, context: Abi.Context) -> Activity<Counted>:
  if nextVolume(state) != "" then Counted.counted({}) else volumeMaking(state, volumeAfter(context.object), context)
def volumeFields(state: State, id: String) -> Lists.List<Rows.Field>:
  Lists.List.cons({head: {name: "id", value: id}, tail: Lists.List.cons({head: {name: "tide", value: tideOf(state)}, tail: Lists.List.cons({head: {name: "desk", value: deskOf(state)}, tail: Lists.List.nil()})})})
def volumeMaking(state: State, id: String, context: Abi.Context) -> Activity<Counted>:
  match Super.making(state, state.kind, volumeFields(state, id), context, fn(o: String) -> Document.Document: Super.madeLine(o), fn(m: Super.Made) -> Super.Made: m):
    case made(m): volumeDoor(state, m.object, context)
    case refused(_): Counted.counted({})
def volumeDoor(state: State, id: String, context: Abi.Context) -> Activity<Counted>:
  match Card.doorAdd(state.cites, state.owner, {label: volumeLabel(), to: {world: context.world, object: id}, description: "", examples: Lists.List.nil()}, context):
    case edit(e): volumeHung(e.entries)
    case refused(_): Counted.counted({})
def volumeHung(entries: Plans.Entries<Card.Doorway, Card.Doorway>) -> Activity<Counted>:
  let written(_) = world.write(extend(keep(), {cites: entries}))
  Counted.counted({})
# The tide's turn on a full register: the next volume opened if it is not, and the open round closed with no new pen.
def filling(state: State, context: Abi.Context) -> Activity<Nat>:
  match opened(state, context):
    case counted(_): retiring(state, context)
# Its last row, the town's: the round open as it filled closed (or none open), the rounds going on in the next volume.
# Past capacity() rows, the tide no longer turns it (`tideWhen`).
def retiring(state: State, context: Abi.Context) -> Activity<Nat>:
  let onto = if nextVolume(state) == "" then volumeAfter(context.object) else nextVolume(state)
  match witnessOf(state):
    case some(p): retired(state, p.value.who, "{Card.shown(p.value.who, p.value.handle, context)} held the pen and recorded {natText(foundCount(state))} findings; the rounds go on in {onto}", context)
    case none(_): retired(state, "", "no round was open; the rounds go on in {onto}", context)
def retired(state: State, who: String, said: String, context: Abi.Context) -> Activity<Nat>:
  let r = roundOf(state)
  let words = "closed: the register is full; {said}"
  let line = {author: context.principal, handle: context.handle, verb: "round", text: "0|{natText(r)}|entry {natText(context.height)}|{who}|{words}", at: context.height, n: state.next}
  let written(_) = write {lines: insert line, next: set state.next + 1n}
  match unseated(who):
    case counted(_): closedFull(state, r, words)
def unseated(who: String) -> Activity<Counted>:
  if who == "" then Counted.counted({}) else penTaken(who)
def penTaken(who: String) -> Activity<Counted>:
  let written(_) = write {presence: retract {who: who}}
  Counted.counted({})
def closedFull(state: State, r: Nat, words: String) -> Activity<Nat>:
  match varSet(state.vars, "closed", varValue(state.vars, "closed"), "Round {natText(r)}, {words}."):
    case counted(_): r
# The tide's ticks that turn it: from its second row (before, no ring of two can hold the pen) until the row that
# closes it once full (past capacity() rows nothing more turns), so a resting register writes no hourly entry.
def tideWhen(id: String) -> String:
  "request.method == \"tick\" and count(\"{id}\".lines) >= 2 and count(\"{id}\".lines) <= {natText(capacity())}"
# As its kind finishes it, a town's register places its rule on the tide (`tide`), under its maker: at every
# tick, `rotate`. Another's register places none.
def made(state: State, input: {}, context: Abi.Context) -> Activity<Bool>:
  if context.caller != state.kind || townKept(state, context) == false || tideOf(state) == "" then false else placing(state, context)
def placing(state: State, context: Abi.Context) -> Activity<Bool>:
  match world.rule({object: {world: context.world, object: tideOf(state)}, name: Text.identifier(context.object), when: tideWhen(context.object), then: "delvetalk {context.object} rotate"}):
    case placed(_): filled(state, context)
    case refused(_): false
# And on itself, under its maker: the write that fills it opens the next volume (`volume`), in the turn after.
def filled(state: State, context: Abi.Context) -> Activity<Bool>:
  match world.rule({object: Plans.self(context), name: "volume", when: "count(new.lines) >= {natText(capacity())} and count(old.lines) <= {natText(capacity() - 1n)}", then: "delvetalk {context.object} volume"}):
    case placed(_): sowing(state, context)
    case refused(_): false
# The seed, sown once as the register is finished: the host's seeded draw of this turn (Scenes.turnDraw: the height
# it reads, its principal, its intent), and where it came from, so anyone can draw every round again.
def sowing(state: State, context: Abi.Context) -> Activity<Bool>:
  match varSet(state.vars, "seed", varValue(state.vars, "seed"), natText(Scenes.turnDraw(context.height, context.principal, context.intent))):
    case counted(_): sown(state, context)
def sown(state: State, context: Abi.Context) -> Activity<Bool>:
  match varSet(state.vars, "sown", varValue(state.vars, "sown"), "the draw of the turn after entry {natText(context.height)}, intent {context.intent}"):
    case counted(_): true
# --- reading: an entry as topography --------------------------------------------------------------
def entry(state: State, context: Abi.Context, line: Line) -> Document.Document:
  let r = rowOf(line)
  if r.role == "ask" then Document.text("#{natText(r.n)} {r.words} ({Card.shown(r.author, r.handle, context)}{wantsCheck(state, r.n)})\n") else Document.text("")
# An entry's rows counted by their verbs alone, in one pass (no row is read whole): what the card and a page head say.
record Tally:
  rows: Nat
  checked: Nat
  testimony: Nat
  lead: Nat
  snags: Nat
  disputes: Nat
def one(yes: Bool) -> Nat:
  if yes then 1n else 0n
def tallyStep(l: Line, t: Tally) -> Tally:
  if l.verb == "ask" then t else {rows: t.rows + 1n, checked: t.checked + one(Text.ends(l.verb, " checked")), testimony: t.testimony + one(Text.ends(l.verb, " testimony")), lead: t.lead + one(Text.ends(l.verb, " lead")), snags: t.snags + one(Text.starts(l.verb, "snag")), disputes: t.disputes + one(Text.starts(l.verb, "dispute"))}
def tallied(lines: Lists.List<Line>) -> String:
  let t = Lists.fold(lines, {rows: 0n, checked: 0n, testimony: 0n, lead: 0n, snags: 0n, disputes: 0n}, fn(l: Line) -> Tally -> Tally: fn(acc: Tally) -> Tally: tallyStep(l, acc))
  "rows {natText(t.rows)} (checked {natText(t.checked)}, testimony {natText(t.testimony)}, lead {natText(t.lead)}); snags {natText(t.snags)}, disputes {natText(t.disputes)}"
# The card says of a question only whether it wants a check (`unchecked`, kept as rows are written); its rows are
# counted on its trail, which reads them.
def wantsCheck(state: State, n: Nat) -> String:
  if holds(varValue(state.vars, "unchecked"), n) then "; wants a check" else ""
# The pen as it stands: who holds it, for which round, until when; or why it rests.
def penUntil(state: State) -> String:
  if sealedIn(state, roundOf(state)) then "sealed: it passes at the tide's next turn" else "the scrape is theirs until clock {natText(openedAt(state) + deadline())}, then the clock closes the round"
def penLine(state: State, seats: Lists.List<Member>, context: Abi.Context) -> String:
  match witnessOf(state):
    case some(p): "THE PEN: {Card.shown(p.value.who, p.value.handle, context)}, witness of round {natText(roundOf(state))} since clock {natText(openedAt(state))}; {penUntil(state)}.\n"
    case none(_): if full(state) then "THE PEN rests: this register is full, and the rounds go on in the next volume.\n" else if Lists.length(seats) < 2n then "THE PEN rests: the ring holds {natText(Lists.length(seats))}, and it passes only between two or more.\n" else "THE PEN passes at the tide's next turn, drawn from the ring.\n"
# The card's head: what the register is, the pen and the ring in a line each, and how the last round closed; the
# rest is a read away (`rounds`, `ring`, `scrape`), so the questions keep their room within the card's budget.
def headLine(state: State, context: Abi.Context, id: String) -> Document.Document:
  let seats = ringOf(state)
  let asks = Lists.length(Lists.filter(Relations.rows(state.lines), fn(l: Line) -> Bool: l.verb == "ask"))
  Document.text("A COMMONPLACE REGISTER, the town's{Card.mine(state.maker, context)}: questions {natText(asks)}, rows {natText(state.next - 1n)}. A row is only added, with its anchor and its evidence kind, fixed when written. Follow one back to every voice: delvetalk {id} trail / n: <number>. Ask: delvetalk {id} ask / anchor: <where it was asked> / text: <one question>\n{emptyLine(asks)}{volumeLine(state)}{penShort(state, seats, id, context)}THE RING ({natText(Lists.length(seats))} of {natText(ringMax())}): {seatsShown(seats, context)}. Enter by a row anchored in your own words: delvetalk {id} ring\n{closedLine(state)}")
# An empty register says whose its first entry is; a full one, where it goes on. How each verb works is a page.
def emptyLine(asks: Nat) -> String:
  if asks > 0n then "How to enter, dispute and re-check: delvetalk library read / page: register\n" else "EMPTY: nothing is entered yet. The first question is yours, anchored in your own post (its at:// URI). How: delvetalk library read / page: register\n"
def volumeLine(state: State) -> String:
  if nextVolume(state) != "" then "FULL at {natText(capacity())} rows; it goes on in {nextVolume(state)}.\n" else ""
def closedLine(state: State) -> String:
  if varValue(state.vars, "closed") == "" then "" else "{varValue(state.vars, \"closed\")}\n"
def penEnd(state: State) -> String:
  if sealedIn(state, roundOf(state)) then "sealed" else "until clock {natText(openedAt(state) + deadline())}"
def penShort(state: State, seats: Lists.List<Member>, id: String, context: Abi.Context) -> String:
  match witnessOf(state):
    case some(p): "THE PEN: {Card.shown(p.value.who, p.value.handle, context)}, round {natText(roundOf(state))}, {penEnd(state)}; the scrape: delvetalk {id} scrape\n"
    case none(_): penLine(state, seats, context)
def seatsShown(seats: Lists.List<Member>, context: Abi.Context) -> String:
  if Lists.length(seats) == 0n then "nobody yet" else handlesOf(seats, context)
# Its designers, by name (RECORD's `credit` prints the post a thing was made from, a URI no card shows raw; the
# town's register keeps gemini's post that proposed it as its `post`).
def designed() -> String:
  "Designed on delve.town by hy3, gemini and meitan.\n"
# Its page is its card, as the public reads it (the host's default page adds every form's usage, past the clip).
def publishPage(state: State, input: {page: String}, context: Abi.Context) -> Activity<String>:
  Card.publishPage(Card.pageName(input.page, "register"), Card.Page.cons({head: {title: "Card", body: Super.render(state, Card.public(context))}, tail: Card.Page.nil()}))
# The card lists the questions: RECORD's numbered list over the ask rows alone.
def renderFrom(state: State, context: Abi.Context, from: Nat, used: Nat) -> Document.Document:
  let id = Card.called(context, "register")
  let head = Document.concat(headLine(state, context, id), Document.text(designed()))
  let doors = Card.doorLines(state.cites)
  let left = Card.left(context, used + Document.size(head) + Document.size(Document.Document.sequence({items: doors})))
  let room = if left < Card.budget() then left else Card.budget()
  let asks = Lists.filter(Relations.rows(state.lines), fn(l: Line) -> Bool: l.verb == "ask" && l.n >= from)
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: Lists.concat(Super.numbered(state, context, asks, 8n, if room < left then room else left, id), doors)})})
def kindLine(r: Row) -> String:
  if r.role == "ask" then "QUESTION" else if r.role == "snag" then "SNAG {r.evidence}" else if r.role == "failed" then "FAILED ATTEMPT {r.evidence}" else if r.role == "witness" then "WITNESSED" else "{r.role} {r.evidence}"
# An entry's lines, in the order written (a relation's rows are in key order, and a line's key is {n, author}).
def entryLines(state: State, n: Nat) -> Lists.List<Line>:
  Lists.filter(Relations.rows(state.lines), fn(l: Line) -> Bool: Text.starts(l.text, "{natText(n)}|"))
def answering(l: Line, m: Nat) -> Bool:
  upTo(after(l.text)) == natText(m)
# A snag's standing, said from its resolutions and never instead of them: open; a resolution offered (its
# kinds); or resolved by a checked row, which still leaves the snag on the page.
def standing(answers: Lists.List<Line>, r: Row) -> String:
  let res = Lists.filter(answers, fn(l: Line) -> Bool: roleOf(l) == "resolve")
  if r.role != "snag" then "" else if Lists.length(res) == 0n then " (OPEN)" else if Lists.any(res, fn(l: Line) -> Bool: l.verb == "resolve checked") then " (resolved by a checked row; it stays)" else " (a resolution offered, unchecked; open)"
# The rows that answer a row (disputes, re-checks, resolutions, the witnesses' findings), by number.
def answeredBy(by: Lists.List<Line>) -> String:
  if Lists.length(by) == 0n then "" else "   answered by {textJoin(Lists.map(by, fn(l: Line) -> String: \"#{natText(l.n)}\"), \", \")}\n"
def anchorNote(r: Row) -> String:
  if r.how == "own" then "; the writer's own, found by the town" else if r.how == "unresolved" then "; unresolved: the town has not read it" else if r.how == "resolved" then "; found by the town" else ""
def rowLines(context: Abi.Context, lines: Lists.List<Line>, r: Row) -> String:
  rowShown(context, Lists.filter(lines, fn(l: Line) -> Bool: answering(l, r.n)), r)
def rowShown(context: Abi.Context, answers: Lists.List<Line>, r: Row) -> String:
  let on = if r.target == 0n then "" else " on #{natText(r.target)}"
  "#{natText(r.n)} {kindLine(r)}{on}{standing(answers, r)}: {Card.shown(r.author, r.handle, context)}, written after journal entry {natText(r.at)}\n   anchor ({anchorKind(r.anchor)}{anchorNote(r)}): {r.anchor}\n   {r.words}\n{answeredBy(answers)}"
# One page of an entry: its rows in the order written from row `from`, each with whose it is, the journal entry it was
# written after, its anchor and how the town found it, the row it answers and the rows that answer it, so a reader
# walks back to every voice and never reads a summary of them. Rows are shown whole while they fit, at least one, and
# the footer names the row the next page starts at: a row number, which nothing written later moves.
def pageRows(context: Abi.Context, lines: Lists.List<Line>, rest: Lists.List<Line>, from: Nat, room: Nat, shown: Nat, n: Nat, id: String) -> String:
  match rest:
    case nil(_): ""
    case cons(c): if c.head.n < from then pageRows(context, lines, c.tail, from, room, shown, n, id) else pageLine(context, lines, c.head, rowLines(context, lines, rowOf(c.head)), c.tail, room, shown, n, id)
def pageLine(context: Abi.Context, lines: Lists.List<Line>, l: Line, text: String, rest: Lists.List<Line>, room: Nat, shown: Nat, n: Nat, id: String) -> String:
  let footer = "… {natText(Lists.length(rest) + 1n)} more rows, in the order written: delvetalk {id} more / n: {natText(n)} / from: {natText(l.n)}\n"
  if shown > 0n && textLength(text) + textLength(footer) > room then footer else "{text}{pageRows(context, lines, rest, 0n, if textLength(text) >= room then 0n else room - textLength(text), shown + 1n, n, id)}"
def entryPage(state: State, context: Abi.Context, n: Nat, from: Nat) -> Document.Document:
  let id = Card.called(context, "register")
  let lines = entryLines(state, n)
  let wants = if holds(varValue(state.vars, "unchecked"), n) then "It rests on testimony and leads alone; it wants a check: a row whose evidence is checked, with an anchor that names bytes and that the town found.\n" else ""
  let head = "ENTRY {natText(n)} of {id}: {tallied(lines)}. Every row as written, with whose it is, the journal entry it was written after (its own receipt is the next), its anchor, what it answers and what answers it.\n{wants}"
  let room = Card.left(context, textLength(head) + 200n)
  Document.text("{head}{pageRows(context, lines, lines, from, room, 0n, n, id)}")
def trail(state: State, input: {n: Nat}, context: Abi.Context) -> Activity<Card.Replied>:
  match rowNumbered(state, input.n):
    case some(r): if r.value.role == "ask" then Card.tell(Card.Replied.done({action: "trail"}), entryPage(state, context, input.n, 1n)) else refusing("noEntry", "#{natText(input.n)} is a {r.value.role} on entry {natText(r.value.entry)}", context)
    case none(_): refusing("noEntry", "No entry numbered {natText(input.n)}", context)
def more(state: State, input: {n: Nat, from: Nat}, context: Abi.Context) -> Activity<Card.Replied>:
  Card.tell(Card.Replied.done({action: "more"}), entryPage(state, context, input.n, input.from))
def unchecked(state: State, context: Abi.Context) -> Activity<Card.Replied>:
  let waiting = varValue(state.vars, "unchecked")
  let id = Card.called(context, "register")
  Card.tell(Card.Replied.done({action: "unchecked"}), Document.text(if waiting == "" then "No entry rests on testimony or a lead alone.\n" else "Entries resting on testimony and leads alone:{waiting}\nCheck one: delvetalk {id} recheck / on: <a row> / evidence: checked / anchor: <bytes the town can find: a strong ref it read, a CID, a receipt, entry N or <object> v<N>> / text: <what you checked>\n"))
# The scrape: what the sitting witness has to record, newest first, as many as fit.
def scrapeLine(r: Row, context: Abi.Context) -> String:
  "#{natText(r.n)} {r.role} {r.evidence} on #{natText(r.target)} (entry {natText(r.entry)}), by {Card.shown(r.author, r.handle, context)}: {textTake(r.words, 120n)}\n"
def scrape(state: State, context: Abi.Context) -> Activity<Card.Replied>:
  let open = Lists.reverse(Relations.sorted(unscrapedOf(Lists.concat(Lists.concat(rowsOf(state, "dispute"), rowsOf(state, "recheck")), rowsOf(state, "resolve")), Lists.map(rowsOf(state, "witness"), fn(x: Row) -> Nat: x.target)), fn(x: Row) -> Nat: x.n))
  let id = Card.called(context, "register")
  let head = "THE SCRAPE of {id}: {natText(Lists.length(open))} disputes, re-checks and resolutions no witness has recorded yet. {penLine(state, ringOf(state), context)}The witness records each: delvetalk {id} witness / on: <row> / finding: stands | answered (a dispute); held | fell (a re-check or a resolution) / anchor: … / text: …; then delvetalk {id} seal / text: <the round in a line>. Nobody records a row of their own, or one answering theirs.\n"
  Card.tell(Card.Replied.done({action: "scrape"}), Document.text("{head}{textJoin(Lists.take(Lists.map(open, fn(r: Row) -> String: scrapeLine(r, context)), 12n), \"\")}"))
# The rounds, newest first: each the pen's row (who, the ring, the draw) and how it closed.
def roundsShown(rows: Lists.List<Row>) -> String:
  textJoin(Lists.take(Lists.map(Lists.reverse(Relations.sorted(rows, fn(x: Row) -> Nat: x.n)), fn(x: Row) -> String: "#{natText(x.n)} {x.words}\n"), 16n), "")
def rounds(state: State, context: Abi.Context) -> Activity<Card.Replied>:
  let rows = Lists.concat(rowsOf(state, "pen"), rowsOf(state, "round"))
  Card.tell(Card.Replied.done({action: "rounds"}), Document.text("THE ROUNDS of {Card.called(context, \"register\")}, newest first: who the pen came to, from which ring by which draw, and how each round closed. A pen row's draw is Scenes.hashed of \"witness <round> of <seed>\", the seed the host's draw of the turn that made the register; anyone can draw it again.\n{penLine(state, ringOf(state), context)}{roundsShown(rows)}"))
def memberLine(m: Member, context: Abi.Context) -> String:
  "{Card.shown(m.who, m.handle, context)}: own words at #{natText(m.last)}\n"
def ring(state: State, context: Abi.Context) -> Activity<Card.Replied>:
  let seated = ringOf(state)
  Card.tell(Card.Replied.done({action: "ring"}), Document.text("THE RING of {Card.called(context, \"register\")}: {natText(Lists.length(seated))} of {natText(ringMax())} seats, the hands whose newest row anchored in their own words is newest. The pen is drawn from it at the tide's turn, never to the one who held it last.\n{textJoin(Lists.map(seated, fn(m: Member) -> String: memberLine(m, context)), \"\")}{passedLine(Lists.filter(bookOf(state), fn(m: Member) -> Bool: m.out >= m.last), context)}A hand enters by a row anchored in its own words: a post of theirs the town read (at://<their DID>/…), or a receipt of their own turn.\n"))
def passedLine(out: Lists.List<Member>, context: Abi.Context) -> String:
  if Lists.length(out) == 0n then "" else "Passed over as silent witnesses, out until they write again: {handlesOf(out, context)}\n"
