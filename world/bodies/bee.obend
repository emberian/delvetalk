layer over ./Record.obend
edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Scenes.obend as Scenes
import ./Relation.obend as Relations
import ./Rows.obend as Rows
import ./Text.obend as Text
# The bee's body, over the inhabitant's (`kind/bee`; bee's posts and glm's names for it,
# docs/review/station-trawl-2026-10-12.md 19, c, d): it works the lamp over the pumps, outside, and goes in to
# the jar of honey opened for it, and out again. Inside is being among who is in its place (its `enter`);
# out at the lamp is having left it. It flies by its own rule on the tide, every fourth tick, and by its own
# rule on its place: whoever takes the choice that goes in after it (`bee.2`, "Go in after it") is followed in.
# Asked its name, it says it three ways, every spelling true.
type State = Super.State
form name:
form fly:
def haunting(state: State, context: Abi.Context) -> Lists.List<Super.Haunting>:
  Lists.append(Lists.append(Lists.List.nil(), {on: Super.tide(state), name: "{Text.identifier(context.object)}_flies", when: "request.method == \"tick\" and new.ticks % 4 == 0", then: "delvetalk {context.object} fly"}), {on: Super.place(state), name: "{Text.identifier(context.object)}_follows", when: "request.method == \"choose\" and new.chose == \"bee.2\" and not (\"{context.principal}\" in new.presence.who)", then: "delvetalk {context.object} fly"})
def verbs() -> String:
  "name"
def moves() -> String:
  "haunt fly"
# Its own: in to the jar when it is out at the lamp, out to the lamp when it is in.
def fly(state: State, context: Abi.Context) -> Activity<Nat>:
  if Super.own(context) == false then Super.moveRefused(state, context) else if Super.present(state) then flyOut(state, context) else flyIn(state, context)
def flyOut(state: State, context: Abi.Context) -> Activity<Nat>:
  match Super.goOut(state, "flew straight up, stopped, flew straight up, out to the lamp", context):
    case moved(m): m.n
    case stayed(_): 0n
def flyIn(state: State, context: Abi.Context) -> Activity<Nat>:
  match Super.comeIn(state, "flew in to the jar of honey", context):
    case moved(m): m.n
    case stayed(_): 0n
def names() -> String:
  "AEEELIFELT, ALTIFETHHH, ALUNCE"
def name(state: State, context: Abi.Context) -> Activity<Nat>:
  Super.hears(state, "name", "asked its name", "It says its name three ways: {names()}. Every spelling is true; the name is the trying itself.", context)
def doing(state: State) -> String:
  "it flies straight up, stops, flies straight up; it works the lamp over the pumps and goes in to the jar of honey, and says its name three ways"
def now(state: State, id: String) -> String:
  if Super.present(state) then "In {Super.place(state)} now, at the jar. Ask its name: delvetalk {id} name\n" else "Out at the lamp over the pumps. Ask its name: delvetalk {id} name\n"
