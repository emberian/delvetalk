edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Relation.obend as Relations
import ./Rows.obend as Rows
import ./Text.obend as Text
import ./Scenes.obend as Scenes
import ./Spween.obend as Spween
# RECORD (docs/METAPHYSICS.md §7): the commonplace's one page. What was said, by whom, in order; a
# line is written, never edited; a keeper, when there is one, admits lines by number, and a record
# with no keeper lets every line stand as written. The anthology is a record kept by its owner; a
# bell, a cistern and a room are records with a body laid over them (world/bodies).
#
# A line is keyed {author, n}: `n` is `next` when it came, which only counts up, so key order
# is the order of writing, a line keeps its number after older lines are dropped, and two
# writers who read one `next` both stand. `admitted` holds the keeper's admissions by number;
# `marks` the record's named moments, each once (a bell's `rung`). `head`, `kind`, `fields`,
# `maker`, `makerHandle` and `post` are set when it is made (KIND's `make`) and never after.
#
# Where a record stands is what it cites and what it makes. `cites` are its doors (the card's
# word): `{label, to}` rows the owner hangs, eight at most. `makes` are the kinds whose things a
# body makes under it (`making`): <record>/<kind>/<n>, each with a door home.
#
# A room is a record whose body (world/bodies/room.obend) reads the rest: `start`, `passages`,
# `cooldown` and `requires` are its scene (world/lib/Scenes.obend), set when it is made and
# changed only by its owner's reprogram; `presence` who is in it and at which passage; `vars`
# what its choices set; `left` when each reader last left; `things` what lies in it.
#
# The package declares no law: a lawful module cannot be imported, and every kind imports the
# package it makes. Its creator passes the law (`lawText` is the record's own).
type Line = Rows.Line
type Presence = Rows.Presence
type Departure = Rows.Departure
record State:
  owner: String
  keeper: String
  keeperHandle: String
  head: fixed String
  kind: fixed String
  fields: fixed Lists.List<Rows.Field>
  maker: fixed String
  makerHandle: fixed String
  post: fixed String
  lines: Relations.Relation<Line>
  admitted: Relations.Relation<Rows.Admission>
  marks: Relations.Relation<Rows.Mark>
  next: Nat
  cites: Card.Doorways
  makes: Lists.List<Plans.Reference>
  start: String
  passages: Lists.List<Scenes.Passage>
  cooldown: Nat
  requires: Scenes.Guard
  presence: Relations.Relation<Presence>
  vars: Lists.List<Scenes.Var>
  left: Relations.Relation<Departure>
  things: Relations.Relation<Plans.Reference>
def initial() -> State:
  {owner: "", keeper: "", keeperHandle: "", head: "", kind: "", fields: Lists.List.nil(), maker: "", makerHandle: "", post: "", lines: Relations.empty(), admitted: Relations.empty(), marks: Relations.empty(), next: 1n, cites: Lists.List.nil(), makes: Lists.List.nil(), start: "", passages: Lists.List.nil(), cooldown: 0n, requires: Lists.List.nil(), presence: Relations.empty(), vars: Lists.List.nil(), left: Relations.empty(), things: Relations.empty()}
# The newest 128 lines: at 280 four-byte characters each they still fit the host's state bytes.
# A body that keeps shorter lines keeps more of them (`relationsWith`).
def relations() -> Relations.Decls:
  relationsWith(128n)
def relationsWith(lines: Nat) -> Relations.Decls:
  Lists.append(Lists.append(Lists.append(Lists.append(Lists.append(Lists.append(Relations.Decls.nil(), {field: "lines", key: Text.words("author n"), limit: lines}), {field: "admitted", key: Text.words("n"), limit: 128n}), {field: "marks", key: Text.words("name"), limit: 16n}), {field: "presence", key: Text.words("who"), limit: presenceMax()}), {field: "left", key: Text.words("at who"), limit: leftMax()}), {field: "things", key: Text.words("object"), limit: 256n})
# Who may be in a room at once: one turn offers a line to at most 32 (the host's sendsPerTurn).
def presenceMax() -> Nat:
  32n
# Departures kept; one still cooling is never dropped for a newer one (the room's `crowded`).
def leftMax() -> Nat:
  64n
# The record's law, as a kind passes it: the owner stays and alone changes the keeper, the doors,
# what it makes, its scene or its code; a line is only added, an admission only added, and only
# the keeper admits; what the spells keep (lines, admissions, marks, presence, departures,
# variables, the floor) no proposal writes, the owner's included.
def lawText() -> String:
  "law owner \"the owner stays; only the owner changes the keeper, the doors, what it makes, its scene or its code; anyone else only by its spells\": unchanged(owner) and (request.subject == new.owner or (request.kind == 0 and unchanged(keeper) and unchanged(cites) and unchanged(makes) and unchanged(start) and unchanged(passages) and unchanged(cooldown) and unchanged(requires)))\nlaw kept \"a line is only added; only the keeper admits\": insertOnly(lines) and insertOnly(admitted) and insertOnly(marks) and (unchanged(admitted) or request.subject == new.keeper)\nlaw methods \"what was written, admitted and marked, who is here, who left, the variables and what lies here change only by their spells, never by a proposal\": request.kind == proposed implies (unchanged(lines) and unchanged(admitted) and unchanged(marks) and unchanged(presence) and unchanged(left) and unchanged(vars) and unchanged(things))"
def lineKey(line: Line) -> {author: String, n: Nat}:
  {author: line.author, n: line.n}
def admissionKey(a: Rows.Admission) -> {n: Nat}:
  {n: a.n}
def markKey(m: Rows.Mark) -> {name: String}:
  {name: m.name}
# A line's author is the turn's principal, never an argument. The writer is answered with the
# line's number and the record as it now stands; the result is the number.
def write(state: State, input: {text: String}, context: Abi.Context) -> Activity<Nat>:
  let line = {author: context.principal, handle: context.handle, text: input.text, at: context.height, n: state.next}
  let written(_) = write {lines: insert line, next: add 1n}
  let said = Document.text("#{natText(line.n)} is written: {line.text}\n\n")
  Card.tellTo(line.n, context.principal, Document.concat(said, renderFrom(extend(state, {lines: Relations.insert(state.lines, line, lineKey), next: state.next + 1n}), context, 0n, Document.size(said))))
# The card's lines from a number on, for reading past the first eight.
def lines(state: State, input: {from: Nat}, context: Abi.Context) -> Activity<Card.Replied>:
  Card.tell(Card.Replied.done({action: "lines"}), renderFrom(state, context, input.from, 0n))
# admit {number}: the keeper's alone (refused by name to anyone else, and by the law).
def admit(state: State, input: {number: Nat}, context: Abi.Context) -> Activity<Card.Replied>:
  if state.keeper == "" || context.principal != state.keeper then refusedCard(state, context, {clause: "notKeeper", reading: keeperReading(state, context)}) else admitting(state, input.number, context)
def admitting(state: State, number: Nat, context: Abi.Context) -> Activity<Card.Replied>:
  match lineNumbered(state, number):
    case none(_): refusedCard(state, context, {clause: "noLine", reading: "No line numbered {natText(number)}"})
    case some(l): admitted(state, l.value, context)
def admitted(state: State, line: Line, context: Abi.Context) -> Activity<Card.Replied>:
  let written(_) = write {admitted: insert {n: line.n, at: context.height}, keeperHandle: set context.handle}
  Card.tell(Card.Replied.done({action: "admit"}), Document.text("#{natText(line.n)} admitted: {line.text}\n"))
def keeperReading(state: State, context: Abi.Context) -> String:
  if state.keeper == "" then "Nobody keeps this record; every line stands as written" else "Only the keeper, {Card.shown(state.keeper, state.keeperHandle, context)}, admits"
def refusedCard(state: State, context: Abi.Context, refusal: Card.Refusal) -> Activity<Card.Replied>:
  Card.tell(Card.Replied.refused(refusal), Document.concat(Document.text("refused {refusal.clause}: {refusal.reading}\n\n"), render(state, context)))
def lineNumbered(state: State, number: Nat) -> Lists.Maybe<Line>:
  Lists.find(Relations.rows(state.lines), fn(l: Line) -> Bool: l.n == number)
def isAdmitted(state: State, n: Nat) -> Bool:
  match Relations.lookup(state.admitted, {n: n}, admissionKey):
    case some(_): true
    case none(_): false
# A named moment, once (a bell's `rung`); false when it was already marked.
def marked(state: State, name: String) -> Bool:
  match Relations.lookup(state.marks, {name: name}, markKey):
    case some(_): true
    case none(_): false
def mark(state: State, name: String, context: Abi.Context) -> Activity<Bool>:
  if marked(state, name) then false else markWritten({name: name, who: context.principal, handle: context.handle, at: context.height})
def markWritten(m: Rows.Mark) -> Activity<Bool>:
  let written(_) = write {marks: insert m}
  true
# A value the kind's form took when the record was made ("" when none).
def field(state: State, name: String) -> String:
  match Lists.find(state.fields, fn(f: Rows.Field) -> Bool: f.name == name):
    case some(f): f.value.value
    case none(_): ""
# Doors on the card are the owner's: what the record cites.
def door(state: State, input: {label: String, to: String}, context: Abi.Context) -> Activity<Card.Replied>:
  doored(Card.doorAdd(state.cites, state.owner, {label: input.label, to: {world: context.world, object: input.to}}, context), "door")
def undoor(state: State, input: {label: String}, context: Abi.Context) -> Activity<Card.Replied>:
  doored(Card.doorRemove(state.cites, state.owner, input.label, context), "undoor")
def doored(edit: Card.DoorEdit, action: String) -> Activity<Card.Replied>:
  match edit:
    case refused(r): Card.tell(Card.Replied.refused(r), Document.text("refused {r.clause}: {r.reading}\n"))
    case edit(e): doorWritten(e.entries, action)
def doorWritten(entries: Plans.Entries<Card.Doorway, Card.Doorway>, action: String) -> Activity<Card.Replied>:
  let written(_) = world.write(extend(keep(), {cites: entries}))
  Card.Replied.done({action: action})
# Making under the record (`makes`): a body's verb (a garden's plant) names one of its kinds and
# the fields the kind's form takes, as text; the kind judges them and makes <record>/<kind>/<n>
# with a door home, answering quietly, and the record answers the maker. A kind the record does
# not make is refused by name; the kind's refusal keeps its clause.
sum Made:
  made: {object: String}
  refused: Card.Refusal
def making(state: State, kind: String, fields: Lists.List<Rows.Field>, context: Abi.Context) -> Activity<Made>:
  if Lists.any(state.makes, fn(r: Plans.Reference) -> Bool: r.object == kind) then calling(kind, fields, context) else notMade({clause: "notMade", reading: makesReading(state)})
def makesReading(state: State) -> String:
  if Lists.length(state.makes) == 0n then "This record makes nothing." else "This record makes {textJoin(Lists.map(state.makes, fn(r: Plans.Reference) -> String: r.object), \", \")}."
def notMade(refusal: Card.Refusal) -> Activity<Made>:
  Card.tell(Made.refused(refusal), Document.text("Not done: {refusal.reading}\n"))
def calling(kind: String, fields: Lists.List<Rows.Field>, context: Abi.Context) -> Activity<Made>:
  match world.call::<Made>({object: {world: context.world, object: kind}, method: "makeUnder", argument: {under: context.object, fields: fields}}):
    case returned(r): madeHere(r.result, context)
    case refused(r): notMade({clause: r.clause, reading: r.reading})
    case denied(_): notMade({clause: "denied", reading: "{kind} does not answer."})
def madeHere(made: Made, context: Abi.Context) -> Activity<Made>:
  match made:
    case made(m): Card.tellTo(made, context.principal, Document.text("Made, at {m.object}.\n"))
    case refused(r): notMade(r)
form write:
  text: text 1..280
form admit:
  number: natural 1..1000000000
form lines:
  from: natural 1..1000000000
form door:
  label: text 1..32
  to: text 1..128
form undoor:
  label: text 1..32
# What the host offers a reader (HOST-HANDOFF 103): admit to the keeper, doors to the owner.
def actions(state: State, context: Abi.Context) -> Lists.List<String>:
  Lists.concat(Text.words("write lines"), Lists.concat(if state.keeper != "" && context.principal == state.keeper then Text.words("admit") else Text.words(""), if context.principal == state.owner then Text.words("door undoor") else Text.words("")))
def blurb() -> Card.Door:
  {word: "record", blurb: "Write a line; it is numbered and never edited."}
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
# At most eight lines and Card.budget() characters; when lines remain, the last row says how
# many and the spell that shows them, and its characters are kept for it.
def numbered(state: State, context: Abi.Context, lines: Lists.List<Line>, shown: Nat, room: Nat, id: String) -> Document.Documents:
  match lines:
    case nil(_): Document.Documents.nil()
    case cons(c): numberedLine(state, context, entry(state, context, c.head), c.head, c.tail, shown, room, id)
def numberedLine(state: State, context: Abi.Context, line: Document.Document, row: Line, rest: Lists.List<Line>, shown: Nat, room: Nat, id: String) -> Document.Documents:
  let more = moreLine(row.n, Lists.length(rest) + 1n, id)
  let needed = Document.size(line) + if Lists.length(rest) == 0n then 0n else Document.size(more)
  if shown == 0n || needed > room then Document.Documents.cons({head: more, tail: Document.Documents.nil()}) else Document.Documents.cons({head: line, tail: numbered(state, context, rest, shown - 1n, room - Document.size(line), id)})
def moreLine(from: Nat, left: Nat, id: String) -> Document.Document:
  Document.text("… and {natText(left)} more: delvetalk {id} lines / from: {natText(from)}\n")
def status(state: State, n: Nat) -> String:
  if state.keeper == "" then "" else if isAdmitted(state, n) then "[admitted] " else "[pending] "
def entry(state: State, context: Abi.Context, line: Line) -> Document.Document:
  Document.text("#{natText(line.n)} {status(state, line.n)}{Card.shown(line.author, line.handle, context)}{Card.mine(line.author, context)}: {line.text}\n")
# The head: the record's own first line, who keeps it, and the spell that writes in it.
def headLine(state: State, context: Abi.Context, id: String) -> Document.Document:
  let title = if state.head == "" then "A RECORD" else state.head
  let kept = if state.keeper == "" then "" else "; keeper {Card.shown(state.keeper, state.keeperHandle, context)}{Card.mine(state.keeper, context)}"
  let until = if state.keeper == "" then "" else ", [pending] until admitted"
  Document.text("{title}{kept}. Write: delvetalk {id} write / text: <1 to 280 characters>; numbered{until}.\n")
def render(state: State, context: Abi.Context) -> Document.Document:
  renderFrom(state, context, 0n, 0n)
# The card's lines numbered `from` on, then its doors: one budget across what the answer has
# already said (`used`), the head, the lines and the doors (Card.limit()).
def renderFrom(state: State, context: Abi.Context, from: Nat, used: Nat) -> Document.Document:
  let id = Card.called(context, "record")
  let head = headLine(state, context, id)
  let doors = Card.doorLines(state.cites)
  let left = Card.left(used + Document.size(head) + Document.size(Document.Document.sequence({items: doors})))
  let room = if left < Card.budget() then left else Card.budget()
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: Lists.concat(numbered(state, context, Lists.filter(Relations.rows(state.lines), fn(l: Line) -> Bool: l.n >= from), 8n, if room < left then room else left, id), doors)})})
