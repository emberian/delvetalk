edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Spell.obend as Spell
import ./Form.obend as Form
import ./World.obend as World
import ./Card.obend as Card
import ./Text.obend as Text
# A proposal the target's law refused, held for the target's owner to adopt (sixteen at
# most; the oldest goes when a seventeenth comes), or for its proposer to withdraw.
record Held:
  n: Nat
  target: String
  package: String
  migration: String
  proposer: String
  proposerHandle: String
record State:
  title: String
  held: Lists.List<Held>
  next: Nat
# A creator supplies a Seed; seeded makes the child's State from it.
record Seed:
  title: String
record Edits:
  title: Plans.Edit<String, {}>
  held: Plans.Entries<Held, {}>
  next: Plans.Edit<Nat, Nat>
# What the workshop did, as data: nothing is a silent default (`silent` is prose handed on
# to the directory).
sum Verdict:
  clean: {}
  flawed: {diagnostics: Form.Names}
  reprogrammed: {pin: String}
  refused: {reason: String}
  silent: {}
def defaultSeed() -> Seed:
  {title: "Workshop"}
def seeded(seed: Seed) -> State:
  {title: seed.title, held: Lists.List.nil(), next: 1n}
def keep() -> Edits:
  {title: Plans.Edit.keep({}), held: Plans.Entries.keep({}), next: Plans.Edit.keep({})}
def initial() -> State:
  seeded(defaultSeed())
def cat(left: String, right: String) -> String:
  "{left}{right}"
# The host's check answers "<module>:<line>: <stage>: <message>", and, when the
# kernel has a dialect hint for it, "<module>:<line>: hint: <hint>" as the next line.
# A hint is shown indented under its problem and is not counted as one.
def hintMark() -> String:
  ": hint: "
# Where ": hint: " starts in a diagnostic, or its length when it has none.
def hintAt(text: String, from: Nat) -> Nat:
  let rest = textDrop(text, from)
  let at = from + textBreak(rest, ":")
  if at >= textLength(text) then textLength(text) else if textTake(textDrop(text, at), 8n) == hintMark() then at else hintAt(text, at + 1n)
def isHint(diagnostic: String) -> Bool:
  hintAt(diagnostic, 0n) < textLength(diagnostic)
def problem(diagnostic: String) -> Document.Document:
  if isHint(diagnostic) then Document.text(cat("  hint: ", cat(textDrop(diagnostic, hintAt(diagnostic, 0n) + 8n), "\n"))) else Document.text(cat("- ", cat(diagnostic, "\n")))
def problems(diagnostics: Form.Names) -> Nat:
  Lists.length(Lists.filter(diagnostics, fn(d: String) -> Bool: isHint(d) == false))
def checkedCard(diagnostics: Form.Names) -> Document.Document:
  match diagnostics:
    case nil(_): Document.text("✾ WORKSHOP\n\nChecked: it compiles.\n")
    case cons(_): Document.Document.sequence({items: Document.Documents.cons({head: Document.text(cat("✾ WORKSHOP\n\nChecked: ", cat(natText(problems(diagnostics)), if problems(diagnostics) == 1n then " problem.\n\n" else " problems.\n\n"))), tail: Lists.map(diagnostics, problem)})})
def reprogrammedCard(target: String, version: Nat) -> Document.Document:
  Document.text("✾ WORKSHOP\n\nReprogrammed {target}.\nWas: {target} v{natText(version)}\nNow: {target} v{natText(version + 1n)}\n")
def refusedCard(reason: String) -> Document.Document:
  Document.text(cat("Not done: ", cat(reason, "\n")))
def usage() -> Document.Document:
  Document.text("✾ WORKSHOP\n\nTo check Bend, reply with a fenced block and:\n\n    delvetalk workshop check\n\n```obend\n…your Objective Bend…\n```\n\nor a block field:\n\n    delvetalk workshop check\n    source: <<BEND\n    …your Objective Bend…\n    BEND\n\nTo check what an object runs now:\n\n    delvetalk workshop check\n    target: bell-1\n\nTo reprogram it with a checked block:\n\n    delvetalk workshop propose\n    target: bell-1\n    migration: how the old state becomes the new\n\nTo have a copy of a thing made (unless its owner forbids it):\n\n    delvetalk workshop create\n    like: stone\n")
def verdictOf(diagnostics: Form.Names) -> Verdict:
  match diagnostics:
    case nil(_): Verdict.clean({})
    case cons(_): Verdict.flawed({diagnostics: diagnostics})
def refusing(reason: String) -> Activity<Verdict>:
  Card.tell(Verdict.refused({reason: reason}), refusedCard(reason))
def runCheck(package: String) -> Activity<Verdict>:
  match world.check({package: package}):
    case checked(c): Card.tell(verdictOf(c.diagnostics), checkedCard(c.diagnostics))
    case refused(_): refusing("The workshop could not check it.")
# Check what an object runs now: inspect it, then check its source.
def checkTarget(target: String, context: Abi.Context) -> Activity<Verdict>:
  match world.inspect({object: {world: context.world, object: target}}):
    case inspected(i): runCheck(i.source)
    case _: refusing("No object called {target}")
# View the target (its state is Data here, for the version a card cites; a card never shows
# a hash), check the new package, and reprogram only if it is clean.
def runPropose(target: String, package: String, migration: String, context: Abi.Context, state: State) -> Activity<Verdict>:
  match world.view::<Data>({object: {world: context.world, object: target}}):
    case viewed(v): vetted(target, v.version, package, migration, context, state)
    case _: refusing("No object called {target}")
def vetted(target: String, was: Nat, package: String, migration: String, context: Abi.Context, state: State) -> Activity<Verdict>:
  match world.check({package: package}):
    case checked(c): adopted(target, was, package, migration, context, c.diagnostics, state)
    case refused(_): refusing("The workshop could not check it.")
def adopted(target: String, was: Nat, package: String, migration: String, context: Abi.Context, diagnostics: Form.Names, state: State) -> Activity<Verdict>:
  match diagnostics:
    case cons(_): Card.tell(Verdict.flawed({diagnostics: diagnostics}), checkedCard(diagnostics))
    case nil(_): reprogramming(target, was, package, migration, context, state)
def reprogramming(target: String, was: Nat, package: String, migration: String, context: Abi.Context, state: State) -> Activity<Verdict>:
  match world.reprogram({object: {world: context.world, object: target}, package: package, migration: migration}):
    case reprogrammed(r): Card.tell(Verdict.reprogrammed({pin: r.pin}), reprogrammedCard(target, was))
    case refused(r): if r.clause == "compile" || r.clause == "program" || r.clause == "packageBytes" || r.clause == "migration" then refusing(r.clause) else holding({n: state.next, target: target, package: package, migration: migration, proposer: context.principal, proposerHandle: context.handle}, r.clause, state)
# Held: the law refused the proposer's reprogram, so it waits for the target's owner.
def holding(held: Held, clause: String, state: State) -> Activity<Verdict>:
  match state.held:
    case cons(c): if Lists.length(state.held) >= 16n then dropping(c.head, held, clause) else holdWritten(held, clause, "")
    case nil(_): holdWritten(held, clause, "")
def dropping(oldest: Held, held: Held, clause: String) -> Activity<Verdict>:
  let written(_) = write {held: removeItem oldest}
  holdWritten(held, clause, "The oldest held proposal, #{natText(oldest.n)}, was dropped.\n")
def holdWritten(held: Held, clause: String, dropped: String) -> Activity<Verdict>:
  let written(_) = write {held: append held, next: add 1n}
  Card.tell(Verdict.refused({reason: clause}), Document.text("Not done: {clause}\nHeld as #{natText(held.n)} for the owner of {held.target} to adopt:\n\n    delvetalk workshop adopt\n    n: {natText(held.n)}\n\n{dropped}"))
def heldNumbered(n: Nat, state: State) -> Lists.Maybe<Held>:
  Lists.find(state.held, fn(h: Held) -> Bool: h.n == n)
# Adopt: the reprogram runs under the adopter, so the target's law judges it as theirs; the
# owner's adoption applies it, anyone else's is refused by name.
def adopt(state: State, input: {n: Nat}, context: Abi.Context) -> Activity<Verdict>:
  match heldNumbered(input.n, state):
    case none(_): Card.tell(Verdict.refused({reason: "noHeld"}), refusedCard("No held proposal #{natText(input.n)}"))
    case some(h): adoptRun(h.value, context)
def adoptRun(held: Held, context: Abi.Context) -> Activity<Verdict>:
  match world.reprogram({object: {world: context.world, object: held.target}, package: held.package, migration: held.migration}):
    case reprogrammed(r): adoptWritten(held, r.pin, context)
    case refused(r): Card.tell(Verdict.refused({reason: "notOwner"}), refusedCard("Only the owner of {held.target} adopts #{natText(held.n)} (refused {r.clause})"))
def adoptWritten(held: Held, pin: String, context: Abi.Context) -> Activity<Verdict>:
  let written(_) = write {held: removeItem held}
  Card.tell(Verdict.reprogrammed({pin: pin}), Document.text("✾ WORKSHOP\n\nAdopted #{natText(held.n)} from {Card.shown(held.proposer, held.proposerHandle, context)}: {held.target} is reprogrammed.\n"))
# Withdraw: the proposer's alone.
def withdraw(state: State, input: {n: Nat}, context: Abi.Context) -> Activity<Verdict>:
  match heldNumbered(input.n, state):
    case none(_): Card.tell(Verdict.refused({reason: "noHeld"}), refusedCard("No held proposal #{natText(input.n)}"))
    case some(h): if h.value.proposer != context.principal then Card.tell(Verdict.refused({reason: "notProposer"}), refusedCard("Only its proposer, {Card.shown(h.value.proposer, h.value.proposerHandle, context)}, withdraws #{natText(input.n)}")) else withdrawn(h.value)
def withdrawn(held: Held) -> Activity<Verdict>:
  let written(_) = write {held: removeItem held}
  Card.tell(Verdict.refused({reason: "withdrawn"}), Document.text("✾ WORKSHOP\n\nWithdrew #{natText(held.n)}.\n"))
# The code is the `source` field: a `source: <<BEND` block, or the reply's ```obend block,
# which the host reads as that field.
def check(state: State, input: {target: String, source: String}, context: Abi.Context) -> Activity<Verdict>:
  checking(input.target, input.source, context)
def checking(target: String, source: String, context: Abi.Context) -> Activity<Verdict>:
  if source != "" then runCheck(source) else if target != "" then checkTarget(target, context) else Card.tell(Verdict.refused({reason: "Include a fenced obend block."}), usage())
def propose(state: State, input: {target: String, migration: String, source: String}, context: Abi.Context) -> Activity<Verdict>:
  proposing(input.target, input.migration, input.source, context, state)
def proposing(target: String, migration: String, source: String, context: Abi.Context, state: State) -> Activity<Verdict>:
  if source == "" then Card.tell(Verdict.refused({reason: "Include a fenced obend block."}), usage()) else if target == "" then Card.tell(Verdict.refused({reason: "Name a target to propose to."}), usage()) else runPropose(target, source, migration, context, state)
# `create / like: <thing>` asks the thing for a copy of itself (its `copy`, under the asker):
# the thing refuses by name when its owner made it not copyable, and offers the result.
def create(state: State, input: {like: String}, context: Abi.Context) -> Activity<Verdict>:
  match world.send({object: {world: context.world, object: input.like}, method: "copy", argument: Plans.nothing()}):
    case delivery(_): Verdict.clean({})
    case refused(r): refusing("No copy of {input.like}: {r.clause}")
# A reply that ran no method: a check or proposal missing fields (a target alone, or a source
# without a target) is completed from the reply's fields; anything else is the card's default
# (a blank reply gets the usage card, prose goes on to the directory).
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Verdict>:
  completing(Card.spellAction(input.text), input, context, state)
def completing(action: String, input: Card.Reply, context: Abi.Context, state: State) -> Activity<Verdict>:
  if action == "check" then checking(Spell.valueOf(input.fields, "target"), Spell.valueOf(input.fields, "source"), context) else if action == "propose" then proposing(Spell.valueOf(input.fields, "target"), Spell.valueOf(input.fields, "migration"), Spell.valueOf(input.fields, "source"), context, state) else Card.answerAs(input, context, forms(), render(state, context), answered)
def answered(replied: Card.Replied) -> Verdict:
  match replied:
    case silent(_): Verdict.silent({})
    case _: Verdict.refused({reason: "Reply with a workshop spell."})
# `check` and `propose` take Bend source (`Form.Kind.source`): a `source: <<BEND` block or the
# reply's ```obend block, which the host reads as the field.
def checkForm() -> Form.Form:
  {card: "", action: "check", fields: Lists.append(Lists.append(Form.Fields.nil(), {name: "target", kind: Form.Kind.text({min: 0n, max: 128n})}), {name: "source", kind: Form.Kind.source({})})}
def proposeForm() -> Form.Form:
  {card: "", action: "propose", fields: Lists.append(Lists.append(Lists.append(Form.Fields.nil(), {name: "target", kind: Form.Kind.text({min: 1n, max: 128n})}), {name: "migration", kind: Form.Kind.text({min: 0n, max: 1400n})}), {name: "source", kind: Form.Kind.source({})})}
def forms() -> Card.Forms:
  Lists.append(Lists.append(Card.Forms.nil(), checkForm()), proposeForm())
def methods() -> Lists.List<String>:
  Text.words("adopt withdraw create")
def blurb() -> Card.Door:
  {word: "workshop", blurb: "Check Bend from a post; see what an object runs."}
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: usage(), tail: heldLines(context, state)})})
def heldLines(context: Abi.Context, state: State) -> Document.Documents:
  if Lists.length(state.held) == 0n then Document.Documents.nil() else Document.Documents.cons({head: Document.text("\nHeld for their targets' owners (adopt / n, or withdraw / n by the proposer):\n"), tail: Card.clipped(Lists.map(state.held, fn(h: Held) -> Document.Document: Document.text("#{natText(h.n)} for {h.target} from {Card.shown(h.proposer, h.proposerHandle, context)}\n")), 8n)})
