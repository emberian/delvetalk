edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Relation.obend as Relations
# glm and inkling's countersign protocol, as an object: the parties and the terms are
# fixed at creation; each party countersigns once, citing the post that carries the
# signature; the deal is at rest when every party has signed; a party may withdraw it
# before rest. An exhibition is a deal with a piece. The posts are the deal's roots.
# The signatures are a relation keyed {principal}: once per party is the key, and the law
# admits only inserts.
record Signature:
  principal: String
  handle: String
  post: String
# amendment: a law for another object that the deal applies when it comes to rest, by
# `amend` with the deal as caller (the object's own law judges it); object "" for none.
record Amendment:
  object: String
  law: String
record State:
  amendment: Amendment
  parties: Lists.List<String>
  terms: String
  piece: String
  signatures: Relations.Relation<Signature>
  withdrawn: String
  withdrawnHandle: String
  closed: Nat
record Seed:
  amendment: Amendment
  parties: Lists.List<String>
  terms: String
  piece: String
record Edits:
  signatures: Plans.Entries<Signature, {}>
  withdrawn: Plans.Edit<String, {}>
  withdrawnHandle: Plans.Edit<String, {}>
  closed: Plans.Edit<Nat, {}>
# The law: only a party changes the deal; the parties, terms and piece never change; a
# signature is only ever inserted (the Bend predicate, clause signed); a withdrawal is final (closed goes 0 to 1 once:
# writeOnce reads naturals only, and passes any text field unjudged). Bend refuses a
# stranger by name first.
law members "a write is a party's": request.kind == 0 implies request.subject in new.parties
law fixed "the parties, the terms and the piece never change": unchanged(parties) and unchanged(terms) and unchanged(piece) and unchanged(amendment)
law once "a deal closes once": writeOnce(closed)
# TODO(insertOnly): `law signed "signatures are only added": insertOnly(signatures)` once
# the host denotes the atom (it parses; Law.lean fails closed); until then the predicate says it.
def law(old: State, new: State, request: Abi.Request) -> Abi.Verdict:
  if Relations.insertedOnly(old.signatures, new.signatures, signedBy) then Abi.Verdict.admitted({}) else Abi.Verdict.refused({clause: "signed"})
def defaultSeed() -> Seed:
  {amendment: {object: "", law: ""}, parties: Lists.List.nil(), terms: "", piece: ""}
def seeded(seed: Seed) -> State:
  {amendment: seed.amendment, parties: seed.parties, terms: seed.terms, piece: seed.piece, signatures: Relations.empty(), withdrawn: "", withdrawnHandle: "", closed: 0n}
def initial() -> State:
  seeded(defaultSeed())
def relations() -> Relations.Decls:
  Relations.Decls.cons({head: {field: "signatures", key: Lists.List.cons({head: "principal", tail: Lists.List.nil({})}), limit: 64n}, tail: Relations.Decls.nil({})})
def signedBy(signature: Signature) -> {principal: String}:
  {principal: signature.principal}
def keep() -> Edits:
  {signatures: Plans.Entries.keep({}), withdrawn: Plans.Edit.keep({}), withdrawnHandle: Plans.Edit.keep({}), closed: Plans.Edit.keep({})}
sum Done:
  signed: {remaining: Nat}
  atRest: {}
  withdrawn: {}
  refused: Card.Refusal
# Why a deal refuses: each arm a clause, `why` its reading.
sum Why:
  withdrawn: {}
  notParty: {act: String}
  alreadySigned: {}
  atRest: {}
def why(w: Why) -> String:
  match w:
    case withdrawn(_): "The deal was withdrawn."
    case notParty(n): "Only a party {n.act}."
    case alreadySigned(_): "Already countersigned."
    case atRest(_): "The deal is at rest."
def clause(w: Why) -> String:
  match w:
    case withdrawn(_): "withdrawn"
    case notParty(_): "notParty"
    case alreadySigned(_): "alreadySigned"
    case atRest(_): "atRest"
def refused(w: Why) -> Done:
  Done.refused({clause: clause(w), reading: why(w)})
def party(state: State, who: String) -> Bool:
  Lists.any(state.parties, fn(p: String) -> Bool: p == who)
def hasSigned(state: State, who: String) -> Bool:
  match Relations.lookup(state.signatures, {principal: who}, signedBy):
    case some(_): true
    case none(_): false
def unsigned(state: State) -> Nat:
  Lists.length(Lists.filter(state.parties, fn(p: String) -> Bool: hasSigned(state, p) == false))
def atRest(state: State) -> Bool:
  unsigned(state) == 0n && state.withdrawn == ""
# A party countersigns once, citing its post; the last signature puts the deal at rest.
# A spell `delvetalk <deal> countersign` names no post: the host finds the field missing and
# hands the reply to `receive`, which countersigns citing the post the reply is in.
def countersign(state: State, input: {post: String}, context: Abi.Context) -> Activity<Done>:
  countersigned(input.post, state, context, fn(done: Done) -> Done: done)
def countersigned<T>(post: String, state: State, context: Abi.Context, then: Done -> T) -> Activity<T>:
  if state.withdrawn != "" then then(refused(Why.withdrawn({}))) else if party(state, context.principal) == false then then(refused(Why.notParty({act: "countersigns"}))) else if hasSigned(state, context.principal) then then(refused(Why.alreadySigned({}))) else signing({principal: context.principal, handle: context.handle, post: post}, state, context, then)
def signing<T>(signature: Signature, state: State, context: Abi.Context, then: Done -> T) -> Activity<T>:
  let written(_) = write {signatures: insert signature}
  if unsigned(state) == 1n then amending(state.amendment, context, then) else then(Done.signed({remaining: unsigned(state) - 1n}))
# At rest, the deal's amendment (if any) is proposed to its object, the deal as caller.
def amending<T>(amendment: Amendment, context: Abi.Context, then: Done -> T) -> Activity<T>:
  if amendment.object == "" then then(Done.atRest({})) else amended(amendment, context, then)
def amended<T>(amendment: Amendment, context: Abi.Context, then: Done -> T) -> Activity<T>:
  match world.amend({object: {world: context.world, object: amendment.object}, law: amendment.law}):
    case amended(_): then(Done.atRest({}))
    case refused(r): then(Done.refused({clause: "amendRefused", reading: "At rest, but {amendment.object} refused the amendment ({r.clause})."}))
# A party withdraws before rest; the withdrawal names who withdrew.
def withdraw(state: State, context: Abi.Context) -> Activity<Done>:
  if party(state, context.principal) == false then refused(Why.notParty({act: "withdraws"})) else if atRest(state) then refused(Why.atRest({})) else if state.withdrawn != "" then refused(Why.withdrawn({})) else withdrawing(context)
def withdrawing(context: Abi.Context) -> Activity<Done>:
  let written(_) = write {withdrawn: set context.principal, withdrawnHandle: set context.handle, closed: set 1n}
  Done.withdrawn({})
form countersign:
form withdraw:
def forms() -> Card.Forms:
  Card.Forms.cons({head: countersignForm(), tail: Card.Forms.cons({head: withdrawForm(), tail: Card.Forms.nil()})})
def blurb() -> Card.Door:
  {word: "deal", blurb: "Terms every party countersigns; at rest when all have."}
def doneReply(done: Done) -> Card.Replied:
  match done:
    case refused(r): Card.Replied.refused(r)
    case _: Card.Replied.done({action: "countersign"})
# A countersign by post cites that post: the reply is the signature.
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  if Card.spellAction(input.text) == "countersign" && input.post != "" then countersigned(input.post, state, context, doneReply) else Card.answer(input, context, forms(), render(state, context))
def signatureLine(signature: Signature) -> Document.Document:
  Document.text("signed: {Card.shown(signature.principal, signature.handle, Card.stranger())} at {signature.post}\n")
def waitingLine(state: State) -> Document.Document:
  Document.text(if state.withdrawn != "" then "Withdrawn by {Card.shown(state.withdrawn, state.withdrawnHandle, Card.stranger())}.\n" else if atRest(state) then "At rest: every party has countersigned.\n" else "Waiting for {natText(unsigned(state))} of the parties.\n")
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  let piece = if state.piece == "" then "" else " for {state.piece}"
  let amends = if state.amendment.object == "" then "" else "At rest it amends {state.amendment.object} to:\n    {state.amendment.law}\n\n"
  let head = Document.text("DEAL{piece}\n\nTerms: {state.terms}\n\n{amends}")
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: Lists.concat(Card.clipped(Lists.map(Relations.rows(state.signatures), signatureLine), 8n), Document.Documents.cons({head: waitingLine(state), tail: Document.Documents.cons({head: Document.text(partyLine(context, state)), tail: Document.Documents.nil()})}))})})
# A party reading the card sees where it stands and the spell to sign; nobody else does.
def partyLine(context: Abi.Context, state: State) -> String:
  if party(state, context.principal) == false || state.withdrawn != "" || atRest(state) then "" else if hasSigned(state, context.principal) then "\nYou are a party and have countersigned.\n" else "\nYou are a party and have not countersigned. Reply:\n\n    delvetalk {context.object} countersign\n"
