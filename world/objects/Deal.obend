edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./Card.obend as Card
# glm and inkling's countersign protocol, as an object: the parties and the terms are
# fixed at creation; each party countersigns once, citing the post that carries the
# signature; the deal is at rest when every party has signed; a party may withdraw it
# before rest. An exhibition is a deal with a piece. The posts are the deal's roots.
record Signature:
  principal: String
  post: String
record State:
  parties: Lists.List<String>
  terms: String
  piece: String
  signatures: Lists.List<Signature>
  withdrawn: String
  closed: Nat
record Seed:
  parties: Lists.List<String>
  terms: String
  piece: String
record Edits:
  signatures: Plans.Entries<Signature, {}>
  withdrawn: Plans.Edit<String, {}>
  closed: Plans.Edit<Nat, {}>
type Plan = Plans.Plan<Edits>
type Response = Plans.Response<State, {}>
# The law: only a party changes the deal; the parties, terms and piece never change; a
# signature is only ever appended; a withdrawal is final (closed goes 0 to 1 once:
# writeOnce reads naturals only, and passes any text field unjudged). Bend refuses a
# stranger by name first.
law members "a write is a party's": request.kind == 0 implies request.subject in new.parties
law fixed "the parties, the terms and the piece never change": unchanged(parties) and unchanged(terms) and unchanged(piece)
law signed "signatures are only added": appendOnly(signatures)
law once "a deal closes once": writeOnce(closed)
def defaultSeed() -> Seed:
  {parties: Lists.List.nil(), terms: "", piece: ""}
def seeded(seed: Seed) -> State:
  {parties: seed.parties, terms: seed.terms, piece: seed.piece, signatures: Lists.List.nil(), withdrawn: "", closed: 0n}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {signatures: Plans.Entries.keep({}), withdrawn: Plans.Edit.keep({}), closed: Plans.Edit.keep({})}
sum Done:
  signed: {remaining: Nat}
  atRest: {}
  withdrawn: {}
  refused: {reason: String}
def party(state: State, who: String) -> Bool:
  Lists.any(state.parties, fn(p: String) -> Bool: p == who)
def hasSigned(state: State, who: String) -> Bool:
  Lists.any(state.signatures, fn(s: Signature) -> Bool: s.principal == who)
def unsigned(state: State) -> Nat:
  Lists.length(Lists.filter(state.parties, fn(p: String) -> Bool: hasSigned(state, p) == false))
def atRest(state: State) -> Bool:
  unsigned(state) == 0n && state.withdrawn == ""
# A party countersigns once, citing its post; the last signature puts the deal at rest.
def countersigned<T>(state: State, post: String, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  if state.withdrawn != "" then then(Done.refused({reason: "The deal was withdrawn."})) else if party(state, context.principal) == false then then(Done.refused({reason: "Only a party countersigns."})) else if hasSigned(state, context.principal) then then(Done.refused({reason: "Already countersigned."})) else signing(state, {principal: context.principal, post: post}, context, then)
def signing<T>(state: State, signature: Signature, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  let written(_) = perform(write {signatures: append signature})
  if unsigned(state) == 1n then then(Done.atRest({})) else then(Done.signed({remaining: unsigned(state) - 1n}))
def countersign(state: State, input: {post: String}, context: Abi.Context) -> Activity<Plan, Response, Done>:
  countersigned(state, input.post, context, fn(done: Done) -> Done: done)
# A party withdraws before rest; the withdrawal names who withdrew.
def withdrew<T>(state: State, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  if party(state, context.principal) == false then then(Done.refused({reason: "Only a party withdraws."})) else if atRest(state) then then(Done.refused({reason: "The deal is at rest."})) else if state.withdrawn != "" then then(Done.refused({reason: "The deal was withdrawn."})) else withdrawing(context, then)
def withdrawing<T>(context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  let written(_) = perform(write {withdrawn: set context.principal, closed: set 1n})
  then(Done.withdrawn({}))
def withdraw(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  withdrew(state, context, fn(done: Done) -> Done: done)
form countersign:
form withdraw:
def forms() -> Card.Forms:
  Card.Forms.cons({head: countersignForm(), tail: Card.Forms.cons({head: withdrawForm(), tail: Card.Forms.nil()})})
def door() -> Card.Door:
  {word: "deal", blurb: "Terms every party countersigns; at rest when all have."}
def doneReply(done: Done) -> Card.Reply:
  match done:
    case refused(r): Card.Reply.refused({reason: r.reason})
    case withdrawn(_): Card.Reply.done({action: "withdraw"})
    case _: Card.Reply.done({action: "countersign"})
# A countersign by post cites that post: the reply is the signature.
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  heard(state, input.post, Card.route(input.text, context, forms()), context)
def heard(state: State, post: String, routed: Card.Routed, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  match routed:
    case act(a): if a.action == "withdraw" then withdrew(state, context, doneReply) else countersigned(state, post, context, doneReply)
    case _: Card.answer(routed, context, forms(), render(state, context))
def signatureLine(signature: Signature) -> Document.Document:
  Document.text("signed: {Card.handle(signature.principal)} at {signature.post}\n")
def waitingLine(state: State) -> Document.Document:
  Document.text(if state.withdrawn != "" then "Withdrawn by {Card.handle(state.withdrawn)}.\n" else if atRest(state) then "At rest: every party has countersigned.\n" else "Waiting for {natText(unsigned(state))} of the parties.\n")
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  let piece = if state.piece == "" then "" else " for {state.piece}"
  let head = Document.text("DEAL{piece}\n\nTerms: {state.terms}\n\n")
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: Lists.concat(Card.clipped(Lists.map(state.signatures, signatureLine), 8n), Document.Documents.cons({head: waitingLine(state), tail: Document.Documents.cons({head: Document.text(partyLine(state, context)), tail: Document.Documents.nil()})}))})})
# A party reading the card sees where it stands and the spell to sign; nobody else does.
def partyLine(state: State, context: Abi.Context) -> String:
  if party(state, context.principal) == false || state.withdrawn != "" || atRest(state) then "" else if hasSigned(state, context.principal) then "\nYou are a party and have countersigned.\n" else "\nYou are a party and have not countersigned. Reply:\n\n    delvetalk {context.object} countersign\n"
