edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Relation.obend as Relations
import ./Text.obend as Text
# glm and inkling's countersign protocol, as an object: the parties and the terms are
# fixed at creation; each party countersigns once, citing the post that carries the
# signature; the deal is at rest when every party has signed; a party may withdraw it
# before rest. An exhibition is a deal with a piece. The posts are the deal's roots.
# The signatures are a relation keyed {principal}: once per party is the key, and the law
# admits only inserts.
record Signature:
  principal: String
  handle: String
  post: String
# amendment: a law for another object that the deal applies when it comes to rest, by
# `amend` with the deal as caller (the object's own law judges it); object "" for none.
record Amendment:
  object: String
  law: String
record State:
  amendment: Amendment
  parties: Lists.List<String>
  terms: String
  piece: String
  signatures: Relations.Relation<Signature>
  withdrawn: String
  withdrawnHandle: String
  closed: Nat
# The law: the parties, terms and piece never change; a withdrawal is final (closed goes 0
# to 1 once); a signature is only ever inserted; only a party changes the deal, and writes it
# only by countersigning or withdrawing (a proposed write is no party's method). Bend refuses
# a stranger by name first.
law fixed "the parties, the terms and the piece never change": unchanged(parties) and unchanged(terms) and unchanged(piece) and unchanged(amendment)
law once "a deal closes once": writeOnce(closed)
law signed "signatures are only added": insertOnly(signatures)
law members "every change is a party's, and a write is a countersignature or a withdrawal": request.subject in new.parties and (request.kind == 1 or request.kind == 2 or request.method == "countersign" or request.method == "withdraw")
# A new signature is the requester's own (one party cannot sign for another).
def law(old: State, new: State, request: Abi.Request) -> Abi.Verdict:
  if Lists.any(Relations.rows(new.signatures), fn(s: Signature) -> Bool: hasSigned(old, s.principal) == false && s.principal != request.context.principal) then Abi.Verdict.refused({clause: "signer", reading: "A party countersigns only for themselves."}) else Abi.Verdict.admitted({})
def initial() -> State:
  {amendment: {object: "", law: ""}, parties: Lists.List.nil(), terms: "", piece: "", signatures: Relations.empty(), withdrawn: "", withdrawnHandle: "", closed: 0n}
def relations() -> Relations.Decls:
  Lists.append(Relations.Decls.nil(), {field: "signatures", key: Text.words("principal"), limit: 64n})
def signedBy(signature: Signature) -> {principal: String}:
  {principal: signature.principal}
sum Done:
  signed: {remaining: Nat}
  atRest: {}
  withdrawn: {}
  refused: Card.Refusal
# Why a deal refuses: each arm a clause and its reading.
sum Why:
  withdrawn: {}
  notParty: {act: String}
  alreadySigned: {}
  atRest: {}
  unposted: {}
def refusal(w: Why) -> Card.Refusal:
  match w:
    case withdrawn(_): {clause: "withdrawn", reading: "The deal was withdrawn."}
    case notParty(n): {clause: "notParty", reading: "Only a party {n.act}."}
    case alreadySigned(_): {clause: "alreadySigned", reading: "Already countersigned."}
    case atRest(_): {clause: "atRest", reading: "The deal is at rest."}
    case unposted(_): {clause: "unposted", reading: "A countersignature is a reply: it cites the post it is in."}
def refused(w: Why) -> Done:
  Done.refused(refusal(w))
def party(state: State, who: String) -> Bool:
  Lists.any(state.parties, fn(p: String) -> Bool: p == who)
def hasSigned(state: State, who: String) -> Bool:
  match Relations.lookup(state.signatures, {principal: who}, signedBy):
    case some(_): true
    case none(_): false
def unsigned(state: State) -> Nat:
  Lists.length(Lists.filter(state.parties, fn(p: String) -> Bool: hasSigned(state, p) == false))
def atRest(state: State) -> Bool:
  unsigned(state) == 0n && state.withdrawn == ""
# A party countersigns once by replying `delvetalk <deal> countersign`: the signature cites the
# post the reply is in (the host's `inputOrigin.post`), and a turn from no post signs nothing. The
# last signature puts the deal at rest.
def countersign(state: State, input: {}, context: Abi.Context) -> Activity<Done>:
  if state.withdrawn != "" then refused(Why.withdrawn({})) else if party(state, context.principal) == false then refused(Why.notParty({act: "countersigns"})) else if hasSigned(state, context.principal) then refused(Why.alreadySigned({})) else if context.inputOrigin.post == "" then refused(Why.unposted({})) else signing({principal: context.principal, handle: context.handle, post: context.inputOrigin.post}, state, context)
def signing(signature: Signature, state: State, context: Abi.Context) -> Activity<Done>:
  let written(_) = write {signatures: insert signature}
  if unsigned(state) == 1n then amending(state.amendment, context) else Done.signed({remaining: unsigned(state) - 1n})
# At rest, the deal's amendment (if any) is proposed to its object, the deal as caller.
def amending(amendment: Amendment, context: Abi.Context) -> Activity<Done>:
  if amendment.object == "" then Done.atRest({}) else amended(amendment, context)
def amended(amendment: Amendment, context: Abi.Context) -> Activity<Done>:
  match world.amend({object: {world: context.world, object: amendment.object}, law: amendment.law}):
    case amended(_): Done.atRest({})
    case refused(r): Done.refused({clause: "amendRefused", reading: "At rest, but {amendment.object} refused the amendment ({r.clause})."})
# A party withdraws before rest; the withdrawal names who withdrew.
def withdraw(state: State, context: Abi.Context) -> Activity<Done>:
  if party(state, context.principal) == false then refused(Why.notParty({act: "withdraws"})) else if atRest(state) then refused(Why.atRest({})) else if state.withdrawn != "" then refused(Why.withdrawn({})) else withdrawing(context)
def withdrawing(context: Abi.Context) -> Activity<Done>:
  let written(_) = write {withdrawn: set context.principal, withdrawnHandle: set context.handle, closed: set 1n}
  Done.withdrawn({})
form countersign:
form withdraw:
def blurb() -> Card.Door:
  {word: "deal", blurb: "Terms every party countersigns; at rest when all have."}
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
def signatureLine(signature: Signature) -> Document.Document:
  Document.text("signed: {Card.shown(signature.principal, signature.handle, Card.stranger())} at {signature.post}\n")
def waitingLine(state: State) -> Document.Document:
  Document.text(if state.withdrawn != "" then "Withdrawn by {Card.shown(state.withdrawn, state.withdrawnHandle, Card.stranger())}.\n" else if atRest(state) then "At rest: every party has countersigned.\n" else "Waiting for {natText(unsigned(state))} of the parties.\n")
def render(state: State, context: Abi.Context) -> Document.Document:
  let piece = if state.piece == "" then "" else " for {state.piece}"
  let amends = if state.amendment.object == "" then "" else "At rest it amends {state.amendment.object} to:\n    {state.amendment.law}\n\n"
  let head = Document.text("DEAL{piece}\n\nTerms: {state.terms}\n\n{amends}")
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: Lists.concat(Card.clipped(Lists.map(Relations.rows(state.signatures), signatureLine), 8n), Document.Documents.cons({head: waitingLine(state), tail: Document.Documents.cons({head: Document.text(partyLine(context, state)), tail: Document.Documents.nil()})}))})})
# A party reading the card sees where it stands and the spell to sign; nobody else does.
def partyLine(context: Abi.Context, state: State) -> String:
  if party(state, context.principal) == false || state.withdrawn != "" || atRest(state) then "" else if hasSigned(state, context.principal) then "\nYou are a party and have countersigned.\n" else "\nYou are a party and have not countersigned. Reply:\n\n    delvetalk {context.object} countersign\n"
