edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./Card.obend as Card
record State:
  open: Bool
  openedBy: String
  knocks: Lists.List<String>
  observers: Card.Observers
# What a creator may supply; the host lays it over initial().
type Seed = {}
record Edits:
  open: Plans.Edit<Bool, {}>
  openedBy: Plans.Edit<String, {}>
  knocks: Plans.Entries<String, {}>
  observers: Plans.Entries<Card.Observer, {}>
type Plan = Plans.Plan<Edits>
type Response = Plans.Response<State, {}>
def defaultSeed() -> Seed:
  {}
def seeded(seed: Seed) -> State:
  {open: false, openedBy: "", knocks: Lists.List.nil(), observers: Card.Observers.nil()}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {open: Plans.Edit.keep({}), openedBy: Plans.Edit.keep({}), knocks: Plans.Entries.keep({}), observers: Plans.Entries.keep({})}
# Who opened it is the turn's principal (for a bell's send, the bell ringer's).
def unlatched(context: Abi.Context) -> Edits:
  extend(keep(), {open: Plans.Edit.set({value: true}), openedBy: Plans.Edit.set({value: context.principal})})
def latch(state: State, context: Abi.Context) -> Edits:
  if state.open then keep() else unlatched(context)
# The method a bell's observer entry names: open the door and tell its observers.
def open(state: State, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: unlatched(context)}))
  Card.broadcast(state.observers, Plans.nothing(), 0n, fn(sent: Nat) -> Bool: true)
# A knock is retained; a knock on a closed door opens it.
def knocked<T>(state: State, context: Abi.Context, then: Bool -> T) -> Activity<Plan, Response, T>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: extend(latch(state, context), {knocks: Plans.Entries.append({item: context.principal})})}))
  if state.open then then(true) else Card.broadcast(state.observers, Plans.nothing(), 0n, fn(sent: Nat) -> T: then(true))
def knock(state: State, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  knocked(state, context, fn(opened: Bool) -> Bool: opened)
def observe(state: State, input: Card.Observer, context: Abi.Context) -> Activity<Plan, Response, Card.Change>:
  changed(Card.observing(state.observers, input), context)
def unobserve(state: State, input: Card.Observer, context: Abi.Context) -> Activity<Plan, Response, Card.Change>:
  changed(Card.unobserving(state.observers, input), context)
def changed(change: Card.Change, context: Abi.Context) -> Activity<Plan, Response, Card.Change>:
  match change:
    case edit(e): observed(change, e.entries, context)
    case _: change
def observed(change: Card.Change, entries: Plans.Entries<Card.Observer, {}>, context: Abi.Context) -> Activity<Plan, Response, Card.Change>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {observers: entries})}))
  change
form knock:
def forms() -> Card.Forms:
  Card.Forms.cons({head: knockForm(), tail: Card.Forms.nil()})
def door() -> Card.Door:
  {word: "door", blurb: "Knock; a bell can open it too."}
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  heard(state, Card.routeHeard(input, context, forms()), context)
def heard(state: State, routed: Card.Routed, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  match routed:
    case act(a): knocked(state, context, fn(opened: Bool) -> Card.Reply: Card.Reply.done({action: a.action}))
    case _: Card.answer(routed, context, forms(), render(state, context))
def knockLine(who: String) -> Document.Document:
  Document.text("knock: {Card.handle(who)}\n")
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text(if state.open then "The door is open, opened by {Card.name(state.openedBy, context)}.\n" else "The door is shut.\n"), tail: Card.clipped(Lists.map(state.knocks, knockLine), 8n)})})
