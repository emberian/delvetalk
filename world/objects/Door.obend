edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Text.obend as Text
# Who knocked, with their handle as the host knew it then.
record Knock:
  who: String
  handle: String
# watching: the object whose `rung` opens this door (a bell), nobody until `watch`.
record State:
  open: Bool
  openedBy: String
  openedHandle: String
  knocks: Lists.List<Knock>
  watching: Plans.Reference
# What a creator may supply; the host lays it over initial().
type Seed = {}
record Edits:
  open: Plans.Edit<Bool, {}>
  openedBy: Plans.Edit<String, {}>
  openedHandle: Plans.Edit<String, {}>
  knocks: Plans.Entries<Knock, {}>
  watching: Plans.Edit<Plans.Reference, {}>
def defaultSeed() -> Seed:
  {}
def seeded(seed: Seed) -> State:
  {open: false, openedBy: "", openedHandle: "", knocks: Lists.List.nil(), watching: Plans.nobody()}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {open: Plans.Edit.keep({}), openedBy: Plans.Edit.keep({}), openedHandle: Plans.Edit.keep({}), knocks: Plans.Entries.keep({}), watching: Plans.Edit.keep({})}
# Who opened it: the knocker, or the object whose change opened it (its id, no handle).
def unlatched(who: String, handle: String) -> Edits:
  extend(keep(), {open: Plans.Edit.set({value: true}), openedBy: Plans.Edit.set({value: who}), openedHandle: Plans.Edit.set({value: handle})})
def latch(context: Abi.Context, state: State) -> Edits:
  if state.open then keep() else unlatched(context.principal, context.handle)
# A knock is retained; a knock on a closed door opens it.
def knock(state: State, context: Abi.Context) -> Activity<Bool>:
  let written(_) = world.write(extend(latch(context, state), {knocks: Plans.Entries.append({item: {who: context.principal, handle: context.handle}})}))
  true
# Watch an object's `rung` (a bell's): the host delivers each write of it to `changed`.
def watch(state: State, input: {object: String}, context: Abi.Context) -> Activity<String>:
  let object = {world: context.world, object: input.object}
  match world.subscribe({object: object, field: "rung", method: "changed"}):
    case subscribed(_): watched(object)
    case denied(_): "denied"
    case refused(r): r.clause
def watched(object: Plans.Reference) -> Activity<String>:
  let written(_) = write {watching: set object}
  "watching"
# A change of the watched object's `rung` to true opens the door; the change is delivered by
# the host (the watched object is the caller), so nobody else's turn opens it this way.
def changed(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Bool>, retracted: Lists.List<Bool>}, context: Abi.Context) -> Activity<Bool>:
  if context.caller == state.watching.object && Plans.same(input.object, state.watching) && input.field == "rung" && Lists.any(input.inserted, fn(rung: Bool) -> Bool: rung) && state.open == false then opened(context.caller) else state.open
def opened(by: String) -> Activity<Bool>:
  let written(_) = world.write(unlatched(by, ""))
  true
form knock:
# An action without a form: watching names an object.
def methods() -> Lists.List<String>:
  Text.words("watch")
def forms() -> Card.Forms:
  Card.Forms.cons({head: knockForm(), tail: Card.Forms.nil()})
def blurb() -> Card.Door:
  {word: "door", blurb: "Knock; a bell can open it too."}
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
def knockLine(knock: Knock) -> Document.Document:
  Document.text("knock: {Card.shown(knock.who, knock.handle, Card.stranger())}\n")
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text(if state.open then "The door is open, opened by {Card.shown(state.openedBy, state.openedHandle, context)}.\n" else "The door is shut.\n"), tail: Card.clipped(Lists.map(state.knocks, knockLine), 8n)})})
