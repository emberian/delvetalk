edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Seats.obend as Seats
import ./Automatafl.obend as Game
import ./Validated.obend as Checked
import ./Text.obend as Text
# The original two-player Automatafl table on the commit-reveal seats. Each round both
# seats seal, both open (each opening waits for the other's seal), and then anyone
# resolves: the table views both seats, plays the qualified game, and moves both seats
# to the next round.
# owner: who may reprogram or amend the table (the host fills it with the creating principal).
record State:
  owner: String
  north: Plans.Reference
  south: Plans.Reference
  round: Nat
  width: Nat
  height: Nat
  game: Game.Result
record Seed:
  north: Plans.Reference
  south: Plans.Reference
record Edits:
  round: Plans.Edit<Nat, Nat>
  game: Plans.Edit<Game.Result, {}>
law rounds "rounds only go forward": monotone(round)
law owner "only the owner reprograms or amends it; anyone plays": request.kind == 0 or request.subject == new.owner
def defaultSeed() -> Seed:
  {north: Plans.nobody(), south: Plans.nobody()}
def opening() -> Game.Result:
  {board: 3544482323287199997214430076569557050131592232587036428018782212697626882n, automaton: 60n, marks: 0n, status: 0n, winner: 0n}
def seeded(seed: Seed) -> State:
  {owner: "", north: seed.north, south: seed.south, round: 0n, width: 11n, height: 11n, game: opening()}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {round: Plans.Edit.keep({}), game: Plans.Edit.keep({})}
sum Done:
  resolved: {round: Nat, status: Nat, winner: Nat}
  refused: {reason: String}
def ready(seat: Seats.State, round: Nat) -> Bool:
  seat.round == round && seat.opened
# Only `resolve` plays: every helper takes the State after its own inputs, since a definition
# whose first parameter is the State is a method any turn may run (`north` skipped the
# finished-match check; `played` and `advanced` wrote or moved the seats with any result).
def resolve(state: State, context: Abi.Context) -> Activity<Done>:
  if state.game.winner != 0n then Done.refused({reason: "The match is finished."}) else north(context, state)
def north(context: Abi.Context, state: State) -> Activity<Done>:
  match world.view::<Seats.State>({object: state.north}):
    case viewed(v): if ready(v.state, state.round) then south(v.state, state) else Done.refused({reason: "North has not opened this round."})
    case _: Done.refused({reason: "North's seat did not answer."})
def south(n: Seats.State, state: State) -> Activity<Done>:
  match world.view::<Seats.State>({object: state.south}):
    case viewed(v): if ready(v.state, state.round) then played(Checked.play(state.width, state.height, state.game.board, state.game.automaton, state.game.marks, n.source, n.target, v.state.source, v.state.target), state) else Done.refused({reason: "South has not opened this round."})
    case _: Done.refused({reason: "South's seat did not answer."})
def played(result: Game.Result, state: State) -> Activity<Done>:
  let written(_) = write {round: add 1n, game: set result}
  advanced(result, state)
def advanced(result: Game.Result, state: State) -> Activity<Done>:
  match world.call::<Seats.Done>({object: state.north, method: "next", argument: Plans.nothing()}):
    case _: advancedSouth(result, state)
def advancedSouth(result: Game.Result, state: State) -> Activity<Done>:
  match world.call::<Seats.Done>({object: state.south, method: "next", argument: Plans.nothing()}):
    case _: Done.resolved({round: state.round + 1n, status: result.status, winner: result.winner})
# An action without a form: anyone resolves a round.
def methods() -> Lists.List<String>:
  Text.words("resolve")
def forms() -> Card.Forms:
  Card.Forms.nil()
def blurb() -> Card.Door:
  {word: "play", blurb: "The original two-player, 11x11 Automatafl: seal, open, resolve."}
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
def glyph(cell: Nat) -> String:
  if cell == 1n then "+" else if cell == 2n then "-" else if cell == 3n then "@" else "."
def row(board: Nat, at: Nat, left: Nat) -> String:
  if left == 0n then "\n" else "{glyph(Game.cell(board, at))}{row(board, at + 1n, left - 1n)}"
def rows(state: State, y: Nat) -> Document.Documents:
  if y == state.height then Document.Documents.nil() else Document.Documents.cons({head: Document.text(row(state.game.board, y * state.width, state.width)), tail: rows(state, y + 1n)})
def outcome(game: Game.Result) -> String:
  if game.winner == 1n then "North wins." else if game.winner == 2n then "South wins." else if game.status == 1n then "The last pair conflicted; the board stayed." else if game.status == 2n then "The last pair was invalid; the board stayed." else "Seal, open, resolve."
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text("AUTOMATAFL, round {natText(state.round)}: {outcome(state.game)}\n\n"), tail: rows(state, 0n)})})
