edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Card.obend as Card
import ./Seats.obend as Seats
import ./Automatafl.obend as Game
import ./Validated.obend as Checked
# The original two-player Automatafl table on the commit-reveal seats. Each round both
# seats seal, both open (each opening waits for the other's seal), and then anyone
# resolves: the table views both seats, plays the qualified game, and moves both seats
# to the next round.
record State:
  north: Plans.Reference
  south: Plans.Reference
  round: Nat
  width: Nat
  height: Nat
  game: Game.Result
record Seed:
  north: Plans.Reference
  south: Plans.Reference
record Edits:
  round: Plans.Edit<Nat, Nat>
  game: Plans.Edit<Game.Result, {}>
type Plan = Plans.Plan<Edits, {}>
type Response = Plans.Response<Seats.State, Seats.Done>
law rounds: monotone(round)
def defaultSeed() -> Seed:
  {north: Plans.nobody(), south: Plans.nobody()}
def opening() -> Game.Result:
  {board: 3544482323287199997214430076569557050131592232587036428018782212697626882n, automaton: 60n, marks: 0n, status: 0n, winner: 0n}
def seeded(seed: Seed) -> State:
  {north: seed.north, south: seed.south, round: 0n, width: 11n, height: 11n, game: opening()}
def initial() -> State:
  seeded(defaultSeed())
sum Done:
  resolved: {round: Nat, status: Nat, winner: Nat}
  refused: {reason: String}
def ready(seat: Seats.State, round: Nat) -> Bool:
  seat.round == round && seat.opened
def resolve(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  if state.game.winner != 0n then Done.refused({reason: "The match is finished."}) else north(state, context)
def north(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match perform(Plan.view({object: state.north})):
    case viewed(v): if ready(v.state, state.round) then south(state, v.state, context) else Done.refused({reason: "North has not opened this round."})
    case _: Done.refused({reason: "North's seat did not answer."})
def south(state: State, n: Seats.State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match perform(Plan.view({object: state.south})):
    case viewed(v): if ready(v.state, state.round) then played(state, Checked.play(state.width, state.height, state.game.board, state.game.automaton, state.game.marks, n.source, n.target, v.state.source, v.state.target), context) else Done.refused({reason: "South has not opened this round."})
    case _: Done.refused({reason: "South's seat did not answer."})
def played(state: State, result: Game.Result, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match perform(Plan.write({object: Plans.self(context), edits: {round: Plans.Edit::<Nat, Nat>.add({delta: 1n}), game: Plans.Edit::<Game.Result, {}>.set({value: result})}})):
    case _: advanced(state, result)
def advanced(state: State, result: Game.Result) -> Activity<Plan, Response, Done>:
  match perform(Plan.call({object: state.north, method: "next", argument: {}})):
    case _: advancedSouth(state, result)
def advancedSouth(state: State, result: Game.Result) -> Activity<Plan, Response, Done>:
  match perform(Plan.call({object: state.south, method: "next", argument: {}})):
    case _: Done.resolved({round: state.round + 1n, status: result.status, winner: result.winner})
def forms() -> Card.Forms:
  Card.Forms.nil()
def door() -> Card.Door:
  {word: "play", blurb: "The original two-player, 11x11 Automatafl: seal, open, resolve."}
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  Card.answer::<Edits, {}, Seats.State, Seats.Done>(Card.route(input.text, context, forms()), context, forms(), render(state))
def glyph(cell: Nat) -> String:
  if cell == 1n then "+" else if cell == 2n then "-" else if cell == 3n then "@" else "."
def row(board: Nat, at: Nat, left: Nat) -> String:
  if left == 0n then "\n" else textConcat(glyph(Game.cell(board, at)), row(board, at + 1n, left - 1n))
def rows(state: State, y: Nat) -> Document.Documents:
  if y == state.height then Document.Documents.nil() else Document.Documents.cons({head: Document.text(row(state.game.board, y * state.width, state.width)), tail: rows(state, y + 1n)})
def outcome(game: Game.Result) -> String:
  if game.winner == 1n then "North wins." else if game.winner == 2n then "South wins." else if game.status == 1n then "The last pair conflicted; the board stayed." else if game.status == 2n then "The last pair was invalid; the board stayed." else "Seal, open, resolve."
def render(state: State) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text(textConcat("AUTOMATAFL, round ", textConcat(natText(state.round), textConcat(": ", textConcat(outcome(state.game), "\n\n"))))), tail: rows(state, 0n)})})
