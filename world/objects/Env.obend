edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Event.obend as Events
import ./Relation.obend as Relations
import ./Rows.obend as Rows
import ./Text.obend as Text
# One principal's senses (inkling's env, mimo's pub/sub): its id is env/<did> and its
# owner that DID. publish takes an event in; observe offers what is new since `seen` and
# changes nothing (observation must not consume); seen moves the mark, as its own turn with
# its own receipt. A post addressed to the owner (the bridge routes mentions here, as the
# author's turn) is taken in as a mention event by `write`. handle: the owner's, as arrival seeds it,
# for the card. Whoever wants to know of what comes in (the owner's Wake) subscribes to
# `buffer`.
# The buffer is a relation keyed {at, actor, uri, n}: an event as it was taken in, with `n`,
# the buffer's count then, so key order (n first) is the order of arrival. It keeps 256;
# past them the host drops the oldest.
type Event = Events.Event
record State:
  owner: String
  handle: String
  buffer: Relations.Relation<Event>
  seen: Nat
# Only the owner writes, reprograms or amends the env: the law admits every kind by the
# owner, so it admits an amendment by its installer exactly when the installer is the
# owner (the host's metarule). An Env is therefore created by its own principal, at
# env/<did>, by that principal's own spell (docs/GENESIS.md): never seeded by ember for
# someone else, which the host refuses ("law does not admit an amendment by its proposer
# ember: owner: request.subject == new.owner").
law owner "the owner never changes; only its owner marks it; anyone's line is taken in": unchanged(owner) and (request.subject == new.owner or (request.kind == 0 and (request.method == "write" or request.method == "receive") and unchanged(handle) and unchanged(seen)))
law mark "the mark of what was seen only moves forward": monotone(seen)
def initial() -> State:
  {owner: "", handle: "", buffer: Relations.empty(), seen: 0n}
def relations() -> Relations.Decls:
  Lists.append(Relations.Decls.nil(), {field: "buffer", key: Text.words("at actor uri n"), limit: 256n})
# An event keeps the first 280 characters of its text (its uri names the rest), so the full
# buffer stays under the state bound: 256 rows at about 86 B plus a 280-character text, two
# 80-character uris, a 59-character CID, a DID and a handle (measured 158 KB).
def sensed(event: Event, n: Nat) -> Event:
  extend(event, {n: n, text: textTake(event.text, 280n)})
sum Done:
  done: {count: Nat}
  refused: Card.Refusal
def notOwner(state: State, context: Abi.Context) -> Activity<Done>:
  refusing({clause: "notOwner", reading: "Only its owner writes this env; that is {Card.handle(state.owner)}"}, context)
def refusing(r: Card.Refusal, context: Abi.Context) -> Activity<Done>:
  Card.refusing(Done.refused(r), r, context)
def misplacedReading(state: State) -> String:
  "An env lives at {Events.envOf(state.owner)}"
# An env lives at env/<its owner's DID> (Events.envOf); one elsewhere takes nothing in.
def misplaced(context: Abi.Context, state: State) -> Bool:
  context.object != Events.envOf(state.owner)
# The owner publishes an event; it is taken in at the turn's height, and the count of the
# buffer as it now stands is the answer.
def publish(state: State, input: {event: Event}, context: Abi.Context) -> Activity<Done>:
  if context.principal != state.owner then notOwner(state, context) else if misplaced(context, state) then refusing({clause: "misplaced", reading: misplacedReading(state)}, context) else taken(extend(input.event, {at: context.height}), state)
def taken(event: Event, state: State) -> Activity<Done>:
  let written(_) = write {buffer: insert sensed(event, Relations.count(state.buffer))}
  Card.tell(Done.done({count: Relations.count(state.buffer) + 1n}), Document.text("Taken in at entry {natText(event.at)}; {natText(Relations.count(state.buffer) + 1n)} in all.\n"))
def since(state: State) -> Lists.List<Event>:
  Lists.filter(Relations.rows(state.buffer), fn(row: Event) -> Bool: row.at > state.seen)
# Offers what is new since the mark; writes nothing, so anyone may look.
def observe(state: State, context: Abi.Context) -> Activity<Nat>:
  Card.tell(Lists.length(since(state)), render(state, context))
def seen(state: State, input: {at: Nat}, context: Abi.Context) -> Activity<Done>:
  if context.principal != state.owner then notOwner(state, context) else if input.at < state.seen then refusing({clause: "alreadySeen", reading: "Already seen through #{natText(state.seen)}"}, context) else markWritten(input.at, context, state)
def markWritten(at: Nat, context: Abi.Context, state: State) -> Activity<Done>:
  let written(_) = write {seen: set at}
  Card.tell(Done.done({count: at}), Document.concat(Document.text("Read through #{natText(at)}; nothing before it is new again.\n\n"), render(extend(state, {seen: at}), context)))
# Someone's post addressed to the owner is a mention: taken in whole as an event, its author
# the turn's principal, never read as a spell (a post quoting `delvetalk garden plant` is
# still a mention), and nothing is offered. A record's `write` (Record.obend) is the same act.
def write(state: State, input: {text: String, post: String}, context: Abi.Context) -> Activity<Card.Replied>:
  if misplaced(context, state) then Card.refusing(Card.Replied.refused({clause: "misplaced", reading: misplacedReading(state)}), {clause: "misplaced", reading: misplacedReading(state)}, context) else mentioned(input.text, input.post, context, state)
def mentioned(text: String, post: String, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  let written(_) = write {buffer: insert sensed({kind: "mention", actor: context.principal, handle: context.handle, uri: post, cid: "", text: text, replyTo: "", at: context.height, n: 0n}, Relations.count(state.buffer))}
  Card.Replied.done({action: "write"})
form observe:
form seen:
  at: natural 0..1000000000
def methods() -> Lists.List<String>:
  Text.words("publish ~write")
# A reply that ran no method: anyone but the owner only mentions (prose, taken in whole; a
# spell in a reply is the host's to run, so the bridge sends mentions to `write`); an empty
# reply still asks for the card.
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  if context.principal != state.owner && Text.blank(input.text) == false then write(state, {text: input.text, post: input.post}, context) else Card.answer(input, context, forms(), render(state, context))
# One line an event: its text's first line, cut at 100 characters.
def line(event: Event) -> Document.Document:
  Document.text("#{natText(event.at)} {event.kind} from {Card.shown(event.actor, event.handle, Card.stranger())}: {firstLine(event.text)}\n")
def firstLine(text: String) -> String:
  let first = textTake(text, textBreak(text, "\n"))
  if textLength(textTake(first, 101n)) > 100n then "{textTake(first, 99n)}…" else first
# What is new since the mark, newest first, eight of them (one line each) and a count of
# the rest: within the 1,400 characters a card may take.
def render(state: State, context: Abi.Context) -> Document.Document:
  let new = since(state)
  let how = if Card.reads(state.owner, context) then " Reply delvetalk env observe to read them, delvetalk env seen / at: <number> to mark them read." else ""
  let head = Document.text("ENV of {Card.shown(state.owner, state.handle, context)}{Card.mine(state.owner, context)}: {natText(Lists.length(new))} new since #{natText(state.seen)}.{how}\n")
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: if Card.reads(state.owner, context) then Card.clippedWithin(Lists.map(Lists.reverse(new), line), 8n, Card.left(context, Document.size(head))) else Document.Documents.nil()})})
