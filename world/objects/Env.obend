edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./Card.obend as Card
import ./Event.obend as Events
# One principal's senses (inkling's env, mimo's pub/sub): its id is env/<did> and its
# owner that DID. publish takes an event in and sends it to every subscriber; observe
# offers what is new since `seen` and changes nothing (observation must not consume);
# seen moves the mark, as its own turn with its own receipt. A post addressed to the
# owner (the bridge routes mentions here, as the author's turn) is taken in by receive as a
# mention event. handle: the owner's, as arrival seeds it, for the card.
record State:
  owner: String
  handle: String
  buffer: Lists.List<Events.Event>
  seen: Nat
  subscribers: Card.Observers
record Seed:
  owner: String
  handle: String
record Edits:
  buffer: Plans.Entries<Events.Event, {}>
  seen: Plans.Edit<Nat, {}>
  subscribers: Plans.Entries<Card.Observer, {}>
# Every send is {event}: a subscriber's method takes the event that happened.
record Told:
  event: Events.Event
type Plan = Plans.Plan<Edits>
type Response = Plans.Response<State, {}>
# Only the owner writes, reprograms or amends the env: the law admits every kind by the
# owner, so it admits an amendment by its installer exactly when the installer is the
# owner (the host's metarule). An Env is therefore created by its own principal, at
# env/<did>, by that principal's own spell (docs/GENESIS.md): never seeded by ember for
# someone else, which the host refuses ("law does not admit an amendment by its proposer
# ember: owner: request.subject == new.owner").
law owner "only its owner writes it; anyone's mention is taken in by receive": request.subject == new.owner or (request.kind == 0 and request.method == "receive" and unchanged(owner) and unchanged(handle) and unchanged(seen) and unchanged(subscribers))
law mark "what it has seen never goes back": monotone(seen)
def defaultSeed() -> Seed:
  {owner: "", handle: ""}
def seeded(seed: Seed) -> State:
  {owner: seed.owner, handle: seed.handle, buffer: Lists.List.nil(), seen: 0n, subscribers: Card.Observers.nil()}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {buffer: Plans.Entries.keep({}), seen: Plans.Edit.keep({}), subscribers: Plans.Entries.keep({})}
sum Done:
  done: {count: Nat}
  refused: {reason: String}
def notOwner(state: State) -> Done:
  Done.refused({reason: "Only its owner writes this env; that is {Card.handle(state.owner)}"})
# The buffer keeps the newest 64 events: a full buffer drops its oldest first.
# An env lives at env/<its owner's DID> (Events.envOf); one elsewhere takes nothing in.
def misplaced(state: State, context: Abi.Context) -> Bool:
  context.object != Events.envOf(state.owner)
def published<T>(state: State, event: Events.Event, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  if context.principal != state.owner then then(notOwner(state)) else if misplaced(state, context) then then(Done.refused({reason: "An env lives at {Events.envOf(state.owner)}"})) else if Lists.length(state.buffer) < 64n then taken(state, extend(event, {at: context.height}), then, context) else dropped(state, extend(event, {at: context.height}), then, context)
def dropped<T>(state: State, event: Events.Event, then: Done -> T, context: Abi.Context) -> Activity<Plan, Response, T>:
  match state.buffer:
    case cons(c): droppedOldest(state, c.head, event, then, context)
    case nil(_): taken(state, event, then, context)
def droppedOldest<T>(state: State, oldest: Events.Event, event: Events.Event, then: Done -> T, context: Abi.Context) -> Activity<Plan, Response, T>:
  let written(_) = perform(write {buffer: removeItem oldest})
  taken(state, event, then, context)
def taken<T>(state: State, event: Events.Event, then: Done -> T, context: Abi.Context) -> Activity<Plan, Response, T>:
  let written(_) = perform(write {buffer: append event})
  Card.broadcast(state.subscribers, {event: event}, 0n, fn(sent: Nat) -> T: then(Done.done({count: sent})))
def publish(state: State, input: Told, context: Abi.Context) -> Activity<Plan, Response, Done>:
  published(state, input.event, context, fn(done: Done) -> Done: done)
def since(state: State) -> Lists.List<Events.Event>:
  Lists.filter(state.buffer, fn(event: Events.Event) -> Bool: event.at > state.seen)
# Offers what is new since the mark; writes nothing, so anyone may look.
def observe(state: State, context: Abi.Context) -> Activity<Plan, Response, Nat>:
  Card.tell(Lists.length(since(state)), render(state, context))
def marked<T>(state: State, at: Nat, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  if context.principal != state.owner then then(notOwner(state)) else if at < state.seen then then(Done.refused({reason: "Already seen through {natText(state.seen)}"})) else markWritten(at, context, then)
def markWritten<T>(at: Nat, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  let written(_) = perform(write {seen: set at})
  then(Done.done({count: at}))
def seen(state: State, input: {at: Nat}, context: Abi.Context) -> Activity<Plan, Response, Done>:
  marked(state, input.at, context, fn(done: Done) -> Done: done)
def subscribe(state: State, input: Card.Observer, context: Abi.Context) -> Activity<Plan, Response, Done>:
  if context.principal != state.owner then notOwner(state) else changed(Card.observing(state.subscribers, input), context)
def unsubscribe(state: State, input: Card.Observer, context: Abi.Context) -> Activity<Plan, Response, Done>:
  if context.principal != state.owner then notOwner(state) else changed(Card.unobserving(state.subscribers, input), context)
def changed(change: Card.Change, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match change:
    case edit(e): subscribed(e.entries, e.count, context)
    case unchanged(u): Done.done({count: u.count})
    case refused(r): Done.refused({reason: r.reason})
def subscribed(entries: Plans.Entries<Card.Observer, {}>, count: Nat, context: Abi.Context) -> Activity<Plan, Response, Done>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {subscribers: entries})}))
  Done.done({count: count})
form observe:
form seen:
  at: natural 0..1000000000
def forms() -> Card.Forms:
  Card.Forms.cons({head: observeForm(), tail: Card.Forms.cons({head: seenForm(), tail: Card.Forms.nil()})})
def door() -> Card.Door:
  {word: "env", blurb: "Your senses: what happened, since you last looked."}
def doneReply(action: String) -> Done -> Card.Reply:
  fn(done: Done) -> Card.Reply: Card.Reply.done({action: action})
# Anyone but the owner only mentions: their post is taken in whole, never read as a spell
# (a post quoting `delvetalk garden plant` is still a mention), and nothing is offered; an
# empty reply still asks for the card.
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  if context.principal != state.owner && Card.blank(input.text) == false then mentioned(state, input.text, input.post, context) else heard(state, Card.routeHeard(input, context, forms()), context)
# Someone else's post is a mention of its owner: taken in as an event (no card offered),
# its author the turn's principal.
def mentioned(state: State, text: String, post: String, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  if misplaced(state, context) then Card.Reply.refused({clause: "misplaced", reading: "An env lives at {Events.envOf(state.owner)}"}) else if Lists.length(state.buffer) < 64n then taken(state, mention(text, post, context), mentionReply, context) else dropped(state, mention(text, post, context), mentionReply, context)
def mention(text: String, post: String, context: Abi.Context) -> Events.Event:
  {kind: "mention", actor: context.principal, handle: context.handle, uri: post, cid: "", text: text, replyTo: "", at: context.height}
def mentionReply(done: Done) -> Card.Reply:
  Card.Reply.done({action: "mention"})
def heard(state: State, routed: Card.Routed, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  match routed:
    case act(a): if a.action == "seen" then marked(state, Card.natural(a.fields, "at"), context, doneReply("seen")) else Card.answer(routed, context, forms(), render(state, context))
    case _: Card.answer(routed, context, forms(), render(state, context))
def line(event: Events.Event) -> Document.Document:
  Document.text("#{natText(event.at)} {event.kind} from {Card.shown(event.actor, event.handle, Card.stranger())}: {event.text}\n")
# What is new since the mark, oldest first, eight and a count.
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  let new = since(state)
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text("ENV of {Card.shown(state.owner, state.handle, context)}{Card.mine(state.owner, context)}: {natText(Lists.length(new))} new since #{natText(state.seen)}\n"), tail: if Card.reads(state.owner, context) then Card.clipped(Lists.map(new, line), 8n) else Document.Documents.nil()})})
