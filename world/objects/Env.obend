edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./Card.obend as Card
import ./Event.obend as Events
# One principal's senses (inkling's env, mimo's pub/sub): its id is env/<did> and its
# owner that DID. publish takes an event in and sends it to every subscriber; observe
# offers what is new since `seen` and changes nothing (observation must not consume);
# seen moves the mark, as its own turn with its own receipt.
record State:
  owner: String
  buffer: Lists.List<Events.Event>
  seen: Nat
  subscribers: Card.Observers
record Seed:
  owner: String
record Edits:
  buffer: Plans.Entries<Events.Event, {}>
  seen: Plans.Edit<Nat, {}>
  subscribers: Plans.Entries<Card.Observer, {}>
# Every send is {event}: a subscriber's method takes the event that happened.
record Told:
  event: Events.Event
type Plan = Plans.Plan<Edits, Told>
type Response = Plans.Response<State, {}>
# Only the owner writes the env. With the host's request.method this becomes
#   owner: request.method == "observe" or request.subject == new.owner
law owner: new.owner == request.subject
law mark: monotone(seen)
def defaultSeed() -> Seed:
  {owner: ""}
def seeded(seed: Seed) -> State:
  {owner: seed.owner, buffer: Lists.List::<Events.Event>.nil(), seen: 0n, subscribers: Card.Observers.nil()}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {buffer: Plans.Entries::<Events.Event, {}>.keep({}), seen: Plans.Edit::<Nat, {}>.keep({}), subscribers: Plans.Entries::<Card.Observer, {}>.keep({})}
sum Done:
  done: {count: Nat}
  refused: {reason: String}
def notOwner(state: State) -> Done:
  Done.refused({reason: textConcat("Only its owner writes this env; that is ", Card.handle(state.owner))})
# The buffer keeps the newest 64 events: a full buffer drops its oldest first.
def published<T>(state: State, event: Events.Event, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  if context.principal != state.owner then then(notOwner(state)) else if Lists.length::<Events.Event>(state.buffer) < 64n then taken::<T>(state, extend(event, {at: context.height}), then, context) else dropped::<T>(state, extend(event, {at: context.height}), then, context)
def dropped<T>(state: State, event: Events.Event, then: Done -> T, context: Abi.Context) -> Activity<Plan, Response, T>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {buffer: Plans.Entries::<Events.Event, {}>.remove({index: 0n})})})):
    case _: taken::<T>(state, event, then, context)
def taken<T>(state: State, event: Events.Event, then: Done -> T, context: Abi.Context) -> Activity<Plan, Response, T>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {buffer: Plans.Entries::<Events.Event, {}>.append({item: event})})})):
    case _: Card.broadcast::<Edits, Told, State, {}, T>(state.subscribers, {event: event}, 0n, fn(sent: Nat) -> T: then(Done.done({count: sent})))
def publish(state: State, input: Told, context: Abi.Context) -> Activity<Plan, Response, Done>:
  published::<Done>(state, input.event, context, fn(done: Done) -> Done: done)
def since(state: State) -> Lists.List<Events.Event>:
  Lists.filter::<Events.Event>(state.buffer, fn(event: Events.Event) -> Bool: event.at > state.seen)
# Offers what is new since the mark; writes nothing, so anyone may look.
def observe(state: State, context: Abi.Context) -> Activity<Plan, Response, Nat>:
  Card.tell::<Edits, Told, State, {}, Nat>(Lists.length::<Events.Event>(since(state)), render(state))
def marked<T>(state: State, at: Nat, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  if context.principal != state.owner then then(notOwner(state)) else if at < state.seen then then(Done.refused({reason: textConcat("Already seen through ", natText(state.seen))})) else markWritten::<T>(at, context, then)
def markWritten<T>(at: Nat, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {seen: Plans.Edit::<Nat, {}>.set({value: at})})})):
    case _: then(Done.done({count: at}))
def seen(state: State, input: {at: Nat}, context: Abi.Context) -> Activity<Plan, Response, Done>:
  marked::<Done>(state, input.at, context, fn(done: Done) -> Done: done)
def subscribe(state: State, input: Card.Observer, context: Abi.Context) -> Activity<Plan, Response, Done>:
  if context.principal != state.owner then notOwner(state) else changed(Card.observing(state.subscribers, input), context)
def unsubscribe(state: State, input: Card.Observer, context: Abi.Context) -> Activity<Plan, Response, Done>:
  if context.principal != state.owner then notOwner(state) else changed(Card.unobserving(state.subscribers, input), context)
def changed(change: Card.Change, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match change:
    case edit(e): subscribed(e.entries, e.count, context)
    case unchanged(u): Done.done({count: u.count})
    case refused(r): Done.refused({reason: r.reason})
def subscribed(entries: Plans.Entries<Card.Observer, {}>, count: Nat, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {subscribers: entries})})):
    case _: Done.done({count: count})
def forms() -> Card.Forms:
  Card.Forms.cons({head: {card: "", action: "observe", fields: Form.Fields.nil()}, tail: Card.Forms.cons({head: {card: "", action: "seen", fields: Form.Fields.cons({head: {name: "at", kind: Form.Kind.natural({min: 0n, max: 1000000000n})}, tail: Form.Fields.nil()})}, tail: Card.Forms.nil()})})
def door() -> Card.Door:
  {word: "env", blurb: "Your senses: what happened, since you last looked."}
def doneReply(action: String) -> Done -> Card.Reply:
  fn(done: Done) -> Card.Reply: Card.Reply.done({action: action})
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  heard(state, Card.route(input.text, context, forms()), context)
def heard(state: State, routed: Card.Routed, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  match routed:
    case act(a): if a.action == "seen" then marked::<Card.Reply>(state, Card.natural(a.fields, "at"), context, doneReply("seen")) else Card.answer::<Edits, Told, State, {}>(routed, context, forms(), render(state))
    case _: Card.answer::<Edits, Told, State, {}>(routed, context, forms(), render(state))
def line(event: Events.Event) -> Document.Document:
  Document.text(textConcat("#", textConcat(natText(event.at), textConcat(" ", textConcat(event.kind, textConcat(" from ", textConcat(Card.handle(event.actor), textConcat(": ", textConcat(event.text, "\n")))))))))
# What is new since the mark, oldest first, eight and a count.
def render(state: State) -> Document.Document:
  let new = since(state)
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text(textConcat("ENV of ", textConcat(Card.handle(state.owner), textConcat(": ", textConcat(natText(Lists.length::<Events.Event>(new)), textConcat(" new since #", textConcat(natText(state.seen), "\n"))))))), tail: Card.clipped(Lists.map::<Events.Event, Document.Document>(new, line), 8n)})})
