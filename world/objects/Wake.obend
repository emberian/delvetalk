edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Event.obend as Events
import ./Relation.obend as Relations
import ./Rows.obend as Rows
import ./Text.obend as Text
# mimo's reflex arc: an owner's triggers, each an event to match and an action to take.
# A trigger on an event subscribes the wake to its env's `buffer`, so every event the env
# takes in is delivered here (`changedSensed`); the owner may also hand one to `sense`. A
# matching trigger notifies the owner's Avatar (its id is the owner's DID), asks the Env to
# show itself, or calls a card. A trigger on another object's writes or rows subscribes the
# wake to that field, with the receiver of its type (`changedNat`, or one per row type of
# Rows.obend).
sum On:
  mention: {actor: String}
  keyword: {term: String}
  reply: {card: String}
  schedule: {every: Nat}
  writes: {object: String, field: String, above: Nat}
  rows: {object: String, field: String, where: Lists.List<Where>, atLeast: Nat}
# A rule's pattern (docs/RELATIONAL.md section 7, Realtalk's When) on one column of a row:
# equal to a value (canonical bytes, Relations.compare), a natural above or below a bound,
# or a text holding a whole word (textHasAny: maximal runs of letters and digits, ASCII
# compared lowercased). A trigger stored as data holds no closure, so a pattern is one of
# these; a rule needing a join or arithmetic is a layer over Wake with the predicate in code.
sum Where:
  equals: {column: String, equals: Relations.Cell}
  above: {column: String, above: Nat}
  below: {column: String, below: Nat}
  contains: {column: String, contains: String}
sum Action:
  notify: {}
  observe: {}
  call: {card: String, method: String}
record Trigger:
  id: Nat
  event: On
  action: Action
# handle: the owner's, as arrival seeds it, for the card.
record State:
  owner: String
  handle: String
  env: Plans.Reference
  triggers: Lists.List<Trigger>
  nextId: Nat
record Seed:
  owner: String
  handle: String
  env: Plans.Reference
record Edits:
  triggers: Plans.Entries<Trigger, {}>
  nextId: Plans.Edit<Nat, Nat>
# Every send carries a line of text: a note's text, or what woke the trigger.
# Only the owner changes its triggers, reprograms or amends it; as with Env, the creator
# must be the owner, so each principal creates their own Wake (docs/GENESIS.md).
law owner "only its owner writes it": request.subject == new.owner
law ids "trigger ids only count up": monotone(nextId)
# The two-tier law, in Bend (stubbed against Abi.Request until the host runs it): the
# triggers change only by the owner's request.
def law(old: State, new: State, request: Abi.Request) -> Abi.Verdict:
  if new.nextId == old.nextId && Lists.length(new.triggers) == Lists.length(old.triggers) || request.context.principal == old.owner then Abi.Verdict.admitted({}) else Abi.Verdict.refused({clause: "owner", reading: "Only its owner changes its triggers."})
def defaultSeed() -> Seed:
  {owner: "", handle: "", env: Plans.nobody()}
def seeded(seed: Seed) -> State:
  {owner: seed.owner, handle: seed.handle, env: if Plans.isNobody(seed.env) then {world: "", object: Events.envOf(seed.owner)} else seed.env, triggers: Lists.List.nil(), nextId: 1n}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {triggers: Plans.Entries.keep({}), nextId: Plans.Edit.keep({})}
sum Done:
  watching: {id: Nat}
  fired: {count: Nat}
  refused: Card.Refusal
# Why a wake refuses: each arm a clause, `why` its reading.
sum Why:
  notOwner: {owner: String}
  full: {}
  noTrigger: {id: Nat}
  early: {}
  noRows: {field: String}
  unwatched: {object: String, field: String, clause: String}
def why(w: Why) -> String:
  match w:
    case notOwner(n): "Only its owner sets these triggers; that is {n.owner}"
    case full(_): "Thirty-two triggers is the most a wake holds."
    case noTrigger(n): "No trigger {natText(n.id)}"
    case early(_): "The schedule was answered before its time."
    case noRows(n): "A wake reads no rows called {n.field} (it reads rains, buffer, greeted, proposals, traces and subs)."
    case unwatched(u): "{u.object}.{u.field} cannot be watched ({u.clause})."
def clause(w: Why) -> String:
  match w:
    case notOwner(_): "notOwner"
    case full(_): "full"
    case noTrigger(_): "noTrigger"
    case early(_): "early"
    case noRows(_): "noRows"
    case unwatched(_): "unwatched"
def refused(w: Why) -> Done:
  Done.refused({clause: clause(w), reading: why(w)})
# The helpers take the State after their own inputs: a definition whose first parameter is
# the State is a method any turn may run.
def notOwner(state: State) -> Done:
  refused(Why.notOwner({owner: Card.handle(state.owner)}))
# The receiver a subscription to a field names: the type of what the field holds.
def receiverFor(on: On) -> String:
  match on:
    case writes(_): "changedNat"
    case rows(r): rowsReceiver(r.field)
    case _: "changedSensed"
def rowsReceiver(field: String) -> String:
  if field == "rains" then "changedRains" else if field == "buffer" then "changedSensed" else if field == "greeted" then "changedGreetings" else if field == "proposals" then "changedProposals" else if field == "traces" then "changedTraces" else if field == "subs" then "changedSubscriptions" else ""
def watched(event: On, action: Action, context: Abi.Context, state: State) -> Activity<Done>:
  if context.principal != state.owner then notOwner(state) else if Lists.length(state.triggers) >= 32n then refused(Why.full({})) else subscribing(event, action, context, state)
# A trigger on writes or rows holds only when the subscription does: the subscription first,
# then the trigger. A trigger on an event subscribes to the env's buffer when the env is
# there (an event may also be handed to `sense`), and stands either way.
def subscribing(event: On, action: Action, context: Abi.Context, state: State) -> Activity<Done>:
  match event:
    case writes(w): watchedField(w.object, w.field, receiverFor(event), event, action, state)
    case rows(r): if receiverFor(event) == "" then refused(Why.noRows({field: r.field})) else watchedField(r.object, r.field, receiverFor(event), event, action, state)
    case schedule(_): added(event, action, state)
    case _: sensing(event, action, state)
def sensing(event: On, action: Action, state: State) -> Activity<Done>:
  match world.subscribe({object: state.env, field: "buffer", method: "changedSensed"}):
    case _: added(event, action, state)
def watchedField(object: String, field: String, receiver: String, event: On, action: Action, state: State) -> Activity<Done>:
  match world.subscribe({object: {world: "", object: object}, field: field, method: receiver}):
    case subscribed(_): added(event, action, state)
    case denied(_): refused(Why.unwatched({object: object, field: field, clause: "denied"}))
    case refused(r): refused(Why.unwatched({object: object, field: field, clause: r.clause}))
def added(event: On, action: Action, state: State) -> Activity<Done>:
  let written(_) = world.write::<Edits>({triggers: Plans.Entries.append({item: {id: state.nextId, event: event, action: action}}), nextId: Plans.Edit.add({delta: 1n})})
  Done.watching({id: state.nextId})
# What the host delivers after a watched scalar's write: its new value and its old. A trigger
# on that object and field fires when the value passes `above` (it was at most `above`
# before and is above it now); a call action is sent with nothing.
def changedNat(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Nat>, retracted: Lists.List<Nat>}, context: Abi.Context) -> Activity<Done>:
  if context.caller != input.object.object then Done.fired({count: 0n}) else passing(state.triggers, input.object.object, input.field, headOr(input.inserted), headOr(input.retracted), 0n, state)
def headOr(values: Lists.List<Nat>) -> Nat:
  match values:
    case nil(_): 0n
    case cons(c): c.head
def passes(on: On, object: String, field: String, value: Nat, was: Nat) -> Bool:
  match on:
    case writes(w): w.object == object && w.field == field && value > w.above && was <= w.above
    case _: false
def passing(triggers: Lists.List<Trigger>, object: String, field: String, value: Nat, was: Nat, count: Nat, state: State) -> Activity<Done>:
  match triggers:
    case nil(_): Done.fired({count: count})
    case cons(c): if passes(c.head.event, object, field, value, was) then passed(c.head.action, c.tail, object, field, value, was, count, state) else passing(c.tail, object, field, value, was, count, state)
def passed(action: Action, rest: Lists.List<Trigger>, object: String, field: String, value: Nat, was: Nat, count: Nat, state: State) -> Activity<Done>:
  match world.send({object: target(action, state), method: method(action), argument: passArgument(action, object, field, value)}):
    case _: passing(rest, object, field, value, was, count + 1n, state)
def passArgument(action: Action, object: String, field: String, value: Nat) -> Data:
  match action:
    case call(_): Plans.nothing()
    case _: {text: "{object}.{field} is {natText(value)}"}
# What the host delivers after a watched relation's write, one receiver per row type: the
# rows inserted, as columns. A rows trigger on that object and field fires once when at least
# `atLeast` (at least one) of the rows match every pattern; a call action is sent with
# nothing, any other the line. Rows the env took in are also events for the event triggers.
def changedRains(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Rain>, retracted: Lists.List<Rows.Rain>}, context: Abi.Context) -> Activity<Done>:
  delivered(input.object.object, input.field, Lists.map(input.inserted, Rows.rainColumns), Lists.List.nil(), context, state)
def changedGreetings(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Greeting>, retracted: Lists.List<Rows.Greeting>}, context: Abi.Context) -> Activity<Done>:
  delivered(input.object.object, input.field, Lists.map(input.inserted, Rows.greetingColumns), Lists.List.nil(), context, state)
def changedProposals(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Proposal>, retracted: Lists.List<Rows.Proposal>}, context: Abi.Context) -> Activity<Done>:
  delivered(input.object.object, input.field, Lists.map(input.inserted, Rows.proposalColumns), Lists.List.nil(), context, state)
def changedTraces(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Trace>, retracted: Lists.List<Rows.Trace>}, context: Abi.Context) -> Activity<Done>:
  delivered(input.object.object, input.field, Lists.map(input.inserted, Rows.traceColumns), Lists.List.nil(), context, state)
def changedSubscriptions(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Subscription>, retracted: Lists.List<Rows.Subscription>}, context: Abi.Context) -> Activity<Done>:
  delivered(input.object.object, input.field, Lists.map(input.inserted, Rows.subscriptionColumns), Lists.List.nil(), context, state)
def changedSensed(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Sensed>, retracted: Lists.List<Rows.Sensed>}, context: Abi.Context) -> Activity<Done>:
  delivered(input.object.object, input.field, Lists.map(input.inserted, Rows.sensedColumns), if input.object.object == state.env.object && input.field == "buffer" then input.inserted else Lists.List.nil(), context, state)
# Only the watched object's own change counts (the host runs the delivery with it as caller).
def delivered(object: String, field: String, rows: Lists.List<Rows.Columns>, events: Lists.List<Rows.Sensed>, context: Abi.Context, state: State) -> Activity<Done>:
  if context.caller != object then Done.fired({count: 0n}) else sensed(events, object, field, rows, 0n, state)
# Each event fires the event triggers it matches, then the rows triggers judge the rows.
def sensed(events: Lists.List<Rows.Sensed>, object: String, field: String, rows: Lists.List<Rows.Columns>, count: Nat, state: State) -> Activity<Done>:
  match events:
    case nil(_): ruled(state.triggers, object, field, rows, count, state)
    case cons(c): fire(state.triggers, c.head, c.tail, object, field, rows, count, state)
def ruled(triggers: Lists.List<Trigger>, object: String, field: String, rows: Lists.List<Rows.Columns>, count: Nat, state: State) -> Activity<Done>:
  match triggers:
    case nil(_): Done.fired({count: count})
    case cons(c): ruledBy(c.head, c.tail, object, field, rows, matched(c.head.event, object, field, rows), count, state)
def ruledBy(trigger: Trigger, rest: Lists.List<Trigger>, object: String, field: String, rows: Lists.List<Rows.Columns>, hits: Nat, count: Nat, state: State) -> Activity<Done>:
  if hits > 0n && hits >= least(trigger.event) then ruleFired(trigger.action, rest, object, field, rows, hits, count, state) else ruled(rest, object, field, rows, count, state)
def ruleFired(action: Action, rest: Lists.List<Trigger>, object: String, field: String, rows: Lists.List<Rows.Columns>, hits: Nat, count: Nat, state: State) -> Activity<Done>:
  match world.send({object: target(action, state), method: method(action), argument: ruleArgument(action, object, field, hits)}):
    case _: ruled(rest, object, field, rows, count + 1n, state)
def ruleArgument(action: Action, object: String, field: String, hits: Nat) -> Data:
  match action:
    case call(_): Plans.nothing()
    case _: {text: "{object}.{field}: {natText(hits)} new {if hits == 1n then \"row\" else \"rows\"} matched"}
def least(on: On) -> Nat:
  match on:
    case rows(r): r.atLeast
    case _: 1n
# How many of the rows match a rows trigger on this object and field (0 for any other).
def matched(on: On, object: String, field: String, rows: Lists.List<Rows.Columns>) -> Nat:
  match on:
    case rows(r): if r.object == object && r.field == field then Lists.length(Lists.filter(rows, fn(row: Rows.Columns) -> Bool: holds(row, r.where))) else 0n
    case _: 0n
def holds(row: Rows.Columns, where: Lists.List<Where>) -> Bool:
  Lists.any(where, fn(w: Where) -> Bool: Lists.any(row, fn(c: Rows.Column) -> Bool: c.column == whereColumn(w) && fits(c.value, w)) == false) == false
def whereColumn(w: Where) -> String:
  match w:
    case equals(e): e.column
    case above(a): a.column
    case below(b): b.column
    case contains(c): c.column
def fits(value: Relations.Cell, w: Where) -> Bool:
  match w:
    case equals(e): Relations.compare(value, e.equals) == 1n
    case above(a): natAbove(value, a.above)
    case below(b): natBelow(value, b.below)
    case contains(c): hasWord(value, c.contains)
def natAbove(value: Relations.Cell, bound: Nat) -> Bool:
  match value:
    case natural(n): n.value > bound
    case text(_): false
def natBelow(value: Relations.Cell, bound: Nat) -> Bool:
  match value:
    case natural(n): n.value < bound
    case text(_): false
def hasWord(value: Relations.Cell, word: String) -> Bool:
  match value:
    case text(t): textHasAny(t.value, Lists.List.cons({head: word, tail: Lists.List.nil({})}))
    case natural(_): false
def watch(state: State, input: {event: On, action: Action}, context: Abi.Context) -> Activity<Done>:
  watched(input.event, input.action, context, state)
# From a post: watch a mention or a keyword (the action is a note to you), or unwatch.
def mention(state: State, input: {actor: String}, context: Abi.Context) -> Activity<Done>:
  watched(On.mention({actor: input.actor}), Action.notify({}), context, state)
def keyword(state: State, input: {term: String}, context: Abi.Context) -> Activity<Done>:
  watched(On.keyword({term: input.term}), Action.notify({}), context, state)
# Unwatch by id: the trigger is found here, in Bend, and removed by its bytes.
def unwatch(state: State, input: {id: Nat}, context: Abi.Context) -> Activity<Done>:
  if context.principal != state.owner then notOwner(state) else removing(Lists.find(state.triggers, fn(t: Trigger) -> Bool: t.id == input.id), input.id)
def removing(found: Lists.Maybe<Trigger>, id: Nat) -> Activity<Done>:
  match found:
    case none(_): refused(Why.noTrigger({id: id}))
    case some(s): removed(s.value, id)
def removed(trigger: Trigger, id: Nat) -> Activity<Done>:
  let written(_) = write {triggers: removeItem trigger}
  Done.watching({id: id})
# A schedule is an await on a height: the turn suspends on a slot nobody settles, and
# when the clock passes `every` it resumes timedOut and acts. One firing per schedule
# turn; schedule again to wake again.
def schedule(state: State, input: {every: Nat, action: Action}, context: Abi.Context) -> Activity<Done>:
  if context.principal != state.owner then notOwner(state) else waited(input.every, input.action, context, state)
def waited(every: Nat, action: Action, context: Abi.Context, state: State) -> Activity<Done>:
  match world.await({slot: {principal: context.object, intent: "schedule/{context.intent}"}, patience: every}):
    case timedOut(_): act(action, "scheduled every {natText(every)}", state)
    case _: refused(Why.early({}))
# The event that woke a trigger, as a line.
def woke(event: Rows.Sensed) -> String:
  "{event.kind} from {Card.handle(event.actor)}: {event.text}"
def contains(text: String, term: String) -> Bool:
  if term == "" then false else found(text, term, textTake(term, 1n))
def found(text: String, term: String, first: String) -> Bool:
  let rest = textDrop(text, textBreak(text, first))
  if textLength(rest) < textLength(term) then false else if textTake(rest, textLength(term)) == term then true else found(textDrop(rest, 1n), term, first)
def matches(on: On, event: Rows.Sensed) -> Bool:
  match on:
    case mention(m): event.kind == "mention" && event.actor == m.actor
    case keyword(k): contains(event.text, k.term)
    case reply(r): event.kind == "reply" && event.replyTo == r.card
    case schedule(_): false
    case writes(_): false
    case rows(_): false
# Each matching trigger acts, in order, by explicit recursion (a send never sits in a
# lambda: an activity in a closure is refused); then the next event, then the rows triggers.
def fire(triggers: Lists.List<Trigger>, event: Rows.Sensed, events: Lists.List<Rows.Sensed>, object: String, field: String, rows: Lists.List<Rows.Columns>, count: Nat, state: State) -> Activity<Done>:
  match triggers:
    case nil(_): sensed(events, object, field, rows, count, state)
    case cons(c): if matches(c.head.event, event) then acted(c.head.action, c.tail, event, events, object, field, rows, count, state) else fire(c.tail, event, events, object, field, rows, count, state)
def acted(action: Action, rest: Lists.List<Trigger>, event: Rows.Sensed, events: Lists.List<Rows.Sensed>, object: String, field: String, rows: Lists.List<Rows.Columns>, count: Nat, state: State) -> Activity<Done>:
  match world.send({object: target(action, state), method: method(action), argument: {text: woke(event)}}):
    case _: fire(rest, event, events, object, field, rows, count + 1n, state)
def act(action: Action, text: String, state: State) -> Activity<Done>:
  match world.send({object: target(action, state), method: method(action), argument: {text: text}}):
    case _: Done.fired({count: 1n})
def target(action: Action, state: State) -> Plans.Reference:
  match action:
    case notify(_): {world: "", object: state.owner}
    case observe(_): state.env
    case call(c): {world: "", object: c.card}
def method(action: Action) -> String:
  match action:
    case notify(_): "note"
    case observe(_): "observe"
    case call(c): c.method
# The owner, in a direct turn, tells the wake what happened.
def sense(state: State, input: {event: Events.Event}, context: Abi.Context) -> Activity<Done>:
  if context.principal != state.owner then notOwner(state) else fire(state.triggers, {kind: input.event.kind, actor: input.event.actor, handle: input.event.handle, uri: input.event.uri, cid: input.event.cid, text: input.event.text, replyTo: input.event.replyTo, at: input.event.at, n: 0n}, Lists.List.nil(), "", "", Lists.List.nil(), 0n, state)
form mention:
  actor: text 1..128
form keyword:
  term: text 1..64
form unwatch:
  id: natural 1..1000000
def methods() -> Lists.List<String>:
  Text.words("watch sense schedule")
def forms() -> Card.Forms:
  Card.Forms.cons({head: mentionForm(), tail: Card.Forms.cons({head: keywordForm(), tail: Card.Forms.cons({head: unwatchForm(), tail: Card.Forms.nil()})})})
def blurb() -> Card.Door:
  {word: "wake", blurb: "Choose what wakes you: mentions, words, replies, a schedule."}
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
def onText(on: On) -> String:
  match on:
    case mention(m): "a mention by {Card.handle(m.actor)}"
    case keyword(k): "the word {k.term}"
    case reply(r): "a reply to {r.card}"
    case schedule(s): "every {natText(s.every)}"
    case writes(w): "{w.object}.{w.field} passing {natText(w.above)}"
    case rows(r): "{natText(r.atLeast)} new rows of {r.object}.{r.field}{wheres(r.where)}"
def wheres(where: Lists.List<Where>) -> String:
  if Lists.length(where) == 0n then "" else textConcat(" where ", textJoin(Lists.map(where, whereText), ", "))
def whereText(w: Where) -> String:
  match w:
    case equals(e): "{e.column} = {cellText(e.equals)}"
    case above(a): "{a.column} > {natText(a.above)}"
    case below(b): "{b.column} < {natText(b.below)}"
    case contains(c): "{c.column} has {c.contains}"
def cellText(cell: Relations.Cell) -> String:
  match cell:
    case natural(n): natText(n.value)
    case text(t): t.value
def actionText(action: Action) -> String:
  match action:
    case notify(_): "note me"
    case observe(_): "show my env"
    case call(c): "call {c.card} {c.method}"
def line(trigger: Trigger) -> Document.Document:
  Document.text("#{natText(trigger.id)} on {onText(trigger.event)}: {actionText(trigger.action)}\n")
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text("WAKE of {Card.shown(state.owner, state.handle, context)}{Card.mine(state.owner, context)}: {natText(Lists.length(state.triggers))} triggers\n"), tail: if Card.reads(state.owner, context) then Card.clipped(Lists.map(state.triggers, line), 8n) else Document.Documents.nil()})})
