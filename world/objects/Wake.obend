edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Event.obend as Events
import ./Relation.obend as Relations
import ./Rows.obend as Rows
import ./Text.obend as Text
# mimo's reflex arc: an owner's triggers, each an event to match and an action to take.
# A trigger on an event subscribes the wake to its env's `buffer`, so every event the env
# takes in is delivered here (`changedSensed`); the owner may also hand one to `sense`. A
# matching trigger notifies the owner's Avatar (its id is the owner's DID), asks the Env to
# show itself, or calls a card. A trigger on another object's writes or rows subscribes the
# wake to that field, with the receiver of its type (`changedNat`, `changedBool`, or one per
# row type of Rows.obend, or `things`, a record's references). `grows` fires on every rise of a
# natural field (a tide's `ticks`), `turns` when a flag becomes true; a bell's `rung` is a row of
# its `marks`, and what a garden grows a row of its `things`.
sum On:
  mention: {actor: String}
  keyword: {term: String}
  schedule: {at: Nat, every: Nat}
  writes: {object: String, field: String, above: Nat}
  grows: {object: String, field: String}
  turns: {object: String, field: String}
  rows: {object: String, field: String, where: Lists.List<Where>, atLeast: Nat}
# A rule's pattern (docs/RELATIONAL.md section 7, Realtalk's When) on one column of a row:
# equal to a value (canonical bytes, Relations.compare), a natural above or below a bound,
# or a text holding a whole word (textHasAny: maximal runs of letters and digits, ASCII
# compared lowercased). A trigger stored as data holds no closure, so a pattern is one of
# these; a rule needing a join or arithmetic is a layer over Wake with the predicate in code.
sum Where:
  equals: {column: String, equals: Relations.Cell}
  above: {column: String, above: Nat}
  below: {column: String, below: Nat}
  contains: {column: String, contains: String}
sum Action:
  notify: {}
  observe: {}
  call: {card: String, method: String}
# seen: the rows a rows trigger has counted toward its next firing (always below its count).
record Trigger:
  id: Nat
  event: On
  action: Action
  seen: Nat
# handle: the owner's, as arrival seeds it, for the card.
record State:
  owner: String
  handle: String
  env: Plans.Reference
  triggers: Lists.List<Trigger>
  nextId: Nat
# Only the owner changes its triggers, reprograms or amends it; as with Env, the creator
# must be the owner, so each principal creates their own Wake (docs/GENESIS.md).
law owner "the owner never changes, and only its owner writes it": unchanged(owner) and request.subject == new.owner
law ids "trigger numbers only count up": monotone(nextId)
def initial() -> State:
  {owner: "", handle: "", env: Plans.nobody(), triggers: Lists.List.nil(), nextId: 1n}
sum Done:
  watching: {id: Nat}
  fired: {count: Nat}
  refused: Card.Refusal
# Why a wake refuses: each arm a clause and its reading.
sum Why:
  notOwner: {owner: String}
  full: {}
  noTrigger: {id: Nat}
  early: {}
  schedulesFull: {}
  never: {}
  noRows: {field: String}
  unwatched: {object: String, field: String, clause: String}
  badWhere: {line: String}
def refusal(w: Why) -> Card.Refusal:
  match w:
    case badWhere(b): {clause: "badWhere", reading: "where is one line, column op value (op =, >, <, has): not {b.line}"}
    case notOwner(n): {clause: "notOwner", reading: "Only its owner sets these triggers; that is {n.owner}"}
    case full(_): {clause: "full", reading: "Thirty-two triggers is the most a wake holds."}
    case noTrigger(n): {clause: "noTrigger", reading: "No trigger {natText(n.id)}"}
    case early(_): {clause: "early", reading: "The schedule was answered before its time."}
    case schedulesFull(_): {clause: "schedulesFull", reading: "Eight standing schedules is the most a wake holds."}
    case never(_): {clause: "never", reading: "A schedule needs a time after now: at, or every from now."}
    case noRows(n): {clause: "noRows", reading: "A wake reads no rows called {n.field} (it reads lines, marks, buffer, greeted, presence, subs and things)."}
    case unwatched(u): {clause: "unwatched", reading: if u.clause == "denied" then "There is no card {u.object} that you may see (yet): nothing to watch." else "{u.object}.{u.field} cannot be watched ({u.clause})."}
def refused(w: Why) -> Done:
  Done.refused(refusal(w))
def notOwner(state: State) -> Done:
  refused(Why.notOwner({owner: Card.handle(state.owner)}))
# The receiver a subscription to a field names: the type of what the field holds.
def receiverFor(on: On) -> String:
  match on:
    case writes(_): "changedNat"
    case grows(_): "changedNat"
    case turns(_): "changedBool"
    case rows(r): rowsReceiver(r.field)
    case _: "changedSensed"
def rowsReceiver(field: String) -> String:
  if field == "lines" then "changedLines" else if field == "marks" then "changedMarks" else if field == "buffer" then "changedSensed" else if field == "greeted" then "changedGreetings" else if field == "presence" then "changedPresence" else if field == "subs" then "changedSubscriptions" else if field == "things" then "changedThings" else ""
def watched(event: On, action: Action, context: Abi.Context, state: State) -> Activity<Done>:
  if context.principal != state.owner then notOwner(state) else if Lists.length(state.triggers) >= 32n then refused(Why.full({})) else subscribing(event, action, context, state)
# A trigger on writes or rows holds only when the subscription does: the subscription first,
# then the trigger. A trigger on an event subscribes to the env's buffer when the env is
# there (an event may also be handed to `sense`), and stands either way.
def subscribing(event: On, action: Action, context: Abi.Context, state: State) -> Activity<Done>:
  match event:
    case writes(w): watchedField(w.object, w.field, receiverFor(event), event, action, state)
    case grows(g): watchedField(g.object, g.field, receiverFor(event), event, action, state)
    case turns(t): watchedField(t.object, t.field, receiverFor(event), event, action, state)
    case rows(r): if receiverFor(event) == "" then refused(Why.noRows({field: r.field})) else watchedField(r.object, r.field, receiverFor(event), event, action, state)
    case schedule(s): scheduling(s.at, s.every, action, context, state)
    case _: sensing(event, action, state)
def sensing(event: On, action: Action, state: State) -> Activity<Done>:
  match world.subscribe({object: state.env, field: "buffer", method: "changedSensed"}):
    case _: added(event, action, state)
def watchedField(object: String, field: String, receiver: String, event: On, action: Action, state: State) -> Activity<Done>:
  match world.subscribe({object: {world: "", object: object}, field: field, method: receiver}):
    case subscribed(_): added(event, action, state)
    case denied(_): refused(Why.unwatched({object: object, field: field, clause: "denied"}))
    case refused(r): refused(Why.unwatched({object: object, field: field, clause: r.clause}))
def added(event: On, action: Action, state: State) -> Activity<Done>:
  let written(_) = write {triggers: append {id: state.nextId, event: event, action: action, seen: 0n}, nextId: add 1n}
  Done.watching({id: state.nextId})
# What the host delivers after a watched scalar's write: its new value and its old. A trigger
# on that object and field fires when the value passes `above` (it was at most `above`
# before and is above it now); a call action is sent with nothing.
def changedNat(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Nat>, retracted: Lists.List<Nat>}, context: Abi.Context) -> Activity<Done>:
  if context.caller != input.object.object then Done.fired({count: 0n}) else passing(state.triggers, input.object.object, input.field, headOr(input.inserted), headOr(input.retracted), 0n, state)
def headOr(values: Lists.List<Nat>) -> Nat:
  match values:
    case nil(_): 0n
    case cons(c): c.head
def passes(on: On, object: String, field: String, value: Nat, was: Nat) -> Bool:
  match on:
    case writes(w): w.object == object && w.field == field && value > w.above && was <= w.above
    case grows(g): g.object == object && g.field == field && value > was
    case _: false
def passing(triggers: Lists.List<Trigger>, object: String, field: String, value: Nat, was: Nat, count: Nat, state: State) -> Activity<Done>:
  match triggers:
    case nil(_): Done.fired({count: count})
    case cons(c): if passes(c.head.event, object, field, value, was) then passed(c.head.action, c.tail, object, field, value, was, count, state) else passing(c.tail, object, field, value, was, count, state)
def passed(action: Action, rest: Lists.List<Trigger>, object: String, field: String, value: Nat, was: Nat, count: Nat, state: State) -> Activity<Done>:
  match world.send({object: target(action, state), method: method(action), argument: passArgument(action, object, field, value)}):
    case _: passing(rest, object, field, value, was, count + 1n, state)
def passArgument(action: Action, object: String, field: String, value: Nat) -> Data:
  match action:
    case call(_): Plans.nothing()
    case _: {text: "{object}.{field} is {natText(value)}"}
# What the host delivers after a watched flag's write: a `turns` trigger on it fires when it
# was false and is true now.
def changedBool(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Bool>, retracted: Lists.List<Bool>}, context: Abi.Context) -> Activity<Done>:
  if context.caller != input.object.object then Done.fired({count: 0n}) else turning(state.triggers, input.object.object, input.field, Lists.any(input.inserted, fn(b: Bool) -> Bool: b), Lists.any(input.retracted, fn(b: Bool) -> Bool: b), 0n, state)
def turned(on: On, object: String, field: String) -> Bool:
  match on:
    case turns(t): t.object == object && t.field == field
    case _: false
def turning(triggers: Lists.List<Trigger>, object: String, field: String, now: Bool, was: Bool, count: Nat, state: State) -> Activity<Done>:
  match triggers:
    case nil(_): Done.fired({count: count})
    case cons(c): if now && was == false && turned(c.head.event, object, field) then turnFired(c.head.action, c.tail, object, field, count, state) else turning(c.tail, object, field, now, was, count, state)
def turnFired(action: Action, rest: Lists.List<Trigger>, object: String, field: String, count: Nat, state: State) -> Activity<Done>:
  match world.send({object: target(action, state), method: method(action), argument: turnArgument(action, object, field)}):
    case _: turning(rest, object, field, true, false, count + 1n, state)
def turnArgument(action: Action, object: String, field: String) -> Data:
  match action:
    case call(_): Plans.nothing()
    case _: {text: "{object}.{field} turned true"}
# What the host delivers after a watched relation's write, one receiver per row type: the
# rows inserted, as columns. A rows trigger on that object and field counts the rows that
# match every pattern across deliveries and fires when the count reaches `atLeast` (see
# `tallied`); a call action is sent with nothing, any other the line. Rows the env took in are also events for the event triggers.
def changedLines(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Line>, retracted: Lists.List<Rows.Line>}, context: Abi.Context) -> Activity<Done>:
  delivered(input.object.object, input.field, Lists.map(input.inserted, Rows.lineColumns), Lists.List.nil(), context, state)
def changedMarks(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Mark>, retracted: Lists.List<Rows.Mark>}, context: Abi.Context) -> Activity<Done>:
  delivered(input.object.object, input.field, Lists.map(input.inserted, Rows.markColumns), Lists.List.nil(), context, state)
def changedGreetings(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Greeting>, retracted: Lists.List<Rows.Greeting>}, context: Abi.Context) -> Activity<Done>:
  delivered(input.object.object, input.field, Lists.map(input.inserted, Rows.greetingColumns), Lists.List.nil(), context, state)
def changedPresence(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Presence>, retracted: Lists.List<Rows.Presence>}, context: Abi.Context) -> Activity<Done>:
  delivered(input.object.object, input.field, Lists.map(input.inserted, Rows.presenceColumns), Lists.List.nil(), context, state)
def changedSubscriptions(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Subscription>, retracted: Lists.List<Rows.Subscription>}, context: Abi.Context) -> Activity<Done>:
  delivered(input.object.object, input.field, Lists.map(input.inserted, Rows.subscriptionColumns), Lists.List.nil(), context, state)
def changedThings(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Plans.Reference>, retracted: Lists.List<Plans.Reference>}, context: Abi.Context) -> Activity<Done>:
  delivered(input.object.object, input.field, Lists.map(input.inserted, fn(r: Plans.Reference) -> Rows.Columns: Rows.one(Rows.text("object", r.object), Rows.none())), Lists.List.nil(), context, state)
def changedSensed(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Events.Event>, retracted: Lists.List<Events.Event>}, context: Abi.Context) -> Activity<Done>:
  delivered(input.object.object, input.field, Lists.map(input.inserted, Rows.sensedColumns), if input.object.object == state.env.object && input.field == "buffer" then input.inserted else Lists.List.nil(), context, state)
# Only the watched object's own change counts (the host runs the delivery with it as caller).
def delivered(object: String, field: String, rows: Lists.List<Rows.Columns>, events: Lists.List<Events.Event>, context: Abi.Context, state: State) -> Activity<Done>:
  if context.caller != object then Done.fired({count: 0n}) else sensed(events, object, field, rows, 0n, state)
# Each event fires the event triggers it matches, then the rows triggers judge the rows.
def sensed(events: Lists.List<Events.Event>, object: String, field: String, rows: Lists.List<Rows.Columns>, count: Nat, state: State) -> Activity<Done>:
  match events:
    case nil(_): ruled(state.triggers, object, field, rows, count, state)
    case cons(c): fire(state.triggers, c.head, c.tail, object, field, rows, count, state)
def ruled(triggers: Lists.List<Trigger>, object: String, field: String, rows: Lists.List<Rows.Columns>, count: Nat, state: State) -> Activity<Done>:
  match triggers:
    case nil(_): Done.fired({count: count})
    case cons(c): ruledBy(c.head, c.tail, object, field, rows, matched(c.head.event, object, field, rows), count, state)
def ruledBy(trigger: Trigger, rest: Lists.List<Trigger>, object: String, field: String, rows: Lists.List<Rows.Columns>, hits: Nat, count: Nat, state: State) -> Activity<Done>:
  if hits == 0n then ruled(rest, object, field, rows, count, state) else tallied(trigger, rest, object, field, rows, trigger.seen + hits, count, state)
# The running count of a rows trigger: the rows matched across deliveries since it last fired.
# At `atLeast` it fires once, with all it has counted, and keeps the remainder toward the next
# firing, so a delivery that carries several counts' worth fires once and the rest carries over;
# `atLeast` 1 fires on every matching delivery and keeps nothing.
def tallied(trigger: Trigger, rest: Lists.List<Trigger>, object: String, field: String, rows: Lists.List<Rows.Columns>, total: Nat, count: Nat, state: State) -> Activity<Done>:
  if carried(trigger.event, total) == trigger.seen then judged(trigger, rest, object, field, rows, total, count, state) else remembered(trigger, rest, object, field, rows, total, count, state)
def remembered(trigger: Trigger, rest: Lists.List<Trigger>, object: String, field: String, rows: Lists.List<Rows.Columns>, total: Nat, count: Nat, state: State) -> Activity<Done>:
  let written(_) = write {triggers: amend trigger with extend(trigger, {seen: carried(trigger.event, total)})}
  judged(trigger, rest, object, field, rows, total, count, state)
def judged(trigger: Trigger, rest: Lists.List<Trigger>, object: String, field: String, rows: Lists.List<Rows.Columns>, total: Nat, count: Nat, state: State) -> Activity<Done>:
  if total >= least(trigger.event) then ruleFired(trigger.action, rest, object, field, rows, total, count, state) else ruled(rest, object, field, rows, count, state)
def carried(on: On, total: Nat) -> Nat:
  if total >= least(on) then total % least(on) else total
def ruleFired(action: Action, rest: Lists.List<Trigger>, object: String, field: String, rows: Lists.List<Rows.Columns>, hits: Nat, count: Nat, state: State) -> Activity<Done>:
  match world.send({object: target(action, state), method: method(action), argument: ruleArgument(action, object, field, hits)}):
    case _: ruled(rest, object, field, rows, count + 1n, state)
def ruleArgument(action: Action, object: String, field: String, hits: Nat) -> Data:
  match action:
    case call(_): Plans.nothing()
    case _: {text: "{object}.{field}: {natText(hits)} new {if hits == 1n then \"row\" else \"rows\"} matched"}
def least(on: On) -> Nat:
  match on:
    case rows(r): if r.atLeast == 0n then 1n else r.atLeast
    case _: 1n
# How many of the rows match a rows trigger on this object and field (0 for any other).
def matched(on: On, object: String, field: String, rows: Lists.List<Rows.Columns>) -> Nat:
  match on:
    case rows(r): if r.object == object && r.field == field then Lists.length(Lists.filter(rows, fn(row: Rows.Columns) -> Bool: holds(row, r.where))) else 0n
    case _: 0n
def holds(row: Rows.Columns, where: Lists.List<Where>) -> Bool:
  Lists.any(where, fn(w: Where) -> Bool: Lists.any(row, fn(c: Rows.Column) -> Bool: c.column == whereColumn(w) && fits(c.value, w)) == false) == false
def whereColumn(w: Where) -> String:
  match w:
    case equals(e): e.column
    case above(a): a.column
    case below(b): b.column
    case contains(c): c.column
def fits(value: Relations.Cell, w: Where) -> Bool:
  match w:
    case equals(e): Relations.compare(value, e.equals) == 1n
    case above(a): natAbove(value, a.above)
    case below(b): natBelow(value, b.below)
    case contains(c): hasWord(value, c.contains)
def natAbove(value: Relations.Cell, bound: Nat) -> Bool:
  match value:
    case natural(n): n.value > bound
    case text(_): false
def natBelow(value: Relations.Cell, bound: Nat) -> Bool:
  match value:
    case natural(n): n.value < bound
    case text(_): false
def hasWord(value: Relations.Cell, word: String) -> Bool:
  match value:
    case text(t): textHasAny(t.value, Lists.List.cons({head: word, tail: Lists.List.nil({})}))
    case natural(_): false
def watch(state: State, input: {event: On, action: Action}, context: Abi.Context) -> Activity<Done>:
  watched(input.event, input.action, context, state)
# A newcomer's own first turn (world-arrive runs it): be told of every thing the garden grows
# (a row of its `things`). A wake that already has that trigger keeps the one it has; without a
# garden the subscription is refused by name and nothing is written.
def arrived(state: State, input: {}, context: Abi.Context) -> Activity<Done>:
  match Lists.find(state.triggers, fn(t: Trigger) -> Bool: plantings(t.event)):
    case some(s): Done.watching({id: s.value.id})
    case none(_): watched(On.rows({object: "garden", field: "things", where: Lists.List.nil(), atLeast: 1n}), Action.notify({}), context, state)
def plantings(on: On) -> Bool:
  match on:
    case rows(r): r.object == "garden" && r.field == "things"
    case _: false
# A bell its kind finishes asks its planter's wake this (bell body `made`): be told when it rings
# (its `rung` mark).
def watchBell(state: State, input: {bell: String}, context: Abi.Context) -> Activity<Done>:
  watched(On.rows({object: input.bell, field: "marks", where: Lists.List.cons({head: Where.equals({column: "name", equals: Relations.text("rung")}), tail: Lists.List.nil()}), atLeast: 1n}), Action.notify({}), context, state)
# From a post: watch a mention or a keyword (the action is a note to you), or unwatch.
def mention(state: State, input: {actor: String}, context: Abi.Context) -> Activity<Done>:
  spelled(On.mention({actor: input.actor}), context, state)
def keyword(state: State, input: {term: String}, context: Abi.Context) -> Activity<Done>:
  spelled(On.keyword({term: input.term}), context, state)
# From a post, on another card's field (docs/GROUND.md §6 change 5): a number passing a mark, a
# number rising, a flag turning true, or rows arriving, those `where` one `column op value` line
# admits (`name = rung`, `n > 6`, `n < 3`, `text has moth`; blank for every row), `count` of them
# (field names are read folded, so a form's are lower case); a reminder at a
# clock, and every so many minutes after (0: once). Each notes the owner's avatar.
def writes(state: State, input: WritesInput, context: Abi.Context) -> Activity<Done>:
  spelled(On.writes({object: input.object, field: input.field, above: input.above}), context, state)
def grows(state: State, input: GrowsInput, context: Abi.Context) -> Activity<Done>:
  spelled(On.grows({object: input.object, field: input.field}), context, state)
def turns(state: State, input: TurnsInput, context: Abi.Context) -> Activity<Done>:
  spelled(On.turns({object: input.object, field: input.field}), context, state)
def rows(state: State, input: RowsInput, context: Abi.Context) -> Activity<Done>:
  match whereOf(input.where):
    case some(w): spelled(On.rows({object: input.object, field: input.field, where: w.value, atLeast: input.count}), context, state)
    case none(_): refused(Why.badWhere({line: input.where}))
def remind(state: State, input: RemindInput, context: Abi.Context) -> Activity<Done>:
  match schedule(state, {at: input.at, every: input.every, action: Action.notify({})}, context):
    case watching(w): noted(Done.watching(w), On.schedule({at: input.at, every: input.every}))
    case refused(r): declined(Done.refused(r))
    case fired(f): Done.fired(f)
# A spell that sets a trigger notes the owner's avatar, answers the watch it made and how to end
# it; a refusal says so with its reading.
def spelled(event: On, context: Abi.Context, state: State) -> Activity<Done>:
  match watched(event, Action.notify({}), context, state):
    case watching(w): noted(Done.watching(w), event)
    case refused(r): declined(Done.refused(r))
    case fired(f): Done.fired(f)
def noted(done: Done, event: On) -> Activity<Done>:
  match done:
    case watching(w): Card.tell(done, Document.text("Watching {watchText(event)}. Stop: delvetalk wake unwatch / id: {natText(w.id)}.\n"))
    case _: done
def declined(done: Done) -> Activity<Done>:
  match done:
    case refused(r): Card.tell(done, Document.text("Not done: {r.reading}\n"))
    case _: done
def watchText(event: On) -> String:
  match event:
    case mention(m): "mentions by {Card.handle(m.actor)}: each notes your avatar"
    case keyword(k): "the word {k.term}: each post with it notes your avatar"
    case schedule(_): "the clock, {onText(event, 0n)}: each notes your avatar"
    case writes(w): "{w.object}'s {w.field}: passing {natText(w.above)} notes your avatar"
    case grows(g): "{g.object}'s {g.field}: each rise notes your avatar"
    case turns(t): "{t.object}'s {t.field}: turning true notes your avatar"
    case rows(r): "{r.object}'s {r.field}{wheres(r.where)}: {rowsWatch(r.atLeast)}"
def rowsWatch(count: Nat) -> String:
  if count <= 1n then "each new row notes your avatar" else "0 of {natText(count)} rows; at {natText(count)} your avatar is noted, then at every {natText(count)} more"
# One `column op value` line as patterns: blank is none; `=` equals (digits a number, else a
# text), `>` above and `<` below a number, `has` a whole word. Anything else is no pattern.
def whereOf(line: String) -> Lists.Maybe<Lists.List<Where>>:
  let words = Text.words(line)
  if Text.blank(line) then Lists.Maybe.some({value: Lists.List.nil()}) else if Lists.length(words) < 3n then Lists.Maybe.none({}) else whereFrom(wordAt(words, 0n), wordAt(words, 1n), textJoin(afterTwo(words), " "))
def afterTwo(words: Lists.List<String>) -> Lists.List<String>:
  match words:
    case nil(_): words
    case cons(c): afterOne(c.tail)
def afterOne(words: Lists.List<String>) -> Lists.List<String>:
  match words:
    case nil(_): words
    case cons(c): c.tail
def wordAt(words: Lists.List<String>, n: Nat) -> String:
  match Lists.at(words, n):
    case some(w): w.value
    case none(_): ""
def whereFrom(column: String, op: String, value: String) -> Lists.Maybe<Lists.List<Where>>:
  if op == "=" then oneWhere(Where.equals({column: column, equals: cellOf(value)})) else if op == "has" then oneWhere(Where.contains({column: column, contains: value})) else numberWhere(column, op, Text.number(value))
def numberWhere(column: String, op: String, number: Text.Number) -> Lists.Maybe<Lists.List<Where>>:
  match number:
    case yes(n): if op == ">" then oneWhere(Where.above({column: column, above: n.value})) else if op == "<" then oneWhere(Where.below({column: column, below: n.value})) else Lists.Maybe.none({})
    case no(_): Lists.Maybe.none({})
def oneWhere(w: Where) -> Lists.Maybe<Lists.List<Where>>:
  Lists.Maybe.some({value: Lists.List.cons({head: w, tail: Lists.List.nil()})})
def cellOf(value: String) -> Relations.Cell:
  match Text.number(value):
    case yes(n): Relations.nat(n.value)
    case no(_): Relations.text(value)
# Unwatch by id: the trigger is found here, in Bend, and removed by its bytes.
def unwatch(state: State, input: {id: Nat}, context: Abi.Context) -> Activity<Done>:
  if context.principal != state.owner then declined(notOwner(state)) else removing(Lists.find(state.triggers, fn(t: Trigger) -> Bool: t.id == input.id), input.id)
def removing(found: Lists.Maybe<Trigger>, id: Nat) -> Activity<Done>:
  match found:
    case none(_): declined(refused(Why.noTrigger({id: id})))
    case some(s): removed(s.value, id)
def removed(trigger: Trigger, id: Nat) -> Activity<Done>:
  let written(_) = write {triggers: removeItem trigger}
  Card.tell(Done.watching({id: id}), Document.text("Trigger {natText(id)} is gone. See what remains: delvetalk wake ?\n"))
# A schedule fires at clock `at` (or `every` minutes from now when `at` is past) and again
# every `every` minutes after (0: once). It stands as a trigger, at most eight of them, and
# unwatch ends it. Each firing is its own turn: the wake sends itself `due {id, at}`, which
# awaits the clock on a slot nobody settles, acts, and sends the next `due`; a once schedule's
# next `due` (at 0) removes its trigger. A turn that only waits writes nothing, so a resumed
# firing never meets a stale root.
def schedule(state: State, input: {at: Nat, every: Nat, action: Action}, context: Abi.Context) -> Activity<Done>:
  if context.principal != state.owner then notOwner(state) else scheduling(input.at, input.every, input.action, context, state)
def scheduling(at: Nat, every: Nat, action: Action, context: Abi.Context, state: State) -> Activity<Done>:
  if Lists.length(Lists.filter(state.triggers, fn(t: Trigger) -> Bool: isSchedule(t.event))) >= 8n then refused(Why.schedulesFull({})) else if firstAt(at, every, context.clock) <= context.clock then refused(Why.never({})) else standing(firstAt(at, every, context.clock), every, action, context, state)
def firstAt(at: Nat, every: Nat, clock: Nat) -> Nat:
  if at > clock then at else clock + every
def isSchedule(on: On) -> Bool:
  match on:
    case schedule(_): true
    case _: false
def standing(at: Nat, every: Nat, action: Action, context: Abi.Context, state: State) -> Activity<Done>:
  let written(_) = write {triggers: append {id: state.nextId, event: On.schedule({at: at, every: every}), action: action, seen: 0n}, nextId: add 1n}
  match world.send({object: Plans.self(context), method: "due", argument: {id: state.nextId, at: at}}):
    case _: Done.watching({id: state.nextId})
def due(state: State, input: {id: Nat, at: Nat}, context: Abi.Context) -> Activity<Done>:
  if context.caller != context.object then Done.fired({count: 0n}) else dueTrigger(Lists.find(state.triggers, fn(t: Trigger) -> Bool: t.id == input.id), input.at, context, state)
def dueTrigger(found: Lists.Maybe<Trigger>, at: Nat, context: Abi.Context, state: State) -> Activity<Done>:
  match found:
    case none(_): Done.fired({count: 0n})
    case some(s): if at == 0n then ended(s.value) else waited(s.value, nextAt(at, everyOf(s.value.event), context.clock), context, state)
# A `due` whose time the clock has already passed (the clock jumped: transport's is wall
# minutes) waits a period from now; missed firings are not made up. A resumed turn sees the
# clock of its start, so this is judged here, in the fresh `due` turn.
def nextAt(at: Nat, every: Nat, clock: Nat) -> Nat:
  if at > clock then at else clock + every
def ended(trigger: Trigger) -> Activity<Done>:
  let written(_) = write {triggers: removeItem trigger}
  Done.fired({count: 0n})
def waited(trigger: Trigger, at: Nat, context: Abi.Context, state: State) -> Activity<Done>:
  match world.awaitUntil({slot: {principal: context.object, intent: "schedule/{context.intent}"}, until: at}):
    case timedOut(_): standsStill(trigger, at, context, state)
    case _: refused(Why.early({}))
# The wait read the wake as it was; an unwatch since then ends the schedule here.
def standsStill(trigger: Trigger, at: Nat, context: Abi.Context, state: State) -> Activity<Done>:
  match world.view::<State>({object: Plans.self(context)}):
    case viewed(v): if Lists.any(v.state.triggers, fn(t: Trigger) -> Bool: t.id == trigger.id) then firing(trigger, at, context, state) else Done.fired({count: 0n})
    case _: Done.fired({count: 0n})
def firing(trigger: Trigger, at: Nat, context: Abi.Context, state: State) -> Activity<Done>:
  match world.send({object: target(trigger.action, state), method: method(trigger.action), argument: if isCall(trigger.action) then Plans.nothing() else {text: "scheduled at {natText(at)}"}}):
    case _: rearmed(trigger, if everyOf(trigger.event) == 0n then 0n else at + everyOf(trigger.event), context)
def rearmed(trigger: Trigger, next: Nat, context: Abi.Context) -> Activity<Done>:
  match world.send({object: Plans.self(context), method: "due", argument: {id: trigger.id, at: next}}):
    case _: Done.fired({count: 1n})
def everyOf(on: On) -> Nat:
  match on:
    case schedule(s): s.every
    case _: 0n
def isCall(action: Action) -> Bool:
  match action:
    case call(_): true
    case _: false
# The event that woke a trigger, as a line.
def woke(event: Events.Event) -> String:
  "{event.kind} from {Card.handle(event.actor)}: {event.text}"
def matches(on: On, event: Events.Event) -> Bool:
  match on:
    case mention(m): event.kind == "mention" && event.actor == m.actor
    case keyword(k): Text.contains(event.text, k.term)
    case schedule(_): false
    case writes(_): false
    case grows(_): false
    case turns(_): false
    case rows(_): false
# Each matching trigger acts, in order, by explicit recursion (a send never sits in a
# lambda: an activity in a closure is refused); then the next event, then the rows triggers.
def fire(triggers: Lists.List<Trigger>, event: Events.Event, events: Lists.List<Events.Event>, object: String, field: String, rows: Lists.List<Rows.Columns>, count: Nat, state: State) -> Activity<Done>:
  match triggers:
    case nil(_): sensed(events, object, field, rows, count, state)
    case cons(c): if matches(c.head.event, event) then acted(c.head.action, c.tail, event, events, object, field, rows, count, state) else fire(c.tail, event, events, object, field, rows, count, state)
def acted(action: Action, rest: Lists.List<Trigger>, event: Events.Event, events: Lists.List<Events.Event>, object: String, field: String, rows: Lists.List<Rows.Columns>, count: Nat, state: State) -> Activity<Done>:
  match world.send({object: target(action, state), method: method(action), argument: {text: woke(event)}}):
    case _: fire(rest, event, events, object, field, rows, count + 1n, state)
def target(action: Action, state: State) -> Plans.Reference:
  match action:
    case notify(_): {world: "", object: state.owner}
    case observe(_): state.env
    case call(c): {world: "", object: c.card}
def method(action: Action) -> String:
  match action:
    case notify(_): "note"
    case observe(_): "observe"
    case call(c): c.method
# The owner, in a direct turn, tells the wake what happened.
def sense(state: State, input: {event: Events.Event}, context: Abi.Context) -> Activity<Done>:
  if context.principal != state.owner then notOwner(state) else fire(state.triggers, input.event, Lists.List.nil(), "", "", Lists.List.nil(), 0n, state)
form mention:
  actor: text 1..128
form keyword:
  term: text 1..64
form unwatch:
  id: natural 1..1000000
form writes:
  object: text 1..128
  field: text 1..64
  above: natural 0..1000000000
form grows:
  object: text 1..128
  field: text 1..64
form turns:
  object: text 1..128
  field: text 1..64
form rows:
  object: text 1..128
  field: text 1..64
  where: text 0..200
  count: natural 1..4096
form remind:
  at: natural 0..1000000000
  every: natural 0..10080
def methods() -> Lists.List<String>:
  Text.words("watch sense schedule ~arrived ~watchBell ~due")
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
def onText(on: On, seen: Nat) -> String:
  match on:
    case mention(m): "a mention by {Card.handle(m.actor)}"
    case keyword(k): "the word {k.term}"
    case schedule(s): if s.every == 0n then "once at {natText(s.at)}" else "every {natText(s.every)} from {natText(s.at)}"
    case writes(w): "{w.object}.{w.field} passing {natText(w.above)}"
    case grows(g): "each rise of {g.object}.{g.field}"
    case turns(t): "{t.object}.{t.field} turning true"
    case rows(r): "{if r.atLeast > 1n then \"{natText(seen)} of \" else \"\"}{natText(r.atLeast)} new rows of {r.object}.{r.field}{wheres(r.where)}"
def wheres(where: Lists.List<Where>) -> String:
  if Lists.length(where) == 0n then "" else textConcat(" where ", textJoin(Lists.map(where, whereText), ", "))
def whereText(w: Where) -> String:
  match w:
    case equals(e): "{e.column} = {cellText(e.equals)}"
    case above(a): "{a.column} > {natText(a.above)}"
    case below(b): "{b.column} < {natText(b.below)}"
    case contains(c): "{c.column} has {c.contains}"
def cellText(cell: Relations.Cell) -> String:
  match cell:
    case natural(n): natText(n.value)
    case text(t): t.value
def actionText(action: Action) -> String:
  match action:
    case notify(_): "note me"
    case observe(_): "show my env"
    case call(c): "call {c.card} {c.method}"
def line(trigger: Trigger) -> Document.Document:
  Document.text("#{natText(trigger.id)} on {onText(trigger.event, trigger.seen)}: {actionText(trigger.action)}\n")
def render(state: State, context: Abi.Context) -> Document.Document:
  let how = if Card.reads(state.owner, context) then " Add: delvetalk wake mention / actor: <handle>, or delvetalk wake keyword / term: <word>; rows, writes, grows, turns and remind are on ?. Remove: delvetalk wake unwatch / id: <number>." else ""
  let head = Document.text("WAKE of {Card.shown(state.owner, state.handle, context)}{Card.mine(state.owner, context)}: {natText(Lists.length(state.triggers))} triggers.{how}\n")
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: if Card.reads(state.owner, context) then Card.clippedWithin(Lists.map(state.triggers, line), 8n, Card.left(context, Document.size(head))) else Document.Documents.nil()})})
