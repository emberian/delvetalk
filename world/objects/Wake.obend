edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./Card.obend as Card
import ./Event.obend as Events
import ./Relation.obend as Relations
# mimo's reflex arc: an owner's triggers, each an event to match and an action to take.
# The owner's Env sends every event to `sense`; a matching trigger notifies the owner's
# Avatar (its id is the owner's DID), asks the Env to show itself, or calls a card.
# The universal message is receive {text, post}, so the Env's deliveries arrive at
# sense {event} (the town's sketch named it receive).
sum On:
  mention: {actor: String}
  keyword: {term: String}
  reply: {card: String}
  schedule: {every: Nat}
  writes: {object: String, field: String, above: Nat}
  rows: {object: String, field: String, where: Lists.List<Where>, atLeast: Nat}
# A rule's pattern (docs/RELATIONAL.md section 7, Realtalk's When): a column equal to a
# value, compared as canonical bytes order them (Relations.compare). A trigger stored as
# data holds no closure, so a pattern is equalities; a rule needing a join or arithmetic is
# a layer over Wake with the predicate in code.
record Where:
  column: String
  equals: Relations.Cell
sum Action:
  notify: {}
  observe: {}
  call: {card: String, method: String}
record Trigger:
  id: Nat
  event: On
  action: Action
# handle: the owner's, as arrival seeds it, for the card.
record State:
  owner: String
  handle: String
  env: Plans.Reference
  triggers: Lists.List<Trigger>
  nextId: Nat
record Seed:
  owner: String
  handle: String
  env: Plans.Reference
record Edits:
  triggers: Plans.Entries<Trigger, {}>
  nextId: Plans.Edit<Nat, Nat>
# Every send carries a line of text: a note's text, or what woke the trigger.
type Plan = Plans.Plan<Edits>
type Response = Plans.Response<State, {}>
# Only the owner changes its triggers, reprograms or amends it; as with Env, the creator
# must be the owner, so each principal creates their own Wake (docs/GENESIS.md).
law owner "only its owner writes it": request.subject == new.owner
law ids "trigger ids only count up": monotone(nextId)
# The two-tier law, in Bend (stubbed against Abi.Request until the host runs it): the
# triggers change only by the owner's request.
def law(old: State, new: State, request: Abi.Request) -> Abi.Verdict:
  if new.nextId == old.nextId && Lists.length(new.triggers) == Lists.length(old.triggers) || request.context.principal == old.owner then Abi.Verdict.admitted({}) else Abi.Verdict.refused({clause: "owner"})
def defaultSeed() -> Seed:
  {owner: "", handle: "", env: Plans.nobody()}
def seeded(seed: Seed) -> State:
  {owner: seed.owner, handle: seed.handle, env: if Plans.isNobody(seed.env) then {world: "", object: Events.envOf(seed.owner)} else seed.env, triggers: Lists.List.nil(), nextId: 1n}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {triggers: Plans.Entries.keep({}), nextId: Plans.Edit.keep({})}
sum Done:
  watching: {id: Nat}
  fired: {count: Nat}
  refused: Card.Refusal
# Why a wake refuses: each arm a clause, `why` its reading.
sum Why:
  notOwner: {owner: String}
  full: {}
  noTrigger: {id: Nat}
  early: {}
def why(w: Why) -> String:
  match w:
    case notOwner(n): "Only its owner sets these triggers; that is {n.owner}"
    case full(_): "Thirty-two triggers is the most a wake holds."
    case noTrigger(n): "No trigger {natText(n.id)}"
    case early(_): "The schedule was answered before its time."
def clause(w: Why) -> String:
  match w:
    case notOwner(_): "notOwner"
    case full(_): "full"
    case noTrigger(_): "noTrigger"
    case early(_): "early"
def refused(w: Why) -> Done:
  Done.refused({clause: clause(w), reading: why(w)})
def notOwner(state: State) -> Done:
  refused(Why.notOwner({owner: Card.handle(state.owner)}))
def watched<T>(state: State, event: On, action: Action, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  if context.principal != state.owner then then(notOwner(state)) else if Lists.length(state.triggers) < 32n then added(state, event, action, context, then) else then(refused(Why.full({})))
def added<T>(state: State, event: On, action: Action, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: {triggers: Plans.Entries.append({item: {id: state.nextId, event: event, action: action}}), nextId: Plans.Edit.add({delta: 1n})}}))
  observing(event, Done.watching({id: state.nextId}), context, then)
# A trigger on another object's writes or rows registers this wake as that object's
# observer (the observers convention: its `observe {object, method}`), by a send: `written`
# for a field's value, `rows` for the rows a write inserts.
def observing<T>(event: On, done: Done, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  match event:
    case writes(w): observed(w.object, "written", done, context, then)
    case rows(r): observed(r.object, "rows", done, context, then)
    case _: then(done)
def observed<T>(object: String, method: String, done: Done, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.send({object: {world: context.world, object: object}, method: "observe", argument: {object: Plans.self(context), method: method}})):
    case _: then(done)
# What an observed object sends on a write: the field and its value now. A trigger on
# that object and field fires when the value passes `above` (it was at most `above`
# before this write, as one step up from it); a call action is sent with nothing.
def written(state: State, input: {field: String, value: Nat}, context: Abi.Context) -> Activity<Plan, Response, Done>:
  passing(state, state.triggers, context.caller, input.field, input.value, 0n)
# What an observed object sends after inserting rows (Card.notifyRows). A trigger on that
# object and field fires once when at least `atLeast` (at least one) of the rows match
# every pattern; a call action is sent with nothing, any other the line.
def rows(state: State, input: {field: String, rows: Card.Rows}, context: Abi.Context) -> Activity<Plan, Response, Done>:
  ruled(state, state.triggers, context.caller, input.field, input.rows, 0n)
def ruled(state: State, triggers: Lists.List<Trigger>, object: String, field: String, rows: Card.Rows, count: Nat) -> Activity<Plan, Response, Done>:
  match triggers:
    case nil(_): Done.fired({count: count})
    case cons(c): ruledBy(state, c.head, c.tail, object, field, rows, matched(c.head.event, object, field, rows), count)
def ruledBy(state: State, trigger: Trigger, rest: Lists.List<Trigger>, object: String, field: String, rows: Card.Rows, hits: Nat, count: Nat) -> Activity<Plan, Response, Done>:
  if hits > 0n && hits >= least(trigger.event) then ruleFired(state, trigger.action, rest, object, field, rows, hits, count) else ruled(state, rest, object, field, rows, count)
def ruleFired(state: State, action: Action, rest: Lists.List<Trigger>, object: String, field: String, rows: Card.Rows, hits: Nat, count: Nat) -> Activity<Plan, Response, Done>:
  match perform(Plan.send({object: target(state, action), method: method(action), argument: ruleArgument(action, object, field, hits)})):
    case _: ruled(state, rest, object, field, rows, count + 1n)
def ruleArgument(action: Action, object: String, field: String, hits: Nat) -> Data:
  match action:
    case call(_): Plans.nothing()
    case _: {text: "{object}.{field}: {natText(hits)} new {if hits == 1n then \"row\" else \"rows\"} matched"}
def least(on: On) -> Nat:
  match on:
    case rows(r): r.atLeast
    case _: 1n
# How many of the rows match a rows trigger on this object and field (0 for any other).
def matched(on: On, object: String, field: String, rows: Card.Rows) -> Nat:
  match on:
    case rows(r): if r.object == object && r.field == field then Lists.length(Lists.filter(rows, fn(row: Card.Row) -> Bool: holds(row, r.where))) else 0n
    case _: 0n
def holds(row: Card.Row, where: Lists.List<Where>) -> Bool:
  Lists.any(where, fn(w: Where) -> Bool: Lists.any(row, fn(c: Card.Column) -> Bool: c.column == w.column && sameCell(c.value, w.equals)) == false) == false
def sameCell(left: Relations.Cell, right: Relations.Cell) -> Bool:
  Relations.compare(left, right) == 1n
def passes(on: On, object: String, field: String, value: Nat) -> Bool:
  match on:
    case writes(w): w.object == object && w.field == field && value > w.above && value - 1n <= w.above
    case _: false
def passing(state: State, triggers: Lists.List<Trigger>, object: String, field: String, value: Nat, count: Nat) -> Activity<Plan, Response, Done>:
  match triggers:
    case nil(_): Done.fired({count: count})
    case cons(c): if passes(c.head.event, object, field, value) then passed(state, c.head.action, c.tail, object, field, value, count) else passing(state, c.tail, object, field, value, count)
def passed(state: State, action: Action, rest: Lists.List<Trigger>, object: String, field: String, value: Nat, count: Nat) -> Activity<Plan, Response, Done>:
  match perform(Plan.send({object: target(state, action), method: method(action), argument: passArgument(action, object, field, value)})):
    case _: passing(state, rest, object, field, value, count + 1n)
def passArgument(action: Action, object: String, field: String, value: Nat) -> Data:
  match action:
    case call(_): Plans.nothing()
    case _: {text: "{object}.{field} is {natText(value)}"}
def same(done: Done) -> Done:
  done
def watch(state: State, input: {event: On, action: Action}, context: Abi.Context) -> Activity<Plan, Response, Done>:
  watched(state, input.event, input.action, context, same)
# Unwatch by id: the trigger is found here, in Bend, and removed by its bytes.
def unwatched<T>(state: State, id: Nat, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  if context.principal != state.owner then then(notOwner(state)) else removing(Lists.find(state.triggers, fn(t: Trigger) -> Bool: t.id == id), id, context, then)
def removing<T>(found: Lists.Maybe<Trigger>, id: Nat, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  match found:
    case none(_): then(refused(Why.noTrigger({id: id})))
    case some(s): removed(s.value, id, context, then)
def removed<T>(trigger: Trigger, id: Nat, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  let written(_) = perform(write {triggers: removeItem trigger})
  then(Done.watching({id: id}))
def unwatch(state: State, input: {id: Nat}, context: Abi.Context) -> Activity<Plan, Response, Done>:
  unwatched(state, input.id, context, same)
# A schedule is an await on a height: the turn suspends on a slot nobody settles, and
# when the clock passes `every` it resumes timedOut and acts. One firing per schedule
# turn; schedule again to wake again.
def schedule(state: State, input: {every: Nat, action: Action}, context: Abi.Context) -> Activity<Plan, Response, Done>:
  if context.principal != state.owner then notOwner(state) else waited(state, input.every, input.action, context)
def waited(state: State, every: Nat, action: Action, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match perform(Plan.await({slot: {principal: context.object, intent: "schedule/{context.intent}"}, patience: every})):
    case timedOut(_): act(state, action, "scheduled every {natText(every)}", 0n)
    case _: refused(Why.early({}))
# The event that woke a trigger, as a line.
def woke(event: Events.Event) -> String:
  "{event.kind} from {Card.handle(event.actor)}: {event.text}"
def contains(text: String, term: String) -> Bool:
  if term == "" then false else found(text, term, textTake(term, 1n))
def found(text: String, term: String, first: String) -> Bool:
  let rest = textDrop(text, textBreak(text, first))
  if textLength(rest) < textLength(term) then false else if textTake(rest, textLength(term)) == term then true else found(textDrop(rest, 1n), term, first)
def matches(on: On, event: Events.Event) -> Bool:
  match on:
    case mention(m): event.kind == "mention" && event.actor == m.actor
    case keyword(k): contains(event.text, k.term)
    case reply(r): event.kind == "reply" && event.replyTo == r.card
    case schedule(_): false
    case writes(_): false
    case rows(_): false
# Each matching trigger acts, in order, by explicit recursion (a send never sits in a
# lambda: an activity in a closure is refused).
def fire(state: State, triggers: Lists.List<Trigger>, event: Events.Event, count: Nat) -> Activity<Plan, Response, Done>:
  match triggers:
    case nil(_): Done.fired({count: count})
    case cons(c): if matches(c.head.event, event) then acted(state, c.head.action, c.tail, event, count) else fire(state, c.tail, event, count)
def acted(state: State, action: Action, rest: Lists.List<Trigger>, event: Events.Event, count: Nat) -> Activity<Plan, Response, Done>:
  match perform(Plan.send({object: target(state, action), method: method(action), argument: {text: woke(event)}})):
    case _: fire(state, rest, event, count + 1n)
def act(state: State, action: Action, text: String, count: Nat) -> Activity<Plan, Response, Done>:
  match perform(Plan.send({object: target(state, action), method: method(action), argument: {text: text}})):
    case _: Done.fired({count: count + 1n})
def target(state: State, action: Action) -> Plans.Reference:
  match action:
    case notify(_): {world: "", object: state.owner}
    case observe(_): state.env
    case call(c): {world: "", object: c.card}
def method(action: Action) -> String:
  match action:
    case notify(_): "note"
    case observe(_): "observe"
    case call(c): c.method
# The owner's env, or the owner in a direct turn, tells the wake what happened.
def sense(state: State, input: {event: Events.Event}, context: Abi.Context) -> Activity<Plan, Response, Done>:
  if context.principal != state.owner then notOwner(state) else fire(state, state.triggers, input.event, 0n)
form mention:
  actor: text 1..128
form keyword:
  term: text 1..64
form unwatch:
  id: natural 1..1000000
def forms() -> Card.Forms:
  Card.Forms.cons({head: mentionForm(), tail: Card.Forms.cons({head: keywordForm(), tail: Card.Forms.cons({head: unwatchForm(), tail: Card.Forms.nil()})})})
def door() -> Card.Door:
  {word: "wake", blurb: "Choose what wakes you: mentions, words, replies, a schedule."}
def doneReply(done: Done) -> Card.Reply:
  match done:
    case refused(r): Card.Reply.refused(r)
    case _: Card.Reply.done({action: "watch"})
# From a post: watch a mention or a keyword (the action is a note to you), or unwatch.
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  heard(state, Card.routeHeard(input, context, forms()), context)
def heard(state: State, routed: Card.Routed, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  match routed:
    case act(a): if a.action == "unwatch" then unwatched(state, Card.natural(a.fields, "id"), context, doneReply) else watched(state, spelled(a.action, a.fields), Action.notify({}), context, doneReply)
    case _: Card.answer(routed, context, forms(), render(state, context))
def spelled(action: String, fields: Card.Fields) -> On:
  if action == "mention" then On.mention({actor: Card.text(fields, "actor")}) else On.keyword({term: Card.text(fields, "term")})
def onText(on: On) -> String:
  match on:
    case mention(m): "a mention by {Card.handle(m.actor)}"
    case keyword(k): "the word {k.term}"
    case reply(r): "a reply to {r.card}"
    case schedule(s): "every {natText(s.every)}"
    case writes(w): "{w.object}.{w.field} passing {natText(w.above)}"
    case rows(r): "{natText(r.atLeast)} new rows of {r.object}.{r.field}{wheres(r.where)}"
def wheres(where: Lists.List<Where>) -> String:
  if Lists.length(where) == 0n then "" else textConcat(" where ", textJoin(Lists.map(where, whereText), ", "))
def whereText(w: Where) -> String:
  "{w.column} = {cellText(w.equals)}"
def cellText(cell: Relations.Cell) -> String:
  match cell:
    case natural(n): natText(n.value)
    case text(t): t.value
def actionText(action: Action) -> String:
  match action:
    case notify(_): "note me"
    case observe(_): "show my env"
    case call(c): "call {c.card} {c.method}"
def line(trigger: Trigger) -> Document.Document:
  Document.text("#{natText(trigger.id)} on {onText(trigger.event)}: {actionText(trigger.action)}\n")
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text("WAKE of {Card.shown(state.owner, state.handle, context)}{Card.mine(state.owner, context)}: {natText(Lists.length(state.triggers))} triggers\n"), tail: if Card.reads(state.owner, context) then Card.clipped(Lists.map(state.triggers, line), 8n) else Document.Documents.nil()})})
