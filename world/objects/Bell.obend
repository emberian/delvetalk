edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
sum Colour:
  amber: {}
  violet: {}
  silver: {}
record Rain:
  author: String
  text: String
record State:
  planter: String
  colour: Colour
  seed: String
  rains: Lists.List<Rain>
  rung: Bool
  door: Plans.Reference
  lastDelivery: String
  planting: Plans.Slot
# What the garden hands the host when it plants a bell.
record Seed:
  planter: String
  colour: Colour
  seed: String
  planting: Plans.Slot
record Edits:
  rains: Plans.Entries<Rain, {}>
  rung: Plans.Edit<Bool, {}>
  door: Plans.Edit<Plans.Reference, {}>
  lastDelivery: Plans.Edit<String, {}>
# The argument of a send: who is acting.
record Who:
  who: String
type Plan = Plans.Plan<Edits, Who>
type Response = Plans.Response<State, {}>
def initial() -> State:
  {planter: "", colour: Colour.amber({}), seed: "", rains: Lists.List::<Rain>.nil(), rung: false, door: {world: "", object: ""}, lastDelivery: "", planting: {principal: "", intent: ""}}
def keep() -> Edits:
  {rains: Plans.Entries::<Rain, {}>.keep({}), rung: Plans.Edit::<Bool, {}>.keep({}), door: Plans.Edit::<Plans.Reference, {}>.keep({}), lastDelivery: Plans.Edit::<String, {}>.keep({})}
def rain(state: State, input: Rain, context: Abi.Context) -> Activity<Plan, Response, Nat>:
  let count = Lists.length::<Rain>(state.rains)
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {rains: Plans.Entries::<Rain, {}>.append({item: input})})})):
    case written(_): count + 1n
    case _: count
# The strike waits for the admission receipt of the planting post, named by the
# slot Garden wrote into the seed: the planter and the post's uri.
def strike(state: State, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  match perform(Plan.await({slot: state.planting, patience: 8n})):
    case reply(r): ringOn(state, r.receipt.outcome, context)
    case _: state.rung
def ringOn(state: State, outcome: Plans.Outcome, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  match outcome:
    case admitted(_): rung(context)
    case refused(_): state.rung
def rung(context: Abi.Context) -> Activity<Plan, Response, Bool>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {rung: Plans.Edit::<Bool, {}>.set({value: true})})})):
    case written(_): true
    case _: false
# Points the bell at the door it rings. The host overwrites the placeholder.
def configure(state: State, input: {door: Plans.Reference}, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {door: Plans.Edit::<Plans.Reference, {}>.set({value: input.door})})})):
    case written(_): true
    case _: false
# Rings: marks the bell rung, then sends Door.open to the configured door.
def ring(state: State, input: Who, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {rung: Plans.Edit::<Bool, {}>.set({value: true})})})):
    case written(_): notify(state, input, context)
    case _: false
def notify(state: State, input: Who, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  match perform(Plan.send({object: state.door, method: "open", argument: input})):
    case delivery(d): remember(d.id, context)
    case _: false
def remember(id: String, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {lastDelivery: Plans.Edit::<String, {}>.set({value: id})})})):
    case written(_): true
    case _: false
def colourName(colour: Colour) -> String:
  match colour:
    case amber(_): "amber"
    case violet(_): "violet"
    case silver(_): "silver"
def line(rain: Rain) -> Document.Document:
  Document.text(textConcat(rain.author, textConcat(": ", textConcat(rain.text, "\n"))))
def render(state: State) -> Document.Document:
  Document.concat(Document.text(textConcat("A ", textConcat(colourName(state.colour), textConcat(" bell planted by ", textConcat(state.planter, textConcat(": ", textConcat(state.seed, if state.rung then " (rung)\n" else " (silent)\n"))))))), Document.Document.sequence({items: Lists.map::<Rain, Document.Document>(state.rains, line)}))
def card(state: State) -> String:
  Document.plain(render(state))
