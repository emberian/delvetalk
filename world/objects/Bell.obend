edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Relation.obend as Relations
import ./Rows.obend as Rows
import ./Text.obend as Text
sum Colour:
  amber: {}
  violet: {}
  silver: {}
# A rain keeps its author's DID and the handle the host knew when it fell, the height its
# turn read (`at`) and `n`, the bell's count of rains at that read. The key is {author, at,
# n}: two rains of one author read at one height are two rows whenever the bell counted a
# rain between them. The host keeps the rains in key order, n first (canonical bytes order
# the columns by name length), so in the order they fell; the bell keeps 2,048, the host
# dropping the first past them, after which n stays 2,048 and `at` orders them. Whoever
# wants to know of rains or a ring subscribes to `rains` or `rung` (a Wake, a door).
type Rain = Rows.Rain
# planting: the uri of the post that planted the bell, which the strike awaits the
# answer to; planter: the principal of the planting turn (the garden writes both).
record State:
  colour: fixed Colour
  seed: fixed String
  rains: Relations.Relation<Rain>
  rung: Bool
  planting: fixed String
  planter: fixed String
  planterHandle: fixed String
  doors: Card.Doorways
def initial() -> State:
  {colour: Colour.amber({}), seed: "", rains: Relations.empty(), rung: false, planting: "", planter: "", planterHandle: "", doors: Lists.List.nil()}
def relations() -> Relations.Decls:
  Lists.append(Relations.Decls.nil(), {field: "rains", key: Text.words("author at n"), limit: 2048n})
def rainKey(rain: Rain) -> {author: String, at: Nat, n: Nat}:
  {author: rain.author, at: rain.at, n: rain.n}
# The author of a rain is the turn's principal, never an argument. The rain is answered with
# the bell as it now stands, to its author, and with the count of rains.
def rain(state: State, input: {text: String}, context: Abi.Context) -> Activity<Nat>:
  let rain = {author: context.principal, handle: context.handle, text: input.text, at: context.height, n: Relations.count(state.rains)}
  let written(_) = write {rains: insert rain}
  Card.tellTo(Relations.count(state.rains) + 1n, context.principal, render(extend(state, {rains: Relations.insert(state.rains, rain, rainKey)}), context))
# The strike waits for the reply that answers the planting post (awaitPost: the first
# turn on the post's recorded object whose replyTo names it), and rings if that turn was
# admitted. A bell planted with no post has nothing to await and stays as it is.
def strike(state: State, context: Abi.Context) -> Activity<Bool>:
  if state.planting == "" then state.rung else awaitPlanting(state.planting, state.rung, context)
def awaitPlanting(planting: String, rung: Bool, context: Abi.Context) -> Activity<Bool>:
  match world.awaitPost({post: planting, patience: 8n}):
    case reply(r): ringOn(r.receipt.outcome, rung, context)
    case _: rung
def ringOn(outcome: Plans.Outcome, rung: Bool, context: Abi.Context) -> Activity<Bool>:
  match outcome:
    case admitted(_): rang(context)
    case refused(_): rung
# Rings: marks the bell rung; its subscribers (a door) are told by the host.
def rang(context: Abi.Context) -> Activity<Bool>:
  let written(_) = write {rung: set true}
  true
def ring(state: State, context: Abi.Context) -> Activity<Bool>:
  rang(context)
form rain:
  text: text 1..280
form ring:
form door:
  label: text 1..32
  to: text 1..160
form undoor:
  label: text 1..32
def methods() -> Lists.List<String>:
  Text.words("strike")
def forms() -> Card.Forms:
  Lists.append(Lists.append(Lists.append(Lists.append(Card.Forms.nil(), rainForm()), ringForm()), doorForm()), undoorForm())
# Doors on the bell's card are its planter's (the garden gives it one home on planting).
def door(state: State, input: {label: String, to: String}, context: Abi.Context) -> Activity<Card.Replied>:
  doored(Card.doorAdd(state.doors, state.planter, {label: input.label, to: {world: context.world, object: input.to}}, context), "door")
def undoor(state: State, input: {label: String}, context: Abi.Context) -> Activity<Card.Replied>:
  doored(Card.doorRemove(state.doors, state.planter, input.label, context), "undoor")
def doored(edit: Card.DoorEdit, action: String) -> Activity<Card.Replied>:
  match edit:
    case refused(r): Card.tell(Card.Replied.refused(r), Document.text("Not done: {r.reading}\n"))
    case edit(e): doorWritten(e.entries, action)
def doorWritten(entries: Plans.Entries<Card.Doorway, Card.Doorway>, action: String) -> Activity<Card.Replied>:
  let written(_) = world.write(extend(keep(), {doors: entries}))
  Card.Replied.done({action: action})
def blurb() -> Card.Door:
  {word: "bell", blurb: "A bell from the Night Garden: rain on it, ring it."}
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
def colourName(colour: Colour) -> String:
  match colour:
    case amber(_): "amber"
    case violet(_): "violet"
    case silver(_): "silver"
def line(rain: Rain) -> Document.Document:
  Document.text("{Card.shown(rain.author, rain.handle, Card.stranger())}: {rain.text}\n")
# Newest rains are last; the card shows the first eight and counts the rest.
def render(state: State, context: Abi.Context) -> Document.Document:
  let article = if colourName(state.colour) == "amber" then "An" else "A"
  let sound = if state.rung then "rung" else "silent"
  let id = Card.called(context, "<bell>")
  let head = Document.text("{article} {colourName(state.colour)} bell, planted by {Card.shown(state.planter, state.planterHandle, context)}{Card.mine(state.planter, context)}: “{state.seed}” — {sound}.\nReply delvetalk {id} rain / text: <1 to 280 characters> to rain on it.\n")
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: Lists.concat(Card.clipped(Lists.map(Relations.rows(state.rains), line), 8n), Card.doorLines(state.doors))})})
