edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./Card.obend as Card
sum Colour:
  amber: {}
  violet: {}
  silver: {}
# A rain keeps its author's DID and the handle the host knew when it fell.
record Rain:
  author: String
  handle: String
  text: String
# planting: the uri of the post that planted the bell, which the strike awaits the
# answer to; planter: the principal of the planting turn (the garden writes both).
record State:
  colour: Colour
  seed: String
  rains: Lists.List<Rain>
  rung: Bool
  planting: String
  planter: String
  planterHandle: String
  observers: Card.Observers
  doors: Card.Doorways
# What a creator may supply; the host lays it over initial().
record Seed:
  colour: Colour
  seed: String
  planting: String
  planter: String
  planterHandle: String
record Edits:
  rains: Plans.Entries<Rain, {}>
  rung: Plans.Edit<Bool, {}>
  observers: Plans.Entries<Card.Observer, {}>
  doors: Plans.Entries<Card.Doorway, {}>
# Bell sends carry nothing: the acting principal is the context's.
type Plan = Plans.Plan<Edits>
type Response = Plans.Response<State, {}>
def defaultSeed() -> Seed:
  {colour: Colour.amber({}), seed: "", planting: "", planter: "", planterHandle: ""}
def seeded(seed: Seed) -> State:
  {colour: seed.colour, seed: seed.seed, rains: Lists.List.nil(), rung: false, planting: seed.planting, planter: seed.planter, planterHandle: seed.planterHandle, observers: Card.Observers.nil(), doors: Lists.List.nil()}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {rains: Plans.Entries.keep({}), rung: Plans.Edit.keep({}), observers: Plans.Entries.keep({}), doors: Plans.Entries.keep({})}
# The author of a rain is the turn's principal, never an argument.
def rained<T>(state: State, text: String, context: Abi.Context, then: Nat -> T) -> Activity<Plan, Response, T>:
  let written(_) = perform(write {rains: append {author: context.principal, handle: context.handle, text: text}})
  then(Lists.length(state.rains) + 1n)
def rain(state: State, input: {text: String}, context: Abi.Context) -> Activity<Plan, Response, Nat>:
  rained(state, input.text, context, fn(count: Nat) -> Nat: count)
# The strike waits for the reply that answers the planting post (awaitPost: the first
# turn on the post's recorded object whose replyTo names it), and rings if that turn was
# admitted. A bell planted with no post has nothing to await and stays as it is.
def strike(state: State, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  if state.planting == "" then state.rung else awaitPlanting(state, context)
def awaitPlanting(state: State, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  match perform(Plan.awaitPost({post: state.planting, patience: 8n})):
    case reply(r): ringOn(state, r.receipt.outcome, context)
    case _: state.rung
def ringOn(state: State, outcome: Plans.Outcome, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  match outcome:
    case admitted(_): rang(state, context, fn(sent: Nat) -> Bool: true)
    case refused(_): state.rung
# Rings: marks the bell rung, then tells every observer (a door opens).
def rang<T>(state: State, context: Abi.Context, then: Nat -> T) -> Activity<Plan, Response, T>:
  let written(_) = perform(write {rung: set true})
  Card.broadcast(state.observers, Plans.nothing(), 0n, then)
def ring(state: State, context: Abi.Context) -> Activity<Plan, Response, Nat>:
  rang(state, context, fn(sent: Nat) -> Nat: sent)
def observe(state: State, input: Card.Observer, context: Abi.Context) -> Activity<Plan, Response, Card.Change>:
  changed(Card.observing(state.observers, input), context)
def unobserve(state: State, input: Card.Observer, context: Abi.Context) -> Activity<Plan, Response, Card.Change>:
  changed(Card.unobserving(state.observers, input), context)
def changed(change: Card.Change, context: Abi.Context) -> Activity<Plan, Response, Card.Change>:
  match change:
    case edit(e): observed(change, e.entries, context)
    case _: change
def observed(change: Card.Change, entries: Plans.Entries<Card.Observer, {}>, context: Abi.Context) -> Activity<Plan, Response, Card.Change>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {observers: entries})}))
  change
form rain:
  text: text 1..280
form ring:
def forms() -> Card.Forms:
  Card.Forms.cons({head: rainForm(), tail: Card.Forms.cons({head: ringForm(), tail: Card.Forms.cons({head: Card.doorForm(), tail: Card.Forms.cons({head: Card.undoorForm(), tail: Card.Forms.nil()})})})})
# Doors on the bell's card are its planter's (the garden gives it one home on planting).
def doored(edit: Card.DoorEdit, action: String, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  match edit:
    case refused(r): Card.tell(Card.Reply.refused(r), Document.text("Not done: {r.reading}\n"))
    case edit(e): doorWritten(e.entries, action, context)
def doorWritten(entries: Plans.Entries<Card.Doorway, {}>, action: String, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {doors: entries})}))
  Card.Reply.done({action: action})
def door() -> Card.Door:
  {word: "bell", blurb: "A bell from the Night Garden: rain on it, ring it."}
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  heard(state, Card.routeHeard(input, context, forms()), context)
def heard(state: State, routed: Card.Routed, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  match routed:
    case act(a): if a.action == "door" || a.action == "undoor" then doored(Card.dooring(state.doors, state.planter, a.action, a.fields, context), a.action, context) else if a.action == "rain" then rainedCard(state, Card.text(a.fields, "text"), context) else rang(state, context, fn(sent: Nat) -> Card.Reply: Card.Reply.done({action: "ring"}))
    case _: Card.answer(routed, context, forms(), render(state, context))
# A rain from a reply is answered with the bell as it now stands, to its author.
def rainedCard(state: State, text: String, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  let rain: Rain = {author: context.principal, handle: context.handle, text: text}
  let written(_) = perform(write {rains: append rain})
  Card.tellTo(Card.Reply.done({action: "rain"}), context.principal, render(extend(state, {rains: Lists.append(state.rains, rain)}), context))
def colourName(colour: Colour) -> String:
  match colour:
    case amber(_): "amber"
    case violet(_): "violet"
    case silver(_): "silver"
def line(rain: Rain) -> Document.Document:
  Document.text("{Card.shown(rain.author, rain.handle, Card.stranger())}: {rain.text}\n")
# Newest rains are last; the card shows the first eight and counts the rest.
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  let article = if colourName(state.colour) == "amber" then "An" else "A"
  let sound = if state.rung then "rung" else "silent"
  let head = Document.text("{article} {colourName(state.colour)} bell planted by {Card.shown(state.planter, state.planterHandle, context)}{Card.mine(state.planter, context)}: {state.seed} ({sound})\n")
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: Lists.concat(Card.clipped(Lists.map(state.rains, line), 8n), Card.doorLines(state.doors))})})
