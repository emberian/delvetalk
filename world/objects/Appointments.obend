edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Appointment.obend as Appointment
# A book of appointments. Booking creates one Appointment object (owned by the turn's
# principal) and sends it `wait`, so each waits in its own turn: a later booking writes
# the book, never the appointment, and cannot stale another's wait.
record State:
  booked: Nat
  children: Lists.List<Plans.Reference>
def initial() -> State:
  {booked: 0n, children: Lists.List.nil()}
sum Done:
  booked: {object: Plans.Reference}
  refused: Card.Refusal
def book(state: State, input: {topic: String, to: String, after: Nat}, context: Abi.Context) -> Activity<Done>:
  if input.after == 0n then Done.refused({clause: "afterZero", reading: "after is at least 1."}) else creating({owner: context.principal, topic: input.topic, to: {world: context.world, object: input.to}, after: input.after}, state, context)
def creating(seed: Appointment.Seed, state: State, context: Abi.Context) -> Activity<Done>:
  match world.create({package: "Appointment", seed: seed, law: "", requireAbsent: {world: "", object: "{context.object}/{natText(state.booked + 1n)}"}}):
    case created(c): counted(c.object)
    case refused(r): Done.refused({clause: r.clause, reading: "The world refused it ({r.clause})."})
def counted(object: Plans.Reference) -> Activity<Done>:
  let written(_) = write {booked: add 1n, children: append object}
  kept(object)
def kept(object: Plans.Reference) -> Activity<Done>:
  match world.send({object: object, method: "wait", argument: Plans.nothing()}):
    case _: Done.booked({object: object})
form book:
  topic: text 1..140
  to: text 1..128
  after: natural 1..1000000
def blurb() -> Card.Door:
  {word: "appointments", blurb: "Book a note for later: it is sent when its time comes."}
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
def childLine(reference: Plans.Reference) -> Document.Document:
  Document.text("- {reference.object}\n")
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text("APPOINTMENTS: {natText(state.booked)} booked, newest first\n"), tail: Card.clipped(Lists.map(Lists.reverse(state.children), childLine), 8n)})})
