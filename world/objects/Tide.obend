edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Relation.obend as Relations
import ./Text.obend as Text
# kimik3's tide: the town's one clock thing. It ticks itself, once every `gap` clock minutes (an
# hour): each tick is its own turn, which sends the tide `due {at}`, a turn that waits for the
# clock on a slot nobody settles and then sends the next `tick`. A turn that only waits writes
# nothing, so a resumed wait never meets a stale root; a wait the clock passed by a jump ticks
# once, at the clock it wakes to (missed ticks are not made up). What happens at a tick is the
# rules written on the tide (`delvetalk tide rules`): the weather's, once a clock day, is `new.ticks
# % 24 == 0`; a front's clock reads the tick too. Its wait is its own on the clock (a slot in its own
# name), so the clock's ending it is a new cause: the host runs the wake under the tide's own chain, a
# whole budget each period, and it ticks for ever (docs/review/astra-2026-10-12 world 5); a second wait of
# its own is refused `waiting`. Its owner starts it (`tick`, the first); a tick
# sooner than `gap` after the last is refused tooSoon, so a second chain dies at its first tick.
# owner: who alone starts, reprograms or amends it (the host fills it with the creating principal).
record State:
  owner: String
  ticks: Nat
  last: Nat
  gap: Nat
law clock "ticks only count up": monotone(ticks)
law last "the last tick only moves forward": monotone(last)
law gap "the gap never changes": unchanged(gap)
law owner "the owner never changes; only the owner reprograms or amends it; anyone places rules, wants and verbs on it": unchanged(owner) and (request.kind == 0 or request.kind == rule or request.subject == new.owner)
law tooSoon "A tick may not come sooner than the gap after the last.": new.ticks <= old.ticks or old.ticks == 0 or request.clock == old.last + old.gap or not (request.clock <= old.last + old.gap)
law methods "Only its own methods write it; a proposed write is refused.": not (request.kind == proposed) and (request.kind == 0 implies not (request.method == ""))
def initial() -> State:
  {owner: "", ticks: 0n, last: 0n, gap: 60n}
# The tide as edition 8 kept it: `subs`, the notes a tick owed, and a gap the opener's wake kept to
# an hour. A carry lays this package over it: `subs` goes (a rule on the tide is how a tick reaches
# anyone now), and it ticks itself hourly.
record Subscription8:
  who: String
  every: Nat
  note: String
  since: Nat
  handle: String
record State8:
  owner: String
  ticks: Nat
  last: Nat
  gap: Nat
  subs: Relations.Relation<Subscription8>
def migrate(old: State8) -> State:
  {owner: old.owner, ticks: old.ticks, last: old.last, gap: 60n}
sum Done:
  ticked: {tick: Nat}
  waited: {}
  refused: Card.Refusal
# A tick: the tide's own (the turn its `due` sent), or its owner's first. Too soon is refused
# by name; a tick from anyone else is told that the tide ticks itself.
def tick(state: State, context: Abi.Context) -> Activity<Done>:
  if context.caller != context.object && (context.principal != state.owner || state.ticks > 0n) then refusing({clause: "itself", reading: "the tide ticks itself every {natText(state.gap)} clock minutes; the next from clock {natText(state.last + state.gap)}"}, context) else if state.ticks > 0n && context.clock < state.last + state.gap then refusing({clause: "tooSoon", reading: "the next tick may come at clock {natText(state.last + state.gap)}"}, context) else ticked(state, context)
def refusing(refusal: Card.Refusal, context: Abi.Context) -> Activity<Done>:
  Card.refusing(Done.refused(refusal), refusal, context)
def ticked(state: State, context: Abi.Context) -> Activity<Done>:
  tickedAt(state, scheduled(state, context.clock), context)
# The clock a tick stands for: the one its wait was set for (the last and a gap), though the wait ends the minute after
# it; a tick a gap or more late (the clock jumped, the town was down) begins again from now. The live review's H6:
# ticks 61 minutes apart, the inhabitants' hours missing their day once in 61.
def scheduled(state: State, clock: Nat) -> Nat:
  if state.ticks > 0n && clock < state.last + state.gap + state.gap then state.last + state.gap else clock
def tickedAt(state: State, at: Nat, context: Abi.Context) -> Activity<Done>:
  let written(_) = write {ticks: add 1n, last: set at}
  match world.send({object: Plans.self(context), method: "due", argument: {at: at + state.gap}}):
    case _: Card.tell(Done.ticked({tick: state.ticks + 1n}), Document.concat(Document.text("Tick {natText(state.ticks + 1n)}.\n\n"), render(extend(state, {ticks: state.ticks + 1n, last: at}), context)))
# Carried to a newer host (the carry's `carried`, as a kind's `made`): the wait the move dropped is waited
# again, for the tick the last one scheduled; a tide not yet begun waits for its owner's first.
def carried(state: State, input: {}, context: Abi.Context) -> Activity<Done>:
  if state.ticks == 0n then Done.waited({}) else rearmed(state, context)
def rearmed(state: State, context: Abi.Context) -> Activity<Done>:
  match world.send({object: Plans.self(context), method: "due", argument: {at: state.last + state.gap}}):
    case _: Done.waited({})
# The wait between ticks: the tide's own send alone; the clock reaching `at` sends the next tick.
def due(state: State, input: {at: Nat}, context: Abi.Context) -> Activity<Done>:
  if context.caller != context.object then Done.waited({}) else waiting(input.at, context)
def waiting(at: Nat, context: Abi.Context) -> Activity<Done>:
  match world.awaitUntil({slot: {principal: context.object, intent: "tide/{context.intent}"}, until: at}):
    case timedOut(_): next(context)
    case _: Done.waited({})
def next(context: Abi.Context) -> Activity<Done>:
  match world.send({object: Plans.self(context), method: "tick", argument: Plans.nothing()}):
    case _: Done.waited({})
form tick:
def methods() -> Lists.List<String>:
  Text.words("~due ~carried")
def actions(state: State, context: Abi.Context) -> Lists.List<String>:
  if context.principal == state.owner && state.ticks == 0n then Text.words("tick") else Text.words("")
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
def render(state: State, context: Abi.Context) -> Document.Document:
  let id = Card.called(context, "tide")
  let when = if state.ticks == 0n then "it has not begun" else "last at clock {natText(state.last)}, the next from clock {natText(state.last + state.gap)}"
  Document.text("THE TIDE, tick {natText(state.ticks)}; {when}. It ticks itself every {natText(state.gap)} clock minutes, and what happens at a tick is the rules written on it:\n  delvetalk {id} rules\n» each rule, who wrote it, and when it last fired\nWrite one:\n  delvetalk {id} rule / name: <a name> / when: request.method == \"tick\" and new.ticks % 24 == 0 / then: <a spell>\n")
