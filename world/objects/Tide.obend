edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./Card.obend as Card
# kimik3's tide: programmable wakes as an object. Anyone subscribes themselves (the
# subscriber is the turn's principal, never an argument); anyone may tick, but a tick
# sooner than `gap` heights after the last is refused tooSoon, naming when the next may
# come. A tick sends each due subscriber's Avatar (its id is the DID) a note.
record Sub:
  who: String
  every: Nat
  note: String
  since: Nat
record State:
  ticks: Nat
  last: Nat
  gap: Nat
  subs: Lists.List<Sub>
record Seed:
  gap: Nat
record Edits:
  ticks: Plans.Edit<Nat, Nat>
  last: Plans.Edit<Nat, {}>
  subs: Plans.Entries<Sub, Sub>
type Plan = Plans.Plan<Edits>
type Response = Plans.Response<State, {}>
# What the law can say today. "Subscribe only yourself" is an item of a list and
# "tooSoon" compares old and new: neither is in today's fragment, so Bend refuses them.
# With request.method and the two-tier law:
#   self: request.method == "tick" or request.subject == <the appended item's who>
law clock: monotone(ticks)
law height: monotone(last)
def defaultSeed() -> Seed:
  {gap: 1n}
def seeded(seed: Seed) -> State:
  {ticks: 0n, last: 0n, gap: seed.gap, subs: Lists.List::<Sub>.nil()}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {ticks: Plans.Edit::<Nat, Nat>.keep({}), last: Plans.Edit::<Nat, {}>.keep({}), subs: Plans.Entries::<Sub, Sub>.keep({})}
sum Done:
  subscribed: {since: Nat}
  ticked: {tick: Nat, sent: Nat}
  tooSoon: {next: Nat}
  refused: {reason: String}
# One subscription per principal: subscribing again replaces it.
def subscribed<T>(state: State, every: Nat, note: String, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  if every == 0n then then(Done.refused({reason: "every is at least 1."})) else subscribing::<T>(state, Lists.indexWhere::<Sub>(state.subs, fn(s: Sub) -> Bool: s.who == context.principal), {who: context.principal, every: every, note: note, since: state.ticks}, context, then)
def subscribing<T>(state: State, found: Lists.Maybe<Nat>, sub: Sub, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  match found:
    case some(s): subWritten::<T>(Plans.Entries::<Sub, Sub>.amend({index: s.value, change: sub}), sub.since, context, then)
    case none(_): if Lists.length::<Sub>(state.subs) < 64n then subWritten::<T>(Plans.Entries::<Sub, Sub>.append({item: sub}), sub.since, context, then) else then(Done.refused({reason: "The tide holds sixty-four subscribers."}))
def subWritten<T>(edit: Plans.Entries<Sub, Sub>, since: Nat, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {subs: edit})})):
    case _: then(Done.subscribed({since: since}))
def same(done: Done) -> Done:
  done
def subscribe(state: State, input: {every: Nat, note: String}, context: Abi.Context) -> Activity<Plan, Response, Done>:
  subscribed::<Done>(state, input.every, input.note, context, same)
def remainder(n: Nat, d: Nat) -> Nat:
  if n < d then n else remainder(n - d, d)
def due(sub: Sub, tick: Nat) -> Bool:
  remainder(tick - sub.since, sub.every) == 0n
# The first tick may come at once; after it, not before last + gap.
def ticked<T>(state: State, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  if state.ticks > 0n && context.height < state.last + state.gap then then(Done.tooSoon({next: state.last + state.gap})) else tickWritten::<T>(state, context, then)
def tickWritten<T>(state: State, context: Abi.Context, then: Done -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {ticks: Plans.Edit::<Nat, Nat>.add({delta: 1n}), last: Plans.Edit::<Nat, {}>.set({value: context.height})})})):
    case _: woken::<T>(state.subs, state.ticks + 1n, 0n, then)
# Sends to each due subscriber in turn, by explicit recursion.
def woken<T>(subs: Lists.List<Sub>, tick: Nat, sent: Nat, then: Done -> T) -> Activity<Plan, Response, T>:
  match subs:
    case nil(_): then(Done.ticked({tick: tick, sent: sent}))
    case cons(c): if due(c.head, tick) then noted::<T>(c.head, c.tail, tick, sent, then) else woken::<T>(c.tail, tick, sent, then)
def noted<T>(sub: Sub, rest: Lists.List<Sub>, tick: Nat, sent: Nat, then: Done -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.send({object: {world: "", object: sub.who}, method: "note", argument: Data.of::<{text: String}>({text: textConcat("tide ", textConcat(natText(tick), textConcat(": ", sub.note)))})})):
    case delivery(_): woken::<T>(rest, tick, sent + 1n, then)
    case _: woken::<T>(rest, tick, sent, then)
def tick(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  ticked::<Done>(state, context, same)
def forms() -> Card.Forms:
  Card.Forms.cons({head: {card: "", action: "subscribe", fields: Form.Fields.cons({head: {name: "every", kind: Form.Kind.natural({min: 1n, max: 1000n})}, tail: Form.Fields.cons({head: {name: "note", kind: Form.Kind.text({min: 1n, max: 140n})}, tail: Form.Fields.nil()})})}, tail: Card.Forms.cons({head: {card: "", action: "tick", fields: Form.Fields.nil()}, tail: Card.Forms.nil()})})
def door() -> Card.Door:
  {word: "tide", blurb: "Wake on a cadence: subscribe yourself; anyone may tick, never too soon."}
def doneReply(done: Done) -> Card.Reply:
  match done:
    case tooSoon(t): Card.Reply.refused({reason: textConcat("tooSoon: the next tick may come at height ", natText(t.next))})
    case refused(r): Card.Reply.refused({reason: r.reason})
    case subscribed(_): Card.Reply.done({action: "subscribe"})
    case ticked(_): Card.Reply.done({action: "tick"})
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  heard(state, Card.route(input.text, context, forms()), context)
def heard(state: State, routed: Card.Routed, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  match routed:
    case act(a): if a.action == "tick" then ticked::<Card.Reply>(state, context, doneReply) else subscribed::<Card.Reply>(state, Card.natural(a.fields, "every"), Card.text(a.fields, "note"), context, doneReply)
    case _: Card.answer::<Edits, State, {}>(routed, context, forms(), render(state))
def line(sub: Sub) -> Document.Document:
  Document.text(textConcat(Card.handle(sub.who), textConcat(" every ", textConcat(natText(sub.every), textConcat(" from tick ", textConcat(natText(sub.since), textConcat(": ", textConcat(sub.note, "\n"))))))))
def render(state: State) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text(textConcat("TIDE at tick ", textConcat(natText(state.ticks), textConcat(", last at height ", textConcat(natText(state.last), textConcat("; the next no sooner than ", textConcat(natText(state.last + state.gap), "\n"))))))), tail: Card.clipped(Lists.map::<Sub, Document.Document>(state.subs, line), 8n)})})
