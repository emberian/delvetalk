edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Relation.obend as Relations
import ./Rows.obend as Rows
# kimik3's tide: programmable wakes as an object. Anyone subscribes themselves (the
# subscriber is the turn's principal, never an argument); anyone may tick, but a tick
# sooner than `gap` clock units after the last is refused tooSoon, naming when the next may
# come. A tick sends each due subscriber's Avatar (its id is the DID) a note.
# handle: the subscriber's handle as the host knew it at subscribe, shown as a bell
# shows its planter's. The subscriptions are a relation keyed {who}: one per principal,
# subscribing again is an upsert of the row, and the card lists them in key order.
type Sub = Rows.Subscription
record State:
  ticks: Nat
  last: Nat
  gap: Nat
  subs: Relations.Relation<Sub>
record Seed:
  gap: Nat
record Edits:
  ticks: Plans.Edit<Nat, Nat>
  last: Plans.Edit<Nat, {}>
  subs: Plans.Entries<Sub, Sub>
# What the law text cannot say: "a changed subscription is its principal's own" ranges over
# the rows, and "tooSoon" compares old and new; the Bend predicate says both.
law clock "ticks only count up": monotone(ticks)
law last "the last tick only moves forward": monotone(last)
# The two-tier law, in Bend: a tick sooner than gap after the last is tooSoon; every key
# the write changed (a row added, replaced or retracted) is the requesting principal's.
def law(old: State, new: State, request: Abi.Request) -> Abi.Verdict:
  if new.ticks > old.ticks && old.ticks > 0n && request.context.clock < old.last + old.gap then Abi.Verdict.refused({clause: "tooSoon", reading: "A tick may not come sooner than the gap after the last."}) else if ownSubs(old.subs, new.subs, request.context.principal) then Abi.Verdict.admitted({}) else Abi.Verdict.refused({clause: "self", reading: "A subscription changes only by its own principal."})
def ownSubs(old: Relations.Relation<Sub>, new: Relations.Relation<Sub>, principal: String) -> Bool:
  ownRows(Relations.rows(old), Relations.rows(new), principal)
# One merge of the old and new rows in key order: a key on one side only, or a row that
# differs, is a changed key and must be the principal's.
def ownRows(old: Lists.List<Sub>, new: Lists.List<Sub>, principal: String) -> Bool:
  match old:
    case nil(_): Lists.any(new, fn(n: Sub) -> Bool: n.who != principal) == false
    case cons(o): ownFrom(o.head, o.tail, new, principal)
def ownFrom(old: Sub, olds: Lists.List<Sub>, new: Lists.List<Sub>, principal: String) -> Bool:
  match new:
    case nil(_): old.who == principal && ownRows(olds, new, principal)
    case cons(n): ownStep(Relations.compare(subKey(old), subKey(n.head)), old, olds, n.head, n.tail, principal)
def ownStep(order: Nat, old: Sub, olds: Lists.List<Sub>, new: Sub, news: Lists.List<Sub>, principal: String) -> Bool:
  if order == 1n then (sameSub(old, new) || new.who == principal) && ownRows(olds, news, principal) else if order == 0n then old.who == principal && ownRows(olds, Lists.List.cons({head: new, tail: news}), principal) else new.who == principal && ownFrom(old, olds, news, principal)
def sameSub(old: Sub, new: Sub) -> Bool:
  old.every == new.every && old.note == new.note && old.since == new.since && old.handle == new.handle
def subKey(sub: Sub) -> {who: String}:
  {who: sub.who}
def relations() -> Relations.Decls:
  Relations.Decls.cons({head: {field: "subs", key: Lists.List.cons({head: "who", tail: Lists.List.nil({})}), limit: 1024n}, tail: Relations.Decls.nil({})})
def defaultSeed() -> Seed:
  {gap: 1n}
def seeded(seed: Seed) -> State:
  {ticks: 0n, last: 0n, gap: seed.gap, subs: Relations.empty()}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {ticks: Plans.Edit.keep({}), last: Plans.Edit.keep({}), subs: Plans.Entries.keep({})}
sum Done:
  subscribed: {since: Nat}
  ticked: {tick: Nat, sent: Nat}
  tooSoon: {next: Nat}
  refused: Card.Refusal
# Why a subscription is refused: each arm a clause, `why` its reading.
sum Why:
  everyZero: {}
  full: {}
def why(w: Why) -> String:
  match w:
    case everyZero(_): "every is at least 1."
    case full(_): "The tide holds sixty-four subscribers."
def clause(w: Why) -> String:
  match w:
    case everyZero(_): "everyZero"
    case full(_): "full"
def refused(w: Why) -> Done:
  Done.refused({clause: clause(w), reading: why(w)})
# One subscription per principal (the key): subscribing again replaces it.
# Every subscribe and tick ends by offering what happened and the Tide's card as the
# write leaves it (a refusal shows the card as read), refusals included. The helpers take
# the State after their own inputs: a definition whose first parameter is the State is a
# method any turn may run.
def told(done: Done, card: Document.Document) -> Activity<Done>:
  Card.tell(done, Document.concat(Document.text(doneLine(done)), card))
def doneLine(done: Done) -> String:
  match done:
    case subscribed(s): "Subscribed, from tick {natText(s.since)}.\n\n"
    case ticked(t): "Tick {natText(t.tick)}: {natText(t.sent)} {if t.sent == 1n then \"note\" else \"notes\"} sent.\n\n"
    case tooSoon(t): "Too soon: the next tick may come at clock {natText(t.next)}.\n\n"
    case refused(r): "refused {r.clause}: {r.reading}\n\n"
def subscribe(state: State, input: {every: Nat, note: String}, context: Abi.Context) -> Activity<Done>:
  if input.every == 0n then told(refused(Why.everyZero({})), render(state, context)) else subscribing({who: context.principal, every: input.every, note: input.note, since: state.ticks, handle: context.handle}, state, context)
# Sixty-four at most (a tick sends to every due one): a new principal past them is refused.
def subscribing(sub: Sub, state: State, context: Abi.Context) -> Activity<Done>:
  if Relations.count(state.subs) < 64n || Relations.exists(state.subs, fn(s: Sub) -> Bool: s.who == sub.who) then subWritten(sub, render(extend(state, {subs: Relations.upsert(state.subs, sub, subKey)}), context)) else told(refused(Why.full({})), render(state, context))
def subWritten(sub: Sub, card: Document.Document) -> Activity<Done>:
  let written(_) = write {subs: upsert sub}
  told(Done.subscribed({since: sub.since}), card)
def remainder(n: Nat, d: Nat) -> Nat:
  if n < d then n else remainder(n - d, d)
def due(sub: Sub, tick: Nat) -> Bool:
  remainder(tick - sub.since, sub.every) == 0n
# The first tick may come at once; after it, not before last + gap.
def tick(state: State, context: Abi.Context) -> Activity<Done>:
  if state.ticks > 0n && context.clock < state.last + state.gap then told(Done.tooSoon({next: state.last + state.gap}), render(state, context)) else tickWritten(context, state)
def tickWritten(context: Abi.Context, state: State) -> Activity<Done>:
  let written(_) = write {ticks: add 1n, last: set context.clock}
  woken(Relations.rows(state.subs), state.ticks + 1n, 0n, render(extend(state, {ticks: state.ticks + 1n, last: context.clock}), context))
# Sends to each due subscriber in turn, by explicit recursion.
def woken(subs: Lists.List<Sub>, tick: Nat, sent: Nat, card: Document.Document) -> Activity<Done>:
  match subs:
    case nil(_): told(Done.ticked({tick: tick, sent: sent}), card)
    case cons(c): if due(c.head, tick) then noted(c.head, c.tail, tick, sent, card) else woken(c.tail, tick, sent, card)
def noted(sub: Sub, rest: Lists.List<Sub>, tick: Nat, sent: Nat, card: Document.Document) -> Activity<Done>:
  match world.send({object: {world: "", object: sub.who}, method: "note", argument: {text: "tide {natText(tick)}: {sub.note}"}}):
    case delivery(_): woken(rest, tick, sent + 1n, card)
    case _: woken(rest, tick, sent, card)
form subscribe:
  every: natural 1..1000
  note: text 1..140
form tick:
def forms() -> Card.Forms:
  Card.Forms.cons({head: subscribeForm(), tail: Card.Forms.cons({head: tickForm(), tail: Card.Forms.nil()})})
def blurb() -> Card.Door:
  {word: "tide", blurb: "Wake on a cadence: subscribe yourself; anyone may tick, never too soon."}
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
def line(context: Abi.Context) -> Sub -> Document.Document:
  fn(sub: Sub) -> Document.Document: Document.text("{Card.shown(sub.who, sub.handle, context)}{Card.mine(sub.who, context)} every {natText(sub.every)} from tick {natText(sub.since)}: {sub.note}\n")
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text("TIDE at tick {natText(state.ticks)}, last at clock {natText(state.last)}; the next no sooner than {natText(state.last + state.gap)}\n"), tail: Card.clipped(Lists.map(Relations.rows(state.subs), line(context)), 8n)})})
