edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Form.obend as Form
import ./Spell.obend as Spell
import ./World.obend as World
import ./Card.obend as Card
import ./Policies.obend as Policies
import ./Relation.obend as Relations
import ./Rows.obend as Rows
import ./Text.obend as Text
import ./Menu.obend as Menu
import ./Mentions.obend as Mentions
type Door = Menu.Door
type Examples = Menu.Examples
type News = Menu.News
type Visit = Menu.Visit
type Missed = Menu.Missed
type Learned = Mentions.Learned
type Learning = Mentions.Learning
# A door as the directory keeps it: keyed by its label, with its place on the menu (the
# owner's order, which the card keeps; key order is not menu order).
record Listed:
  label: String
  description: String
  to: Plans.Reference
  examples: Examples
  watch: String
  place: Nat
type Greeting = Rows.Greeting
# doors: the menu, keyed {label}. greeted: the principals the menu has gone to once, keyed
# {principal} (each later summons gets one line). policy: the interpretation policy prose is
# read with (the town's model, offered the forms of every door); nobody means prose is not
# interpreted. news: each watched door's count. visits: each reader's last door, which their
# menu opens on. missed: when each reader was last answered for prose naming nothing.
record State:
  owner: String
  doors: Relations.Relation<Listed>
  greeted: Relations.Relation<Greeting>
  policy: Plans.Reference
  news: Relations.Relation<News>
  visits: Relations.Relation<Visit>
  missed: Relations.Relation<Missed>
sum Answer:
  done: {}
  refused: Card.Refusal
# Only the owner adds or removes a door; anyone's summons only inserts into greeted. A law in
# source means a Directory is made with world-create.
law owner "the owner never changes; only the owner changes the doors or the policy, and anyone else only by its methods": unchanged(owner) and (request.subject == new.owner or (request.kind == 0 and unchanged(doors) and unchanged(policy)))
law greeted "anyone's summons only adds to who was greeted": request.subject == new.owner or insertOnly(greeted)
def initial() -> State:
  {owner: "", doors: Relations.empty(), greeted: Relations.empty(), policy: Plans.nobody(), news: Relations.empty(), visits: Relations.empty(), missed: Relations.empty()}
def relations() -> Relations.Decls:
  Lists.append(Lists.append(Lists.append(Lists.append(Lists.append(Relations.Decls.nil(), {field: "doors", key: Text.words("label"), limit: 64n}), {field: "greeted", key: Text.words("principal"), limit: 2048n}), {field: "news", key: Text.words("card"), limit: 64n}), {field: "visits", key: Text.words("principal"), limit: 64n}), {field: "missed", key: Text.words("principal"), limit: 64n})
def listedKey(listed: Listed) -> {label: String}:
  {label: listed.label}
def greetingKey(greeting: Greeting) -> Greeting:
  greeting
def doorOf(listed: Listed) -> Door:
  {label: listed.label, description: listed.description, to: listed.to, examples: listed.examples, watch: listed.watch}
# The doors in key order, for every walk whose order does not show; the card's menu is in
# place order (`menu`).
def doors(state: State) -> Lists.List<Door>:
  Relations.project(state.doors, doorOf)
def menu(state: State) -> Lists.List<Door>:
  Lists.map(Relations.order(state.doors, fn(l: Listed) -> Nat: l.place), doorOf)
def position(label: String, state: State) -> Lists.Maybe<Listed>:
  Relations.lookup(state.doors, {label: label}, listedKey)
def greetedBefore(principal: String, state: State) -> Bool:
  match Relations.lookup(state.greeted, greetingKey({principal: principal}), greetingKey):
    case some(_): true
    case none(_): false
def answerRefused(clause: String, reading: String) -> Answer:
  Answer.refused({clause: clause, reading: reading})
# Adds a door at the end of the menu. A door watching a field of its object reads its count now
# and subscribes the directory to it (the owner's turn); each change comes back to the receiver
# for its rows. A door whose object is not there yet watches nothing.
def add(state: State, input: {door: Door}, context: Abi.Context) -> Activity<Answer>:
  match position(input.door.label, state):
    case some(_): answerRefused("doorTaken", "There is already a door called {input.door.label}")
    case none(_): standing(extend(input.door, {place: nextPlace(state)}), context)
def standing(door: Listed, context: Abi.Context) -> Activity<Answer>:
  if Plans.isNobody(door.to) || Menu.receiverOf(door.watch) == "" then added(door) else if door.watch == "ticks" then tickCount(door, context) else if door.watch == "count" then madeCount(door, context) else rowCount(door, context)
def tickCount(door: Listed, context: Abi.Context) -> Activity<Answer>:
  match world.viewField::<Nat>({object: door.to, field: "ticks"}):
    case viewed(v): watched(door, v.state, context)
    case _: added(door)
def madeCount(door: Listed, context: Abi.Context) -> Activity<Answer>:
  match world.viewField::<Nat>({object: door.to, field: "count"}):
    case viewed(v): watched(door, v.state, context)
    case _: added(door)
def rowCount(door: Listed, context: Abi.Context) -> Activity<Answer>:
  match world.viewField::<Relations.Relation<Data>>({object: door.to, field: door.watch}):
    case viewed(v): watched(door, Relations.count(v.state), context)
    case _: added(door)
def watched(door: Listed, count: Nat, context: Abi.Context) -> Activity<Answer>:
  let written(_) = write {doors: insert door, news: upsert {card: door.to.object, count: count, newest: "", at: context.clock}}
  Card.subscribing(door.to, door.watch, Menu.receiverOf(door.watch), Answer.done({}))
def added(door: Listed) -> Activity<Answer>:
  let written(_) = write {doors: insert door}
  Answer.done({})
# The receivers count a change only from the watched object itself (the delivery's caller) on
# a watched field: rows inserted less those retracted (an upsert is both, an eviction a
# retraction); a tick count is the new value.
def changedNat(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Nat>, retracted: Lists.List<Nat>}, context: Abi.Context) -> Activity<Answer>:
  noted(input.object.object, input.field, Lists.fold(input.inserted, 0n, fn(n: Nat) -> Nat -> Nat: fn(_: Nat) -> Nat: n), "", context, state)
def changedChildren(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Child>, retracted: Lists.List<Rows.Child>}, context: Abi.Context) -> Activity<Answer>:
  moved(input.object.object, input.field, Lists.length(input.inserted), Lists.length(input.retracted), Menu.newestOf(Lists.map(input.inserted, fn(c: Rows.Child) -> String: c.object)), context, state)
def changedLines(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Line>, retracted: Lists.List<Rows.Line>}, context: Abi.Context) -> Activity<Answer>:
  moved(input.object.object, input.field, Lists.length(input.inserted), Lists.length(input.retracted), Menu.newestOf(Lists.map(input.inserted, fn(l: Rows.Line) -> String: "#{natText(l.n)}")), context, state)
def changedHeld(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Held>, retracted: Lists.List<Rows.Held>}, context: Abi.Context) -> Activity<Answer>:
  moved(input.object.object, input.field, Lists.length(input.inserted), Lists.length(input.retracted), Menu.newestOf(Lists.map(input.inserted, fn(h: Rows.Held) -> String: if h.target == "" then "#{natText(h.n)}, {h.name}" else "#{natText(h.n)} for {h.target}")), context, state)
def changedPresence(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Presence>, retracted: Lists.List<Rows.Presence>}, context: Abi.Context) -> Activity<Answer>:
  moved(input.object.object, input.field, Lists.length(input.inserted), Lists.length(input.retracted), "", context, state)
def moved(card: String, field: String, added: Nat, dropped: Nat, newest: String, context: Abi.Context, state: State) -> Activity<Answer>:
  let before = standingCount(card, state) + added
  noted(card, field, if before >= dropped then before - dropped else 0n, newest, context, state)
def standingCount(card: String, state: State) -> Nat:
  match Relations.lookup(state.news, {card: card}, Menu.newsKey):
    case some(n): n.value.count
    case none(_): 0n
def noted(card: String, field: String, count: Nat, newest: String, context: Abi.Context, state: State) -> Activity<Answer>:
  if context.caller != card || Lists.any(doors(state), fn(d: Door) -> Bool: d.to.object == card && d.watch == field) == false then Answer.done({}) else news({card: card, count: count, newest: newest, at: context.clock})
def news(row: News) -> Activity<Answer>:
  let written(_) = write {news: upsert row}
  Answer.done({})
def nextPlace(state: State) -> Nat:
  Lists.fold(Relations.rows(state.doors), 0n, fn(l: Listed) -> Nat -> Nat: fn(most: Nat) -> Nat: if l.place + 1n > most then l.place + 1n else most)
# add and remove are no forms, so a reply's field lines (`label: moth`) are never the
# directory's own spell.
def remove(state: State, input: {door: {label: String}}, context: Abi.Context) -> Activity<Answer>:
  match position(input.door.label, state):
    case none(_): answerRefused("noDoor", "There is no door called {input.door.label}")
    case some(l): removed(l.value, Relations.exists(state.news, fn(n: News) -> Bool: n.card == l.value.to.object))
# Removing a watched door drops its news and its subscription.
def removed(door: Listed, counted: Bool) -> Activity<Answer>:
  if counted then unwatched(door) else unlisted(door.label)
def unlisted(label: String) -> Activity<Answer>:
  let written(_) = write {doors: retract {label: label}}
  Answer.done({})
def unwatched(door: Listed) -> Activity<Answer>:
  let written(_) = write {doors: retract {label: door.label}, news: retract {card: door.to.object}}
  match world.unsubscribe({object: door.to, field: door.watch, method: Menu.receiverOf(door.watch)}):
    case _: Answer.done({})
# The menu as a trie (Menu.trie), opening on the reader's last door.
def render(state: State, context: Abi.Context) -> Document.Document:
  trie(state, context, lastDoor(state, context.principal))
def lastDoor(state: State, principal: String) -> String:
  match Relations.lookup(state.visits, {principal: principal}, Menu.visitKey):
    case some(v): v.value.door
    case none(_): ""
def trie(state: State, context: Abi.Context, first: String) -> Document.Document:
  Menu.trie(menu(state), state.news, context, first)
def methods() -> Lists.List<String>:
  Text.words("add remove due")
def forms() -> Card.Forms:
  Card.Forms.nil()
def blurb() -> Card.Door:
  {word: "directory", blurb: "The doors of DelveTalk."}
# What the directory did with a reply.
sum Heard:
  passed: {card: String}
  door: {object: String}
  menu: {}
  silent: {}
  refused: Card.Refusal
  unclear: {needs: Form.Names}
  asked: {card: String}
  several: {count: Nat}
def refusing(clause: String, reading: String, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  toldThen(Document.text("✾ DELVETALK · ROOT\n\nrefused {clause}: {reading}\n"), Heard.refused({clause: clause, reading: reading}), greet, context, state)
# The hub's reply (a spell naming another card never reaches here: the host runs it there). A
# door word gets that door's card; the menu goes to each principal once, under hob's greeting.
# A misfit spell addressed here comes with its clause and reason, which hob is shown; with no
# policy it is refused by its clause.
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Heard>:
  if input.misfit.clause != "" && Plans.isNobody(state.policy) then refusing(input.misfit.clause, input.misfit.reason, false, context, state) else worded(input, doorFor(doors(state), Mentions.doorWord(input.text)), context, state)
# Calls a door's receive with a reply, as this turn; the door reads it as its own. `greet`: the
# reply is a principal's first (`greeting`), whose menu follows whatever the reply drew.
def passOn(card: String, input: {text: String, post: String}, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.call::<Data>({object: {world: context.world, object: card}, method: "receive", argument: input}):
    case returned(_): visited(card, Heard.passed({card: card}), greet, context, state)
    case denied(_): refusing("notVisible", "The card {card} is not visible to you.", greet, context, state)
    case refused(r): refusing(r.clause, if r.reading == "" then "Not passed to {card}." else r.reading, greet, context, state)
# The door a reply went through is the reader's last (its menu opens there); an arc's is its
# parent door's. Written only when it changes.
def visited(card: String, result: Heard, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match topDoorOf(card, state):
    case some(d): if d.value.label == lastDoor(state, context.principal) then welcomed(greet, d.value.label, result, context, state) else visit(d.value.label, result, greet, context, state)
    case none(_): welcomed(greet, "", result, context, state)
def visit(label: String, result: Heard, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  let written(_) = write {visits: upsert {principal: context.principal, door: label, at: context.clock}}
  welcomed(greet, label, result, context, state)
# A first reply's menu comes after what the reply drew, under hob's greeting, opening on the
# door it went through (`first`, "" for none).
def welcomed(greet: Bool, first: String, result: Heard, context: Abi.Context, state: State) -> Activity<Heard>:
  if greet then Card.tell(result, greetingCard(state, context, first)) else result
def greetingCard(state: State, context: Abi.Context, first: String) -> Document.Document:
  Menu.trieUnder(Menu.greetingLine(), menu(state), state.news, context, first)
def toldThen(document: Document.Document, result: Heard, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.offer({to: "", document: document}):
    case _: welcomed(greet, "", result, context, state)
def topDoorOf(card: String, state: State) -> Lists.Maybe<Door>:
  let all = menu(state)
  Lists.find(all, fn(d: Door) -> Bool: Plans.isNobody(d.to) == false && Menu.isArc(all, d) == false && (card == d.to.object || Text.starts(card, "{d.to.object}/")))
def doorFor(doors: Lists.List<Door>, word: String) -> Lists.Maybe<Door>:
  Lists.find(doors, fn(door: Door) -> Bool: word != "" && (door.label == word || door.to.object == word))
def worded(input: Card.Heard, found: Lists.Maybe<Door>, context: Abi.Context, state: State) -> Activity<Heard>:
  match found:
    case some(d): if Plans.isNobody(d.value.to) then linkDoor(d.value) else doorCard(d.value.to, context)
    case none(_): fieldsOrProse(input, context, state)
# Where the walk goes once the doors' forms are learned: the field lines' door, or hob.
sum Next:
  fielded: {first: Spell.Binding}
  read: {greet: Bool}
def fieldsOrProse(input: Card.Heard, context: Abi.Context, state: State) -> Activity<Heard>:
  match input.fields:
    case cons(c): learning(input, Next.fielded({first: c.head}), Lists.List.nil(), doors(state), context, state)
    case nil(_): unaddressed(input, context, state)
# What is learned of the doors: each door's offered forms, and those of the first card under it
# (a garden's bell), which field lines and the pruned menu read; hob at the root is offered the
# doors' own (`Mentions.doorForms`), and for a reply a card handed on, that card's.
def learning(input: Card.Heard, next: Next, learned: Learning, doors: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Heard>:
  match doors:
    case nil(_): learnedAll(input, next, learned, context, state)
    case cons(c): if Plans.isNobody(c.head.to) then learning(input, next, learned, c.tail, context, state) else doorLearned(input, next, learned, c.head.to.object, c.tail, context, state)
def doorLearned(input: Card.Heard, next: Next, learned: Learning, door: String, rest: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.inspect({object: {world: context.world, object: door}, source: false}):
    case inspected(i): childListed(input, next, Lists.concat(learned, Mentions.learnedOf(door, door, false, Card.offeredOnly(i.methods, i.offered))), door, rest, context, state)
    case _: childListed(input, next, learned, door, rest, context, state)
def childListed(input: Card.Heard, next: Next, learned: Learning, door: String, rest: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.objects({prefix: "{door}/", after: ""}):
    case listed(l): childLearned(input, next, learned, door, Lists.at(l.ids, 0n), rest, context, state)
    case refused(_): learning(input, next, learned, rest, context, state)
def childLearned(input: Card.Heard, next: Next, learned: Learning, door: String, child: Lists.Maybe<String>, rest: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Heard>:
  match child:
    case none(_): learning(input, next, learned, rest, context, state)
    case some(c): childInspected(input, next, learned, door, c.value, rest, context, state)
def childInspected(input: Card.Heard, next: Next, learned: Learning, door: String, child: String, rest: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.inspect({object: {world: context.world, object: child}, source: false}):
    case inspected(i): learning(input, next, Lists.concat(learned, Mentions.learnedOf(child, door, true, Card.offeredOnly(i.methods, i.offered))), rest, context, state)
    case _: learning(input, next, learned, rest, context, state)
def learnedAll(input: Card.Heard, next: Next, learned: Learning, context: Abi.Context, state: State) -> Activity<Heard>:
  match next:
    case fielded(f): fielded(input, f.first, Lists.find(learned, fn(l: Learned) -> Bool: l.child == false && (l.form.action == f.first.name || Card.hasField(l.form, f.first.name))), context, state)
    case read(r): consulted(input, {card: "", forms: Mentions.doorForms(learned), learned: learned}, r.greet, context, state)
# Field lines with no delvetalk line: when the first names an action a door offers (`plant:
# …`), the lines become that door's spell; when it names a field of a door's form (`colour:
# violet`), they go to that door as they are, to complete the spell it holds.
def fielded(input: Card.Heard, first: Spell.Binding, found: Lists.Maybe<Learned>, context: Abi.Context, state: State) -> Activity<Heard>:
  match found:
    case some(l): passOn(l.value.card, {text: if l.value.form.action == first.name then Mentions.spellFor(l.value.card, l.value.form, input.fields) else input.text, post: input.post}, false, context, state)
    case none(_): unaddressed(input, context, state)
# Prose, which hob reads when there is a policy (the host's reach decides whether it was
# addressed at all: unaddressed prose is hob's `none` at once, with no model call). A principal's
# first reply is greeted, and its menu follows whatever hob drew.
def unaddressed(input: Card.Heard, context: Abi.Context, state: State) -> Activity<Heard>:
  if context.caller != "" then handedOn(input, context, state) else if greetedBefore(context.principal, state) == false then greeting(input, context, state) else reading(input, false, context, state)
def reading(input: Card.Heard, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  if Plans.isNobody(state.policy) then quiet(greet, input, Lists.List.nil(), context, state) else learning(input, Next.read({greet: greet}), Lists.List.nil(), doors(state), context, state)
# A reply a card handed on (it has no policy of its own) is read against that card's forms.
def handedOn(input: Card.Heard, context: Abi.Context, state: State) -> Activity<Heard>:
  if Plans.isNobody(state.policy) then Heard.silent({}) else callerRead(input, context, state)
def callerRead(input: Card.Heard, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.inspect({object: {world: context.world, object: context.caller}, source: false}):
    case inspected(i): consulted(input, {card: context.caller, forms: Lists.map(Card.offeredOnly(i.methods, i.offered), fn(f: Form.Form) -> Form.Form: Card.named(f, context.caller)), learned: Lists.List.nil()}, false, context, state)
    case _: Heard.silent({})
# What hob reads against: the card the words answered ("" for the root), its forms, and what was
# learned of the doors (to prune a menu).
record Reading:
  card: String
  forms: Lists.List<Form.Form>
  learned: Learning
def consulted(input: Card.Heard, read: Reading, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.view::<Policies.State>({object: state.policy}):
    case viewed(v): macroOr(input, v.state, Card.expanded(input.text, v.state), read, greet, context, state)
    case _: welcomed(greet, "", Heard.silent({}), context, state)
# A macro of the policy's that the prose matches goes to the card its expansion names (its
# second word), with no model call.
def macroOr(input: Card.Heard, policy: Policies.State, expanded: Lists.Maybe<String>, read: Reading, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match expanded:
    case some(e): byMacro(Mentions.wordAt(Text.words(e.value), 1n), e.value, input, greet, context, state)
    case none(_): interpreting(input, read, policy, greet, context, state)
def byMacro(card: String, text: String, input: Card.Heard, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  if card == "" || card == context.object then welcomed(greet, "", Heard.silent({}), context, state) else passOn(card, {text: text, post: input.post}, greet, context, state)
# hob reads the words once against the forms; the host fits its spell and answers the proposal
# with the card it names, or hob's `none`, `card` or `ask`.
def interpreting(input: Card.Heard, read: Reading, policy: Policies.State, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.interpret::<Data>(Card.interpretation(input.text, read.forms, state.policy, "", Card.misfitLine(input.misfit))):
    case proposal(p): proposed(p.object, p.method, p.argument, read.forms, policy, greet, context, state)
    case proposals(p): folding(p.items, Lists.List.nil(), "", policy, greet, context, state)
    case unclear(u): hobbed(Card.hobNeeds(u.needs, read.forms), input, read, policy, greet, context, state)
    case replied(r): hobbed(Card.hobSaid(r.text), input, read, policy, greet, context, state)
    case denied(_): refusing("policy", "The policy is not visible to you.", greet, context, state)
    case _: welcomed(greet, "", Heard.silent({}), context, state)
# hob's answer that is no spell: none is quiet (the hourly menu for a reply to the root itself),
# card the card answered (the menu at the root), ask hob's question over the nearest doors
# (at the root) or the card's first spell.
def hobbed(hob: Card.Hob, input: Card.Heard, read: Reading, policy: Policies.State, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match hob:
    case none(_): quiet(greet, input, read.learned, context, state)
    case card(_): if read.card == "" then Card.tell(Heard.menu({}), render(state, context)) else doorCard({world: context.world, object: read.card}, context)
    case ask(a): toldThen(asking(a.needs, input, read, context, state), Heard.unclear({needs: a.needs}), greet, context, state)
# hob's lines are fixed (VOICE's second miss), with only the fields the forms name.
def asking(needs: Form.Names, input: Card.Heard, read: Reading, context: Abi.Context, state: State) -> Document.Document:
  if read.card == "" then Menu.pruned(missLine(needs), nearest(input, read.learned, state), menu(state), state.news, context) else Card.askCard(needs, read.card, read.forms)
def missLine(needs: Form.Names) -> String:
  if Lists.length(needs) == 0n then "hob: no door takes that as said. The nearest:" else "hob: no door takes that as said; still needs {Text.joined(needs)}. The nearest:"
def nearest(input: Card.Heard, learned: Learning, state: State) -> Lists.List<Door>:
  let all = menu(state)
  let touched = touchedDoors(input, learned, state)
  if Lists.length(touched) == 0n then Lists.filter(all, fn(d: Door) -> Bool: Plans.isNobody(d.to) == false && Menu.isArc(all, d) == false) else touched
# A proposal runs on its door as this turn, unless the policy confirms that action first: then
# the speaker is shown the spell to send.
def proposed(object: String, method: String, argument: Data, forms: Lists.List<Form.Form>, policy: Policies.State, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  if Card.confirms(policy, method) then toldThen(Mentions.askedFirst(object, Lists.filter(forms, fn(f: Form.Form) -> Bool: f.card == object && f.action == method)), Heard.asked({card: object}), greet, context, state) else calling(object, method, argument, greet, context, state)
def calling(object: String, method: String, argument: Data, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.call::<Data>({object: {world: context.world, object: object}, method: method, argument: argument}):
    case returned(_): visited(object, Heard.passed({card: object}), greet, context, state)
    case denied(_): refusing("notVisible", "The card {object} is not visible to you.", greet, context, state)
    case refused(r): refusing(r.clause, if r.reading == "" then "Not done at {object}." else r.reading, greet, context, state)
# Several spells (docs/MENU.md §2.2): each item in order, as this turn, its call admitted or
# refused on its own (one the policy confirms is not run); the card lists each spell with what
# came of it, and the reader's door is the first admitted one's.
def folding(items: Lists.List<World.Proposed<Data>>, ran: Examples, first: String, policy: Policies.State, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match items:
    case nil(_): folded(ran, first, greet, context, state)
    case cons(c): foldOne(c.head, c.tail, ran, first, policy, greet, context, state)
def foldOne(item: World.Proposed<Data>, rest: Lists.List<World.Proposed<Data>>, ran: Examples, first: String, policy: Policies.State, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match item:
    case proposal(p): if Card.confirms(policy, p.method) then folding(rest, Lists.append(ran, {example: "delvetalk {p.object} {p.method}", comes: "asks first: reply with it filled in"}), first, policy, greet, context, state) else foldCall(p.object, p.method, p.argument, rest, ran, first, policy, greet, context, state)
    case unclear(u): folding(rest, Lists.append(ran, {example: "(spell {natText(Lists.length(ran) + 1n)})", comes: "unclear: {Text.joined(u.reasons)}"}), first, policy, greet, context, state)
def foldCall(object: String, method: String, argument: Data, rest: Lists.List<World.Proposed<Data>>, ran: Examples, first: String, policy: Policies.State, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  let spell = "delvetalk {object} {method}"
  match world.call::<Data>({object: {world: context.world, object: object}, method: method, argument: argument}):
    case returned(_): folding(rest, Lists.append(ran, {example: spell, comes: "admitted"}), if first == "" then object else first, policy, greet, context, state)
    case denied(_): folding(rest, Lists.append(ran, {example: spell, comes: "refused notVisible: The card {object} is not visible to you."}), first, policy, greet, context, state)
    case refused(r): folding(rest, Lists.append(ran, {example: spell, comes: Menu.refusedLine(r.clause, r.reading, object)}), first, policy, greet, context, state)
def folded(ran: Examples, first: String, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.offer({to: "", document: Menu.ran(ran)}):
    case _: visited(first, Heard.several({count: Lists.length(ran)}), greet, context, state)
def touchedDoors(input: Card.Heard, learned: Learning, state: State) -> Lists.List<Door>:
  let all = menu(state)
  Lists.filter(all, fn(d: Door) -> Bool: Plans.isNobody(d.to) == false && Menu.isArc(all, d) == false && Mentions.touches(Card.heard(input), d, learned))
# Nothing came of a reply: a first reply's menu; a reply to the directory itself, the menu
# pruned to the doors it named (all when none) under one line, once an hour per speaker
# (`missed`, 60 clock minutes), then quiet: a conversation in its thread costs at most one card
# an hour; a reply a card handed on, nothing.
def quiet(greet: Bool, input: Card.Heard, learned: Learning, context: Abi.Context, state: State) -> Activity<Heard>:
  if greet || context.caller != "" || missedLately(context, state) then welcomed(greet, "", Heard.silent({}), context, state) else heardNothing(touchedDoors(input, learned, state), context, state)
def heardNothing(touched: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Heard>:
  let all = menu(state)
  let written(_) = write {missed: upsert {principal: context.principal, at: context.clock}}
  Card.tell(Heard.menu({}), Menu.pruned(Mentions.nothingHead(), if Lists.length(touched) == 0n then Lists.filter(all, fn(d: Door) -> Bool: Menu.isArc(all, d) == false) else touched, all, state.news, context))
def missedLately(context: Abi.Context, state: State) -> Bool:
  match Relations.lookup(state.missed, {principal: context.principal}, Menu.missedKey):
    case some(m): context.clock < m.value.at + 60n
    case none(_): false
# For a card's default receive (Card.answerAs): whether a reply to it that fits no form is owed
# its usage card, under the same hourly bound; asking marks it.
def due(state: State, input: {}, context: Abi.Context) -> Activity<Bool>:
  if missedLately(context, state) then false else marked(context)
def marked(context: Abi.Context) -> Activity<Bool>:
  let written(_) = write {missed: upsert {principal: context.principal, at: context.clock}}
  true
# A link door (no object) answers with its description.
def linkDoor(door: Door) -> Activity<Heard>:
  Card.tell(Heard.door({object: ""}), Document.text("{door.label}\n{door.description}\n"))
def doorCard(to: Plans.Reference, context: Abi.Context) -> Activity<Heard>:
  match world.card({object: to}):
    case carded(c): Card.tell(Heard.door({object: to.object}), c.document)
    case _: Card.tell(Heard.refused({clause: "noCard", reading: "No card at {to.object}"}), Document.text("The door to {to.object} opens on nothing yet.\n"))
# The menu once per principal (the newest 2,048), under hob's greeting: with no policy at once;
# with one, after hob read the words.
def greeting(input: Card.Heard, context: Abi.Context, state: State) -> Activity<Heard>:
  let written(_) = write {greeted: insert {principal: context.principal}, missed: upsert {principal: context.principal, at: context.clock}}
  if Plans.isNobody(state.policy) then Card.tell(Heard.menu({}), greetingCard(state, context, "")) else reading(input, true, context, state)
