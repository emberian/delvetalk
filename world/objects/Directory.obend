edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Form.obend as Form
import ./Spell.obend as Spell
import ./World.obend as World
import ./Card.obend as Card
import ./Policies.obend as Policies
import ./Relation.obend as Relations
import ./Rows.obend as Rows
import ./Text.obend as Text
import ./Menu.obend as Menu
import ./Mentions.obend as Mentions
type Door = Menu.Door
type Examples = Menu.Examples
type News = Menu.News
type Visit = Menu.Visit
type Learned = Mentions.Learned
type Learning = Mentions.Learning
# A door as the directory keeps it: keyed by its label, with its place on the menu (the
# owner's order, which the card keeps; key order is not menu order).
record Listed:
  label: String
  description: String
  to: Plans.Reference
  examples: Examples
  watch: String
  place: Nat
type Greeting = Rows.Greeting
# doors: the menu, keyed {label}. greeted: the principals the menu has gone to once, keyed
# {principal} (each later summons gets one line). policy: the interpretation policy prose is
# read with (the town's model, offered the forms of every door); nobody means prose is not
# interpreted. news: each watched door's count. visits: each reader's last door (the newest 64
# readers), which their menu opens on.
record State:
  owner: String
  doors: Relations.Relation<Listed>
  greeted: Relations.Relation<Greeting>
  policy: Plans.Reference
  news: Relations.Relation<News>
  visits: Relations.Relation<Visit>
sum Answer:
  done: {}
  refused: Card.Refusal
# Only the owner adds or removes a door: the law judges every write (a stranger's add is
# refused with clause owner); anyone's summons only inserts into greeted (clause greeted). A
# law in source means a Directory is made with world-create, never by a creator that imports
# it. Past 4,096 greeted the host drops the oldest row, and insertOnly counts a dropped row as
# kept.
law owner "the owner never changes; only the owner changes the doors or the policy, and anyone else only by its methods": unchanged(owner) and (request.subject == new.owner or (request.kind == 0 and unchanged(doors) and unchanged(policy)))
law greeted "anyone's summons only adds to who was greeted": request.subject == new.owner or insertOnly(greeted)
def initial() -> State:
  {owner: "", doors: Relations.empty(), greeted: Relations.empty(), policy: Plans.nobody(), news: Relations.empty(), visits: Relations.empty()}
def relations() -> Relations.Decls:
  Lists.append(Lists.append(Lists.append(Lists.append(Relations.Decls.nil(), {field: "doors", key: Text.words("label"), limit: 64n}), {field: "greeted", key: Text.words("principal"), limit: 4096n}), {field: "news", key: Text.words("card"), limit: 64n}), {field: "visits", key: Text.words("principal"), limit: 64n})
def listedKey(listed: Listed) -> {label: String}:
  {label: listed.label}
def greetingKey(greeting: Greeting) -> Greeting:
  greeting
def doorOf(listed: Listed) -> Door:
  {label: listed.label, description: listed.description, to: listed.to, examples: listed.examples, watch: listed.watch}
# The doors in key order, for every walk whose order does not show; the card's menu is in
# place order (`menu`).
def doors(state: State) -> Lists.List<Door>:
  Relations.project(state.doors, doorOf)
def menu(state: State) -> Lists.List<Door>:
  Lists.map(Relations.order(state.doors, fn(l: Listed) -> Nat: l.place), doorOf)
def position(label: String, state: State) -> Lists.Maybe<Listed>:
  Relations.lookup(state.doors, {label: label}, listedKey)
def greetedBefore(principal: String, state: State) -> Bool:
  match Relations.lookup(state.greeted, greetingKey({principal: principal}), greetingKey):
    case some(_): true
    case none(_): false
def answerRefused(clause: String, reading: String) -> Answer:
  Answer.refused({clause: clause, reading: reading})
# Adds a door at the end of the menu (one place past the last); a label names one door. A door
# watching a field of its object reads the field's count now and subscribes the directory to
# it, as the owner's turn: each later change comes back as a delivery to the receiver for the
# field's rows, which keeps the door's news. A door whose object is not there yet watches
# nothing (add it again once the object is made).
def add(state: State, input: {door: Door}, context: Abi.Context) -> Activity<Answer>:
  match position(input.door.label, state):
    case some(_): answerRefused("doorTaken", "There is already a door called {input.door.label}")
    case none(_): standing(extend(input.door, {place: nextPlace(state)}), context)
def standing(door: Listed, context: Abi.Context) -> Activity<Answer>:
  if Plans.isNobody(door.to) || Menu.receiverOf(door.watch) == "" then added(door) else if door.watch == "ticks" then tickCount(door, context) else rowCount(door, context)
def tickCount(door: Listed, context: Abi.Context) -> Activity<Answer>:
  match world.viewField::<Nat>({object: door.to, field: "ticks"}):
    case viewed(v): watched(door, v.state, context)
    case _: added(door)
def rowCount(door: Listed, context: Abi.Context) -> Activity<Answer>:
  match world.viewField::<Relations.Relation<Data>>({object: door.to, field: door.watch}):
    case viewed(v): watched(door, Relations.count(v.state), context)
    case _: added(door)
def watched(door: Listed, count: Nat, context: Abi.Context) -> Activity<Answer>:
  let written(_) = write {doors: insert door, news: upsert {card: door.to.object, count: count, newest: "", at: context.clock}}
  Card.subscribing(door.to, door.watch, Menu.receiverOf(door.watch), Answer.done({}))
def added(door: Listed) -> Activity<Answer>:
  let written(_) = write {doors: insert door}
  Answer.done({})
# The receivers: a change counts only from the watched object itself (the host runs the
# delivery with it as caller) on a field a door watches. A relation's count moves by the rows
# inserted less those retracted (an upsert is both; a row the host's retention dropped is
# retracted); a tick count is the new value.
def changedNat(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Nat>, retracted: Lists.List<Nat>}, context: Abi.Context) -> Activity<Answer>:
  noted(input.object.object, input.field, Lists.fold(input.inserted, 0n, fn(n: Nat) -> Nat -> Nat: fn(_: Nat) -> Nat: n), "", context, state)
def changedChildren(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Child>, retracted: Lists.List<Rows.Child>}, context: Abi.Context) -> Activity<Answer>:
  moved(input.object.object, input.field, Lists.length(input.inserted), Lists.length(input.retracted), Menu.newestOf(Lists.map(input.inserted, fn(c: Rows.Child) -> String: c.object)), context, state)
def changedProposals(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Proposal>, retracted: Lists.List<Rows.Proposal>}, context: Abi.Context) -> Activity<Answer>:
  moved(input.object.object, input.field, Lists.length(input.inserted), Lists.length(input.retracted), Menu.newestOf(Lists.map(input.inserted, fn(p: Rows.Proposal) -> String: "#{natText(p.n)}")), context, state)
def changedHeld(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Held>, retracted: Lists.List<Rows.Held>}, context: Abi.Context) -> Activity<Answer>:
  moved(input.object.object, input.field, Lists.length(input.inserted), Lists.length(input.retracted), Menu.newestOf(Lists.map(input.inserted, fn(h: Rows.Held) -> String: "#{natText(h.n)} for {h.target}")), context, state)
def changedPresence(state: State, input: {object: Plans.Reference, field: String, version: Nat, inserted: Lists.List<Rows.Presence>, retracted: Lists.List<Rows.Presence>}, context: Abi.Context) -> Activity<Answer>:
  moved(input.object.object, input.field, Lists.length(input.inserted), Lists.length(input.retracted), "", context, state)
def moved(card: String, field: String, added: Nat, dropped: Nat, newest: String, context: Abi.Context, state: State) -> Activity<Answer>:
  let before = standingCount(card, state) + added
  noted(card, field, if before >= dropped then before - dropped else 0n, newest, context, state)
def standingCount(card: String, state: State) -> Nat:
  match Relations.lookup(state.news, {card: card}, Menu.newsKey):
    case some(n): n.value.count
    case none(_): 0n
def noted(card: String, field: String, count: Nat, newest: String, context: Abi.Context, state: State) -> Activity<Answer>:
  if context.caller != card || Lists.any(doors(state), fn(d: Door) -> Bool: d.to.object == card && d.watch == field) == false then Answer.done({}) else news({card: card, count: count, newest: newest, at: context.clock})
def news(row: News) -> Activity<Answer>:
  let written(_) = write {news: upsert row}
  Answer.done({})
def nextPlace(state: State) -> Nat:
  Lists.fold(Relations.rows(state.doors), 0n, fn(l: Listed) -> Nat -> Nat: fn(most: Nat) -> Nat: if l.place + 1n > most then l.place + 1n else most)
# remove {door: {label}}, as add takes {door}: neither is a form, so a reply's bare field lines
# are never the directory's own spell; they reach receive, which tries the doors' forms (a
# stranger's `label: moth` is prose to it, never refused by the owner's law).
def remove(state: State, input: {door: {label: String}}, context: Abi.Context) -> Activity<Answer>:
  match position(input.door.label, state):
    case none(_): answerRefused("noDoor", "There is no door called {input.door.label}")
    case some(l): removed(l.value, Relations.exists(state.news, fn(n: News) -> Bool: n.card == l.value.to.object))
# Removing a watched door drops its news and its subscription.
def removed(door: Listed, counted: Bool) -> Activity<Answer>:
  if counted then unwatched(door) else unlisted(door.label)
def unlisted(label: String) -> Activity<Answer>:
  let written(_) = write {doors: retract {label: label}}
  Answer.done({})
def unwatched(door: Listed) -> Activity<Answer>:
  let written(_) = write {doors: retract {label: door.label}, news: retract {card: door.to.object}}
  match world.unsubscribe({object: door.to, field: door.watch, method: Menu.receiverOf(door.watch)}):
    case _: Answer.done({})
# The menu as a trie (Menu.trie), opening on the reader's last door.
def render(state: State, context: Abi.Context) -> Document.Document:
  trie(state, context, lastDoor(state, context.principal))
def lastDoor(state: State, principal: String) -> String:
  match Relations.lookup(state.visits, {principal: principal}, Menu.visitKey):
    case some(v): v.value.door
    case none(_): ""
def trie(state: State, context: Abi.Context, first: String) -> Document.Document:
  Menu.trie(menu(state), state.news, context, first)
def methods() -> Lists.List<String>:
  Text.words("add remove")
def forms() -> Card.Forms:
  Card.Forms.nil()
def blurb() -> Card.Door:
  {word: "directory", blurb: "The doors of DelveTalk."}
# What the directory did with a reply.
sum Heard:
  passed: {card: String}
  door: {object: String}
  menu: {}
  silent: {}
  refused: Card.Refusal
  unclear: {needs: Form.Names}
  asked: {card: String}
def refusing(clause: String, reading: String, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  toldThen(Document.text("✾ DELVETALK · ROOT\n\nrefused {clause}: {reading}\n"), Heard.refused({clause: clause, reading: reading}), greet, context, state)
# The hub's reply. A spell naming another card never reaches here: the host runs it on that
# card as this turn (a reply to the hub post reaches the object it names). The owner is
# answered with silence; a door word gets that door's card; the menu goes to each principal
# once, and anything later that names no door, card or form gets nothing at all (no offer, so
# no draft: 137 one-line pointers in one rehearsal run were three times the posting quota).
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Heard>:
  if context.principal == state.owner && context.caller == "" then Heard.silent({}) else worded(input, doorFor(doors(state), Mentions.doorWord(input.text)), context, state)
# Calls a door's receive with a reply, as this turn; the door reads it as its own. `greet`: the
# reply is a principal's first (`greeting`), whose menu follows whatever the reply drew.
def passOn(card: String, input: {text: String, post: String}, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.call::<Data>({object: {world: context.world, object: card}, method: "receive", argument: input}):
    case returned(_): visited(card, Heard.passed({card: card}), greet, context, state)
    case denied(_): refusing("notVisible", "The card {card} is not visible to you.", greet, context, state)
    case refused(r): refusing(r.clause, if r.reading == "" then "Not passed to {card}." else r.reading, greet, context, state)
# The door a reply went through is the reader's last (its menu opens there); an arc's is its
# parent door's. Written only when it changes.
def visited(card: String, result: Heard, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match topDoorOf(card, state):
    case some(d): if d.value.label == lastDoor(state, context.principal) then welcomed(greet, d.value.label, result, context, state) else visit(d.value.label, result, greet, context, state)
    case none(_): welcomed(greet, "", result, context, state)
def visit(label: String, result: Heard, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  let written(_) = write {visits: upsert {principal: context.principal, door: label, at: context.clock}}
  welcomed(greet, label, result, context, state)
# A first reply's menu comes after what the reply drew, opening on the door it went through
# (`first`, "" for none).
def welcomed(greet: Bool, first: String, result: Heard, context: Abi.Context, state: State) -> Activity<Heard>:
  if greet then Card.tell(result, trie(state, context, first)) else result
def toldThen(document: Document.Document, result: Heard, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.offer({to: "", document: document}):
    case _: welcomed(greet, "", result, context, state)
def topDoorOf(card: String, state: State) -> Lists.Maybe<Door>:
  let all = menu(state)
  Lists.find(all, fn(d: Door) -> Bool: Plans.isNobody(d.to) == false && Menu.isArc(all, d) == false && (card == d.to.object || Text.starts(card, "{d.to.object}/")))
def doorFor(doors: Lists.List<Door>, word: String) -> Lists.Maybe<Door>:
  Lists.find(doors, fn(door: Door) -> Bool: word != "" && (door.label == word || door.to.object == word))
def worded(input: Card.Reply, found: Lists.Maybe<Door>, context: Abi.Context, state: State) -> Activity<Heard>:
  match found:
    case some(d): if Plans.isNobody(d.value.to) then linkDoor(d.value) else doorCard(d.value.to, context)
    case none(_): fieldsOrProse(input, context, state)
# Where the walk goes next: the field lines' door, the judging of prose, or a first greeting's
# prose (the menu, then the prose read as any other).
sum Next:
  fielded: {first: Spell.Binding}
  judged: {}
  greeting: {}
def fieldsOrProse(input: Card.Reply, context: Abi.Context, state: State) -> Activity<Heard>:
  match input.fields:
    case cons(c): learning(input, Next.fielded({first: c.head}), Lists.List.nil(), doors(state), context, state)
    case nil(_): unaddressed(input, context, state)
def learning(input: Card.Reply, next: Next, learned: Learning, doors: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Heard>:
  match doors:
    case nil(_): learnedAll(input, next, learned, context, state)
    case cons(c): if Plans.isNobody(c.head.to) then learning(input, next, learned, c.tail, context, state) else doorLearned(input, next, learned, c.head.to.object, c.tail, context, state)
def doorLearned(input: Card.Reply, next: Next, learned: Learning, door: String, rest: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.inspect({object: {world: context.world, object: door}}):
    case inspected(i): childListed(input, next, Lists.concat(learned, Mentions.learnedOf(door, door, false, i.methods)), door, rest, context, state)
    case _: childListed(input, next, learned, door, rest, context, state)
def childListed(input: Card.Reply, next: Next, learned: Learning, door: String, rest: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.objects({prefix: "{door}/", after: ""}):
    case listed(l): childLearned(input, next, learned, door, Lists.at(l.ids, 0n), rest, context, state)
    case refused(_): learning(input, next, learned, rest, context, state)
def childLearned(input: Card.Reply, next: Next, learned: Learning, door: String, child: Lists.Maybe<String>, rest: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Heard>:
  match child:
    case none(_): learning(input, next, learned, rest, context, state)
    case some(c): childInspected(input, next, learned, door, c.value, rest, context, state)
def childInspected(input: Card.Reply, next: Next, learned: Learning, door: String, child: String, rest: Lists.List<Door>, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.inspect({object: {world: context.world, object: child}}):
    case inspected(i): learning(input, next, Lists.concat(learned, Mentions.learnedOf(child, door, true, i.methods)), rest, context, state)
    case _: learning(input, next, learned, rest, context, state)
def learnedAll(input: Card.Reply, next: Next, learned: Learning, context: Abi.Context, state: State) -> Activity<Heard>:
  match next:
    case fielded(f): fielded(input, f.first, Lists.find(learned, fn(l: Learned) -> Bool: l.child == false && (l.form.action == f.first.name || Card.hasField(l.form, f.first.name))), context, state)
    case judged(_): judgedHandOn(input, learned, context, state)
    case greeting(_): if named(input, learned, Lists.List.nil(), state) then consulted(input, learned, true, context, state) else Card.tell(Heard.menu({}), render(state, context))
# Field lines with no delvetalk line (the gate's hour: `plant: … / colour: silver`, `rain: …`):
# when the first `name: value` line names an action one of the doors offers, the lines
# become that door's spell (the action line's value fills the form's first field the
# others leave open) and go to that door's receive. When it names a field of a door's form
# instead (`colour: violet`, answering "I still need: colour"), the lines go to that door's
# receive as they are, to complete the spell the door holds for the speaker.
def fielded(input: Card.Reply, first: Spell.Binding, found: Lists.Maybe<Learned>, context: Abi.Context, state: State) -> Activity<Heard>:
  match found:
    case some(l): passOn(l.value.card, {text: if l.value.form.action == first.name then Mentions.spellFor(l.value.card, l.value.form, input.fields) else input.text, post: input.post}, false, context, state)
    case none(_): unaddressed(input, context, state)
# Prose that names no door, card or field form: the menu once per principal; then, with a
# policy, the town's model reads it against every door's forms: a proposal goes to the door
# whose form it fits, a miss is asked once more, a second miss offers what is still needed
# and the policy's escalation copy; `unclear: not addressed` gets nothing at all.
# A reply a card handed on (context.caller is that card) gets no menu. Every prose reply,
# handed on or posted under the hub by someone already greeted, reaches the model only when
# it names a door word, a form action or a form field of the doors (`judged`).
def unaddressed(input: Card.Reply, context: Abi.Context, state: State) -> Activity<Heard>:
  if context.caller != "" then handedOn(input, context, state) else if greetedBefore(context.principal, state) == false then greeting(input, context, state) else handedOn(input, context, state)
def handedOn(input: Card.Reply, context: Abi.Context, state: State) -> Activity<Heard>:
  if Plans.isNobody(state.policy) then Heard.silent({}) else learning(input, Next.judged({}), Lists.List.nil(), doors(state), context, state)
# Prose naming none of the doors' words or fields is not read by the model (only the first
# 2,000 characters are looked at: a 5,142-character post once burned the budget). A reply handed
# on by a card does not count the words of that card's own family: its own actions and
# fields, and the door it lives under with that door's (a bell's thread talking of the
# garden, a cistern or rain is the bell's own business, not a request to another door).
def judgedHandOn(input: Card.Reply, learned: Learning, context: Abi.Context, state: State) -> Activity<Heard>:
  if context.caller == "" then judged(input, learned, Lists.List.nil(), context, state) else ownFamily(input, learned, context, state)
def ownFamily(input: Card.Reply, learned: Learning, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.inspect({object: {world: context.world, object: context.caller}}):
    case inspected(i): judged(input, learned, Lists.concat(Lists.concat(Mentions.formWords(i.methods), Mentions.formFields(i.methods)), Mentions.family(learned, familyDoor(context.caller, state))), context, state)
    case _: judged(input, learned, Lists.List.nil(), context, state)
def familyDoor(caller: String, state: State) -> Lists.Maybe<Door>:
  Lists.find(doors(state), fn(d: Door) -> Bool: Plans.isNobody(d.to) == false && (caller == d.to.object || Text.starts(caller, "{d.to.object}/")))
def judged(input: Card.Reply, learned: Learning, excluded: Lists.List<String>, context: Abi.Context, state: State) -> Activity<Heard>:
  if named(input, learned, excluded, state) then consulted(input, learned, false, context, state) else Heard.silent({})
def named(input: Card.Reply, learned: Learning, excluded: Lists.List<String>, state: State) -> Bool:
  Mentions.mentions(textTake(input.text, 2000n), input.fields, Mentions.without(Lists.concat(Mentions.allDoorWords(doors(state)), Mentions.formWords(Mentions.formsOf(learned))), excluded), Mentions.without(Lists.concat(Mentions.formFields(Mentions.formsOf(learned)), Mentions.knownFields()), excluded))
def consulted(input: Card.Reply, learned: Learning, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.view::<Policies.State>({object: state.policy}):
    case viewed(v): macroOr(input, v.state, Card.expanded(input.text, v.state), learned, greet, context, state)
    case _: welcomed(greet, "", Heard.silent({}), context, state)
# A macro of the policy's that the prose matches goes to the card its expansion names (its
# second word), with no model call.
def macroOr(input: Card.Reply, policy: Policies.State, expanded: Lists.Maybe<String>, learned: Learning, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match expanded:
    case some(e): byMacro(Mentions.wordAt(Text.words(e.value), 1n), e.value, input, greet, context, state)
    case none(_): interpreting(input, learned, policy, 0n, Form.Names.nil(), greet, context, state)
def byMacro(card: String, text: String, input: Card.Reply, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  if card == "" || card == context.object then welcomed(greet, "", Heard.silent({}), context, state) else passOn(card, {text: text, post: input.post}, greet, context, state)
# The model reads the prose against every door's forms; the host fits its spell and answers
# the proposal with the door it names, or what the spell lacks.
def interpreting(input: Card.Reply, learned: Learning, policy: Policies.State, attempt: Nat, needs: Form.Names, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.interpret::<Data>(Card.interpretation(input.text, Mentions.doorForms(learned), state.policy, policy, attempt, needs)):
    case proposal(p): proposed(p.object, p.method, p.argument, Mentions.doorForms(learned), policy, greet, context, state)
    case unclear(u): if Card.silentNeeds(u.needs) then welcomed(greet, "", Heard.silent({}), context, state) else missed(input, learned, policy, attempt, u.needs, greet, context, state)
    case replied(r): readBack(input, learned, policy, attempt, Card.prose(r.text), greet, context, state)
    case denied(_): refusing("policy", "The policy is not visible to you.", greet, context, state)
    case _: welcomed(greet, "", Heard.silent({}), context, state)
# A proposal runs on its door as this turn (the door's own method, under the speaker), unless
# the policy confirms that action first: then the speaker is shown the door's spell to send,
# and sending it is the yes.
def proposed(object: String, method: String, argument: Data, forms: Lists.List<Form.Form>, policy: Policies.State, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  if Card.confirms(policy, method) then toldThen(askedFirst(object, Lists.filter(forms, fn(f: Form.Form) -> Bool: f.card == object && f.action == method)), Heard.asked({card: object}), greet, context, state) else calling(object, method, argument, greet, context, state)
def calling(object: String, method: String, argument: Data, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match world.call::<Data>({object: {world: context.world, object: object}, method: method, argument: argument}):
    case returned(_): visited(object, Heard.passed({card: object}), greet, context, state)
    case denied(_): refusing("notVisible", "The card {object} is not visible to you.", greet, context, state)
    case refused(r): refusing(r.clause, if r.reading == "" then "Not done at {object}." else r.reading, greet, context, state)
def readBack(input: Card.Reply, learned: Learning, policy: Policies.State, attempt: Nat, fitted: Card.Fitted, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  match fitted:
    case miss(m): missed(input, learned, policy, attempt, m.needs, greet, context, state)
    case _: welcomed(greet, "", Heard.silent({}), context, state)
# A miss naming an action no door offers is answered at once; any other is asked once more,
# and the second is answered with the menu pruned to the doors the reply named (their words,
# actions or fields), what is still needed above it.
def missed(input: Card.Reply, learned: Learning, policy: Policies.State, attempt: Nat, needs: Form.Names, greet: Bool, context: Abi.Context, state: State) -> Activity<Heard>:
  if Mentions.unoffered(needs) then toldThen(nearestFor(Mentions.missedAction(needs), learned, needs), Heard.unclear({needs: needs}), greet, context, state) else if attempt == 0n then interpreting(input, learned, policy, 1n, needs, greet, context, state) else Card.unfitted(policy, input.text, needs, context, missCard(input, learned, needs, context, state), Heard.unclear({needs: needs}))
def missCard(input: Card.Reply, learned: Learning, needs: Form.Names, context: Abi.Context, state: State) -> Document.Document:
  let all = menu(state)
  let touched = Lists.filter(all, fn(d: Door) -> Bool: Plans.isNobody(d.to) == false && Menu.isArc(all, d) == false && Mentions.touches(input, d, learned))
  if Lists.length(touched) == 0n then Document.text(needsHead(needs)) else Menu.pruned(needsHead(needs), touched, all, state.news, context)
def needsHead(needs: Form.Names) -> String:
  "✾ DELVETALK · ROOT\n\nI could not fit that to a door. I still need: {Text.joined(needs)}.\n"
# The nearest door is one whose forms have an action resembling the miss; else a kind of card
# under a door that takes it (a garden's bell takes rain); else none is named.
def nearestFor(missed: String, learned: Learning, needs: Form.Names) -> Document.Document:
  match Lists.find(Mentions.doorForms(learned), fn(f: Form.Form) -> Bool: Mentions.resembles(f.action, missed)):
    case some(f): usageOf(f.value.card, Mentions.doorForms(learned), needs)
    case none(_): kindTaking(Lists.find(learned, fn(l: Learned) -> Bool: l.child && missed != "" && l.form.action == missed), missed, needs)
def kindTaking(found: Lists.Maybe<Learned>, missed: String, needs: Form.Names) -> Document.Document:
  match found:
    case some(l): noDoor(needs, Mentions.kindLine(l.value.card, missed))
    case none(_): noDoor(needs, "")
def noDoor(needs: Form.Names, kind: String) -> Document.Document:
  Document.text("✾ DELVETALK · ROOT\n\nNo door offers that ({Text.joined(needs)}).{kind}\n")
def usageOf(card: String, forms: Lists.List<Form.Form>, needs: Form.Names) -> Document.Document:
  Document.concat(Document.text("✾ DELVETALK · ROOT\n\nNo door offers that ({Text.joined(needs)}). The nearest is {card}:\n"), Card.usage(card, Lists.filter(forms, fn(f: Form.Form) -> Bool: f.card == card)))
# An action the policy confirms (a give, an offer, a reprogram) is not run from prose: the
# speaker is shown the door's spell, and sending it is the yes.
def askedFirst(card: String, forms: Lists.List<Form.Form>) -> Document.Document:
  Document.concat(Document.text("✾ DELVETALK · ROOT\n\nI understood this, and it asks first. To do it, reply with it filled in:\n"), Card.usage(card, forms))
# A link door (no object; genesis's STUDIO) answers with its description, which carries the
# URL; it has no card to ask for and no forms to read.
def linkDoor(door: Door) -> Activity<Heard>:
  Card.tell(Heard.door({object: ""}), Document.text("{door.label}\n{door.description}\n"))
def doorCard(to: Plans.Reference, context: Abi.Context) -> Activity<Heard>:
  match world.card({object: to}):
    case carded(c): Card.tell(Heard.door({object: to.object}), c.document)
    case _: Card.tell(Heard.refused({clause: "noCard", reading: "No card at {to.object}"}), Document.text("The door to {to.object} opens on nothing yet.\n"))
# The menu once per principal: the greeting is remembered (the newest 4,096 principals).
# A first reply gets the menu; when it also asks for something (it names a door, an action or
# a field) and there is a policy, the request is read as any later one first, and the menu
# follows what it drew, opening on the door a proposal went through (docs/MENU.md §2.2).
def greeting(input: Card.Reply, context: Abi.Context, state: State) -> Activity<Heard>:
  let written(_) = write {greeted: insert {principal: context.principal}}
  if Plans.isNobody(state.policy) then Card.tell(Heard.menu({}), render(state, context)) else learning(input, Next.greeting({}), Lists.List.nil(), doors(state), context, state)
