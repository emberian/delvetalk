edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Place.obend as Place
import ./Form.obend as Form
import ./Card.obend as Card
record State:
  name: String
  description: String
  holder: Plans.Reference
  location: Plans.Reference
# A creator supplies a Seed; seeded makes the child's State from it.
record Seed:
  name: String
  description: String
  holder: Plans.Reference
  location: Plans.Reference
record Edits:
  holder: Plans.Edit<Plans.Reference, {}>
  location: Plans.Edit<Plans.Reference, {}>
# Its calls into places and avatars carry nothing: the place reads the thing from its
# caller and the person from the principal.
type Plan = Plans.Plan<Edits>
# A view reads the place the thing lies in; a call answers with the place's Done.
type Response = Plans.Response<Place.State, Place.Done>
def defaultSeed() -> Seed:
  {name: "", description: "", holder: Plans.nobody(), location: Plans.nobody()}
def seeded(seed: Seed) -> State:
  {name: seed.name, description: seed.description, holder: seed.holder, location: seed.location}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {holder: Plans.Edit::<Plans.Reference, {}>.keep({}), location: Plans.Edit::<Plans.Reference, {}>.keep({})}
def held(context: Abi.Context, holder: Plans.Reference, location: Plans.Reference) -> Activity<Plan, Response, Place.Done>:
  match perform(Plan.write({object: Plans.self(context), edits: {holder: Plans.Edit::<Plans.Reference, {}>.set({value: holder}), location: Plans.Edit::<Plans.Reference, {}>.set({value: location})}})):
    case written(_): Place.Done.done({})
    case _: Place.Done.refused({reason: "The write was not answered."})
# Pick the thing up from its place: view the place, have it release the thing,
# then record the holder. Only an unheld thing can be acquired.
def person(context: Abi.Context) -> Plans.Reference:
  {world: context.world, object: context.principal}
def acquire(state: State, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  if Plans.isNobody(state.holder) == false then Place.Done.refused({reason: textConcat("Already held by ", state.holder.object)}) else look(state, person(context), context)
def look(state: State, by: Plans.Reference, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  match perform(Plan.view({object: state.location})):
    case viewed(v): lying(state, by, context, v.state)
    case denied(_): Place.Done.refused({reason: "The place is not visible."})
    case _: Place.Done.refused({reason: "The place did not answer."})
def lying(state: State, by: Plans.Reference, context: Abi.Context, place: Place.State) -> Activity<Plan, Response, Place.Done>:
  match Plans.indexOf(place.things, Plans.self(context)):
    case none(_): Place.Done.refused({reason: "It is not lying in its place."})
    case some(_): lift(state, by, context)
def lift(state: State, by: Plans.Reference, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  match perform(Plan.call({object: state.location, method: "take", argument: Plans.nothing()})):
    case returned(r): taken(r.result, state, by, context)
    case _: Place.Done.refused({reason: "The place did not answer."})
def taken(result: Place.Done, state: State, by: Plans.Reference, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  match result:
    case done(_): carried(state, by, context)
    case refused(_): result
# The holder's avatar records what it now carries; hold never refuses.
def carried(state: State, by: Plans.Reference, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  match perform(Plan.call({object: by, method: "hold", argument: Plans.nothing()})):
    case _: held(context, by, state.location)
# Put the thing down where the holder stands (at): the place must accept it.
def drop(state: State, input: {at: Plans.Reference}, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  if Plans.same(state.holder, person(context)) == false then Place.Done.refused({reason: "You are not holding it."}) else setDown(state, person(context), input.at, context)
def setDown(state: State, by: Plans.Reference, at: Plans.Reference, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  match perform(Plan.call({object: at, method: "put", argument: Plans.nothing()})):
    case returned(r): placed(r.result, by, at, context)
    case _: Place.Done.refused({reason: "The place did not answer."})
def placed(result: Place.Done, by: Plans.Reference, at: Plans.Reference, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  match result:
    case done(_): dropped(by, at, context)
    case refused(_): result
def dropped(by: Plans.Reference, at: Plans.Reference, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  match perform(Plan.call({object: by, method: "release", argument: Plans.nothing()})):
    case _: held(context, Plans.nobody(), at)
# Hand the thing to someone else. The giver is the avatar of the principal.
# The recipient's avatar holds it and, since it came from somebody else, notes who.
def give(state: State, input: {to: Plans.Reference}, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  if Plans.same(state.holder, person(context)) == false then Place.Done.refused({reason: "You are not holding it."}) else letGo(state, input.to, person(context), context)
def letGo(state: State, to: Plans.Reference, from: Plans.Reference, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  match perform(Plan.call({object: from, method: "release", argument: Plans.nothing()})):
    case _: handOver(state, to, from, context)
def handOver(state: State, to: Plans.Reference, from: Plans.Reference, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  match perform(Plan.call({object: to, method: "hold", argument: Plans.nothing()})):
    case _: held(context, to, state.location)
def holding(state: State) -> String:
  if Plans.isNobody(state.holder) then "Nobody holds it." else textConcat("Held by ", textConcat(Card.handle(state.holder.object), "."))
def render(state: State) -> Document.Document:
  Document.text(textConcat(state.name, textConcat("\n", textConcat(state.description, textConcat("\n", textConcat(holding(state), "\n"))))))
def forms() -> Card.Forms:
  Card.Forms.cons({head: {card: "", action: "acquire", fields: Form.Fields.nil()}, tail: Card.Forms.cons({head: {card: "", action: "give", fields: Form.Fields.cons({head: {name: "to", kind: Form.Kind.text({min: 1n, max: 128n})}, tail: Form.Fields.nil()})}, tail: Card.Forms.nil()})})
def door() -> Card.Door:
  {word: "thing", blurb: "Pick it up, put it down, give it away."}
# A spell's `to` names the recipient's avatar, which is the recipient's DID.
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  heard(state, Card.route(input.text, context, forms()), context)
def heard(state: State, routed: Card.Routed, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  match routed:
    case act(a): if a.action == "acquire" then acquire(state, context) else give(state, {to: {world: context.world, object: Card.text(a.fields, "to")}}, context)
    case _: Card.answerAs::<Edits, Place.State, Place.Done, Place.Done>(routed, context, forms(), render(state), Place.Done.refused({reason: Card.reason(routed)}))
