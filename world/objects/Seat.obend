edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Card.obend as Card
import ./Seats.obend as Seats
# One player's seat. commit seals a digest of (table, round, seat, source, target,
# nonce) in a turn whose intent is Seats.commitIntent, so the opponent's reveal can
# await exactly that slot: the reveal opens the move only once the opponent's
# commitment is admitted, and suspends until it is.
type State = Seats.State
record Seed:
  table: Plans.Reference
  seat: Nat
  owner: String
  opponent: String
  rival: Plans.Reference
record Edits:
  round: Plans.Edit<Nat, Nat>
  digest: Plans.Edit<String, {}>
  opened: Plans.Edit<Bool, {}>
  source: Plans.Edit<Nat, {}>
  target: Plans.Edit<Nat, {}>
type Plan = Plans.Plan<Edits>
type Response = Plans.Response<State, {}>
def defaultSeed() -> Seed:
  {table: Plans.nobody(), seat: 0n, owner: "", opponent: "", rival: Plans.nobody()}
def seeded(seed: Seed) -> State:
  {table: seed.table, seat: seed.seat, owner: seed.owner, opponent: seed.opponent, rival: seed.rival, round: 0n, digest: "", opened: false, source: 0n, target: 0n}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {round: Plans.Edit::<Nat, Nat>.keep({}), digest: Plans.Edit::<String, {}>.keep({}), opened: Plans.Edit::<Bool, {}>.keep({}), source: Plans.Edit::<Nat, {}>.keep({}), target: Plans.Edit::<Nat, {}>.keep({})}
type Done = Seats.Done
def framed(text: String) -> String:
  textConcat(natText(textLength(text)), textConcat(":", text))
def commitment(table: String, round: Nat, seat: Nat, source: Nat, target: Nat, nonce: String) -> String:
  sha256Text(textConcat(framed("delvetalk.automatafl.commit.v2"), textConcat(framed(table), textConcat(framed(natText(round)), textConcat(framed(natText(seat)), textConcat(framed(natText(source)), textConcat(framed(natText(target)), framed(nonce))))))))
def hex(text: String) -> Bool:
  textLength(text) == 64n && textSpan(text, "0123456789abcdef") == 64n
def mine(state: State, round: Nat, context: Abi.Context) -> String:
  if context.principal != state.owner then textConcat("This seat is ", Card.handle(state.owner)) else if round != state.round then textConcat("The round is ", natText(state.round)) else ""
def commit(state: State, input: {round: Nat, digest: String}, context: Abi.Context) -> Activity<Plan, Response, Done>:
  if mine(state, input.round, context) != "" then Done.refused({reason: mine(state, input.round, context)}) else if state.digest != "" then Done.refused({reason: "Already sealed this round."}) else if hex(input.digest) == false then Done.refused({reason: "A digest is 64 lower-case hex characters."}) else if context.intent != Seats.commitIntent(state.table.object, state.round) then Done.refused({reason: textConcat("Seal in the turn named ", Seats.commitIntent(state.table.object, state.round))}) else sealed(input.digest, context)
def sealed(digest: String, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {digest: Plans.Edit::<String, {}>.set({value: digest})})})):
    case _: Done.committed({})
# Open the move: it must match the seal, and the opponent's commitment must be admitted;
# until it is, the turn waits on the opponent's slot.
def reveal(state: State, input: {round: Nat, source: Nat, target: Nat, nonce: String}, context: Abi.Context) -> Activity<Plan, Response, Done>:
  if mine(state, input.round, context) != "" then Done.refused({reason: mine(state, input.round, context)}) else if state.digest == "" || state.opened then Done.refused({reason: "Nothing sealed to open."}) else if commitment(state.table.object, state.round, state.seat, input.source, input.target, input.nonce) != state.digest then Done.refused({reason: "The opening does not match the seal."}) else awaiting(state, input.source, input.target, context)
def awaiting(state: State, source: Nat, target: Nat, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match perform(Plan.await({slot: {principal: state.opponent, intent: Seats.commitIntent(state.table.object, state.round)}, patience: 64n})):
    case reply(r): answered(state, r.receipt.outcome, source, target, context)
    case timedOut(_): Done.refused({reason: "The opponent did not seal in time."})
    case _: Done.refused({reason: "The opponent's seal is unknown."})
# Any admitted turn of the opponent under that intent settles the slot, so the seal
# itself is read from the rival seat before the move is opened.
def answered(state: State, outcome: Plans.Outcome, source: Nat, target: Nat, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match outcome:
    case admitted(_): checked(state, source, target, context)
    case refused(_): Done.refused({reason: "The opponent's seal was refused."})
def checked(state: State, source: Nat, target: Nat, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match perform(Plan.view({object: state.rival})):
    case viewed(v): if v.state.round == state.round && v.state.digest != "" then opening(source, target, context) else Done.refused({reason: "The opponent has not sealed this round."})
    case _: Done.refused({reason: "The opponent's seat did not answer."})
def opening(source: Nat, target: Nat, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {opened: Plans.Edit::<Bool, {}>.set({value: true}), source: Plans.Edit::<Nat, {}>.set({value: source}), target: Plans.Edit::<Nat, {}>.set({value: target})})})):
    case _: Done.opened({})
# The table, having resolved, moves every seat to the next round.
def next(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  if context.caller != state.table.object then Done.refused({reason: "Only the table moves the round."}) else nextRound(state, context)
def nextRound(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match perform(Plan.write({object: Plans.self(context), edits: {round: Plans.Edit::<Nat, Nat>.add({delta: 1n}), digest: Plans.Edit::<String, {}>.set({value: ""}), opened: Plans.Edit::<Bool, {}>.set({value: false}), source: Plans.Edit::<Nat, {}>.set({value: 0n}), target: Plans.Edit::<Nat, {}>.set({value: 0n})}})):
    case _: Done.next({round: state.round + 1n})
# A seal is made off the town's posts (the move stays private): the card shows status.
def forms() -> Card.Forms:
  Card.Forms.nil()
def door() -> Card.Door:
  {word: "seat", blurb: "Your seat at a commit-reveal table."}
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  Card.answer::<Edits, State, {}>(Card.route(input.text, context, forms()), context, forms(), render(state))
def render(state: State) -> Document.Document:
  Document.text(textConcat(Card.handle(state.owner), textConcat("'s seat, round ", textConcat(natText(state.round), textConcat(": ", textConcat(if state.opened then textConcat("opened ", textConcat(natText(state.source), textConcat(" to ", natText(state.target)))) else if state.digest != "" then "sealed" else "choosing", "\n"))))))
