edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Form.obend as Form
import ./Card.obend as Card
# The reference activity the host's own suites time. It follows the card protocol: a
# turn's packet carries only what its entry reaches, and 200 HTTP bumps took 0.50 s on
# hbox with Card in the closure against 0.39 s without (test_http's bound is 10 s).
record State:
  count: Nat
# A creator supplies a Seed; seeded makes the child's State from it.
type Seed = {}
record Edits:
  count: Plans.Edit<Nat, Nat>
type Plan = Plans.Plan<Edits>
type Response = Plans.Response<State, Nat>
def defaultSeed() -> Seed:
  {}
def seeded(seed: Seed) -> State:
  {count: 0n}
def initial() -> State:
  seeded(defaultSeed())
def bumped<T>(state: State, context: Abi.Context, then: Nat -> T) -> Activity<Plan, Response, T>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: {count: Plans.Edit.add({delta: 1n})}}))
  then(state.count + 1n)
def bump(state: State, context: Abi.Context) -> Activity<Plan, Response, Nat>:
  bumped(state, context, fn(count: Nat) -> Nat: count)
form bump:
def forms() -> Card.Forms:
  Card.Forms.cons({head: bumpForm(), tail: Card.Forms.nil()})
def door() -> Card.Door:
  {word: "counter", blurb: "Bump it; everyone shares the count."}
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  heard(state, Card.routeHeard(input, context, forms()), context)
def heard(state: State, routed: Card.Routed, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  match routed:
    case act(a): bumped(state, context, fn(count: Nat) -> Card.Reply: Card.Reply.done({action: "bump"}))
    case _: Card.answer(routed, context, forms(), render(state, context))
# The card as the reader in the context sees it: the count is everyone's.
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.text("Count: {natText(state.count)}")
def card(state: State) -> String:
  Document.plain(render(state, Card.stranger()))
