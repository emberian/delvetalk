edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Spell.obend as Spell
import ./Form.obend as Form
import ./List.obend as Lists
import ./Bell.obend as Bell
import ./Cistern.obend as Cistern
import ./Card.obend as Card
# A proposal the garden understood from a principal and is waiting to hear "yes" to.
record Pending:
  principal: String
  spell: String
# children: the bells planted here, oldest first, written on each create.
# confirm: whether a proposal understood from prose waits for "yes" (the garden's
# stance; the policy only interprets).
# owner: the human who owns the garden's wiki page (its `merge` checkpoints it, and only
# the owner changes confirm). pageCheckpoint: the post the last merge answered.
record State:
  owner: String
  planted: Nat
  policy: Plans.Reference
  confirm: Bool
  pending: Lists.List<Pending>
  children: Lists.List<Plans.Reference>
  pageCheckpoint: String
record Edits:
  planted: Plans.Edit<Nat, Nat>
  confirm: Plans.Edit<Bool, {}>
  pending: Plans.Entries<Pending, Pending>
  children: Plans.Entries<Plans.Reference, {}>
  pageCheckpoint: Plans.Edit<String, {}>
# A creator supplies a Seed; the host lays it over initial(). The garden's own creates
# carry Data: a Bell.Seed, and nothing for a cistern.
record Seed:
  owner: String
  policy: Plans.Reference
  confirm: Bool
  pending: Lists.List<Pending>
type Plan = Plans.Plan<Edits>
# What plant takes, and so what an interpretation proposes: the host checks the
# proposal's argument against plant's input type. A proposal is plain JSON, which has
# no variants, so the colour is its name and the garden reads it.
record Planting:
  colour: String
  seed: String
# The garden views nothing; interpret names the policy by reference.
type Response = Plans.Response<State, Planting>
# Anyone plants, rains and replies; only the owner changes who owns it, its stance, its
# policy or its page checkpoint (a set or a merge from anyone else is refused in Bend
# first, by name; this law refuses the same write proposed any other way).
law owner: request.subject == new.owner or (request.kind == 0 and unchanged(owner) and unchanged(confirm) and unchanged(policy) and unchanged(pageCheckpoint))
def defaultSeed() -> Seed:
  {owner: "", policy: Plans.nobody(), confirm: true, pending: Lists.List::<Pending>.nil()}
def seeded(seed: Seed) -> State:
  {owner: seed.owner, planted: 0n, policy: seed.policy, confirm: seed.confirm, pending: seed.pending, children: Lists.List::<Plans.Reference>.nil(), pageCheckpoint: ""}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {planted: Plans.Edit::<Nat, Nat>.keep({}), confirm: Plans.Edit::<Bool, {}>.keep({}), pageCheckpoint: Plans.Edit::<String, {}>.keep({}), pending: Plans.Entries::<Pending, Pending>.keep({}), children: Plans.Entries::<Plans.Reference, {}>.keep({})}
sum Made:
  made: {object: Plans.Reference}
  refused: {clause: String}
# Bells are minted: an empty requireAbsent lets the host choose <garden>/bell/<n>, and the
# garden records the reference created {object} answers. The cistern has a chosen name,
# <garden>/cistern, so a second is refused requiredAbsence (the §10 refusal).
def minted() -> Plans.Reference:
  {world: "", object: ""}
def chosen(context: Abi.Context, name: String) -> Plans.Reference:
  {world: "", object: textConcat(context.object, textConcat("/", name))}
# The post that plants (input.post) is what the bell's strike later awaits (awaitPost):
# the reply that answers it. Planting directly, with no post, leaves the bell nothing to
# await. The planter is the turn's principal, never anything the caller wrote.
# Plant directly: the same create, count and card as a spell's, without a reply.
def plant(state: State, input: Planting, context: Abi.Context) -> Activity<Plan, Response, Reply>:
  named(state, context, "", Held.none({}), false, input.colour, input.seed)
# One cistern per garden: the second create finds garden/cistern occupied.
def cistern(state: State, input: {}, context: Abi.Context) -> Activity<Plan, Response, Made>:
  match perform(Plan.create({package: "Cistern", seed: Plans.nothing(), law: "Cistern", requireAbsent: chosen(context, "cistern")})):
    case created(c): Made.made({object: c.object})
    case refused(r): Made.refused({clause: r.clause})
    case _: Made.refused({clause: "no creation"})
# The form the garden offers for planting, as data the Spell module checks a reply
# against. The card is named by the object the reply answers.
def plantForm(context: Abi.Context) -> Form.Form:
  Card.named(planting(), context.object)
def planting() -> Form.Form:
  {card: "", action: "plant", fields: Form.Fields.cons({head: {name: "colour", kind: Form.Kind.choice({options: Lists.append::<String>(Lists.append::<String>(Lists.append::<String>(Form.Names.nil(), "amber"), "violet"), "silver")})}, tail: Form.Fields.cons({head: {name: "seed", kind: Form.Kind.text({min: 1n, max: 80n})}, tail: Form.Fields.nil()})})}
# A reader with a proposal waiting is reminded of it, first.
def waiting(state: State, context: Abi.Context) -> String:
  match heldBy(state.pending, context.principal, 0n):
    case some(s): textConcat(Card.name(context.principal, context), textConcat(", this waits for your yes:\n\n", textConcat(s.spell, "\n")))
    case none(_): ""
def childLine(reference: Plans.Reference) -> Document.Document:
  Document.text(textConcat("- ", textConcat(reference.object, "\n")))
# The garden card: how to plant first (readers clip near 1,400 characters), then the
# bells, newest first, eight of them and a count of the rest.
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  let head = Document.text(textConcat("✾ THE NIGHT GARDEN\n\n", textConcat(waiting(state, context), textConcat("To plant, reply:\n\n    delvetalk ", textConcat(if context.object == "" then "garden" else context.object, textConcat(" plant\n    seed: <what might grow here, 1 to 80 characters>\n    colour: <amber, violet or silver>\n\n", textConcat(Card.checkpointLine(state.pageCheckpoint), textConcat(natText(state.planted), " planted, newest first:\n"))))))))
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: Card.clipped(Lists.map::<Plans.Reference, Document.Document>(Lists.reverse::<Plans.Reference>(state.children), childLine), 8n)})})
# The garden's page: its card, how to reply, then one section per bell, newest first,
# sixteen of them; the card section counts the rest.
def page(state: State, context: Abi.Context) -> Card.Page:
  let bells = Lists.reverse::<Plans.Reference>(state.children)
  let shown = Lists.map::<Plans.Reference, Card.Section>(Lists.take::<Plans.Reference>(bells, 16n), fn(bell: Plans.Reference) -> Card.Section: {title: bell.object, body: Document.text(textConcat("A bell planted here: [[", textConcat(bell.object, "]]. Reply on its card to rain on it.\n")))})
  let more = if Lists.length::<Plans.Reference>(bells) > 16n then textConcat("… and ", textConcat(natText(Lists.length::<Plans.Reference>(bells) - 16n), " more bells\n")) else ""
  Lists.concat::<Card.Section>(Card.defaultPage(Document.concat(render(state, context), Document.text(more)), context, forms()), shown)
# Publishes the page as one agentwiki post (`wiki: <id>` and its sections).
def publish(state: State, context: Abi.Context) -> Activity<Plan, Response, String>:
  match perform(Plan.publish({page: "", section: "", body: Card.pageText(page(state, context))})):
    case published(p): p.post
    case refused(r): r.clause
    case _: ""
def forms() -> Card.Forms:
  Card.Forms.cons({head: planting(), tail: Card.Forms.cons({head: digging(), tail: Card.Forms.nil()})})
# The cistern form: the garden's one cistern, at garden/cistern, keeps refusals. Its
# name is what the digger calls it (`cistern: a stone cistern for refused proposals`).
def digging() -> Form.Form:
  {card: "", action: "cistern", fields: Form.Fields.cons({head: {name: "name", kind: Form.Kind.text({min: 0n, max: 120n})}, tail: Form.Fields.nil()})}
# A spell to the garden plants, or digs the cistern.
def spelled(state: State, context: Abi.Context, post: String, action: String, parsed: Spell.Parsed, found: Held) -> Activity<Plan, Response, Reply>:
  if action == "cistern" then dig(context, found, Spell.fit(parsed, Card.named(digging(), context.object))) else judged(state, context, post, parsed, false, found)
def dig(context: Abi.Context, found: Held, fit: Spell.Fit) -> Activity<Plan, Response, Reply>:
  match fit:
    case proposal(_): digging2(context, found)
    case unclear(u): told(found, context, Reply.unclear({needs: u.needs}), needsCard(u.needs))
    case refused(r): told(found, context, Reply.refused({reason: r.reason}), refusedCard(r.reason))
def digging2(context: Abi.Context, found: Held) -> Activity<Plan, Response, Reply>:
  match perform(Plan.create({package: "Cistern", seed: Plans.nothing(), law: "Cistern", requireAbsent: chosen(context, "cistern")})):
    case created(c): told(found, context, Reply.dug({object: c.object}), Document.text(textConcat("✾ THE NIGHT GARDEN\n\nThe cistern is dug at ", textConcat(c.object.object, ". It keeps refusals.\n"))))
    case refused(r): told(found, context, Reply.refused({reason: r.clause}), refusedCard(r.clause))
    case _: told(found, context, Reply.refused({reason: "The garden could not dig it."}), refusedCard("The garden could not dig it."))
def door() -> Card.Door:
  {word: "garden", blurb: "Plant something; rain on another's planting. Things remember who helped them grow."}
# What the town says to the garden is a Card.Heard: the reply text and the post it
# is in. Who wrote it is the turn's principal; the planting slot is the turn's intent.
sum Reply:
  planted: {object: Plans.Reference, colour: String, seed: String}
  unclear: {needs: Form.Names}
  refused: {reason: String}
  confirming: {spell: String}
  cleared: {}
  shown: {}
  merged: {post: String}
  dug: {object: Plans.Reference}
  changed: {}
  silent: {}
# A colour by name, or none: a name outside the three is refused, never defaulted.
def colourNamed(name: String) -> Lists.Maybe<Bell.Colour>:
  if name == "amber" then Lists.Maybe::<Bell.Colour>.some({value: Bell.Colour.amber({})}) else if name == "violet" then Lists.Maybe::<Bell.Colour>.some({value: Bell.Colour.violet({})}) else if name == "silver" then Lists.Maybe::<Bell.Colour>.some({value: Bell.Colour.silver({})}) else Lists.Maybe::<Bell.Colour>.none({})
def spell(card: String, seed: String, colour: String) -> String:
  textConcat("    delvetalk ", textConcat(card, textConcat(" plant\n    seed: ", textConcat(seed, textConcat("\n    colour: ", textConcat(colour, "\n"))))))
def plantedCard(context: Abi.Context, who: String, reference: Plans.Reference, colour: String, seed: String, count: Nat) -> Document.Document:
  let what = textConcat("Planted for ", textConcat(who, textConcat(if colour == "amber" then ": an " else ": a ", textConcat(colour, textConcat(" bell, “", textConcat(seed, "”."))))))
  let where = textConcat("It lives at ", textConcat(reference.object, textConcat(". The garden now holds ", textConcat(natText(count), " planted."))))
  Document.text(textConcat("✾ THE NIGHT GARDEN\n\n", textConcat(what, textConcat("\n", textConcat(where, textConcat("\n\nTo plant another, reply:\n\n", spell(context.object, "a fern that remembers yesterday", "silver")))))))
def unclearCard(context: Abi.Context, needs: Form.Names, parsed: Spell.Parsed) -> Document.Document:
  Document.text(textConcat("✾ THE NIGHT GARDEN\n\nAlmost. I still need: ", textConcat(Spell.joined(needs), textConcat(".\nReply with the spell, filled in:\n\n", spell(context.object, filled(parsed, "seed", "<what might grow here, 1 to 80 characters>"), filled(parsed, "colour", "<amber, violet or silver>"))))))
def filled(parsed: Spell.Parsed, name: String, hint: String) -> String:
  match parsed:
    case spell(s): if Spell.valueOf(s.fields, name) == "" then hint else Spell.valueOf(s.fields, name)
    case notASpell(_): hint
def refusedCard(reason: String) -> Document.Document:
  Document.text(textConcat("Not planted: ", textConcat(reason, "\n")))
# The proposal a principal has waiting, if any: the stored item (amended and removed
# by its bytes, so another principal's proposal landing first moves nothing) and its spell.
sum Held:
  none: {}
  some: {item: Pending, spell: String}
def heldBy(items: Lists.List<Pending>, principal: String, index: Nat) -> Held:
  match items:
    case nil(_): Held.none({})
    case cons(c): if c.head.principal == principal then Held.some({item: c.head, spell: c.head.spell}) else heldBy(c.tail, principal, index + 1n)
# What a reply to a waiting proposal says: yes, no or anything else. Only a short
# reply is examined; it is one word between blanks, in one of three spellings.
sum Word:
  yes: {}
  no: {}
  other: {}
def wordOf(text: String) -> Word:
  if textLength(text) > 64n then Word.other({}) else worded(textDrop(text, textSpan(text, " \n\t\r")))
def worded(rest: String) -> Word:
  let core = textTake(rest, textBreak(rest, " \n\t\r"))
  if textSpan(textDrop(rest, textLength(core)), " \n\t\r") + textLength(core) == textLength(rest) then classed(core) else Word.other({})
def classed(core: String) -> Word:
  if core == "yes" || core == "Yes" || core == "YES" || core == "y" then Word.yes({}) else if core == "no" || core == "No" || core == "NO" || core == "n" then Word.no({}) else Word.other({})
# Every observed spell arrives here. A principal with a proposal waiting is first
# heard as answering it; otherwise the text parses, fits the plant form, plants on a
# proposal and writes nothing; it always ends by offering a reply card.
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Reply>:
  if Card.isMerge(input.text) then Card.merge::<Edits, State, Planting, Reply>(input.post, state.owner, context, fn(post: String) -> Edits: extend(keep(), {pageCheckpoint: Plans.Edit::<String, {}>.set({value: post})}), Reply.merged({post: input.post}), fn(reason: String) -> Reply: Reply.refused({reason: reason})) else heard(state, input, context, heldBy(state.pending, context.principal, 0n))
def heard(state: State, input: Card.Heard, context: Abi.Context, found: Held) -> Activity<Plan, Response, Reply>:
  match found:
    case none(_): hear(state, input, context, Spell.parse(input.text), found)
    case some(s): replied(state, input, context, found, s.spell)
# Yes plants what was stored; no drops it; anything else is heard afresh and
# replaces the stored proposal (or drops it when it proposes nothing).
def replied(state: State, input: Card.Heard, context: Abi.Context, found: Held, stored: String) -> Activity<Plan, Response, Reply>:
  match wordOf(input.text):
    case yes(_): confirmed(state, input, context, found, stored)
    case no(_): told(found, context, Reply.cleared({}), Document.text("✾ THE NIGHT GARDEN\n\nI dropped what I understood.\n"))
    case other(_): hear(state, input, context, Spell.parse(input.text), found)
def confirmed(state: State, input: Card.Heard, context: Abi.Context, found: Held, stored: String) -> Activity<Plan, Response, Reply>:
  match Spell.fit(Spell.parse(stored), plantForm(context)):
    case proposal(p): named(state, context, input.post, found, false, Card.text(p.bindings, "colour"), Card.text(p.bindings, "seed"))
    case _: told(found, context, Reply.refused({reason: "I could not read what I had understood."}), refusedCard("I could not read what I had understood."))
def hear(state: State, input: Card.Heard, context: Abi.Context, parsed: Spell.Parsed, found: Held) -> Activity<Plan, Response, Reply>:
  match parsed:
    case notASpell(_): if textSpan(input.text, " \n\t\r") == textLength(input.text) then tell(Reply.shown({}), render(state, context)) else bared(state, input, context, Card.withBare(parsed, input.text, context, forms()), found)
    case spell(s): if s.action == "set" || s.action == "?" then Card.answerLensedAs::<Edits, State, Planting, Reply>(Card.routeParsed(parsed, context, forms()), context, forms(), lenses(), guard(state, context), render(state, context), fromCard) else spelled(state, context, input.post, s.action, parsed, found)
# Whether understood prose waits for "yes" is the owner's to set: `delvetalk garden set`
# with `confirm: yes` or `confirm: no`.
def lenses() -> Lists.List<Form.Lens<Edits>>:
  Lists.List::<Form.Lens<Edits>>.cons({head: Form.Lens::<Edits>.lens({field: "confirm", form: Form.Kind.choice({options: Lists.append::<String>(Lists.append::<String>(Form.Names.nil(), "yes"), "no")}), put: fn(v: Form.Value) -> Edits: extend(keep(), {confirm: Plans.Edit::<Bool, {}>.set({value: Card.valueText(v) == "yes"})})}), tail: Lists.List::<Form.Lens<Edits>>.nil()})
def guard(state: State, context: Abi.Context) -> String:
  if context.principal == state.owner then "" else textConcat("Only the garden's owner sets it; that is ", Card.name(state.owner, context))
def fromCard(reply: Card.Reply) -> Reply:
  match reply:
    case silent(_): Reply.silent({})
    case done(_): Reply.changed({})
    case usage(_): Reply.shown({})
    case unclear(u): Reply.unclear({needs: u.needs})
    case refused(r): Reply.refused({reason: r.reason})
# Field lines naming the plant form (`plant: a fern / colour: silver`) are its spell;
# other prose goes to the policy's model.
def bared(state: State, input: Card.Heard, context: Abi.Context, parsed: Spell.Parsed, found: Held) -> Activity<Plan, Response, Reply>:
  match parsed:
    case spell(s): spelled(state, context, input.post, s.action, parsed, found)
    case notASpell(_): understand(state, input, context, found)
# What is not a spell is given to the policy's model, which can only propose; with no
# policy, prose naming none of the garden's forms gets no card.
def understand(state: State, input: Card.Heard, context: Abi.Context, found: Held) -> Activity<Plan, Response, Reply>:
  if Plans.isNobody(state.policy) then silent(found, context) else interpreted(state, input, context, state.confirm, found)
def interpreted(state: State, input: Card.Heard, context: Abi.Context, confirm: Bool, found: Held) -> Activity<Plan, Response, Reply>:
  match perform(Plan.interpret({utterance: input.text, offers: Lists.List::<Form.Form>.cons({head: plantForm(context), tail: Lists.List::<Form.Form>.nil()}), policy: state.policy})):
    case proposal(p): named(state, context, input.post, found, confirm, p.argument.colour, p.argument.seed)
    case unclear(u): if notAddressed(u.needs) then silent(found, context) else told(found, context, Reply.unclear({needs: u.needs}), needsCard(u.needs))
    case replied(r): readBack(state, context, input.post, heardBack(r.text), confirm, found)
    case denied(_): told(found, context, Reply.refused({reason: "The garden's policy is not visible to you."}), refusedCard("The garden's policy is not visible to you."))
    case _: told(found, context, Reply.refused({reason: "I could not make sense of that."}), refusedCard("I could not make sense of that."))
# The model's own words, when the host hands them back as text (`replied {text}`): a
# spell is fitted to the plant form here, in Bend, as a typed one is; `unclear: <need>`
# names what is missing; `unclear: not addressed` (prose that names no card) and
# anything else end the turn with no card at all.
sum Back:
  spell: {parsed: Spell.Parsed}
  unclear: {need: String}
  silent: {}
def heardBack(text: String) -> Back:
  backOf(Spell.parse(text), textDrop(text, textSpan(text, " \n\t\r")))
def backOf(parsed: Spell.Parsed, text: String) -> Back:
  match parsed:
    case spell(_): Back.spell({parsed: parsed})
    case notASpell(_): if textTake(text, 8n) == "unclear:" then needOf(Spell.trimEnd(Spell.trimStart(textTake(textDrop(text, 8n), textBreak(textDrop(text, 8n), "\n"))))) else Back.silent({})
def needOf(need: String) -> Back:
  if need == "" || need == "not addressed" then Back.silent({}) else Back.unclear({need: need})
def notAddressed(needs: Form.Names) -> Bool:
  Lists.any::<String>(needs, fn(need: String) -> Bool: need == "not addressed")
def readBack(state: State, context: Abi.Context, post: String, back: Back, confirm: Bool, found: Held) -> Activity<Plan, Response, Reply>:
  match back:
    case spell(s): judged(state, context, post, s.parsed, confirm, found)
    case unclear(u): told(found, context, Reply.unclear({needs: Form.Names.cons({head: u.need, tail: Form.Names.nil()})}), needsCard(Form.Names.cons({head: u.need, tail: Form.Names.nil()})))
    case silent(_): silent(found, context)
# Not addressed to the garden: no card. A proposal the principal had waiting is dropped
# (this prose replaced it), still without a card.
def silent(found: Held, context: Abi.Context) -> Activity<Plan, Response, Reply>:
  match found:
    case none(_): Reply.silent({})
    case some(_): quietly(context, forget(found))
def quietly(context: Abi.Context, edit: Plans.Entries<Pending, Pending>) -> Activity<Plan, Response, Reply>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {pending: edit})})):
    case _: Reply.silent({})
def needsCard(needs: Form.Names) -> Document.Document:
  Document.text(textConcat("✾ THE NIGHT GARDEN\n\nI did not quite get that. I still need: ", textConcat(Spell.joined(needs), ".\n")))
def confirmCard(context: Abi.Context, colour: String, seed: String) -> Document.Document:
  Document.text(textConcat("✾ THE NIGHT GARDEN\n\n", textConcat(Card.name(context.principal, context), textConcat(", I understood this:\n\n", textConcat(spell(context.object, seed, colour), "\nReply yes or correct it.\n")))))
# Fit the spell (typed by the user, or proposed by the policy's model) to the plant
# form. A proposed spell is only acted on when the garden does not ask first.
def judged(state: State, context: Abi.Context, post: String, parsed: Spell.Parsed, confirm: Bool, found: Held) -> Activity<Plan, Response, Reply>:
  match Spell.fit(parsed, plantForm(context)):
    case proposal(p): named(state, context, post, found, confirm, Card.text(p.bindings, "colour"), Card.text(p.bindings, "seed"))
    case unclear(u): told(found, context, Reply.unclear({needs: u.needs}), unclearCard(context, u.needs, parsed))
    case refused(r): told(found, context, Reply.refused({reason: r.reason}), refusedCard(r.reason))
def named(state: State, context: Abi.Context, post: String, found: Held, confirm: Bool, colour: String, seed: String) -> Activity<Plan, Response, Reply>:
  match colourNamed(colour):
    case some(c): settled(state, context, post, found, confirm, c.value, seed)
    case none(_): told(found, context, Reply.refused({reason: "colour is one of: amber, violet, silver"}), refusedCard("colour is one of: amber, violet, silver"))
def settled(state: State, context: Abi.Context, post: String, found: Held, confirm: Bool, colour: Bell.Colour, seed: String) -> Activity<Plan, Response, Reply>:
  if confirm then asked(state, context, found, Bell.colourName(colour), seed) else grow(state, context, post, found, colour, seed)
# The proposal waits, one per principal: a new one replaces the old.
def asked(state: State, context: Abi.Context, found: Held, colour: String, seed: String) -> Activity<Plan, Response, Reply>:
  let entry = {principal: context.principal, spell: spell(context.object, seed, colour)}
  match found:
    case some(s): remembered(context, Plans.Entries::<Pending, Pending>.amendItem({item: s.item, change: entry}), colour, seed)
    case none(_): if Lists.length::<Pending>(state.pending) < 64n then remembered(context, Plans.Entries::<Pending, Pending>.append({item: entry}), colour, seed) else tell(Reply.refused({reason: "Too many proposals are waiting."}), refusedCard("Too many proposals are waiting."))
def remembered(context: Abi.Context, edit: Plans.Entries<Pending, Pending>, colour: String, seed: String) -> Activity<Plan, Response, Reply>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {pending: edit})})):
    case written(_): Card.tellTo::<Edits, State, Planting, Reply>(Reply.confirming({spell: spell(context.object, seed, colour)}), context.principal, confirmCard(context, colour, seed))
    case _: tell(Reply.refused({reason: "The garden could not remember it."}), refusedCard("The garden could not remember it."))
def grow(state: State, context: Abi.Context, post: String, found: Held, colour: Bell.Colour, seed: String) -> Activity<Plan, Response, Reply>:
  match perform(Plan.create({package: "Bell", seed: Data.of::<Bell.Seed>({colour: colour, seed: seed, planting: post, planter: context.principal, planterHandle: context.handle}), law: "Bell", requireAbsent: minted()})):
    case created(c): counted(state, context, found, c.object, Bell.colourName(colour), seed)
    case refused(r): told(found, context, Reply.refused({reason: r.clause}), refusedCard(r.clause))
    case _: told(found, context, Reply.refused({reason: "The garden could not plant it."}), refusedCard("The garden could not plant it."))
# Planting counts, keeps the bell among the children, and settles whatever this
# principal had waiting.
def counted(state: State, context: Abi.Context, found: Held, reference: Plans.Reference, colour: String, seed: String) -> Activity<Plan, Response, Reply>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {planted: Plans.Edit::<Nat, Nat>.add({delta: 1n}), pending: forget(found), children: Plans.Entries::<Plans.Reference, {}>.append({item: reference})})})):
    case written(_): tell(Reply.planted({object: reference, colour: colour, seed: seed}), plantedCard(context, Card.name(context.principal, context), reference, colour, seed, state.planted + 1n))
    case _: tell(Reply.refused({reason: "The garden could not count it."}), refusedCard("The garden could not count it."))
def forget(found: Held) -> Plans.Entries<Pending, Pending>:
  match found:
    case none(_): Plans.Entries::<Pending, Pending>.keep({})
    case some(s): Plans.Entries::<Pending, Pending>.removeItem({item: s.item})
# Answers with a card, first dropping the waiting proposal this reply superseded.
def told(found: Held, context: Abi.Context, reply: Reply, card: Document.Document) -> Activity<Plan, Response, Reply>:
  match found:
    case none(_): tell(reply, card)
    case some(s): forgotten(context, forget(found), reply, card)
def forgotten(context: Abi.Context, edit: Plans.Entries<Pending, Pending>, reply: Reply, card: Document.Document) -> Activity<Plan, Response, Reply>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {pending: edit})})):
    case written(_): tell(reply, card)
    case _: tell(reply, card)
def tell(reply: Reply, card: Document.Document) -> Activity<Plan, Response, Reply>:
  Card.tell::<Edits, State, Planting, Reply>(reply, card)
