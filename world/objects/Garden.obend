edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Spell.obend as Spell
import ./Form.obend as Form
import ./List.obend as Lists
import ./Bell.obend as Bell
import ./Cistern.obend as Cistern
import ./Policy.obend as Policy
record State:
  planted: Nat
  policy: Plans.Reference
record Edits:
  planted: Plans.Edit<Nat, Nat>
# A creator supplies a Seed; the child's seeded makes its State. The garden
# creates two kinds of child, so its A is a sum with one constructor per package
# (named like the package, lower case), each holding that package's Seed.
record Seed:
  policy: Plans.Reference
sum Child:
  bell: Bell.Seed
  cistern: Cistern.Seed
type Plan = Plans.Plan<Edits, Child>
# A view reads the policy; an interpretation's proposal argument is a spell.
type Response = Plans.Response<Policy.State, String>
def defaultSeed() -> Seed:
  {policy: Plans.nobody()}
def seeded(seed: Seed) -> State:
  {planted: 0n, policy: seed.policy}
def initial() -> State:
  seeded(defaultSeed())
sum Made:
  made: {object: Plans.Reference}
  refused: {clause: String}
def child(context: Abi.Context, kind: String, serial: Nat) -> Plans.Reference:
  {world: "", object: textConcat(context.object, textConcat("/", textConcat(kind, textConcat("/", natText(serial)))))}
def planted(context: Abi.Context, reference: Plans.Reference) -> Activity<Plan, Response, Made>:
  match perform(Plan.write({object: Plans.self(context), edits: {planted: Plans.Edit::<Nat, Nat>.add({delta: 1n})}})):
    case written(_): Made.made({object: reference})
    case _: Made.refused({clause: "garden count"})
# The create names the reference the bell will occupy; the host refuses it if taken.
# The bell's planting slot is the planter and the post that asked for it, which is
# what the bell's strike later awaits.
def plant(state: State, input: {colour: Bell.Colour, seed: String, post: String}, context: Abi.Context) -> Activity<Plan, Response, Made>:
  sow(state, input.colour, input.seed, context.principal, input.post, context)
def sow(state: State, colour: Bell.Colour, seed: String, planter: String, post: String, context: Abi.Context) -> Activity<Plan, Response, Made>:
  match perform(Plan.create({package: "Bell", seed: Child.bell({planter: planter, colour: colour, seed: seed, planting: {principal: planter, intent: post}}), law: "Bell", requireAbsent: child(context, "bell", state.planted + 1n)})):
    case created(c): planted(context, c.object)
    case refused(r): Made.refused({clause: r.clause})
    case _: Made.refused({clause: "no creation"})
# One cistern per garden: the second create finds its reference occupied.
def cistern(state: State, input: {}, context: Abi.Context) -> Activity<Plan, Response, Made>:
  match perform(Plan.create({package: "Cistern", seed: Child.cistern({}), law: "Cistern", requireAbsent: child(context, "cistern", 1n)})):
    case created(c): Made.made({object: c.object})
    case refused(r): Made.refused({clause: r.clause})
    case _: Made.refused({clause: "no creation"})
# The form the garden offers for planting, as data the Spell module checks a reply
# against. The card is named by the object the reply answers.
def plantForm(context: Abi.Context) -> Form.Form:
  {card: context.object, action: "plant", fields: Form.Fields.cons({head: {name: "colour", kind: Form.Kind.choice({options: Lists.append::<String>(Lists.append::<String>(Lists.append::<String>(Form.Names.nil(), "amber"), "violet"), "silver")})}, tail: Form.Fields.cons({head: {name: "seed", kind: Form.Kind.text({min: 1n, max: 80n})}, tail: Form.Fields.nil()})})}
# A card reply becomes a proposal without a host round trip; the host feeds an
# admitted proposal to plant.
def propose(text: String, context: Abi.Context) -> Spell.Fit:
  Spell.fit(Spell.parse(text), plantForm(context))
def render(state: State) -> Document.Document:
  Document.text(textConcat("The Night Garden: ", textConcat(natText(state.planted), " planted\n")))
def card(state: State) -> String:
  Document.plain(render(state))
# Offers the card to the principal: the host renders the Document to text.
def present(state: State, input: {}, context: Abi.Context) -> Activity<Plan, Response, Nat>:
  match perform(Plan.offer({to: "", document: render(state)})):
    case offered(_): state.planted
    case _: 0n
# What the town says to the garden: the reply text, who wrote it, and the post it
# is in (the post is the intent of the planting, which the bell's strike awaits).
record Heard:
  text: String
  who: String
  post: String
sum Reply:
  planted: {object: Plans.Reference, colour: String, seed: String}
  unclear: {needs: Form.Names}
  refused: {reason: String}
  confirming: {spell: String}
def cat(left: String, right: String) -> String:
  textConcat(left, right)
def entryText(entries: Spell.Entries, name: String) -> String:
  match entries:
    case nil(_): ""
    case cons(c): if c.head.name == name then spoken(c.head.value) else entryText(c.tail, name)
def spoken(value: Spell.Value) -> String:
  match value:
    case text(t): t.value
    case choice(c): c.value
    case natural(n): natText(n.value)
def colourNamed(name: String) -> Bell.Colour:
  if name == "amber" then Bell.Colour.amber({}) else if name == "violet" then Bell.Colour.violet({}) else Bell.Colour.silver({})
def spell(card: String, seed: String, colour: String) -> String:
  cat("    delvetalk ", cat(card, cat(" plant\n    seed: ", cat(seed, cat("\n    colour: ", cat(colour, "\n"))))))
def plantedCard(context: Abi.Context, who: String, reference: Plans.Reference, colour: String, seed: String, count: Nat) -> Document.Document:
  let what = cat("Planted for ", cat(who, cat(": a ", cat(colour, cat(" bell, “", cat(seed, "”."))))))
  let where = cat("It lives at ", cat(reference.object, cat(". The garden now holds ", cat(natText(count), " planted."))))
  Document.text(cat("✾ THE NIGHT GARDEN\n\n", cat(what, cat("\n", cat(where, cat("\n\nTo plant another, reply:\n\n", spell(context.object, "a fern that remembers yesterday", "silver")))))))
def unclearCard(context: Abi.Context, needs: Form.Names, parsed: Spell.Parsed) -> Document.Document:
  Document.text(cat("✾ THE NIGHT GARDEN\n\nAlmost. I still need: ", cat(Spell.joined(needs), cat(".\nReply with the spell, filled in:\n\n", spell(context.object, filled(parsed, "seed", "<what might grow here, 1 to 80 characters>"), filled(parsed, "colour", "<amber, violet or silver>"))))))
def filled(parsed: Spell.Parsed, name: String, hint: String) -> String:
  match parsed:
    case spell(s): if Spell.valueOf(s.fields, name) == "" then hint else Spell.valueOf(s.fields, name)
    case notASpell(_): hint
def refusedCard(reason: String) -> Document.Document:
  Document.text(cat("Not planted: ", cat(reason, "\n")))
# Every observed spell arrives here. It parses, fits the plant form, plants on a
# proposal and writes nothing otherwise; it always ends by offering a reply card.
def receive(state: State, input: Heard, context: Abi.Context) -> Activity<Plan, Response, Reply>:
  hear(state, input, context, Spell.parse(input.text))
def hear(state: State, input: Heard, context: Abi.Context, parsed: Spell.Parsed) -> Activity<Plan, Response, Reply>:
  match parsed:
    case notASpell(_): understand(state, input, context)
    case spell(_): judged(state, input, context, parsed, false)
# What is not a spell is given to the policy's model, which can only propose.
def understand(state: State, input: Heard, context: Abi.Context) -> Activity<Plan, Response, Reply>:
  match perform(Plan.view({object: state.policy})):
    case viewed(v): interpreted(state, input, context, v.state.confirm)
    case _: tell(Reply.refused({reason: "The garden has no interpretation policy."}), refusedCard("The garden has no interpretation policy."))
def interpreted(state: State, input: Heard, context: Abi.Context, confirm: Bool) -> Activity<Plan, Response, Reply>:
  match perform(Plan.interpret({utterance: input.text, offers: Lists.List::<Form.Form>.cons({head: plantForm(context), tail: Lists.List::<Form.Form>.nil()}), policy: state.policy})):
    case proposal(p): judged(state, input, context, Spell.parse(p.argument), confirm)
    case unclear(u): tell(Reply.unclear({needs: u.needs}), needsCard(u.needs))
    case _: tell(Reply.refused({reason: "I could not make sense of that."}), refusedCard("I could not make sense of that."))
def needsCard(needs: Form.Names) -> Document.Document:
  Document.text(cat("✾ THE NIGHT GARDEN\n\nI did not quite get that. I still need: ", cat(Spell.joined(needs), ".\n")))
def confirmCard(context: Abi.Context, colour: String, seed: String) -> Document.Document:
  Document.text(cat("✾ THE NIGHT GARDEN\n\nI understood this:\n\n", cat(spell(context.object, seed, colour), "\nReply yes or correct it.\n")))
# Fit the spell (typed by the user, or proposed by the policy's model) to the plant
# form. A proposed spell is only acted on when the policy does not ask first.
def judged(state: State, input: Heard, context: Abi.Context, parsed: Spell.Parsed, confirm: Bool) -> Activity<Plan, Response, Reply>:
  match Spell.fit(parsed, plantForm(context)):
    case proposal(p): settled(state, input, context, confirm, entryText(p.bindings, "colour"), entryText(p.bindings, "seed"))
    case unclear(u): tell(Reply.unclear({needs: u.needs}), unclearCard(context, u.needs, parsed))
    case refused(r): tell(Reply.refused({reason: r.reason}), refusedCard(r.reason))
def settled(state: State, input: Heard, context: Abi.Context, confirm: Bool, colour: String, seed: String) -> Activity<Plan, Response, Reply>:
  if confirm then tell(Reply.confirming({spell: spell(context.object, seed, colour)}), confirmCard(context, colour, seed)) else grow(state, input, context, colour, seed)
def grow(state: State, input: Heard, context: Abi.Context, colour: String, seed: String) -> Activity<Plan, Response, Reply>:
  match perform(Plan.create({package: "Bell", seed: Child.bell({planter: input.who, colour: colourNamed(colour), seed: seed, planting: {principal: input.who, intent: input.post}}), law: "Bell", requireAbsent: child(context, "bell", state.planted + 1n)})):
    case created(c): counted(state, input, context, c.object, colour, seed)
    case refused(r): tell(Reply.refused({reason: r.clause}), refusedCard(r.clause))
    case _: tell(Reply.refused({reason: "The garden could not plant it."}), refusedCard("The garden could not plant it."))
def counted(state: State, input: Heard, context: Abi.Context, reference: Plans.Reference, colour: String, seed: String) -> Activity<Plan, Response, Reply>:
  match perform(Plan.write({object: Plans.self(context), edits: {planted: Plans.Edit::<Nat, Nat>.add({delta: 1n})}})):
    case written(_): tell(Reply.planted({object: reference, colour: colour, seed: seed}), plantedCard(context, input.who, reference, colour, seed, state.planted + 1n))
    case _: tell(Reply.refused({reason: "The garden could not count it."}), refusedCard("The garden could not count it."))
def tell(reply: Reply, card: Document.Document) -> Activity<Plan, Response, Reply>:
  match perform(Plan.offer({to: "", document: card})):
    case _: reply
