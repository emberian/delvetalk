edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Spell.obend as Spell
import ./Form.obend as Form
import ./List.obend as Lists
import ./World.obend as World
import ./Card.obend as Card
import ./Policies.obend as Policies
import ./Relation.obend as Relations
import ./Text.obend as Text
import ./Rows.obend as Rows
# What the garden holds for a principal: a planting understood from prose waiting for "yes"
# (needs empty), or a planting spell missing fields (needs names them) that a reply of only
# the missing `name: value` lines completes (the host hands such a reply to receive with its
# fields). One per principal: `pending` is keyed {principal}, so holding another replaces it
# (an upsert). colour and seed are as given so far ("" for none).
record Pending:
  principal: String
  colour: String
  seed: String
  needs: Lists.List<String>
# children: the bells planted here, keyed {object}: a bell's id is garden/bell/<n> with n
# minted in order, and a text key sorts by length and then by bytes, so key order is the
# order of planting. A child row keeps the bell's colour, which the `byColour` view counts.
# confirmFor: the actions whose proposals understood from prose wait for "yes" here, beside
# the policy's own confirmFor (either asking is enough); empty by default, so a planting
# understood from prose plants and the receipt is the answer.
# owner: the human who owns the garden's wiki page (its `merge` checkpoints it, and only
# the owner changes confirmFor). ownerHandle: the owner's handle, from the seed (genesis passes it),
# so a refusal names the owner as the town does. pageCheckpoint: the post the last merge answered.
# Whoever wants to know how many grow (a Wake) subscribes to `planted`.
type Child = Rows.Child
record State:
  owner: String
  ownerHandle: String
  planted: Nat
  policy: Plans.Reference
  confirmFor: Lists.List<String>
  pending: Relations.Relation<Pending>
  children: Relations.Relation<Child>
  pageCheckpoint: String
# What plant takes, and so what an interpretation proposes: the host reads a colour's word
# as its case (in a spell, a proposal or a direct turn).
record Planting:
  colour: Rows.Colour
  seed: String
# Anyone plants, rains and replies; only the owner changes who owns it, its stance, its
# policy or its page checkpoint (a set or a merge from anyone else is refused in Bend
# first, by name; this law refuses the same write proposed any other way).
law owner "the owner never changes; only the owner changes what asks first, the policy or the page, and anyone else only by its methods": unchanged(owner) and (request.subject == new.owner or (request.kind == 0 and unchanged(ownerHandle) and unchanged(confirmFor) and unchanged(policy) and unchanged(pageCheckpoint)))
def initial() -> State:
  {owner: "", ownerHandle: "", planted: 0n, policy: Plans.nobody(), confirmFor: Lists.List.nil(), pending: Relations.empty(), children: Relations.empty(), pageCheckpoint: ""}
def relations() -> Relations.Decls:
  Lists.append(Lists.append(Relations.Decls.nil(), {field: "pending", key: Text.words("principal"), limit: pendingMax()}), {field: "children", key: Text.words("object"), limit: 2048n})
# Principals with a planting held at once: the Bend check refuses one more by name, since past
# the limit the host would drop someone else's.
def pendingMax() -> Nat:
  64n
# The post that plants is what the bell's strike later awaits (awaitPost): the reply a spell
# came in (`inputOrigin.post`); planting directly leaves the bell nothing to await. The planter
# is the turn's principal, never anything the caller wrote. A typed planting plants (it
# settles whatever the speaker had waiting).
def plant(state: State, input: Planting, context: Abi.Context) -> Activity<Reply>:
  settled(input.colour, input.seed, context.inputOrigin.post, false, heldBy(context.principal, state), context, state)
# The kinds the garden makes under itself (docs/CATALOGUE.md §3): a bell is kind/bell's, a
# cistern kind/cistern's, each <garden>/<kind>/<n> with a door home. The kind answers `made`.
sum Made:
  made: {object: String}
  refused: Card.Refusal
def kind(context: Abi.Context, name: String) -> Plans.Reference:
  {world: context.world, object: "kind/{name}"}
def field(name: String, value: String) -> Rows.Field:
  {name: name, value: value}
# A cistern is dug by kind/cistern under the garden; its name is what the digger calls it
# (`cistern: a stone cistern for refused proposals`), which the kind's form does not take.
def cistern(state: State, input: {name: String}, context: Abi.Context) -> Activity<Reply>:
  match world.call::<Made>({object: kind(context, "cistern"), method: "makeUnder", argument: {under: context.object, fields: Lists.List::<Rows.Field>.nil()}}):
    case returned(r): dug(r.result, context, state)
    case refused(r): refused(Why.world({clause: r.clause}), heldBy(context.principal, state))
    case denied(_): refused(Why.world({clause: "denied"}), heldBy(context.principal, state))
def dug(made: Made, context: Abi.Context, state: State) -> Activity<Reply>:
  match made:
    case made(m): told(Reply.dug({object: {world: context.world, object: m.object}}), Document.text("The cistern is dug at {m.object}; it takes refusals.\n"), heldBy(context.principal, state))
    case refused(r): refused(Why.world({clause: r.clause}), heldBy(context.principal, state))
# The form the garden offers for planting, as data: its card is the object a reply answers.
def plantForm(context: Abi.Context) -> Form.Form:
  Card.named(planting(), context.object)
form plant as planting:
  colour: amber | violet | silver
  seed: text 1..80
form cistern as digging:
  name: text 0..120
# A reader with a proposal waiting is reminded of it, first.
def waiting(context: Abi.Context, state: State) -> String:
  match heldBy(context.principal, state):
    case some(s): if Lists.length(s.item.needs) == 0n then "{Card.name(context.principal, context)}, this waits for your yes:\n\n{spell(context.object, s.item.seed, s.item.colour)}\n" else ""
    case none(_): ""
def childLine(child: Child) -> Document.Document:
  Document.text("- {child.object}\n")
# Derived views (FOUNDATION §9, `viewDerived {object, view}`): pure definitions of the state
# and the reader's context that another object may ask for by name.
def views() -> Lists.List<String>:
  Text.words("byColour")
# How many bells of each colour grow here, one row a colour that has any, keyed {colour}.
record Tally:
  colour: Rows.Colour
  count: Nat
def byColour(state: State, context: Abi.Context) -> Relations.Relation<Tally>:
  Relations.Relation.rows({items: Lists.map(Relations.group(state.children, fn(c: Child) -> Rows.Colour: c.colour), fn(g: Relations.Group<Child, Rows.Colour>) -> Tally: {colour: Relations.groupKey(g), count: Lists.length(Relations.groupRows(g))})})
# Words are read only with a policy, and shown back first only when planting asks first.
def inWords(state: State) -> String:
  if Plans.isNobody(state.policy) then "" else if asks(state.confirmFor, "plant") then "Or say it in words; I show you the spell before it grows.\n\n" else "Or say it in words; the interpreter plants what it understands.\n\n"
# The garden card: how to plant first (readers clip near 1,400 characters), then the
# bells, newest first, eight of them and a count of the rest.
def render(state: State, context: Abi.Context) -> Document.Document:
  let card = Card.called(context, "garden")
  let head = Document.text("✾ THE NIGHT GARDEN\n\n{waiting(context, state)}To plant, reply:\n\n    delvetalk {card} plant\n    seed: <what might grow here, 1 to 80 characters>\n    colour: <amber, violet or silver>\n\n{inWords(state)}{natText(state.planted)} planted, newest first:\n")
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: Card.clipped(Lists.map(Lists.reverse(Relations.rows(state.children)), childLine), 8n)})})
# The garden's page: its card, how to reply, then one section per bell, newest first,
# sixteen of them; the card section counts the rest.
def page(state: State, context: Abi.Context) -> Card.Page:
  let bells = Lists.reverse(Relations.rows(state.children))
  let shown = Lists.map(Lists.take(bells, 16n), fn(bell: Child) -> Card.Section: {title: bell.object, body: Document.text("A bell planted here: [[{bell.object}]]. Reply on its card to rain on it.\n")})
  let more = if Lists.length(bells) > 16n then "… and {natText(Lists.length(bells) - 16n)} more bells\n" else ""
  Lists.concat(Card.defaultPage(Document.concat(render(state, context), Document.text(more)), context, forms()), shown)
# Publishes the page under the door word (genesis posts one card per door).
def publishPage(state: State, input: {page: String}, context: Abi.Context) -> Activity<String>:
  Card.publishPage(Card.pageName(input.page, blurb().word), page(state, Card.public(context)))
def blurb() -> Card.Door:
  {word: "garden", blurb: "Plant something; rain on another's planting. Things remember who helped them grow."}
sum Reply:
  planted: {object: Plans.Reference, colour: String, seed: String}
  unclear: {needs: Form.Names}
  refused: Card.Refusal
  confirming: {spell: String}
  cleared: {}
  shown: {}
  merged: {post: String}
  dug: {object: Plans.Reference}
  changed: {}
  silent: {}
def colourName(c: Rows.Colour) -> String:
  match c:
    case amber(_): "amber"
    case violet(_): "violet"
    case silver(_): "silver"
# A colour by name (a held or macro planting keeps the text it was given), or none: a name
# outside the three is refused, never defaulted.
def colourNamed(name: String) -> Lists.Maybe<Rows.Colour>:
  if name == "amber" then Lists.Maybe.some({value: Rows.Colour.amber({})}) else if name == "violet" then Lists.Maybe.some({value: Rows.Colour.violet({})}) else if name == "silver" then Lists.Maybe.some({value: Rows.Colour.silver({})}) else Lists.Maybe.none({})
def spell(card: String, seed: String, colour: String) -> String:
  "    delvetalk {card} plant\n    seed: {seed}\n    colour: {colour}\n"
# The acknowledgement is posted where the planting was, so it prints the new bell's whole rain
# spell (a reply naming the bell reaches it from here).
def plantedCard(context: Abi.Context, reference: Plans.Reference, colour: String, seed: String, count: Nat) -> Document.Document:
  let article = if colour == "amber" then "an" else "a"
  let another = spell(context.object, "a fern that remembers yesterday", "silver")
  Document.text("Planted, {Card.name(context.principal, context)}: {article} {colour} bell, “{seed}”, at {reference.object}; {natText(count)} planted.\nRain on it:\n\n    delvetalk {reference.object} rain\n    text: <1 to 200 characters>\n\nAnother:\n\n{another}")
def unclearCard(context: Abi.Context, needs: Form.Names, colour: String, seed: String) -> Document.Document:
  let again = spell(context.object, if seed == "" then "<what might grow here, 1 to 80 characters>" else seed, if colour == "" then "<amber, violet or silver>" else colour)
  Document.text("✾ THE NIGHT GARDEN\n\nAlmost. I still need: {Text.joined(needs)}.\nReply with just the missing lines, or the spell filled in:\n\n{again}")
# Why the garden refuses: each arm a clause and its reading; a refusal the world gave (a
# create refused requiredAbsence) keeps the world's clause.
sum Why:
  world: {clause: String}
  policyHidden: {}
  policy: {}
  noMacroSpell: {}
  senseless: {}
  badColour: {}
  tooManyWaiting: {}
  nothingWaiting: {}
  notOwner: {owner: String}
  noField: {field: String}
  noPost: {}
  seedLength: {length: Nat}
def refusal(w: Why) -> Card.Refusal:
  match w:
    case world(r): {clause: r.clause, reading: "The world refused it ({r.clause})."}
    case policyHidden(_): {clause: "policyHidden", reading: "The garden's policy is not visible to you."}
    case policy(_): {clause: "policy", reading: "The policy is not visible to you."}
    case noMacroSpell(_): {clause: "noMacroSpell", reading: "The macro expands to no planting."}
    case senseless(_): {clause: "senseless", reading: "I could not make sense of that."}
    case badColour(_): {clause: "badColour", reading: "colour is one of: amber, violet, silver"}
    case tooManyWaiting(_): {clause: "tooManyWaiting", reading: "Too many proposals are waiting."}
    case nothingWaiting(_): {clause: "nothingWaiting", reading: "Nothing of yours waits for a yes or no here."}
    case notOwner(n): {clause: "notOwner", reading: "Only the garden's owner sets it; that is {n.owner}"}
    case noField(n): {clause: "noField", reading: "No field called {n.field} can be set here."}
    case noPost(_): {clause: "noPost", reading: "A merge names the post it answers."}
    case seedLength(l): {clause: "seedLength", reading: "A seed is 1 to {natText(seedMax())} characters; this one is {natText(l.length)}."}
def refusedCard(refusal: Card.Refusal) -> Document.Document:
  Document.text("Not planted, refused {refusal.clause}: {refusal.reading}\n")
# Answers a refusal with its card, first dropping the waiting proposal it superseded.
def refused(w: Why, found: Held) -> Activity<Reply>:
  told(Reply.refused(refusal(w)), refusedCard(refusal(w)), found)
# The proposal a principal has waiting, if any (replaced and retracted by its key, so another
# principal's proposal landing first moves nothing).
sum Held:
  none: {}
  some: {item: Pending}
def pendingKey(p: Pending) -> {principal: String}:
  {principal: p.principal}
def heldBy(principal: String, state: State) -> Held:
  match Relations.lookup(state.pending, {principal: principal}, pendingKey):
    case some(s): Held.some({item: s.value})
    case none(_): Held.none({})
# A reply that ran no method: the owner's `merge`; a planting spell missing fields, or the
# missing lines completing one held for the speaker; a yes or no to a planting that waits; a
# blank reply (the card); prose, which the policy's model reads, or with no policy goes on to
# the commonplace.
# A misfit spell (`plant / colour: verdigris`) is read by hob with its clause and reason, which
# asks one question; with no policy it is refused by its clause.
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Reply>:
  if input.misfit.clause != "" then misfitted(Card.heard(input), input.misfit, heldBy(context.principal, state), context, state) else if Card.isMerge(input.text) then merging(input.post, context, state) else heard(Card.heard(input), Card.spellAction(input.text), heldBy(context.principal, state), context, state)
def misfitted(input: Card.Reply, misfit: Card.Misfit, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  if Plans.isNobody(state.policy) then Card.answerRefused({clause: misfit.clause, reading: misfit.reason}, context, forms(), render(state, context), fromCard) else consulted(input, Card.misfitLine(misfit), found, context, state)
def merging(post: String, context: Abi.Context, state: State) -> Activity<Reply>:
  if state.owner == "" || context.principal != state.owner then Card.tell(Reply.refused({clause: "notOwner", reading: Card.notOwner(ownerName(state, context))}), Document.text("Not merged: {Card.notOwner(ownerName(state, context))}\n")) else if post == "" then Card.tell(Reply.refused(refusal(Why.noPost({}))), Document.text("Not merged: a merge names the post it answers.\n")) else merged(post)
def merged(post: String) -> Activity<Reply>:
  let written(_) = write {pageCheckpoint: set post}
  Card.tell(Reply.merged({post: post}), Document.text("Page checkpointed.\n"))
def heard(input: Card.Reply, action: String, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  if action == "plant" || action == "" && plantFielded(input.fields) then completing(input.fields, found, context, state) else if action != "" then Card.answerAs(input, context, forms(), render(state, context), fromCard) else answered(input, found, context, state)
# Field lines naming the planting (`plant:`, `seed:`, `colour:`), with no spell line.
def plantFielded(fields: Spell.Bindings) -> Bool:
  Lists.any(fields, fn(b: Spell.Binding) -> Bool: b.name == "plant" || b.name == "seed" || b.name == "colour")
# The planting so far: what the speaker had held, then these lines (a `plant:` line is the
# seed, as the town writes it).
def completing(fields: Spell.Bindings, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  let colour = Spell.valueOf(fields, "colour")
  let seed = if Spell.valueOf(fields, "seed") == "" then Spell.valueOf(fields, "plant") else Spell.valueOf(fields, "seed")
  match found:
    case some(s): if Lists.length(s.item.needs) > 0n then fromFields(if colour == "" then s.item.colour else colour, if seed == "" then s.item.seed else seed, found, context, state) else fromFields(colour, seed, found, context, state)
    case none(_): fromFields(colour, seed, found, context, state)
# A planting from text: a seed past the form's bound is refused, what is missing is held for the
# speaker and asked for, and the rest plants (a colour's name is read here). Lines that reach
# receive were never fitted to the form, so its bound is checked here.
def seedMax() -> Nat:
  80n
def fromFields(colour: String, seed: String, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  if textLength(seed) > seedMax() then refused(Why.seedLength({length: textLength(seed)}), found) else fromBounded(colour, seed, found, context, state)
def fromBounded(colour: String, seed: String, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  let needs = Lists.filter(Lists.append(Lists.append(Form.Names.nil(), "colour"), "seed"), fn(n: String) -> Bool: if n == "colour" then colour == "" else seed == "")
  if Lists.length(needs) > 0n then held({principal: context.principal, colour: colour, seed: seed, needs: needs}, unclearCard(context, needs, colour, seed), found, state) else named(colour, seed, false, found, context, state)
# A planting completed from lines or confirmed by a yes is planted by this turn's post, which
# the bell's strike awaits a reply to.
def named(colour: String, seed: String, confirm: Bool, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  match colourNamed(colour):
    case some(c): settled(c.value, seed, context.inputOrigin.post, confirm, found, context, state)
    case none(_): refused(Why.badColour({}), found)
# Not a planting: a yes or no to what waits, a blank reply, or prose.
def answered(input: Card.Reply, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  match Card.answerOf(input.text):
    case yes(_): confirmed(found, context, state)
    case no(_): declined(found)
    case other(_): if Text.blank(input.text) then shown(context, state) else prose(input, found, context, state)
# Yes plants what waits; no drops it; with nothing of the speaker's waiting, either is
# answered so, with no model call (rehearsal play mode).
def confirmed(found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  match found:
    case some(s): if Lists.length(s.item.needs) == 0n then named(s.item.colour, s.item.seed, false, found, context, state) else refused(Why.nothingWaiting({}), found)
    case none(_): refused(Why.nothingWaiting({}), found)
def declined(found: Held) -> Activity<Reply>:
  match found:
    case some(_): told(Reply.cleared({}), Document.text("✾ THE NIGHT GARDEN\n\nI dropped what I understood.\n"), found)
    case none(_): refused(Why.nothingWaiting({}), found)
# A blank reply gets the card (which teaches the plant spell), and the policy's shortcuts
# (`?` is the host's usage, which cannot read the policy).
def shown(context: Abi.Context, state: State) -> Activity<Reply>:
  if Plans.isNobody(state.policy) then Card.tell(Reply.shown({}), render(state, context)) else shownWith(context, state)
def shownWith(context: Abi.Context, state: State) -> Activity<Reply>:
  match world.view::<Policies.State>({object: state.policy}):
    case viewed(v): Card.tell(Reply.shown({}), Document.concat(render(state, context), Card.macroUsage(v.state)))
    case _: Card.tell(Reply.shown({}), render(state, context))
def fromCard(reply: Card.Replied) -> Reply:
  match reply:
    case silent(_): Reply.silent({})
    case done(_): Reply.changed({})
    case usage(_): Reply.shown({})
    case unclear(u): Reply.unclear({needs: u.needs})
    case refused(r): Reply.refused(r)
    case _: Reply.changed({})
# Whether an understood planting waits for "yes" here is the owner's to set: `delvetalk
# garden set` with `confirm: yes` or `confirm: no` adds or drops plant in confirmFor.
def lenses() -> Lists.List<Form.Field>:
  Lists.List.cons({head: {name: "confirm", kind: Form.Kind.choice({options: Lists.append(Lists.append(Form.Names.nil(), "yes"), "no")})}, tail: Lists.List.nil()})
def set(state: State, input: {field: String, value: Form.Value}, context: Abi.Context) -> Activity<Reply>:
  if context.principal != state.owner then setRefused(Why.notOwner({owner: ownerName(state, context)})) else if input.field != "confirm" then setRefused(Why.noField({field: input.field})) else confirming(Card.valueText(input.value) == "yes", state)
def ownerName(state: State, context: Abi.Context) -> String:
  Card.shown(state.owner, state.ownerHandle, context)
def setRefused(w: Why) -> Activity<Reply>:
  Card.tell(Reply.refused(refusal(w)), Document.text("Not done: {refusal(w).reading}\n"))
def confirming(ask: Bool, state: State) -> Activity<Reply>:
  let written(_) = world.write(extend(keep(), {confirmFor: if ask == asks(state.confirmFor, "plant") then Plans.Entries.keep({}) else if ask then Plans.Entries.append({item: "plant"}) else Plans.Entries.removeItem({item: "plant"})}))
  Card.tell(Reply.changed({}), Document.text("Set confirm to {if ask then \"yes\" else \"no\"}.\n"))
def asks(actions: Lists.List<String>, action: String) -> Bool:
  Lists.any(actions, fn(a: String) -> Bool: a == action)
# Whether an understood planting waits for "yes": the garden's confirmFor or the policy's.
def confirmsPlant(policy: Policies.State, state: State) -> Bool:
  asks(state.confirmFor, "plant") || Card.confirms(policy, "plant")
# Prose is given to the policy's model, which can only propose; with no policy it goes on to
# the commonplace's reading (Card's default) and the garden offers nothing. Either way a
# proposal the speaker had waiting is dropped (this prose replaced it).
def prose(input: Card.Reply, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  if Plans.isNobody(state.policy) then unplaced(input, found, context) else consulted(input, "", found, context, state)
def unplaced(input: Card.Reply, found: Held, context: Abi.Context) -> Activity<Reply>:
  match found:
    case none(_): Card.handOn(input, context, Reply.silent({}))
    case some(_): forgottenOn(input, found, context)
def forgottenOn(input: Card.Reply, found: Held, context: Abi.Context) -> Activity<Reply>:
  let written(_) = world.write(extend(keep(), {pending: forget(found)}))
  Card.handOn(input, context, Reply.silent({}))
def consulted(input: Card.Reply, misfit: String, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  match world.view::<Policies.State>({object: state.policy}):
    case viewed(v): macroOr(input, Card.expanded(input.text, v.state), v.state, misfit, found, context, state)
    case _: refused(Why.policyHidden({}), found)
# A macro of the policy's that the prose matches is its spell, typed by the owner: its
# planting is read as a typed one is, and no model is asked.
def macroOr(input: Card.Reply, expanded: Lists.Maybe<String>, policy: Policies.State, misfit: String, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  match expanded:
    case some(e): byMacro(Spell.parse(e.value), found, context, state)
    case none(_): interpreted(input, policy, misfit, found, context, state)
def byMacro(parsed: Spell.Parsed, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  match parsed:
    case spell(s): if s.action == "plant" then completing(s.fields, found, context, state) else refused(Why.noMacroSpell({}), found)
    case notASpell(_): refused(Why.noMacroSpell({}), found)
def offers(context: Abi.Context) -> Card.Forms:
  Card.Forms.cons({head: plantForm(context), tail: Card.Forms.nil()})
# hob reads the words against the plant form, with the planting held for the speaker and the
# misfit; the host fits its spell. A proposal plants (or waits for yes); hob's `none` is
# silence, `card` the garden's card, `ask` its question over the plant spell. What was held
# stays held, so the answer to hob's question completes it.
def interpreted(input: Card.Reply, policy: Policies.State, misfit: String, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  match world.interpret::<Planting>(Card.interpretation(input.text, offers(context), state.policy, heldLine(found), misfit)):
    case proposal(p): settled(p.argument.colour, p.argument.seed, input.post, confirmsPlant(policy, state), found, context, state)
    case proposals(p): firstPlanting(Lists.at(p.items, 0n), input, policy, found, context, state)
    case unclear(u): hobbed(Card.hobNeeds(u.needs, offers(context)), input, policy, context, state)
    case replied(r): hobbed(Card.hobSaid(r.text), input, policy, context, state)
    case timedOut(_): refused(Why.senseless({}), found)
    case denied(_): refused(Why.policy({}), found)
    case refused(_): refused(Why.senseless({}), found)
def hobbed(hob: Card.Hob, input: Card.Reply, policy: Policies.State, context: Abi.Context, state: State) -> Activity<Reply>:
  Card.hobbed(hob, policy, input.text, context, offers(context), render(state, context), hobReply(hob))
def hobReply(hob: Card.Hob) -> Reply:
  match hob:
    case ask(a): Reply.unclear({needs: a.needs})
    case card(_): Reply.shown({})
    case none(_): Reply.silent({})
# What hob is shown of the planting held for the speaker ("" for none).
def heldLine(found: Held) -> String:
  match found:
    case none(_): ""
    case some(s): if Lists.length(s.item.needs) == 0n then "a planting waiting for yes: seed \"{s.item.seed}\", colour {s.item.colour}" else "a planting with seed \"{s.item.seed}\"; still needs {Text.joined(s.item.needs)}"
# Several spells: the garden takes the first (the commonplace runs each on its door).
def firstPlanting(item: Lists.Maybe<World.Proposed<Planting>>, input: Card.Reply, policy: Policies.State, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  match item:
    case some(i): plantingItem(i.value, input, policy, found, context, state)
    case none(_): Reply.silent({})
def plantingItem(item: World.Proposed<Planting>, input: Card.Reply, policy: Policies.State, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  match item:
    case proposal(p): settled(p.argument.colour, p.argument.seed, input.post, confirmsPlant(policy, state), found, context, state)
    case unclear(u): hobbed(Card.hobNeeds(u.reasons, offers(context)), input, policy, context, state)
def confirmCard(context: Abi.Context, colour: String, seed: String) -> Document.Document:
  Document.text("✾ THE NIGHT GARDEN\n\n{Card.name(context.principal, context)}, I understood this:\n\n{spell(context.object, seed, colour)}\nReply yes or correct it.\n")
# A planting either waits for the speaker's yes (an understood one the garden or the policy
# confirms first) or grows.
def settled(colour: Rows.Colour, seed: String, post: String, confirm: Bool, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  if confirm then held({principal: context.principal, colour: colourName(colour), seed: seed, needs: Lists.List.nil()}, confirmCard(context, colourName(colour), seed), found, state) else grow(colour, seed, post, found, context, state)
# What the garden holds, one per principal: a new one replaces the old; `pendingMax`
# principals at most. A held planting waiting for yes answers `confirming`, one missing
# fields `unclear`.
def held(entry: Pending, card: Document.Document, found: Held, state: State) -> Activity<Reply>:
  match found:
    case some(_): holding(entry, card)
    case none(_): if Relations.count(state.pending) < pendingMax() then holding(entry, card) else Card.tell(Reply.refused(refusal(Why.tooManyWaiting({}))), refusedCard(refusal(Why.tooManyWaiting({}))))
def holding(entry: Pending, card: Document.Document) -> Activity<Reply>:
  let written(_) = write {pending: upsert entry}
  Card.tellTo(if Lists.length(entry.needs) == 0n then Reply.confirming({spell: spell("", entry.seed, entry.colour)}) else Reply.unclear({needs: entry.needs}), entry.principal, card)
# kind/bell makes the bell under the garden, with the turn's post (the one its strike awaits),
# the planter as its maker and owner, and a door home.
def grow(colour: Rows.Colour, seed: String, post: String, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  match world.call::<Made>({object: kind(context, "bell"), method: "makeUnder", argument: {under: context.object, fields: Lists.List.cons({head: field("colour", colourName(colour)), tail: Lists.List.cons({head: field("seed", seed), tail: Lists.List::<Rows.Field>.nil()})})}}):
    case returned(r): grown(r.result, colour, seed, found, context, state)
    case refused(r): refused(Why.world({clause: r.clause}), found)
    case denied(_): refused(Why.world({clause: "denied"}), found)
def grown(made: Made, colour: Rows.Colour, seed: String, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  match made:
    case made(m): watching({world: context.world, object: m.object}, colour, seed, found, context, state)
    case refused(r): refused(Why.world({clause: r.clause}), found)
# The planter's wake is told when the new bell rings: the garden sends its `watchBell`, which
# runs as the planter's after this turn commits, once the bell exists (whatever it answers,
# the planting stands).
def watching(reference: Plans.Reference, hue: Rows.Colour, seed: String, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  match world.send({object: {world: context.world, object: "wake/{context.principal}"}, method: "watchBell", argument: {bell: reference.object}}):
    case _: counted(reference, hue, seed, found, context, state)
# Planting counts, keeps the bell among the children, and settles whatever this principal
# had waiting; the planter gets the card (a Wake subscribed to `planted` hears of it).
def counted(reference: Plans.Reference, hue: Rows.Colour, seed: String, found: Held, context: Abi.Context, state: State) -> Activity<Reply>:
  let written(_) = world.write(extend(keep(), {planted: Plans.Edit.add({delta: 1n}), pending: forget(found), children: Plans.Entries.insert({row: {world: reference.world, object: reference.object, colour: hue}})}))
  Card.tell(Reply.planted({object: reference, colour: colourName(hue), seed: seed}), plantedCard(context, reference, colourName(hue), seed, state.planted + 1n))
def forget(found: Held) -> Plans.Entries<Pending, Pending>:
  match found:
    case none(_): Plans.Entries.keep({})
    case some(s): Plans.Entries.retract({key: {principal: s.item.principal}})
# Answers with a card, first dropping the waiting proposal this reply superseded.
def told(reply: Reply, card: Document.Document, found: Held) -> Activity<Reply>:
  match found:
    case none(_): Card.tell(reply, card)
    case some(_): forgotten(forget(found), reply, card)
def forgotten(edit: Plans.Entries<Pending, Pending>, reply: Reply, card: Document.Document) -> Activity<Reply>:
  let written(_) = world.write(extend(keep(), {pending: edit}))
  Card.tell(reply, card)
