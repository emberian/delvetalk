edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Spell.obend as Spell
import ./Form.obend as Form
import ./List.obend as Lists
import ./Bell.obend as Bell
import ./Cistern.obend as Cistern
import ./Card.obend as Card
import ./Policies.obend as Policies
import ./Relation.obend as Relations
# What the garden holds for a principal: a proposal understood from prose waiting for
# "yes" (needs empty), or a spell missing fields (needs names them) that a reply of only
# the missing `name: value` lines completes. One per principal: `pending` is keyed
# {principal}, so holding another replaces it (an upsert).
record Pending:
  principal: String
  spell: String
  needs: Lists.List<String>
# children: the bells planted here, keyed {object}: a bell's id is garden/bell/<n> with n
# minted in order, and a text key sorts by length and then by bytes, so key order is the
# order of planting.
# confirmFor: the actions whose proposals understood from prose wait for "yes" here, beside
# the policy's own confirmFor (either asking is enough); empty by default, so a planting
# understood from prose plants and the receipt is the answer.
# owner: the human who owns the garden's wiki page (its `merge` checkpoints it, and only
# the owner changes confirmFor). pageCheckpoint: the post the last merge answered.
record State:
  owner: String
  planted: Nat
  policy: Plans.Reference
  confirmFor: Lists.List<String>
  pending: Relations.Relation<Pending>
  children: Relations.Relation<Plans.Reference>
  pageCheckpoint: String
  observers: Card.Observers
record Edits:
  planted: Plans.Edit<Nat, Nat>
  confirmFor: Plans.Entries<String, {}>
  pending: Plans.Entries<Pending, Pending>
  children: Plans.Entries<Plans.Reference, {}>
  pageCheckpoint: Plans.Edit<String, {}>
  observers: Plans.Entries<Card.Observer, {}>
# A creator supplies a Seed; the host lays it over initial(). The garden's own creates
# carry Data: a Bell.Seed, and nothing for a cistern.
record Seed:
  owner: String
  policy: Plans.Reference
  confirmFor: Lists.List<String>
  pending: Relations.Relation<Pending>
type Plan = Plans.Plan<Edits>
# What plant takes, and so what an interpretation proposes: the host checks the
# proposal's argument against plant's input type. A proposal is plain JSON, which has
# no variants, so the colour is its name and the garden reads it.
record Planting:
  colour: String
  seed: String
# The garden views its policy (Card's interpretation default), and interpret names it by reference.
type Response = Plans.Response<Policies.State, Planting>
# Anyone plants, rains and replies; only the owner changes who owns it, its stance, its
# policy or its page checkpoint (a set or a merge from anyone else is refused in Bend
# first, by name; this law refuses the same write proposed any other way).
law owner "only the owner changes who owns it, its stance, its policy or its page": request.subject == new.owner or (request.kind == 0 and unchanged(owner) and unchanged(confirmFor) and unchanged(policy) and unchanged(pageCheckpoint))
def defaultSeed() -> Seed:
  {owner: "", policy: Plans.nobody(), confirmFor: Lists.List.nil(), pending: Relations.empty()}
def seeded(seed: Seed) -> State:
  {owner: seed.owner, planted: 0n, policy: seed.policy, confirmFor: seed.confirmFor, pending: seed.pending, children: Relations.empty(), pageCheckpoint: "", observers: Card.Observers.nil()}
def initial() -> State:
  seeded(defaultSeed())
def relations() -> Relations.Decls:
  Relations.Decls.cons({head: {field: "pending", key: Lists.List.cons({head: "principal", tail: Lists.List.nil({})}), limit: 64n}, tail: Relations.Decls.cons({head: {field: "children", key: Lists.List.cons({head: "object", tail: Lists.List.nil({})}), limit: 4096n}, tail: Relations.Decls.nil({})})})
def keep() -> Edits:
  {planted: Plans.Edit.keep({}), confirmFor: Plans.Entries.keep({}), pageCheckpoint: Plans.Edit.keep({}), pending: Plans.Entries.keep({}), children: Plans.Entries.keep({}), observers: Plans.Entries.keep({})}
sum Made:
  made: {object: Plans.Reference}
  refused: {clause: String}
# Bells are minted: an empty requireAbsent lets the host choose <garden>/bell/<n>, and the
# garden records the reference created {object} answers. The cistern has a chosen name,
# <garden>/cistern, so a second is refused requiredAbsence (the §10 refusal).
def minted() -> Plans.Reference:
  {world: "", object: ""}
def chosen(context: Abi.Context, name: String) -> Plans.Reference:
  {world: "", object: "{context.object}/{name}"}
# The post that plants (input.post) is what the bell's strike later awaits (awaitPost):
# the reply that answers it. Planting directly, with no post, leaves the bell nothing to
# await. The planter is the turn's principal, never anything the caller wrote.
# Plant directly: the same create, count and card as a spell's, without a reply.
def plant(state: State, input: Planting, context: Abi.Context) -> Activity<Plan, Response, Reply>:
  named(state, context, "", Held.none({}), false, input.colour, input.seed)
# One cistern per garden: the second create finds garden/cistern occupied.
def cistern(state: State, input: {}, context: Abi.Context) -> Activity<Plan, Response, Made>:
  match perform(Plan.create({package: "Cistern", seed: Plans.nothing(), law: "Cistern", requireAbsent: chosen(context, "cistern")})):
    case created(c): Made.made({object: c.object})
    case refused(r): Made.refused({clause: r.clause})
    case _: Made.refused({clause: "no creation"})
# The form the garden offers for planting, as data the Spell module checks a reply
# against. The card is named by the object the reply answers.
def plantForm(context: Abi.Context) -> Form.Form:
  Card.named(planting(), context.object)
form plant as planting:
  colour: amber | violet | silver
  seed: text 1..80
# A reader with a proposal waiting is reminded of it, first.
def waiting(state: State, context: Abi.Context) -> String:
  match heldBy(Relations.rows(state.pending), context.principal, 0n):
    case some(s): "{Card.name(context.principal, context)}, this waits for your yes:\n\n{s.spell}\n"
    case none(_): ""
def childLine(reference: Plans.Reference) -> Document.Document:
  Document.text("- {reference.object}\n")
# The garden card: how to plant first (readers clip near 1,400 characters), then the
# bells, newest first, eight of them and a count of the rest.
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  let card = if context.object == "" then "garden" else context.object
  let head = Document.text("✾ THE NIGHT GARDEN\n\n{waiting(state, context)}To plant, reply:\n\n    delvetalk {card} plant\n    seed: <what might grow here, 1 to 80 characters>\n    colour: <amber, violet or silver>\n\n{Card.checkpointLine(state.pageCheckpoint)}{natText(state.planted)} planted, newest first:\n")
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: Card.clipped(Lists.map(Lists.reverse(Relations.rows(state.children)), childLine), 8n)})})
# The garden's page: its card, how to reply, then one section per bell, newest first,
# sixteen of them; the card section counts the rest.
def page(state: State, context: Abi.Context) -> Card.Page:
  let bells = Lists.reverse(Relations.rows(state.children))
  let shown = Lists.map(Lists.take(bells, 16n), fn(bell: Plans.Reference) -> Card.Section: {title: bell.object, body: Document.text("A bell planted here: [[{bell.object}]]. Reply on its card to rain on it.\n")})
  let more = if Lists.length(bells) > 16n then "… and {natText(Lists.length(bells) - 16n)} more bells\n" else ""
  Lists.concat(Card.defaultPage(Document.concat(render(state, context), Document.text(more)), context, forms()), shown)
# Publishes the page under the door word (genesis posts one card per door).
def publishPage(state: State, input: {page: String}, context: Abi.Context) -> Activity<Plan, Response, String>:
  Card.publishPage(Card.pageName(input.page, door().word), page(state, Card.public(context)))
# Publishes the page as one agentwiki post (`wiki: <id>` and its sections).
def publish(state: State, context: Abi.Context) -> Activity<Plan, Response, String>:
  match perform(Plan.publish({page: "", section: "", body: Card.pageText(page(state, context))})):
    case published(p): p.post
    case refused(r): r.clause
    case _: ""
def forms() -> Card.Forms:
  Card.Forms.cons({head: planting(), tail: Card.Forms.cons({head: digging(), tail: Card.Forms.nil()})})
# The cistern form: the garden's one cistern, at garden/cistern, keeps refusals. Its
# name is what the digger calls it (`cistern: a stone cistern for refused proposals`).
form cistern as digging:
  name: text 0..120
# A spell to the garden plants, or digs the cistern.
def spelled(state: State, context: Abi.Context, post: String, action: String, parsed: Spell.Parsed, found: Held) -> Activity<Plan, Response, Reply>:
  if action == "cistern" then dig(context, found, Spell.fit(parsed, Card.named(digging(), context.object))) else judged(state, context, post, parsed, false, found)
def dig(context: Abi.Context, found: Held, fit: Spell.Fit) -> Activity<Plan, Response, Reply>:
  match fit:
    case proposal(_): digging2(context, found)
    case unclear(u): told(found, context, Reply.unclear({needs: u.needs}), needsCard(u.needs))
    case refused(r): refused(found, context, Why.badSpell({reason: r.reason}))
def digging2(context: Abi.Context, found: Held) -> Activity<Plan, Response, Reply>:
  match perform(Plan.create({package: "Cistern", seed: Plans.nothing(), law: "Cistern", requireAbsent: chosen(context, "cistern")})):
    case created(c): told(found, context, Reply.dug({object: c.object}), Document.text("✾ THE NIGHT GARDEN\n\nThe cistern is dug at {c.object.object}. It keeps refusals.\n"))
    case refused(r): refused(found, context, Why.world({clause: r.clause}))
    case _: refused(found, context, Why.noCreation({what: "dig"}))
def door() -> Card.Door:
  {word: "garden", blurb: "Plant something; rain on another's planting. Things remember who helped them grow."}
# What the town says to the garden is a Card.Heard: the reply text and the post it
# is in. Who wrote it is the turn's principal; the planting slot is the turn's intent.
sum Reply:
  planted: {object: Plans.Reference, colour: String, seed: String}
  unclear: {needs: Form.Names}
  refused: Card.Refusal
  confirming: {spell: String}
  cleared: {}
  shown: {}
  merged: {post: String}
  dug: {object: Plans.Reference}
  changed: {}
  silent: {}
# A colour by name, or none: a name outside the three is refused, never defaulted.
def colourNamed(name: String) -> Lists.Maybe<Bell.Colour>:
  if name == "amber" then Lists.Maybe.some({value: Bell.Colour.amber({})}) else if name == "violet" then Lists.Maybe.some({value: Bell.Colour.violet({})}) else if name == "silver" then Lists.Maybe.some({value: Bell.Colour.silver({})}) else Lists.Maybe.none({})
def spell(card: String, seed: String, colour: String) -> String:
  "    delvetalk {card} plant\n    seed: {seed}\n    colour: {colour}\n"
def plantedCard(context: Abi.Context, who: String, reference: Plans.Reference, colour: String, seed: String, count: Nat) -> Document.Document:
  let article = if colour == "amber" then "an" else "a"
  let what = "Planted for {who}: {article} {colour} bell, “{seed}”."
  let where = "It lives at {reference.object}. The garden now holds {natText(count)} planted."
  let another = spell(context.object, "a fern that remembers yesterday", "silver")
  Document.text("✾ THE NIGHT GARDEN\n\n{what}\n{where}\n\nTo plant another, reply:\n\n{another}")
def unclearCard(context: Abi.Context, needs: Form.Names, parsed: Spell.Parsed) -> Document.Document:
  let again = spell(context.object, filled(parsed, "seed", "<what might grow here, 1 to 80 characters>"), filled(parsed, "colour", "<amber, violet or silver>"))
  Document.text("✾ THE NIGHT GARDEN\n\nAlmost. I still need: {Spell.joined(needs)}.\nReply with just the missing lines, or the spell filled in:\n\n{again}")
def filled(parsed: Spell.Parsed, name: String, hint: String) -> String:
  match parsed:
    case spell(s): if Spell.valueOf(s.fields, name) == "" then hint else Spell.valueOf(s.fields, name)
    case notASpell(_): hint
# Why the garden refuses: each arm a clause, `why` its reading; a refusal the world gave
# (a create refused requiredAbsence) keeps the world's clause.
sum Why:
  badSpell: {reason: String}
  world: {clause: String}
  noCreation: {what: String}
  unreadable: {}
  policyHidden: {}
  noMacroSpell: {reason: String}
  senseless: {}
  badColour: {}
  tooManyWaiting: {}
def why(w: Why) -> String:
  match w:
    case badSpell(b): b.reason
    case world(r): "The world refused it ({r.clause})."
    case noCreation(n): "The garden could not {n.what} it."
    case unreadable(_): "I could not read what I had understood."
    case policyHidden(_): "The garden's policy is not visible to you."
    case noMacroSpell(n): "The macro expands to no spell: {n.reason}"
    case senseless(_): "I could not make sense of that."
    case badColour(_): "colour is one of: amber, violet, silver"
    case tooManyWaiting(_): "Too many proposals are waiting."
def clause(w: Why) -> String:
  match w:
    case badSpell(_): "badSpell"
    case world(r): r.clause
    case noCreation(_): "noCreation"
    case unreadable(_): "unreadable"
    case policyHidden(_): "policyHidden"
    case noMacroSpell(_): "noMacroSpell"
    case senseless(_): "senseless"
    case badColour(_): "badColour"
    case tooManyWaiting(_): "tooManyWaiting"
def refusal(w: Why) -> Card.Refusal:
  {clause: clause(w), reading: why(w)}
def refusedCard(refusal: Card.Refusal) -> Document.Document:
  Document.text("Not planted, refused {refusal.clause}: {refusal.reading}\n")
# Answers a refusal with its card, first dropping the waiting proposal it superseded.
def refused(found: Held, context: Abi.Context, w: Why) -> Activity<Plan, Response, Reply>:
  told(found, context, Reply.refused(refusal(w)), refusedCard(refusal(w)))
# The proposal a principal has waiting, if any: the stored row (replaced and retracted by
# its key, so another principal's proposal landing first moves nothing) and its spell.
sum Held:
  none: {}
  some: {item: Pending, spell: String, needs: Lists.List<String>}
def heldBy(items: Lists.List<Pending>, principal: String, index: Nat) -> Held:
  match items:
    case nil(_): Held.none({})
    case cons(c): if c.head.principal == principal then Held.some({item: c.head, spell: c.head.spell, needs: c.head.needs}) else heldBy(c.tail, principal, index + 1n)
# What a reply to a waiting proposal says: yes, no or anything else. Only a short
# reply is examined; it is one word between blanks, in one of three spellings.
sum Word:
  yes: {}
  no: {}
  other: {}
def wordOf(text: String) -> Word:
  if textLength(text) > 64n then Word.other({}) else worded(textDrop(text, textSpan(text, " \n\t\r")))
def worded(rest: String) -> Word:
  let core = textTake(rest, textBreak(rest, " \n\t\r"))
  if textSpan(textDrop(rest, textLength(core)), " \n\t\r") + textLength(core) == textLength(rest) then classed(core) else Word.other({})
def classed(core: String) -> Word:
  if core == "yes" || core == "Yes" || core == "YES" || core == "y" then Word.yes({}) else if core == "no" || core == "No" || core == "NO" || core == "n" then Word.no({}) else Word.other({})
# Every observed spell arrives here. A principal with a proposal waiting is first
# heard as answering it; otherwise the text parses, fits the plant form, plants on a
# proposal and writes nothing; it always ends by offering a reply card.
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Reply>:
  if Card.isMerge(input.text) then Card.merge(input.post, state.owner, context, fn(post: String) -> Edits: extend(keep(), {pageCheckpoint: Plans.Edit.set({value: post})}), Reply.merged({post: input.post}), fn(r: Card.Refusal) -> Reply: Reply.refused(r)) else heard(state, input, context, heldBy(Relations.rows(state.pending), context.principal, 0n))
def heard(state: State, input: Card.Heard, context: Abi.Context, found: Held) -> Activity<Plan, Response, Reply>:
  match found:
    case none(_): hear(state, input, context, Spell.parse(input.text), found)
    case some(s): if Lists.length(s.needs) == 0n then replied(state, input, context, found, s.spell) else completing(state, input, context, found, s.spell)
# A spell missing fields is completed by a reply of only field lines; anything else is
# heard afresh (and replaces it).
def completing(state: State, input: Card.Heard, context: Abi.Context, found: Held, stored: String) -> Activity<Plan, Response, Reply>:
  if Card.onlyFields(input.text) then judged(state, context, input.post, Spell.parse(Card.completed(stored, input.text)), false, found) else hear(state, input, context, Spell.parse(input.text), found)
# Yes plants what was stored; no drops it; anything else is heard afresh and
# replaces the stored proposal (or drops it when it proposes nothing).
def replied(state: State, input: Card.Heard, context: Abi.Context, found: Held, stored: String) -> Activity<Plan, Response, Reply>:
  match wordOf(input.text):
    case yes(_): confirmed(state, input, context, found, stored)
    case no(_): told(found, context, Reply.cleared({}), Document.text("✾ THE NIGHT GARDEN\n\nI dropped what I understood.\n"))
    case other(_): hear(state, input, context, Spell.parse(input.text), found)
def confirmed(state: State, input: Card.Heard, context: Abi.Context, found: Held, stored: String) -> Activity<Plan, Response, Reply>:
  match Spell.fit(Spell.parse(stored), plantForm(context)):
    case proposal(p): named(state, context, input.post, found, false, Card.text(p.bindings, "colour"), Card.text(p.bindings, "seed"))
    case _: refused(found, context, Why.unreadable({}))
def hear(state: State, input: Card.Heard, context: Abi.Context, parsed: Spell.Parsed, found: Held) -> Activity<Plan, Response, Reply>:
  match parsed:
    case notASpell(_): if textSpan(input.text, " \n\t\r") == textLength(input.text) then tell(Reply.shown({}), render(state, context)) else bared(state, input, context, Card.withBare(parsed, input.text, context, forms()), found)
    case spell(s): if s.action == "?" && Plans.isNobody(state.policy) == false && s.card == context.object then helped(state, context) else if s.action == "set" || s.action == "?" then Card.answerLensedAs(Card.routeParsed(parsed, context, forms()), context, forms(), lenses(state), guard(state, context), render(state, context), fromCard) else spelled(state, context, input.post, s.action, parsed, found)
# The usage card, with the shortcuts the garden's policy knows.
def helped(state: State, context: Abi.Context) -> Activity<Plan, Response, Reply>:
  match perform(Plan.view({object: state.policy})):
    case viewed(v): tell(Reply.shown({}), Document.concat(Card.help(context.object, forms(), lenses(state)), Card.macroUsage(v.state)))
    case _: tell(Reply.shown({}), Card.help(context.object, forms(), lenses(state)))
# Whether an understood planting waits for "yes" here is the owner's to set: `delvetalk
# garden set` with `confirm: yes` or `confirm: no` adds or drops plant in confirmFor.
def lenses(state: State) -> Lists.List<Form.Lens<Edits>>:
  Lists.List.cons({head: Form.Lens.lens({field: "confirm", form: Form.Kind.choice({options: Lists.append(Lists.append(Form.Names.nil(), "yes"), "no")}), put: fn(v: Form.Value) -> Edits: extend(keep(), {confirmFor: asking(state, Card.valueText(v) == "yes")})}), tail: Lists.List.nil()})
def asking(state: State, ask: Bool) -> Plans.Entries<String, {}>:
  if ask == asks(state.confirmFor, "plant") then Plans.Entries.keep({}) else if ask then Plans.Entries.append({item: "plant"}) else Plans.Entries.removeItem({item: "plant"})
def asks(actions: Lists.List<String>, action: String) -> Bool:
  Lists.any(actions, fn(a: String) -> Bool: a == action)
# Whether an understood planting waits for "yes": the garden's confirmFor or the policy's.
def confirmsPlant(state: State, policy: Policies.State) -> Bool:
  asks(state.confirmFor, "plant") || Card.confirms(policy, "plant")
def guard(state: State, context: Abi.Context) -> String:
  if context.principal == state.owner then "" else "Only the garden's owner sets it; that is {Card.name(state.owner, context)}"
def fromCard(reply: Card.Reply) -> Reply:
  match reply:
    case silent(_): Reply.silent({})
    case done(_): Reply.changed({})
    case usage(_): Reply.shown({})
    case unclear(u): Reply.unclear({needs: u.needs})
    case refused(r): Reply.refused(r)
# Field lines naming the plant form (`plant: a fern / colour: silver`) are its spell;
# other prose goes to the policy's model.
def bared(state: State, input: Card.Heard, context: Abi.Context, parsed: Spell.Parsed, found: Held) -> Activity<Plan, Response, Reply>:
  match parsed:
    case spell(s): spelled(state, context, input.post, s.action, parsed, found)
    case notASpell(_): understand(state, input, context, found)
# What is not a spell is given to the policy's model, which can only propose; with no
# policy, prose naming none of the garden's forms gets no card. The garden reads its policy
# first (Card's interpretation default: a miss is asked once more, a second miss escalates).
def understand(state: State, input: Card.Heard, context: Abi.Context, found: Held) -> Activity<Plan, Response, Reply>:
  if Plans.isNobody(state.policy) then unplaced(input, context, found) else consulted(state, input, context, found)
# With no policy, prose the garden cannot place goes to the directory's reading (Card's
# default), and the garden offers nothing.
def unplaced(input: Card.Heard, context: Abi.Context, found: Held) -> Activity<Plan, Response, Reply>:
  if Card.handsOn(input.text, context) == false then silent(found, context) else forwarding(input, context, found)
def forwarding(input: Card.Heard, context: Abi.Context, found: Held) -> Activity<Plan, Response, Reply>:
  match perform(Card.forwarding(input.text, input.post, context)):
    case _: silent(found, context)
def consulted(state: State, input: Card.Heard, context: Abi.Context, found: Held) -> Activity<Plan, Response, Reply>:
  match perform(Plan.view({object: state.policy})):
    case viewed(v): macroOr(state, input, context, found, v.state, Card.expanded(input.text, v.state))
    case _: refused(found, context, Why.policyHidden({}))
# A macro of the policy's that the prose matches is its spell, typed by the owner: it is
# judged as a typed spell is, and no model is asked.
def macroOr(state: State, input: Card.Heard, context: Abi.Context, found: Held, policy: Policies.State, expanded: Lists.Maybe<String>) -> Activity<Plan, Response, Reply>:
  match expanded:
    case some(e): byMacro(state, input, context, found, Spell.parse(e.value))
    case none(_): interpreted(state, input, context, found, policy, 0n, Form.Names.nil())
def byMacro(state: State, input: Card.Heard, context: Abi.Context, found: Held, parsed: Spell.Parsed) -> Activity<Plan, Response, Reply>:
  match parsed:
    case spell(s): spelled(state, context, input.post, s.action, parsed, found)
    case notASpell(n): refused(found, context, Why.noMacroSpell({reason: n.reason}))
def offers(context: Abi.Context) -> Card.Forms:
  Card.Forms.cons({head: plantForm(context), tail: Card.Forms.nil()})
def interpreted(state: State, input: Card.Heard, context: Abi.Context, found: Held, policy: Policies.State, attempt: Nat, needs: Form.Names) -> Activity<Plan, Response, Reply>:
  match perform(Card.asking(input.text, offers(context), state.policy, policy, attempt, needs)):
    case proposal(p): named(state, context, input.post, found, confirmsPlant(state, policy), p.argument.colour, p.argument.seed)
    case unclear(u): if Card.notAddressed(u.needs) then silent(found, context) else told(found, context, Reply.unclear({needs: u.needs}), needsCard(u.needs))
    case replied(r): readBack(state, input, context, found, policy, attempt, Card.fitting(r.text, offers(context)))
    case denied(_): refused(found, context, Why.policyHidden({}))
    case _: refused(found, context, Why.senseless({}))
# The model's own words (`replied {text}`), fitted by Card.fitting to the plant form: a hit
# is judged as a typed spell is; a first miss is asked again with its needs; a second miss
# offers the needs card (none when nothing is named) and the policy's escalation copy.
def readBack(state: State, input: Card.Heard, context: Abi.Context, found: Held, policy: Policies.State, attempt: Nat, fitted: Card.Fitted) -> Activity<Plan, Response, Reply>:
  match fitted:
    case hit(h): judged(state, context, input.post, h.parsed, confirmsPlant(state, policy), found)
    case miss(m): if attempt == 0n then interpreted(state, input, context, found, policy, 1n, m.needs) else unfit(input, context, found, policy, m.needs)
    case silent(_): silent(found, context)
def unfit(input: Card.Heard, context: Abi.Context, found: Held, policy: Policies.State, needs: Form.Names) -> Activity<Plan, Response, Reply>:
  if policy.escalateTo == "" then missed(found, context, needs) else escalated(input, context, found, policy, needs)
def escalated(input: Card.Heard, context: Abi.Context, found: Held, policy: Policies.State, needs: Form.Names) -> Activity<Plan, Response, Reply>:
  match perform(Card.escalation(policy, input.text, context)):
    case _: missed(found, context, needs)
def missed(found: Held, context: Abi.Context, needs: Form.Names) -> Activity<Plan, Response, Reply>:
  match needs:
    case nil(_): silent(found, context)
    case cons(_): told(found, context, Reply.unclear({needs: needs}), needsCard(needs))
# Not addressed to the garden: no card. A proposal the principal had waiting is dropped
# (this prose replaced it), still without a card.
def silent(found: Held, context: Abi.Context) -> Activity<Plan, Response, Reply>:
  match found:
    case none(_): Reply.silent({})
    case some(_): quietly(context, forget(found))
def quietly(context: Abi.Context, edit: Plans.Entries<Pending, Pending>) -> Activity<Plan, Response, Reply>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {pending: edit})}))
  Reply.silent({})
def needsCard(needs: Form.Names) -> Document.Document:
  Document.text("✾ THE NIGHT GARDEN\n\nI did not quite get that. I still need: {Spell.joined(needs)}.\n")
def confirmCard(context: Abi.Context, colour: String, seed: String) -> Document.Document:
  Document.text("✾ THE NIGHT GARDEN\n\n{Card.name(context.principal, context)}, I understood this:\n\n{spell(context.object, seed, colour)}\nReply yes or correct it.\n")
# Fit the spell (typed by the user, or proposed by the policy's model) to the plant
# form. A proposed spell is only acted on when the garden does not ask first.
def judged(state: State, context: Abi.Context, post: String, parsed: Spell.Parsed, confirm: Bool, found: Held) -> Activity<Plan, Response, Reply>:
  match Spell.fit(parsed, plantForm(context)):
    case proposal(p): named(state, context, post, found, confirm, Card.text(p.bindings, "colour"), Card.text(p.bindings, "seed"))
    case unclear(u): held(state, context, found, partial(parsed, context), u.needs, unclearCard(context, u.needs, parsed))
    case refused(r): refused(found, context, Why.badSpell({reason: r.reason}))
def named(state: State, context: Abi.Context, post: String, found: Held, confirm: Bool, colour: String, seed: String) -> Activity<Plan, Response, Reply>:
  match colourNamed(colour):
    case some(c): settled(state, context, post, found, confirm, c.value, seed)
    case none(_): refused(found, context, Why.badColour({}))
def settled(state: State, context: Abi.Context, post: String, found: Held, confirm: Bool, colour: Bell.Colour, seed: String) -> Activity<Plan, Response, Reply>:
  if confirm then asked(state, context, found, Bell.colourName(colour), seed) else grow(state, context, post, found, colour, seed)
# The spell as typed so far, to complete with the missing lines.
def partial(parsed: Spell.Parsed, context: Abi.Context) -> String:
  match parsed:
    case spell(s): Card.spellText(context.object, "plant", s.fields)
    case notASpell(_): Card.spellText(context.object, "plant", Spell.Bindings.nil({}))
# What the garden holds, one per principal: a new one replaces the old.
def holding(state: State, found: Held, entry: Pending) -> Lists.Maybe<Plans.Entries<Pending, Pending>>:
  match found:
    case some(_): Lists.Maybe.some({value: Plans.Entries.upsert({row: entry})})
    case none(_): if Relations.count(state.pending) < 64n then Lists.Maybe.some({value: Plans.Entries.upsert({row: entry})}) else Lists.Maybe.none({})
def held(state: State, context: Abi.Context, found: Held, spell: String, needs: Form.Names, card: Document.Document) -> Activity<Plan, Response, Reply>:
  match holding(state, found, {principal: context.principal, spell: spell, needs: needs}):
    case some(e): heldWritten(context, e.value, needs, card)
    case none(_): told(found, context, Reply.unclear({needs: needs}), card)
def heldWritten(context: Abi.Context, edit: Plans.Entries<Pending, Pending>, needs: Form.Names, card: Document.Document) -> Activity<Plan, Response, Reply>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {pending: edit})}))
  tell(Reply.unclear({needs: needs}), card)
# The proposal waits, one per principal: a new one replaces the old.
def asked(state: State, context: Abi.Context, found: Held, colour: String, seed: String) -> Activity<Plan, Response, Reply>:
  let entry: Pending = {principal: context.principal, spell: spell(context.object, seed, colour), needs: Lists.List.nil()}
  match found:
    case some(_): remembered(context, Plans.Entries.upsert({row: entry}), colour, seed)
    case none(_): if Relations.count(state.pending) < 64n then remembered(context, Plans.Entries.upsert({row: entry}), colour, seed) else tell(Reply.refused(refusal(Why.tooManyWaiting({}))), refusedCard(refusal(Why.tooManyWaiting({}))))
def remembered(context: Abi.Context, edit: Plans.Entries<Pending, Pending>, colour: String, seed: String) -> Activity<Plan, Response, Reply>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {pending: edit})}))
  Card.tellTo(Reply.confirming({spell: spell(context.object, seed, colour)}), context.principal, confirmCard(context, colour, seed))
def grow(state: State, context: Abi.Context, post: String, found: Held, colour: Bell.Colour, seed: String) -> Activity<Plan, Response, Reply>:
  match perform(Plan.create({package: "Bell", seed: bellSeed(context, post, colour, seed), law: "Bell", requireAbsent: minted()})):
    case created(c): counted(state, context, found, c.object, Bell.colourName(colour), seed)
    case refused(r): refused(found, context, Why.world({clause: r.clause}))
    case _: refused(found, context, Why.noCreation({what: "plant"}))
# A bell is planted with a door home to its garden.
def bellSeed(context: Abi.Context, post: String, colour: Bell.Colour, seed: String) -> {colour: Bell.Colour, seed: String, planting: String, planter: String, planterHandle: String, doors: Card.Doorways}:
  {colour: colour, seed: seed, planting: post, planter: context.principal, planterHandle: context.handle, doors: Card.Doorways.cons({head: {label: "garden", to: Plans.self(context)}, tail: Card.Doorways.nil()})}
# Planting counts, keeps the bell among the children, and settles whatever this
# principal had waiting.
def counted(state: State, context: Abi.Context, found: Held, reference: Plans.Reference, colour: String, seed: String) -> Activity<Plan, Response, Reply>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {planted: Plans.Edit.add({delta: 1n}), pending: forget(found), children: Plans.Entries.insert({row: reference})})}))
  notified(Card.ownObservers(state.observers), state.planted + 1n, Reply.planted({object: reference, colour: colour, seed: seed}), plantedCard(context, Card.name(context.principal, context), reference, colour, seed, state.planted + 1n))
# Observers (a Wake watching `planted`) are told the count after each planting, by their
# method, as `{field: "planted", value}`; then the planter gets the card.
def notified(observers: Card.Observers, planted: Nat, reply: Reply, card: Document.Document) -> Activity<Plan, Response, Reply>:
  match observers:
    case nil(_): tell(reply, card)
    case cons(c): notifiedOne(c.head, c.tail, planted, reply, card)
def notifiedOne(observer: Card.Observer, rest: Card.Observers, planted: Nat, reply: Reply, card: Document.Document) -> Activity<Plan, Response, Reply>:
  match perform(Plan.send({object: observer.object, method: observer.method, argument: {field: "planted", value: planted}})):
    case _: notified(rest, planted, reply, card)
def observe(state: State, input: Card.Observer, context: Abi.Context) -> Activity<Plan, Response, Card.Change>:
  observerChanged(Card.observing(state.observers, input), context)
def unobserve(state: State, input: Card.Observer, context: Abi.Context) -> Activity<Plan, Response, Card.Change>:
  observerChanged(Card.unobserving(state.observers, input), context)
def observerChanged(change: Card.Change, context: Abi.Context) -> Activity<Plan, Response, Card.Change>:
  match change:
    case edit(e): observerWritten(change, e.entries, context)
    case _: change
def observerWritten(change: Card.Change, entries: Plans.Entries<Card.Observer, {}>, context: Abi.Context) -> Activity<Plan, Response, Card.Change>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {observers: entries})}))
  change
def forget(found: Held) -> Plans.Entries<Pending, Pending>:
  match found:
    case none(_): Plans.Entries.keep({})
    case some(s): Plans.Entries.retract({key: {principal: s.item.principal}})
# Answers with a card, first dropping the waiting proposal this reply superseded.
def told(found: Held, context: Abi.Context, reply: Reply, card: Document.Document) -> Activity<Plan, Response, Reply>:
  match found:
    case none(_): tell(reply, card)
    case some(s): forgotten(context, forget(found), reply, card)
def forgotten(context: Abi.Context, edit: Plans.Entries<Pending, Pending>, reply: Reply, card: Document.Document) -> Activity<Plan, Response, Reply>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {pending: edit})}))
  tell(reply, card)
def tell(reply: Reply, card: Document.Document) -> Activity<Plan, Response, Reply>:
  Card.tell(reply, card)
