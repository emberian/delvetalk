edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
record Exit:
  label: String
  to: Plans.Reference
record State:
  name: String
  description: String
  exits: Lists.List<Exit>
  present: Lists.List<Plans.Reference>
  things: Lists.List<Plans.Reference>
# Who is acting, on enter and leave.
record Who:
  who: Plans.Reference
# A thing and who handles it, on take and put.
record Handling:
  thing: Plans.Reference
  by: Plans.Reference
# Every method that can refuse answers with this sum.
sum Done:
  done: {}
  refused: {reason: String}
record Edits:
  present: Plans.Entries<Plans.Reference, {}>
  things: Plans.Entries<Plans.Reference, {}>
type Plan = Plans.Plan<Edits, {}>
type Response = Plans.Response<State, {}>
def initial() -> State:
  {name: "", description: "", exits: Lists.List::<Exit>.nil(), present: Lists.List::<Plans.Reference>.nil(), things: Lists.List::<Plans.Reference>.nil()}
def keep() -> Edits:
  {present: Plans.Entries::<Plans.Reference, {}>.keep({}), things: Plans.Entries::<Plans.Reference, {}>.keep({})}
def written(context: Abi.Context, edits: Edits) -> Activity<Plan, Response, Done>:
  match perform(Plan.write({object: Plans.self(context), edits: edits})):
    case written(_): Done.done({})
    case refused(r): Done.refused({reason: r.clause})
    case _: Done.refused({reason: "The write was not answered."})
# Join the people here. Law decides whether the subject may enter.
def enter(state: State, input: Who, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match Plans.indexOf(state.present, input.who):
    case at(_): Done.refused({reason: "Already here."})
    case absent(_): written(context, extend(keep(), {present: Plans.Entries::<Plans.Reference, {}>.append({item: input.who})}))
def leave(state: State, input: Who, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match Plans.indexOf(state.present, input.who):
    case absent(_): Done.refused({reason: "Not here."})
    case at(a): written(context, extend(keep(), {present: Plans.Entries::<Plans.Reference, {}>.remove({index: a.index})}))
# A thing leaves the floor into the hands of someone who is here.
def take(state: State, input: Handling, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match Plans.indexOf(state.present, input.by):
    case absent(_): Done.refused({reason: "Only someone here can take things."})
    case at(_): takeThing(state, input, context)
def takeThing(state: State, input: Handling, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match Plans.indexOf(state.things, input.thing):
    case absent(_): Done.refused({reason: "That is not lying here."})
    case at(a): written(context, extend(keep(), {things: Plans.Entries::<Plans.Reference, {}>.remove({index: a.index})}))
def put(state: State, input: Handling, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match Plans.indexOf(state.present, input.by):
    case absent(_): Done.refused({reason: "Only someone here can put things down."})
    case at(_): putThing(state, input, context)
def putThing(state: State, input: Handling, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match Plans.indexOf(state.things, input.thing):
    case at(_): Done.refused({reason: "That is already lying here."})
    case absent(_): written(context, extend(keep(), {things: Plans.Entries::<Plans.Reference, {}>.append({item: input.thing})}))
def line(prefix: String, suffix: String) -> Document.Document:
  Document.text(textConcat(prefix, textConcat(suffix, "\n")))
def reference(prefix: String) -> Plans.Reference -> Document.Document:
  fn(item: Plans.Reference) -> Document.Document: line(prefix, item.object)
def exit(item: Exit) -> Document.Document:
  line("Exit ", textConcat(item.label, textConcat(" to ", item.to.object)))
def render(state: State) -> Document.Document:
  Document.Document.sequence({items: Lists.concat::<Document.Document>(Lists.concat::<Document.Document>(Lists.concat::<Document.Document>(Document.Documents.cons({head: line(state.name, ""), tail: Document.Documents.cons({head: line(state.description, ""), tail: Document.Documents.nil()})}), Lists.map::<Plans.Reference, Document.Document>(state.present, reference("Here: "))), Lists.map::<Plans.Reference, Document.Document>(state.things, reference("Lying here: "))), Lists.map::<Exit, Document.Document>(state.exits, exit))})
# The room card: description, who is here, what lies here, exits. The host takes
# a pure method to return the state record, so a card is shown by offering it.
def describe(state: State, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  match perform(Plan.offer({document: render(state)})):
    case offered(_): true
    case _: false
def card(state: State) -> String:
  Document.plain(render(state))
