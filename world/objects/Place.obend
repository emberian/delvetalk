edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Form.obend as Form
import ./World.obend as World
import ./Card.obend as Card
import ./Relation.obend as Relations
import ./Rows.obend as Rows
import ./Text.obend as Text
import ./Forms.obend as Forms
import ./Places.obend as Places
# PLACE (docs/CATALOGUE.md section 3): somewhere things are and people pass. Who is here, what lies
# here, its doors, the traces it keeps, and the kinds whose instances hang here (`makes`): a place
# makes one under itself by calling the kind's `makeUnder`, so the instance is <place>/<kind>/<n>
# with a door home. A garden is a place that makes bells; the Reading Room one that keeps no traces.
#
# The package declares no law: a lawful module cannot be imported, and every kind imports the
# package it makes. Its creator passes the law (`lawText` is the place's own).
#
# The make spell is the owner's `shape`: it grafts on the place a layer generated from its makes'
# forms (a `kind:` choice, then the union of their fields), as a kind's `shape` does for its own.
type Exit = Places.Exit
type Made = Places.Made
type Pending = Places.Pending
type State = Places.State
type Done = Places.Done
# What the kind answered to a make: the id it made, or its refusal.
sum Result:
  made: {object: String}
  refused: Card.Refusal
def objectKey(reference: Plans.Reference) -> {object: String}:
  Places.objectKey(reference)
def holds(relation: Relations.Relation<Plans.Reference>, reference: Plans.Reference) -> Bool:
  Places.holds(relation, reference)
def madeKey(m: Made) -> {object: String}:
  {object: m.object}
# What happened here: who acted (an avatar or a principal), their handle as the host knew
# it, the action, the refusal's clause ("" when admitted), the height its turn read and `n`,
# the count of traces then. Key order (n first) is the order they happened; the place keeps
# 64 (the host drops the oldest past them).
type Trace = Rows.Trace
def initial() -> State:
  {owner: "", ownerHandle: "", name: "", description: "", exits: Lists.List.nil(), present: Relations.empty(), things: Relations.empty(), traces: Relations.empty(), keep: 64n, makes: Lists.List.nil(), made: Relations.empty(), count: 0n, policy: Plans.nobody(), confirmFor: Lists.List.nil(), held: Relations.empty(), pageCheckpoint: ""}
# The place's law, as a kind passes it: the owner stays and alone renames, redescribes, reprograms
# or changes what it makes; anyone else only by its spells.
def lawText() -> String:
  "law owner \"the owner stays; only the owner renames, redescribes or reprograms it; anyone comes and goes by its spells\": unchanged(owner) and (request.subject == new.owner or (request.kind == 0 and unchanged(ownerHandle) and unchanged(name) and unchanged(description) and unchanged(exits) and unchanged(makes) and unchanged(keep) and unchanged(policy) and unchanged(confirmFor) and unchanged(pageCheckpoint)))"
def relations() -> Relations.Decls:
  Lists.append(Lists.append(Lists.append(Lists.append(Lists.append(Relations.Decls.nil(), {field: "present", key: Text.words("object"), limit: 256n}), {field: "things", key: Text.words("object"), limit: 256n}), {field: "traces", key: Text.words("at who action n"), limit: 64n}), {field: "made", key: Text.words("object"), limit: 1024n}), {field: "held", key: Text.words("principal"), limit: 64n})
sum Why:
  alreadyHere: {}
  notHere: {}
  notAThing: {doing: String}
  notPresent: {doing: String}
  notLying: {}
  alreadyLying: {}
  absent: {who: String}
  notOwner: {owner: String}
  notMade: {makes: String}
def refusal(w: Why) -> Card.Refusal:
  match w:
    case alreadyHere(_): {clause: "alreadyHere", reading: "Already here."}
    case notHere(_): {clause: "notHere", reading: "Not here."}
    case notAThing(n): {clause: "notAThing", reading: "Only a thing can {n.doing}."}
    case notPresent(n): {clause: "notPresent", reading: "Only someone here can {n.doing}."}
    case notLying(_): {clause: "notLying", reading: "That is not lying here."}
    case alreadyLying(_): {clause: "alreadyLying", reading: "That is already lying here."}
    case absent(a): {clause: "notHere", reading: "{a.who} is not here."}
    case notOwner(n): {clause: "notOwner", reading: "Only the room's owner changes it; that is {n.owner}"}
    case notMade(n): {clause: "notMade", reading: if n.makes == "" then "This place makes nothing." else "This place makes {n.makes}."}
def refused(w: Why) -> Done:
  Done.refused(refusal(w))
# A refusal the speaker reads: its line, offered, and nothing written.
def told(w: Why) -> Activity<Done>:
  Card.tell(refused(w), Document.text("Not done: {refusal(w).reading}\n"))
# Every enter, leave, take and put leaves a trace, admitted or refused, while the place keeps any
# (the card shows the newest eight; the host keeps 64).
def trace(action: String, clause: String, context: Abi.Context, state: State) -> Trace:
  {who: context.principal, handle: context.handle, action: action, clause: clause, at: context.height, n: Relations.count(state.traces)}
def traced(edits: Edits, action: String, context: Abi.Context, state: State) -> Activity<Done>:
  if state.keep == 0n then plain(edits) else tracedWith(edits, action, context, state)
def plain(edits: Edits) -> Activity<Done>:
  let written(_) = world.write(edits)
  Done.done({})
def tracedWith(edits: Edits, action: String, context: Abi.Context, state: State) -> Activity<Done>:
  let written(_) = world.write(extend(edits, {traces: Plans.Entries.insert({row: trace(action, "", context, state)})}))
  Done.done({})
def refusedTraced(w: Why, action: String, context: Abi.Context, state: State) -> Activity<Done>:
  if state.keep == 0n then refused(w) else refusedWritten(w, action, context, state)
def refusedWritten(w: Why, action: String, context: Abi.Context, state: State) -> Activity<Done>:
  let written(_) = write {traces: insert trace(action, refusal(w).clause, context, state)}
  refused(w)
# Whoever enters or leaves is the calling object, or, in a direct turn, the avatar of the
# principal (an avatar's id is its principal's DID).
def actor(context: Abi.Context) -> Plans.Reference:
  if context.caller == "" then person(context) else caller(context)
def caller(context: Abi.Context) -> Plans.Reference:
  {world: context.world, object: context.caller}
def person(context: Abi.Context) -> Plans.Reference:
  {world: context.world, object: context.principal}
def here(context: Abi.Context, state: State) -> Bool:
  holds(state.present, person(context))
# Join the people here; leave them.
def enter(state: State, context: Abi.Context) -> Activity<Done>:
  if holds(state.present, actor(context)) then refusedTraced(Why.alreadyHere({}), "enter", context, state) else traced(extend(keep(), {present: Plans.Entries.insert({row: actor(context)})}), "enter", context, state)
def leave(state: State, context: Abi.Context) -> Activity<Done>:
  if holds(state.present, actor(context)) == false then refusedTraced(Why.notHere({}), "leave", context, state) else traced(extend(keep(), {present: Plans.Entries.retract({key: objectKey(actor(context))})}), "leave", context, state)
# A thing leaves the floor into the hands of the principal, who must be here. Only the thing
# itself (the calling object) takes itself off the floor or puts itself down.
def take(state: State, context: Abi.Context) -> Activity<Done>:
  if context.caller == "" then refused(Why.notAThing({doing: "take itself"})) else if here(context, state) == false then refusedTraced(Why.notPresent({doing: "take things"}), "take", context, state) else if holds(state.things, caller(context)) == false then refusedTraced(Why.notLying({}), "take", context, state) else traced(extend(keep(), {things: Plans.Entries.retract({key: objectKey(caller(context))})}), "take", context, state)
def put(state: State, context: Abi.Context) -> Activity<Done>:
  if context.caller == "" then refused(Why.notAThing({doing: "put itself down"})) else if here(context, state) == false then refusedTraced(Why.notPresent({doing: "put things down"}), "put", context, state) else if holds(state.things, caller(context)) then refusedTraced(Why.alreadyLying({}), "put", context, state) else traced(extend(keep(), {things: Plans.Entries.insert({row: caller(context)})}), "put", context, state)
# Talk: `say` and `emote` offer a line, under the speaker's handle, to every avatar present
# (in key order, at most as many as one turn may send to), `whisper` to one of them. Only
# someone here talks.
form say:
  line: text 1..280
form emote:
  line: text 1..280
form whisper:
  to: text 1..160
  line: text 1..280
def say(state: State, input: {line: String}, context: Abi.Context) -> Activity<Done>:
  if here(context, state) then offered(Lists.take(Relations.rows(state.present), 32n), "{speaker(context)}: {input.line}\n") else told(Why.notPresent({doing: "say"}))
def emote(state: State, input: {line: String}, context: Abi.Context) -> Activity<Done>:
  if here(context, state) then offered(Lists.take(Relations.rows(state.present), 32n), "* {speaker(context)} {input.line}\n") else told(Why.notPresent({doing: "emote"}))
def whisper(state: State, input: {to: String, line: String}, context: Abi.Context) -> Activity<Done>:
  if here(context, state) == false then told(Why.notPresent({doing: "whisper"})) else whispered(Lists.find(Relations.rows(state.present), fn(p: Plans.Reference) -> Bool: p.object == input.to || Card.handle(p.object) == input.to), input.to, "{speaker(context)} whispers: {input.line}\n")
def whispered(found: Lists.Maybe<Plans.Reference>, to: String, line: String) -> Activity<Done>:
  match found:
    case some(p): offered(Lists.List.cons({head: p.value, tail: Lists.List.nil()}), line)
    case none(_): told(Why.absent({who: to}))
def speaker(context: Abi.Context) -> String:
  Card.name(context.principal, context)
def offered(present: Lists.List<Plans.Reference>, line: String) -> Activity<Done>:
  match present:
    case nil(_): Done.done({})
    case cons(c): offeredOne(c.head, c.tail, line)
def offeredOne(to: Plans.Reference, rest: Lists.List<Plans.Reference>, line: String) -> Activity<Done>:
  match world.offer({to: to.object, document: Document.text(line)}):
    case _: offered(rest, line)
# The owner's doors: eight at most, the exits an avatar's `move` takes.
form door:
  label: text 1..32
  to: text 1..128
form undoor:
  label: text 1..32
def door(state: State, input: {label: String, to: String}, context: Abi.Context) -> Activity<Card.Replied>:
  doored(Card.doorAdd(state.exits, state.owner, {label: input.label, to: {world: context.world, object: input.to}}, context), "door")
def undoor(state: State, input: {label: String}, context: Abi.Context) -> Activity<Card.Replied>:
  doored(Card.doorRemove(state.exits, state.owner, input.label, context), "undoor")
def doored(edit: Card.DoorEdit, action: String) -> Activity<Card.Replied>:
  match edit:
    case refused(r): Card.tell(Card.Replied.refused(r), Document.text("refused {r.clause}: {r.reading}\n"))
    case edit(e): doorWritten(e.entries, action)
def doorWritten(entries: Plans.Entries<Card.Doorway, Card.Doorway>, action: String) -> Activity<Card.Replied>:
  let written(_) = world.write(extend(keep(), {exits: entries}))
  Card.Replied.done({action: action})
# Making (docs/CATALOGUE.md section 3): the place makes an instance of one of its `makes` kinds
# under itself, <place>/<kind>/<n> with a door home, and answers the maker; the kind answers
# quietly. A body's `make` (the layer `shape` grafts) calls this with the kind's id and the fields
# its form took. A kind the place does not make is refused by name; a refusal the kind gave keeps
# the world's clause.
def making(state: State, kind: String, fields: Lists.List<Rows.Field>, context: Abi.Context) -> Activity<Result>:
  if Lists.any(state.makes, fn(r: Plans.Reference) -> Bool: r.object == kind) then calling(state, kind, fields, context) else turnedAway(Why.notMade({makes: makesWords(state)}))
def turnedAway(w: Why) -> Activity<Result>:
  Card.tell(Result.refused(refusal(w)), Document.text("Not done: {refusal(w).reading}\n"))
def calling(state: State, kind: String, fields: Lists.List<Rows.Field>, context: Abi.Context) -> Activity<Result>:
  match world.call::<Result>({object: {world: context.world, object: kind}, method: "makeUnder", argument: {under: context.object, fields: fields}}):
    case returned(r): recorded(state, kind, r.result, context)
    case refused(r): Card.tell(Result.refused({clause: r.clause, reading: r.reading}), Document.text("Not done: {r.reading}\n"))
    case denied(_): Card.tell(Result.refused({clause: "denied", reading: "That kind does not answer."}), Document.text("Not done: That kind does not answer.\n"))
def recorded(state: State, kind: String, result: Result, context: Abi.Context) -> Activity<Result>:
  match result:
    case made(m): counted(state, kind, m.object, result, context)
    case refused(r): Card.tell(result, Document.text("Not done: {r.reading}\n"))
def counted(state: State, kind: String, object: String, result: Result, context: Abi.Context) -> Activity<Result>:
  let written(_) = write {made: insert {object: object, kind: kind, n: state.count + 1n}, count: add 1n}
  Card.tellTo(result, context.principal, Document.text("Made, at {object}; {natText(state.count + 1n)} made here.\n"))
def lastSegment(id: String) -> String:
  let at = textBreak(id, "/")
  if at == textLength(id) then id else lastSegment(textDrop(id, at + 1n))
def kindName(kind: Plans.Reference) -> String:
  lastSegment(kind.object)
def makesWords(state: State) -> String:
  textJoin(Lists.map(state.makes, kindName), ", ")
# Shaping: the make spell is a layer generated from the forms of the kinds this place makes. The
# kinds' forms are read from their cards' states (`form`, one `name: kind` line a field).
# A view decodes the whole state, so this mirrors Kind.State (Kind imports this module and cannot be
# imported here); tests/test_kinds.py reads a real kind through it.
record KindMade:
  object: String
  n: Nat
record KindForm:
  owner: String
  ownerHandle: String
  name: String
  of: String
  form: String
  law: String
  head: String
  body: String
  made: Relations.Relation<KindMade>
  count: Nat
def shape(state: State, input: {object: String}, context: Abi.Context) -> Activity<Done>:
  if context.principal != state.owner then told(Why.notOwner({owner: Card.name(state.owner, context)})) else if Lists.length(madeKinds(state)) == 0n then told(Why.notMade({makes: ""})) else collected(state, madeKinds(state), "", context)
def collected(state: State, kinds: Lists.List<Plans.Reference>, forms: String, context: Abi.Context) -> Activity<Done>:
  match kinds:
    case nil(_): reshaped(state, forms, context)
    case cons(c): formRead(state, c.head, c.tail, forms, context)
def formRead(state: State, kind: Plans.Reference, rest: Lists.List<Plans.Reference>, forms: String, context: Abi.Context) -> Activity<Done>:
  match world.view::<KindForm>({object: kind}):
    case viewed(v): collected(state, rest, "{forms}{v.state.form}\n", context)
    case _: collected(state, rest, forms, context)
def reshaped(state: State, forms: String, context: Abi.Context) -> Activity<Done>:
  match world.extend({object: Plans.self(context), package: layerSource(state, forms), migration: ""}):
    case reprogrammed(_): Card.tell(Done.done({}), Document.text("Shaped; this place makes {makesWords(state)}.\n"))
    case refused(r): Card.tell(Done.refused({clause: r.clause, reading: r.reading}), Document.text("Not done: {r.reading}\n"))
# The kinds a spell can name: ids whose last segment is a word (letters and digits).
def madeKinds(state: State) -> Lists.List<Plans.Reference>:
  Lists.filter(state.makes, fn(r: Plans.Reference) -> Bool: Forms.sound({name: kindName(r), kind: ""}))
# The first of each name stands.
def deduped(items: Lists.List<Forms.Spec>) -> Lists.List<Forms.Spec>:
  match items:
    case nil(_): Lists.List.nil()
    case cons(c): Lists.List.cons({head: c.head, tail: deduped(Lists.filter(c.tail, fn(s: Forms.Spec) -> Bool: s.name != c.head.name))})
def kindOptions(state: State) -> String:
  textJoin(Lists.map(deduped(Lists.map(madeKinds(state), fn(r: Plans.Reference) -> Forms.Spec: {name: kindName(r), kind: ""})), fn(s: Forms.Spec) -> String: s.name), " | ")
# The fields the kinds' forms take, in order, each name once; `kind` is the choice's own.
def fieldSpecs(forms: String) -> Lists.List<Forms.Spec>:
  deduped(Lists.filter(Lists.filter(Forms.specs(forms), Forms.sound), fn(s: Forms.Spec) -> Bool: s.name != "kind"))
# The layer: every base form is declared again (a layer's forms replace the ones below) and
# delegates, then the make.
def delegates() -> String:
  "type State = Super.State\nform say:\n  line: text 1..280\nform emote:\n  line: text 1..280\nform whisper:\n  to: text 1..160\n  line: text 1..280\nform door:\n  label: text 1..32\n  to: text 1..128\nform undoor:\n  label: text 1..32\ndef say(state: State, input: SayInput, context: Abi.Context) -> Activity<Super.Done>:\n  Super.say(state, {{line: input.line}}, context)\ndef emote(state: State, input: EmoteInput, context: Abi.Context) -> Activity<Super.Done>:\n  Super.emote(state, {{line: input.line}}, context)\ndef whisper(state: State, input: WhisperInput, context: Abi.Context) -> Activity<Super.Done>:\n  Super.whisper(state, {{to: input.to, line: input.line}}, context)\ndef door(state: State, input: DoorInput, context: Abi.Context) -> Activity<Card.Replied>:\n  Super.door(state, {{label: input.label, to: input.to}}, context)\ndef undoor(state: State, input: UndoorInput, context: Abi.Context) -> Activity<Card.Replied>:\n  Super.undoor(state, {{label: input.label}}, context)\n"
def layerSource(state: State, forms: String) -> String:
  let fields = fieldSpecs(forms)
  let choice = kindOptions(state)
  let formLines = textJoin(Lists.map(fields, Forms.formLine), "")
  let converters = textJoin(Lists.map(fields, Forms.converter), "")
  let spell = textJoin(Lists.map(Lists.List.cons({head: {name: "kind", kind: choice}, tail: fields}), Forms.spellField), "")
  let options = textJoin(Lists.map(Forms.split(choice, "|"), kindCase), "")
  let cases = textJoin(Lists.map(Forms.split(choice, "|"), Forms.caseLine), "")
  "layer over ./Place.obend\nedition ObjectiveBend 1\nimport ./Abi.obend as Abi\nimport ./List.obend as Lists\nimport ./Text.obend as Text\nimport ./Card.obend as Card\nimport ./Form.obend as Form\nimport ./Rows.obend as Rows\n{delegates()}sum Makeable:\n{options}form make:\n  kind: Makeable\n{formLines}def make(state: State, input: MakeInput, context: Abi.Context) -> Activity<Super.Result>:\n  Super.making(state, \"kind/{{makeKindText(input.kind)}}\", {Forms.fieldsExpr(fields)}, context)\ndef makeLine(state: State, id: String) -> String:\n  \"Make one: delvetalk {{id}} make{spell}\"\ndef makeWords(state: State) -> Lists.List<String>:\n  Text.words(\"make\")\ndef makeKindText(c: Makeable) -> String:\n  match c:\n{cases}{converters}"
def kindCase(option: String) -> String:
  "  {Text.trim(option)}: {{}}\n"
# What a base place offers of making: nothing; the grafted layer overrides both.
def makeLine(state: State, id: String) -> String:
  ""
def makeWords(state: State) -> Lists.List<String>:
  Text.words("")
# The room's name and description are lenses: `delvetalk <room> set` and `name: ...`, the
# owner's (the law refuses the same write from anyone else).
def lenses() -> Lists.List<Form.Field>:
  Lists.append(Lists.append(Lists.append(Lists.List.nil(), {name: "name", kind: Form.Kind.text({min: 1n, max: 64n})}), {name: "description", kind: Form.Kind.text({min: 0n, max: 280n})}), {name: "traces", kind: Form.Kind.natural({min: 0n, max: 64n})})
# The host judged the value against the lens's kind; an unlensed field never reaches here.
def set(state: State, input: {field: String, value: Form.Value}, context: Abi.Context) -> Activity<Done>:
  if context.principal != state.owner then told(Why.notOwner({owner: Card.name(state.owner, context)})) else setting(input.field, Card.valueText(input.value))
# `traces` is how many the place keeps (0: none, so the card says nothing of who passed).
def setting(field: String, value: String) -> Activity<Done>:
  let written(_) = world.write(if field == "name" then extend(keep(), {name: Plans.Edit.set({value: value})}) else if field == "traces" then extend(keep(), {keep: Plans.Edit.set({value: Text.digits(value, 0n)})}) else extend(keep(), {description: Plans.Edit.set({value: value})}))
  Card.tell(Done.done({}), Document.text("Set {field} to {value}.\n"))
# A room is entered and left by an avatar's move, and things take and put themselves.
def methods() -> Lists.List<String>:
  Text.words("enter leave take put shape")
# What the host offers a reader: talk and make to everyone, the doors and the shape to the owner.
def actions(state: State, context: Abi.Context) -> Lists.List<String>:
  Lists.concat(Lists.concat(Text.words("say emote whisper"), makeWords(state)), if context.principal == state.owner then Text.words("door undoor shape") else Text.words(""))
def placeWord() -> String:
  "<place>"
def line(prefix: String, suffix: String) -> Document.Document:
  Document.text("{prefix}{suffix}\n")
def reference(prefix: String) -> Plans.Reference -> Document.Document:
  fn(item: Plans.Reference) -> Document.Document: line(prefix, Card.handle(item.object))
def sized(lines: Document.Documents) -> Nat:
  Document.size(Document.Document.sequence({items: lines}))
def less(room: Nat, used: Nat) -> Nat:
  if used >= room then 0n else room - used
def one(document: Document.Document) -> Document.Documents:
  Document.Documents.cons({head: document, tail: Document.Documents.nil()})
# The card: name and description, who is here and what lies here, the doors, how to talk and
# leave, how to make, what was made, then the traces. Every list gets what the fixed lines leave
# of Card.limit(), one after another; 60 characters are kept for the traces' header and footer.
def render(state: State, context: Abi.Context) -> Document.Document:
  let id = Card.called(context, placeWord())
  let top = Document.Documents.cons({head: line(state.name, ""), tail: one(line(state.description, ""))})
  let doors = Lists.concat(Card.doorLines(state.exits), one(line("Say: delvetalk {id} say / line: <text>. Leave: delvetalk <your avatar> move / exit: <label>.", "")))
  let making = Lists.concat(makeDocs(state, id), madeHeader(state))
  let you = hereLine(state, context)
  let room = Card.left(sized(top) + sized(doors) + sized(making) + sized(you) + 60n)
  let present = Card.clippedWithin(Lists.map(Relations.rows(state.present), reference("Here: ")), 8n, room)
  let lying = Card.clippedWithin(Lists.map(Relations.rows(state.things), reference("Lying here: ")), 8n, less(room, sized(present)))
  let made = Card.clippedWithin(Lists.map(newest(state), madeLine), 8n, less(room, sized(present) + sized(lying)))
  let traces = traceLines(state, less(room, sized(present) + sized(lying) + sized(made)))
  Document.Document.sequence({items: Lists.concat(Lists.concat(top, Lists.concat(present, lying)), Lists.concat(Lists.concat(doors, Lists.concat(making, made)), Lists.concat(you, traces)))})
# The make spell, one line, at most 300 characters (the place's makes bound nothing else).
def makeDocs(state: State, id: String) -> Document.Documents:
  if makeLine(state, id) == "" then Document.Documents.nil() else one(line(textTake(makeLine(state, id), 300n), ""))
def madeHeader(state: State) -> Document.Documents:
  if state.count == 0n then Document.Documents.nil() else one(line("{natText(state.count)} made here, newest first:", ""))
def newest(state: State) -> Lists.List<Made>:
  Lists.reverse(Relations.order(state.made, fn(m: Made) -> Nat: m.n))
def madeLine(m: Made) -> Document.Document:
  line("- ", m.object)
def traceLines(state: State, room: Nat) -> Document.Documents:
  if state.keep == 0n || Relations.count(state.traces) == 0n then Document.Documents.nil() else Document.Documents.cons({head: line("Traces, the last eight, refusals too:", ""), tail: Card.clippedWithin(Lists.map(Lists.take(Lists.reverse(Relations.rows(state.traces)), shownTraces(state)), traceLine), shownTraces(state), room)})
def shownTraces(state: State) -> Nat:
  if state.keep < 8n then state.keep else 8n
def traceLine(t: Trace) -> Document.Document:
  line("  {Card.shown(t.who, t.handle, Card.stranger())} {t.action}", if t.clause == "" then "" else ": refused {t.clause}")
# A reader whose avatar is here is told so.
def hereLine(state: State, context: Abi.Context) -> Document.Documents:
  if here(context, state) then one(line("You are here.", "")) else Document.Documents.nil()
# Derived views (FOUNDATION §9, `viewDerived {object, view}`).
def views() -> Lists.List<String>:
  Text.words("affordances")
# What can be done here, as spells: this room's own forms, then for each thing lying here
# taking it (a thing acquires itself into the taker's hands), then each exit as the reader's
# avatar's move (an avatar's id is its principal's DID).
def affordances(state: State, context: Abi.Context) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Card.usage(context.object, forms()), tail: Lists.concat(Lists.map(Relations.rows(state.things), fn(t: Plans.Reference) -> Document.Document: Document.text("\n    delvetalk {t.object} acquire\n")), Lists.map(state.exits, fn(e: Exit) -> Document.Document: Document.text("\n    delvetalk {context.principal} move\n    exit: {e.label}\n")))})})
def blurb() -> Card.Door:
  {word: "place", blurb: "A room: who is here, what lies here, the exits."}
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
