edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Form.obend as Form
import ./Card.obend as Card
record Exit:
  label: String
  to: Plans.Reference
# owner: who may rename and redescribe the room (by its name and description lenses).
# A Place is imported by Thing and Avatar for its State and Done, so it cannot declare a
# law ("a law belongs to the package's entry module"): the guard is the code's.
record State:
  owner: String
  name: String
  description: String
  exits: Lists.List<Exit>
  present: Lists.List<Plans.Reference>
  things: Lists.List<Plans.Reference>
# Every method that can refuse answers with this sum.
sum Done:
  done: {}
  refused: {reason: String}
# A creator supplies a Seed; seeded makes the child's State from it.
record Seed:
  owner: String
  name: String
  description: String
  exits: Lists.List<Exit>
  present: Lists.List<Plans.Reference>
  things: Lists.List<Plans.Reference>
record Edits:
  name: Plans.Edit<String, {}>
  description: Plans.Edit<String, {}>
  present: Plans.Entries<Plans.Reference, {}>
  things: Plans.Entries<Plans.Reference, {}>
# No call carries an argument: who is acting is the context's business.
type Plan = Plans.Plan<Edits>
type Response = Plans.Response<State, {}>
def defaultSeed() -> Seed:
  {owner: "", name: "", description: "", exits: Lists.List::<Exit>.nil(), present: Lists.List::<Plans.Reference>.nil(), things: Lists.List::<Plans.Reference>.nil()}
def seeded(seed: Seed) -> State:
  {owner: seed.owner, name: seed.name, description: seed.description, exits: seed.exits, present: seed.present, things: seed.things}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {name: Plans.Edit::<String, {}>.keep({}), description: Plans.Edit::<String, {}>.keep({}), present: Plans.Entries::<Plans.Reference, {}>.keep({}), things: Plans.Entries::<Plans.Reference, {}>.keep({})}
def written(context: Abi.Context, edits: Edits) -> Activity<Plan, Response, Done>:
  match perform(Plan.write({object: Plans.self(context), edits: edits})):
    case written(_): Done.done({})
    case _: Done.refused({reason: "The write was not answered."})
# Whoever enters or leaves is the calling object, or, in a direct turn, the avatar
# of the principal (an avatar's id is its principal's DID).
def actor(context: Abi.Context) -> Plans.Reference:
  if context.caller == "" then {world: context.world, object: context.principal} else {world: context.world, object: context.caller}
def caller(context: Abi.Context) -> Plans.Reference:
  {world: context.world, object: context.caller}
# Join the people here. Law decides whether the subject may enter.
def enter(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match Plans.indexOf(state.present, actor(context)):
    case some(_): Done.refused({reason: "Already here."})
    case none(_): written(context, extend(keep(), {present: Plans.Entries::<Plans.Reference, {}>.append({item: actor(context)})}))
def leave(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match Plans.indexOf(state.present, actor(context)):
    case none(_): Done.refused({reason: "Not here."})
    case some(_): written(context, extend(keep(), {present: Plans.Entries::<Plans.Reference, {}>.removeItem({item: actor(context)})}))
# A thing leaves the floor into the hands of the principal, who must be here. Only
# the thing itself (the calling object) takes itself off the floor.
def person(context: Abi.Context) -> Plans.Reference:
  {world: context.world, object: context.principal}
def take(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  if context.caller == "" then Done.refused({reason: "Only a thing can take itself."}) else takeFrom(state, context)
def takeFrom(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match Plans.indexOf(state.present, person(context)):
    case none(_): Done.refused({reason: "Only someone here can take things."})
    case some(_): takeThing(state, context)
def takeThing(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match Plans.indexOf(state.things, caller(context)):
    case none(_): Done.refused({reason: "That is not lying here."})
    case some(_): written(context, extend(keep(), {things: Plans.Entries::<Plans.Reference, {}>.removeItem({item: caller(context)})}))
def put(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  if context.caller == "" then Done.refused({reason: "Only a thing can put itself down."}) else putFrom(state, context)
def putFrom(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match Plans.indexOf(state.present, person(context)):
    case none(_): Done.refused({reason: "Only someone here can put things down."})
    case some(_): putThing(state, context)
def putThing(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match Plans.indexOf(state.things, caller(context)):
    case some(_): Done.refused({reason: "That is already lying here."})
    case none(_): written(context, extend(keep(), {things: Plans.Entries::<Plans.Reference, {}>.append({item: caller(context)})}))
def line(prefix: String, suffix: String) -> Document.Document:
  Document.text(textConcat(prefix, textConcat(suffix, "\n")))
def reference(prefix: String) -> Plans.Reference -> Document.Document:
  fn(item: Plans.Reference) -> Document.Document: line(prefix, Card.handle(item.object))
def exit(item: Exit) -> Document.Document:
  line("Exit ", textConcat(item.label, textConcat(" to ", item.to.object)))
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.Document.sequence({items: Lists.concat::<Document.Document>(Lists.concat::<Document.Document>(Lists.concat::<Document.Document>(Document.Documents.cons({head: line(state.name, ""), tail: Document.Documents.cons({head: line(state.description, ""), tail: Document.Documents.nil()})}), Card.clipped(Lists.map::<Plans.Reference, Document.Document>(state.present, reference("Here: ")), 8n)), Card.clipped(Lists.map::<Plans.Reference, Document.Document>(state.things, reference("Lying here: ")), 8n)), Lists.concat::<Document.Document>(Lists.map::<Exit, Document.Document>(state.exits, exit), hereLine(state, context)))})
# A reader whose avatar is here is told so.
def hereLine(state: State, context: Abi.Context) -> Document.Documents:
  match Plans.indexOf(state.present, person(context)):
    case some(_): Document.Documents.cons({head: line("You are here.", ""), tail: Document.Documents.nil()})
    case none(_): Document.Documents.nil()
# A room is entered and left by an avatar's move, and things take and put themselves:
# its card offers no spell of its own.
def forms() -> Card.Forms:
  Card.Forms.nil()
def door() -> Card.Door:
  {word: "place", blurb: "A room: who is here, what lies here, the exits."}
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  Card.answerLensed::<Edits, State, {}>(Card.route(input.text, context, forms()), context, forms(), lenses(), if state.owner != "" && context.principal == state.owner then "" else textConcat("Only the room's owner changes it; that is ", Card.handle(state.owner)), render(state, context))
def lenses() -> Lists.List<Form.Lens<Edits>>:
  Lists.List::<Form.Lens<Edits>>.cons({head: Form.Lens::<Edits>.lens({field: "name", form: Form.Kind.text({min: 1n, max: 64n}), put: fn(v: Form.Value) -> Edits: extend(keep(), {name: Plans.Edit::<String, {}>.set({value: Card.valueText(v)})})}), tail: Lists.List::<Form.Lens<Edits>>.cons({head: Form.Lens::<Edits>.lens({field: "description", form: Form.Kind.text({min: 0n, max: 280n}), put: fn(v: Form.Value) -> Edits: extend(keep(), {description: Plans.Edit::<String, {}>.set({value: Card.valueText(v)})})}), tail: Lists.List::<Form.Lens<Edits>>.nil()})})
