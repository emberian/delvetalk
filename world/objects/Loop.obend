edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
record State:
  count: Nat
def initial() -> State:
  {count: 0n}
# Counts and sends tick to itself: the cycle the host's causal ledger must stop.
def tick(state: State, context: Abi.Context) -> Activity<Nat>:
  let written(_) = write {count: add 1n}
  again(state.count + 1n, context)
def again(count: Nat, context: Abi.Context) -> Activity<Nat>:
  match world.send({object: Plans.self(context), method: "tick", argument: Plans.nothing()}):
    case _: count
form tick:
def forms() -> Card.Forms:
  Card.Forms.cons({head: tickForm(), tail: Card.Forms.nil()})
def blurb() -> Card.Door:
  {word: "loop", blurb: "Ticks itself until the causal budget runs out."}
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.text("Ticks: {natText(state.count)}\n")
