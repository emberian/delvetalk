edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Document.obend as Document
import ./Plan.obend as Plans
record State:
  count: Nat
record Edits:
  count: Plans.Edit<Nat, Nat>
type Plan = Plans.Plan<Edits, {}>
type Response = Plans.Response<State, {}>
def initial() -> State:
  {count: 0n}
# Counts and sends tick to itself: the cycle the host's causal ledger must stop.
def tick(state: State, context: Abi.Context) -> Activity<Plan, Response, Nat>:
  match perform(Plan.write({object: Plans.self(context), edits: {count: Plans.Edit::<Nat, Nat>.add({delta: 1n})}})):
    case written(_): again(state, context)
    case _: state.count
def again(state: State, context: Abi.Context) -> Activity<Plan, Response, Nat>:
  match perform(Plan.send({object: Plans.self(context), method: "tick", argument: {}})):
    case _: state.count + 1n
def render(state: State) -> Document.Document:
  Document.text(textConcat("Ticks: ", textConcat(natText(state.count), "\n")))
def card(state: State) -> String:
  Document.plain(render(state))
