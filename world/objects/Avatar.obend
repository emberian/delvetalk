edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Place.obend as Place
import ./Form.obend as Form
import ./Card.obend as Card
record Note:
  from: String
  text: String
# The object a verified principal gets; its id is the principal's DID string.
# Its mailbox: who is told when its principal sends (observers, each by the method it
# named), and what it follows (the objects it asked to tell it, by `notice` or `note`).
record State:
  handle: String
  at: Plans.Reference
  holding: Lists.List<Plans.Reference>
  inbox: Lists.List<Note>
  observers: Card.Observers
  following: Lists.List<Plans.Reference>
# A creator supplies a Seed; seeded makes the child's State from it.
record Seed:
  handle: String
  at: Plans.Reference
  holding: Lists.List<Plans.Reference>
record Edits:
  handle: Plans.Edit<String, {}>
  at: Plans.Edit<Plans.Reference, {}>
  holding: Plans.Entries<Plans.Reference, {}>
  inbox: Plans.Entries<Note, {}>
  observers: Plans.Entries<Card.Observer, {}>
  following: Plans.Entries<Plans.Reference, {}>
# Its calls into places carry nothing: the place reads the mover from its caller.
type Plan = Plans.Plan<Edits>
type Response = Plans.Response<Place.State, Place.Done>
sum Moved:
  moved: {to: Plans.Reference}
  refused: {reason: String}
sum Found:
  none: {}
  some: {exit: Place.Exit}
def defaultSeed() -> Seed:
  {handle: "", at: Plans.nobody(), holding: Lists.List::<Plans.Reference>.nil()}
def seeded(seed: Seed) -> State:
  {handle: seed.handle, at: seed.at, holding: seed.holding, inbox: Lists.List::<Note>.nil(), observers: Card.Observers.nil(), following: Lists.List::<Plans.Reference>.nil()}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {handle: Plans.Edit::<String, {}>.keep({}), at: Plans.Edit::<Plans.Reference, {}>.keep({}), holding: Plans.Entries::<Plans.Reference, {}>.keep({}), inbox: Plans.Entries::<Note, {}>.keep({}), observers: Plans.Entries::<Card.Observer, {}>.keep({}), following: Plans.Entries::<Plans.Reference, {}>.keep({})}
def edited(edits: Edits, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  match perform(Plan.write({object: Plans.self(context), edits: edits})):
    case written(_): true
    case _: false
# An avatar answers only to its own principal: its id is the principal's DID.
def mine(context: Abi.Context) -> Bool:
  context.principal == context.object
# Appears somewhere: the place's own record of who is present is its business.
def arrive(state: State, input: {at: Plans.Reference}, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  if mine(context) then edited(extend(keep(), {at: Plans.Edit::<Plans.Reference, {}>.set({value: input.at})}), context) else false
# A note from the turn's principal; it is appended in the order it arrives.
# The inbox keeps the newest 64 notes: a full inbox drops its oldest first.
def noted<T>(state: State, from: String, text: String, context: Abi.Context, then: Bool -> T) -> Activity<Plan, Response, T>:
  match state.inbox:
    case cons(c): if Lists.length::<Note>(state.inbox) < 64n then posted::<T>(from, text, context, then) else crowded::<T>(c.head, from, text, context, then)
    case nil(_): posted::<T>(from, text, context, then)
def crowded<T>(oldest: Note, from: String, text: String, context: Abi.Context, then: Bool -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {inbox: Plans.Entries::<Note, {}>.removeItem({item: oldest})})})):
    case _: posted::<T>(from, text, context, then)
def posted<T>(from: String, text: String, context: Abi.Context, then: Bool -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {inbox: Plans.Entries::<Note, {}>.append({item: {from: from, text: text}})})})):
    case _: then(true)
def note(state: State, input: {text: String}, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  noted::<Bool>(state, context.principal, input.text, context, fn(done: Bool) -> Bool: done)
# What an observed object (a bell, a door) sends with nothing: a note that it moved,
# from the object that told it.
def notice(state: State, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  noted::<Bool>(state, if context.caller == "" then context.principal else context.caller, textConcat("news from ", if context.caller == "" then Card.handle(context.principal) else context.caller), context, fn(done: Bool) -> Bool: done)
# --- The mailbox -------------------------------------------------------------------
# One turn may send at most sendsPerTurn (the host's Limits.sendsPerTurn, 32; a turn
# past it is refused whole), so the mailing list holds that many and a send to all of
# it is one turn's worth.
def sendsPerTurn() -> Nat:
  32n
# An object observes this avatar only for itself: the observer named is the caller.
def observe(state: State, input: Card.Observer, context: Abi.Context) -> Activity<Plan, Response, Card.Change>:
  if input.object.object != context.caller && input.object.object != context.principal then Card.Change.refused({reason: "An observer adds only itself."}) else observeChanged(Card.observingUpTo(state.observers, input, sendsPerTurn()), context)
def unobserve(state: State, input: Card.Observer, context: Abi.Context) -> Activity<Plan, Response, Card.Change>:
  if input.object.object != context.caller && input.object.object != context.principal && mine(context) == false then Card.Change.refused({reason: "An observer removes only itself."}) else observeChanged(Card.unobserving(state.observers, input), context)
def observeChanged(change: Card.Change, context: Abi.Context) -> Activity<Plan, Response, Card.Change>:
  match change:
    case edit(e): observeWritten(change, e.entries, context)
    case _: change
def observeWritten(change: Card.Change, entries: Plans.Entries<Card.Observer, {}>, context: Abi.Context) -> Activity<Plan, Response, Card.Change>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {observers: entries})})):
    case _: change
sum Mailed:
  sent: {count: Nat}
  followed: {object: Plans.Reference}
  refused: {reason: String}
def mailedReply(action: String) -> Mailed -> Card.Reply:
  fn(mailed: Mailed) -> Card.Reply: mailedAs(action, mailed)
def mailedAs(action: String, mailed: Mailed) -> Card.Reply:
  match mailed:
    case refused(r): Card.Reply.refused({reason: r.reason})
    case _: Card.Reply.done({action: action})
# The avatar's principal sends a line to every observer, each by the method it named.
def sent<T>(state: State, text: String, context: Abi.Context, then: Mailed -> T) -> Activity<Plan, Response, T>:
  if mine(context) == false then then(Mailed.refused({reason: "Only the avatar's own principal sends from it."})) else if Lists.length::<Card.Observer>(state.observers) > sendsPerTurn() then then(Mailed.refused({reason: "More observers than one turn may send to."})) else Card.broadcast::<Edits, Place.State, Place.Done, T>(state.observers, Data.of::<{text: String}>({text: text}), 0n, fn(count: Nat) -> T: then(Mailed.sent({count: count})))
def send(state: State, input: {text: String}, context: Abi.Context) -> Activity<Plan, Response, Mailed>:
  sent::<Mailed>(state, input.text, context, fn(m: Mailed) -> Mailed: m)
# Subscribe to an object: ask it (a send: its observe runs in its own turn, under its
# law) to tell this avatar, by `note` with a line when it is an avatar (a DID) and by
# `notice` otherwise, and remember following it.
def methodFor(object: Plans.Reference) -> String:
  if textTake(object.object, 4n) == "did:" then "note" else "notice"
def subscribed<T>(state: State, object: Plans.Reference, context: Abi.Context, then: Mailed -> T) -> Activity<Plan, Response, T>:
  if mine(context) == false then then(Mailed.refused({reason: "Only the avatar's own principal subscribes it."})) else if Lists.any::<Plans.Reference>(state.following, fn(f: Plans.Reference) -> Bool: Plans.same(f, object)) then then(Mailed.refused({reason: textConcat("Already following ", object.object)})) else if Lists.length::<Plans.Reference>(state.following) >= sendsPerTurn() then then(Mailed.refused({reason: "Following thirty-two is the most."})) else asking::<T>(object, context, then)
def asking<T>(object: Plans.Reference, context: Abi.Context, then: Mailed -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.send({object: object, method: "observe", argument: Data.of::<Card.Observer>({object: Plans.self(context), method: methodFor(object)})})):
    case delivery(_): following::<T>(object, context, then)
    case _: then(Mailed.refused({reason: textConcat("Could not ask ", object.object)}))
def following<T>(object: Plans.Reference, context: Abi.Context, then: Mailed -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {following: Plans.Entries::<Plans.Reference, {}>.append({item: object})})})):
    case _: then(Mailed.followed({object: object}))
def subscribe(state: State, input: {object: Plans.Reference}, context: Abi.Context) -> Activity<Plan, Response, Mailed>:
  subscribed::<Mailed>(state, input.object, context, fn(m: Mailed) -> Mailed: m)
def unsubscribed<T>(state: State, object: Plans.Reference, context: Abi.Context, then: Mailed -> T) -> Activity<Plan, Response, T>:
  if mine(context) == false then then(Mailed.refused({reason: "Only the avatar's own principal unsubscribes it."})) else unfollowing::<T>(Lists.find::<Plans.Reference>(state.following, fn(f: Plans.Reference) -> Bool: Plans.same(f, object)), object, context, then)
def unfollowing<T>(found: Lists.Maybe<Plans.Reference>, object: Plans.Reference, context: Abi.Context, then: Mailed -> T) -> Activity<Plan, Response, T>:
  match found:
    case none(_): then(Mailed.refused({reason: textConcat("Not following ", object.object)}))
    case some(s): unasking::<T>(s.value, context, then)
def unasking<T>(object: Plans.Reference, context: Abi.Context, then: Mailed -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.send({object: object, method: "unobserve", argument: Data.of::<Card.Observer>({object: Plans.self(context), method: methodFor(object)})})):
    case _: unfollowed::<T>(object, context, then)
def unfollowed<T>(object: Plans.Reference, context: Abi.Context, then: Mailed -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {following: Plans.Entries::<Plans.Reference, {}>.removeItem({item: object})})})):
    case _: then(Mailed.followed({object: object}))
def unsubscribe(state: State, input: {object: Plans.Reference}, context: Abi.Context) -> Activity<Plan, Response, Mailed>:
  unsubscribed::<Mailed>(state, input.object, context, fn(m: Mailed) -> Mailed: m)
# Things call hold and release on their holder's avatar. Both are idempotent and
# never refuse, so a thing that has already staged its own writes cannot be left
# half done. The thing is the calling object; the giver is the turn's principal, and
# receiving something from somebody else also leaves a note.
def thing(context: Abi.Context) -> Plans.Reference:
  {world: context.world, object: context.caller}
def hold(state: State, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  if context.caller == "" then Place.Done.refused({reason: "Only a thing can be held."}) else holdThing(state, context)
def holdThing(state: State, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  match Plans.indexOf(state.holding, thing(context)):
    case some(_): Place.Done.done({})
    case none(_): held(context)
def held(context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {holding: Plans.Entries::<Plans.Reference, {}>.append({item: thing(context)}), inbox: gift(context)})})):
    case _: Place.Done.done({})
def gift(context: Abi.Context) -> Plans.Entries<Note, {}>:
  if mine(context) then Plans.Entries::<Note, {}>.keep({}) else Plans.Entries::<Note, {}>.append({item: {from: context.principal, text: textConcat("gave you ", context.caller)}})
def release(state: State, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  if context.caller == "" then Place.Done.refused({reason: "Only a thing can be released."}) else releaseThing(state, context)
def releaseThing(state: State, context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  match Plans.indexOf(state.holding, thing(context)):
    case none(_): Place.Done.done({})
    case some(_): released(context)
def released(context: Abi.Context) -> Activity<Plan, Response, Place.Done>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {holding: Plans.Entries::<Plans.Reference, {}>.removeItem({item: thing(context)})})})):
    case _: Place.Done.done({})
def find(exits: Lists.List<Place.Exit>, label: String) -> Found:
  match exits:
    case nil(_): Found.none({})
    case cons(c): if c.head.label == label then Found.some({exit: c.head}) else find(c.tail, label)
# Walk through an exit of the current place: view it, leave it, enter the next
# place, and record where we are. A typed refusal before any write leaves nothing
# changed; the calls into places are the only things staged. Each step carries what
# the walk finishes with (`then`), so receive can walk too.
def move(state: State, input: {exit: String}, context: Abi.Context) -> Activity<Plan, Response, Moved>:
  walk::<Moved>(state, input.exit, context, fn(moved: Moved) -> Moved: moved)
def walk<T>(state: State, label: String, context: Abi.Context, then: Moved -> T) -> Activity<Plan, Response, T>:
  if mine(context) then looked::<T>(state, label, context, then) else then(Moved.refused({reason: "Only the avatar's own principal moves it."}))
def looked<T>(state: State, label: String, context: Abi.Context, then: Moved -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.view({object: state.at})):
    case viewed(v): through::<T>(state, label, context, find(v.state.exits, label), then)
    case denied(_): then(Moved.refused({reason: "The place is not visible."}))
    case _: then(Moved.refused({reason: "The place did not answer."}))
def through<T>(state: State, label: String, context: Abi.Context, found: Found, then: Moved -> T) -> Activity<Plan, Response, T>:
  match found:
    case none(_): then(Moved.refused({reason: textConcat("There is no exit named ", label)}))
    case some(s): leaving::<T>(state, s.exit.to, context, then)
def leaving<T>(state: State, to: Plans.Reference, context: Abi.Context, then: Moved -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.call({object: state.at, method: "leave", argument: Plans.nothing()})):
    case returned(r): left::<T>(r.result, to, context, then)
    case _: then(Moved.refused({reason: "The place did not answer."}))
def left<T>(result: Place.Done, to: Plans.Reference, context: Abi.Context, then: Moved -> T) -> Activity<Plan, Response, T>:
  match result:
    case done(_): entering::<T>(to, context, then)
    case refused(r): then(Moved.refused({reason: r.reason}))
def entering<T>(to: Plans.Reference, context: Abi.Context, then: Moved -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.call({object: to, method: "enter", argument: Plans.nothing()})):
    case returned(r): entered::<T>(r.result, to, context, then)
    case _: then(Moved.refused({reason: "The place did not answer."}))
def entered<T>(result: Place.Done, to: Plans.Reference, context: Abi.Context, then: Moved -> T) -> Activity<Plan, Response, T>:
  match result:
    case done(_): arrived::<T>(to, context, then)
    case refused(r): then(Moved.refused({reason: r.reason}))
def arrived<T>(to: Plans.Reference, context: Abi.Context, then: Moved -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.write({object: Plans.self(context), edits: extend(keep(), {at: Plans.Edit::<Plans.Reference, {}>.set({value: to})})})):
    case _: then(Moved.moved({to: to}))
def forms() -> Card.Forms:
  Card.Forms.cons({head: {card: "", action: "move", fields: Form.Fields.cons({head: {name: "exit", kind: Form.Kind.text({min: 1n, max: 64n})}, tail: Form.Fields.nil()})}, tail: Card.Forms.cons({head: {card: "", action: "note", fields: Form.Fields.cons({head: {name: "text", kind: Form.Kind.text({min: 1n, max: 280n})}, tail: Form.Fields.nil()})}, tail: Card.Forms.cons({head: {card: "", action: "send", fields: Form.Fields.cons({head: {name: "text", kind: Form.Kind.text({min: 1n, max: 280n})}, tail: Form.Fields.nil()})}, tail: Card.Forms.cons({head: {card: "", action: "subscribe", fields: Form.Fields.cons({head: {name: "to", kind: Form.Kind.text({min: 1n, max: 160n})}, tail: Form.Fields.nil()})}, tail: Card.Forms.cons({head: {card: "", action: "unsubscribe", fields: Form.Fields.cons({head: {name: "to", kind: Form.Kind.text({min: 1n, max: 160n})}, tail: Form.Fields.nil()})}, tail: Card.Forms.nil()})})})})})
def door() -> Card.Door:
  {word: "avatar", blurb: "You in the world: move through exits, leave notes, follow things and send to your followers."}
def movedReply(moved: Moved) -> Card.Reply:
  match moved:
    case moved(_): Card.Reply.done({action: "move"})
    case refused(r): Card.Reply.refused({reason: r.reason})
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  heard(state, Card.route(input.text, context, forms()), context)
def heard(state: State, routed: Card.Routed, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  match routed:
    case act(a): if a.action == "move" then walk::<Card.Reply>(state, Card.text(a.fields, "exit"), context, movedReply) else acted(state, a.action, a.fields, context)
    case _: Card.answerLensed::<Edits, Place.State, Place.Done>(routed, context, forms(), lenses(), if mine(context) then "" else "Only the avatar's own principal changes it.", render(state, context))
def acted(state: State, action: String, fields: Card.Fields, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  if action == "note" then noted::<Card.Reply>(state, context.principal, Card.text(fields, "text"), context, fn(done: Bool) -> Card.Reply: Card.Reply.done({action: "note"})) else if action == "send" then sent::<Card.Reply>(state, Card.text(fields, "text"), context, mailedReply("send")) else if action == "subscribe" then subscribed::<Card.Reply>(state, {world: context.world, object: Card.text(fields, "to")}, context, mailedReply("subscribe")) else unsubscribed::<Card.Reply>(state, {world: context.world, object: Card.text(fields, "to")}, context, mailedReply("unsubscribe"))
# The handle the card shows is set through a lens: `delvetalk <did> set` and `handle: ...`.
def lenses() -> Lists.List<Form.Lens<Edits>>:
  Lists.List::<Form.Lens<Edits>>.cons({head: Form.Lens::<Edits>.lens({field: "handle", form: Form.Kind.text({min: 1n, max: 64n}), put: fn(v: Form.Value) -> Edits: extend(keep(), {handle: Plans.Edit::<String, {}>.set({value: Card.valueText(v)})})}), tail: Lists.List::<Form.Lens<Edits>>.nil()})
def holdingLine(item: Plans.Reference) -> Document.Document:
  Document.text(textConcat("Holding: ", textConcat(item.object, "\n")))
def noteLine(item: Note) -> Document.Document:
  Document.text(textConcat(Card.handle(item.from), textConcat(": ", textConcat(item.text, "\n"))))
# Notes newest first; eight of each list, then a count.
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.Document.sequence({items: Lists.concat::<Document.Document>(Lists.concat::<Document.Document>(Document.Documents.cons({head: Document.text(textConcat(state.handle, textConcat(" is at ", textConcat(state.at.object, "\n")))), tail: Document.Documents.nil()}), Card.clipped(Lists.map::<Plans.Reference, Document.Document>(state.holding, holdingLine), 8n)), Lists.concat::<Document.Document>(mailFor(state, context), inboxFor(state, context)))})
# Followers are counted for everyone; what it follows is its principal's to see.
def mailFor(state: State, context: Abi.Context) -> Document.Documents:
  Document.Documents.cons({head: Document.text(textConcat(natText(Lists.length::<Card.Observer>(state.observers)), textConcat(" following, follows ", textConcat(natText(Lists.length::<Plans.Reference>(state.following)), "\n")))), tail: if Card.reads(context.object, context) then Card.clipped(Lists.map::<Plans.Reference, Document.Document>(state.following, fn(f: Plans.Reference) -> Document.Document: Document.text(textConcat("Follows: ", textConcat(Card.handle(f.object), "\n")))), 8n) else Document.Documents.nil()})
# The notes are the avatar's principal's alone; anyone else sees how many there are.
def inboxFor(state: State, context: Abi.Context) -> Document.Documents:
  if Card.reads(context.object, context) then Card.clipped(Lists.map::<Note, Document.Document>(Lists.reverse::<Note>(state.inbox), noteLine), 8n) else Document.Documents.cons({head: Document.text(if Lists.length::<Note>(state.inbox) == 1n then "1 note\n" else textConcat(natText(Lists.length::<Note>(state.inbox)), " notes\n")), tail: Document.Documents.nil()})
