edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Spell.obend as Spell
import ./Form.obend as Form
import ./Card.obend as Card
record Term:
  word: String
  meaning: String
record Example:
  utterance: String
  spell: String
# The interpretation policy as an ordinary object: the host sends prompt(...) to
# the configured model and returns the answer as a proposal, never as authority.
record State:
  owner: String
  model: String
  system: String
  lexicon: Lists.List<Term>
  examples: Lists.List<Example>
  escalate: String
# A creator supplies a Seed; seeded makes the child's State from it.
record Seed:
  owner: String
  model: String
  system: String
  escalate: String
record Edits:
  model: Plans.Edit<String, {}>
  escalate: Plans.Edit<String, {}>
  lexicon: Plans.Entries<Term, {}>
  examples: Plans.Entries<Example, {}>
type Plan = Plans.Plan<Edits>
type Response = Plans.Response<State, {}>
def defaultSeed() -> Seed:
  {owner: "", model: "", system: "You turn what a participant says into one spell for the card they are answering. You never act; you only propose.", escalate: ""}
def seeded(seed: Seed) -> State:
  {owner: seed.owner, model: seed.model, system: seed.system, lexicon: Lists.List::<Term>.nil(), examples: Lists.List::<Example>.nil(), escalate: seed.escalate}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {model: Plans.Edit::<String, {}>.keep({}), escalate: Plans.Edit::<String, {}>.keep({}), lexicon: Plans.Entries::<Term, {}>.keep({}), examples: Plans.Entries::<Example, {}>.keep({})}
# Every write of the policy is its owner's: the law says so, and the methods refuse a
# stranger by name before writing. With the host's `request.method` the law becomes
#   owner: request.kind == 0 and request.method == "describe" or request.subject == new.owner
law owner: new.owner == request.subject
sum Taught:
  taught: {count: Nat}
  refused: {reason: String}
# At most this many examples go into every model call.
def exampleCap() -> Nat:
  16n
def edited<T>(state: State, edits: Edits, context: Abi.Context, then: Taught -> T) -> Activity<Plan, Response, T>:
  if context.principal != state.owner then then(Taught.refused({reason: textConcat("Only the policy's owner may teach it; that is ", Card.handle(state.owner))})) else written::<T>(state, edits, context, then)
def written<T>(state: State, edits: Edits, context: Abi.Context, then: Taught -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.write({object: Plans.self(context), edits: edits})):
    case _: then(Taught.taught({count: Lists.length::<Example>(state.examples)}))
def same(taught: Taught) -> Taught:
  taught
def taught<T>(state: State, example: Example, context: Abi.Context, then: Taught -> T) -> Activity<Plan, Response, T>:
  if Lists.length::<Example>(state.examples) < exampleCap() then edited::<T>(state, extend(keep(), {examples: Plans.Entries::<Example, {}>.append({item: example})}), context, then) else then(Taught.refused({reason: "The policy holds sixteen examples, the most a model call carries."}))
def defined<T>(state: State, term: Term, context: Abi.Context, then: Taught -> T) -> Activity<Plan, Response, T>:
  if Lists.length::<Term>(state.lexicon) < exampleCap() then edited::<T>(state, extend(keep(), {lexicon: Plans.Entries::<Term, {}>.append({item: term})}), context, then) else then(Taught.refused({reason: "The lexicon holds sixteen words."}))
# Teach it a phrase and the spell that phrase means.
def teach(state: State, input: {example: Example}, context: Abi.Context) -> Activity<Plan, Response, Taught>:
  taught::<Taught>(state, input.example, context, same)
# Define a word of the lexicon.
def define(state: State, input: {term: Term}, context: Abi.Context) -> Activity<Plan, Response, Taught>:
  defined::<Taught>(state, input.term, context, same)
# Choose the model, and the stronger one to escalate to when it is unsure.
def setModel(state: State, input: {model: String, escalate: String}, context: Abi.Context) -> Activity<Plan, Response, Taught>:
  edited::<Taught>(state, extend(keep(), {model: Plans.Edit::<String, {}>.set({value: input.model}), escalate: Plans.Edit::<String, {}>.set({value: input.escalate})}), context, same)
def forms() -> Card.Forms:
  Card.Forms.cons({head: {card: "", action: "teach", fields: Form.Fields.cons({head: {name: "utterance", kind: Form.Kind.text({min: 1n, max: 280n})}, tail: Form.Fields.cons({head: {name: "spell", kind: Form.Kind.text({min: 1n, max: 280n})}, tail: Form.Fields.nil()})})}, tail: Card.Forms.cons({head: {card: "", action: "define", fields: Form.Fields.cons({head: {name: "word", kind: Form.Kind.text({min: 1n, max: 64n})}, tail: Form.Fields.cons({head: {name: "meaning", kind: Form.Kind.text({min: 1n, max: 280n})}, tail: Form.Fields.nil()})})}, tail: Card.Forms.nil()})})
def door() -> Card.Door:
  {word: "policy", blurb: "How a card understands prose: its examples and words."}
def taughtReply(taught: Taught) -> Card.Reply:
  match taught:
    case taught(_): Card.Reply.done({action: "teach"})
    case refused(r): Card.Reply.refused({reason: r.reason})
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  heard(state, Card.route(input.text, context, forms()), context)
def heard(state: State, routed: Card.Routed, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  match routed:
    case act(a): if a.action == "teach" then taught::<Card.Reply>(state, {utterance: Card.text(a.fields, "utterance"), spell: Card.text(a.fields, "spell")}, context, taughtReply) else defined::<Card.Reply>(state, {word: Card.text(a.fields, "word"), meaning: Card.text(a.fields, "meaning")}, context, taughtReply)
    case _: Card.answer::<Edits, State, {}>(routed, context, forms(), renderFor(state, context))
def kindText(kind: Form.Kind) -> String:
  match kind:
    case text(t): textConcat("text of ", textConcat(natText(t.min), textConcat(" to ", textConcat(natText(t.max), " characters"))))
    case natural(n): textConcat("a natural number from ", textConcat(natText(n.min), textConcat(" to ", natText(n.max))))
    case choice(c): textConcat("one of ", Spell.joined(c.options))
def fieldLine(field: Form.Field) -> String:
  textConcat("  ", textConcat(field.name, textConcat(": ", textConcat(kindText(field.kind), "\n"))))
def formParts(form: Form.Form) -> Lists.List<String>:
  Lists.List::<String>.cons({head: textConcat("delvetalk ", textConcat(form.card, textConcat(" ", textConcat(form.action, "\n")))), tail: Lists.map::<Form.Field, String>(form.fields, fieldLine)})
def termLine(term: Term) -> String:
  textConcat("- ", textConcat(term.word, textConcat(": ", textConcat(term.meaning, "\n"))))
def exampleLine(example: Example) -> String:
  textConcat("Participant: ", textConcat(example.utterance, textConcat("\nSpell:\n", textConcat(example.spell, "\n\n"))))
def many(forms: Lists.List<Form.Form>) -> Lists.List<String>:
  match forms:
    case nil(_): Lists.List::<String>.nil()
    case cons(c): Lists.concat::<String>(formParts(c.head), many(c.tail))
def part(text: String) -> Lists.List<String>:
  Lists.List::<String>.cons({head: text, tail: Lists.List::<String>.nil()})
# The system prompt the host sends: the policy's instruction, the lexicon, the
# examples as pairs, the offered forms in the exact spell grammar, and the answer
# format. Pieces are joined in balanced rounds, so its cost is near linear.
def prompt(state: State, offers: Lists.List<Form.Form>, utterance: String) -> String:
  Document.joinAll(Lists.concat::<String>(Lists.concat::<String>(Lists.concat::<String>(Lists.concat::<String>(Lists.concat::<String>(part(textConcat(state.system, "\n\nLexicon:\n")), Lists.map::<Term, String>(state.lexicon, termLine)), part("\nExamples:\n")), Lists.map::<Example, String>(state.examples, exampleLine)), part("Offered forms (a spell is the delvetalk line, then one field: value line per field):\n\n")), Lists.concat::<String>(many(offers), part(textConcat("\nAnswer with one spell in exactly that grammar, or with unclear: <what is missing>, and nothing else.\n\nParticipant: ", utterance)))))
def exampleCard(example: Example) -> Document.Document:
  Document.text(exampleLine(example))
def stance(state: State) -> String:
  textConcat("I only propose; the card I serve decides whether to ask first.\n", if state.escalate == "" then "" else textConcat("When unsure I escalate to ", textConcat(state.escalate, ".\n")))
def teaching() -> String:
  "\nTo teach me a phrase, reply:\n\n    delvetalk policy teach\n    utterance: a silver fern that remembers\n    spell: delvetalk garden plant, seed: a fern that remembers, colour: silver\n\nTo define a word:\n\n    delvetalk policy define\n    word: moth\n    meaning: a seed\n\nWhat I know:\n"
# The policy as a card, including how to teach it.
# The card as the reader in the context sees it.
def renderFor(state: State, context: Abi.Context) -> Document.Document:
  let head = Document.text(textConcat("✾ INTERPRETATION POLICY\n\nModel: ", textConcat(state.model, textConcat("\n", textConcat(stance(state), if Card.reads(state.owner, context) then teaching() else textConcat("\nOnly its owner, ", textConcat(Card.handle(state.owner), ", teaches it.\n\nWhat I know:\n")))))))
  let terms = Lists.map::<Term, Document.Document>(state.lexicon, fn(term: Term) -> Document.Document: Document.text(termLine(term)))
  let shown = Lists.map::<Example, Document.Document>(state.examples, exampleCard)
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: Lists.concat::<Document.Document>(terms, shown)})})
# The card for the host's `card {object}` until the host passes the reader's context.
def render(state: State) -> Document.Document:
  renderFor(state, Card.stranger())
