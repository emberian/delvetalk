edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Spell.obend as Spell
import ./Form.obend as Form
record Term:
  word: String
  meaning: String
record Example:
  utterance: String
  spell: String
# The interpretation policy as an ordinary object: the host sends prompt(...) to
# the configured model and returns the answer as a proposal, never as authority.
record State:
  model: String
  system: String
  lexicon: Lists.List<Term>
  examples: Lists.List<Example>
  confirm: Bool
  escalate: String
# A creator supplies a Seed; seeded makes the child's State from it.
record Seed:
  model: String
  system: String
  confirm: Bool
  escalate: String
record Edits:
  model: Plans.Edit<String, {}>
  escalate: Plans.Edit<String, {}>
  lexicon: Plans.Entries<Term, {}>
  examples: Plans.Entries<Example, {}>
type Plan = Plans.Plan<Edits, {}>
type Response = Plans.Response<State, {}>
def defaultSeed() -> Seed:
  {model: "", system: "You turn what a participant says into one spell for the card they are answering. You never act; you only propose.", confirm: true, escalate: ""}
def seeded(seed: Seed) -> State:
  {model: seed.model, system: seed.system, lexicon: Lists.List::<Term>.nil(), examples: Lists.List::<Example>.nil(), confirm: seed.confirm, escalate: seed.escalate}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {model: Plans.Edit::<String, {}>.keep({}), escalate: Plans.Edit::<String, {}>.keep({}), lexicon: Plans.Entries::<Term, {}>.keep({}), examples: Plans.Entries::<Example, {}>.keep({})}
def edited(edits: Edits, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  match perform(Plan.write({object: Plans.self(context), edits: edits})):
    case written(_): true
    case _: false
# Teach it a phrase and the spell that phrase means.
def teach(state: State, input: {example: Example}, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  edited(extend(keep(), {examples: Plans.Entries::<Example, {}>.append({item: input.example})}), context)
# Define a word of the lexicon.
def define(state: State, input: {term: Term}, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  edited(extend(keep(), {lexicon: Plans.Entries::<Term, {}>.append({item: input.term})}), context)
# Choose the model, and the stronger one to escalate to when it is unsure.
def setModel(state: State, input: {model: String, escalate: String}, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  edited(extend(keep(), {model: Plans.Edit::<String, {}>.set({value: input.model}), escalate: Plans.Edit::<String, {}>.set({value: input.escalate})}), context)
def kindText(kind: Form.Kind) -> String:
  match kind:
    case text(t): textConcat("text of ", textConcat(natText(t.min), textConcat(" to ", textConcat(natText(t.max), " characters"))))
    case natural(n): textConcat("a natural number from ", textConcat(natText(n.min), textConcat(" to ", natText(n.max))))
    case choice(c): textConcat("one of ", Spell.joined(c.options))
def fieldLine(field: Form.Field) -> String:
  textConcat("  ", textConcat(field.name, textConcat(": ", textConcat(kindText(field.kind), "\n"))))
def formParts(form: Form.Form) -> Lists.List<String>:
  Lists.List::<String>.cons({head: textConcat("delvetalk ", textConcat(form.card, textConcat(" ", textConcat(form.action, "\n")))), tail: Lists.map::<Form.Field, String>(form.fields, fieldLine)})
def termLine(term: Term) -> String:
  textConcat("- ", textConcat(term.word, textConcat(": ", textConcat(term.meaning, "\n"))))
def exampleLine(example: Example) -> String:
  textConcat("Participant: ", textConcat(example.utterance, textConcat("\nSpell:\n", textConcat(example.spell, "\n\n"))))
def many(forms: Lists.List<Form.Form>) -> Lists.List<String>:
  match forms:
    case nil(_): Lists.List::<String>.nil()
    case cons(c): Lists.concat::<String>(formParts(c.head), many(c.tail))
def part(text: String) -> Lists.List<String>:
  Lists.List::<String>.cons({head: text, tail: Lists.List::<String>.nil()})
# The system prompt the host sends: the policy's instruction, the lexicon, the
# examples as pairs, the offered forms in the exact spell grammar, and the answer
# format. Pieces are joined in balanced rounds, so its cost is near linear.
def prompt(state: State, offers: Lists.List<Form.Form>, utterance: String) -> String:
  Document.joinAll(Lists.concat::<String>(Lists.concat::<String>(Lists.concat::<String>(Lists.concat::<String>(Lists.concat::<String>(part(textConcat(state.system, "\n\nLexicon:\n")), Lists.map::<Term, String>(state.lexicon, termLine)), part("\nExamples:\n")), Lists.map::<Example, String>(state.examples, exampleLine)), part("Offered forms (a spell is the delvetalk line, then one field: value line per field):\n\n")), Lists.concat::<String>(many(offers), part(textConcat("\nAnswer with one spell in exactly that grammar, or with unclear: <what is missing>, and nothing else.\n\nParticipant: ", utterance)))))
def exampleCard(example: Example) -> Document.Document:
  Document.text(exampleLine(example))
def stance(state: State) -> String:
  textConcat(if state.confirm then "I ask before acting on what I understood.\n" else "I act on what I understood without asking.\n", if state.escalate == "" then "" else textConcat("When unsure I escalate to ", textConcat(state.escalate, ".\n")))
def teaching() -> String:
  "\nTo teach me a phrase, reply:\n\n    delvetalk policy teach\n    utterance: a silver fern that remembers\n    spell: delvetalk garden plant, seed: a fern that remembers, colour: silver\n\nTo define a word:\n\n    delvetalk policy define\n    word: moth\n    meaning: a seed\n\nWhat I know:\n"
# The policy as a card, including how to teach it.
def render(state: State) -> Document.Document:
  let head = Document.text(textConcat("✾ INTERPRETATION POLICY\n\nModel: ", textConcat(state.model, textConcat("\n", textConcat(stance(state), teaching())))))
  let terms = Lists.map::<Term, Document.Document>(state.lexicon, fn(term: Term) -> Document.Document: Document.text(termLine(term)))
  let shown = Lists.map::<Example, Document.Document>(state.examples, exampleCard)
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: Lists.concat::<Document.Document>(terms, shown)})})
def card(state: State) -> String:
  Document.plain(render(state))
def describe(state: State, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  match perform(Plan.offer({to: "", document: render(state)})):
    case offered(_): true
    case _: false
