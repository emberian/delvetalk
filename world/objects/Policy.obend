edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Form.obend as Form
import ./World.obend as World
import ./Card.obend as Card
import ./Policies.obend as Policies
import ./Text.obend as Text
type Term = Policies.Term
type Example = Policies.Example
type Macro = Policies.Macro
# The interpretation policy as an ordinary object: the host sends prompt(...) to
# the configured model and returns the answer as a proposal, never as authority. Its
# State is Policies.State, so a card may import the type and view it.
type State = Policies.State
# What waits for a yes by default: changing an object's program or law, giving custody away,
# a countersignature and an adoption. Planting, raining, subscribing and submitting run at once.
def asking() -> Lists.List<String>:
  Text.words("reprogram amend offer countersign adopt")
# hob's instruction (docs/FLEX.md §2), the policy's `system` unless its owner sets another.
def hob() -> String:
  "hob reads for a town of cards. A participant answered the card below in words. Give the spell they meant, so the card can run it; the card and its law decide what is admitted, never you."
def initial() -> State:
  {owner: "", model: "", system: hob(), lexicon: Lists.List.nil(), examples: Lists.List.nil(), macros: Lists.List.nil({}), confirmFor: asking()}
# Every write of the policy is its owner's: the law says so, and the methods refuse a
# stranger by name before writing.
law owner "the owner never changes, and only the owner teaches it": unchanged(owner) and request.subject == new.owner
sum Taught:
  taught: {count: Nat}
  refused: Card.Refusal
# Why the policy refuses: each arm a clause and its reading.
sum Why:
  notOwner: {owner: String}
  examplesFull: {}
  lexiconFull: {}
  macrosFull: {}
  macroHole: {}
  macroTooLong: {}
def refusal(w: Why) -> Card.Refusal:
  match w:
    case notOwner(n): {clause: "notOwner", reading: "Only the policy's owner may teach it; that is {n.owner}"}
    case examplesFull(_): {clause: "examplesFull", reading: "The policy holds sixteen examples, the most a model call carries."}
    case lexiconFull(_): {clause: "lexiconFull", reading: "The lexicon holds sixteen words."}
    case macrosFull(_): {clause: "macrosFull", reading: "The policy holds sixteen macros."}
    case macroHole(_): {clause: "macroHole", reading: "A macro's pattern starts with a word, not a hole."}
    case macroTooLong(_): {clause: "macroTooLong", reading: "A macro's name takes 64 characters, its pattern 280 and its expansion 560."}
# A refusal is answered by name (Card.refusing) and writes nothing.
def refused(w: Why, context: Abi.Context) -> Activity<Taught>:
  Card.refusing(Taught.refused(refusal(w)), refusal(w), context)
# At most this many examples go into every model call.
def exampleCap() -> Nat:
  16n
# Every write is the owner's (refused by name first).
def edited(edits: Edits, context: Abi.Context, state: State) -> Activity<Taught>:
  if context.principal != state.owner then refused(Why.notOwner({owner: Card.name(state.owner, context)}), context) else written(edits, state)
def written(edits: Edits, state: State) -> Activity<Taught>:
  let written(_) = world.write(edits)
  Taught.taught({count: Lists.length(state.examples)})
# Teach it a phrase and the spell that phrase means.
def teach(state: State, input: {utterance: String, spell: String}, context: Abi.Context) -> Activity<Taught>:
  if Lists.length(state.examples) < exampleCap() then edited(extend(keep(), {examples: Plans.Entries.append({item: {utterance: input.utterance, spell: input.spell}})}), context, state) else refused(Why.examplesFull({}), context)
# Define a word of the lexicon.
def define(state: State, input: {word: String, meaning: String}, context: Abi.Context) -> Activity<Taught>:
  if Lists.length(state.lexicon) < exampleCap() then edited(extend(keep(), {lexicon: Plans.Entries.append({item: {word: input.word, meaning: input.meaning}})}), context, state) else refused(Why.lexiconFull({}), context)
# `delvetalk policy confirm / action: plant / ask: yes` makes an interpreted plant wait for
# the speaker's yes; `ask: no` lets it run at once.
sum Ask:
  yes: {}
  no: {}
def confirm(state: State, input: {action: String, ask: Ask}, context: Abi.Context) -> Activity<Taught>:
  edited(extend(keep(), {confirmFor: asked(input.action, asks(input.ask), state)}), context, state)
def asks(ask: Ask) -> Bool:
  match ask:
    case yes(_): true
    case no(_): false
def asked(action: String, ask: Bool, state: State) -> Plans.Entries<String, String>:
  if ask == Lists.any(state.confirmFor, fn(a: String) -> Bool: a == action) then Plans.Entries.keep({}) else if ask then Plans.Entries.append({item: action}) else Plans.Entries.removeItem({item: action})
# Teach a macro: its name, a pattern of words and `{holes}`, and the spell it expands to, one
# field line (`expansion: garden plant / colour: violet / seed: a bell for {who}`: a field line
# keeps its slashes). A macro of the same name is replaced; the pattern must start with a
# literal word (a pattern of holes alone would take all prose).
def macro(state: State, input: {name: String, pattern: String, expansion: String}, context: Abi.Context) -> Activity<Taught>:
  if textTake(Text.trimStart(input.pattern), 1n) == "{{" then refused(Why.macroHole({}), context) else if textLength(input.expansion) > 560n || textLength(input.pattern) > 280n || textLength(input.name) > 64n then refused(Why.macroTooLong({}), context) else macroPlaced(input, Lists.find(state.macros, fn(m: Macro) -> Bool: m.name == input.name), context, state)
def macroPlaced(macro: Macro, found: Lists.Maybe<Macro>, context: Abi.Context, state: State) -> Activity<Taught>:
  match found:
    case some(f): edited(extend(keep(), {macros: Plans.Entries.amendItem({item: f.value, change: macro})}), context, state)
    case none(_): if Lists.length(state.macros) < exampleCap() then edited(extend(keep(), {macros: Plans.Entries.append({item: macro})}), context, state) else refused(Why.macrosFull({}), context)
form teach:
  utterance: text 1..280
  spell: text 1..280
form define:
  word: text 1..64
  meaning: text 1..280
form macro:
  name: text 1..64
  pattern: text 1..280
  expansion: text 1..560
form confirm:
  action: text 1..64
  ask: yes | no
# The model and the system instruction are set through lenses: `delvetalk <policy> set` and `model: ...`.
def lenses() -> Lists.List<Form.Field>:
  Lists.append(Lists.append(Lists.List.nil(), {name: "model", kind: Form.Kind.text({min: 1n, max: 64n})}), {name: "system", kind: Form.Kind.text({min: 1n, max: 1000n})})
def set(state: State, input: {field: String, value: Form.Value}, context: Abi.Context) -> Activity<Card.Replied>:
  if context.principal != state.owner then Card.refusing(Card.Replied.refused(refusal(Why.notOwner({owner: Card.name(state.owner, context)}))), refusal(Why.notOwner({owner: Card.name(state.owner, context)})), context) else setting(input.field, Card.valueText(input.value))
# The host judged the value against the lens's kind; an unlensed field never reaches here.
def lensEdits(field: String, value: String) -> Edits:
  if field == "model" then extend(keep(), {model: Plans.Edit.set({value: value})}) else extend(keep(), {system: Plans.Edit.set({value: value})})
def setting(field: String, value: String) -> Activity<Card.Replied>:
  let written(_) = world.write(lensEdits(field, value))
  Card.tell(Card.Replied.done({action: "set"}), Document.text("Set {field} to {value}.\n"))
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
# A source's bound is the host's `Bounds.maxPackageBytes` (131,072 bytes), as a literal: Bend cannot read it.
def kindText(kind: Form.Kind) -> String:
  match kind:
    case text(t): "text of {natText(t.min)} to {natText(t.max)} characters"
    case natural(n): "a natural number from {natText(n.min)} to {natText(n.max)}"
    case choice(c): "one of {Text.joined(c.options)}"
    case source(_): "Bend source of 1 to 131072 characters, as a <<BEND block or the reply's ```obend block"
def fieldLine(field: Form.Field) -> String:
  "  {field.name}: {kindText(field.kind)}\n"
def formParts(form: Form.Form) -> Lists.List<String>:
  Lists.List.cons({head: "delvetalk {form.card} {form.action}\n", tail: Lists.map(form.fields, fieldLine)})
def termLine(term: Term) -> String:
  "- {term.word}: {term.meaning}\n"
def exampleLine(example: Example) -> String:
  "Said: {example.utterance}\n{example.spell}\n\n"
def many(forms: Lists.List<Form.Form>) -> Lists.List<String>:
  match forms:
    case nil(_): Lists.List.nil()
    case cons(c): Lists.concat(formParts(c.head), many(c.tail))
def part(text: String) -> Lists.List<String>:
  Lists.List.cons({head: text, tail: Lists.List.nil()})
def heldPart(held: String) -> String:
  if held == "" then "" else "Held for this participant: {held}\n"
def misfitPart(misfit: String) -> String:
  if misfit == "" then "" else "Misfit: {misfit}\n"
def examplesPart(state: State) -> Lists.List<String>:
  if Lists.length(state.examples) == 0n then Lists.List.nil() else Lists.concat(part("\nSaid, and the answer:\n"), Lists.map(state.examples, exampleLine))
def answers() -> String:
  "\nAnswer with exactly one of these, and nothing else:\n- the spell, up to three one after another; every value from their words, never invented, a choice never widened;\n- ask: <one short question> when a value is missing or does not fit: name the field and what it takes; no thanks, sorry or please;\n- card when they ask something the card already shows (a count, a rule, who is here);\n- say: <answer> for a question about what a card is or does: at most two sentences, from the card, its forms and the pages given;\n- none when the words ask nothing of this card: talk among participants, a report, a note.\n"
# The system prompt the host sends with the utterance as the user turn (docs/FLEX.md §2): hob's
# instruction, the card as the speaker reads it, its forms in the spell grammar, the lexicon,
# what the card holds for the speaker and the misfit, the examples, and the five answers; or, for
# words asked for Bend, the drafting prompt. Pieces are joined in balanced rounds, so its cost is
# near linear.
def prompt(state: State, asked: {utterance: String, offers: Lists.List<Form.Form>, card: String, held: String, misfit: String}) -> String:
  if drafting(asked.offers) then draftPrompt() else cardPrompt(state, asked)
def cardPrompt(state: State, asked: {utterance: String, offers: Lists.List<Form.Form>, card: String, held: String, misfit: String}) -> String:
  let head = part("{state.system}\n\nThe card they answered:\n{asked.card}\n\nWhat it takes (a spell is the delvetalk line, then one `field: value` line per field, in any order):\n")
  let words = if Lists.length(state.lexicon) == 0n then Lists.List::<String>.nil() else Lists.concat(part("\nWords:\n"), Lists.map(state.lexicon, termLine))
  let tail = if asked.held == "" && asked.misfit == "" then Lists.List::<String>.nil() else part("\n{heldPart(asked.held)}{misfitPart(asked.misfit)}")
  Document.joinAll(Lists.concat(Lists.concat(Lists.concat(Lists.concat(head, many(asked.offers)), words), Lists.concat(tail, examplesPart(state))), part(answers())))
# Words asked for Bend (the workshop's `make`): one form offered, and it takes source. The
# answer is the package alone, so the prompt holds no card and no spell, only what a package is.
def drafting(offers: Lists.List<Form.Form>) -> Bool:
  match offers:
    case cons(c): Lists.length(c.tail) == 0n && Lists.any(c.head.fields, fn(f: Form.Field) -> Bool: isSource(f.kind))
    case nil(_): false
def isSource(kind: Form.Kind) -> Bool:
  match kind:
    case source(_): true
    case _: false
def draftPrompt() -> String:
  "hob drafts Bend for a town of cards. The words below describe one card; write its package: a State, initial(), a form and a method for each thing it does, and render. Keep it as small as the words allow; the workshop checks it and its describer adopts it.\n\nA whole package, a jar anyone drops a coin in:\n\n```obend\n{jar()}```\n\nAnswer with one ```obend block holding the package, and nothing else.\n"
# The library's `object` page's package (capsules/pages/object.txt; tests/test_policy.py holds them equal).
def jar() -> String:
  "edition ObjectiveBend 1\nimport ./Abi.obend as Abi\nimport ./List.obend as Lists\nimport ./Document.obend as Document\nimport ./Relation.obend as Relations\nimport ./Text.obend as Text\nrecord Coin:\n  n: Nat\n  who: String\n  line: String\nrecord State:\n  owner: String\n  coins: Relations.Relation<Coin>\ndef initial() -> State:\n  {{owner: \"\", coins: Relations.empty()}}\ndef relations() -> Relations.Decls:\n  Lists.append(Relations.Decls.nil(), {{field: \"coins\", key: Text.words(\"n who\"), limit: 64n}})\nlaw owner \"anyone drops; the owner reprograms\": request.kind == 0 or request.subject == new.owner\nform drop:\n  line: text 1..140\ndef drop(state: State, input: {{line: String}}, context: Abi.Context) -> Activity<Nat>:\n  let written(_) = write {{coins: insert {{n: Relations.count(state.coins), who: context.principal, line: input.line}}}}\n  Relations.count(state.coins) + 1n\ndef render(state: State, context: Abi.Context) -> Document.Document:\n  Document.text(\"{{natText(Relations.count(state.coins))}} coins\\n\")\n"
def exampleCard(example: Example) -> Document.Document:
  Document.text(exampleLine(example))
def stance(state: State) -> String:
  let first = if Lists.length(state.confirmFor) == 0n then "nothing" else Text.joined(state.confirmFor)
  "I only propose. A card asks the speaker first before: {first}.\n"
def teaching() -> String:
  "\nTo teach me a phrase, reply:\n\n    delvetalk policy teach\n    utterance: a silver fern that remembers\n    spell: delvetalk garden plant seed: a fern that remembers, colour: silver\n\nTo define a word:\n\n    delvetalk policy define\n    word: moth\n    meaning: a seed\n\nTo teach a shortcut no model is asked about:\n\n    delvetalk policy macro\n    name: moth-bell\n    pattern: moth for {{who}}\n    expansion: garden plant / colour: violet / seed: a bell for {{who}}\n\nWhat I know:\n"
# The policy as a card, including how to teach it; its words, examples and macros take what the
# head leaves of Card.limit(context), one budget across the card as every card keeps.
def render(state: State, context: Abi.Context) -> Document.Document:
  let how = if Card.reads(state.owner, context) then teaching() else "\nOnly its owner, {Card.name(state.owner, context)}, teaches it.\n\nWhat I know:\n"
  let head = Document.text("✾ INTERPRETATION POLICY\n\nModel: {state.model}\n{stance(state)}{how}")
  let terms = Lists.map(state.lexicon, fn(term: Term) -> Document.Document: Document.text(termLine(term)))
  let shown = Lists.map(state.examples, exampleCard)
  let macros = Lists.map(state.macros, fn(m: Macro) -> Document.Document: Document.text("Macro {m.name}: {m.pattern}\n  means: delvetalk {m.expansion}\n"))
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: Card.clippedWithin(Lists.concat(Lists.concat(terms, shown), macros), 48n, Card.left(context, Document.size(head)))})})
