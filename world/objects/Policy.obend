edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Spell.obend as Spell
import ./Form.obend as Form
import ./Card.obend as Card
import ./Policies.obend as Policies
type Term = Policies.Term
type Example = Policies.Example
type Macro = Policies.Macro
# The interpretation policy as an ordinary object: the host sends prompt(...) to
# the configured model and returns the answer as a proposal, never as authority. Its
# State is Policies.State, so a card may import the type and view it.
type State = Policies.State
# A creator supplies a Seed; seeded makes the child's State from it.
record Seed:
  owner: String
  model: String
  system: String
  escalate: String
  escalateTo: String
  confirmFor: Lists.List<String>
record Edits:
  model: Plans.Edit<String, {}>
  escalate: Plans.Edit<String, {}>
  escalateTo: Plans.Edit<String, {}>
  system: Plans.Edit<String, {}>
  lexicon: Plans.Entries<Term, {}>
  examples: Plans.Entries<Example, {}>
  macros: Plans.Entries<Macro, Macro>
  confirmFor: Plans.Entries<String, {}>
type Plan = Plans.Plan<Edits>
type Response = Plans.Response<State, {}>
def defaultSeed() -> Seed:
  {owner: "", model: "", system: "You turn what a participant says into one spell for the card they are answering. You never act; you only propose.", escalate: "", escalateTo: "", confirmFor: asking()}
# What waits for a yes by default: changing an object's program or law, and giving
# offering custody away. Planting, raining, subscribing and submitting run at once.
def asking() -> Lists.List<String>:
  Lists.List.cons({head: "reprogram", tail: Lists.List.cons({head: "amend", tail: Lists.List.cons({head: "offer", tail: Lists.List.nil({})})})})
def seeded(seed: Seed) -> State:
  {owner: seed.owner, model: seed.model, system: seed.system, lexicon: Lists.List.nil(), examples: Lists.List.nil(), escalate: seed.escalate, escalateTo: seed.escalateTo, macros: Lists.List.nil({}), confirmFor: seed.confirmFor}
def initial() -> State:
  seeded(defaultSeed())
def keep() -> Edits:
  {model: Plans.Edit.keep({}), escalate: Plans.Edit.keep({}), escalateTo: Plans.Edit.keep({}), system: Plans.Edit.keep({}), lexicon: Plans.Entries.keep({}), examples: Plans.Entries.keep({}), macros: Plans.Entries.keep({}), confirmFor: Plans.Entries.keep({})}
# Every write of the policy is its owner's: the law says so, and the methods refuse a
# stranger by name before writing. `describe` is the one method open to everyone: it
# writes nothing today, and a describe that ever wrote would be the package's to answer.
law owner "only the owner teaches it; anyone may describe": (request.kind == 0 and request.method == "describe") or request.subject == new.owner
sum Taught:
  taught: {count: Nat}
  refused: Card.Refusal
# Why the policy refuses: each arm a clause, `why` its reading.
sum Why:
  notOwner: {owner: String}
  examplesFull: {}
  lexiconFull: {}
  macrosFull: {}
  macroIncomplete: {}
  macroHole: {}
  macroTooLong: {}
def why(w: Why) -> String:
  match w:
    case notOwner(n): "Only the policy's owner may teach it; that is {n.owner}"
    case examplesFull(_): "The policy holds sixteen examples, the most a model call carries."
    case lexiconFull(_): "The lexicon holds sixteen words."
    case macrosFull(_): "The policy holds sixteen macros."
    case macroIncomplete(_): "A macro needs a name, a pattern and an expansion."
    case macroHole(_): "A macro's pattern starts with a word, not a hole."
    case macroTooLong(_): "A macro's name takes 64 characters, its pattern 280 and its expansion 560."
def clause(w: Why) -> String:
  match w:
    case notOwner(_): "notOwner"
    case examplesFull(_): "examplesFull"
    case lexiconFull(_): "lexiconFull"
    case macrosFull(_): "macrosFull"
    case macroIncomplete(_): "macroIncomplete"
    case macroHole(_): "macroHole"
    case macroTooLong(_): "macroTooLong"
def refusal(w: Why) -> Card.Refusal:
  {clause: clause(w), reading: why(w)}
# At most this many examples go into every model call.
def exampleCap() -> Nat:
  16n
def edited<T>(state: State, edits: Edits, context: Abi.Context, then: Taught -> T) -> Activity<Plan, Response, T>:
  if context.principal != state.owner then then(Taught.refused(refusal(Why.notOwner({owner: Card.name(state.owner, context)})))) else written(state, edits, context, then)
def written<T>(state: State, edits: Edits, context: Abi.Context, then: Taught -> T) -> Activity<Plan, Response, T>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: edits}))
  then(Taught.taught({count: Lists.length(state.examples)}))
def same(taught: Taught) -> Taught:
  taught
def taught<T>(state: State, example: Example, context: Abi.Context, then: Taught -> T) -> Activity<Plan, Response, T>:
  if Lists.length(state.examples) < exampleCap() then edited(state, extend(keep(), {examples: Plans.Entries.append({item: example})}), context, then) else then(Taught.refused(refusal(Why.examplesFull({}))))
def defined<T>(state: State, term: Term, context: Abi.Context, then: Taught -> T) -> Activity<Plan, Response, T>:
  if Lists.length(state.lexicon) < exampleCap() then edited(state, extend(keep(), {lexicon: Plans.Entries.append({item: term})}), context, then) else then(Taught.refused(refusal(Why.lexiconFull({}))))
# Teach it a phrase and the spell that phrase means.
def teach(state: State, input: {example: Example}, context: Abi.Context) -> Activity<Plan, Response, Taught>:
  taught(state, input.example, context, same)
# Define a word of the lexicon.
def define(state: State, input: {term: Term}, context: Abi.Context) -> Activity<Plan, Response, Taught>:
  defined(state, input.term, context, same)
# The model, the stronger one a second attempt names ("" for the same), the principal a
# card tells what it could not fit after two attempts (`escalate-to`, a DID, "" for nobody) and the
# system instruction are set through lenses: `delvetalk <policy> set` and `model: ...`.
def lenses() -> Lists.List<Form.Lens<Edits>>:
  Lists.List.cons({head: Form.Lens.lens({field: "model", form: Form.Kind.text({min: 1n, max: 64n}), put: fn(v: Form.Value) -> Edits: extend(keep(), {model: Plans.Edit.set({value: Card.valueText(v)})})}), tail: Lists.List.cons({head: Form.Lens.lens({field: "escalate", form: Form.Kind.text({min: 0n, max: 64n}), put: fn(v: Form.Value) -> Edits: extend(keep(), {escalate: Plans.Edit.set({value: Card.valueText(v)})})}), tail: Lists.List.cons({head: Form.Lens.lens({field: "escalate-to", form: Form.Kind.text({min: 0n, max: 160n}), put: fn(v: Form.Value) -> Edits: extend(keep(), {escalateTo: Plans.Edit.set({value: Card.valueText(v)})})}), tail: Lists.List.cons({head: Form.Lens.lens({field: "system", form: Form.Kind.text({min: 1n, max: 1000n}), put: fn(v: Form.Value) -> Edits: extend(keep(), {system: Plans.Edit.set({value: Card.valueText(v)})})}), tail: Lists.List.nil()})})})})
# Who may set a lens: the owner; anyone else is refused by name before the law is asked.
def guard(state: State, context: Abi.Context) -> String:
  if context.principal == state.owner then "" else "Only the policy's owner may teach it; that is {Card.name(state.owner, context)}"
form teach:
  utterance: text 1..280
  spell: text 1..280
form define:
  word: text 1..64
  meaning: text 1..280
form confirm:
  action: text 1..64
  ask: yes | no
def forms() -> Card.Forms:
  Card.Forms.cons({head: teachForm(), tail: Card.Forms.cons({head: defineForm(), tail: Card.Forms.cons({head: macroForm(), tail: Card.Forms.cons({head: confirmForm(), tail: Card.Forms.nil()})})})})
# `delvetalk policy confirm / action: plant / ask: yes` makes an interpreted plant wait for
# the speaker's yes; `ask: no` lets it run at once. The owner's, as all teaching.
def confirming(state: State, action: String, ask: Bool, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  edited(state, extend(keep(), {confirmFor: asked(state, action, ask)}), context, fn(t: Taught) -> Card.Reply: confirmReply(t))
def asked(state: State, action: String, ask: Bool) -> Plans.Entries<String, {}>:
  if ask == Lists.any(state.confirmFor, fn(a: String) -> Bool: a == action) then Plans.Entries.keep({}) else if ask then Plans.Entries.append({item: action}) else Plans.Entries.removeItem({item: action})
def confirmReply(taught: Taught) -> Card.Reply:
  match taught:
    case taught(_): Card.Reply.done({action: "confirm"})
    case refused(r): Card.Reply.refused(r)
# The macro form, for the usage card: the spell's fields after these three (` / colour:
# violet / seed: a bell for {who}`) belong to the expansion, so receive reads it before route.
form macro as macroForm:
  name: text 1..64
  pattern: text 1..280
  expansion: text 1..280
def door() -> Card.Door:
  {word: "policy", blurb: "How a card understands prose: its examples and words."}
def taughtReply(taught: Taught) -> Card.Reply:
  match taught:
    case taught(_): Card.Reply.done({action: "teach"})
    case refused(r): Card.Reply.refused(r)
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  match Spell.parse(input.text):
    case spell(s): if s.action == "macro" && Card.names(s.card, context) then macroTaught(state, s.fields, context) else heard(state, Card.routeHeard(input, context, forms()), context)
    case notASpell(_): heard(state, Card.routeHeard(input, context, forms()), context)
# Teach a macro: `delvetalk policy macro / name: moth-bell / pattern: moth for {who} /
# expansion: garden plant / colour: violet / seed: a bell for {who}`. Every field after the
# expansion line joins it as ` / field: value`. A macro of the same name is replaced; the
# pattern must start with a literal word (a pattern of holes alone would take all prose).
def macroTaught(state: State, fields: Spell.Bindings, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  if Spell.valueOf(fields, "expansion") == "" then macroRefused(state, Why.macroIncomplete({}), context) else macroWith(state, {name: Spell.valueOf(fields, "name"), pattern: Spell.valueOf(fields, "pattern"), expansion: expansionOf(fields)}, context)
def expansionOf(fields: Spell.Bindings) -> String:
  textJoin(Lists.List.cons({head: Spell.valueOf(fields, "expansion"), tail: Lists.map(Lists.filter(fields, fn(b: Spell.Binding) -> Bool: b.name != "name" && b.name != "pattern" && b.name != "expansion"), fn(b: Spell.Binding) -> String: "{b.name}: {b.value}")}), " / ")
def macroWith(state: State, macro: Macro, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  if macro.name == "" || macro.pattern == "" then macroRefused(state, Why.macroIncomplete({}), context) else if textTake(Spell.trimStart(macro.pattern), 1n) == "{{" then macroRefused(state, Why.macroHole({}), context) else if textLength(macro.expansion) > 560n || textLength(macro.pattern) > 280n || textLength(macro.name) > 64n then macroRefused(state, Why.macroTooLong({}), context) else macroPlaced(state, macro, Lists.find(state.macros, fn(m: Macro) -> Bool: m.name == macro.name), context)
def macroPlaced(state: State, macro: Macro, found: Lists.Maybe<Macro>, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  match found:
    case some(f): edited(state, extend(keep(), {macros: Plans.Entries.amendItem({item: f.value, change: macro})}), context, macroReply)
    case none(_): if Lists.length(state.macros) < exampleCap() then edited(state, extend(keep(), {macros: Plans.Entries.append({item: macro})}), context, macroReply) else macroRefused(state, Why.macrosFull({}), context)
def macroReply(taught: Taught) -> Card.Reply:
  match taught:
    case taught(_): Card.Reply.done({action: "macro"})
    case refused(r): Card.Reply.refused(r)
def macroRefused(state: State, w: Why, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  Card.answer(Card.Routed.refused(refusal(w)), context, forms(), render(state, context))
def heard(state: State, routed: Card.Routed, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  match routed:
    case act(a): if a.action == "confirm" then confirming(state, Card.text(a.fields, "action"), Card.text(a.fields, "ask") == "yes", context) else if a.action == "teach" then taught(state, {utterance: Card.text(a.fields, "utterance"), spell: Card.text(a.fields, "spell")}, context, taughtReply) else defined(state, {word: Card.text(a.fields, "word"), meaning: Card.text(a.fields, "meaning")}, context, taughtReply)
    case _: Card.answerLensed(routed, context, forms(), lenses(), guard(state, context), render(state, context))
def kindText(kind: Form.Kind) -> String:
  match kind:
    case text(t): "text of {natText(t.min)} to {natText(t.max)} characters"
    case natural(n): "a natural number from {natText(n.min)} to {natText(n.max)}"
    case choice(c): "one of {Spell.joined(c.options)}"
def fieldLine(field: Form.Field) -> String:
  "  {field.name}: {kindText(field.kind)}\n"
def formParts(form: Form.Form) -> Lists.List<String>:
  Lists.List.cons({head: "delvetalk {form.card} {form.action}\n", tail: Lists.map(form.fields, fieldLine)})
def termLine(term: Term) -> String:
  "- {term.word}: {term.meaning}\n"
def exampleLine(example: Example) -> String:
  "Participant: {example.utterance}\nSpell:\n{example.spell}\n\n"
def many(forms: Lists.List<Form.Form>) -> Lists.List<String>:
  match forms:
    case nil(_): Lists.List.nil()
    case cons(c): Lists.concat(formParts(c.head), many(c.tail))
def part(text: String) -> Lists.List<String>:
  Lists.List.cons({head: text, tail: Lists.List.nil()})
# The system prompt the host sends: the policy's instruction, the lexicon, the
# examples as pairs, the offered forms in the exact spell grammar, and the answer
# format. Pieces are joined in balanced rounds, so its cost is near linear.
def prompt(state: State, offers: Lists.List<Form.Form>, utterance: String) -> String:
  Document.joinAll(Lists.concat(Lists.concat(Lists.concat(Lists.concat(Lists.concat(part("{state.system}\n\nLexicon:\n"), Lists.map(state.lexicon, termLine)), part("\nExamples:\n")), Lists.map(state.examples, exampleLine)), part("Offered forms (a spell is the delvetalk line, then one field: value line per field):\n\n")), Lists.concat(many(offers), part("\nAnswer with one spell in exactly that grammar, or with unclear: <what is missing>, and nothing else.\n\nParticipant: {utterance}"))))
def exampleCard(example: Example) -> Document.Document:
  Document.text(exampleLine(example))
def stance(state: State, context: Abi.Context) -> String:
  let escalation = if state.escalate == "" then "" else "When unsure I escalate to {state.escalate}.\n"
  let told = if state.escalateTo == "" then "" else "What a card cannot fit twice goes to {Card.name(state.escalateTo, context)}.\n"
  let first = if Lists.length(state.confirmFor) == 0n then "nothing" else Spell.joined(state.confirmFor)
  "I only propose. A card asks the speaker first before: {first}.\n{escalation}{told}"
def teaching() -> String:
  "\nTo teach me a phrase, reply:\n\n    delvetalk policy teach\n    utterance: a silver fern that remembers\n    spell: delvetalk garden plant seed: a fern that remembers, colour: silver\n\nTo define a word:\n\n    delvetalk policy define\n    word: moth\n    meaning: a seed\n\nTo teach a shortcut no model is asked about:\n\n    delvetalk policy macro\n    name: moth-bell\n    pattern: moth for {{who}}\n    expansion: garden plant\n    colour: violet\n    seed: a bell for {{who}}\n\nWhat I know:\n"
# The policy as a card, including how to teach it.
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  let how = if Card.reads(state.owner, context) then teaching() else "\nOnly its owner, {Card.name(state.owner, context)}, teaches it.\n\nWhat I know:\n"
  let head = Document.text("✾ INTERPRETATION POLICY\n\nModel: {state.model}\n{stance(state, context)}{how}")
  let terms = Lists.map(state.lexicon, fn(term: Term) -> Document.Document: Document.text(termLine(term)))
  let shown = Lists.map(state.examples, exampleCard)
  let macros = Lists.map(state.macros, fn(m: Macro) -> Document.Document: Document.text("Macro {m.name}: {m.pattern}\n  means: delvetalk {m.expansion}\n"))
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: Lists.concat(Lists.concat(terms, shown), macros)})})
