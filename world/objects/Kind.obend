edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Relation.obend as Relations
import ./Rows.obend as Rows
import ./Text.obend as Text
import ./Record.obend as Record
import ./Scenes.obend as Scenes
import ./Spween.obend as Spween
import ./Forms.obend as Forms
# KIND (docs/CATALOGUE.md §3): a thing whose instances are things. It holds the form its `make`
# takes (field lines, `colour: amber | violet | silver` / `seed: text 1..80`), the law its
# instances are created under (each cites it: `under "<kind>"`), the card head they start with
# (`{field}` and `{maker}` holes),
# the package they run (`of`: record or kind) and a body: a layer over that package, as source,
# grafted on each instance as it is made ("" for none). `make` is create, then extend.
#
# A kind's `make` is its own: a layer generated from its form (laid as `kinds` makes it, or by its
# owner's `shape` for a kind created whole), whose `make` takes exactly those fields and hands them
# to `making` as rows, the thing named by the kind; and, for a kind of things, whose `place` takes
# them and an exact `id`, the kind owner's alone and offered to them alone (the hand's own things,
# `garden`, `porch`). So the host reads a make spell's fields and bounds as it reads any form's,
# and `?` on a kind prints its own make.
# `kinds` is the kind of kinds (`of: kind`): its make makes a kind, and shapes it.
#
# The package declares no law, as every made package: its creator passes it (`lawText`).
record Made:
  object: String
  n: Nat
record State:
  owner: String
  ownerHandle: String
  name: fixed String
  of: fixed String
  form: String
  law: String
  head: String
  voice: String
  body: String
  made: Relations.Relation<Made>
  count: Nat
def initial() -> State:
  {owner: "", ownerHandle: "", name: "", of: "record", form: "", law: "", head: "", voice: "", body: "", made: Relations.empty(), count: 0n}
# A kind as editions 8 and 9 kept it, before `voice`: a carry gives it none ("": its instances are
# painted in no register but the contract's).
record State8:
  owner: String
  ownerHandle: String
  name: String
  of: String
  form: String
  law: String
  head: String
  body: String
  made: Relations.Relation<Made>
  count: Nat
def migrate(old: State8) -> State:
  {owner: old.owner, ownerHandle: old.ownerHandle, name: old.name, of: old.of, form: old.form, law: old.law, head: old.head, voice: "", body: old.body, made: old.made, count: old.count}
def relations() -> Relations.Decls:
  Lists.append(Relations.Decls.nil(), {field: "made", key: Text.words("object"), limit: 1024n})
def madeKey(m: Made) -> {object: String}:
  {object: m.object}
# A kind's own law: the owner stays and alone changes what the kind makes; anyone makes.
def lawText() -> String:
  "law owner \"the owner stays; only the owner changes the form, the law, the head, the voice or the body; anyone makes, and places rules, wants and verbs on it\": unchanged(owner) and (request.subject == new.owner or ((request.kind == 0 or request.kind == rule) and unchanged(form) and unchanged(law) and unchanged(head) and unchanged(voice) and unchanged(body)))"
sum Done:
  made: {object: String}
  refused: Card.Refusal
# The package a kind's instances run, by `of`: a kind, or a record (a bell, a room, a garden are
# records with bodies).
def packageOf(of: String) -> String:
  if of == "kind" then "Kind" else if of == "record" then "Record" else ""
def valueOf(fields: Lists.List<Rows.Field>, name: String) -> String:
  match Lists.find(fields, fn(f: Rows.Field) -> Bool: f.name == name):
    case some(f): f.value.value
    case none(_): ""
def captures(fields: Lists.List<Rows.Field>, context: Abi.Context) -> Card.Captures:
  Card.Captures.cons({head: {hole: "maker", text: Card.name(context.principal, context)}, tail: Lists.map(fields, fn(f: Rows.Field) -> Card.Capture: {hole: f.name, text: f.value})})
# What a make spell's fields seed: the instance's head, kind, fields and maker, laid over its
# package's initial(); a kind made by `kinds` takes its own fields from the form. An instance
# made under a record cites it home, labelled by its last segment. A `spween` field (a room's,
# handed by the room a block was posted to) is the instance's scene: its passages, start,
# cooldown and requirements, and not kept among the fields. A thing is made tended: at the clock and the
# entry of its making.
def seedOf(state: State, fields: Lists.List<Rows.Field>, under: String, context: Abi.Context) -> Data:
  if state.of == "kind" then kindSeed(fields, context) else instanceSeed(state, fields, under, context)
def instanceSeed(state: State, fields: Lists.List<Rows.Field>, under: String, context: Abi.Context) -> Data:
  sceneSeed(state, Lists.filter(fields, fn(f: Rows.Field) -> Bool: f.name != "spween" && f.name != "id"), under, context, Spween.parse(valueOf(fields, "spween")))
def sceneSeed(state: State, kept: Lists.List<Rows.Field>, under: String, context: Abi.Context, scene: Spween.Parsed) -> Data:
  match scene:
    case parsed(p): withScene(state, kept, under, context, p.seed)
    case refused(_): plainSeed(state, kept, under, context)
def plainSeed(state: State, kept: Lists.List<Rows.Field>, under: String, context: Abi.Context) -> Data:
  {owner: context.principal, head: Card.filled(state.head, captures(kept, context)), kind: context.object, fields: kept, maker: context.principal, makerHandle: context.handle, post: context.inputOrigin.post, cites: homeDoor(under, context), tended: context.clock, tendedAt: context.height}
def withScene(state: State, kept: Lists.List<Rows.Field>, under: String, context: Abi.Context, scene: Scenes.Seed) -> Data:
  {owner: context.principal, head: Card.filled(state.head, captures(kept, context)), kind: context.object, fields: kept, maker: context.principal, makerHandle: context.handle, post: context.inputOrigin.post, cites: homeDoor(under, context), tended: context.clock, tendedAt: context.height, start: scene.start, passages: scene.passages, cooldown: scene.cooldown, requires: scene.requires}
def homeDoor(under: String, context: Abi.Context) -> Card.Doorways:
  if under == "" then Card.Doorways.nil() else Card.Doorways.cons({head: {label: lastSegment(under), to: {world: context.world, object: under}, description: "", examples: Lists.List.nil()}, tail: Card.Doorways.nil()})
def lastSegment(id: String) -> String:
  let at = textBreak(id, "/")
  if at == textLength(id) then id else lastSegment(textDrop(id, at + 1n))
def kindSeed(fields: Lists.List<Rows.Field>, context: Abi.Context) -> Data:
  {owner: context.principal, ownerHandle: context.handle, name: valueOf(fields, "name"), of: valueOf(fields, "of"), form: valueOf(fields, "form"), law: valueOf(fields, "law"), head: valueOf(fields, "head"), voice: valueOf(fields, "voice"), body: valueOf(fields, "body")}
# What a made thing is created under: its kind's `law`, cited (LAW §4 F), so the kind's owner
# amends the law of every instance at once and a refusal reads the kind's clause.
def lawOf(context: Abi.Context) -> String:
  "law kind \"{context.object}'s law holds\": under \"{context.object}\""
# A kind made by `kinds` is kind/<name>; an exact `id` is that id; anything else the first free
# <under>/<name>/<n>, or <name>/<n> (the host mints past ids already held).
def wanted(state: State, fields: Lists.List<Rows.Field>, under: String) -> String:
  if state.of == "kind" then kindId(valueOf(fields, "name")) else if valueOf(fields, "id") != "" then valueOf(fields, "id") else if under == "" then "{state.name}/" else "{under}/{state.name}/"
def kindId(name: String) -> String:
  "kind/{name}"
# Makes one: creates it from the package `of` names with the fields as its seed under the kind's
# law, then lays its body over it in the same turn (a made kind, the make its form generates).
# Made under a record, the record answers the maker and the kind says nothing.
# A `spween` field that is not a scene is refused by its reason, never made into a room without one;
# a kind's law that does not read is refused before the kind is made.
def making(state: State, fields: Lists.List<Rows.Field>, under: String, context: Abi.Context) -> Activity<Done>:
  if valueOf(fields, "id") != "" && context.principal != state.owner then refused(context, {clause: "notOwner", reading: "Only {Card.shown(state.owner, state.ownerHandle, context)} places what this kind makes at an id; make it, and it is named"}) else if state.of == "kind" then lawChecked(state, fields, under, context, Text.trim(valueOf(fields, "law"))) else scened(state, fields, under, context, valueOf(fields, "spween"))
# The text a kind will hold for what it makes, read as the host will read it: one clause a line,
# a law, a rule or a want, each checked as a package's clauses are (`world.check`), so a text that
# would refuse every make never stands. What it makes cites it (`under`), so its rules fire and its
# wants pose on every instance, owned by the kind's owner.
def lawChecked(state: State, fields: Lists.List<Rows.Field>, under: String, context: Abi.Context, law: String) -> Activity<Done>:
  match Lists.find(clauseLines(law), fn(line: String) -> Bool: clause(line) == false):
    case some(l): unlawful("`{l.value}` is no clause", context)
    case none(_): if law == "" then creating(state, fields, under, context) else lawRead(state, fields, under, context, law)
def lawRead(state: State, fields: Lists.List<Rows.Field>, under: String, context: Abi.Context, law: String) -> Activity<Done>:
  match world.check({package: "edition ObjectiveBend 1\nrecord State:\n  owner: String\ndef initial() -> State:\n  {{owner: \"\"}}\n{clauses(law)}\n"}):
    case checked(c): lawDiagnosed(state, fields, under, context, c.diagnostics)
    case refused(r): unlawful("it could not be read ({r.clause})", context)
def lawDiagnosed(state: State, fields: Lists.List<Rows.Field>, under: String, context: Abi.Context, diagnostics: Form.Names) -> Activity<Done>:
  match diagnostics:
    case nil(_): creating(state, fields, under, context)
    case cons(c): unlawful(diagnosis(c.head), context)
def unlawful(why: String, context: Abi.Context) -> Activity<Done>:
  refused(context, {clause: "badValue", reading: "law: {why}. One clause a line: law NAME \"reading\": EXPR, a rule ending then SPELL, a want asks SPELL; delvetalk library read / page: laws"})
# A line in one of the three modalities: a law refuses, a rule fires, a want poses (OVERHAUL §2).
def clause(line: String) -> Bool:
  Text.starts(line, "law ") || Text.starts(line, "rule ") || Text.starts(line, "want ")
def clauses(law: String) -> String:
  textJoin(clauseLines(law), "\n")
def clauseLines(law: String) -> Lists.List<String>:
  Lists.filter(Lists.map(Forms.split(law, "\n"), Text.trim), fn(line: String) -> Bool: line != "")
# A checker's line, `<module>:<line>: <stage>: <message>`, as its message.
def diagnosis(line: String) -> String:
  let rest = textDrop(line, Text.indexOf(line, ": ") + 2n)
  textDrop(rest, Text.indexOf(rest, ": ") + 2n)
def scened(state: State, fields: Lists.List<Rows.Field>, under: String, context: Abi.Context, spween: String) -> Activity<Done>:
  match Spween.parse(spween):
    case refused(r): if Text.blank(spween) then creating(state, fields, under, context) else refused(context, {clause: "spween", reading: "The spween is not a scene: {r.reason}"})
    case parsed(_): creating(state, fields, under, context)
def creating(state: State, fields: Lists.List<Rows.Field>, under: String, context: Abi.Context) -> Activity<Done>:
  match world.create({package: packageOf(state.of), seed: seedOf(state, fields, under, context), law: lawOf(context), requireAbsent: {world: context.world, object: wanted(state, fields, under)}}):
    case created(c): counted(state, c.object.object, under != "", layerOf(state, fields), context)
    case refused(r): refused(context, {clause: r.clause, reading: if r.reading == "" then "{wanted(state, fields, under)} was not made" else r.reading})
def counted(state: State, id: String, quiet: Bool, layer: String, context: Abi.Context) -> Activity<Done>:
  let written(_) = write {made: insert {object: id, n: state.count + 1n}, count: add 1n}
  if layer == "" then toldUnless(quiet, state, id, context) else laid(state, id, quiet, layer, context)
def toldUnless(quiet: Bool, state: State, id: String, context: Abi.Context) -> Activity<Done>:
  if quiet then Done.made({object: id}) else told(state, id, context)
# The layer laid into the making, in the same turn (HOST-HANDOFF 5.122): a made kind's make, or a
# thing's body, judged by the made thing's law; refused, nothing is made. Then a made record's
# `made` (a made kind has none), sent so it runs once the turn is committed (a body places its rules
# there, on the thing it answers, which needs the made thing in place).
def laid(state: State, id: String, quiet: Bool, layer: String, context: Abi.Context) -> Activity<Done>:
  match world.extend({object: {world: context.world, object: id}, package: layer, migration: ""}):
    case reprogrammed(_): finished(state, id, quiet, context)
    case refused(_): refuse("refused body: what was made could not be given its body, so nothing was made")
def finished(state: State, id: String, quiet: Bool, context: Abi.Context) -> Activity<Done>:
  if state.of == "kind" then toldUnless(quiet, state, id, context) else madeSent(state, id, quiet, context)
def madeSent(state: State, id: String, quiet: Bool, context: Abi.Context) -> Activity<Done>:
  match world.send({object: {world: context.world, object: id}, method: "made", argument: {}}):
    case _: toldUnless(quiet, state, id, context)
# What is laid on what this kind makes: a kind's make from the form it is made with, a thing's body.
def layerOf(state: State, fields: Lists.List<Rows.Field>) -> String:
  if state.of == "kind" then layerSource(valueOf(fields, "of"), valueOf(fields, "form")) else state.body
def told(state: State, id: String, context: Abi.Context) -> Activity<Done>:
  Card.tellTo(Done.made({object: id}), context.principal, Document.text("Made, at {id}; {natText(state.count + 1n)} made. Its card: delvetalk {id} ?\n"))
def refused(context: Abi.Context, refusal: Card.Refusal) -> Activity<Done>:
  Card.refusing(Done.refused(refusal), refusal, context)
# A record making under itself passes its own id and the fields (`under`): the instance is
# <under>/<name>/<n>, citing it home, and the record answers the maker. The fields come as text,
# so they are judged against the form here, as the host judges a make spell: a missing field, a
# value outside its bounds or not one of its options is refused by the host's clause, nothing
# made; fields the form does not take (a room's `spween`) are the seed's to read.
def makeUnder(state: State, input: {under: String, fields: Lists.List<Rows.Field>}, context: Abi.Context) -> Activity<Done>:
  match Forms.fault(state.form, input.fields):
    case some(f): refused(context, {clause: f.value.clause, reading: f.value.reading})
    case none(_): making(state, input.fields, input.under, context)
# Grafts the kind's make: the owner's, for a kind created whole rather than made (genesis shapes
# `kinds`); `kinds` lays each kind's make as it makes it.
def shape(state: State, input: {object: String}, context: Abi.Context) -> Activity<Done>:
  if context.principal != state.owner then refused(context, {clause: "notOwner", reading: "Only {Card.shown(state.owner, state.ownerHandle, context)} shapes this kind"}) else unshaped(state, context)
# A kind is shaped once: a layer goes over the package's own module, so a kind that already has its
# make (shaped, or made by `kinds`) is refused by name rather than laid a second layer.
def unshaped(state: State, context: Abi.Context) -> Activity<Done>:
  match world.inspect({object: Plans.self(context), source: false}):
    case inspected(i): if Lists.any(i.methods, fn(f: Form.Form) -> Bool: f.action == "make") then refused(context, {clause: "shaped", reading: "Already shaped; its make stands"}) else reshaped(state, context)
    case _: reshaped(state, context)
def reshaped(state: State, context: Abi.Context) -> Activity<Done>:
  match world.extend({object: Plans.self(context), package: layerSource(state.of, state.form), migration: ""}):
    case reprogrammed(_): Card.tell(Done.made({object: context.object}), Document.text("Shaped. Make one:\n  {spellLine(Card.called(context, kindId(state.name)), Forms.specs(state.form))}\n"))
    case refused(r): refused(context, {clause: r.clause, reading: r.reading})
def methods() -> Lists.List<String>:
  Text.words("~shape makeUnder")
# What the host offers a reader: the make to anyone, the exact id's `place` to the kind's owner.
def actions(state: State, context: Abi.Context) -> Lists.List<String>:
  if context.principal == state.owner then Text.words("make place") else Text.words("make")
def forms() -> Card.Forms:
  Card.Forms.nil()
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
# The kind's make layer: `make` with exactly its form's fields and, for a kind of things, `place`
# with them and the exact `id`.
def layerSource(of: String, form: String) -> String:
  let items = Forms.specs(form)
  let place = if of == "kind" then "" else actionSource("place", Lists.append(items, {name: "id", kind: "text 1..64"}))
  "layer over ./Kind.obend\nedition ObjectiveBend 1\nimport ./Abi.obend as Abi\nimport ./List.obend as Lists\nimport ./Form.obend as Form\nimport ./Rows.obend as Rows\ntype State = Super.State\n{actionSource(\"make\", items)}{place}"
def actionSource(action: String, items: Lists.List<Forms.Spec>) -> String:
  let formLines = textJoin(Lists.map(items, Forms.formLine), "")
  let converters = textJoin(Lists.map(items, fn(i: Forms.Spec) -> String: Forms.converter(action, i)), "")
  "form {action}:\n{formLines}def {action}(state: State, input: {Forms.capital(action)}Input, context: Abi.Context) -> Activity<Super.Done>:\n  Super.making(state, {Forms.fieldsExpr(action, items)}, \"\", context)\n{converters}"
# The make spell with its blanks, one inline line.
def spellLine(id: String, items: Lists.List<Forms.Spec>) -> String:
  let fields = textJoin(Lists.map(items, Forms.spellField), "")
  "delvetalk {id} make{fields}"
def newest(state: State) -> Lists.List<Made>:
  Lists.reverse(Relations.order(state.made, fn(m: Made) -> Nat: m.n))
def madeLine(m: Made) -> Document.Document:
  Document.text("- {m.object}\n")
def render(state: State, context: Abi.Context) -> Document.Document:
  let id = Card.called(context, kindId(state.name))
  let bodied = if state.body == "" then "" else ", with a body"
  let comes = if state.of == "kind" then "kind/<name>, a kind anyone makes" else "{state.name}/N, yours"
  let spell = spellLine(id, Forms.specs(state.form))
  let law = if state.of == "kind" then "A law is written in, one clause a line: law maker \"only its maker writes\": request.subject == new.maker\n" else ""
  let voice = if state.voice == "" then "" else "Its things speak: {state.voice}\n"
  let head = Document.text("KIND {state.name}: makes a {state.of}{bodied}; {natText(state.count)} made. Make one:\n  {spell}\n» {comes}\n{voice}{law}Newest first:\n")
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: Card.clippedWithin(Lists.map(newest(state), madeLine), 8n, Card.left(context, Document.size(head)))})})
