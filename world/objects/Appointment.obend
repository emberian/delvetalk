edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./List.obend as Lists
import ./Text.obend as Text
# One appointment: at `after` clock units from its waiting turn, it sends a note to
# `to` (an Avatar is the principal's DID). wait is an await on a slot nobody settles,
# resumed timedOut when the clock passes. Cancelling writes the appointment, so a keep
# still waiting resumes on a stale root and is refused: nothing is sent.
sum Status:
  booked: {}
  kept: {}
  cancelled: {}
record State:
  owner: fixed String
  topic: fixed String
  to: fixed Plans.Reference
  after: fixed Nat
  status: Status
record Seed:
  owner: String
  topic: String
  to: Plans.Reference
  after: Nat
def initial() -> State:
  {owner: "", topic: "", to: Plans.nobody(), after: 1n, status: Status.booked({})}
sum Done:
  kept: {}
  cancelled: {}
  refused: Card.Refusal
def notBooked() -> Done:
  Done.refused({clause: "notBooked", reading: "This appointment is no longer booked."})
def open(state: State) -> Bool:
  match state.status:
    case booked(_): true
    case _: false
def wait(state: State, context: Abi.Context) -> Activity<Done>:
  if open(state) then waiting(context, state) else notBooked()
def waiting(context: Abi.Context, state: State) -> Activity<Done>:
  match world.await({slot: {principal: context.object, intent: "wait/{context.intent}"}, patience: state.after}):
    case timedOut(_): due(context, state)
    case _: Done.refused({clause: "early", reading: "The appointment was answered before its time."})
def due(context: Abi.Context, state: State) -> Activity<Done>:
  let written(_) = write {status: set Status.kept({})}
  sent(state)
def sent(state: State) -> Activity<Done>:
  match world.send({object: state.to, method: "note", argument: {text: "appointment: {state.topic}"}}):
    case _: Done.kept({})
def cancel(state: State, context: Abi.Context) -> Activity<Done>:
  if context.principal != state.owner then Done.refused({clause: "notOwner", reading: "Only its owner cancels it; that is {Card.name(state.owner, context)}"}) else if open(state) then cancelling(context) else notBooked()
def cancelling(context: Abi.Context) -> Activity<Done>:
  let written(_) = write {status: set Status.cancelled({})}
  Done.cancelled({})
def methods() -> Lists.List<String>:
  Text.words("wait cancel")
def forms() -> Card.Forms:
  Card.Forms.nil()
def blurb() -> Card.Door:
  {word: "appointment", blurb: "A note sent when its time comes."}
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
def statusName(status: Status) -> String:
  match status:
    case booked(_): "booked"
    case kept(_): "kept"
    case cancelled(_): "cancelled"
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.text("Appointment: {state.topic} for {Card.name(state.to.object, context)}, after {natText(state.after)} ({statusName(state.status)}){Card.mine(state.owner, context)}\n")
