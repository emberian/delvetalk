edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Card.obend as Card
# One appointment: at `after` clock units from its keeping turn, it sends a note to
# `to` (an Avatar is the principal's DID). keep is an await on a slot nobody settles,
# resumed timedOut when the clock passes. Cancelling writes the appointment, so a keep
# still waiting resumes on a stale root and is refused: nothing is sent.
sum Status:
  booked: {}
  kept: {}
  cancelled: {}
record State:
  owner: String
  topic: String
  to: Plans.Reference
  after: Nat
  status: Status
record Seed:
  owner: String
  topic: String
  to: Plans.Reference
  after: Nat
record Edits:
  status: Plans.Edit<Status, {}>
type Plan = Plans.Plan<Edits>
type Response = Plans.Response<State, {}>
def defaultSeed() -> Seed:
  {owner: "", topic: "", to: Plans.nobody(), after: 1n}
def seeded(seed: Seed) -> State:
  {owner: seed.owner, topic: seed.topic, to: seed.to, after: seed.after, status: Status.booked({})}
def initial() -> State:
  seeded(defaultSeed())
sum Done:
  kept: {}
  cancelled: {}
  refused: {reason: String}
def open(state: State) -> Bool:
  match state.status:
    case booked(_): true
    case _: false
def keep(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  if open(state) then waiting(state, context) else Done.refused({reason: "This appointment is no longer booked."})
def waiting(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  match perform(Plan.await({slot: {principal: context.object, intent: "keep/{context.intent}"}, patience: state.after})):
    case timedOut(_): due(state, context)
    case _: Done.refused({reason: "The appointment was answered before its time."})
def due(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: {status: Plans.Edit.set({value: Status.kept({})})}}))
  sent(state)
def sent(state: State) -> Activity<Plan, Response, Done>:
  match perform(Plan.send({object: state.to, method: "note", argument: {text: "appointment: {state.topic}"}})):
    case _: Done.kept({})
def cancel(state: State, context: Abi.Context) -> Activity<Plan, Response, Done>:
  if context.principal != state.owner then Done.refused({reason: "Only its owner cancels it; that is {Card.name(state.owner, context)}"}) else if open(state) then cancelling(context) else Done.refused({reason: "This appointment is no longer booked."})
def cancelling(context: Abi.Context) -> Activity<Plan, Response, Done>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: {status: Plans.Edit.set({value: Status.cancelled({})})}}))
  Done.cancelled({})
def forms() -> Card.Forms:
  Card.Forms.nil()
def blurb() -> Card.Door:
  {word: "appointment", blurb: "A note sent when its time comes."}
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Replied>:
  Card.answerPlan(Card.routeHeard(input, context, forms()), context, forms(), render(state, context))
def statusName(status: Status) -> String:
  match status:
    case booked(_): "booked"
    case kept(_): "kept"
    case cancelled(_): "cancelled"
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.text("Appointment: {state.topic} for {Card.name(state.to.object, context)}, after {natText(state.after)} ({statusName(state.status)}){Card.mine(state.owner, context)}\n")
