edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./Card.obend as Card
sum Status:
  proposed: {}
  admitted: {}
record Proposal:
  author: String
  line: String
  status: Status
record State:
  proposals: Lists.List<Proposal>
# What a creator may supply; the host lays it over initial().
type Seed = {}
record Edits:
  proposals: Plans.Entries<Proposal, Proposal>
type Plan = Plans.Plan<Edits>
type Response = Plans.Response<State, {}>
def defaultSeed() -> Seed:
  {}
def seeded(seed: Seed) -> State:
  {proposals: Lists.List::<Proposal>.nil()}
def initial() -> State:
  seeded(defaultSeed())
# Submission only proposes; admission is the receiver's law, not the author's. The
# author is the turn's principal.
def submitted<T>(state: State, line: String, context: Abi.Context, then: Nat -> T) -> Activity<Plan, Response, T>:
  match perform(Plan.write({object: Plans.self(context), edits: {proposals: Plans.Entries::<Proposal, Proposal>.append({item: {author: context.principal, line: line, status: Status.proposed({})}})}})):
    case _: then(Lists.length::<Proposal>(state.proposals) + 1n)
def submit(state: State, input: {line: String}, context: Abi.Context) -> Activity<Plan, Response, Nat>:
  submitted::<Nat>(state, input.line, context, fn(count: Nat) -> Nat: count)
sum Found:
  none: {}
  some: {proposal: Proposal}
def at(items: Lists.List<Proposal>, index: Nat) -> Found:
  match items:
    case nil(_): Found.none({})
    case cons(c): if index == 0n then Found.some({proposal: c.head}) else at(c.tail, index - 1n)
# The host replaces the item at the index by the change, so admission rewrites
# the proposal with its status flipped.
def admit(state: State, input: {index: Nat}, context: Abi.Context) -> Activity<Plan, Response, Bool>:
  match at(state.proposals, input.index):
    case none(_): false
    case some(s): admitted(context, input.index, s.proposal)
def admitted(context: Abi.Context, index: Nat, proposal: Proposal) -> Activity<Plan, Response, Bool>:
  match perform(Plan.write({object: Plans.self(context), edits: {proposals: Plans.Entries::<Proposal, Proposal>.amend({index: index, change: {author: proposal.author, line: proposal.line, status: Status.admitted({})}})}})):
    case _: true
def forms() -> Card.Forms:
  Card.Forms.cons({head: {card: "", action: "submit", fields: Form.Fields.cons({head: {name: "line", kind: Form.Kind.text({min: 1n, max: 280n})}, tail: Form.Fields.nil()})}, tail: Card.Forms.nil()})
def door() -> Card.Door:
  {word: "anthology", blurb: "Submit a line; the anthology's law admits it."}
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  heard(state, Card.route(input.text, context, forms()), context)
def heard(state: State, routed: Card.Routed, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  match routed:
    case act(a): submitted::<Card.Reply>(state, Card.text(a.fields, "line"), context, fn(count: Nat) -> Card.Reply: Card.Reply.done({action: a.action}))
    case _: Card.answer::<Edits, State, {}>(routed, context, forms(), render(state))
def statusName(status: Status) -> String:
  match status:
    case proposed(_): "proposed"
    case admitted(_): "admitted"
def entry(proposal: Proposal) -> Document.Document:
  Document.text(textConcat("[", textConcat(statusName(proposal.status), textConcat("] ", textConcat(Card.handle(proposal.author), textConcat(": ", textConcat(proposal.line, "\n")))))))
def render(state: State) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text("Anthology\n"), tail: Card.clipped(Lists.map::<Proposal, Document.Document>(state.proposals, entry), 8n)})})
