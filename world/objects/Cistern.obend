edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Relation.obend as Relations
import ./Text.obend as Text
# A retained receipt, keyed {at, slot}: `at` is the receipt's height, so key order is the order
# of the turns, and past 256 the host drops the oldest.
record Kept:
  at: Nat
  slot: Plans.Slot
  outcome: Plans.Outcome
# level: how much the town has poured in; it only rises (a Wake watching it passing a mark is
# the flood).
record State:
  entries: Relations.Relation<Kept>
  level: Nat
# The Garden imports this package to create it, so the law cannot sit here in source: each
# creator passes it (the Garden's `cistern`, deploy/genesis.py, which tests compare).
def lawText(creator: String) -> String:
  "law owner \"its own methods write it, or its creator\": request.kind == 0 or request.subject == \"{creator}\"\nlaw level \"the level only rises\": monotone(level)"
def initial() -> State:
  {entries: Relations.empty(), level: 0n}
def relations() -> Relations.Decls:
  Lists.append(Relations.Decls.nil(), {field: "entries", key: Text.words("at slot"), limit: 256n})
# Retains a refusal (or any) receipt; the answer is how many it keeps.
def retain(state: State, input: {receipt: Plans.Receipt}, context: Abi.Context) -> Activity<Nat>:
  let written(_) = write {entries: insert {at: input.receipt.height, slot: input.receipt.slot, outcome: input.receipt.outcome}}
  Relations.count(Relations.insert(state.entries, {at: input.receipt.height, slot: input.receipt.slot, outcome: input.receipt.outcome}, keptKey))
def keptKey(kept: Kept) -> {at: Nat, slot: Plans.Slot}:
  {at: kept.at, slot: kept.slot}
sum Poured:
  poured: {level: Nat}
  refused: Card.Refusal
# Anyone pours 1 to 20 at a time (a direct turn too, not only the spell its form bounds); the
# pourer is answered with the cistern as it now stands.
def pour(state: State, input: {amount: Nat}, context: Abi.Context) -> Activity<Poured>:
  if input.amount == 0n || input.amount > 20n then Poured.refused({clause: "badAmount", reading: "A pour is 1 to 20."}) else poured(state.level + input.amount, input.amount, context, state)
def poured(level: Nat, amount: Nat, context: Abi.Context, state: State) -> Activity<Poured>:
  let written(_) = write {level: add amount}
  Card.tellTo(Poured.poured({level: level}), context.principal, render(extend(state, {level: level}), context))
form pour:
  amount: natural 1..20
# A receipt is structured data, not a spell: retain has no form.
def methods() -> Lists.List<String>:
  Text.words("retain")
def blurb() -> Card.Door:
  {word: "cistern", blurb: "Keeps the receipts it is given, newest first, and what the town pours in."}
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
def outcomeName(outcome: Plans.Outcome) -> String:
  match outcome:
    case admitted(_): "admitted"
    case refused(r): "refused {r.class}"
def line(kept: Kept) -> Document.Document:
  Document.text("#{natText(kept.at)} {Card.handle(kept.slot.principal)}: {outcomeName(kept.outcome)}\n")
def render(state: State, context: Abi.Context) -> Document.Document:
  let id = Card.called(context, "cistern")
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text("Cistern, level {natText(state.level)}. Pour: delvetalk {id} pour / amount: <1 to 20>.\n"), tail: Card.clipped(Lists.map(Lists.reverse(Relations.rows(state.entries)), line), 8n)})})
