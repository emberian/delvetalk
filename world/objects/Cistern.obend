edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
record State:
  entries: Lists.List<Plans.Receipt>
# A creator supplies a Seed; seeded makes the child's State from it.
type Seed = {}
record Edits:
  entries: Plans.Entries<Plans.Receipt, {}>
type Plan = Plans.Plan<Edits, {}>
type Response = Plans.Response<State, {}>
def defaultSeed() -> Seed:
  {}
def seeded(seed: Seed) -> State:
  {entries: Lists.List::<Plans.Receipt>.nil()}
def initial() -> State:
  seeded(defaultSeed())
# Retains a refusal (or any) receipt in the order it was offered.
def retain(state: State, input: {receipt: Plans.Receipt}, context: Abi.Context) -> Activity<Plan, Response, Nat>:
  let count = Lists.length::<Plans.Receipt>(state.entries)
  match perform(Plan.write({object: Plans.self(context), edits: {entries: Plans.Entries::<Plans.Receipt, {}>.append({item: input.receipt})}})):
    case written(_): count + 1n
    case _: count
def outcomeName(outcome: Plans.Outcome) -> String:
  match outcome:
    case admitted(_): "admitted"
    case refused(r): textConcat("refused ", r.class)
def line(receipt: Plans.Receipt) -> Document.Document:
  Document.text(textConcat("#", textConcat(natText(receipt.height), textConcat(" ", textConcat(receipt.slot.principal, textConcat(": ", textConcat(outcomeName(receipt.outcome), "\n")))))))
def render(state: State) -> Document.Document:
  Document.concat(Document.text("Cistern\n"), Document.Document.sequence({items: Lists.map::<Plans.Receipt, Document.Document>(state.entries, line)}))
def card(state: State) -> String:
  Document.plain(render(state))
