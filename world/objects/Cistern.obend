edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Plan.obend as Plans
import ./Card.obend as Card
record State:
  entries: Lists.List<Plans.Receipt>
# What a creator may supply; the host lays it over initial().
type Seed = {}
record Edits:
  entries: Plans.Entries<Plans.Receipt, {}>
type Plan = Plans.Plan<Edits>
type Response = Plans.Response<State, {}>
def defaultSeed() -> Seed:
  {}
def seeded(seed: Seed) -> State:
  {entries: Lists.List.nil()}
def initial() -> State:
  seeded(defaultSeed())
# Retains a refusal (or any) receipt in the order it was offered.
def retain(state: State, input: {receipt: Plans.Receipt}, context: Abi.Context) -> Activity<Plan, Response, Nat>:
  let written(_) = perform(Plan.write({object: Plans.self(context), edits: {entries: Plans.Entries.append({item: input.receipt})}}))
  Lists.length(state.entries) + 1n
# A receipt is structured data, not a spell: the card offers no form.
def forms() -> Card.Forms:
  Card.Forms.nil()
def door() -> Card.Door:
  {word: "cistern", blurb: "Keeps receipts, refusals first."}
def receive(state: State, input: Card.Heard, context: Abi.Context) -> Activity<Plan, Response, Card.Reply>:
  Card.answer(Card.route(input.text, context, forms()), context, forms(), render(state, context))
def outcomeName(outcome: Plans.Outcome) -> String:
  match outcome:
    case admitted(_): "admitted"
    case refused(r): "refused {r.class}"
def line(receipt: Plans.Receipt) -> Document.Document:
  Document.text("#{natText(receipt.height)} {Card.handle(receipt.slot.principal)}: {outcomeName(receipt.outcome)}\n")
# The card as the reader in the context sees it (the host's card {object} passes the reader).
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text("Cistern\n"), tail: Card.clipped(Lists.map(state.entries, line), 8n)})})
