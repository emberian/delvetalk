edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Relation.obend as Relations
import ./Rows.obend as Rows
import ./Text.obend as Text
import ./Scenes.obend as Scenes
import ./Spween.obend as Spween
# A scene: passages and choices as data (world/lib/Scenes.obend), who is where, the
# variables its choices change, and when each reader last left. The reader is always the
# turn's principal; no method takes one as an argument. Passages are the creator's seed
# (sixteen passages of eight choices are what a card can show), or a ```spween block a
# reader posts here, which makes a new scene at <this scene>/<its id> (world/lib/
# Spween.obend). Presence holds sixteen readers, variables sixteen names, and `left` the
# newest 64 departures.
#
# A choice offers itself only when its guard holds over the variables; taking it applies
# its effects in order and moves the reader to its target, or out of the scene at END.
# Entering needs the scene's `requires` to hold and, when the scene has a cooldown, that
# the reader left at least `cooldown` clock units ago: refused by name in Bend first, and
# by the law below for the same write proposed any other way.
type Choice = Scenes.Choice
type Passage = Scenes.Passage
type Var = Scenes.Var
type Presence = Rows.Presence
# When a reader last left, keyed {at, who}: key order is the order of leaving, so past 64 the
# host drops the oldest.
record Left:
  who: String
  at: Nat
# owner: who may reprogram or amend the scene (the host fills it with the creating
# principal: ember for genesis's rooms, the poster for a scene made from spween).
record State:
  owner: String
  title: String
  start: String
  passages: Lists.List<Passage>
  presence: Relations.Relation<Presence>
  vars: Lists.List<Var>
  cooldown: Nat
  requires: Scenes.Guard
  left: Relations.Relation<Left>
def initial() -> State:
  {owner: "", title: "", start: "", passages: Lists.List.nil(), presence: Relations.empty(), vars: Lists.List.nil(), cooldown: 0n, requires: Lists.List.nil(), left: Relations.empty()}
def leftKey(l: Left) -> {at: Nat, who: String}:
  {at: l.at, who: l.who}
def relations() -> Relations.Decls:
  Lists.append(Lists.append(Relations.Decls.nil(), {field: "presence", key: Text.words("who"), limit: 16n}), {field: "left", key: Text.words("at who"), limit: 64n})
law owner "only the owner reprograms or amends it; anyone enters, chooses and leaves": request.kind == 0 or request.subject == new.owner
law fixed "the owner, title, passages, start, cooldown and requirements never change": unchanged(owner) and unchanged(title) and unchanged(start) and unchanged(passages) and unchanged(cooldown) and unchanged(requires)
# The cooldown, as the second tier of the law: a reader who appears in presence must have
# left at least `cooldown` clock units before the turn's clock.
def law(old: State, new: State, request: Abi.Request) -> Abi.Verdict:
  if old.cooldown == 0n then Abi.Verdict.admitted({}) else arrivals(Relations.rows(new.presence), request.context.clock, old)
def arrivals(presence: Lists.List<Presence>, clock: Nat, old: State) -> Abi.Verdict:
  if Lists.any(presence, fn(p: Presence) -> Bool: Rows.isPresent(old.presence, p.who) == false && cooling(p.who, clock, old)) then Abi.Verdict.refused({clause: "cooldown", reading: "One who left enters again only after the cooldown."}) else Abi.Verdict.admitted({})
def lastLeft(who: String, state: State) -> Lists.Maybe<Left>:
  Lists.find(Relations.rows(state.left), fn(l: Left) -> Bool: l.who == who)
def cooling(who: String, clock: Nat, state: State) -> Bool:
  match lastLeft(who, state):
    case some(l): clock < l.value.at + state.cooldown
    case none(_): false
sum Done:
  entered: {at: String}
  moved: {to: String}
  left: {}
  refused: Card.Refusal
def here(context: Abi.Context, state: State) -> Lists.Maybe<Presence>:
  Rows.presentAs(state.presence, context.principal)
def passageAt(id: String, state: State) -> Lists.Maybe<Passage>:
  Lists.find(state.passages, fn(p: Passage) -> Bool: p.id == id)
# What an activity may do, judged purely before anything is written: a refusal names
# itself and writes nothing, so the card can show it. A move carries the edits of its
# effects, one write each, in order.
sum Verdict:
  enter: {at: String}
  move: {me: Presence, choice: Choice, vars: Lists.List<Plans.Entries<Var, Var>>}
  leave: {me: Presence, vars: Lists.List<Plans.Entries<Var, Var>>}
  no: Card.Refusal
def no(clause: String, reading: String) -> Verdict:
  Verdict.no({clause: clause, reading: reading})
def enterVerdict(context: Abi.Context, state: State) -> Verdict:
  match here(context, state):
    case some(_): no("alreadyHere", "You are already in this scene.")
    case none(_): if Relations.count(state.presence) >= 16n then no("sceneFull", "Sixteen readers are already here.") else if Lists.any(state.passages, fn(p: Passage) -> Bool: p.id == state.start) == false then no("noStart", "This scene has no start passage.") else admitted(context, state)
def admitted(context: Abi.Context, state: State) -> Verdict:
  match Scenes.failing(state.requires, state.vars):
    case some(c): no("unmet", "The scene requires {Scenes.clauseText(c.value)}.")
    case none(_): if cooling(context.principal, context.clock, state) then no("cooldown", "You left at clock {natText(leftAt(context.principal, state))}; enter again from clock {natText(leftAt(context.principal, state) + state.cooldown)}.") else Verdict.enter({at: state.start})
def leftAt(who: String, state: State) -> Nat:
  match lastLeft(who, state):
    case some(l): l.value.at
    case none(_): 0n
def leaveVerdict(context: Abi.Context, state: State) -> Verdict:
  match here(context, state):
    case none(_): no("notHere", "You are not in this scene.")
    case some(p): Verdict.leave({me: p.value, vars: Lists.List.nil()})
def chooseVerdict(choice: String, context: Abi.Context, state: State) -> Verdict:
  match here(context, state):
    case none(_): no("notHere", "Enter the scene first.")
    case some(p): standing(p.value, choice, state)
def standing(me: Presence, choice: String, state: State) -> Verdict:
  match passageAt(me.at, state):
    case none(_): no("noPassage", "Your passage is gone.")
    case some(ps): offered(me, Lists.find(ps.value.choices, fn(c: Choice) -> Bool: c.label == choice), choice, state)
def offered(me: Presence, found: Lists.Maybe<Choice>, choice: String, state: State) -> Verdict:
  match found:
    case none(_): no("notOffered", "{me.at} does not offer {choice}")
    case some(c): guarded(me, c.value, Scenes.failing(c.value.guard, state.vars), state)
def guarded(me: Presence, c: Choice, failed: Lists.Maybe<Scenes.Clause>, state: State) -> Verdict:
  match failed:
    case some(f): no("guarded", "{c.label} needs {Scenes.clauseText(f.value)}.")
    case none(_): arriving(me, c, state)
def arriving(me: Presence, c: Choice, state: State) -> Verdict:
  if c.to == Scenes.ending() then effected(me, c, effects(c.effects, state.vars, Lists.List.nil()), true) else reached(me, c, state)
def reached(me: Presence, c: Choice, state: State) -> Verdict:
  match passageAt(c.to, state):
    case none(_): no("noPassage", "{c.to} is not in this scene")
    case some(_): effected(me, c, effects(c.effects, state.vars, Lists.List.nil()), false)
def effected(me: Presence, c: Choice, edits: Effects, ends: Bool) -> Verdict:
  match edits:
    case full(_): no("varsFull", "Sixteen variables are already set.")
    case edits(e): if ends then Verdict.leave({me: me, vars: e.edits}) else Verdict.move({me: me, choice: c, vars: e.edits})
# The edits a choice's effects make, in order, each against the variables as the ones
# before it leave them.
sum Effects:
  edits: {edits: Lists.List<Plans.Entries<Var, Var>>}
  full: {}
def effects(list: Lists.List<Scenes.Effect>, vars: Lists.List<Var>, edits: Lists.List<Plans.Entries<Var, Var>>) -> Effects:
  match list:
    case nil(_): Effects.edits({edits: edits})
    case cons(c): effectOn(c.head, c.tail, vars, edits, Lists.find(vars, fn(v: Var) -> Bool: v.name == c.head.key))
def effectOn(effect: Scenes.Effect, rest: Lists.List<Scenes.Effect>, vars: Lists.List<Var>, edits: Lists.List<Plans.Entries<Var, Var>>, found: Lists.Maybe<Var>) -> Effects:
  match found:
    case some(v): effects(rest, Lists.map(vars, fn(w: Var) -> Var: if w.name == effect.key then {name: w.name, value: Scenes.applied(effect, w.value)} else w), Lists.append(edits, Plans.Entries.amendItem({item: v.value, change: {name: effect.key, value: Scenes.applied(effect, v.value.value)}})))
    case none(_): if Lists.length(vars) >= 16n then Effects.full({}) else effects(rest, Lists.append(vars, {name: effect.key, value: Scenes.applied(effect, "")}), Lists.append(edits, Plans.Entries.append({item: {name: effect.key, value: Scenes.applied(effect, "")}})))
# Performs a verdict: a refusal writes nothing and offers the reader's card with its clause
# ("refused notOffered: ..."); otherwise the writes, in order.
def done(verdict: Verdict, context: Abi.Context, state: State) -> Activity<Done>:
  match verdict:
    case no(n): Card.answerRefused(n, context, forms(), render(state, context), fn(r: Card.Replied) -> Done: Done.refused(n))
    case enter(e): entering(e.at, context)
    case move(m): moving(m.me, m.choice, m.vars)
    case leave(l): departing(l.me, l.vars, context, state)
def entering(at: String, context: Abi.Context) -> Activity<Done>:
  let written(_) = write {presence: insert {who: context.principal, at: at}}
  Done.entered({at: at})
def moving(me: Presence, c: Choice, vars: Lists.List<Plans.Entries<Var, Var>>) -> Activity<Done>:
  let written(_) = write {presence: upsert {who: me.who, at: c.to}}
  varied(vars, Done.moved({to: c.to}))
def varied(vars: Lists.List<Plans.Entries<Var, Var>>, done: Done) -> Activity<Done>:
  match vars:
    case nil(_): done
    case cons(c): wroteVar(c.head, c.tail, done)
def wroteVar(edit: Plans.Entries<Var, Var>, rest: Lists.List<Plans.Entries<Var, Var>>, done: Done) -> Activity<Done>:
  let written(_) = world.write(extend(keep(), {vars: edit}))
  varied(rest, done)
# Leaving (or reaching END) records when, for the cooldown: the reader's last departure is
# retracted and this one inserted.
def departing(me: Presence, vars: Lists.List<Plans.Entries<Var, Var>>, context: Abi.Context, state: State) -> Activity<Done>:
  let written(_) = write {presence: retract {who: me.who}}
  match lastLeft(me.who, state):
    case some(l): forgotten(l.value, vars, context)
    case none(_): recorded(vars, context)
def forgotten(last: Left, vars: Lists.List<Plans.Entries<Var, Var>>, context: Abi.Context) -> Activity<Done>:
  let written(_) = write {left: retract leftKey(last)}
  recorded(vars, context)
def recorded(vars: Lists.List<Plans.Entries<Var, Var>>, context: Abi.Context) -> Activity<Done>:
  let written(_) = write {left: insert {at: context.clock, who: context.principal}}
  varied(vars, Done.left({}))
def enter(state: State, context: Abi.Context) -> Activity<Done>:
  done(enterVerdict(context, state), context, state)
def choose(state: State, input: {choice: String}, context: Abi.Context) -> Activity<Done>:
  done(chooseVerdict(input.choice, context, state), context, state)
def leave(state: State, context: Abi.Context) -> Activity<Done>:
  done(leaveVerdict(context, state), context, state)
form enter:
form choose:
  choice: text 1..64
form leave:
def forms() -> Card.Forms:
  Lists.append(Lists.append(Lists.append(Card.Forms.nil(), enterForm()), chooseForm()), leaveForm())
def blurb() -> Card.Door:
  {word: "scene", blurb: "A passage-and-choice scene: enter, choose, leave; post a ```spween block to make one."}
# A ```spween block makes a new scene beside this one; anything else is the card's default.
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  match Spween.block(input.text):
    case some(b): authored(Spween.parse(b.value), context, state)
    case none(_): Card.answer(input, context, forms(), render(state, context))
def authored(parsed: Spween.Parsed, context: Abi.Context, state: State) -> Activity<Card.Replied>:
  match parsed:
    case refused(r): Card.answerRefused({clause: "spween", reading: r.reason}, context, forms(), render(state, context), fn(x: Card.Replied) -> Card.Replied: x)
    case parsed(p): creating(p.seed, "{context.object}/{p.id}")
def creating(seed: Scenes.Seed, id: String) -> Activity<Card.Replied>:
  match world.create({package: "Scene", seed: seed, law: "", requireAbsent: {world: "", object: id}}):
    case created(c): Card.tell(Card.Replied.done({action: "create"}), Document.text("SCENE {seed.title} is at {c.object.object}: {natText(Lists.length(seed.passages))} passages. Reply delvetalk {c.object.object} enter to begin.\n"))
    case refused(r): Card.tell(Card.Replied.refused({clause: r.clause, reading: "The world refused it ({r.clause})."}), Document.text("Not made, refused {r.clause}: {id}\n"))
def choiceLine(c: Choice) -> Document.Document:
  Document.text("  * {c.label}\n")
def varLine(v: Var) -> Document.Document:
  Document.text("{v.name} = {v.value}\n")
def stranger(context: Abi.Context, state: State) -> Document.Document:
  let card = if context.object == "" then "<scene>" else context.object
  Document.text("SCENE {state.title}: {natText(Relations.count(state.presence))} here. Reply delvetalk {card} enter to join.\n")
def reading(me: Presence, context: Abi.Context, state: State) -> Document.Document:
  match passageAt(me.at, state):
    case none(_): stranger(context, state)
    case some(ps): passageCard(ps.value, state)
def passageHead(ps: Passage, state: State) -> Document.Document:
  Document.text("SCENE {state.title} ({natText(Relations.count(state.presence))} here), you are at {ps.id}:\n{ps.text}\nChoices:\n")
# The choices whose guards hold now; the others are not shown.
def passageCard(ps: Passage, state: State) -> Document.Document:
  let choices = Card.clipped(Lists.map(Lists.filter(ps.choices, fn(c: Choice) -> Bool: Scenes.holds(c.guard, state.vars)), choiceLine), 8n)
  let vars = Card.clipped(Lists.map(state.vars, varLine), 4n)
  Document.Document.sequence({items: Document.Documents.cons({head: passageHead(ps, state), tail: Lists.concat(choices, vars)})})
# The card as the reader in the context sees it: a present reader sees their passage.
def render(state: State, context: Abi.Context) -> Document.Document:
  match here(context, state):
    case some(p): reading(p.value, context, state)
    case none(_): stranger(context, state)
