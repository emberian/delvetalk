edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Relation.obend as Relations
import ./Text.obend as Text
# The stacks (docs/LIBRARY.md): pages on how the town works and walks of spells in order, each
# under the clip, read with `read`; a card's law with its readings, with `law`. hob, the
# librarian, speaks the first line of each.
sum Kind:
  page: {}
  walk: {}
# A page, keyed {name}; `place` is the order it was first shelved in, which the index keeps.
record Page:
  name: String
  kind: Kind
  title: String
  body: String
  place: Nat
record State:
  owner: String
  ownerHandle: String
  pages: Relations.Relation<Page>
law owner "only the owner shelves a page; anyone reads, and places rules, wants and verbs on it": request.subject == new.owner or ((request.kind == 0 or request.kind == rule) and unchanged(owner) and unchanged(pages))
def initial() -> State:
  {owner: "", ownerHandle: "", pages: Relations.empty()}
# 96 pages, each at most what a reply leaves after the library's receipt line (Card.limit: 1,266 characters in a
# world of one post's room, kilobytes where the world gives more; `shelve` refuses past it): a town that documents
# itself from inside shelves its language, its API and its docs beside the guide.
def relations() -> Relations.Decls:
  Lists.append(Relations.Decls.nil(), {field: "pages", key: Text.words("name"), limit: 96n})
form read:
  page: text 1..120
form laws:
  card: text 1..128
form shelve:
  name: text 1..32
  kind: Kind
  title: text 1..80
  body: text 1..32768
def ordered(state: State) -> Lists.List<Page>:
  Relations.order(state.pages, fn(p: Page) -> Nat: p.place)
# A page that continues another (`guide-3` continues `guide`: its name before the first `-` is a page here) or
# translates it (`guide.ja` is `guide` in the tongue `ja`: its name before the first `.` is a page here) is read by
# name and left off the index and the shelf line, where its first page stands for it.
def continued(state: State, page: Page) -> Bool:
  derived(state, page, "-") || derived(state, page, ".")
def derived(state: State, page: Page, mark: String) -> Bool:
  let at = textBreak(page.name, mark)
  if at >= textLength(page.name) then false else shelvedName(state, textTake(page.name, at))
def shelvedName(state: State, name: String) -> Bool:
  match Relations.lookup(state.pages, {name: name}):
    case some(_): true
    case none(_): false
def heads(state: State) -> Lists.List<Page>:
  Lists.filter(ordered(state), fn(p: Page) -> Bool: continued(state, p) == false)
def isWalk(page: Page) -> Bool:
  match page.kind:
    case walk(_): true
    case page(_): false
# The page named, else the first whose name is a whole word of what was given ("how do i read
# laws" finds laws), a mark at either end aside.
def found(state: State, said: String) -> Lists.Maybe<Page>:
  match Relations.lookup(state.pages, {name: Text.trim(said)}):
    case some(p): Lists.Maybe.some({value: p.value})
    case none(_): Lists.find(ordered(state), fn(p: Page) -> Bool: Lists.any(Text.words(said), fn(w: String) -> Bool: textLength(w) > 0n && Card.stripped(w, textLength(w)) == p.name))
# Reading writes nothing and asks no model. A reader whose avatar states a tongue (`delvetalk me set / tongue: ja`)
# is read the page's translation (`guide.ja`) where one is shelved; no avatar, no tongue, `en`, or a view refused
# read the page as shelved.
def read(state: State, input: {page: String}, context: Abi.Context) -> Activity<Card.Replied>:
  match world.viewField::<String>({object: {world: context.world, object: context.principal}, field: "tongue"}):
    case viewed(v): readIn(state, input, v.state, context)
    case _: readIn(state, input, "", context)
def readIn(state: State, input: {page: String}, tongue: String, context: Abi.Context) -> Activity<Card.Replied>:
  match found(state, input.page):
    case some(p): Card.tell(Card.Replied.done({action: "read"}), Document.text(translated(state, p.value, tongue).body))
    case none(_): refused({clause: "noPage", reading: "No page called {input.page}. {shelfLine(state)}"}, context)
def translated(state: State, page: Page, tongue: String) -> Page:
  if tongue == "" || tongue == "en" then page else inTongue(state, page, tongue)
def inTongue(state: State, page: Page, tongue: String) -> Page:
  match Relations.lookup(state.pages, {name: "{page.name}.{tongue}"}):
    case some(t): t.value
    case none(_): page
def names(pages: Lists.List<Page>) -> String:
  textJoin(Lists.map(pages, fn(p: Page) -> String: p.name), " ")
def shelfLine(state: State) -> String:
  let walks = Lists.filter(heads(state), isWalk)
  let walked = if Lists.length(walks) == 0n then "" else "; walks: {names(walks)}"
  "Pages: {names(Lists.filter(heads(state), fn(p: Page) -> Bool: isWalk(p) == false))}{walked}."
def refused(refusal: Card.Refusal, context: Abi.Context) -> Activity<Card.Replied>:
  Card.refusing(Card.Replied.refused(refusal), refusal, context)
# A card's law as the host has it (`inspect` without the source): each clause with its reading,
# then its expression; a clause `under "<object>"` is followed to that object's `law` (a made
# thing's kind), whose clauses come after, their expressions dropped when the whole would pass
# the card's clip.
def laws(state: State, input: {card: String}, context: Abi.Context) -> Activity<Card.Replied>:
  match world.inspect({object: {world: context.world, object: input.card}, source: false}):
    case inspected(i): citing(input.card, i.laws, Lists.find(i.laws, fn(r: World.LawRow) -> Bool: Text.starts(r.clause, "under \"")), context)
    case _: refused({clause: "noCard", reading: "No card {input.card} that you may see; the commonplace lists the doors"}, context)
def citing(card: String, rows: Lists.List<World.LawRow>, under: Lists.Maybe<World.LawRow>, context: Abi.Context) -> Activity<Card.Replied>:
  match under:
    case none(_): lawTold(card, rows, "", "", context)
    case some(u): cited(card, rows, quoted(u.value.clause), context)
def cited(card: String, rows: Lists.List<World.LawRow>, object: String, context: Abi.Context) -> Activity<Card.Replied>:
  match world.viewField::<String>({object: {world: context.world, object: object}, field: "law"}):
    case viewed(v): lawTold(card, rows, "Under {object}'s law:\n{lawLines(lawRows(v.state))}", "Under {object}'s law:\n{readingLines(lawRows(v.state))}", context)
    case _: lawTold(card, rows, "", "", context)
def lawTold(card: String, rows: Lists.List<World.LawRow>, whole: String, readings: String, context: Abi.Context) -> Activity<Card.Replied>:
  let own = "LAW of {card}\n{lawLines(rows)}"
  let text = if textLength(own) + textLength(whole) <= Card.limit(context) then "{own}{whole}" else "{own}{readings}"
  Card.tell(Card.Replied.done({action: "laws"}), Document.text(if textLength(text) > Card.limit(context) then "{textTake(text, Card.limit(context) - 2n)}…\n" else text))
# The text between the first pair of double quotes (`under "kind/bell"` names kind/bell).
def quoted(clause: String) -> String:
  let after = textDrop(clause, textBreak(clause, "\"") + 1n)
  textTake(after, textBreak(after, "\""))
def lawLines(rows: Lists.List<World.LawRow>) -> String:
  if Lists.length(rows) == 0n then "  no law text: anyone's write by its spells, the creator's anything\n" else textJoin(Lists.map(rows, clause), "")
def clause(row: World.LawRow) -> String:
  if row.reading == "" then "  {row.name}\n    {row.clause}\n" else "  {row.name}: {row.reading}\n    {row.clause}\n"
def readingLines(rows: Lists.List<World.LawRow>) -> String:
  textJoin(Lists.map(rows, fn(r: World.LawRow) -> String: "  {r.name}: {r.reading}\n"), "")
# Law text as the grammar writes it, one `law NAME "reading": EXPR` a line, read into rows.
def lawRows(text: String) -> Lists.List<World.LawRow>:
  if Text.blank(text) then Lists.List.nil() else lawRowsAt(text, textBreak(text, "\n"))
def lawRowsAt(text: String, stop: Nat) -> Lists.List<World.LawRow>:
  let rest = lawRows(textDrop(text, stop + 1n))
  if Text.starts(Text.trim(textTake(text, stop)), "law ") then Lists.List.cons({head: lawRow(textDrop(Text.trim(textTake(text, stop)), 4n)), tail: rest}) else rest
def lawRow(body: String) -> World.LawRow:
  let name = textTake(body, textBreak(body, " :\""))
  let after = Text.trimStart(textDrop(body, textLength(name)))
  if Text.starts(after, "\"") then readRow(name, textDrop(after, 1n)) else {name: name, clause: Text.trimStart(textDrop(after, 1n)), reading: ""}
def readRow(name: String, after: String) -> World.LawRow:
  let close = textBreak(after, "\"")
  {name: name, clause: Text.trimStart(textDrop(Text.trimStart(textDrop(after, close + 1n)), 1n)), reading: textTake(after, close)}
# Only the owner shelves: a page keeps its place when shelved again.
# A page holds what one reply of it shows here (`Card.limit`): a page past it is refused, never cut.
def shelve(state: State, input: {name: String, kind: Kind, title: String, body: String}, context: Abi.Context) -> Activity<Card.Replied>:
  if context.principal != state.owner then refused({clause: "notOwner", reading: "Only {Card.shown(state.owner, state.ownerHandle, context)} shelves a page"}, context) else if textLength(input.body) > Card.limit(context) then refused({clause: "tooLong", reading: "A page here holds {natText(Card.limit(context))} characters, what one reply shows; this one is {natText(textLength(input.body))}"}, context) else shelved(extend(input, {place: placeOf(input.name, state)}))
def placeOf(name: String, state: State) -> Nat:
  match Relations.lookup(state.pages, {name: name}):
    case some(p): p.value.place
    case none(_): Lists.fold(Relations.rows(state.pages), 0n, fn(p: Page) -> Nat -> Nat: fn(most: Nat) -> Nat: if p.place + 1n > most then p.place + 1n else most)
def shelved(page: Page) -> Activity<Card.Replied>:
  let written(_) = write {pages: upsert page}
  Card.tell(Card.Replied.done({action: "shelve"}), Document.text("Shelved {page.name}.\n"))
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
def plural(n: Nat, word: String) -> String:
  if n == 1n then "one {word}" else "{Text.countWord(n)} {word}s"
def entryLine(page: Page) -> String:
  let padded = textTake(textConcat(page.name, "           "), 11n)
  "  {padded}{page.title}\n"
# The index: hob's line, the pages, the walks, the law spell. The head, the walks' header and the law
# line are counted first; the pages take what Card.limit(context) leaves of them (and of the walks'
# count, kept for it), the walks what the pages leave.
def render(state: State, context: Abi.Context) -> Document.Document:
  let pages = Lists.filter(heads(state), fn(p: Page) -> Bool: isWalk(p) == false)
  let walks = Lists.filter(heads(state), isWalk)
  let id = Card.called(context, "library")
  let counted = plural(Lists.length(pages), "page")
  let walked = plural(Lists.length(walks), "walk")
  let head = Document.text("hob: {counted}, {walked}; say which and I fetch it.\n\nPages: delvetalk {id} read / page: <name>\n")
  let walkHead = Document.text(if Lists.length(walks) == 0n then "" else "Walks, spells in order; each ends with something changed:\n")
  let law = Document.text("A card's law as the host has it: delvetalk {id} laws / card: bell/1\n")
  let fixed = Document.size(head) + Document.size(walkHead) + Document.size(law)
  let reserve = if Lists.length(walks) == 0n then 0n else textLength(Card.more(Lists.length(walks)))
  let shownPages = Card.clippedWithin(Lists.map(pages, entryDoc), 32n, Card.left(context, fixed + reserve))
  let shownWalks = Card.clippedWithin(Lists.map(walks, entryDoc), 32n, Card.left(context, fixed + Document.size(Document.Document.sequence({items: shownPages}))))
  Document.Document.sequence({items: Document.Documents.cons({head: head, tail: Document.Documents.cons({head: Document.Document.sequence({items: shownPages}), tail: Document.Documents.cons({head: walkHead, tail: Document.Documents.cons({head: Document.Document.sequence({items: shownWalks}), tail: Document.Documents.cons({head: law, tail: Document.Documents.nil()})})})})})})
def entryDoc(page: Page) -> Document.Document:
  Document.text(entryLine(page))
