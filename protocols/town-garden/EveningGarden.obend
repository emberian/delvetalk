edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Blooms.obend as Blooms
import ./Garden.obend as Garden
def describe() -> Garden.Description:
  Garden.describe()
def plant(state: Garden.State, input: {seed: String, colour: String}, context: Abi.Context) -> Garden.Decision:
  Garden.plant(state, input, context)
def rain(state: Garden.State, input: {id: Nat, line: String}, context: Abi.Context) -> Garden.Decision:
  Garden.rain(state, input, context)
def visit(state: Garden.State, input: {id: Nat}, context: Abi.Context) -> Garden.Decision:
  Garden.visit(state, input, context)
def page(state: Garden.State, input: {index: Nat}, context: Abi.Context) -> Garden.Decision:
  Garden.page(state, input, context)
def cutting(state: Garden.State, input: {id: Nat, colour: String}, context: Abi.Context) -> Garden.Decision:
  Garden.cutting(state, input, context)
def view(state: Garden.State, panel: String) -> Garden.View:
  extend(Garden.view(state, panel), {title: "The Night Garden · a sign made together"})
