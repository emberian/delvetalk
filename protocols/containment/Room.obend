edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Encounter.obend as E
import ./Relations.obend as R
record State:
  open: Bool
  capacity: Nat
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: R.Transfer
def admit(s: State, i: R.Transfer, c: Abi.Context) -> Decision:
  let allowed = R.follows(c, "habitat", "plan") && i.destination == c.object && i.actor == c.principal && s.open && i.occupancy < s.capacity
  {accepted: allowed, reason: if allowed then "" else "Room closed, full, or admission not planned here.", state: s, result: i}
record Method:
  label: String
  fields: {object: Abi.StringField, destination: Abi.StringField, previous: Abi.StringField, holder: Abi.StringField, occupancy: Abi.NatField, actor: Abi.StringField}
record Description:
  name: String
  initial: State
  methods: {admit: Method}
  panels: {}
def describe() -> Description:
  {name: "A room", initial: {open: true, capacity: 4n}, methods: {admit: {label: "Admit a planned arrival", fields: {object: R.textField(), destination: R.textField(), previous: R.textField(), holder: R.textField(), occupancy: R.natField(), actor: R.textField()}}}, panels: {}}
record View:
  title: String
  prose: String
  actions: {admit: R.Action}
  children: E.Children
def view(s: State, panel: String) -> View:
  {title: "A room", prose: if s.open then "There is room for company. Ask to enter or put something down." else "This room is resting. Come back after it opens.", actions: {admit: {visible: false, text: "Enter with a plan", command: "admit", input: {}}}, children: E.Children.nil()}
