edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Encounter.obend as E
# Possession of this portable source object never changes its own ability law.
record State:
  lit: Bool
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: String
def shine(state: State, input: {}, context: Abi.Context) -> Decision:
  {accepted: true, reason: "", state: {lit: true}, result: "The lamp shines."}
record Description:
  name: String
  initial: State
  methods: {shine: {label: String, fields: {}}}
  panels: {}
def describe() -> Description:
  {name: "A portable lamp", initial: {lit: false}, methods: {shine: {label: "Light the lamp", fields: {}}}, panels: {}}
record View:
  title: String
  prose: String
  actions: {shine: {visible: Bool, text: String, command: String, input: {}}}
  children: E.Children
def view(state: State, panel: String) -> View:
  {title: "A portable lamp", prose: if state.lit then "The lamp shines." else "A lamp waits to be lit.", actions: {shine: {visible: true, text: "Light the lamp", command: "shine", input: {}}}, children: E.Children.nil()}
