edition ObjectiveBend 1
import ./List.obend as Lists
import ./Abi.obend as Abi
import ./Encounter.obend as E
record Member:
  object: String
  owner: String
  holder: String
  place: String
  offer: String
  role: String
type Members = Lists.List<Member>
def member(object: String, owner: String, holder: String, place: String, offer: String, role: String) -> Member:
  {object: object, owner: owner, holder: holder, place: place, offer: offer, role: role}
def empty() -> Member:
  member("", "", "", "", "", "")
def get(xs: Members, object: String) -> Member:
  match xs:
    case nil(_): empty()
    case cons(c): if c.head.object == object then c.head else get(c.tail, object)
def body(xs: Members, principal: String) -> Member:
  match xs:
    case nil(_): empty()
    case cons(c): if c.head.role == "resident" && c.head.owner == principal then c.head else body(c.tail, principal)
def size(xs: Members) -> Nat:
  Lists.length::<Member>(xs)
def put(xs: Members, m: Member) -> Members:
  match xs:
    case nil(_): Members.cons({head: m, tail: Members.nil()})
    case cons(c): if c.head.object == m.object then Members.cons({head: m, tail: c.tail}) else Members.cons({head: c.head, tail: put(c.tail, m)})
def occupancy(xs: Members, place: String) -> Nat:
  Lists.fold::<Member, Nat>(xs, 0n, fn(m: Member) -> Nat -> Nat: fn(total: Nat) -> Nat: (if m.place == place && m.holder == "" && m.role != "room" then 1n else 0n) + total)
def located(xs: Members, m: Member) -> String:
  if m.holder == "" then m.place else body(xs, m.holder).place
def follows(ctx: Abi.Context, object: String, command: String) -> Bool:
  ctx.inputOrigin.kind == "invoke" && ctx.inputOrigin.object == object && ctx.inputOrigin.command == command && ctx.inputOrigin.immediatelyPrevious
record Transfer:
  object: String
  destination: String
  previous: String
  holder: String
  occupancy: Nat
  actor: String
def children(xs: Members) -> E.Children:
  Lists.map::<Member, E.Child>(xs, fn(m: Member) -> E.Child: {key: m.object, label: m.object, object: m.object, panel: "main"})
record Action:
  visible: Bool
  text: String
  command: String
  input: {}
def textField() -> Abi.StringField:
  {type: "string", minLength: 0n, maxLength: 128n}
def natField() -> Abi.NatField:
  {type: "nat", minimum: 0n, maximum: 9007199254740991n}

# The committed placement outcome is an ordinary typed source value. Its
# producer program is authenticated separately in the receiving context.
record Arrival:
  object: String
  destination: String
  actor: String
