edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Agreement.obend as Agreement
record BoolField:
  type: String
record LightField:
  type: String
  options: {dim: String, bright: String}
record OrderField:
  type: String
  options: {north: String, south: String}
record PieceMethod:
  label: String
  fields: {title: Abi.StringField, note: Abi.StringField, minutes: Abi.NatField, fragile: BoolField, light: LightField}
record ArrangeMethod:
  label: String
  fields: {caption: Abi.StringField, first: OrderField}
record EmptyMethod:
  label: String
  fields: {}
record Description:
  name: String
  initial: Agreement.State
  methods: {offerNorth: PieceMethod, offerSouth: PieceMethod, arrange: ArrangeMethod, consentNorth: EmptyMethod, consentSouth: EmptyMethod, open: EmptyMethod}
  panels: {north: String, south: String}
def pieceFields() -> {title: Abi.StringField, note: Abi.StringField, minutes: Abi.NatField, fragile: BoolField, light: LightField}:
  {title:{type:"string",minLength:1n,maxLength:120n},note:{type:"string",minLength:1n,maxLength:320n},minutes:{type:"nat",minimum:1n,maximum:30n},fragile:{type:"bool"},light:{type:"enum",options:{dim:"dim",bright:"bright"}}}
def initial(participants: Agreement.Participants) -> Agreement.State:
  Agreement.initial(participants)
def describe() -> Description:
  {name:"shared-exhibition-v2",initial:Agreement.initial({north:"north",south:"south",curator:"curator"}),methods:{offerNorth:{label:"Offer the north piece",fields:pieceFields()},offerSouth:{label:"Offer the south piece",fields:pieceFields()},arrange:{label:"Propose the exhibition arrangement",fields:{caption:{type:"string",minLength:1n,maxLength:400n},first:{type:"enum",options:{north:"north",south:"south"}}}},consentNorth:{label:"Approve this arrangement as north",fields:{}},consentSouth:{label:"Approve this arrangement as south",fields:{}},open:{label:"Open the exhibition",fields:{}}},panels:{north:"North artist’s note",south:"South artist’s note"}}
def offerNorth(state: Agreement.State, input: Agreement.Piece, context: Abi.Context) -> Agreement.Decision:
  Agreement.offered(state,input,context,true)
def offerSouth(state: Agreement.State, input: Agreement.Piece, context: Abi.Context) -> Agreement.Decision:
  Agreement.offered(state,input,context,false)
def arrange(state: Agreement.State, input: Agreement.Proposal, context: Abi.Context) -> Agreement.Decision:
  Agreement.arranged(state,input,context)
def consentNorth(state: Agreement.State, input: {}, context: Abi.Context) -> Agreement.Decision:
  Agreement.consented(state,context,true)
def consentSouth(state: Agreement.State, input: {}, context: Abi.Context) -> Agreement.Decision:
  Agreement.consented(state,context,false)
def open(state: Agreement.State, input: {}, context: Abi.Context) -> Agreement.Decision:
  Agreement.opened(state,context)
def view(state: Agreement.State, panel: String) -> Agreement.View:
  Agreement.view(state,panel)
