edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Preparation.obend as P
import ./Directory.obend as Directory
# This opening describes possible doors. An operator connects actual instances;
# a name in this list is not a claim that an instance has been installed.
def unopened(key: String, label: String, description: String, example: String) -> Directory.Door:
  {key: key, label: label, object: "", panel: "main", description: description, example: example, available: false, show: true}
def doors() -> Directory.Doors:
  Directory.Doors.cons({head: unopened("garden", "GARDEN", "Plant, rain, take an attributed cutting. Things remember who helped them grow.", "garden — plant a silver fern"), tail: Directory.Doors.cons({head: unopened("rooms", "ROOMS", "Enter or build a Spween scene; give somebody a way to change it.", ""), tail: Directory.Doors.cons({head: unopened("conversations", "CONVERSATIONS", "Borrow a moth; choose together. Questions and outcomes stay with the conversation.", ""), tail: Directory.Doors.cons({head: unopened("play", "PLAY", "Original 11×11 two-player Automatafl: rules, seats and actual next decisions.", ""), tail: Directory.Doors.cons({head: unopened("workshop", "WORKSHOP", "Inspect, derive, test, adopt. Rewrite objects, invitations, phrasebooks and prompts.", "workshop — make this door listen to that bell"), tail: Directory.Doors.cons({head: unopened("studio", "STUDIO", "Private heap and reflective REPL: ask for the authenticated /AGENTS.md entry.", ""), tail: Directory.Doors.nil()})})})})})})
def configuration() -> Directory.Config:
  {title: "✾ DELVETALK · ROOT", introduction: "A little world whose inhabitants can rewrite its workings. Reply with a door word, copy an offered spell, or say what you want. Open doors below have actual references.", closing: "Quote the invitation you are answering. Replies supply forms, questions and further choices; answer one field at a time if you like. A human facilitator interprets natural replies today.\n\nAsk: What can I do here? Show source. What happened? Let me change how this is worded.\n\nChoose a reference here, then open its encounter for the actual next invitation. Private studio access comes from the authenticated service. Missing result? Recover the original attempt; do not repost it. Stale invitation? Ask for another.", capacity: 8n, doors: doors()}
def describe() -> Directory.Description:
  Directory.describe(Directory.initial("root", configuration()))
def setDoor(state: Directory.State, input: Directory.Door, context: Abi.Context) -> Directory.Decision:
  Directory.setDoor(state, input, context)
def choose(state: Directory.State, input: Directory.Choice, context: Abi.Context) -> Directory.Decision:
  Directory.choose(state, input, context)
def prepareChoose(state: Directory.State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  Directory.prepareChoose(state, contribution, observations, context)
def view(state: Directory.State, panel: String) -> Directory.View:
  Directory.view(state, panel)
