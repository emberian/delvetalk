edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Preparation.obend as P
import ./Allocation.obend as A
import ./Encounter.obend as E
import ./Creation.obend as Creation
import ./SessionEntry.obend as Session
import ./Directory.obend as D
record Config:
  entry: P.Value
  doors: D.Doors
  welcome: String
record State:
  entry: P.Value
  doors: D.Doors
  welcome: String
  next: Nat
def initial(config: Config) -> State:
  {entry: config.entry, doors: config.doors, welcome: config.welcome, next: 1n}
def name(state: State) -> String:
  textConcat("session-", natText(state.next))
def identity(state: State, parent: String) -> String:
  textConcat(parent, textConcat("/", name(state)))
def pair(key: String, value: P.Value, tail: P.Fields) -> P.Fields:
  P.Fields.cons({head: {name: key, value: value}, tail: tail})
def text(value: String) -> P.Value:
  P.Value.text({value: value})
def replaced(fields: P.Fields, key: String, value: P.Value) -> P.Fields:
  match fields:
    case nil(_): pair(key, value, P.Fields.nil())
    case cons(c): if c.head.name == key then pair(key, value, c.tail) else pair(c.head.name, c.head.value, replaced(c.tail, key, value))
def withField(value: P.Value, key: String, replacement: P.Value) -> P.Value:
  match value:
    case record(r): P.Value.record({fields: replaced(r.fields, key, replacement)})
    case none(_): P.Value.none()
    case retained(_): P.Value.none()
    case boolean(_): P.Value.none()
    case natural(_): P.Value.none()
    case number(_): P.Value.none()
    case text(_): P.Value.none()
    case array(_): P.Value.none()
def items(value: P.Value) -> P.Values:
  match value:
    case array(a): a.values
    case none(_): P.Values.nil()
    case retained(_): P.Values.nil()
    case boolean(_): P.Values.nil()
    case natural(_): P.Values.nil()
    case number(_): P.Values.nil()
    case text(_): P.Values.nil()
    case record(_): P.Values.nil()
def wireText(value: String) -> P.Value:
  P.Value.record({fields: pair("tag", text("label"), pair("value", text(value), P.Fields.nil()))})
def wireField(key: String, value: P.Value) -> P.Value:
  P.Value.record({fields: pair("name", text(key), pair("value", value, P.Fields.nil()))})
def wireGet(fields: P.Values, key: String) -> P.Value:
  match fields:
    case nil(_): P.Value.none()
    case cons(c): if P.textEquals(P.get(c.head, "name"), key) then P.get(c.head, "value") else wireGet(c.tail, key)
def wireFields(fields: P.Values, key: String, replacement: P.Value) -> P.Values:
  match fields:
    case nil(_): P.Values.cons({head: wireField(key, replacement), tail: P.Values.nil()})
    case cons(c): if P.textEquals(P.get(c.head, "name"), key) then P.Values.cons({head: wireField(key, replacement), tail: c.tail}) else P.Values.cons({head: c.head, tail: wireFields(c.tail, key, replacement)})
def wireWith(record: P.Value, key: String, replacement: P.Value) -> P.Value:
  withField(record, "fields", P.Value.array({values: wireFields(items(P.get(record, "fields")), key, replacement)}))
def originWire(origin: Session.Origin) -> P.Value:
  P.Value.record({fields: pair("tag", text("record"), pair("fields", P.Value.array({values: P.Values.cons({head: wireField("author", wireText(origin.author)), tail: P.Values.cons({head: wireField("originUri", wireText(origin.originUri)), tail: P.Values.cons({head: wireField("originCid", wireText(origin.originCid)), tail: P.Values.nil()})})})}), P.Fields.nil()))})
def configured(program: P.Value, home: String, origin: Session.Origin) -> P.Value:
  let model = P.get(P.get(program, "initial"), "model")
  let directory = wireGet(items(P.get(model, "fields")), "directory")
  let updated = wireWith(wireWith(model, "directory", wireWith(directory, "home", wireText(home))), "origin", originWire(origin))
  withField(program, "initial", P.oneField("model", updated))
def people(person: String) -> P.Value:
  P.Value.array({values: P.Values.cons({head: text(person), tail: P.Values.nil()})})
def law(author: String, operator: String) -> P.Value:
  P.Value.record({fields: pair("profile", text("delvetalk-scoped-law"), pair("view", P.Value.record({fields: pair("main", text("public"), P.Fields.nil())}), pair("invoke", P.Value.record({fields: pair("choose", people(author), pair("setDoor", people(operator), pair("begin", people(operator), P.Fields.nil())))}), pair("reprogram", people(operator), pair("law", people(operator), P.Fields.nil())))))})
def valid(origin: Session.Origin) -> Bool:
  origin.author != "" && textLength(origin.author) <= 256n && origin.originUri != "" && textLength(origin.originUri) <= 1024n && origin.originCid != "" && textLength(origin.originCid) <= 128n
record Followup:
  enabled: Bool
  object: String
  offer: String
  fields: {did: String, proof: String}
record Result:
  session: String
  author: String
  originUri: String
  originCid: String
  followup: Followup
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Result
  allocations: A.Allocations
def make(state: State, input: Session.Origin, context: Abi.Context) -> Decision:
  let allowed = valid(input) && state.next <= 64n && D.validDoors(state.doors, 8n)
  let home = identity(state, context.object)
  {accepted: allowed, reason: if allowed then "" else "Supply the verified author and immutable original post URI/CID; this factory retains at most 64 sessions.", state: if allowed then extend(state, {next: state.next + 1n}) else state, result: {session: home, author: input.author, originUri: input.originUri, originCid: input.originCid, followup: {enabled: state.welcome != "", object: state.welcome, offer: "enroll", fields: {did: input.author, proof: input.originCid}}}, allocations: if allowed then A.Allocations.cons({head: {name: name(state), protocol: configured(state.entry, home, input), law: law(input.author, context.principal)}, tail: A.Allocations.nil()}) else A.Allocations.nil()}
record Fields:
  author: Abi.StringField
  originUri: Abi.StringField
  originCid: Abi.StringField
def field(max: Nat) -> Abi.StringField:
  {type: "string", minLength: 1n, maxLength: max}
def fields() -> Fields:
  {author: field(256n), originUri: field(1024n), originCid: field(128n)}
record Description:
  name: String
  initial: State
  methods: {make: {label: String, fields: Fields}}
  panels: {}
  allocation: {limit: Nat}
def describe() -> Description:
  {name: "Fresh DelveTalk sessions", initial: {entry: P.Value.none(), doors: D.Doors.nil(), welcome: "", next: 1n}, methods: {make: {label: "Open the verified post's session", fields: fields()}}, panels: {}, allocation: {limit: 64n}}
def doorInput(door: D.Door) -> P.Value:
  P.Value.record({fields: pair("key", text(door.key), pair("label", text(door.label), pair("object", text(door.object), pair("panel", text(door.panel), pair("description", text(door.description), pair("example", text(door.example), pair("available", P.Value.boolean({value: door.available}), pair("show", P.Value.boolean({value: door.show}), P.Fields.nil()))))))))})
def configureDoors(doors: D.Doors, home: String) -> P.Effects:
  match doors:
    case nil(_): P.Effects.nil()
    case cons(c): P.Effects.cons({head: P.Effect.invoke({object: home, command: "setDoor", input: doorInput(c.head)}), tail: configureDoors(c.tail, home)})
def targetsReady(requests: P.Requests, observations: P.Observations) -> Bool:
  match requests:
    case nil(_): true
    case cons(c): P.observed(observations, c.head.object) && targetsReady(c.tail, observations)
def targetReads(requests: P.Requests) -> P.Reads:
  match requests:
    case nil(_): P.Reads.nil()
    case cons(c): P.Reads.cons({head: P.Read.existing({object: c.head.object}), tail: targetReads(c.tail)})
def prepareOrigin(state: State, input: P.Value, origin: Session.Origin, observations: P.Observations, context: P.Context) -> P.Preparation:
  if D.validDoors(state.doors, 8n) == false then P.Preparation.refused({message: "Configure a bounded list of actual session doors."}) else if targetsReady(D.requests(state.doors), observations) == false then P.Preparation.refused({message: "Capture the configured open doors before opening this session."}) else if valid(origin) == false then P.Preparation.refused({message: "The operator must supply the verified author and original post URI/CID."}) else if state.next > 64n then P.Preparation.refused({message: "This session factory has reached its allocation bound."}) else P.Preparation.ready({summary: "Open a fresh directory session for this verified, retained post.", reads: P.Reads.cons({head: P.Read.existing({object: context.object}), tail: P.Reads.cons({head: P.Read.absent({object: identity(state, context.object)}), tail: targetReads(D.requests(state.doors))})}), calls: P.Effects.cons({head: P.Effect.invoke({object: context.object, command: "make", input: input}), tail: P.Effects.cons({head: P.Effect.invoke({object: identity(state, context.object), command: "begin", input: P.Value.record({fields: P.Fields.nil()})}), tail: configureDoors(state.doors, identity(state, context.object))})})})
def prepareCid(state: State, input: P.Value, author: String, uri: String, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.textField(input, "originCid"):
    case missing(_): P.Preparation.refused({message: "Supply the verified original post CID."})
    case wrongKind(_): P.Preparation.refused({message: "The original post CID must be text."})
    case found(cid): prepareOrigin(state, input, {author: author, originUri: uri, originCid: cid.value}, observations, context)
def prepareUri(state: State, input: P.Value, author: String, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.textField(input, "originUri"):
    case missing(_): P.Preparation.refused({message: "Supply the verified original post URI."})
    case wrongKind(_): P.Preparation.refused({message: "The original post URI must be text."})
    case found(uri): prepareCid(state, input, author, uri.value, observations, context)
def prepareMake(state: State, input: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.textField(input, "author"):
    case missing(_): P.Preparation.refused({message: "Supply the verified author."})
    case wrongKind(_): P.Preparation.refused({message: "The verified author must be text."})
    case found(author): prepareUri(state, input, author.value, observations, context)
record Invitation:
  visible: Bool
  text: String
  prepare: String
  fields: Fields
  observations: P.Requests
record View:
  title: String
  prose: String
  actions: {}
  children: E.Children
  invitations: {make: Invitation}
def view(state: State, panel: String) -> View:
  {title: "Fresh DelveTalk sessions", prose: "An authorized operator opens a session for a verified post. Public tags are discovery markers, not authority. Recover an uncertain result from the retained original attempt.", actions: {}, children: E.Children.nil(), invitations: {make: {visible: state.next <= 64n, text: "Open the verified post's session", prepare: "prepareMake", fields: fields(), observations: D.requests(state.doors)}}}
