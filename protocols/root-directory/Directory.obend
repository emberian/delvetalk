edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Preparation.obend as P
import ./Encounter.obend as E
import ./Document.obend as Document
record Door:
  key: String
  label: String
  object: String
  panel: String
  description: String
  example: String
  available: Bool
  show: Bool
sum Doors:
  nil: {}
  cons: {head: Door, tail: Doors}
record Config:
  title: String
  introduction: String
  closing: String
  capacity: Nat
  doors: Doors
record State:
  home: String
  config: Config
record Choice:
  door: String
  original: String
record Selected:
  door: String
  object: String
  panel: String
  original: String
  by: String
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Selected
def blank() -> Door:
  {key: "", label: "", object: "", panel: "main", description: "", example: "", available: false, show: false}
def count(doors: Doors) -> Nat:
  match doors:
    case nil(_): 0n
    case cons(c): 1n + count(c.tail)
def find(doors: Doors, key: String) -> Door:
  match doors:
    case nil(_): blank()
    case cons(c): if c.head.key == key then c.head else find(c.tail, key)
def enabled(door: Door) -> Bool:
  door.show && door.available && door.object != ""
def any(doors: Doors) -> Bool:
  match doors:
    case nil(_): false
    case cons(c): enabled(c.head) || any(c.tail)
def replace(doors: Doors, door: Door) -> Doors:
  match doors:
    case nil(_): Doors.cons({head: door, tail: Doors.nil()})
    case cons(c): if c.head.key == door.key then Doors.cons({head: door, tail: c.tail}) else Doors.cons({head: c.head, tail: replace(c.tail, door)})
def valid(door: Door) -> Bool:
  textLength(door.key) > 0n && textLength(door.key) <= 32n && textLength(door.label) > 0n && textLength(door.label) <= 96n && textLength(door.object) <= 128n && textLength(door.panel) > 0n && textLength(door.panel) <= 64n && textLength(door.description) <= 512n && textLength(door.example) <= 256n && (door.available == false || door.object != "")
def validDoors(doors: Doors, budget: Nat) -> Bool:
  match doors:
    case nil(_): true
    case cons(c): if budget == 0n then false else valid(c.head) && find(c.tail, c.head.key).key == "" && validDoors(c.tail, budget - 1n)
def initial(home: String, config: Config) -> State:
  if config.capacity == 0n || config.capacity > 8n || validDoors(config.doors, config.capacity) == false then {home: home, config: {title: "Directory needs configuration", introduction: "Supply up to eight distinct, bounded door descriptions.", closing: "", capacity: 8n, doors: Doors.nil()}} else {home: home, config: config}
def result(door: Door, original: String, author: String) -> Selected:
  {door: door.key, object: door.object, panel: door.panel, original: original, by: author}
def setDoor(state: State, input: Door, context: Abi.Context) -> Decision:
  let yes = valid(input) && (find(state.config.doors, input.key).key != "" || count(state.config.doors) < state.config.capacity)
  {accepted: yes, reason: if yes then "" else "Supply a bounded door with a unique key and room in this directory; an available door needs a target.", state: if yes then {home: context.object, config: extend(state.config, {doors: replace(state.config.doors, input)})} else state, result: result(input, "", context.principal)}
def choose(state: State, input: Choice, context: Abi.Context) -> Decision:
  let door = find(state.config.doors, input.door)
  let yes = enabled(door) && textLength(input.original) <= 512n
  {accepted: yes, reason: if yes then "" else "Choose a configured open door. A missing door cannot become a target just because it was named.", state: state, result: result(door, input.original, context.principal)}
def child(door: Door) -> E.Child:
  {key: door.key, label: door.label, object: door.object, panel: door.panel}
def childrenInto(doors: Doors, found: E.Children) -> E.Children:
  match doors:
    case nil(_): found
    case cons(c): childrenInto(c.tail, if enabled(c.head) then E.childrenOffer(found, child(c.head), 8n) else found)
def children(doors: Doors) -> E.Children:
  childrenInto(doors, E.Children.nil())
def hasObject(doors: Doors, object: String) -> Bool:
  match doors:
    case nil(_): false
    case cons(c): (enabled(c.head) && c.head.object == object) || hasObject(c.tail, object)
def requests(doors: Doors) -> P.Requests:
  match doors:
    case nil(_): P.Requests.nil()
    case cons(c): if enabled(c.head) && hasObject(c.tail, c.head.object) == false then P.Requests.cons({head: {object: c.head.object, inspectState: false, inspectLaw: false}, tail: requests(c.tail)}) else requests(c.tail)
def prepareChoose(state: State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  let key = P.text(P.get(contribution, "door"))
  let door = find(state.config.doors, key)
  let original = P.text(P.get(contribution, "original"))
  if key == "" then P.Preparation.question({message: "Which open door would you like to try? Keep your words in the original field; a facilitator can help choose.", needs: P.Names.cons({head: "door", tail: P.Names.nil()})}) else if enabled(door) == false then P.Preparation.refused({message: "That door is not open in this directory. Choose one of its actual references."}) else if textLength(original) > 512n then P.Preparation.refused({message: "Keep this first contribution within 512 characters."}) else if P.observation(observations, door.object).object != door.object then P.Preparation.refused({message: "Capture the configured door's current object before choosing it."}) else P.Preparation.ready({summary: textConcat("Choose ", textConcat(door.label, "; its own encounter offers the next contribution.")), reads: P.Reads.cons({head: P.Read.existing({object: door.object}), tail: P.Reads.nil()}), calls: P.Effects.cons({head: P.Effect.invoke({object: context.object, command: "choose", input: P.Value.record({fields: P.Fields.cons({head: {name: "door", value: P.Value.text({value: key})}, tail: P.Fields.cons({head: {name: "original", value: P.Value.text({value: original})}, tail: P.Fields.nil()})})})}), tail: P.Effects.nil()})})
def capture(state: State) -> Document.Capture:
  {object: state.home, revision: 1n, meaning: "choose-an-explicit-directory-reference", entry: "prepareChoose", token: "choose"}
# One bounded sequence per section. Keeping section boundaries avoids repeated
# traversal of a long constructed cons spine in the demand evaluator.
def doorDocument(door: Door) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text(textConcat(door.label, textConcat("\n", textConcat(door.description, "\n")))), tail: Document.Documents.cons({head: if enabled(door) then Document.Document.reference(child(door)) else Document.text("Not open in this directory yet."), tail: Document.Documents.cons({head: Document.text("\n"), tail: Document.Documents.cons({head: if door.example == "" then Document.empty() else Document.quote("You might say", Document.text(door.example)), tail: Document.Documents.cons({head: Document.text("\n\n"), tail: Document.Documents.nil()})})})})})})
def doorItems(doors: Doors) -> Document.Documents:
  match doors:
    case nil(_): Document.Documents.nil()
    case cons(c): if c.head.show == false then doorItems(c.tail) else Document.Documents.cons({head: doorDocument(c.head), tail: doorItems(c.tail)})
def document(state: State) -> Document.Document:
  Document.Document.sequence({items: Document.Documents.cons({head: Document.text(textConcat(state.config.title, textConcat("\n\n", textConcat(state.config.introduction, "\n\n")))), tail: Document.Documents.cons({head: Document.Document.sequence({items: doorItems(state.config.doors)}), tail: Document.Documents.cons({head: Document.text(textConcat("HOW TO CONTINUE\n", textConcat(state.config.closing, "\n"))), tail: Document.Documents.cons({head: if any(state.config.doors) then Document.Document.offer({label: "Choose a door and keep your own words", capture: capture(state)}) else Document.text("Ask the facilitator which doors can be connected here."), tail: Document.Documents.cons({head: Document.text("\n"), tail: Document.Documents.nil()})})})})})})
def reading(state: State) -> String:
  Document.plain(document(state))
record TextField:
  type: String
  minLength: Nat
  maxLength: Nat
record Description:
  name: String
  initial: State
  methods: {setDoor: {label: String, fields: {key: TextField, label: TextField, object: TextField, panel: TextField, description: TextField, example: TextField, available: {type: String}, show: {type: String}}}, choose: {label: String, fields: {door: TextField, original: TextField}}}
  panels: {}
def text(max: Nat) -> TextField:
  {type: "string", minLength: 0n, maxLength: max}
def describe(state: State) -> Description:
  {name: state.config.title, initial: state, methods: {setDoor: {label: "Configure a directory door", fields: {key: text(32n), label: text(96n), object: text(128n), panel: text(64n), description: text(512n), example: text(256n), available: {type: "bool"}, show: {type: "bool"}}}, choose: {label: "Choose an open door", fields: {door: text(32n), original: text(512n)}}}, panels: {}}
record Invitation:
  visible: Bool
  text: String
  prepare: String
  fields: {door: TextField, original: TextField}
  observations: P.Requests
record View:
  title: String
  prose: String
  actions: {}
  children: E.Children
  invitations: {choose: Invitation}
  document: Document.Document
def view(state: State, panel: String) -> View:
  let doc = document(state)
  {title: state.config.title, prose: Document.plain(doc), actions: {}, children: children(state.config.doors), invitations: {choose: {visible: any(state.config.doors), text: "Choose a door and keep your own words", prepare: "prepareChoose", fields: {door: text(32n), original: text(512n)}, observations: requests(state.config.doors)}}, document: doc}
