edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Preparation.obend as P
import ./Encounter.obend as E
import ./Document.obend as D
import ./Conversation.obend as C
import ./Interpretation.obend as I
import ./ConversationModel.obend as M
import ./Reflection.obend as R
import ./Writing.obend as W
record Input:
  source: String
  result: String
def missing(fields: P.Fields) -> P.Names:
  match P.textField(P.Value.record({fields: fields}), "thought"):
    case missing(_): P.Names.cons({head: "thought", tail: P.Names.nil()})
    case wrongKind(_): P.Names.cons({head: "thought", tail: P.Names.nil()})
    case found(t): if t.value == "" then P.Names.cons({head: "thought", tail: P.Names.nil()}) else P.Names.nil()
def accepts(fields: P.Fields) -> Bool:
  match fields:
    case nil(_): true
    case cons(c): c.head.name == "thought" && C.textBetween(c.head.value, 1n, 4096n) && accepts(c.tail)
def policy(state: C.State) -> C.Policy:
  {revision: state.interpreter.revision, capacity: 64n, window: 8n, accepts: fn(fields: P.Fields) -> Bool: accepts(fields), needs: fn(fields: P.Fields) -> P.Names: missing(fields)}
def initial() -> C.State:
  extend(C.initial("Your private notebook", {object: "notebook", revision: 2n, meaning: "keep-a-thought", entry: "prepareNote", token: "note"}, missing(P.Fields.nil())), {interpreter: initialPolicy()})
def record(state: C.State, input: Input, context: Abi.Context) -> C.Decision:
  C.recordSource(policy(state), state, "Bend", input.source, "submitted-source", input.result, context)
def note(state: C.State, input: {thought: String}, context: Abi.Context) -> C.Decision:
  let fields = P.Fields.cons({head: {name: "thought", value: P.Value.text({value: input.thought})}, tail: P.Fields.nil()})
  let kept = C.contribute(policy(state), state, C.literal(state, input.thought, fields), context)
  let next = extend(kept.state, {bindings: P.Fields.nil(), unresolved: missing(P.Fields.nil()), capture: extend(state.capture, {revision: state.capture.revision + 1n}), outcomes: C.Outcomes.cons({head: {actor: context.principal, status: "kept", content: D.text("Thought kept.")}, tail: state.outcomes})})
  if textLength(input.thought) == 0n then C.decided(state, false, "Write a thought first; a few words are enough.") else if textLength(input.thought) > 4096n then C.decided(state, false, "Keep this thought within 4096 characters.") else if kept.accepted then C.decided(next, true, "Thought kept.") else kept
def retain(state: C.State, input: C.Interpretation, context: Abi.Context) -> C.Decision:
  C.retain(policy(state), state, input, context)
def prepareNote(state: C.State, input: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  if C.ready(state) == false then P.Preparation.question({message: "What thought would you like to keep? A sentence or fragment is enough.", needs: state.unresolved}) else P.Preparation.ready({summary: "Keep this thought in your notebook", reads: P.Reads.nil(), calls: P.Effects.cons({head: P.Effect.invoke({object: context.object, command: "note", input: P.oneField("thought", P.field(state.bindings, "thought"))}), tail: P.Effects.nil()})})
record NoteFields:
  thought: Abi.StringField
def noteFields() -> NoteFields:
  {thought: {type: "string", minLength: 1n, maxLength: 4096n}}
record Description:
  name: String
  initial: C.State
  methods: {reviseInterpretation: {label: String, fields: I.EditFields}, note: {label: String, fields: NoteFields}, record: {label: String, fields: {source: Abi.StringField, result: Abi.StringField}}, retain: {label: String, fields: {}, inputCodec: String}}
  panels: {interpretation: String}
def describe() -> Description:
  {name: "Private notebook", initial: initial(), methods: {reviseInterpretation: {label: "Revise prompt and conventions", fields: I.editFields()}, note: {label: "Keep a thought", fields: noteFields()}, record: {label: "Retain source and its supplied result", fields: {source: {type: "string", minLength: 0n, maxLength: 65536n}, result: {type: "string", minLength: 0n, maxLength: 65536n}}}, retain: {label: "Continue an interpreted intention", fields: {}, inputCodec: "data"}}, panels: {interpretation: "Prompt and conventions"}}
record NoteAction:
  visible: Bool
  text: String
  command: String
  input: {}
  fields: NoteFields
record RevisionAction:
  visible: Bool
  text: String
  command: String
  input: {}
  fields: I.EditFields
record Invitation:
  visible: Bool
  text: String
  prepare: String
  fields: {}
  observations: P.Requests
record View:
  title: String
  prose: String
  actions: {note: NoteAction, reviseInterpretation: RevisionAction}
  children: E.Children
  invitations: {note: Invitation, inspectTemplates: W.InspectInvitation, reviseTemplates: W.ReviseInvitation}
  document: D.Document
  interpretation: {request: String, prepare: String, contributionCodec: String}
def document(state: C.State, after: Nat, limit: Nat) -> D.Document:
  D.concat(D.text("Keep a thought below. A sentence or fragment is enough. Open Prompt and conventions to inspect or revise this notebook’s source; check and adopt the variation at its source desk.\n"), C.render(policy(state), state, after, limit))
def view(state: C.State, panel: String) -> View:
  let writing = W.view(sourceWriting(state), "main")
  let doc = if panel == "interpretation" then D.concat(I.inspect(state.interpreter), D.concat(D.text("\nActual offered fields:\n"), D.text(M.schemaText(schema())))) else document(state, 0n, 8n)
  {title: "Your private notebook", prose: D.plain(doc), actions: {reviseInterpretation: {visible: panel == "interpretation", text: "Revise prompt and conventions", command: "reviseInterpretation", input: {}, fields: I.editFields()}, note: {visible: state.count < 64n, text: "Keep a thought", command: "note", input: {}, fields: noteFields()}}, children: E.Children.cons({head: {key: "source-variation", label: "Check and adopt template variations", object: "source-desk", panel: "main"}, tail: E.Children.nil()}), invitations: {inspectTemplates: extend(writing.invitations.inspect, {visible: panel == "interpretation", prepare: "prepareInspectTemplates"}), reviseTemplates: extend(writing.invitations.revise, {visible: panel == "interpretation", prepare: "prepareReviseTemplates"}), note: {visible: C.ready(state), text: "Keep this thought", prepare: "prepareNote", fields: {}, observations: P.Requests.nil()}}, document: doc, interpretation: {request: "interpretationRequest", prepare: "prepareInterpretation", contributionCodec: "data"}}
def schema() -> I.Schema:
  I.Schema.cons({head: I.textSchema("thought", 1n, 4096n), tail: I.Schema.nil()})
def initialPolicy() -> I.Policy:
  extend(I.defaultPolicy(), {revision: "notebook-policy-v2", vocabulary: "This notebook offers note: keep one thought. The sole field is thought, a sentence or fragment of up to 4096 characters. Preserve the participant's intended words; ask if the thought is missing. Keeping a note never executes code or acts on another object. For requested execution, explain that source variations are explicitly submitted, checked and adopted under current authority. Never invent an execution result or silently turn an action request into an accomplished action."})
def interpretationRequest(state: C.State, original: String, observations: P.Observations, context: P.Context) -> M.Request:
  M.interpretationRequest(state.interpreter, state, original, observations, schema(), C.interpretationContext(state))
def prepareInterpretation(state: C.State, input: M.Response, observations: P.Observations, context: P.Context) -> M.Preparation:
  M.prepareInterpretation(policy(state), state.interpreter, state, input, observations, context, schema())

def reviseInterpretation(state: C.State, input: I.PolicyEdit, context: Abi.Context) -> C.Decision:
  C.editInterpretation(state, input, missing(P.Fields.nil()), context)

def sourceWriting(state: C.State) -> W.State:
  W.initial({candidate: "source-desk", target: state.capture.object, syntax: "objective-bend-object"})
def prepareInspectTemplates(state: C.State, contribution: P.Value, observations: P.Observations, context: P.Context, definitions: R.Definitions) -> R.Inspection:
  W.prepareInspect(sourceWriting(state), contribution, observations, context, definitions)
def prepareReviseTemplates(state: C.State, contribution: P.Value, observations: P.Observations, context: P.Context, definitions: R.Definitions) -> P.Preparation:
  W.prepareRevise(sourceWriting(state), contribution, observations, context, definitions)
