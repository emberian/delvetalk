edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Preparation.obend as P
import ./Emissions.obend as E
record Peer:
  slot: Nat
  object: String
  program: String
  generation: Nat
sum Peers:
  nil: {}
  cons: {head: Peer, tail: Peers}
record Links:
  epoch: Nat
  inbound: Peers
  outbound: Peers
record Limits:
  capacity: Nat
  work: Nat
record Configure:
  side: String
  slot: Nat
  enabled: Bool
  object: String
  program: String
  generation: Nat
record Selection:
  side: String
  slot: Nat
  enabled: Bool
  object: String
  generation: Nat
def unselected() -> Selection:
  {side: "", slot: 0n, enabled: false, object: "", generation: 0n}
record Payload:
  topic: String
  units: Nat
  generation: Nat
record Page:
  items: Peers
  next: Nat
  count: Nat
  more: Bool
def initial() -> Links:
  {epoch: 0, inbound: Peers.nil(), outbound: Peers.nil()}
def length(xs: Peers) -> Nat:
  match xs:
    case nil(_): 0
    case cons(c): 1 + length(c.tail)
def within(xs: Peers, work: Nat) -> Bool:
  match xs:
    case nil(_): true
    case cons(c): if work == 0 then false else within(c.tail, work - 1)
def contains(xs: Peers, slot: Nat) -> Bool:
  match xs:
    case nil(_): false
    case cons(c): c.head.slot == slot || contains(c.tail, slot)
def unique(xs: Peers, input: Configure) -> Bool:
  match xs:
    case nil(_): true
    case cons(c): (c.head.slot == input.slot || c.head.object != input.object) && unique(c.tail, input)
def fits(xs: Peers, input: Configure, limits: Limits) -> Bool:
  if within(xs, limits.work) == false then false else input.enabled == false || contains(xs, input.slot) || (length(xs) < limits.capacity && length(xs) < limits.work)
def valid(links: Links, input: Configure, limits: Limits) -> Bool:
  input.generation > 0 && input.generation <= 65535 && input.slot > 0 && input.slot <= 65535 && input.object != "" && textLength(input.object) <= 128n && textLength(input.program) == 64n && (if input.side == "listen" then input.generation > links.epoch && fits(links.inbound, input, limits) && (input.enabled == false || unique(links.inbound, input)) else input.side == "send" && fits(links.outbound, input, limits))
def configured(input: Configure) -> Peer:
  {slot: input.slot, object: input.object, program: input.program, generation: input.generation}
def remove(xs: Peers, slot: Nat) -> Peers:
  match xs:
    case nil(_): xs
    case cons(c): if c.head.slot == slot then c.tail else Peers.cons({head: c.head, tail: remove(c.tail, slot)})
def insert(xs: Peers, peer: Peer) -> Peers:
  match xs:
    case nil(_): Peers.cons({head: peer, tail: xs})
    case cons(c): if peer.slot < c.head.slot then Peers.cons({head: peer, tail: xs}) else if peer.slot == c.head.slot then Peers.cons({head: peer, tail: c.tail}) else Peers.cons({head: c.head, tail: insert(c.tail, peer)})
def replace(xs: Peers, input: Configure) -> Peers:
  if input.enabled then insert(xs, configured(input)) else remove(xs, input.slot)
def update(links: Links, input: Configure) -> Links:
  {epoch: if input.side == "listen" then input.generation else links.epoch, inbound: if input.side == "listen" then replace(links.inbound, input) else links.inbound, outbound: if input.side == "send" then replace(links.outbound, input) else links.outbound}
def matches(peer: Peer, payload: Payload, event: E.CausalEvent) -> Bool:
  peer.object == event.source && peer.program == event.sourceProgram && peer.generation == payload.generation
def any(xs: Peers, payload: Payload, event: E.CausalEvent) -> Bool:
  match xs:
    case nil(_): false
    case cons(c): matches(c.head, payload, event) || any(c.tail, payload, event)
def allows(links: Links, payload: Payload, event: E.CausalEvent) -> Bool:
  any(links.inbound, payload, event)
def obsolete(links: Links, payload: Payload, event: E.CausalEvent) -> Bool:
  payload.generation > 65535 || (allows(links, payload, event) == false && payload.generation <= links.epoch)
def skip(xs: Peers, after: Nat) -> Peers:
  match xs:
    case nil(_): xs
    case cons(c): if c.head.slot > after then xs else skip(c.tail, after)
def nonempty(xs: Peers) -> Bool:
  match xs:
    case nil(_): false
    case cons(c): true
def take(xs: Peers, limit: Nat, after: Nat) -> Page:
  match xs:
    case nil(_): {items: xs, next: after, count: 0, more: false}
    case cons(c):
      let rest: Page = if limit == 0 then {items: Peers.nil(), next: after, count: 0, more: true} else take(c.tail, limit - 1, c.head.slot)
      if limit == 0 then rest else {items: Peers.cons({head: c.head, tail: rest.items}), next: rest.next, count: rest.count + 1, more: rest.more}
def page(links: Links, after: Nat, limit: Nat) -> Page:
  take(skip(links.outbound, after), limit, after)
def tail(xs: Peers) -> Peers:
  match xs:
    case nil(_): xs
    case cons(c): c.tail
def payload(topic: String, units: Nat, generation: Nat) -> P.Value:
  P.Value.record({fields: P.Fields.cons({head: {name: "topic", value: P.Value.text({value: topic})}, tail: P.Fields.cons({head: {name: "units", value: P.Value.natural({value: units})}, tail: P.Fields.cons({head: {name: "generation", value: P.Value.natural({value: generation})}, tail: P.Fields.nil()})})})})
def emit(items: Peers, topic: String, units: Nat) -> E.Emissions:
  match items:
    case nil(_): E.empty()
    case cons(c): E.Emissions.cons({head: {to: c.head.object, command: "receive", recipientProgram: c.head.program, payload: payload(topic, units, c.head.generation)}, tail: emit(c.tail, topic, units)})
def sending(links: Links) -> Bool:
  nonempty(links.outbound)
