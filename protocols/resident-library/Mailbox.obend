edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Emissions.obend as E
import ./Preparation.obend as P
import ./Encounter.obend as Encounter
import ./Consent.obend as Consent
record Note:
  topic: String
  units: Nat
  event: String
  source: String
  author: String
sum Notes:
  nil: {}
  cons: {head: Note, tail: Notes}
record Queue:
  size: Nat
  front: Notes
  rear: Notes
record State:
  pending: Consent.Selection
  links: Consent.Links
  notes: Queue
record Input:
  topic: String
  units: Nat
  after: Nat
  limit: Nat
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: String
record Effects:
  accepted: Bool
  reason: String
  state: State
  result: {next: Nat, count: Nat, more: Bool}
  emissions: E.Emissions
record Behavior:
  capacity: Nat
  maxUnits: Nat
  consent: Consent.Limits
  batch: Nat
  accepts: String -> Bool
  store: State -> Consent.Payload -> E.CausalEvent -> Decision
def reverse(xs: Notes, acc: Notes) -> Notes:
  match xs:
    case nil(_): acc
    case cons(c): reverse(c.tail, Notes.cons({head: c.head, tail: acc}))
def empty() -> Queue:
  {size: 0, front: Notes.nil(), rear: Notes.nil()}
def enqueue(queue: Queue, note: Note) -> Queue:
  if queue.size == 0 then {size: 1, front: Notes.cons({head: note, tail: Notes.nil()}), rear: Notes.nil()} else {size: queue.size + 1, front: queue.front, rear: Notes.cons({head: note, tail: queue.rear})}
def initial() -> State:
  {pending: Consent.unselected(), links: Consent.initial(), notes: empty()}
def decision(ok: Bool, state: State, reason: String, result: String) -> Decision:
  {accepted: ok, reason: if ok then "" else reason, state: state, result: result}
def store(behavior: Behavior, state: State, input: Consent.Payload, event: E.CausalEvent) -> Decision:
  if Consent.obsolete(state.links, input, event) then decision(true, state, "", "declined-consent") else if Consent.allows(state.links, input, event) == false then decision(false, state, "Consent is not yet granted.", "pending-consent") else if behavior.accepts(input.topic) == false || input.units == 0 || input.units > behavior.maxUnits then decision(true, state, "", "declined-notice") else if state.notes.size >= behavior.capacity then decision(false, state, "Mailbox is full; acknowledge a notice and retry.", "pending-capacity") else decision(true, {pending: state.pending, links: state.links, notes: enqueue(state.notes, {topic: input.topic, units: input.units, event: event.id, source: event.source, author: event.originatingPrincipal})}, "Mailbox is full; acknowledge a notice and retry.", "stored")
extension Inbox(self: Behavior, super: {}) -> Behavior:
  {capacity: 4, maxUnits: 8, consent: {capacity: 16, work: 64}, batch: 4, accepts: fn(topic: String) -> Bool: false, store: fn(state: State, input: Consent.Payload, event: E.CausalEvent) -> Decision: store(self, state, input, event)}
def configure(behavior: Behavior, state: State, input: Consent.Configure) -> Decision:
  if Consent.valid(state.links, input, behavior.consent) then decision(true, {pending: Consent.unselected(), links: Consent.update(state.links, input), notes: state.notes}, "", "configured") else decision(false, state, "Use a fresh consent epoch, unique incoming source and an available collection key.", "not-configured")
def selected(state: State, input: Consent.Selection) -> Decision:
  let valid = (input.side == "listen" || input.side == "send") && input.slot > 0n && input.slot <= 65535n && input.object != "" && textLength(input.object) <= 128n && input.generation > 0n && input.generation <= 65535n
  decision(valid, if valid then extend(state, {pending: input}) else state, "Choose a peer, consent side, collection key and fresh generation.", "selected")
def configureInput(behavior: Behavior, state: State, input: P.Value) -> Decision:
  let shaped = P.isText(P.get(input, "side")) && P.isNatural(P.get(input, "slot")) && P.isBoolean(P.get(input, "enabled")) && P.isText(P.get(input, "object")) && P.isText(P.get(input, "program")) && P.isNatural(P.get(input, "generation"))
  if shaped then configure(behavior, state, {side: P.textOrEmpty(P.get(input, "side")), slot: P.naturalOrZero(P.get(input, "slot")), enabled: P.booleanOrFalse(P.get(input, "enabled")), object: P.textOrEmpty(P.get(input, "object")), program: P.textOrEmpty(P.get(input, "program")), generation: P.naturalOrZero(P.get(input, "generation"))}) else decision(false, state, "Supply the complete source-prepared consent.", "not-configured")
def preparationInput(selection: Consent.Selection, program: String) -> P.Value:
  P.Value.record({fields: P.Fields.cons({head: {name: "side", value: P.Value.text({value: selection.side})}, tail: P.Fields.cons({head: {name: "slot", value: P.Value.natural({value: selection.slot})}, tail: P.Fields.cons({head: {name: "enabled", value: P.Value.boolean({value: selection.enabled})}, tail: P.Fields.cons({head: {name: "object", value: P.Value.text({value: selection.object})}, tail: P.Fields.cons({head: {name: "program", value: P.Value.text({value: program})}, tail: P.Fields.cons({head: {name: "generation", value: P.Value.natural({value: selection.generation})}, tail: P.Fields.nil()})})})})})})})
def prepareConfigure(behavior: Behavior, state: State, input: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.lookupObservation(observations, state.pending.object):
    case missing(_): P.Preparation.refused({message: "Capture the selected peer before confirming consent."})
    case found(found): prepareCapturedConfigure(behavior, state, found.value, context)
def prepareCapturedConfigure(behavior: Behavior, state: State, peer: P.Observation, context: P.Context) -> P.Preparation:
  let prepared = preparationInput(state.pending, peer.program)
  if state.pending.object == "" then P.Preparation.refused({message: "Choose a peer before capturing consent."}) else if peer.object != state.pending.object || textLength(peer.program) != 64n then P.Preparation.refused({message: "Capture the selected peer's current program."}) else if configureInput(behavior, state, prepared).accepted == false then P.Preparation.refused({message: "The selected consent is no longer admissible; choose a fresh generation or available key."}) else P.Preparation.ready({summary: textConcat("Confirm captured consent with ", state.pending.object), reads: P.Reads.cons({head: P.Read.existing({object: state.pending.object}), tail: P.Reads.nil()}), calls: P.Effects.cons({head: P.Effect.invoke({object: context.object, command: "configure", input: prepared}), tail: P.Effects.nil()})})
def pageLimit(behavior: Behavior) -> Nat:
  if behavior.batch > 16 then 16 else behavior.batch
def announce(behavior: Behavior, state: State, input: Input) -> Effects:
  let bounds: Bool = input.limit > 0 && input.limit <= pageLimit(behavior) && input.after <= 65535 && Consent.within(state.links.outbound, behavior.consent.work)
  let page: Consent.Page = if bounds then Consent.page(state.links, input.after, input.limit) else {items: Consent.Peers.nil(), next: input.after, count: 0, more: false}
  let ok: Bool = bounds && behavior.accepts(input.topic) && input.units > 0 && input.units <= behavior.maxUnits && page.count > 0
  {accepted: ok, reason: if ok then "" else "Choose an allowed topic, bounded units and a nonempty subscription page.", state: state, result: {next: page.next, count: page.count, more: page.more}, emissions: Consent.emit(page.items, input.topic, input.units)}
def advance(queue: Queue, tail: Notes) -> Queue:
  match tail:
    case nil(_): {size: queue.size - 1, front: reverse(queue.rear, Notes.nil()), rear: Notes.nil()}
    case cons(_): {size: queue.size - 1, front: tail, rear: queue.rear}
def acknowledge(state: State) -> Decision:
  match state.notes.front:
    case nil(_): decision(false, state, "Mailbox is empty.", "empty")
    case cons(c):
      let queue: Queue = advance(state.notes, c.tail)
      decision(true, {pending: state.pending, links: state.links, notes: queue}, "", c.head.topic)
def oldest(queue: Queue) -> String:
  match queue.front:
    case nil(_): "No notices are waiting."
    case cons(c): c.head.topic
record ConfigForm:
  label: String
  fields: {side: {type: String, options: {a: String, b: String}}, slot: Abi.NatField, enabled: {type: String}, object: Abi.StringField, generation: Abi.NatField}
record PostForm:
  label: String
  fields: {topic: Abi.StringField, units: Abi.NatField, after: Abi.NatField, limit: Abi.NatField}
record ReceiveForm:
  label: String
  fields: {topic: Abi.StringField, units: Abi.NatField, generation: Abi.NatField}
record Description:
  name: String
  initial: State
  methods: {configure: {label: String, fields: {}, inputCodec: String}, selectPeer: ConfigForm, announce: PostForm, receive: ReceiveForm, acknowledge: {label: String, fields: {}}}
  panels: {oldest: String}
def text(max: Nat) -> Abi.StringField:
  {type: "string", minLength: 1, maxLength: max}
def number(max: Nat) -> Abi.NatField:
  {type: "nat", minimum: 1, maximum: max}
def describe(name: String, behavior: Behavior) -> Description:
  {name: name, initial: initial(), methods: {configure: {label: "Confirm captured consent", fields: {}, inputCodec: "value"}, selectPeer: {label: "Choose a peer", fields: {side: {type: "enum", options: {a: "listen", b: "send"}}, slot: number(65535), enabled: {type: "bool"}, object: text(128), generation: number(65535)}}, announce: {label: "Announce to subscribers", fields: {topic: text(16), units: number(behavior.maxUnits), after: {type: "nat", minimum: 0, maximum: 65535}, limit: number(pageLimit(behavior))}}, receive: {label: "Receive an admitted notice", fields: {topic: text(16), units: number(behavior.maxUnits), generation: number(65535)}}, acknowledge: {label: "Acknowledge oldest notice", fields: {}}}, panels: {oldest: "Oldest notice"}}
record Action:
  visible: Bool
  text: String
  command: String
  input: {}
record View:
  title: String
  prose: String
  actions: {selectPeer: Action, announce: Action, acknowledge: Action}
  children: Encounter.Children
  invitations: {configure: {visible: Bool, text: String, prepare: String, fields: {}, observations: P.Requests}}
def action(command: String, visible: Bool, text: String) -> Action:
  {visible: visible, text: text, command: command, input: {}}
def view(state: State, panel: String, title: String, prose: String) -> View:
  {title: title, prose: if panel == "oldest" then oldest(state.notes) else prose, actions: {selectPeer: action("selectPeer", true, "Choose a peer"), announce: action("announce", Consent.sending(state.links), "Announce to subscribers"), acknowledge: action("acknowledge", state.notes.size > 0, "Acknowledge oldest notice")}, children: if state.pending.object == "" then Encounter.Children.nil() else Encounter.Children.cons({head: {key: "peer", label: "Selected peer", object: state.pending.object, panel: "main"}, tail: Encounter.Children.nil()}), invitations: {configure: {visible: state.pending.object != "", text: "Confirm consent with the captured peer", prepare: "prepareConfigure", fields: {}, observations: if state.pending.object == "" then P.Requests.nil() else P.Requests.cons({head: {object: state.pending.object, inspectState: false, inspectLaw: false}, tail: P.Requests.nil()})}}}
