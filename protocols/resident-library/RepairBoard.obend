edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Emissions.obend as E
import ./Preparation.obend as P
import ./Consent.obend as Consent
import ./Mailbox.obend as Mailbox
extension Repair(self: Mailbox.Behavior, super: Mailbox.Behavior) -> Mailbox.Behavior:
  extend(super, {capacity: super.capacity - 2, maxUnits: super.maxUnits - 4, accepts: fn(topic: String) -> Bool: topic == "help" || topic == "ready"})
def behavior() -> Mailbox.Behavior:
  fix(compose(Mailbox.Inbox, Repair), {})
def describe() -> Mailbox.Description:
  Mailbox.describe("Repair exchange", behavior())
def configure(state: Mailbox.State, input: P.Value, context: Abi.Context) -> Mailbox.Decision:
  Mailbox.configureInput(behavior(), state, input)
def selectPeer(state: Mailbox.State, input: Consent.Selection, context: Abi.Context) -> Mailbox.Decision:
  Mailbox.selected(state, input)
def prepareConfigure(state: Mailbox.State, input: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  Mailbox.prepareConfigure(behavior(), state, input, observations, context)
def announce(state: Mailbox.State, input: Mailbox.Input, context: Abi.Context) -> Mailbox.Effects:
  Mailbox.announce(behavior(), state, input)
def receive(state: Mailbox.State, input: Consent.Payload, context: Abi.Context, event: E.CausalEvent) -> Mailbox.Decision:
  behavior().store(state, input, event)
def acknowledge(state: Mailbox.State, input: {}, context: Abi.Context) -> Mailbox.Decision:
  Mailbox.acknowledge(state)
def view(state: Mailbox.State, panel: String) -> Mailbox.View:
  Mailbox.view(state, panel, "Repair exchange", "Offer help or report ready. Two notices fit on this shared workbench; acknowledge one when its work is understood.")
