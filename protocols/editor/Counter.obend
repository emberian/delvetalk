edition ObjectiveBend 1
record State:
  count: Nat
record Input:
  amount: Nat
record Origin:
  kind: String
  object: String
  command: String
  program: String
  immediatelyPrevious: Bool
record Context:
  object: String
  principal: String
  inputOrigin: Origin
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Nat
record Field:
  type: String
  minimum: Nat
  maximum: Nat
record Method:
  label: String
  fields: {amount: Field}
record Description:
  name: String
  initial: State
  methods: {add: Method}
  panels: {}
record Action:
  visible: Bool
  text: String
  command: String
  input: {}
record Child:
  key: String
  label: String
  object: String
  panel: String
sum Children:
  nil: {}
  cons: {head: Child, tail: Children}
record View:
  title: String
  prose: String
  actions: {add: Action}
  children: Children
def describe() -> Description:
  {name: "Shared counter", initial: {count: 0}, methods: {add: {label: "Add a note", fields: {amount: {type: "nat", minimum: 1, maximum: 10}}}}, panels: {}}
def add(state: State, input: Input, context: Context) -> Decision:
  {accepted: true, reason: "", state: {count: state.count + input.amount}, result: state.count + input.amount}
def view(state: State, panel: String) -> View:
  {title: "Shared counter", prose: "Each added note remains through deliberate revisions.", actions: {add: {visible: true, text: "Add a note", command: "add", input: {}}}, children: Children.nil()}
