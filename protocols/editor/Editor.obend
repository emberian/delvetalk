edition ObjectiveBend 1
import ./Preparation.obend as P
record Entry:
  name:String
  candidate:String
  adopted:Bool
sum Entries:
  nil:{}
  cons:{head:Entry,tail:Entries}
record State:
  target:String
  factory:String
  next:Nat
  g:Nat
  name:String
  candidate:String
  baseline:Nat
  phase:String
  code:String
  entries:Entries
record Origin:
  kind:String
  object:String
  command:String
  immediatelyPrevious:Bool
record Context:
  object:String
  principal:String
  inputOrigin:Origin
record Draft:
  name:String
record Witness:
  object:String
  version:Nat
record Plan:
  factory:String
  name:String
  editor:String
  generation:Nat
  target:String
  baselineVersion:Nat
record Report:
  candidate:String
  editor:String
  generation:Nat
  target:String
  baselineVersion:Nat
  status:String
  program:String
record Reprogrammed:
  object:String
  version:Nat
  program:String
record Approval:
  candidate:String
  editor:String
  generation:Nat
  target:String
record Decision:
  accepted:Bool
  reason:String
  state:State
  result:String
record PlanDecision:
  accepted:Bool
  reason:String
  state:State
  result:Plan
record ApprovalDecision:
  accepted:Bool
  reason:String
  state:State
  result:Approval
def append(xs:Entries,entry:Entry)->Entries:
  match xs:
    case nil(_):Entries.cons({head:entry,tail:Entries.nil()})
    case cons(c):Entries.cons({head:c.head,tail:append(c.tail,entry)})
def installed(xs:Entries,candidate:String)->Entries:
  match xs:
    case nil(_):Entries.nil()
    case cons(c):Entries.cons({head:{name:c.head.name,candidate:c.head.candidate,adopted:c.head.adopted||c.head.candidate==candidate},tail:installed(c.tail,candidate)})
def refused(state:State,reason:String)->Decision:
  {accepted:false,reason:reason,state:state,result:""}
def observed(state:State,input:Witness,context:Context)->Bool:
  context.inputOrigin.kind=="observe"&&context.inputOrigin.object==state.target&&context.inputOrigin.command==""&&context.inputOrigin.immediatelyPrevious&&input.object==state.target
def reported(state:State,input:Report,context:Context)->Bool:
  context.inputOrigin.kind=="invoke"&&context.inputOrigin.command=="report"&&context.inputOrigin.object==input.candidate&&context.inputOrigin.immediatelyPrevious&&input.candidate==candidate(state)&&input.editor==context.object&&input.generation==state.g&&input.target==state.target&&input.baselineVersion==state.baseline
def drafted(state:State,input:Draft)->State:
  extend(state,{g:state.next,next:state.next+1n,name:input.name,candidate:"",baseline:0n,phase:"draft",code:""})
def planned(state:State,input:Witness)->State:
  extend(state,{baseline:input.version,phase:"planned"})
def approving(state:State)->State:
  extend(state,{phase:"adopting"})
def finished(state:State)->State:
  extend(state,{phase:"adopted",entries:installed(state.entries,state.candidate)})
def activated(state:State,input:Report)->State:
  extend(state,{candidate:input.candidate,phase:"pending",entries:append(state.entries,{name:state.name,candidate:input.candidate,adopted:false})})
def reviewState(state:State,input:Report)->State:
  extend(state,{phase:input.status,code:input.program})
def draft(state:State,input:Draft,context:Context)->Decision:
  if state.target==""||input.name==""||state.next>32n then refused(state,"Name a new generation (maximum 32).") else {accepted:true,reason:"",state:drafted(state,input),result:"A fresh generation awaits its exact target baseline."}
def plan(state:State,input:Witness,context:Context)->PlanDecision:
  let accepted:Bool = state.phase=="draft"&&observed(state,input,context)
  {accepted:accepted,reason:if accepted then "" else "Observe the target first.",state:planned(state,input),result:{factory:state.factory,name:state.name,editor:context.object,generation:state.g,target:state.target,baselineVersion:input.version}}
def review(state:State,input:Report,context:Context)->Decision:
  if reported(state,input,context)==false||state.phase=="adopted" then refused(state,"Wrong generation report.") else if state.phase=="planned" then if input.status!="pending" then refused(state,"A new candidate must be pending.") else {accepted:true,reason:"",state:activated(state,input),result:"Generation retained."} else if input.candidate!=state.candidate||(input.status!="pending"&&input.status!="ready"&&input.status!="failed") then refused(state,"Not the current candidate.") else {accepted:true,reason:"",state:reviewState(state,input),result:input.status}
def approve(state:State,input:Witness,context:Context)->ApprovalDecision:
  let accepted:Bool = state.phase=="ready"&&observed(state,input,context)&&input.version==state.baseline
  {accepted:accepted,reason:if accepted then "" else "Target drifted or not ready. Rebase.",state:approving(state),result:{candidate:state.candidate,editor:context.object,generation:state.g,target:state.target}}
def finish(state:State,input:Reprogrammed,context:Context)->Decision:
  if state.phase!="adopting"||context.inputOrigin.kind!="reprogram"||context.inputOrigin.object!=state.target||context.inputOrigin.command!=""||context.inputOrigin.immediatelyPrevious==false||input.object!=state.target||input.version!=state.baseline+1n||input.program!=state.code then refused(state,"Expected the actual approved reprogram.") else {accepted:true,reason:"",state:finished(state),result:"Installed; earlier experiments remain."}
record Child:
  key:String
  label:String
  object:String
  panel:String
sum Children:
  nil:{}
  cons:{head:Child,tail:Children}
def children(xs:Entries)->Children:
  match xs:
    case nil(_):Children.nil()
    case cons(c):Children.cons({head:{key:c.head.candidate,label:if c.head.adopted then "Installed variation" else c.head.name,object:c.head.candidate,panel:"main"},tail:children(c.tail)})
record StringField:
  type:String
  minLength:Nat
  maxLength:Nat
record NatField:
  type:String
  minimum:Nat
  maximum:Nat
record DraftMethod:
  label:String
  fields:{name:StringField}
record WitnessMethod:
  label:String
  fields:{object:StringField,version:NatField}
record ReportMethod:
  label:String
  fields:{candidate:StringField,editor:StringField,generation:NatField,target:StringField,baselineVersion:NatField,status:StringField,program:StringField}
record FinishMethod:
  label:String
  fields:{object:StringField,version:NatField,program:StringField}
record Description:
  name:String
  initial:State
  methods:{draft:DraftMethod,plan:WitnessMethod,review:ReportMethod,approve:WitnessMethod,finish:FinishMethod}
  panels:{phase:String,candidate:String,target:String}
record Action:
  visible:Bool
  text:String
  command:String
  input:{}
record BaseView:
  title:String
  prose:String
  actions:{draft:Action}
  children:Children
def textField()->StringField:
  {type:"string",minLength:1n,maxLength:256n}
def nameField()->StringField:
  {type:"string",minLength:1n,maxLength:64n}
def numberField()->NatField:
  {type:"nat",minimum:0n,maximum:9007199254740991n}
def witnessMethod(label:String)->WitnessMethod:
  {label:label,fields:{object:textField(),version:numberField()}}
def reportMethod(label:String)->ReportMethod:
  {label:label,fields:{candidate:textField(),editor:textField(),generation:numberField(),target:textField(),baselineVersion:numberField(),status:textField(),program:textField()}}
def describe()->Description:
  {name:"Workshop",initial:{target:"",factory:"",next:1n,g:0n,name:"",candidate:"",baseline:0n,phase:"idle",code:"",entries:Entries.nil()},methods:{draft:{label:"New variation",fields:{name:nameField()}},plan:witnessMethod("Capture baseline"),review:reportMethod("Review candidate"),approve:witnessMethod("Approve baseline"),finish:{label:"Record installation",fields:{object:textField(),version:numberField(),program:textField()}}},panels:{phase:"Current generation",candidate:"Current candidate",target:"Edited object"}}
def baseView(state:State,panel:String)->BaseView:
  {title:"Workshop",prose:if panel=="phase" then state.phase else if panel=="candidate" then state.candidate else if panel=="target" then state.target else if state.phase=="ready" then "Checked. Compare with the captured target." else if state.phase=="failed" then "Failed. Retained for inspection. Try another variation." else if state.phase=="adopted" then "Installed. Make another variation." else "Make a variation,try examples,compare,then deliberately adopt.",actions:{draft:{visible:state.target!="",text:"New variation",command:"draft",input:{}}},children:children(state.entries)}

# Authored captured workflow offers
record Config:
  target: String
  factory: String
def initial(config: Config) -> State:
  extend(describe().initial, {target: config.target, factory: config.factory})
def names1(a: String) -> P.Names:
  P.Names.cons({head: a, tail: P.Names.nil()})
def names2(a: String, b: String) -> P.Names:
  P.Names.cons({head: a, tail: names1(b)})
def names3(a: String, b: String, c: String) -> P.Names:
  P.Names.cons({head: a, tail: names2(b, c)})
def read1(a: String) -> P.Reads:
  P.Reads.cons({head: P.Read.existing({object: a}), tail: P.Reads.nil()})
def read2(a: String, b: String) -> P.Reads:
  P.Reads.cons({head: P.Read.existing({object: a}), tail: read1(b)})
def effect1(a: P.Effect) -> P.Effects:
  P.Effects.cons({head: a, tail: P.Effects.nil()})
def effect2(a: P.Effect, b: P.Effect) -> P.Effects:
  P.Effects.cons({head: a, tail: effect1(b)})
def effect3(a: P.Effect, b: P.Effect, c: P.Effect) -> P.Effects:
  P.Effects.cons({head: a, tail: effect2(b, c)})
def effect4(a: P.Effect, b: P.Effect, c: P.Effect, d: P.Effect) -> P.Effects:
  P.Effects.cons({head: a, tail: effect3(b, c, d)})
def effect5(a: P.Effect, b: P.Effect, c: P.Effect, d: P.Effect, e: P.Effect) -> P.Effects:
  P.Effects.cons({head: a, tail: effect4(b, c, d, e)})
def candidate(state: State) -> String:
  if state.candidate == "" then textConcat(textConcat(state.factory, "/"), state.name) else state.candidate
def question(message: String, field: String) -> P.Preparation:
  P.Preparation.question({message: message, needs: names1(field)})
def refusal(message: String) -> P.Preparation:
  P.Preparation.refused({message: message})
def prepareMake(state: State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  let name: String = P.text(P.get(contribution, "name"))
  if state.target == "" || state.factory == "" then refusal("This workshop needs a target and a candidate factory.") else if state.next > 32n then refusal("This workshop has retained its 32 generations.") else if name == "" then question("What shall we call this variation?", "name") else if textLength(name) > 64n then refusal("Use a variation name of at most 64 characters.") else P.Preparation.ready({summary: "Make a new variation with the captured target baseline.", reads: P.Reads.cons({head: P.Read.absent({object: textConcat(textConcat(state.factory, "/"), name)}), tail: read2(state.target, state.factory)}), calls: effect4(P.Effect.invoke({object: context.object, command: "draft", input: P.oneField("name", P.Value.text({value: name}))}), P.Effect.observe({object: state.target}), P.Effect.invokeResult({object: context.object, command: "plan", result: 1n}), P.Effect.invokeResult({object: state.factory, command: "make", result: 2n}))})
def proposal(syntax: String, source: String, examples: String) -> P.Value:
  P.Value.record({fields: P.Fields.cons({head: {name: "syntax", value: P.Value.text({value: syntax})}, tail: P.Fields.cons({head: {name: "source", value: P.Value.text({value: source})}, tail: P.Fields.cons({head: {name: "scenarios", value: P.Value.text({value: examples})}, tail: P.Fields.nil()})})})})
def submission(state: State, target: P.Observation, input: P.Value, context: P.Context) -> P.Value:
  P.Value.record({fields: P.Fields.cons({head: {name: "proposal", value: proposal(P.text(P.get(input, "syntax")), P.text(P.get(input, "source")), P.text(P.get(input, "examples")))}, tail: P.Fields.cons({head: {name: "migration", value: target.state}, tail: P.Fields.cons({head: {name: "target", value: P.Value.text({value: state.target})}, tail: P.Fields.cons({head: {name: "editor", value: P.Value.text({value: context.object})}, tail: P.Fields.cons({head: {name: "generation", value: P.Value.natural({value: state.g})}, tail: P.Fields.cons({head: {name: "baselineVersion", value: P.Value.natural({value: state.baseline})}, tail: P.Fields.nil()})})})})})})})
def prepareSubmit(state: State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  let target: P.Observation = P.observation(observations, state.target)
  let syntax: String = P.text(P.get(contribution, "syntax"))
  if state.phase != "planned" then refusal("Make a fresh variation before submitting source.") else if target.object == "" then refusal("Capture the target before submitting source.") else if target.version != state.baseline then refusal("The target changed. Make a new variation to rebase.") else if syntax == "" then question("Which source language are you using?", "syntax") else if syntax != "objective-bend-spell@2" && syntax != "objective-bend-spell@3" then refusal("Choose ordinary or typed Objective Bend source.") else if P.text(P.get(contribution, "source")) == "" then question("What source shall this variation use?", "source") else if P.text(P.get(contribution, "examples")) == "" then question("Which examples should the compiler check?", "examples") else if textLength(P.text(P.get(contribution, "source"))) > 32768n then refusal("Keep this source within 32768 characters.") else if textLength(P.text(P.get(contribution, "examples"))) > 16384n then refusal("Keep these examples within 16384 characters.") else P.Preparation.ready({summary: "Submit this source and examples to the immutable candidate.", reads: read2(state.target, candidate(state)), calls: effect3(P.Effect.invoke({object: candidate(state), command: "submit", input: submission(state, target, contribution, context)}), P.Effect.invoke({object: candidate(state), command: "report", input: P.Value.record({fields: P.Fields.nil()})}), P.Effect.invokeResult({object: context.object, command: "review", result: 1n}))})
def prepareReview(state: State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  if state.candidate == "" then refusal("Submit a variation before reviewing it.") else if state.phase != "pending" && state.phase != "ready" && state.phase != "failed" then refusal("This variation is not awaiting review.") else P.Preparation.ready({summary: "Review the current generation's actual compiler report.", reads: read1(state.candidate), calls: effect2(P.Effect.invoke({object: state.candidate, command: "report", input: P.Value.record({fields: P.Fields.nil()})}), P.Effect.invokeResult({object: context.object, command: "review", result: 0n}))})
def prepareAdopt(state: State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  let target: P.Observation = P.observation(observations, state.target)
  if state.phase != "ready" then refusal("Review a checked variation before adopting it.") else if target.object == "" then refusal("Capture the target before adoption.") else if target.version != state.baseline then refusal("The target changed. Make a new variation to rebase.") else P.Preparation.ready({summary: "Adopt the checked variation under current authority and retain the actual reprogram evidence.", reads: read2(state.target, state.candidate), calls: effect5(P.Effect.observe({object: state.target}), P.Effect.invokeResult({object: context.object, command: "approve", result: 0n}), P.Effect.invokeResult({object: state.candidate, command: "adopt", result: 1n}), P.Effect.reprogramResult({object: state.target, result: 2n}), P.Effect.invokeResult({object: context.object, command: "finish", result: 3n}))})
record NameInvitation:
  visible: Bool
  text: String
  prepare: String
  fields: {name: StringField}
  observations: P.Requests
record SubmitInvitation:
  visible: Bool
  text: String
  prepare: String
  fields: {syntax: {type: String, options: {ordinary: String, typed: String}}, source: StringField, examples: StringField}
  observations: P.Requests
record Invitation:
  visible: Bool
  text: String
  prepare: String
  fields: {}
  observations: P.Requests
record View:
  title: String
  prose: String
  actions: {}
  children: Children
  invitations: {make: NameInvitation, submit: SubmitInvitation, review: Invitation, adopt: Invitation}
def view(state: State, panel: String) -> View:
  let prior: BaseView = baseView(state, panel)
  let configured: Bool = state.target != "" && state.factory != ""
  {title: prior.title, prose: prior.prose, actions: {}, children: prior.children, invitations: {make: {visible: configured && state.next <= 32n, text: "Make a new variation or rebase", prepare: "prepareMake", fields: {name: nameField()}, observations: if configured then requests2(state.target, state.factory) else P.Requests.nil()}, submit: {visible: state.phase == "planned", text: "Submit source and examples", prepare: "prepareSubmit", fields: {syntax: {type: "enum", options: {ordinary: "objective-bend-spell@2", typed: "objective-bend-spell@3"}}, source: {type: "string", minLength: 1n, maxLength: 32768n}, examples: {type: "string", minLength: 1n, maxLength: 16384n}}, observations: if configured then requests2(state.target, candidate(state)) else P.Requests.nil()}, review: {visible: state.phase == "pending" || state.phase == "ready" || state.phase == "failed", text: "Review the current candidate", prepare: "prepareReview", fields: {}, observations: if state.candidate != "" then requests1(state.candidate) else P.Requests.nil()}, adopt: {visible: state.phase == "ready", text: "Adopt this checked variation", prepare: "prepareAdopt", fields: {}, observations: if state.candidate != "" then requests2(state.target, state.candidate) else P.Requests.nil()}}}

def requests1(a: String) -> P.Requests:
  P.Requests.cons({head: {object: a, inspectState: false, inspectLaw: false}, tail: P.Requests.nil()})
def requests2(a: String, b: String) -> P.Requests:
  P.Requests.cons({head: {object: a, inspectState: false, inspectLaw: false}, tail: requests1(b)})
