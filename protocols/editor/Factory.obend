edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Encounter.obend as E
import ./Preparation.obend as P
import ./Allocation.obend as A

record State:
  compiler: String
  reporters: P.Value
  candidate: P.Value
  last: String
record Plan:
  factory: String
  name: String
  editor: String
  generation: Nat
  target: String
  baselineVersion: Nat
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Plan
  allocations: A.Allocations
def initial(config: P.Value) -> State:
  {compiler: P.text(P.get(config, "compiler")), reporters: P.get(config, "reporters"), candidate: P.get(config, "candidate"), last: ""}
def pair(name: String, value: P.Value, tail: P.Fields) -> P.Fields:
  P.Fields.cons({head: {name: name, value: value}, tail: tail})
def principal(who: String) -> P.Value:
  P.Value.array({values: P.Values.cons({head: P.Value.text({value: who}), tail: P.Values.nil()})})
# A review relationship is configured explicitly, separately from reporting.
# The ordinary maker-only authority remains the default for Editor candidates.
def withoutMaker(values: P.Values, maker: String) -> P.Values:
  match values:
    case nil(_): P.Values.nil()
    case cons(c): if P.text(c.head) == maker then withoutMaker(c.tail, maker) else P.Values.cons({head: c.head, tail: withoutMaker(c.tail, maker)})
def reviewersWithMaker(reviewers: P.Value, maker: String) -> P.Value:
  match reviewers:
    case array(r): P.Value.array({values: P.Values.cons({head: P.Value.text({value: maker}), tail: withoutMaker(r.values, maker)})})
    case none(_): principal(maker)
    case retained(_): reviewers
    case boolean(_): reviewers
    case natural(_): reviewers
    case number(_): reviewers
    case text(_): reviewers
    case record(_): reviewers
def members(value: P.Value) -> P.Values:
  match value:
    case array(r): r.values
    case none(_): P.Values.nil()
    case retained(_): P.Values.nil()
    case boolean(_): P.Values.nil()
    case natural(_): P.Values.nil()
    case number(_): P.Values.nil()
    case text(_): P.Values.nil()
    case record(_): P.Values.nil()
def mergedMembers(values: P.Values, into: P.Values) -> P.Values:
  match values:
    case nil(_): into
    case cons(c): P.Values.cons({head: c.head, tail: withoutMaker(mergedMembers(c.tail, into), P.text(c.head))})
def readingAuthority(state: State, maker: String, reviewers: P.Value) -> P.Value:
  let people: P.Values = mergedMembers(members(state.reporters), mergedMembers(members(reviewers), P.Values.nil()))
  P.Value.array({values: P.Values.cons({head: P.Value.text({value: maker}), tail: withoutMaker(P.Values.cons({head: P.Value.text({value: state.compiler}), tail: withoutMaker(people, state.compiler)}), maker)})})
def authority(state: State, maker: String) -> P.Value:
  authorityWithReviewers(state, maker, P.Value.none())
def authorityWithReviewers(state: State, maker: String, reviewers: P.Value) -> P.Value:
  let methods: P.Value = P.Value.record({fields: pair("submit", principal(maker), pair("adopt", reviewersWithMaker(reviewers, maker), pair("compiled", principal(state.compiler), pair("failed", principal(state.compiler), pair("report", state.reporters, P.Fields.nil())))))})
  let nobody: P.Value = P.Value.array({values: P.Values.nil()})
  P.Value.record({fields: pair("profile", P.Value.text({value: "delvetalk-scoped-law"}), pair("invoke", methods, pair("reprogram", nobody, pair("law", nobody, pair("read", readingAuthority(state, maker, reviewers), P.Fields.nil())))))})
def remembered(state: State, name: String) -> State:
  extend(state, {last: name})
def make(state: State, input: Plan, context: Abi.Context) -> Decision:
  let planned: Bool = context.inputOrigin.kind == "invoke" && context.inputOrigin.object == input.editor && context.inputOrigin.command == "plan" && context.inputOrigin.immediatelyPrevious && input.factory == context.object && input.editor != "" && input.target != "" && input.generation > 0n && state.compiler != ""
  {accepted: planned, reason: if planned then "" else "Use the actual immediately preceding editor plan.", state: if planned then remembered(state, input.name) else state, result: input, allocations: if planned then A.Allocations.cons({head: {name: input.name, protocol: state.candidate, law: authority(state, context.principal)}, tail: A.Allocations.nil()}) else A.Allocations.nil()}
record Method:
  label: String
  fields: {factory: Abi.StringField, name: Abi.StringField, editor: Abi.StringField, generation: Abi.NatField, target: Abi.StringField, baselineVersion: Abi.NatField}
record Description:
  name: String
  initial: State
  methods: {make: Method}
  panels: {main: String}
  allocation: {limit: Nat}
def textField() -> Abi.StringField:
  {type: "string", minLength: 1n, maxLength: 256n}
def numberField() -> Abi.NatField:
  {type: "nat", minimum: 0n, maximum: 9007199254740991n}
def describe() -> Description:
  {name: "Candidate workshop", initial: initial(P.Value.none()), methods: {make: {label: "Make the planned variation", fields: {factory: textField(), name: {type: "string", minLength: 1n, maxLength: 64n}, editor: textField(), generation: numberField(), target: textField(), baselineVersion: numberField()}}}, panels: {main: "Workshop"}, allocation: {limit: 32n}}
record View:
  title: String
  prose: String
  actions: {}
  children: E.Children
def view(state: State, panel: String) -> View:
  {title: "Candidate workshop", prose: "Each editor plan can make one fresh immutable candidate. Earlier experiments remain.", actions: {}, children: E.Children.nil()}
