edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Encounter.obend as E
import ./Preparation.obend as P
import ./RevisionReport.obend as RR
import ./Reflection.obend as R
import ./Document.obend as D

# The compiler reports data; this object owns submission and release policy.
record Config:
  editorMode: Bool
record State:
  editorMode: Bool
  status: String
  checkRequested: Bool
  checkGeneration: Nat
  checkRequester: String
  proposal: P.Value
  migration: P.Value
  target: String
  submitter: String
  artifact: String
  protocol: P.Value
  diagnostics: P.Value
  compiler: String
  roomArtifact: P.Value
  lastRelease: String
  editor: String
  generation: Nat
  baselineVersion: Nat
  program: String
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: P.Value
def initial(config: Config) -> State:
  {editorMode: config.editorMode, status: "empty", checkRequested: false, checkGeneration: 0n, checkRequester: "", proposal: P.Value.none(), migration: P.Value.none(), target: "", submitter: "", artifact: "", protocol: P.Value.none(), diagnostics: P.Value.array({values: P.Values.nil()}), compiler: "", roomArtifact: P.Value.none(), lastRelease: "", editor: "", generation: 0n, baselineVersion: 0n, program: ""}
def ordinary() -> State:
  initial({editorMode: false})
def isRecord(value: P.Value) -> Bool:
  match value:
    case record(_): true
    case retained(_): false
    case none(_): false
    case boolean(_): false
    case natural(_): false
    case number(_): false
    case text(_): false
    case array(_): false
def pair(name: String, value: P.Value, tail: P.Fields) -> P.Fields:
  P.Fields.cons({head: {name: name, value: value}, tail: tail})
def text(value: String) -> P.Value:
  P.Value.text({value: value})
def number(value: Nat) -> P.Value:
  P.Value.natural({value: value})
def refused(state: State, reason: String) -> Decision:
  {accepted: false, reason: reason, state: state, result: P.Value.none()}
def accepted(state: State, result: P.Value) -> Decision:
  {accepted: true, reason: "", state: state, result: result}
def submit(state: State, input: P.Value, context: Abi.Context) -> Decision:
  let editor: String = P.textOrEmpty(P.get(input, "editor"))
  let generation: Nat = P.naturalOrZero(P.get(input, "generation"))
  let target: String = P.textOrEmpty(P.get(input, "target"))
  if state.status != "empty" then refused(state, "This immutable candidate already has a submission.") else if isRecord(P.get(input, "proposal")) == false || isRecord(P.get(input, "migration")) == false || target == "" then refused(state, "Submit a proposal, complete migration and target.") else if state.editorMode && (editor == "" || generation == 0n) then refused(state, "Name the planned editor generation.") else if state.editorMode && P.isNatural(P.get(input, "baselineVersion")) == false then refused(state, "Supply the captured baseline version as a natural number, including zero.") else accepted(extend(state, {status: "pending", proposal: P.get(input, "proposal"), migration: P.get(input, "migration"), target: target, submitter: context.principal, editor: editor, generation: generation, baselineVersion: P.naturalOrZero(P.get(input, "baselineVersion"))}), text("submitted"))
# The inhabitant requests compiler work through this governed source method.
# Generation is durable source intent; exact native replay never increments it.
def requestCheck(state: State, input: {}, context: Abi.Context) -> Decision:
  if state.status != "pending" then refused(state, "Submit source and examples before requesting their check.") else if state.checkRequested then refused(state, "This compiler check is already requested.") else accepted(extend(state, {checkRequested: true, checkGeneration: state.checkGeneration + 1n, checkRequester: context.principal}), text("Compiler check requested."))
def compiled(state: State, input: P.Value, context: Abi.Context) -> Decision:
  let program: String = P.textOrEmpty(P.get(input, "program"))
  let artifact: String = P.textOrEmpty(P.get(input, "artifact"))
  if state.status != "pending" then refused(state, "Only a pending candidate accepts a compiler report.") else if isRecord(P.get(input, "protocol")) == false || program == "" || artifact == "" then refused(state, "A checked program and its retained artifact are required.") else accepted(extend(state, {status: "ready", checkRequested: false, artifact: artifact, protocol: P.get(input, "protocol"), program: program, diagnostics: P.Value.array({values: P.Values.nil()}), compiler: context.principal, roomArtifact: P.get(input, "roomArtifact")}), text("compiled"))
def failed(state: State, input: P.Value, context: Abi.Context) -> Decision:
  if state.status != "pending" then refused(state, "Only a pending candidate accepts a compiler report.") else accepted(extend(state, {status: "failed", checkRequested: false, artifact: P.textOrEmpty(P.get(input, "artifact")), diagnostics: P.get(input, "diagnostics"), compiler: context.principal}), text("failed"))
record ReportDecision:
  accepted: Bool
  reason: String
  state: State
  result: RR.Report
def report(state: State, input: {}, context: Abi.Context) -> ReportDecision:
  {accepted: true, reason: "", state: state, result: {candidate: context.object, editor: state.editor, generation: state.generation, target: state.target, baselineVersion: state.baselineVersion, status: state.status, program: state.program}}
def approved(state: State, input: RR.Approval, context: Abi.Context) -> Bool:
  context.inputOrigin.kind == "invoke" && context.inputOrigin.object == state.editor && context.inputOrigin.command == "approve" && context.inputOrigin.immediatelyPrevious && input.editor == state.editor && input.generation == state.generation && input.candidate == context.object
def released(state: State, context: Abi.Context) -> Decision:
  accepted(extend(state, {lastRelease: context.principal}), P.Value.record({fields: pair("protocol", state.protocol, pair("state", state.migration, P.Fields.nil()))}))
def adopt(state: State, input: RR.Target, context: Abi.Context) -> Decision:
  if state.status != "ready" then refused(state, "Check this candidate before adopting it.") else if input.target != state.target then refused(state, "This candidate names another target.") else if state.editorMode then refused(state, "Use the actual immediately preceding editor approval.") else released(state, context)
def adoptApproved(state: State, input: RR.Approval, context: Abi.Context) -> Decision:
  if state.status != "ready" then refused(state, "Check this candidate before adopting it.") else if input.target != state.target then refused(state, "This candidate names another target.") else if state.editorMode == false || approved(state, input, context) == false then refused(state, "Use the actual immediately preceding editor approval.") else released(state, context)
record OpenMethod:
  label: String
  fields: {}
  inputCodec: String
  resultCodec: String
record TypedReportMethod:
  label: String
  fields: {}
record ReportMethod:
  label: String
  fields: {}
  resultCodec: String
record DirectAdoptMethod:
  label: String
  fields: {target: Abi.StringField}
  resultCodec: String
record ApprovedAdoptMethod:
  label: String
  fields: {}
  inputCodec: String
  resultCodec: String
record Description:
  name: String
  initial: State
  methods: {requestCheck: ReportMethod, submit: OpenMethod, compiled: OpenMethod, failed: OpenMethod, report: TypedReportMethod, adopt: DirectAdoptMethod, adoptApproved: ApprovedAdoptMethod}
  panels: {status: String}
def method(label: String) -> OpenMethod:
  {label: label, fields: {}, inputCodec: "value", resultCodec: "value"}
def describe() -> Description:
  {name: "Candidate", initial: initial({editorMode: true}), methods: {requestCheck: {label: "Check source and examples", fields: {}, resultCodec: "value"}, submit: method("Submit source and examples"), compiled: method("Retain a checked compiler result"), failed: method("Retain compiler diagnostics"), report: {label: "Report this candidate", fields: {}}, adopt: {label: "Release this checked candidate", fields: {target: {type: "string", minLength: 1n, maxLength: 512n}}, resultCodec: "value"}, adoptApproved: {label: "Release the editor-approved candidate", fields: {}, inputCodec: "data", resultCodec: "value"}}, panels: {status: "Compiler report"}}
# An empty release form cannot carry hidden operational inputs.
def emptyContribution(value: P.Value) -> Bool:
  match value:
    case record(r):
      match r.fields:
        case nil(_): true
        case cons(_): false
    case retained(_): false
    case none(_): false
    case boolean(_): false
    case natural(_): false
    case number(_): false
    case text(_): false
    case array(_): false
def firstDiagnostic(values: P.Values) -> String:
  match values:
    case nil(_): ""
    case cons(c): P.textOrEmpty(P.get(c.head, "message"))
def diagnostic(value: P.Value) -> String:
  match value:
    case array(a): firstDiagnostic(a.values)
    case retained(_): ""
    case record(_): ""
    case none(_): ""
    case boolean(_): ""
    case natural(_): ""
    case number(_): ""
    case text(t): t.value
def failureSummary(state: State) -> String:
  let message: String = diagnostic(state.diagnostics)
  if message == "" || textLength(message) > 1024n then "Compilation or examples refused; inspect this variation's retained report for details." else textConcat("Compilation or examples refused: ", message)
# The physical compiler consumes this source-authored request. It supplies only
# native compilation/example execution and exact report custody, never readiness
# policy or adoption. Ordinary source preparation's four-argument ABI is enough.
def prepareInspectProposal(state: State, contribution: P.Value, observations: P.Observations, context: P.Context) -> R.Inspection:
  R.Inspection.inspection({message: "Inspect this retained proposal and the examples requested of its compiler.", value: P.Value.record({fields: pair("object", text(context.object), pair("status", text(state.status), pair("target", text(state.target), P.Fields.nil())))}), document: R.proposalDocument(state.proposal)})
def prepareCompilerWork(state: State, contribution: P.Value, observations: P.Observations, context: P.Context) -> R.Inspection:
  let requested: Bool = state.status == "pending" && state.checkRequested
  let request: P.Value = P.Value.record({fields: pair("format", text("delvetalk-compiler-request-v1"), pair("object", text(context.object), pair("intent", text(textConcat(textConcat("source-compile:", context.object), textConcat(":", natText(state.checkGeneration)))), pair("proposal", state.proposal, pair("migration", state.migration, pair("target", text(state.target), pair("reports", P.Value.record({fields: pair("passed", text("compiled"), pair("failed", text("failed"), P.Fields.nil()))}), P.Fields.nil())))))))})
  R.Inspection.inspection({message: if requested then "Check this retained source and its examples." else "No compiler check is requested.", value: if requested then request else P.Value.none(), document: D.text(if requested then "The compiler will report against this exact requested revision." else "Request a check from this candidate first.")})
# Ordinary release is a source-authored atomic turn over its captured target.
def prepareRelease(state: State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.lookupObservation(observations, state.target):
    case missing(_): P.Preparation.refused({message: "Capture this candidate's target before releasing it."})
    case found(t): prepareCapturedRelease(state, contribution, t.value, context)
def prepareCapturedRelease(state: State, contribution: P.Value, target: P.Observation, context: P.Context) -> P.Preparation:
  if emptyContribution(contribution) == false then P.Preparation.refused({message: "Release takes no additional fields."}) else if state.editorMode then P.Preparation.refused({message: "Use this candidate's editor approval."}) else if state.status != "ready" || state.program == "" || state.artifact == "" then P.Preparation.refused({message: "Check this candidate before releasing it."}) else if state.target == "" || target.object != state.target then P.Preparation.refused({message: "Capture this candidate's target before releasing it."}) else P.Preparation.ready({summary: "Release the checked variation and install its complete proposed state under current law.", reads: P.Reads.cons({head: P.Read.existing({object: context.object}), tail: P.Reads.cons({head: P.Read.existing({object: state.target}), tail: P.Reads.nil()})}), calls: P.Effects.cons({head: P.Effect.invoke({object: context.object, command: "adopt", input: P.oneField("target", text(state.target))}), tail: P.Effects.cons({head: P.Effect.reprogramResult({object: state.target, result: 0n}), tail: P.Effects.nil()})})})
record ReleaseInvitation:
  visible: Bool
  text: String
  prepare: String
  fields: {}
  observations: P.Requests
record View:
  title: String
  prose: String
  actions: {check: {visible: Bool, text: String, command: String, input: {}}}
  children: E.Children
  invitations: {inspect: ReleaseInvitation, compile: ReleaseInvitation, release: ReleaseInvitation}
def view(state: State, panel: String) -> View:
  {title: "Candidate", prose: if state.status == "empty" then "A fresh variation awaits source and examples." else if state.status == "pending" then "Source retained; awaiting its compiler report." else if state.status == "ready" then if state.editorMode then "Checked and ready for its editor's approval." else "Checked and ready for adoption under current law." else failureSummary(state), actions: {check: {visible: state.status == "pending" && state.checkRequested == false, text: "Check source and examples", command: "requestCheck", input: {}}}, children: if state.target == "" then E.Children.nil() else E.Children.cons({head: {key: "target", label: "Target of this variation", object: state.target, panel: "main"}, tail: E.Children.nil()}), invitations: {inspect: {visible: state.status != "empty", text: "Inspect this source and its examples", prepare: "prepareInspectProposal", fields: {}, observations: P.Requests.nil()}, compile: {visible: state.status == "pending" && state.checkRequested, text: "Requested compiler work", prepare: "prepareCompilerWork", fields: {}, observations: P.Requests.nil()}, release: {visible: state.editorMode == false && state.status == "ready" && state.target != "", text: "Release this checked variation", prepare: "prepareRelease", fields: {}, observations: if state.target == "" then P.Requests.nil() else P.Requests.cons({head: {object: state.target, inspectState: false, inspectLaw: false}, tail: P.Requests.nil()})}}}
