edition ObjectiveBend 1
import ./BaseRuntime.obend as Base
import ./SceneData.obend as D
import ./SceneModel.obend as M
def lantern(view: M.View) -> M.View:
  {title: "The Moth Workshop by Lanternlight", prose: view.prose, actions: view.actions, children: view.children}
extension Lantern(self: M.Behavior, super: M.Behavior) -> M.Behavior:
  extend(super, {view: fn(scene: D.Scene, state: M.State, panel: String) -> M.View: lantern(super.view(scene, state, panel))})
def behavior() -> M.Behavior:
  fix(compose(Base.Default, Lantern), {})
