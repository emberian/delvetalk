edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Encounter.obend as E
import ./SceneModel.obend as M
import ./Handler.obend as H
import ./DefaultScene.obend as DefaultScene

def describe() -> M.Description:
  extend(DefaultScene.describe(), {name: "Unwritten Moth Workshop"})
def initial(config: M.State) -> M.State:
  config
def start(state: M.State, input: {}, context: Abi.Context) -> M.Decision:
  {accepted: false, reason: "Write a scene and handlers before starting this workshop.", state: state, result: {passage: state.passage, ended: state.ended}, emissions: H.begin(state.handler).emissions}
def choose(state: M.State, input: M.Choice, context: Abi.Context) -> M.Decision:
  start(state, {}, context)
def requirements(state: M.State) -> Bool:
  DefaultScene.requirements(state)
def view(state: M.State, panel: String) -> M.View:
  {title: "Unwritten Moth Workshop", prose: "Make a candidate and writing card, supply source and examples, then adopt a checked scene.", actions: M.Actions.nil(), children: E.Children.nil()}
