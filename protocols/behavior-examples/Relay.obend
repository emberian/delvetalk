edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Encounter.obend as E
record Input:
  amount: Nat
record State:
  total: Nat
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Input
record CountDecision:
  accepted: Bool
  reason: String
  state: State
  result: Nat
record Method:
  label: String
  fields: {amount: Abi.NatField}
record CountMethod:
  label: String
  fields: {}
record Description:
  name: String
  initial: State
  methods: {relay: Method, count: CountMethod}
  panels: {}
def describe() -> Description:
  {name: "A hand to hand relay", initial: {total: 0}, methods: {relay: {label: "Pass a small measure onward", fields: {amount: {type: "nat", minimum: 1, maximum: 5}}}, count: {label: "Read this hand's total", fields: {}}}, panels: {}}
def relay(state: State, input: Input, context: Abi.Context) -> Decision:
  if input.amount == 0 || state.total + input.amount > 5 then {accepted: false, reason: "This hand can hold five measures.", state: state, result: input} else {accepted: true, reason: "", state: {total: state.total + input.amount}, result: input}
def count(state: State, input: {}, context: Abi.Context) -> CountDecision:
  {accepted: true, reason: "", state: state, result: state.total}
record Action:
  visible: Bool
  text: String
  command: String
  input: {}
record View:
  title: String
  prose: String
  actions: {relay: Action, count: Action}
  children: E.Children
def view(state: State, panel: String) -> View:
  {title: "A hand to hand relay", prose: textConcat("This hand holds ", textConcat(natText(state.total), " measures. Pass a checked measure to another hand; a full receiver refuses the whole passage.")), actions: {relay: {visible: state.total < 5, text: "Pass a small measure onward", command: "relay", input: {}}, count: {visible: true, text: "Read this hand's total", command: "count", input: {}}}, children: E.Children.nil()}
