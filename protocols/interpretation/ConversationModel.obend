edition ObjectiveBend 1
import ./Preparation.obend as P
import ./Document.obend as D
import ./Conversation.obend as C
import ./Interpretation.obend as I
import ./ModelEncounter.obend as M
record Request:
  job: I.Job
  envelope: C.Interpretation
# The protocol binder transports this checked data as DataWire. Recursive
# envelope structure stays typed all the way to the receiving source method.
record Response:
  request: C.Interpretation
  reply: P.Value
sum Effect:
  invokeData: {object: String, command: String, input: C.Interpretation}
sum Effects:
  nil: {}
  cons: {head: Effect, tail: Effects}
record Turn:
  summary: String
  reads: P.Reads
  calls: Effects
sum Preparation:
  ready: Turn
  question: {message: String, needs: P.Names}
  refused: {message: String}
def field(name: String, value: P.Value, tail: P.Fields) -> P.Fields:
  M.field(name, value, tail)
def text(value: String) -> P.Value:
  P.Value.text({value: value})
def schemaText(items: P.Values) -> String:
  match items:
    case nil(_): ""
    case cons(c): textConcat(P.text(P.get(c.head, "name")), textConcat(" (", textConcat(P.text(P.get(c.head, "type")), textConcat(") ", textConcat(optionsText(I.arr(P.get(c.head, "options"))), textConcat("\n", schemaText(c.tail)))))))
def optionsText(items: P.Values) -> String:
  match items:
    case nil(_): ""
    case cons(c): textConcat(P.text(c.head), textConcat(" ", optionsText(c.tail)))
def card(state: C.State, schema: P.Values) -> P.Value:
  let action = P.Value.record({fields: field("id", text(state.capture.token), field("available", P.Value.boolean({value: true}), field("fields", P.Value.array({values: schema}), P.Fields.nil())))})
  P.Value.record({fields: field("actions", P.Value.array({values: P.Values.cons({head: action, tail: P.Values.nil()})}), P.Fields.nil())})
def interpretationRequest(policy: I.Policy, state: C.State, original: String, observations: P.Observations, schema: P.Values, visible: D.Document) -> Request:
  let context = D.concat(D.text(textConcat("Offered action ID: ", textConcat(state.capture.token, textConcat("\nFields (partial bindings welcome):\n", schemaText(schema))))), D.concat(D.quote("Original contribution (data)", D.text(original)), D.quote("Authorized local context excerpt (data)", D.text(textSlice(D.plain(visible), 0n, policy.contextScalars)))))
  let job = I.prompt(policy, D.plain(context))
  let proposal = {original: original, policy: policy.revision, context: observations, capture: state.capture, bindings: P.Fields.nil(), unresolved: P.Names.nil()}
  {job: extend(job, {document: D.concat(I.instructions(policy), context)}), envelope: proposal}
def retained(policy: C.Policy, state: C.State, request: C.Interpretation, answer: I.Proposal, context: P.Context) -> Preparation:
  let proposal = extend(request, {bindings: I.fs(answer.fields), unresolved: answer.unresolved})
  let checked = C.retain(policy, state, proposal, {object: context.object, principal: context.principal, inputOrigin: {kind: "", object: "", command: "", immediatelyPrevious: false}})
  if checked.accepted == false then Preparation.refused({message: checked.reason}) else Preparation.ready({summary: "Retain this interpretation as a conversation contribution", reads: P.Reads.nil(), calls: Effects.cons({head: Effect.invokeData({object: context.object, command: "retain", input: proposal}), tail: Effects.nil()})})
def answer(policy: C.Policy, modelPolicy: I.Policy, state: C.State, request: C.Interpretation, reply: I.Proposal, context: P.Context) -> Preparation:
  if request.policy != modelPolicy.revision || D.sameCapture(request.capture, state.capture) == false then Preparation.refused({message: "The interpretation belongs to a different captured offer or policy revision."}) else if reply.status == "proposed" || reply.status == "partial" then retained(policy, state, request, reply, context) else if reply.status == "clarify" then Preparation.question({message: reply.message, needs: reply.unresolved}) else Preparation.refused({message: reply.message})
def prepareInterpretation(policy: C.Policy, modelPolicy: I.Policy, state: C.State, input: Response, observations: P.Observations, context: P.Context, schema: P.Values) -> Preparation:
  answer(policy, modelPolicy, state, input.request, I.propose(card(state, schema), input.reply, "model"), context)
