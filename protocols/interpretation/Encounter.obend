edition ObjectiveBend 1
import ./Preparation.obend as P
import ./Document.obend as D
import ./Conversation.obend as C
import ./Interpretation.obend as I
# Instructions and quoted data remain distinct document nodes. The actual
# authorized observations are supplied explicitly, never fetched by rendering.
def documentPrompt(policy: I.Policy, original: String, context: D.Document) -> D.Document:
  D.concat(D.text(policy.instructions), D.concat(D.text(textConcat("\nVocabulary: ", policy.vocabulary)), D.concat(D.text(textConcat("\nExamples: ", policy.examples)), D.concat(D.text(textConcat("\nEscalation: ", policy.escalation)), D.concat(D.quote("Original contribution (data)", D.text(original)), D.quote("Selected authorized context (data)", context))))))
def proposal(original: String, policy: I.Policy, context: P.Observations, capture: D.Capture, answer: I.Proposal) -> C.Interpretation:
  {original: original, policy: policy.revision, context: context, capture: capture, bindings: I.fs(answer.fields), unresolved: answer.unresolved}
# These are explicit activities. Pure rendering below only uses retained state.
record Request:
  key: String
  generation: Nat
  templateRevision: String
  original: String
  context: P.Observations
  capture: D.Capture
  job: I.Job
record Section:
  request: Request
  status: String
  output: String
record Receipt:
  key: String
  status: String
  output: String
record Decision:
  accepted: Bool
  reason: String
  state: Section
def pending(request: Request) -> Section:
  {request: request, status: "pending", output: ""}
def regenerate(state: Section, request: Request) -> Decision:
  if request.key == state.request.key then {accepted: false, reason: "Reuse the retained request and receipt.", state: state} else if request.generation <= state.request.generation then {accepted: false, reason: "Regeneration needs a new explicit generation.", state: state} else {accepted: true, reason: "", state: pending(request)}
def receive(state: Section, receipt: Receipt) -> Decision:
  if receipt.key != state.request.key then {accepted: false, reason: "Receipt belongs to another exact request.", state: state} else if state.status != "pending" then {accepted: false, reason: "The exact request already has a retained outcome.", state: state} else if receipt.status == "received" || receipt.status == "uncertain" || receipt.status == "error" then {accepted: true, reason: "", state: extend(state, {status: receipt.status, output: receipt.output})} else {accepted: false, reason: "Invalid service outcome.", state: state}
def render(state: Section) -> D.Document:
  if state.status == "received" then D.Document.result({status: "generated", body: D.quote("Retained model output", D.text(state.output))}) else D.Document.result({status: state.status, body: D.text("Generation is pending or unavailable; no operation has been executed.")})
# Small constructors for genuinely heterogeneous form schemas.
def field(name: String, value: P.Value, tail: P.Fields) -> P.Fields:
  P.Fields.cons({head: {name: name, value: value}, tail: tail})
def text(value: String) -> P.Value:
  P.Value.text({value: value})
