edition ObjectiveBend 1
import ./Preparation.obend as P
import ./Abi.obend as Abi
import ./Encounter.obend as Encounter
import ./GrantPolicy.obend as G
record Member:
  did: String
  proof: String
sum Members:
  nil: {}
  cons: {head: Member, tail: Members}
record State:
  service: String
  targets: P.Values
  members: Members
  count: Nat
  capacity: Nat
  open: Bool
record Config:
  service: String
  targets: P.Values
  capacity: Nat
  open: Bool
def initial(config: Config) -> State:
  {service: config.service, targets: config.targets, members: Members.nil(), count: 0n, capacity: config.capacity, open: config.open}
def blank() -> State:
  initial({service: "", targets: P.Values.nil(), capacity: 0n, open: false})
def contains(xs: Members, did: String) -> Bool:
  match xs:
    case nil(_): false
    case cons(c): c.head.did == did || contains(c.tail, did)
record Verified:
  did: String
  proof: String
def allowed(state: State, input: Verified, principal: String) -> Bool:
  principal == state.service && state.service != "" && state.open && state.capacity <= 64n && state.count < state.capacity && input.did != "" && textLength(input.did) <= 256n && input.proof != "" && textLength(input.proof) <= 128n && contains(state.members, input.did) == false
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: String
def enroll(state: State, input: Verified, context: Abi.Context) -> Decision:
  let yes: Bool = allowed(state, input, context.principal)
  {accepted: yes, reason: if yes then "" else "This verified identity needs a new invitation from the welcome steward.", state: if yes then extend(state, {members: Members.cons({head: {did: input.did, proof: input.proof}, tail: state.members}), count: state.count + 1n}) else state, result: if yes then "Welcome to the shared garden and workshop." else ""}
def targetReady(targetSpec: P.Value, observed: P.Observation, service: String) -> Bool:
  let config: P.Value = P.get(P.get(observed.law, "amendment"), "config")
  P.textEquals(P.get(targetSpec, "object"), observed.object) && observed.object != "" && G.commandNames(P.get(targetSpec, "commands")) && P.textEquals(P.get(observed.law, "profile"), "delvetalk-scoped-law") && P.textEquals(P.get(config, "service"), service) && G.equal(P.get(config, "commands"), P.get(targetSpec, "commands")) && G.optionalBoolean(config, "reprogram") && G.optionalBoolean(targetSpec, "reprogram") && P.booleanOrFalse(P.get(config, "reprogram")) == P.booleanOrFalse(P.get(targetSpec, "reprogram"))
sum TargetPlan:
  invalid: {}
  found: {reads: P.Reads, calls: P.Effects}
def capturedPlan(spec: P.Value, captured: P.Observation, rest: P.Values, observations: P.Observations, service: String, did: String) -> TargetPlan:
  if targetReady(spec, captured, service) == false then TargetPlan.invalid() else completedPlan(spec, captured, targetPlan(rest, observations, service, did), did)
def completedMethods(spec: P.Value, captured: P.Observation, rest: TargetPlan, did: String, methods: P.Names) -> TargetPlan:
  match rest:
    case invalid(_): TargetPlan.invalid()
    case found(p): TargetPlan.found({reads: P.Reads.cons({head: P.Read.existing({object: captured.object}), tail: p.reads}), calls: P.Effects.cons({head: P.Effect.law({object: captured.object, law: G.enrolledRole(captured.law, methods, did, G.boolean(P.get(spec, "reprogram")))}), tail: p.calls})})
def completedPlan(spec: P.Value, captured: P.Observation, rest: TargetPlan, did: String) -> TargetPlan:
  match G.names(G.values(P.get(spec, "commands"))):
    case invalid(_): TargetPlan.invalid()
    case found(n): completedMethods(spec, captured, rest, did, n.value)
def targetPlan(xs: P.Values, observations: P.Observations, service: String, did: String) -> TargetPlan:
  match xs:
    case nil(_): TargetPlan.found({reads: P.Reads.nil(), calls: P.Effects.nil()})
    case cons(c):
      match P.textField(c.head, "object"):
        case missing(_): TargetPlan.invalid()
        case wrongKind(_): TargetPlan.invalid()
        case found(t):
          match P.lookupObservation(observations, t.value):
            case missing(_): TargetPlan.invalid()
            case found(o): capturedPlan(c.head, o.value, c.tail, observations, service, did)
def planned(state: State, contribution: P.Value, plan: TargetPlan, context: P.Context) -> P.Preparation:
  match plan:
    case invalid(_): P.Preparation.refused({message: "Capture the configured shared places with their current enrollment policies."})
    case found(p): P.Preparation.ready({summary: "Welcome this verified identity to the shared places, preserving every other permission.", reads: p.reads, calls: P.Effects.cons({head: P.Effect.invoke({object: context.object, command: "enroll", input: contribution}), tail: p.calls})})
def prepareVerified(state: State, contribution: P.Value, input: Verified, observations: P.Observations, context: P.Context) -> P.Preparation:
  if contains(state.members, input.did) then P.Preparation.refused({message: "No new grant: this identity is already enrolled; access remains subject to current rules."}) else if allowed(state, input, context.principal) == false then P.Preparation.refused({message: "This verified identity needs a new invitation from the welcome steward."}) else if G.emptyValues(state.targets) then P.Preparation.refused({message: "Configure the actual shared places."}) else planned(state, contribution, targetPlan(state.targets, observations, state.service, input.did), context)
def prepareProof(state: State, contribution: P.Value, did: String, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.textField(contribution, "proof"):
    case missing(_): P.Preparation.refused({message: "Supply the verified identity proof."})
    case wrongKind(_): P.Preparation.refused({message: "The identity proof must be text."})
    case found(p): prepareVerified(state, contribution, {did: did, proof: p.value}, observations, context)
def prepareEnroll(state: State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.textField(contribution, "did"):
    case missing(_): P.Preparation.refused({message: "Supply the verified identity."})
    case wrongKind(_): P.Preparation.refused({message: "The verified identity must be text."})
    case found(d): prepareProof(state, contribution, d.value, observations, context)
record Field:
  type: String
  minLength: Nat
  maxLength: Nat
record Description:
  name: String
  initial: State
  methods: {enroll: {label: String, fields: {did: Field, proof: Field}}}
  panels: {}
def didField() -> Field:
  {type: "string", minLength: 1n, maxLength: 256n}
def proofField() -> Field:
  {type: "string", minLength: 1n, maxLength: 128n}
def describe() -> Description:
  {name: "Welcome", initial: blank(), methods: {enroll: {label: "Record an authenticated welcome", fields: {did: didField(), proof: proofField()}}}, panels: {}}
def targetRequests(xs: P.Values) -> P.Requests:
  match xs:
    case nil(_): P.Requests.nil()
    case cons(c): P.Requests.cons({head: {object: P.textOrEmpty(P.get(c.head, "object")), inspectState: false, inspectLaw: true}, tail: targetRequests(c.tail)})
record Invitation:
  visible: Bool
  text: String
  prepare: String
  fields: {did: Field, proof: Field}
  observations: P.Requests
record View:
  title: String
  prose: String
  actions: {}
  children: Encounter.Children
  invitations: {enroll: Invitation}
def view(state: State, panel: String) -> View:
  {title: "Welcome", prose: "A verified account may ask the welcome steward for a place in the shared garden and workshop. Personal rooms remain personal.", actions: {}, children: Encounter.Children.nil(), invitations: {enroll: {visible: state.open, text: "Welcome a verified account", prepare: "prepareEnroll", fields: {did: didField(), proof: proofField()}, observations: targetRequests(state.targets)}}}
