edition ObjectiveBend 1
import ./Preparation.obend as P
import ./Encounter.obend as E
import ./Abi.obend as Abi
import ./Reflection.obend as R
import ./Document.obend as D

record State:
  candidate: String
  target: String
  syntax: String
def initial(config: State) -> State:
  config
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: String
def report(state: State, input: {}, context: Abi.Context) -> Decision:
  {accepted: true, reason: "", state: state, result: "Source and examples are prepared through the captured writing invitation."}
record Description:
  name: String
  initial: State
  methods: {report: {label: String, fields: {}}}
  panels: {}
def describe() -> Description:
  {name: "Writing", initial: {candidate: "", target: "", syntax: ""}, methods: {report: {label: "About this writing card", fields: {}}}, panels: {}}
def pair(name: String, value: P.Value, tail: P.Fields) -> P.Fields:
  P.Fields.cons({head: {name: name, value: value}, tail: tail})
def text(value: String) -> P.Value:
  P.Value.text({value: value})
def need(name: String, message: String) -> P.Preparation:
  P.Preparation.question({message: message, needs: P.Names.cons({head: name, tail: P.Names.nil()})})
def prepared(state: State, source: String, scenarios: String, target: P.Observation, context: P.Context) -> P.Preparation:
  if source == "" then need("source", "Supply source for this variation.") else if scenarios == "" then need("scenarios", "Supply examples for this variation.") else if textLength(source) > 32768n || textLength(scenarios) > 16384n then P.Preparation.refused({message: "The source or examples exceed this writing card's bounds."}) else P.Preparation.ready({summary: "Submit source while preserving the complete captured target state.", reads: P.Reads.cons({head: P.Read.existing({object: state.candidate}), tail: P.Reads.cons({head: P.Read.existing({object: state.target}), tail: P.Reads.nil()})}), calls: P.Effects.cons({head: P.Effect.invoke({object: state.candidate, command: "submit", input: P.Value.record({fields: pair("proposal", P.Value.record({fields: pair("syntax", text(state.syntax), pair("source", text(source), pair("scenarios", text(scenarios), P.Fields.nil())))}), pair("migration", target.state, pair("target", text(state.target), P.Fields.nil())))})}), tail: P.Effects.nil()})})
def capturedSubmission(state: State, source: String, scenarios: String, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.lookupObservation(observations, state.target):
    case missing(_): P.Preparation.refused({message: "Capture the target of this variation."})
    case found(target):
      match P.lookupObservation(observations, state.candidate):
        case missing(_): P.Preparation.refused({message: "Capture the candidate for this variation."})
        case found(_): prepared(state, source, scenarios, target.value, context)
def suppliedSubmission(state: State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.textField(contribution, "source"):
    case missing(_): need("source", "Supply source for this variation.")
    case wrongKind(_): P.Preparation.refused({message: "The variation source must be text."})
    case found(source):
      match P.textField(contribution, "scenarios"):
        case missing(_): need("scenarios", "Supply examples for this variation.")
        case wrongKind(_): P.Preparation.refused({message: "The variation examples must be text."})
        case found(scenarios): capturedSubmission(state, source.value, scenarios.value, observations, context)
def prepareSubmit(state: State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  if state.candidate == "" || state.target == "" || state.syntax == "" then P.Preparation.refused({message: "Configure a candidate, target and source syntax."}) else suppliedSubmission(state, contribution, observations, context)
# This is source-owned inspection of the target's actual captured definition.
# Reflection supplies selected exact modules; it does not choose a workflow.
def prepareInspect(state: State, contribution: P.Value, observations: P.Observations, context: P.Context, definitions: R.Definitions) -> R.Inspection:
  match R.lookup(definitions, state.target, "resident"):
    case missing(_): R.Inspection.inspection({message: "The captured source definition is unavailable.", value: P.Value.none(), document: D.text("Capture a readable installed source table.")})
    case found(d): R.Inspection.inspection({message: "These are the target's installed source modules. Edit their method, offered fields, view or interpretation text; submit the revised source and examples here before adoption.", value: P.Value.record({fields: pair("object", text(d.value.object), pair("program", text(d.value.program), P.Fields.nil()))}), document: R.document(d.value)})
# Revisions preserve the captured dependency table. The source chooses which
# named module changes and constructs the complete proposal and migration.
def submitModules(state: State, modules: R.Modules, scenarios: String, target: P.Observation) -> P.Preparation:
  let proposal: P.Value = P.Value.record({fields: pair("format", text("delvetalk-inline-module-proposal-v1"), pair("syntax", text(state.syntax), pair("modules", P.Value.array({values: R.moduleValues(modules)}), pair("scenarios", text(scenarios), P.Fields.nil()))))})
  P.Preparation.ready({summary: "Submit this revision with its exact captured dependencies and complete captured state.", reads: P.Reads.cons({head: P.Read.existing({object: state.candidate}), tail: P.Reads.cons({head: P.Read.existing({object: state.target}), tail: P.Reads.nil()})}), calls: P.Effects.cons({head: P.Effect.invoke({object: state.candidate, command: "submit", input: P.Value.record({fields: pair("proposal", proposal, pair("migration", target.state, pair("target", text(state.target), P.Fields.nil())))})}), tail: P.Effects.nil()})})
def reviseDefinition(state: State, module: String, source: String, scenarios: String, target: P.Observation, definition: R.Definition) -> P.Preparation:
  match R.revisedModules(definition.modules, module, source):
    case missing(_): P.Preparation.refused({message: "Choose a module from the captured installed definition."})
    case found(r): submitModules(state, r.modules, scenarios, target)
def capturedRevision(state: State, module: String, source: String, scenarios: String, observations: P.Observations, definitions: R.Definitions) -> P.Preparation:
  match P.lookupObservation(observations, state.target):
    case missing(_): P.Preparation.refused({message: "Capture the target before revising it."})
    case found(target):
      match R.lookup(definitions, state.target, "resident"):
        case missing(_): P.Preparation.refused({message: "Capture the installed source table before revising it."})
        case found(d): reviseDefinition(state, module, source, scenarios, target.value, d.value)
def boundedRevision(state: State, module: String, source: String, scenarios: String, observations: P.Observations, definitions: R.Definitions) -> P.Preparation:
  if module == "" || source == "" || scenarios == "" || textLength(module) > 128n || textLength(source) > 32768n || textLength(scenarios) > 16384n then P.Preparation.refused({message: "Supply a named module, bounded revised source and examples."}) else capturedRevision(state, module, source, scenarios, observations, definitions)
def suppliedRevision(state: State, contribution: P.Value, observations: P.Observations, definitions: R.Definitions) -> P.Preparation:
  match P.textField(contribution, "module"):
    case missing(_): need("module", "Which installed module shall this variation replace?")
    case wrongKind(_): P.Preparation.refused({message: "The module name must be text."})
    case found(module):
      match P.textField(contribution, "source"):
        case missing(_): need("source", "Supply the revised module source.")
        case wrongKind(_): P.Preparation.refused({message: "The module source must be text."})
        case found(source):
          match P.textField(contribution, "scenarios"):
            case missing(_): need("scenarios", "Supply examples for the revised behavior.")
            case wrongKind(_): P.Preparation.refused({message: "The examples must be text."})
            case found(scenarios): boundedRevision(state, module.value, source.value, scenarios.value, observations, definitions)
def prepareRevise(state: State, contribution: P.Value, observations: P.Observations, context: P.Context, definitions: R.Definitions) -> P.Preparation:
  if state.candidate == "" || state.target == "" || state.syntax != "objective-bend-object" then P.Preparation.refused({message: "Configure a candidate, target and Objective Bend source syntax."}) else suppliedRevision(state, contribution, observations, definitions)
record Field:
  type: String
  minLength: Nat
  maxLength: Nat
record Invitation:
  visible: Bool
  text: String
  prepare: String
  fields: {source: Field, scenarios: Field}
  observations: P.Requests
record InspectInvitation:
  visible: Bool
  text: String
  prepare: String
  fields: {}
  observations: P.Requests
  definitions: R.Requests
record ReviseInvitation:
  visible: Bool
  text: String
  prepare: String
  fields: {module: Field, source: Field, scenarios: Field}
  observations: P.Requests
  definitions: R.Requests
record View:
  title: String
  prose: String
  actions: {}
  children: E.Children
  invitations: {inspect: InspectInvitation, revise: ReviseInvitation, submit: Invitation}
def view(state: State, panel: String) -> View:
  {title: "Write a variation", prose: "Source and examples are checked before adoption. This writing card preserves its captured target's complete state.", actions: {}, children: E.Children.nil(), invitations: {inspect: {visible: state.target != "", text: "Inspect the installed definition", prepare: "prepareInspect", fields: {}, observations: P.Requests.cons({head: {object: state.target, inspectState: false, inspectLaw: false}, tail: P.Requests.nil()}), definitions: R.Requests.cons({head: {object: state.target, package: "resident"}, tail: R.Requests.nil()})}, revise: {visible: state.candidate != "" && state.target != "", text: "Revise an installed module and its examples", prepare: "prepareRevise", fields: {module: {type: "string", minLength: 1n, maxLength: 128n}, source: {type: "string", minLength: 1n, maxLength: 32768n}, scenarios: {type: "string", minLength: 1n, maxLength: 16384n}}, observations: P.Requests.cons({head: {object: state.candidate, inspectState: false, inspectLaw: false}, tail: P.Requests.cons({head: {object: state.target, inspectState: false, inspectLaw: false}, tail: P.Requests.nil()})}), definitions: R.Requests.cons({head: {object: state.target, package: "resident"}, tail: R.Requests.nil()})}, submit: {visible: state.candidate != "" && state.target != "", text: "Submit source and examples", prepare: "prepareSubmit", fields: {source: {type: "string", minLength: 1n, maxLength: 32768n}, scenarios: {type: "string", minLength: 1n, maxLength: 16384n}}, observations: P.Requests.cons({head: {object: state.candidate, inspectState: false, inspectLaw: false}, tail: P.Requests.cons({head: {object: state.target, inspectState: false, inspectLaw: false}, tail: P.Requests.nil()})})}}}
