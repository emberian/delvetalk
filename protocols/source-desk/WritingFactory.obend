edition ObjectiveBend 1
import ./List.obend as Lists
import ./Abi.obend as Abi
import ./Preparation.obend as P
import ./Allocation.obend as A
import ./Encounter.obend as E
import ./Factory.obend as F
import ./Writing.obend as W
import ./Creation.obend as C
record State:
  writer: P.Value
  last: String
record Config:
  writer: P.Value
def initial(config: Config) -> State:
  {writer: config.writer, last: ""}
record Input:
  name: String
  candidate: String
  target: String
  syntax: String
type WritingAllocations = Lists.List<{name: String, protocol: P.Value, law: P.Value, initial: W.State}>
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: String
  allocations: WritingAllocations
def make(state: State, input: Input, context: Abi.Context) -> Decision:
  let allowed: Bool = input.name != "" && input.candidate != "" && input.target != "" && input.syntax != ""
  {accepted: allowed, reason: if allowed then "" else "Name a writing card, candidate, target and syntax.", state: if allowed then {writer: state.writer, last: input.name} else state, result: input.name, allocations: if allowed then WritingAllocations.cons({head: A.configured::<W.State>(input.name, state.writer, P.Value.record({fields: F.pair("profile", W.text("delvetalk-scoped-law"), F.pair("invoke", P.oneField("report", P.Value.array({values: P.Values.cons({head: W.text(context.principal), tail: P.Values.nil()})})), F.pair("reprogram", P.Value.array({values: P.Values.nil()}), F.pair("law", P.Value.array({values: P.Values.nil()}), F.pair("read", F.principal(context.principal), F.pair("view", P.oneField("main", W.text("public")), P.Fields.nil()))))))}), W.initial({candidate: input.candidate, target: input.target, syntax: input.syntax})), tail: WritingAllocations.nil()}) else WritingAllocations.nil()}
record Field:
  type: String
  minLength: Nat
  maxLength: Nat
record Method:
  label: String
  fields: {name: Field, candidate: Field, target: Field, syntax: Field}
record Description:
  name: String
  initial: State
  methods: {make: Method}
  panels: {}
  allocation: {limit: Nat}
def field() -> Field:
  {type: "string", minLength: 1n, maxLength: 256n}
def describe() -> Description:
  {name: "Writing cards", initial: {writer: P.Value.none(), last: ""}, methods: {make: {label: "Make a writing card", fields: {name: {type: "string", minLength: 1n, maxLength: 64n}, candidate: field(), target: field(), syntax: field()}}}, panels: {}, allocation: {limit: 16n}}
def preparedMake(name: String, candidate: String, target: String, syntax: String, context: P.Context) -> P.Preparation:
  if name == "" || candidate == "" || target == "" || syntax == "" then W.need("name", "Name the writing card, candidate, target and source syntax.") else if textLength(name) > 64n then P.Preparation.refused({message: "The writing card name is too long."}) else C.make(context.object, name, P.Value.record({fields: F.pair("name", W.text(name), F.pair("candidate", W.text(candidate), F.pair("target", W.text(target), F.pair("syntax", W.text(syntax), P.Fields.nil()))))}), "Allocate a configured source writing card.")
def prepareMake(state: State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.textField(contribution, "name"):
    case missing(_): W.need("name", "Name the writing card.")
    case wrongKind(_): P.Preparation.refused({message: "The writing card name must be text."})
    case found(name):
      match P.textField(contribution, "candidate"):
        case missing(_): W.need("candidate", "Choose the candidate for this writing card.")
        case wrongKind(_): P.Preparation.refused({message: "The candidate identity must be text."})
        case found(candidate):
          match P.textField(contribution, "target"):
            case missing(_): W.need("target", "Choose the target of this variation.")
            case wrongKind(_): P.Preparation.refused({message: "The target identity must be text."})
            case found(target):
              match P.textField(contribution, "syntax"):
                case missing(_): W.need("syntax", "Choose the source syntax for this variation.")
                case wrongKind(_): P.Preparation.refused({message: "The source syntax must be text."})
                case found(syntax): preparedMake(name.value, candidate.value, target.value, syntax.value, context)
record Invitation:
  visible: Bool
  text: String
  prepare: String
  fields: {name: Field, candidate: Field, target: Field, syntax: Field}
  observations: P.Requests
record View:
  title: String
  prose: String
  actions: {}
  children: E.Children
  invitations: {make: Invitation}
def view(state: State, panel: String) -> View:
  {title: "Writing cards", prose: "Choose an existing candidate and target for a captured source submission.", actions: {}, children: E.Children.nil(), invitations: {make: {visible: true, text: "Make a writing card", prepare: "prepareMake", fields: {name: {type: "string", minLength: 1n, maxLength: 64n}, candidate: field(), target: field(), syntax: field()}, observations: P.Requests.nil()}}}
