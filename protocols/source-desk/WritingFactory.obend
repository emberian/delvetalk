edition ObjectiveBend 1
import ./Preparation.obend as P
import ./Allocation.obend as A
import ./Encounter.obend as E
import ./Factory.obend as F
import ./Writing.obend as W
record State:
  writer: P.Value
  last: String
record Config:
  writer: P.Value
def initial(config: Config) -> State:
  {writer: config.writer, last: ""}
record Input:
  name: String
  candidate: String
  target: String
  syntax: String
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: String
  allocations: A.Allocations
def make(state: State, input: Input, context: F.Context) -> Decision:
  let allowed: Bool = input.name != "" && input.candidate != "" && input.target != "" && input.syntax != ""
  {accepted: allowed, reason: if allowed then "" else "Name a writing card, candidate, target and syntax.", state: if allowed then {writer: state.writer, last: input.name} else state, result: input.name, allocations: if allowed then A.Allocations.cons({head: {name: input.name, protocol: W.configuredProgram(state.writer, {candidate: input.candidate, target: input.target, syntax: input.syntax}), law: P.Value.record({fields: F.pair("profile", W.text("delvetalk-scoped-law-v1"), F.pair("invoke", P.oneField("report", P.Value.array({values: P.Values.cons({head: W.text(context.principal), tail: P.Values.nil()})})), F.pair("reprogram", P.Value.array({values: P.Values.nil()}), F.pair("law", P.Value.array({values: P.Values.nil()}), P.Fields.nil()))))})}, tail: A.Allocations.nil()}) else A.Allocations.nil()}
record Field:
  type: String
  minLength: Nat
  maxLength: Nat
record Method:
  label: String
  fields: {name: Field, candidate: Field, target: Field, syntax: Field}
record Description:
  name: String
  initial: State
  methods: {make: Method}
  panels: {}
  allocation: {limit: Nat}
def field() -> Field:
  {type: "string", minLength: 1n, maxLength: 256n}
def describe() -> Description:
  {name: "Writing cards", initial: {writer: P.Value.none(), last: ""}, methods: {make: {label: "Make a writing card", fields: {name: {type: "string", minLength: 1n, maxLength: 64n}, candidate: field(), target: field(), syntax: field()}}}, panels: {}, allocation: {limit: 16n}}
record Action:
  visible: Bool
  text: String
  command: String
  input: {}
record View:
  title: String
  prose: String
  actions: {make: Action}
  children: E.Children
def view(state: State, panel: String) -> View:
  {title: "Writing cards", prose: "Choose an existing candidate and target for a captured source submission.", actions: {make: {visible: true, text: "Make a writing card", command: "make", input: {}}}, children: E.Children.nil()}
