edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Preparation.obend as P
import ./Allocation.obend as A
import ./Encounter.obend as Encounter
import ./Factory.obend as F
import ./Creation.obend as C

# An ordinary workshop reuses the Candidate factory's child authority.
# This specialization accepts a direct name rather than an Editor.plan origin.
record Config:
  compiler: String
  reporters: P.Value
  candidate: P.Value
  reviewers: P.Value
record State:
  base: F.State
  reviewers: P.Value
record Input:
  name: String
record Result:
  name: String
  maker: String
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Result
  allocations: A.Allocations
def reviewed(base: F.State, reviewers: P.Value) -> State:
  {base: base, reviewers: reviewers}
def initial(config: Config) -> State:
  reviewed(F.initial({compiler: config.compiler, reporters: config.reporters, candidate: config.candidate}), config.reviewers)
def make(state: State, input: Input, context: Abi.Context) -> Decision:
  let ready: Bool = input.name != "" && state.base.compiler != ""
  {accepted: ready, reason: if ready then "" else "Name the desk and configure its compiler.", state: if ready then extend(state, {base: F.remembered(state.base, input.name)}) else state, result: {name: input.name, maker: context.principal}, allocations: if ready then A.Allocations.cons({head: {name: input.name, protocol: state.base.candidate, law: F.authorityWithReviewers(state.base, context.principal, state.reviewers)}, tail: A.Allocations.nil()}) else A.Allocations.nil()}
record Method:
  label: String
  fields: {name: Abi.StringField}
record Description:
  name: String
  initial: State
  methods: {make: Method}
  panels: {last: String}
  allocation: {limit: Nat}
def describe() -> Description:
  {name: "Writing desks", initial: reviewed(F.blank(), P.Value.none()), methods: {make: {label: "Make a writing desk", fields: {name: {type: "string", minLength: 1n, maxLength: 64n}}}}, panels: {last: "Last made"}, allocation: {limit: 16n}}
record Invitation:
  visible: Bool
  text: String
  prepare: String
  fields: {name: Abi.StringField}
  observations: P.Requests
record View:
  title: String
  prose: String
  actions: {}
  children: Encounter.Children
  invitations: {make: Invitation}
def view(state: State, panel: String) -> View:
  {title: "Writing desks", prose: if panel == "last" then state.base.last else "Make a fresh desk for a proposal. Its maker submits a proposal. Its maker or an explicitly configured reviewer may release checked code under the target’s current law; the compiler reports results.", actions: {}, children: Encounter.Children.nil(), invitations: {make: {visible: state.base.compiler != "", text: "Make a writing desk", prepare: "prepareMake", fields: {name: {type: "string", minLength: 1n, maxLength: 64n}}, observations: P.Requests.nil()}}}

def named(state: State, name: String, context: P.Context) -> P.Preparation:
  if state.base.compiler == "" then P.Preparation.refused({message: "Configure the workshop compiler."}) else if name == "" then P.Preparation.question({message: "Name the writing desk.", needs: P.Names.cons({head: "name", tail: P.Names.nil()})}) else C.make(context.object, name, P.oneField("name", P.Value.text({value: name})), "Make a new writing desk under its current factory law.")
def prepareMake(state: State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.textField(contribution, "name"):
    case found(name): named(state, name.value, context)
    case missing(_): P.Preparation.question({message: "Name the writing desk.", needs: P.Names.cons({head: "name", tail: P.Names.nil()})})
    case wrongKind(_): P.Preparation.refused({message: "The writing desk name must be text."})
