edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Preparation.obend as P
import ./Conversation.obend as C
import ./Notebook.obend as N
import ./ConversationModel.obend as M
def describe() -> N.Description:
  N.describe()
def answer(state: C.State, input: N.Input, context: Abi.Context) -> C.Decision:
  N.answer(state, input, context)
def interpret(state: C.State, input: N.Interpreted, context: Abi.Context) -> C.Decision:
  N.interpret(state, input, context)
def retain(state: C.State, input: P.Value, context: Abi.Context) -> C.Decision:
  N.retain(state, input, context)
def resolve(state: C.State, input: N.Completion, context: Abi.Context) -> C.Decision:
  N.resolve(state, input, context)
def prepareResolve(state: C.State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  N.prepareResolve(state, contribution, observations, context)
def view(state: C.State, panel: String) -> N.View:
  N.render(state, "The evening desk keeps every voice. Choose a moth by its reference, or bring an interpretation to continue.")
def interpretationRequest(state: C.State, original: String, observations: P.Observations, context: P.Context) -> M.Request:
  N.interpretationRequest(state, original, observations, context)
def prepareInterpretation(state: C.State, input: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  N.prepareInterpretation(state, input, observations, context)
