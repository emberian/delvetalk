edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Preparation.obend as P
import ./Encounter.obend as E
import ./Document.obend as D
import ./Conversation.obend as C
import ./Interpretation.obend as I
import ./ConversationModel.obend as M
import ./Reflection.obend as R
import ./Writing.obend as W
record State:
  conversation: C.State
  offered: E.Children
  sourceCandidate: String
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: String
record Input:
  original: String
  target: String
  recipient: String
record Interpreted:
  original: String
  target: String
  recipient: String
  token: String
  policy: String
record Completion:
  recipient: String
  object: String
sum Selection:
  incomplete: {}
  invalid: {}
  selected: {target: String, recipient: String}
def offers(items: E.Children, object: String) -> Bool:
  match items:
    case nil(_): false
    case cons(c): c.head.object == object || offers(c.tail, object)
def missingText(fields: P.Fields, name: String) -> Bool:
  match P.textField(P.Value.record({fields: fields}), name):
    case missing(_): true
    case wrongKind(_): true
    case found(t): t.value == ""
def needs(fields: P.Fields) -> P.Names:
  let recipient = if missingText(fields, "recipient") then P.Names.cons({head: "recipient", tail: P.Names.nil()}) else P.Names.nil()
  if missingText(fields, "target") then P.Names.cons({head: "target", tail: recipient}) else recipient
def validField(items: E.Children, field: P.Field) -> Bool:
  match P.asText(field.value):
    case missing(_): false
    case wrongKind(_): false
    case found(t): if field.name == "target" then t.value != "" && offers(items, t.value) else field.name == "recipient" && textLength(t.value) > 0n && textLength(t.value) <= 64n
def valid(items: E.Children, fields: P.Fields) -> Bool:
  match fields:
    case nil(_): true
    case cons(c): validField(items, c.head) && valid(items, c.tail)
def policy(state: State) -> C.Policy:
  {revision: state.conversation.interpreter.revision, capacity: 32n, window: 8n, accepts: fn(fields: P.Fields) -> Bool: valid(state.offered, fields), needs: fn(fields: P.Fields) -> P.Names: needs(fields)}
def configured(object: String, focus: String, offered: E.Children) -> State:
  {conversation: extend(C.initial(focus, {object: object, revision: 1n, meaning: "lend-an-offered-object", entry: "prepareResolve", token: "resolve"}, needs(P.Fields.nil())), {interpreter: initialPolicy()}), offered: offered, sourceCandidate: ""}
def configuredForSource(object: String, focus: String, offered: E.Children, candidate: String) -> State:
  extend(configured(object, focus, offered), {sourceCandidate: candidate})
def initial() -> State:
  configured("conversation", "Lending conversation", E.Children.nil())
def decided(state: State, decision: C.Decision) -> Decision:
  {accepted: decision.accepted, reason: decision.reason, state: extend(state, {conversation: decision.state}), result: decision.result}
def bindings(input: Input) -> P.Fields:
  let recipient = if input.recipient == "" then P.Fields.nil() else P.Fields.cons({head: {name: "recipient", value: P.Value.text({value: input.recipient})}, tail: P.Fields.nil()})
  if input.target == "" then recipient else P.Fields.cons({head: {name: "target", value: P.Value.text({value: input.target})}, tail: recipient})
def answer(state: State, input: Input, context: Abi.Context) -> Decision:
  decided(state, C.contribute(policy(state), state.conversation, C.literal(state.conversation, input.original, bindings(input)), context))
def interpret(state: State, input: Interpreted, context: Abi.Context) -> Decision:
  decided(state, C.contribute(policy(state), state.conversation, {original: input.original, policy: input.policy, context: P.Observations.nil(), capture: extend(state.conversation.capture, {token: input.token}), bindings: bindings({original: input.original, target: input.target, recipient: input.recipient}), unresolved: P.Names.nil()}, context))
def retain(state: State, input: C.Interpretation, context: Abi.Context) -> Decision:
  decided(state, C.retain(policy(state), state.conversation, input, context))
def withRecipient(target: String, fields: P.Fields) -> Selection:
  match P.textField(P.Value.record({fields: fields}), "recipient"):
    case missing(_): Selection.incomplete()
    case wrongKind(_): Selection.invalid()
    case found(r): if r.value == "" then Selection.incomplete() else Selection.selected({target: target, recipient: r.value})
def selected(state: State) -> Selection:
  match P.textField(P.Value.record({fields: state.conversation.bindings}), "target"):
    case missing(_): Selection.incomplete()
    case wrongKind(_): Selection.invalid()
    case found(t): if t.value == "" then Selection.incomplete() else if offers(state.offered, t.value) == false || valid(state.offered, state.conversation.bindings) == false then Selection.invalid() else withRecipient(t.value, state.conversation.bindings)
def resolveSelected(state: State, input: Completion, target: String, recipient: String, context: Abi.Context) -> Decision:
  let actual = context.inputOrigin.kind == "invoke" && context.inputOrigin.object == target && context.inputOrigin.command == "lend" && context.inputOrigin.immediatelyPrevious && input.object == target && input.recipient == recipient
  decided(state, if actual then C.finish(state.conversation, D.text(textConcat("Lent ", textConcat(input.object, textConcat(" to ", input.recipient)))), context) else C.decided(state.conversation, false, "Completion requires the selected object's immediately preceding lending result."))
def resolve(state: State, input: Completion, context: Abi.Context) -> Decision:
  match selected(state):
    case incomplete(_): decided(state, C.decided(state.conversation, false, "Choose an offered object and recipient first."))
    case invalid(_): decided(state, C.decided(state.conversation, false, "The selected fields do not match this encounter's offered references."))
    case selected(s): resolveSelected(state, input, s.target, s.recipient, context)
def prepareSelected(target: String, recipient: String, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.lookupObservation(observations, target):
    case missing(_): P.Preparation.refused({message: "Capture the selected object before completing this intention."})
    case found(_): P.Preparation.ready({summary: "Lend the selected object and retain its actual result", reads: P.Reads.cons({head: P.Read.existing({object: target}), tail: P.Reads.nil()}), calls: P.Effects.cons({head: P.Effect.invoke({object: target, command: "lend", input: P.oneField("recipient", P.Value.text({value: recipient}))}), tail: P.Effects.cons({head: P.Effect.invokeResult({object: context.object, command: "resolve", result: 0n}), tail: P.Effects.nil()})})})
def prepareOpen(state: State, observations: P.Observations, context: P.Context) -> P.Preparation:
  match selected(state):
    case incomplete(_): P.Preparation.question({message: "Which offered object and who should receive it?", needs: needs(state.conversation.bindings)})
    case invalid(_): P.Preparation.refused({message: "Choose a reference offered by this encounter and a text recipient."})
    case selected(s): prepareSelected(s.target, s.recipient, observations, context)
def prepareResolve(state: State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  if state.conversation.closed then P.Preparation.refused({message: "This intention is already complete."}) else prepareOpen(state, observations, context)
def observations(state: State) -> P.Requests:
  match selected(state):
    case incomplete(_): P.Requests.nil()
    case invalid(_): P.Requests.nil()
    case selected(s): P.Requests.cons({head: {object: s.target, inspectState: false, inspectLaw: false}, tail: P.Requests.nil()})
def references(items: E.Children) -> D.Documents:
  match items:
    case nil(_): D.Documents.nil()
    case cons(c): D.Documents.cons({head: D.concat(D.Document.reference(c.head), D.text("\n")), tail: references(c.tail)})
def document(state: State, after: Nat, limit: Nat, introduction: String) -> D.Document:
  let listed = D.Document.sequence({items: references(state.offered)})
  let offer = D.Document.offer({label: "Finish choosing", capture: state.conversation.capture})
  D.concat(D.text(textConcat(introduction, "\n")), D.concat(listed, D.concat(offer, D.concat(D.text("\n"), C.render(policy(state), state.conversation, after, limit)))))
record AnswerFields:
  original: Abi.StringField
  target: Abi.StringField
  recipient: Abi.StringField
record InterpretFields:
  original: Abi.StringField
  target: Abi.StringField
  recipient: Abi.StringField
  token: Abi.StringField
  policy: Abi.StringField
def answerFields() -> AnswerFields:
  {original: field(1024n), target: field(512n), recipient: field(64n)}
def interpretFields() -> InterpretFields:
  {original: field(1024n), target: field(512n), recipient: field(64n), token: field(64n), policy: field(64n)}
record Description:
  name: String
  initial: State
  methods: {reviseInterpretation: {label: String, fields: I.EditFields}, retain: {label: String, fields: {}, inputCodec: String}, answer: {label: String, fields: AnswerFields}, interpret: {label: String, fields: InterpretFields}, resolve: {label: String, fields: {recipient: Abi.StringField, object: Abi.StringField}}}
  panels: {interpretation: String}
def field(max: Nat) -> Abi.StringField:
  {type: "string", minLength: 0n, maxLength: max}
def describe() -> Description:
  {name: "Lending conversation", initial: initial(), methods: {reviseInterpretation: {label: "Revise prompt and conventions", fields: I.editFields()}, retain: {label: "Retain an interpreted contribution", fields: {}, inputCodec: "data"}, answer: {label: "Answer a field", fields: answerFields()}, interpret: {label: "Retain an interpretation", fields: interpretFields()}, resolve: {label: "Receive the actual lending result", fields: {recipient: field(64n), object: field(512n)}}}, panels: {interpretation: "Prompt and conventions"}}
record AnswerAction:
  visible: Bool
  text: String
  command: String
  input: {}
  fields: AnswerFields
record InterpretAction:
  visible: Bool
  text: String
  command: String
  input: {}
  fields: InterpretFields
record RevisionAction:
  visible: Bool
  text: String
  command: String
  input: {}
  fields: I.EditFields
record Invitation:
  visible: Bool
  text: String
  prepare: String
  fields: {}
  observations: P.Requests
record View:
  title: String
  prose: String
  actions: {answer: AnswerAction, interpret: InterpretAction, reviseInterpretation: RevisionAction}
  children: E.Children
  invitations: {resolve: Invitation, inspectTemplates: W.InspectInvitation, reviseTemplates: W.ReviseInvitation}
  document: D.Document
  interpretation: {request: String, prepare: String, contributionCodec: String}
def renderPanel(state: State, introduction: String, panel: String) -> View:
  let writing = W.view(sourceWriting(state), "main")
  let doc = if panel == "interpretation" then D.concat(I.inspect(state.conversation.interpreter), D.concat(D.text("\nActual offered fields:\n"), D.text(M.schemaText(schema(state))))) else document(state, 0n, 8n, introduction)
  {title: state.conversation.focus, prose: D.plain(doc), actions: {reviseInterpretation: {visible: panel == "interpretation", text: "Revise prompt and conventions", command: "reviseInterpretation", input: {}, fields: I.editFields()}, answer: {visible: state.conversation.closed == false, text: "Answer a field", command: "answer", input: {}, fields: answerFields()}, interpret: {visible: state.conversation.closed == false, text: "Retain an interpretation", command: "interpret", input: {}, fields: interpretFields()}}, children: sourceChildren(state), invitations: {inspectTemplates: extend(writing.invitations.inspect, {visible: panel == "interpretation", prepare: "prepareInspectTemplates"}), reviseTemplates: extend(writing.invitations.revise, {visible: panel == "interpretation" && state.sourceCandidate != "", prepare: "prepareReviseTemplates"}), resolve: {visible: state.conversation.closed == false, text: "Finish choosing", prepare: "prepareResolve", fields: {}, observations: observations(state)}}, document: doc, interpretation: {request: "interpretationRequest", prepare: "prepareInterpretation", contributionCodec: "data"}}
def render(state: State, introduction: String) -> View:
  renderPanel(state, introduction, "main")
def view(state: State, panel: String) -> View:
  renderPanel(state, "Choose an offered object and its recipient. Field answers and interpreted prose continue the same conversation.", panel)
def options(items: E.Children) -> P.Names:
  match items:
    case nil(_): P.Names.nil()
    case cons(c): P.Names.cons({head: c.head.object, tail: options(c.tail)})
def schema(state: State) -> I.Schema:
  I.Schema.cons({head: {name: "target", shape: I.Shape.enumeration({options: options(state.offered)})}, tail: I.Schema.cons({head: I.textSchema("recipient", 1n, 64n), tail: I.Schema.nil()})})
def choicesText(items: E.Children) -> String:
  match items:
    case nil(_): ""
    case cons(c): textConcat(c.head.label, textConcat(" = ", textConcat(c.head.object, textConcat("\n", choicesText(c.tail)))))
def initialPolicy() -> I.Policy:
  extend(I.defaultPolicy(), {revision: "lending-policy-v2", vocabulary: "Choose only an offered reference below; ask when ambiguous. Recipient is a named participant. Preparing this operation lends the selected actual object."})
def interpretationPolicy(state: State) -> I.Policy:
  extend(state.conversation.interpreter, {vocabulary: textConcat(state.conversation.interpreter.vocabulary, textConcat("\nActual offered references:\n", choicesText(state.offered)))})
def reviseInterpretation(state: State, input: I.PolicyEdit, context: Abi.Context) -> Decision:
  decided(state, C.editInterpretation(state.conversation, input, needs(P.Fields.nil()), context))
def interpretationRequest(state: State, original: String, observations: P.Observations, context: P.Context) -> M.Request:
  M.interpretationRequest(interpretationPolicy(state), state.conversation, original, observations, schema(state), D.concat(D.text("Choose an offered reference and recipient.\n"), D.concat(D.Document.sequence({items: references(state.offered)}), C.interpretationContext(state.conversation))))
def prepareInterpretation(state: State, input: M.Response, observations: P.Observations, context: P.Context) -> M.Preparation:
  M.prepareInterpretation(policy(state), interpretationPolicy(state), state.conversation, input, observations, context, schema(state))

def sourceWriting(state: State) -> W.State:
  W.initial({candidate: state.sourceCandidate, target: state.conversation.capture.object, syntax: "objective-bend-object"})
def sourceChildren(state: State) -> E.Children:
  if state.sourceCandidate == "" then state.offered else E.Children.cons({head: {key: "source-variation", label: "Check and adopt template variations", object: state.sourceCandidate, panel: "main"}, tail: state.offered})
def prepareInspectTemplates(state: State, contribution: P.Value, observations: P.Observations, context: P.Context, definitions: R.Definitions) -> R.Inspection:
  W.prepareInspect(sourceWriting(state), contribution, observations, context, definitions)
def prepareReviseTemplates(state: State, contribution: P.Value, observations: P.Observations, context: P.Context, definitions: R.Definitions) -> P.Preparation:
  W.prepareRevise(sourceWriting(state), contribution, observations, context, definitions)
