edition ObjectiveBend 1
import ./Reflection.obend as R
import ./Abi.obend as Abi
import ./Preparation.obend as P
import ./Encounter.obend as E
import ./Document.obend as D
import ./Conversation.obend as C
import ./Interpretation.obend as I
import ./ConversationModel.obend as M
import ./Notebook.obend as N
# Example configuration, not the reusable notebook's reference policy.
def configured(object: String, focus: String, offered: E.Children) -> N.State:
  N.configured(object, focus, offered)
def initial() -> N.State:
  configured("conversation", "Lend a moth", E.Children.cons({head: {key: "amber", label: "Amber moth", object: "moth:amber", panel: "main"}, tail: E.Children.cons({head: {key: "silver", label: "Silver moth", object: "moth:silver", panel: "main"}, tail: E.Children.nil()})}))
def describe() -> N.Description:
  extend(N.describe(), {initial: initial()})
def answer(state: N.State, input: N.Input, context: Abi.Context) -> N.Decision:
  N.answer(state, input, context)
def interpret(state: N.State, input: N.Interpreted, context: Abi.Context) -> N.Decision:
  N.interpret(state, input, context)
def retain(state: N.State, input: C.Interpretation, context: Abi.Context) -> N.Decision:
  N.retain(state, input, context)
def resolve(state: N.State, input: N.Completion, context: Abi.Context) -> N.Decision:
  N.resolve(state, input, context)
def prepareResolve(state: N.State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  N.prepareResolve(state, contribution, observations, context)
def document(state: N.State, after: Nat, limit: Nat, introduction: String) -> D.Document:
  N.document(state, after, limit, introduction)
def view(state: N.State, panel: String) -> N.View:
  N.view(state, panel)
def interpretationRequest(state: N.State, original: String, observations: P.Observations, context: P.Context) -> M.Request:
  N.interpretationRequest(state, original, observations, context)
def prepareInterpretation(state: N.State, input: M.Response, observations: P.Observations, context: P.Context) -> M.Preparation:
  N.prepareInterpretation(state, input, observations, context)

def reviseInterpretation(state: N.State, input: I.PolicyEdit, context: Abi.Context) -> N.Decision:
  N.reviseInterpretation(state, input, context)

def prepareInspectTemplates(state: N.State, contribution: P.Value, observations: P.Observations, context: P.Context, definitions: R.Definitions) -> R.Inspection:
  N.prepareInspectTemplates(state, contribution, observations, context, definitions)
def prepareReviseTemplates(state: N.State, contribution: P.Value, observations: P.Observations, context: P.Context, definitions: R.Definitions) -> P.Preparation:
  N.prepareReviseTemplates(state, contribution, observations, context, definitions)
