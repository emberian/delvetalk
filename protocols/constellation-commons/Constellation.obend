edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Encounter.obend as Encounter
import ./Stars.obend as Stars
record State:
  stars: Stars.Stars
  count: Nat
  selected: Nat
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Stars.Star
def initial() -> State:
  {stars: Stars.empty(), count: 0, selected: 0}
def refuse(state: State, reason: String) -> Decision:
  {accepted: false, reason: reason, state: state, result: Stars.blank()}
def contribute(state: State, input: {image: String, line: String}, context: Abi.Context) -> Decision:
  let star: Stars.Star = {id: state.count + 1, author: context.principal, image: input.image, line: input.line, revision: 1}
  if state.count >= 12 then refuse(state, "The twelve lights are filled; their authors can still revise them.") else if Stars.words(input.image, 80) == false || Stars.words(input.line, 240) == false then refuse(state, "Offer an image in 1–80 characters and a line in 1–240 characters.") else {accepted: true, reason: "", state: {stars: Stars.append(state.stars, star), count: state.count + 1, selected: star.id}, result: star}
def revise(state: State, input: {id: Nat, image: String, line: String}, context: Abi.Context) -> Decision:
  let old: Stars.Star = Stars.find(state.stars, input.id)
  let star: Stars.Star = extend(old, {image: input.image, line: input.line, revision: old.revision + 1})
  if old.id == 0 then refuse(state, "Choose an existing light.") else if old.author != context.principal then refuse(state, "Only this light's author can revise it.") else if Stars.words(input.image, 80) == false || Stars.words(input.line, 240) == false then refuse(state, "Keep the image within 1–80 characters and the line within 1–240 characters.") else {accepted: true, reason: "", state: extend(state, {stars: Stars.replace(state.stars, star), selected: star.id}), result: star}
def visit(state: State, input: {id: Nat}, context: Abi.Context) -> Decision:
  let star: Stars.Star = Stars.find(state.stars, input.id)
  if star.id == 0 then refuse(state, "Choose a numbered light from the sky.") else {accepted: true, reason: "", state: extend(state, {selected: star.id}), result: star}
record Fields:
  image: Abi.StringField
  line: Abi.StringField
record Description:
  name: String
  initial: State
  methods: {contribute: {label: String, fields: Fields}, revise: {label: String, fields: {id: Abi.NatField, image: Abi.StringField, line: Abi.StringField}}, visit: {label: String, fields: {id: Abi.NatField}}}
  panels: {sky: String, selected: String}
def describe() -> Description:
  {name: "A constellation of borrowed light", initial: initial(), methods: {contribute: {label: "Offer an image and a line", fields: {image: {type: "string", minLength: 1, maxLength: 80}, line: {type: "string", minLength: 1, maxLength: 240}}}, revise: {label: "Revise your own light", fields: {id: {type: "nat", minimum: 1, maximum: 12}, image: {type: "string", minLength: 1, maxLength: 80}, line: {type: "string", minLength: 1, maxLength: 240}}}, visit: {label: "Inspect a numbered light", fields: {id: {type: "nat", minimum: 1, maximum: 12}}}}, panels: {sky: "The shared sky", selected: "A light and its author"}}
record Action:
  visible: Bool
  text: String
  command: String
  input: {}
record SelectedAction:
  visible: Bool
  text: String
  command: String
  input: {id: Nat}
record View:
  title: String
  prose: String
  actions: {contribute: Action, visit: Action, revise: SelectedAction}
  children: Encounter.Children
def view(state: State, panel: String) -> View:
  let star: Stars.Star = Stars.find(state.stars, state.selected)
  {title: "A constellation of borrowed light", prose: if state.count == 0 then "Leave an image and a line beneath this dark sky. Other voices can place their lights beside yours; you can return and revise your own." else if panel == "selected" then Stars.story(star) else textConcat("Read these lights together; let the spaces between their images make a poem.\n\n", Stars.sky(state.stars)), actions: {contribute: {visible: state.count < 12, text: "Place another light beside these", command: "contribute", input: {}}, visit: {visible: state.count > 0, text: "Inspect a numbered light", command: "visit", input: {}}, revise: {visible: star.id > 0, text: "Author: revise this light", command: "revise", input: {id: star.id}}}, children: Encounter.Children.nil()}
