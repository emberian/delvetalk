edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./ReviewableWork.obend as Work
record PostMethod:
  label: String
  fields: {task: Abi.StringField}
record EmptyMethod:
  label: String
  fields: {}
record SubmitMethod:
  label: String
  fields: {result: Abi.StringField}
record ReviewMethod:
  label: String
  fields: {review: Abi.StringField}
record Description:
  name: String
  initial: Work.State
  methods: {post: PostMethod, claim: EmptyMethod, submit: SubmitMethod, accept: ReviewMethod, reject: ReviewMethod}
  panels: {}
def initial(config: Work.Configuration) -> Work.State:
  Work.initial(config)
def describe() -> Description:
  {name:"work-ticket-v2",initial:Work.initial({requester:"requester",links:{context:Work.OptionalReference.absent(),about:Work.OptionalReference.absent(),replyTo:Work.OptionalReference.absent()}}),methods:{post:{label:"Post this task",fields:{task:{type:"string",minLength:1n,maxLength:2048n}}},claim:{label:"Claim this task",fields:{}},submit:{label:"Submit work for review",fields:{result:{type:"string",minLength:1n,maxLength:2048n}}},accept:{label:"Accept the submission",fields:{review:{type:"string",minLength:1n,maxLength:1024n}}},reject:{label:"Reject the submission",fields:{review:{type:"string",minLength:1n,maxLength:1024n}}}},panels:{}}
def post(state: Work.State, input: Work.Post, context: Abi.Context) -> Work.Decision:
  Work.posted(state,input,context)
def claim(state: Work.State, input: {}, context: Abi.Context) -> Work.Decision:
  Work.claimed(state,context)
def submit(state: Work.State, input: Work.Submission, context: Abi.Context) -> Work.Decision:
  Work.submitted(state,input,context)
def accept(state: Work.State, input: Work.Review, context: Abi.Context) -> Work.Decision:
  Work.reviewed(state,input,context,true)
def reject(state: Work.State, input: Work.Review, context: Abi.Context) -> Work.Decision:
  Work.reviewed(state,input,context,false)
def view(state: Work.State, panel: String) -> Work.View:
  Work.view(state)
