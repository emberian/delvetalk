edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Encounter.obend as Encounter
sum Phase:
  draft: {}
  open: {}
  claimed: {}
  submitted: {}
  accepted: {}
  rejected: {}
record Reference:
  format: String
  world: String
  object: String
sum OptionalReference:
  absent: {}
  present: Reference
record Links:
  context: OptionalReference
  about: OptionalReference
  replyTo: OptionalReference
record Configuration:
  requester: String
  links: Links
record State:
  phase: Phase
  requester: String
  author: String
  task: String
  claimant: String
  result: String
  submittedBy: String
  review: String
  reviewedBy: String
  links: Links
record Receipt:
  by: String
  transition: String
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Receipt
record Post:
  task: String
record Submission:
  result: String
record Review:
  review: String
def initial(config: Configuration) -> State:
  {phase: Phase.draft(), requester: config.requester, author: "", task: "", claimant: "", result: "", submittedBy: "", review: "", reviewedBy: "", links: config.links}
def status(phase: Phase) -> String:
  match phase:
    case draft(_): "draft"
    case open(_): "open"
    case claimed(_): "claimed"
    case submitted(_): "submitted"
    case accepted(_): "accepted"
    case rejected(_): "rejected"
def refused(state: State, reason: String) -> Decision:
  {accepted: false, reason: reason, state: state, result: {by: "", transition: ""}}
def changed(state: State, phase: Phase, author: String, task: String, claimant: String, result: String, submittedBy: String, review: String, reviewedBy: String) -> State:
  {phase:phase,requester:state.requester,author:author,task:task,claimant:claimant,result:result,submittedBy:submittedBy,review:review,reviewedBy:reviewedBy,links:state.links}
def posted(state: State, input: Post, context: Abi.Context) -> Decision:
  if status(state.phase)!="draft"||context.principal!=state.requester||input.task=="" then refused(state,"Only the requester can post nonempty work from draft.") else {accepted:true,reason:"",state:changed(state,Phase.open(),context.principal,input.task,state.claimant,state.result,state.submittedBy,state.review,state.reviewedBy),result:{by:context.principal,transition:"post"}}
def claimed(state: State, context: Abi.Context) -> Decision:
  if status(state.phase)!="open" then refused(state,"This work is not open.") else {accepted:true,reason:"",state:changed(state,Phase.claimed(),state.author,state.task,context.principal,state.result,state.submittedBy,state.review,state.reviewedBy),result:{by:context.principal,transition:"claim"}}
def submitted(state: State, input: Submission, context: Abi.Context) -> Decision:
  if status(state.phase)!="claimed"||context.principal!=state.claimant||input.result=="" then refused(state,"Only the claimant can submit nonempty work.") else {accepted:true,reason:"",state:changed(state,Phase.submitted(),state.author,state.task,state.claimant,input.result,context.principal,state.review,state.reviewedBy),result:{by:context.principal,transition:"submit"}}
def reviewed(state: State, input: Review, context: Abi.Context, accept: Bool) -> Decision:
  if status(state.phase)!="submitted"||context.principal!=state.requester||input.review=="" then refused(state,"Only the requester can review a submission.") else {accepted:true,reason:"",state:changed(state,if accept then Phase.accepted() else Phase.rejected(),state.author,state.task,state.claimant,state.result,state.submittedBy,input.review,context.principal),result:{by:context.principal,transition:if accept then "accept" else "reject"}}
record Action:
  visible: Bool
  text: String
  command: String
  input: {}
record View:
  title: String
  prose: String
  actions: {post: Action, claim: Action, submit: Action, accept: Action, reject: Action}
  children: Encounter.Children
def title(phase: Phase) -> String:
  match phase:
    case draft(_): "Work ticket · Draft"
    case open(_): "Work ticket · Open"
    case claimed(_): "Work ticket · Claimed"
    case submitted(_): "Work ticket · Submitted"
    case accepted(_): "Work ticket · Accepted"
    case rejected(_): "Work ticket · Rejected"
def prose(state: State) -> String:
  match state.phase:
    case draft(_): "Post a task for another participant."
    case open(_): state.task
    case claimed(_): state.task
    case submitted(_): state.result
    case accepted(_): state.review
    case rejected(_): state.review
def view(state: State) -> View:
  let phase: String = status(state.phase)
  {title:title(state.phase),prose:prose(state),actions:{post:{visible:phase=="draft",text:"Post this task",command:"post",input:{}},claim:{visible:phase=="open",text:"Claim this task",command:"claim",input:{}},submit:{visible:phase=="claimed",text:"Submit work for review",command:"submit",input:{}},accept:{visible:phase=="submitted",text:"Accept the submission",command:"accept",input:{}},reject:{visible:phase=="submitted",text:"Reject the submission",command:"reject",input:{}}},children:Encounter.Children.nil()}
