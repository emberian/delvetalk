edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Encounter.obend as Encounter
import ./Emissions.obend as E
import ./Appointments.obend as Appointments
record Config:
  capacity: Nat
record PhysicalConfig:
  capacity: Nat
  epochMillis: Nat
  quantumMillis: Nat
record State:
  now: Nat
  epochMillis: Nat
  quantumMillis: Nat
  observedMillis: Nat
  nextGeneration: Nat
  size: Nat
  capacity: Nat
  offset: Nat
  queue: Appointments.Queue
  last: Appointments.Last
record Request:
  id: String
  generation: Nat
  due: Nat
  deadline: Nat
  to: String
  recipientProgram: String
  topic: String
record Quote:
  id: String
  due: Nat
  deadline: Nat
  to: String
  recipientProgram: String
  topic: String
record Cancel:
  id: String
  generation: Nat
record Tick:
  now: Nat
record Sample:
  unixMillis: Nat
record Page:
  offset: Nat
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Appointments.Result
record Quoted:
  accepted: Bool
  reason: String
  state: State
  result: Request
record Effects:
  accepted: Bool
  reason: String
  state: State
  result: Appointments.Result
  emissions: E.Emissions
def configured(config: Config) -> State:
  {now: 0n, epochMillis: 0n, quantumMillis: 1000n, observedMillis: 0n, nextGeneration: 1n, size: 0n, capacity: config.capacity, offset: 0n, queue: Appointments.empty(), last: {id: "", generation: 0n, status: "none"}}
def physical(config: PhysicalConfig) -> State:
  extend(configured({capacity: config.capacity}), {epochMillis: config.epochMillis, quantumMillis: config.quantumMillis, observedMillis: config.epochMillis})
def quote(state: State, input: Quote, context: Abi.Context) -> Quoted:
  {accepted: true, reason: "", state: state, result: {id: input.id, generation: state.nextGeneration, due: input.due, deadline: input.deadline, to: input.to, recipientProgram: input.recipientProgram, topic: input.topic}}
def request(state: State, input: Request, context: Abi.Context) -> Decision:
  let unique = Appointments.contains(state.queue.front, input.id) == false && Appointments.contains(state.queue.back, input.id) == false
  let ok = state.capacity > 0n && state.capacity <= 24n && state.size < state.capacity && unique && input.id != "" && input.generation == state.nextGeneration && input.due >= state.now && input.deadline >= input.due && input.to != "" && input.topic != ""
  let item: Appointments.Item = {id: input.id, owner: context.principal, generation: input.generation, due: input.due, deadline: input.deadline, to: input.to, recipientProgram: input.recipientProgram, topic: input.topic}
  {accepted: ok, reason: if ok then "" else "Use a unique active id, the clock's next generation, available capacity (1..24), and ordered future times.", state: extend(state, {nextGeneration: state.nextGeneration + 1n, size: state.size + 1n, queue: Appointments.push(state.queue, item)}), result: {status: "queued", id: input.id, generation: input.generation, now: state.now}}
def cancel(state: State, input: Cancel, context: Abi.Context) -> Decision:
  let ok = Appointments.owns(state.queue.front, input.id, input.generation, context.principal) || Appointments.owns(state.queue.back, input.id, input.generation, context.principal)
  {accepted: ok, reason: if ok then "" else "Only the owner can cancel this queued generation. An admitted send cannot be recalled.", state: extend(state, {size: state.size - 1n, offset: 0n, queue: {front: Appointments.remove(state.queue.front, input.id), back: Appointments.remove(state.queue.back, input.id)}, last: {id: input.id, generation: input.generation, status: "cancelled"}}), result: {status: "cancelled", id: input.id, generation: input.generation, now: state.now}}
def status(state: State, input: Cancel, context: Abi.Context) -> Decision:
  let active = Appointments.active(state.queue.front, input.id, input.generation) || Appointments.active(state.queue.back, input.id, input.generation)
  {accepted: true, reason: "", state: state, result: {status: if active then "queued" else "absent", id: input.id, generation: input.generation, now: state.now}}
def tick(state: State, input: Tick, context: Abi.Context) -> Effects:
  let a = Appointments.advance(state.queue, state.last, input.now, state.size > 0n)
  let b = Appointments.advance(a.queue, a.last, input.now, state.size > 1n)
  let c = Appointments.advance(b.queue, b.last, input.now, state.size > 2n)
  let d = Appointments.advance(c.queue, c.last, input.now, state.size > 3n)
  let ok = input.now >= state.now
  {accepted: ok, reason: if ok then "" else "Logical time cannot run backwards.", state: extend(state, {now: input.now, size: state.size - a.removed - b.removed - c.removed - d.removed, offset: 0n, queue: d.queue, last: d.last}), result: {status: "swept", id: d.last.id, generation: d.last.generation, now: input.now}, emissions: E.append(a.emission, E.append(b.emission, E.append(c.emission, d.emission)))}
def sample(state: State, input: Sample, context: Abi.Context) -> Effects:
  let valid = state.quantumMillis > 0n && input.unixMillis >= state.epochMillis && input.unixMillis >= state.observedMillis
  let decision = tick(state, {now: (input.unixMillis - state.epochMillis) / (if state.quantumMillis == 0n then 1n else state.quantumMillis)}, context)
  extend(decision, {accepted: valid && decision.accepted, reason: if valid then decision.reason else "Physical observation predates the epoch, rolls backwards, or has an invalid quantum.", state: extend(decision.state, {observedMillis: input.unixMillis})})
def page(state: State, input: Page, context: Abi.Context) -> Decision:
  let ok = input.offset == 0n || input.offset < state.size
  {accepted: ok, reason: if ok then "" else "Choose a page within the active queue.", state: extend(state, {offset: input.offset}), result: {status: "page", id: "", generation: state.nextGeneration, now: state.now}}
record RequestForm:
  label: String
  fields: {id: Abi.StringField, generation: Abi.NatField, due: Abi.NatField, deadline: Abi.NatField, to: Abi.StringField, recipientProgram: Abi.StringField, topic: Abi.StringField}
record CancelForm:
  label: String
  fields: {id: Abi.StringField, generation: Abi.NatField}
record QuoteForm:
  label: String
  fields: {id: Abi.StringField, due: Abi.NatField, deadline: Abi.NatField, to: Abi.StringField, recipientProgram: Abi.StringField, topic: Abi.StringField}
record TickForm:
  label: String
  fields: {now: Abi.NatField}
record SampleForm:
  label: String
  fields: {unixMillis: Abi.NatField}
record PageForm:
  label: String
  fields: {offset: Abi.NatField}
record Description:
  name: String
  initial: State
  methods: {request: RequestForm, quote: QuoteForm, cancel: CancelForm, status: CancelForm, tick: TickForm, sample: SampleForm, page: PageForm}
  panels: {}
def naturalField() -> Abi.NatField:
  {type: "nat", minimum: 0n, maximum: 9007199254740991n}
def textField() -> Abi.StringField:
  {type: "string", minLength: 1n, maxLength: 256n}
def describe() -> Description:
  {name: "Appointments", initial: configured({capacity: 16n}), methods: {request: {label: "Book an appointment", fields: {id: textField(), generation: naturalField(), due: naturalField(), deadline: naturalField(), to: textField(), recipientProgram: {type: "string", minLength: 64n, maxLength: 64n}, topic: textField()}}, quote: {label: "Quote the current generation", fields: {id: textField(), due: naturalField(), deadline: naturalField(), to: textField(), recipientProgram: textField(), topic: textField()}}, cancel: {label: "Cancel my queued generation", fields: {id: textField(), generation: naturalField()}}, status: {label: "Observe this generation at its clock", fields: {id: textField(), generation: naturalField()}}, tick: {label: "Driver: advance explicit logical time", fields: {now: naturalField()}}, sample: {label: "Driver: retain a physical observation", fields: {unixMillis: naturalField()}}, page: {label: "Browse active appointments", fields: {offset: naturalField()}}}, panels: {}}
record BookAction:
  visible: Bool
  text: String
  command: String
  input: {generation: Nat}
record CancelAction:
  visible: Bool
  text: String
  command: String
  input: Cancel
record PageAction:
  visible: Bool
  text: String
  command: String
  input: Page
record View:
  title: String
  prose: String
  actions: {book: BookAction, a: CancelAction, b: CancelAction, c: CancelAction, d: CancelAction, next: PageAction, previous: PageAction}
  children: Encounter.Children
def cancellation(xs: Appointments.Entries) -> CancelAction:
  match xs:
    case nil(_): {visible: false, text: "", command: "cancel", input: {id: "", generation: 0n}}
    case cons(c): {visible: true, text: c.head.topic, command: "cancel", input: {id: c.head.id, generation: c.head.generation}}
def recipients(xs: Appointments.Entries, remaining: Nat) -> Encounter.Children:
  match xs:
    case nil(_): Encounter.Children.nil()
    case cons(c): if remaining == 0n then Encounter.Children.nil() else Encounter.Children.cons({head: {key: c.head.id, label: c.head.topic, object: c.head.to, panel: "main"}, tail: recipients(c.tail, remaining - 1n)})
def view(state: State, panel: String) -> View:
  let a = Appointments.skip(Appointments.ordered(state.queue), state.offset)
  let b = Appointments.tail(a)
  let c = Appointments.tail(b)
  let d = Appointments.tail(c)
  {title: if state.size == 0n then "No queued appointments" else "Queued appointments", prose: "Browse four active appointments per page. Look inside shows exact id, generation, due time and deadline. Cancellation removes only queued work; an admitted send cannot be recalled. A refused tick leaves the queue unchanged; its retained receipt explains the failure. Completed entries leave the queue; the last summary and native receipts retain their outcome.", actions: {book: {visible: state.size < state.capacity, text: "Book an appointment", command: "request", input: {generation: state.nextGeneration}}, a: cancellation(a), b: cancellation(b), c: cancellation(c), d: cancellation(d), next: {visible: state.offset + 4n < state.size, text: "Next four appointments", command: "page", input: {offset: state.offset + 4n}}, previous: {visible: state.offset > 0n, text: "Previous four appointments", command: "page", input: {offset: state.offset - 4n}}}, children: recipients(a, 4n)}
