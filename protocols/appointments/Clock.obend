edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Encounter.obend as Encounter
import ./Appointments.obend as Appointments
record Config:
  capacity: Nat
record State:
  now: Nat
  nextGeneration: Nat
  size: Nat
  capacity: Nat
  offset: Nat
  queue: Appointments.Queue
  last: Appointments.Last
record Request:
  id: String
  generation: Nat
  due: Nat
  deadline: Nat
  to: String
  recipientProgram: String
  topic: String
record Cancel:
  id: String
  generation: Nat
record Tick:
  now: Nat
record Page:
  offset: Nat
record Result:
  status: String
  id: String
  generation: Nat
  now: Nat
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Result
record Effects:
  accepted: Bool
  reason: String
  state: State
  result: Result
  emissions: Appointments.Slots
def configured(config: Config) -> State:
  {now: 0n, nextGeneration: 1n, size: 0n, capacity: config.capacity, offset: 0n, queue: Appointments.empty(), last: {id: "", generation: 0n, status: "none"}}
def request(state: State, input: Request, context: Abi.Context) -> Decision:
  let unique = Appointments.contains(state.queue.front, input.id) == false && Appointments.contains(state.queue.back, input.id) == false
  let ok = state.capacity > 0n && state.capacity <= 24n && state.size < state.capacity && unique && input.id != "" && input.generation == state.nextGeneration && input.due >= state.now && input.deadline >= input.due && input.to != "" && input.topic != ""
  let item: Appointments.Item = {id: input.id, owner: context.principal, generation: input.generation, due: input.due, deadline: input.deadline, to: input.to, recipientProgram: input.recipientProgram, topic: input.topic}
  {accepted: ok, reason: if ok then "" else "Use a unique active id, the clock's next generation, available capacity (1..24), and ordered future times.", state: {now: state.now, nextGeneration: state.nextGeneration + 1n, size: state.size + 1n, capacity: state.capacity, offset: state.offset, queue: Appointments.push(state.queue, item), last: state.last}, result: {status: "queued", id: input.id, generation: input.generation, now: state.now}}
def cancel(state: State, input: Cancel, context: Abi.Context) -> Decision:
  let ok = Appointments.owns(state.queue.front, input.id, input.generation, context.principal) || Appointments.owns(state.queue.back, input.id, input.generation, context.principal)
  {accepted: ok, reason: if ok then "" else "Only the owner can cancel this queued generation. An admitted send cannot be recalled.", state: {now: state.now, nextGeneration: state.nextGeneration, size: state.size - 1n, capacity: state.capacity, offset: 0n, queue: {front: Appointments.remove(state.queue.front, input.id), back: Appointments.remove(state.queue.back, input.id)}, last: {id: input.id, generation: input.generation, status: "cancelled"}}, result: {status: "cancelled", id: input.id, generation: input.generation, now: state.now}}
def tick(state: State, input: Tick, context: Abi.Context) -> Effects:
  let a = Appointments.advance(state.queue, state.last, input.now, state.size > 0n)
  let b = Appointments.advance(a.queue, a.last, input.now, state.size > 1n)
  let c = Appointments.advance(b.queue, b.last, input.now, state.size > 2n)
  let d = Appointments.advance(c.queue, c.last, input.now, state.size > 3n)
  let ok = input.now >= state.now
  {accepted: ok, reason: if ok then "" else "Logical time cannot run backwards.", state: {now: input.now, nextGeneration: state.nextGeneration, size: state.size - a.removed - b.removed - c.removed - d.removed, capacity: state.capacity, offset: 0n, queue: d.queue, last: d.last}, result: {status: "swept", id: d.last.id, generation: d.last.generation, now: input.now}, emissions: {a: a.emission, b: b.emission, c: c.emission, d: d.emission}}
def page(state: State, input: Page, context: Abi.Context) -> Decision:
  let ok = input.offset == 0n || input.offset < state.size
  {accepted: ok, reason: if ok then "" else "Choose a page within the active queue.", state: {now: state.now, nextGeneration: state.nextGeneration, size: state.size, capacity: state.capacity, offset: input.offset, queue: state.queue, last: state.last}, result: {status: "page", id: "", generation: state.nextGeneration, now: state.now}}
record RequestForm:
  label: String
  fields: {id: Abi.StringField, generation: Abi.NatField, due: Abi.NatField, deadline: Abi.NatField, to: Abi.StringField, recipientProgram: Abi.StringField, topic: Abi.StringField}
record CancelForm:
  label: String
  fields: {id: Abi.StringField, generation: Abi.NatField}
record TickForm:
  label: String
  fields: {now: Abi.NatField}
record PageForm:
  label: String
  fields: {offset: Abi.NatField}
record Description:
  name: String
  initial: State
  methods: {request: RequestForm, cancel: CancelForm, tick: TickForm, page: PageForm}
  panels: {}
def naturalField() -> Abi.NatField:
  {type: "nat", minimum: 0n, maximum: 9007199254740991n}
def textField() -> Abi.StringField:
  {type: "string", minLength: 1n, maxLength: 256n}
def describe() -> Description:
  {name: "Appointments", initial: configured({capacity: 16n}), methods: {request: {label: "Book an appointment", fields: {id: textField(), generation: naturalField(), due: naturalField(), deadline: naturalField(), to: textField(), recipientProgram: {type: "string", minLength: 64n, maxLength: 64n}, topic: textField()}}, cancel: {label: "Cancel my queued generation", fields: {id: textField(), generation: naturalField()}}, tick: {label: "Driver: advance explicit logical time", fields: {now: naturalField()}}, page: {label: "Browse active appointments", fields: {offset: naturalField()}}}, panels: {}}
record BookAction:
  visible: Bool
  text: String
  command: String
  input: {generation: Nat}
record CancelAction:
  visible: Bool
  text: String
  command: String
  input: Cancel
record PageAction:
  visible: Bool
  text: String
  command: String
  input: Page
record View:
  title: String
  prose: String
  actions: {book: BookAction, a: CancelAction, b: CancelAction, c: CancelAction, d: CancelAction, next: PageAction, previous: PageAction}
  children: Encounter.Children
def cancellation(xs: Appointments.Entries) -> CancelAction:
  match xs:
    case nil(_): {visible: false, text: "", command: "cancel", input: {id: "", generation: 0n}}
    case cons(c): {visible: true, text: c.head.topic, command: "cancel", input: {id: c.head.id, generation: c.head.generation}}
def recipients(xs: Appointments.Entries, remaining: Nat) -> Encounter.Children:
  match xs:
    case nil(_): Encounter.Children.nil()
    case cons(c): if remaining == 0n then Encounter.Children.nil() else Encounter.Children.cons({head: {key: c.head.id, label: c.head.topic, object: c.head.to, panel: "main"}, tail: recipients(c.tail, remaining - 1n)})
def view(state: State, panel: String) -> View:
  let a = Appointments.skip(Appointments.ordered(state.queue), state.offset)
  let b = Appointments.tail(a)
  let c = Appointments.tail(b)
  let d = Appointments.tail(c)
  {title: if state.size == 0n then "No queued appointments" else "Queued appointments", prose: "Browse four active appointments per page. Look inside shows exact id, generation, due time and deadline. Cancellation removes only queued work; an admitted send cannot be recalled. A refused tick leaves the queue unchanged; its retained receipt explains the failure. Completed entries leave the queue; the last summary and native receipts retain their outcome.", actions: {book: {visible: state.size < state.capacity, text: "Book an appointment", command: "request", input: {generation: state.nextGeneration}}, a: cancellation(a), b: cancellation(b), c: cancellation(c), d: cancellation(d), next: {visible: state.offset + 4n < state.size, text: "Next four appointments", command: "page", input: {offset: state.offset + 4n}}, previous: {visible: state.offset > 0n, text: "Previous four appointments", command: "page", input: {offset: state.offset - 4n}}}, children: recipients(a, 4n)}
