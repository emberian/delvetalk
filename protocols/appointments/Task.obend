edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Encounter.obend as Encounter
import ./Preparation.obend as P
import ./Emissions.obend as E
import ./Appointments.obend as Appointments
record Config:
  owner: String
  clock: String
record State:
  owner: String
  clock: String
  runs: Nat
  lastTopic: String
  lastTick: Nat
  lastId: String
  lastGeneration: Nat
  lastEvent: String
record Result:
  action: String
  runs: Nat
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Result
def configured(config: Config) -> State:
  {owner: config.owner, clock: config.clock, runs: 0n, lastTopic: "", lastTick: 0n, lastId: "", lastGeneration: 0n, lastEvent: ""}
def wake(state: State, value: P.Value, context: Abi.Context, event: E.CausalEvent) -> Decision:
  match Appointments.readPayload(value):
    case missing(failure): {accepted: false, reason: textConcat("Missing appointment payload field: ", failure.field), state: state, result: {action: "", runs: state.runs}}
    case wrongKind(failure): {accepted: false, reason: textConcat("Wrong appointment payload field type: ", failure.field), state: state, result: {action: "", runs: state.runs}}
    case found(parsed):
      let input = parsed.value
      let ok = event.source == state.clock && input.owner == state.owner && input.tick >= input.due && input.tick <= input.deadline
      {accepted: ok, reason: if ok then "" else "This task accepts its owner's timely appointments from its named clock.", state: {owner: state.owner, clock: state.clock, runs: state.runs + 1n, lastTopic: input.topic, lastTick: input.tick, lastId: input.id, lastGeneration: input.generation, lastEvent: event.id}, result: {action: input.topic, runs: state.runs + 1n}}
record WakeForm:
  label: String
  inputCodec: String
  fields: {owner: Abi.StringField, id: Abi.StringField, generation: Abi.NatField, due: Abi.NatField, deadline: Abi.NatField, tick: Abi.NatField, topic: Abi.StringField}
record Description:
  name: String
  initial: State
  methods: {wake: WakeForm}
  panels: {owner: String, clock: String, activity: String}
def textField() -> Abi.StringField:
  {type: "string", minLength: 1n, maxLength: 256n}
def naturalField() -> Abi.NatField:
  {type: "nat", minimum: 0n, maximum: 9007199254740991n}
def describe() -> Description:
  {name: "Scheduled task", initial: configured({owner: "moss", clock: "clock"}), methods: {wake: {label: "Receive an admitted appointment", inputCodec: "value", fields: {owner: textField(), id: textField(), generation: naturalField(), due: naturalField(), deadline: naturalField(), tick: naturalField(), topic: textField()}}}, panels: {owner: "Task owner", clock: "Appointment clock", activity: "Latest activity"}}
record View:
  title: String
  prose: String
  actions: {}
  children: Encounter.Children
def view(state: State, panel: String) -> View:
  {title: if state.runs == 0n then "Waiting for an appointment" else "Appointment received", prose: if panel == "owner" then state.owner else if panel == "clock" then state.clock else if state.runs == 0n then "This task listens to its owner's admitted appointments. Only native delivery can wake it. Look inside shows exact run count, tick, id, generation and event identity." else state.lastTopic, actions: {}, children: Encounter.Children.cons({head: {key: "clock", label: "Appointment clock", object: state.clock, panel: "main"}, tail: Encounter.Children.nil()})}
