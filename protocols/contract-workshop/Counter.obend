edition ObjectiveBend 1

record State:
  count: Nat
record Input:
  amount: Nat
record Context:
  object: String
  principal: String
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Nat
record Counter:
  add(state: State, input: Input, context: Context) -> Decision

# This specification's checked method row is the receiving interface bound.
# Its implementation and claims do not prove the behavior of another program.
spec CounterContract for Counter:
  def add(state: State, input: Input, context: Context) -> Decision:
    {accepted: true, reason: "", state: state, result: state.count}
  claim preservesCount(n: Nat): true

def contract() -> Specification<Counter>:
  CounterContract

# A separate implementation can satisfy the interface and do different work.
def add(state: State, input: Input, context: Context) -> Decision:
  {accepted: true, reason: "", state: {count: state.count + input.amount}, result: state.count + input.amount}

record Method:
  label: String
  fields: {amount: {type: String, maximum: Nat}}
record Description:
  name: String
  initial: State
  methods: {add: Method}
  panels: {}
record Action:
  visible: Bool
  text: String
  command: String
  input: {amount: Nat}
record View:
  title: String
  prose: String
  actions: {add: Action}
def describe() -> Description:
  {name: "The governed counter", initial: {count: 0}, methods: {add: {label: "Add to the counter", fields: {amount: {type: "nat", maximum: 100}}}}, panels: {}}
def view(state: State, panel: String) -> View:
  {title: "The governed counter", prose: "Its method promise belongs to the current law.", actions: {add: {visible: true, text: "Add one", command: "add", input: {amount: 1}}}}
