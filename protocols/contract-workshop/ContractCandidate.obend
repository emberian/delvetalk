edition ObjectiveBend 1
import ./Preparation.obend as P
import ./Candidate.obend as C
import ./ContractWorkshop.obend as W

# A candidate gains a contract workshop by ordinary source composition.
export C.ordinary
def describe() -> C.Description:
  extend(C.describe(), {name: "ContractCandidate", initial: C.ordinary()})
export C.submit
export C.requestCheck
export C.prepareInspectProposal
export C.prepareCompilerWork
export C.compiled
export C.failed
export C.report
export C.adopt
export C.prepareRelease
def prepareContract(state: C.State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.textField(state.proposal, "syntax"):
    case missing(_): P.Preparation.refused({message: "The checked proposal must retain its source syntax."})
    case wrongKind(_): P.Preparation.refused({message: "The checked proposal syntax must be text."})
    case found(t): W.prepare(state.status, state.target, state.protocol, t.value, contribution, observations, context)
export C.view
