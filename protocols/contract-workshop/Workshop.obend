edition ObjectiveBend 1
import ./Preparation.obend as P

# Contract meaning is chosen here; the compiler supplies exact source and metadata.
def text(value: String) -> P.Value:
  P.Value.text({value: value})
def pair(name: String, value: P.Value, tail: P.Fields) -> P.Fields:
  P.Fields.cons({head: {name: name, value: value}, tail: tail})
def replaced(fields: P.Fields, name: String, value: P.Value) -> P.Fields:
  match fields:
    case nil(_): pair(name, value, P.Fields.nil())
    case cons(c): if c.head.name == name then pair(name, value, c.tail) else P.Fields.cons({head: c.head, tail: replaced(c.tail, name, value)})
def install(law: P.Value, contract: P.Value) -> P.Value:
  match law:
    case record(r): P.Value.record({fields: replaced(replaced(r.fields, "profile", text("delvetalk-scoped-law")), "contract", contract)})
    case retained(_): P.Value.none()
    case none(_): P.Value.none()
    case boolean(_): P.Value.none()
    case natural(_): P.Value.none()
    case number(_): P.Value.none()
    case text(_): P.Value.none()
    case array(_): P.Value.none()
def prepareCaptured(status: String, target: String, program: P.Value, syntax: String, contribution: P.Value, entry: String, captured: P.Observation, context: P.Context) -> P.Preparation:
  let table: P.Value = P.get(P.get(program, "sourcePackages"), "resident")
  let package: P.Value = P.Value.record({fields: pair("modules", P.get(table, "modules"), pair("entry", text(entry), P.Fields.nil()))})
  let contract: P.Value = P.Value.record({fields: pair("profile", text("delvetalk-source-contract-v1"), pair("package", package, pair("stateProfile", text("model"), pair("metadata", P.get(contribution, "metadata"), P.Fields.nil()))))})
  if status != "ready" then P.Preparation.refused({message: "Check this candidate before installing its promise."}) else if target == "" || target == context.object then P.Preparation.refused({message: "The contract requires a distinct governed target."}) else if captured.object != target then P.Preparation.refused({message: "Capture the governed target and its current law."}) else if P.textEquals(P.get(captured.law, "profile"), "delvetalk-scoped-law") == false then P.Preparation.refused({message: "Contract installation requires an explicit scoped law."}) else if syntax != "objective-bend-object" then P.Preparation.refused({message: "A source promise requires an Objective Bend package."}) else if P.textEquals(P.get(table, "format"), "delvetalk-source-package-table-v1") == false then P.Preparation.refused({message: "The checked candidate must retain its source package."}) else if entry == "" then P.Preparation.refused({message: "Name the specification export."}) else P.Preparation.ready({summary: "Install this checked source promise under the captured current law.", reads: P.Reads.cons({head: P.Read.existing({object: context.object}), tail: P.Reads.cons({head: P.Read.existing({object: target}), tail: P.Reads.nil()})}), calls: P.Effects.cons({head: P.Effect.invoke({object: context.object, command: "adopt", input: P.oneField("target", text(target))}), tail: P.Effects.cons({head: P.Effect.law({object: target, law: install(captured.law, contract)}), tail: P.Effects.nil()})})})
def prepareEntry(status: String, target: String, program: P.Value, syntax: String, contribution: P.Value, captured: P.Observation, context: P.Context) -> P.Preparation:
  match P.textField(contribution, "entry"):
    case missing(_): P.Preparation.refused({message: "Name the specification export."})
    case wrongKind(_): P.Preparation.refused({message: "The specification export must be text."})
    case found(t): prepareCaptured(status, target, program, syntax, contribution, t.value, captured, context)
def prepare(status: String, target: String, program: P.Value, syntax: String, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.lookupObservation(observations, target):
    case missing(_): P.Preparation.refused({message: "Capture the governed target and its current law."})
    case found(o): prepareEntry(status, target, program, syntax, contribution, o.value, context)
