edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Preparation.obend as P
import ./Emissions.obend as E
import ./Encounter.obend as Encounter
# A deliberately cyclic resident for exercising native causal ceilings.
# The initiating call supplies the observed exact program, as source preparation
# does for ordinary connections; every descendant preserves that binding.
record State:
  turns: Nat
  object: String
  program: String
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Nat
  emissions: E.Emissions
def next(state: State) -> E.Emissions:
  E.one({to: state.object, command: "receive", recipientProgram: state.program, payload: P.oneField("tick", P.Value.natural({value: state.turns}))})
def start(state: State, input: {object: String, program: String}, context: Abi.Context) -> Decision:
  let allowed = input.object != "" && textLength(input.object) <= 128n && textLength(input.program) == 64n
  let joined = if allowed then extend(state, {object: input.object, program: input.program}) else state
  {accepted: allowed, reason: if allowed then "" else "Capture the exact cyclic recipient.", state: joined, result: joined.turns, emissions: if allowed then next(joined) else E.empty()}
def receive(state: State, input: P.Value, context: Abi.Context, event: E.CausalEvent) -> Decision:
  let allowed = event.source == state.object && event.sourceProgram == state.program
  let advanced = if allowed then extend(state, {turns: state.turns + 1n}) else state
  {accepted: allowed, reason: if allowed then "" else "Only the captured cycle can continue.", state: advanced, result: advanced.turns, emissions: if allowed then next(advanced) else E.empty()}
record Description:
  name: String
  initial: State
  methods: {start: {label: String, fields: {object: Abi.StringField, program: Abi.StringField}}, receive: {label: String, fields: {tick: Abi.NatField}, inputCodec: String}}
  panels: {}
def describe() -> Description:
  {name: "Bounded causal cycle", initial: {turns: 0n, object: "", program: ""}, methods: {start: {label: "Begin captured cycle", fields: {object: {type: "string", minLength: 1n, maxLength: 128n}, program: {type: "string", minLength: 64n, maxLength: 64n}}}, receive: {label: "Continue causal cycle", fields: {tick: {type: "nat", minimum: 0n, maximum: 65535n}}, inputCodec: "value"}}, panels: {}}

record View:
  title: String
  prose: String
  actions: {}
  children: Encounter.Children
def view(state: State, panel: String) -> View:
  {title: "Bounded causal cycle", prose: "A source loop exercises receiving limits.", actions: {}, children: Encounter.Children.nil()}
