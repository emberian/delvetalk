edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Preparation.obend as P
import ./Encounter.obend as Encounter
import ./Emissions.obend as E
record State:
  source: String
  open: Bool
  heard: Nat
  lastEvent: String
  lastSource: String
  lastProgram: String
  lastPlayer: String
  lastRelay: String
  lastRootPlayer: String
  lastRoot: String
  lastParent: String
  lastDepth: Nat
  recipient: String
  recipientProgram: String
record Result:
  disposition: String
  heard: Nat
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Result
  emissions: E.Emissions
def hear(state: State, input: P.Value, context: Abi.Context, event: E.CausalEvent) -> Decision:
  let chord = P.textOrEmpty(P.get(input, "chord"))
  let accepted = event.source == state.source && (chord == "C E G" || chord == "decline")
  let decline = chord == "decline"
  let reaction = accepted && decline == false && state.recipientProgram != ""
  {accepted: accepted, reason: if accepted then "" else "This door listens for the courtyard bell's C E G chord.", state: if accepted && decline == false then extend(state, {open: true, heard: state.heard + 1n, lastEvent: event.id, lastSource: event.source, lastProgram: event.sourceProgram, lastPlayer: event.originatingPrincipal, lastRelay: context.principal, lastRootPlayer: event.rootPrincipal, lastRoot: event.root, lastParent: event.parent, lastDepth: event.depth}) else state, result: {disposition: if decline then "declined" else "opened", heard: if accepted && decline == false then state.heard + 1n else state.heard}, emissions: if reaction then E.one({to: state.recipient, command: "glow", recipientProgram: state.recipientProgram, payload: P.oneField("chord", P.Value.text({value: chord}))}) else E.empty()}
record Bound:
  accepted: Bool
  reason: String
  state: State
  result: String
def bind(state: State, input: P.Value, context: Abi.Context) -> Bound:
  let target = P.textOrEmpty(P.get(input, "object"))
  let program = P.textOrEmpty(P.get(input, "program"))
  let accepted = P.isText(P.get(input, "object")) && P.isText(P.get(input, "program")) && target == state.recipient && textLength(program) == 64n
  {accepted: accepted, reason: if accepted then "" else "Capture this door's chosen light before connecting it.", state: if accepted then extend(state, {recipientProgram: program}) else state, result: target}
def prepareBind(state: State, input: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.lookupObservation(observations, state.recipient):
    case missing(_): P.Preparation.refused({message: "Capture the selected light before connecting it."})
    case found(found): prepareCapturedBind(state, found.value, context)
def prepareCapturedBind(state: State, observed: P.Observation, context: P.Context) -> P.Preparation:
  if observed.object != state.recipient || textLength(observed.program) != 64n then P.Preparation.refused({message: "The selected light is not captured here."}) else P.Preparation.ready({summary: "Let the door light its observed lantern when the bell opens it.", reads: P.Reads.cons({head: P.Read.existing({object: state.recipient}), tail: P.Reads.nil()}), calls: P.Effects.cons({head: P.Effect.invoke({object: context.object, command: "bind", input: P.Value.record({fields: P.Fields.cons({head: {name: "object", value: P.Value.text({value: state.recipient})}, tail: P.Fields.cons({head: {name: "program", value: P.Value.text({value: observed.program})}, tail: P.Fields.nil()})})})}), tail: P.Effects.nil()})})
record Description:
  name: String
  initial: State
  methods: {hear: {label: String, fields: {chord: Abi.StringField}, inputCodec: String}, bind: {label: String, fields: {}, inputCodec: String}}
  panels: {}
def describe() -> Description:
  {name: "Listening door", initial: {source: "bell", open: false, heard: 0n, lastEvent: "", lastSource: "", lastProgram: "", lastPlayer: "", lastRelay: "", lastRootPlayer: "", lastRoot: "", lastParent: "", lastDepth: 0n, recipient: "lantern", recipientProgram: ""}, methods: {hear: {label: "Hear an admitted sound", fields: {chord: {type: "string", minLength: 1n, maxLength: 128n}}, inputCodec: "value"}, bind: {label: "Connect the captured light", fields: {}, inputCodec: "value"}}, panels: {}}
def configured(config: {source: String, recipient: String}) -> State:
  extend(describe().initial, {source: config.source, recipient: config.recipient})
record Invitation:
  visible: Bool
  text: String
  prepare: String
  fields: {}
  observations: P.Requests
record View:
  title: String
  prose: String
  actions: {}
  children: Encounter.Children
  invitations: {bind: Invitation}
def view(state: State, panel: String) -> View:
  {title: "The listening door", prose: if state.open then "The door stands open. Its own source chooses whether the captured lantern hears the opening chord." else "The door opens when it hears the courtyard bell sing C E G. Connect its lantern to let the opening carry on.", actions: {}, children: Encounter.Children.cons({head: {key: "light", label: "The door's lantern", object: state.recipient, panel: "main"}, tail: Encounter.Children.nil()}), invitations: {bind: {visible: true, text: "Connect the lantern", prepare: "prepareBind", fields: {}, observations: P.Requests.cons({head: {object: state.recipient, inspectState: false, inspectLaw: false}, tail: P.Requests.nil()})}}}
