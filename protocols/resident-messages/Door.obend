edition ObjectiveBend 1
record State:
  open: Bool
  heard: Nat
  lastEvent: String
  lastSource: String
  lastProgram: String
  lastPlayer: String
  lastRelay: String
record Payload:
  chord: String
record Origin:
  kind: String
  object: String
  command: String
  immediatelyPrevious: Bool
record Context:
  object: String
  principal: String
  inputOrigin: Origin
record Event:
  id: String
  source: String
  sourceProgram: String
  originatingPrincipal: String
record Result:
  disposition: String
  heard: Nat
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Result
def hear(state: State, input: Payload, context: Context, event: Event) -> Decision:
  let accepted: Bool = event.source == "bell" && (input.chord == "C E G" || input.chord == "decline") in let decline: Bool = input.chord == "decline" in {accepted: accepted, reason: if accepted then "" else "This door listens for the courtyard bell's C E G chord.", state: if decline then state else {open: true, heard: state.heard + 1n, lastEvent: event.id, lastSource: event.source, lastProgram: event.sourceProgram, lastPlayer: event.originatingPrincipal, lastRelay: context.principal}, result: {disposition: if decline then "declined" else "opened", heard: if decline then state.heard else state.heard + 1n}}
record StringField:
  type: String
  minLength: Nat
  maxLength: Nat
record NatField:
  type: String
  minimum: Nat
  maximum: Nat
record Form:
  label: String
  fields: {chord: StringField}
record Description:
  name: String
  initial: State
  methods: {hear: Form}
  panels: {}
def describe() -> Description:
  {name: "Courtyard hear", initial: {open: false, heard: 0, lastEvent: "", lastSource: "", lastProgram: "", lastPlayer: "", lastRelay: ""}, methods: {hear: {label: "hear", fields: {chord: {type: "string", minLength: 1, maxLength: 128}}}}, panels: {}}
record Child:
  key: String
  label: String
  object: String
  panel: String
sum Children:
  nil: {}
  cons: {head: Child, tail: Children}
record View:
  title: String
  prose: String
  actions: {}
  children: Children
def view(state: State, panel: String) -> View:
  {title: "The listening door", prose: "The door opens when it hears the courtyard bell sing C E G.", actions: {}, children: Children.nil()}
