edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Preparation.obend as P
import ./Encounter.obend as Encounter
import ./Emissions.obend as E
record State:
  source: String
  glows: Nat
  lastSource: String
  lastEmitterActor: String
  lastRootPlayer: String
  lastRelay: String
  lastEvent: String
  lastParent: String
  lastRoot: String
  lastDepth: Nat
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: String
def glow(state: State, input: P.Value, context: Abi.Context, event: E.CausalEvent) -> Decision:
  let accepted = event.source == state.source && P.textEquals(P.get(input, "chord"), "C E G")
  {accepted: accepted, reason: if accepted then "" else "This lantern listens for the opening door.", state: if accepted then {source: state.source, glows: state.glows + 1n, lastSource: event.source, lastEmitterActor: event.originatingPrincipal, lastRootPlayer: event.rootPrincipal, lastRelay: context.principal, lastEvent: event.id, lastParent: event.parent, lastRoot: event.root, lastDepth: event.depth} else state, result: if accepted then "The lantern glows." else ""}
record Description:
  name: String
  initial: State
  methods: {glow: {label: String, fields: {chord: Abi.StringField}, inputCodec: String}}
  panels: {}
def describe() -> Description:
  {name: "Courtyard lantern", initial: {source: "door", glows: 0n, lastSource: "", lastEmitterActor: "", lastRootPlayer: "", lastRelay: "", lastEvent: "", lastParent: "", lastRoot: "", lastDepth: 0n}, methods: {glow: {label: "Receive the opening light", fields: {chord: {type: "string", minLength: 1n, maxLength: 128n}}, inputCodec: "value"}}, panels: {}}
def configured(config: {source: String}) -> State:
  extend(describe().initial, {source: config.source})
record View:
  title: String
  prose: String
  actions: {}
  children: Encounter.Children
def view(state: State, panel: String) -> View:
  {title: "The courtyard lantern", prose: if state.glows == 0n then "A lantern waits for the door to open." else textConcat("The lantern glows after a chord begun by ", textConcat(state.lastRootPlayer, ". Its door and relay remain separately attributed.")), actions: {}, children: Encounter.Children.nil()}
