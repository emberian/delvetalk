edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Encounter.obend as E

record State:
  text: String
record Input:
  text: String
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: String
def write(state: State, input: Input, context: Abi.Context) -> Decision:
  let accepted: Bool = textLength(input.text) <= 512n
  {accepted: accepted, reason: if accepted then "" else "Use at most 512 characters.", state: if accepted then {text: input.text} else state, result: input.text}
record Field:
  type: String
  minLength: Nat
  maxLength: Nat
record Description:
  name: String
  initial: State
  methods: {write: {label: String, fields: {text: Field}}}
  panels: {}
def describe() -> Description:
  {name: "A new object", initial: {text: ""}, methods: {write: {label: "Write", fields: {text: {type: "string", minLength: 0n, maxLength: 512n}}}}, panels: {}}
record Action:
  visible: Bool
  text: String
  command: String
  input: {}
record View:
  title: String
  prose: String
  actions: {write: Action}
  children: E.Children
def view(state: State, panel: String) -> View:
  {title: "A new object", prose: state.text, actions: {write: {visible: true, text: "Write", command: "write", input: {}}}, children: E.Children.nil()}
