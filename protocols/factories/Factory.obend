edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Preparation.obend as P
import ./Allocation.obend as A
import ./Encounter.obend as E
import ./Creation.obend as C

record Config:
  object: P.Value
  participants: P.Value
  read: P.Value
record State:
  object: P.Value
  participants: P.Value
  read: P.Value
  last: String
def initial(config: Config) -> State:
  {object: config.object, participants: config.participants, read: config.read, last: ""}
def ordinary(object: P.Value) -> State:
  {object: object, participants: P.Value.none(), read: P.Value.text({value: "public"}), last: ""}
def without(values: P.Values, maker: String) -> P.Values:
  match values:
    case nil(_): P.Values.nil()
    case cons(c): if P.textEquals(c.head, maker) then without(c.tail, maker) else P.Values.cons({head: c.head, tail: without(c.tail, maker)})
def people(state: State, maker: String) -> P.Value:
  match state.participants:
    case array(a): P.Value.array({values: P.Values.cons({head: P.Value.text({value: maker}), tail: without(a.values, maker)})})
    case none(_): P.Value.array({values: P.Values.cons({head: P.Value.text({value: maker}), tail: P.Values.nil()})})
    case boolean(_): P.Value.none()
    case natural(_): P.Value.none()
    case number(_): P.Value.none()
    case text(_): P.Value.none()
    case record(_): P.Value.none()
    case retained(_): P.Value.none()
def pair(name: String, value: P.Value, tail: P.Fields) -> P.Fields:
  P.Fields.cons({head: {name: name, value: value}, tail: tail})
def commandGrants(fields: P.Fields, principals: P.Value) -> P.Fields:
  match fields:
    case nil(_): P.Fields.nil()
    case cons(c): pair(c.head.name, principals, commandGrants(c.tail, principals))
def commandFields(value: P.Value) -> P.Fields:
  match value:
    case record(r): r.fields
    case none(_): P.Fields.nil()
    case retained(_): P.Fields.nil()
    case boolean(_): P.Fields.nil()
    case natural(_): P.Fields.nil()
    case number(_): P.Fields.nil()
    case text(_): P.Fields.nil()
    case array(_): P.Fields.nil()
def authority(state: State, maker: String) -> P.Value:
  let principals: P.Value = people(state, maker)
  P.Value.record({fields: pair("profile", P.Value.text({value: "delvetalk-scoped-law"}), pair("read", state.read, pair("invoke", P.Value.record({fields: commandGrants(commandFields(P.get(state.object, "commands")), principals)}), pair("reprogram", principals, pair("law", principals, P.Fields.nil())))))})
record Input:
  name: String
record Result:
  name: String
  maker: String
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Result
  allocations: A.Allocations
def make(state: State, input: Input, context: Abi.Context) -> Decision:
  let accepted: Bool = input.name != ""
  {accepted: accepted, reason: if accepted then "" else "Name the new object.", state: if accepted then extend(state, {last: input.name}) else state, result: {name: input.name, maker: context.principal}, allocations: if accepted then A.Allocations.cons({head: {name: input.name, protocol: state.object, law: authority(state, context.principal)}, tail: A.Allocations.nil()}) else A.Allocations.nil()}
record Field:
  type: String
  minLength: Nat
  maxLength: Nat
record Method:
  label: String
  fields: {name: Field}
record Description:
  name: String
  initial: State
  methods: {make: Method}
  panels: {last: String}
  allocation: {limit: Nat}
def describe() -> Description:
  {name: "Object workshop", initial: {object: P.Value.none(), participants: P.Value.none(), read: P.Value.text({value: "public"}), last: ""}, methods: {make: {label: "Make an object", fields: {name: {type: "string", minLength: 1n, maxLength: 64n}}}}, panels: {last: "Last made"}, allocation: {limit: 16n}}
record Invitation:
  visible: Bool
  text: String
  prepare: String
  fields: {name: Field}
  observations: P.Requests
record View:
  title: String
  prose: String
  actions: {}
  children: E.Children
  invitations: {make: Invitation}
def view(state: State, panel: String) -> View:
  {title: "Object workshop", prose: if panel == "last" then state.last else "Create an object, then teach it a new program. Its maker and the configured participants may use and govern it.", actions: {}, children: E.Children.nil(), invitations: {make: {visible: true, text: "Make an object", prepare: "prepareMake", fields: {name: {type: "string", minLength: 1n, maxLength: 64n}}, observations: P.Requests.nil()}}}
def prepareMake(state: State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.textField(contribution, "name"):
    case missing(_): P.Preparation.question({message: "Name the object.", needs: P.Names.cons({head: "name", tail: P.Names.nil()})})
    case wrongKind(_): P.Preparation.refused({message: "The object name must be text."})
    case found(t): if t.value == "" then P.Preparation.question({message: "Name the object.", needs: P.Names.cons({head: "name", tail: P.Names.nil()})}) else C.make(context.object, t.value, P.oneField("name", P.Value.text({value: t.value})), "Make an object with its captured workshop and absence roots.")
