{
  "lexicon": 1,
  "id": "town.delvetalk.listSessionRecords",
  "description": "A session's cards, entries and REPL objects in record shape, returned to its holder or a named reader and written nowhere.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "session",
          "collection"
        ],
        "properties": {
          "session": {
            "type": "string"
          },
          "collection": {
            "type": "string",
            "format": "nsid"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "records"
          ],
          "properties": {
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "value"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "cid": {
                    "type": "string",
                    "format": "cid"
                  },
                  "value": {
                    "type": "unknown"
                  }
                }
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthRequired"
        },
        {
          "name": "Denied"
        },
        {
          "name": "SessionExpired"
        }
      ]
    }
  }
}
