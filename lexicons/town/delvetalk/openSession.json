{
  "lexicon": 1,
  "id": "town.delvetalk.openSession",
  "description": "Open a scratch world (world-scratch), private to the caller and the readers named; served only as XRPC responses, never as repository records.",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Open a scratch world (world-scratch), private to the caller and the readers named; served only as XRPC responses, never as repository records. Inter-service auth: aud did:web:gsb.fg-goose.online#delvetalk, lxm this NSID.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 32
            },
            "from": {
              "type": "ref",
              "ref": "#fork"
            },
            "readers": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "did"
              },
              "maxLength": 8
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "session",
            "expires"
          ],
          "properties": {
            "session": {
              "type": "string",
              "description": "`scratch/<name>`."
            },
            "from": {
              "type": "unknown"
            },
            "readers": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "did"
              }
            },
            "expires": {
              "type": "integer",
              "minimum": 0,
              "description": "Home-world clock minute at which it is discarded if idle."
            },
            "expiresAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthRequired"
        },
        {
          "name": "InvalidToken"
        },
        {
          "name": "HostUnavailable"
        }
      ]
    },
    "fork": {
      "type": "object",
      "properties": {
        "world": {
          "type": "string"
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
