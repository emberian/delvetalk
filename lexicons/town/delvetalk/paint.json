{
  "lexicon": 1,
  "id": "town.delvetalk.paint",
  "description": "A card's verified paint (docs/OVERHAUL.md section 4): model prose, cached and never journaled, so outside the signed tree; the exact card is its strongRef.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "description": "Record key: `<object id, / as ~>.<version>`.",
      "record": {
        "type": "object",
        "required": [
          "object",
          "version",
          "card",
          "text"
        ],
        "properties": {
          "object": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "card": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "text": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    }
  }
}
