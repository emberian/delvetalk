{
  "lexicon": 1,
  "id": "town.delvetalk.page",
  "description": "A library page or walk (world/objects/Library.obend), as the library holds it.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "description": "Record key: the page's name.",
      "record": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "title",
          "body"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "page or walk"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "description": "The page's text, under a reply's clip."
          },
          "place": {
            "type": "integer"
          }
        }
      }
    }
  }
}
