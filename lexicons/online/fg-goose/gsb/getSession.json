{
  "lexicon": 1,
  "id": "online.fg-goose.gsb.getSession",
  "description": "A session's status, readers and expiry, to its holder or a named reader.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "session"
        ],
        "properties": {
          "session": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "session",
            "expires"
          ],
          "properties": {
            "session": {
              "type": "string",
              "description": "`scratch/<name>`."
            },
            "from": {
              "type": "unknown"
            },
            "readers": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "did"
              }
            },
            "expires": {
              "type": "integer",
              "minimum": 0,
              "description": "Home-world clock minute at which it is discarded if idle."
            },
            "expiresAt": {
              "type": "string",
              "format": "datetime"
            },
            "holder": {
              "type": "string",
              "format": "did"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthRequired"
        },
        {
          "name": "Denied"
        },
        {
          "name": "SessionExpired"
        }
      ]
    }
  }
}
