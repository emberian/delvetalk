{
  "lexicon": 1,
  "id": "online.fg-goose.gsb.getEntry",
  "description": "A journal entry's whole canonical bytes, to its own principal only.",
  "defs": {
    "main": {
      "type": "query",
      "description": "Inter-service auth: iss must be the entry's principal.",
      "parameters": {
        "type": "params",
        "required": [
          "entry"
        ],
        "properties": {
          "entry": {
            "type": "string",
            "description": "The entry's hash (CID).",
            "format": "cid"
          },
          "world": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/vnd.ipld.car",
        "description": "A CARv1 of the entry block, rooted at its CID."
      },
      "errors": [
        {
          "name": "AuthRequired"
        },
        {
          "name": "Denied"
        },
        {
          "name": "RecordNotFound"
        }
      ]
    }
  }
}
