{
  "lexicon": 1,
  "id": "online.fg-goose.gsb.act",
  "description": "Run one call as the caller's turn.",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Run one call as the caller's turn. Inter-service auth: aud did:web:gsb.fg-goose.online#delvetalk, lxm this NSID.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "call",
            "intent"
          ],
          "properties": {
            "call": {
              "type": "ref",
              "ref": "online.fg-goose.gsb.defs#call"
            },
            "intent": {
              "type": "string",
              "description": "The caller's idempotency key: the same intent answers the first receipt.",
              "maxLength": 256
            },
            "if": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "online.fg-goose.gsb.defs#pin"
              },
              "maxLength": 16
            },
            "world": {
              "type": "string",
              "description": "A durable world, or `scratch/<name>` of the caller's session; default the town."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "online.fg-goose.gsb.defs#answerView"
        }
      },
      "errors": [
        {
          "name": "AuthRequired"
        },
        {
          "name": "InvalidToken"
        },
        {
          "name": "HostUnavailable"
        }
      ]
    }
  }
}
