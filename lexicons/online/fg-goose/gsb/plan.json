{
  "lexicon": 1,
  "id": "online.fg-goose.gsb.plan",
  "description": "Run up to eight calls judged as one turn, all or nothing (host turn not yet built: answered unsupported).",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Run up to eight calls judged as one turn, all or nothing (host turn not yet built: answered unsupported). Inter-service auth: aud did:web:gsb.fg-goose.online#delvetalk, lxm this NSID.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "calls",
            "intent"
          ],
          "properties": {
            "calls": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "online.fg-goose.gsb.defs#call"
              },
              "minLength": 1,
              "maxLength": 8
            },
            "intent": {
              "type": "string",
              "maxLength": 256
            },
            "if": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "online.fg-goose.gsb.defs#pin"
              },
              "maxLength": 16
            },
            "world": {
              "type": "string",
              "description": "A durable world, or `scratch/<name>` of the caller's session; default the town."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "online.fg-goose.gsb.defs#answerView"
        }
      },
      "errors": [
        {
          "name": "AuthRequired"
        },
        {
          "name": "InvalidToken"
        },
        {
          "name": "HostUnavailable"
        }
      ]
    }
  }
}
