edition ObjectiveBend 1
record State:
  count: Nat
record Origin:
  kind: String
  object: String
  command: String
  program: String
  immediatelyPrevious: Bool
record Context:
  object: String
  principal: String
  inputOrigin: Origin
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: {previous: Nat}
record Field:
  type: String
  minimum: Nat
  maximum: Nat
record Method:
  label: String
  fields: {amount: Field}
record Description:
  name: String
  initial: State
  methods: {add: Method}
  panels: {}
record Action:
  visible: Bool
  text: String
  command: String
  input: {}
record Child:
  key: String
  label: String
  object: String
  panel: String
sum Children:
  nil: {}
  cons: {head: Child, tail: Children}
record View:
  title: String
  prose: String
  actions: {add: Action}
  children: Children
def describe() -> Description:
  {name: "Counter", initial: {count: 0n}, methods: {add: {label: "Add to the counter", fields: {amount: {type: "nat", minimum: 0n, maximum: 1000000000n}}}}, panels: {}}
def add(state: State, input: {amount: Nat}, context: Context) -> Decision:
  {accepted: true, reason: "", state: {count: state.count + input.amount}, result: {previous: state.count}}
def view(state: State, panel: String) -> View:
  {title: "Counter", prose: textConcat("Current count: ", natText(state.count)), actions: {add: {visible: true, text: "Add to the counter", command: "add", input: {}}}, children: Children.nil()}
