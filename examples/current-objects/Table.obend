edition ObjectiveBend 1
record State:
  title: String
  invitation: String
record Description:
  name: String
  initial: State
  methods: {}
  panels: {}
record Child:
  key: String
  label: String
  object: String
  panel: String
sum Children:
  nil: {}
  cons: {head: Child, tail: Children}
record View:
  title: String
  prose: String
  actions: {}
  children: Children
def describe() -> Description:
  {name: "The empty table", initial: {title: "The empty table", invitation: "Propose a shared activity here."}, methods: {}, panels: {}}
def view(state: State, panel: String) -> View:
  {title: state.title, prose: state.invitation, actions: {}, children: Children.nil()}
