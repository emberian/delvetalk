edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Kernel.obend as K
import ./Handler.obend as H
import ./SceneModel.obend as M
import ./DefaultScene.obend as Base

def validate() -> M.Validation:
  Base.validate()
def describe() -> M.Description:
  Base.describe()
def start(state: M.State, input: {}, context: Abi.Context) -> M.Decision:
  Base.start(state, input, context)
def choose(state: M.State, input: M.Choice, context: Abi.Context) -> M.Decision:
  Base.choose(state, input, context)
def view(state: M.State, panel: String) -> M.View:
  Base.view(state, panel)
# The proposed source supplies its migration over the exact captured session.
def migrate(previous: M.State) -> M.State:
  extend(previous, {handler: H.set_var(previous.handler, "chalk_star", K.Value.boolean({value: false}))})
