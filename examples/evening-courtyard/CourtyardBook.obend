edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Preparation.obend as P
import ./Encounter.obend as E
import ./Document.obend as D
import ./Conversation.obend as C

# This book owns the conversation, not copies of its neighbours' states.
record Config:
  object: String
  title: String
  places: E.Children
record State:
  conversation: C.State
  places: E.Children
record Note:
  line: String
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: String
def policy() -> C.Policy:
  {revision: "courtyard-notes", capacity: 32n, window: 8n, accepts: fn(fields: P.Fields) -> Bool: true, needs: fn(fields: P.Fields) -> P.Names: P.Names.nil()}
def configured(config: Config) -> State:
  {conversation: C.initial(config.title, {object: config.object, revision: 1n, meaning: "an-evening-built-together", entry: "note", token: "note"}, P.Names.nil()), places: config.places}
def note(state: State, input: Note, context: Abi.Context) -> Decision:
  let valid = textLength(input.line) > 0n && textLength(input.line) <= 512n
  let contribution = if valid then C.contribute(policy(), state.conversation, C.literal(state.conversation, input.line, P.Fields.nil()), context) else C.decided(state.conversation, false, "Leave one short line for the next visitor.")
  {accepted: contribution.accepted, reason: contribution.reason, state: extend(state, {conversation: contribution.state}), result: contribution.result}
def references(places: E.Children) -> D.Documents:
  match places:
    case nil(_): D.Documents.nil()
    case cons(c): D.Documents.cons({head: D.concat(D.Document.reference(c.head), D.text("\n")), tail: references(c.tail)})
record Description:
  name: String
  initial: State
  methods: {note: {label: String, fields: {line: Abi.StringField}}}
  panels: {}
def describe() -> Description:
  {name: "The evening courtyard", initial: configured({object: "courtyard", title: "An evening built together", places: E.Children.nil()}), methods: {note: {label: "Leave a line", fields: {line: {type: "string", minLength: 1n, maxLength: 512n}}}}, panels: {}}
record View:
  title: String
  prose: String
  actions: {note: {visible: Bool, text: String, command: String, input: {}}}
  children: E.Children
  document: D.Document
def render(state: State, introduction: String) -> View:
  let doc = D.concat(D.text(textConcat(introduction, "\n")), D.concat(D.Document.sequence({items: references(state.places)}), C.render(policy(), state.conversation, 0n, 8n)))
  {title: state.conversation.focus, prose: D.plain(doc), actions: {note: {visible: true, text: "Leave a line", command: "note", input: {}}}, children: state.places, document: doc}
def view(state: State, panel: String) -> View:
  render(state, "Moss makes the bell; Iris makes the door and its light. Follow a place to make, connect, or arrange its next chord. Each thing keeps its own rules. Leave a line here for whoever returns.")
