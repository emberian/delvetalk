edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
import ./World.obend as World
import ./Card.obend as Card
import ./Text.obend as Text
record State:
  lit: Bool
  litBy: String
  litHandle: String
def initial() -> State:
  {lit: false, litBy: "", litHandle: ""}
# Light the lantern and remember who did: the turn's principal.
def light(state: State, context: Abi.Context) -> Activity<Bool>:
  lit(context.principal, context.handle)
def lit(by: String, handle: String) -> Activity<Bool>:
  let written(_) = write {lit: set true, litBy: set by, litHandle: set handle}
  true
form light:
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.text(if state.lit then "The lantern is lit by {Card.shown(state.litBy, state.litHandle, context)}{Card.mine(state.litBy, context)}.\n" else "The lantern is dark.\n")
