edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Document.obend as Document
import ./List.obend as Lists
import ./Plan.obend as Plans
import ./Form.obend as Form
import ./World.obend as World
import ./Card.obend as Card
# The reference activity the host's own suites time. It follows the card protocol: a
# turn's packet carries only what its entry reaches, and 200 HTTP bumps took 0.50 s on
# hbox with Card in the closure against 0.39 s without (test_http's bound is 10 s).
record State:
  count: Nat
def initial() -> State:
  {count: 0n}
def bump(state: State, context: Abi.Context) -> Activity<Nat>:
  let written(_) = write {count: add 1n}
  state.count + 1n
form bump:
def blurb() -> Card.Door:
  {word: "counter", blurb: "Bump it; everyone shares the count."}
def receive(state: State, input: Card.Reply, context: Abi.Context) -> Activity<Card.Replied>:
  Card.answer(input, context, forms(), render(state, context))
# The card as the reader in the context sees it: the count is everyone's.
def render(state: State, context: Abi.Context) -> Document.Document:
  Document.text("Count: {natText(state.count)}")
def card(state: State) -> String:
  Document.plain(render(state, Card.stranger()))
