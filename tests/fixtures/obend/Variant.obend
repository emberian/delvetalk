edition ObjectiveBend 1
import ./List.obend as Lists
import ./Document.obend as Document
import ./Form.obend as Form
import ./Plan.obend as Plans
# The variant Plan dialect: an activity `Activity<Plan, Response, A>` that performs a Plan
# value and matches its Response. Every object in world/ speaks the message dialect
# (World.obend); the host still answers these variant arms, and the kernel accepts the
# three-argument Activity, until their lanes delete them (WHOLENESS section 4, day 4). These
# fixtures test those arms meanwhile; nothing in world/ imports this module.
record View:
  object: Plans.Reference
record Await:
  slot: Plans.Slot
  patience: Nat
# The forms an interpretation may answer with, in the spell grammar. `model` names the
# model to ask instead of the policy's own ("" for the policy's): a card's second attempt
# names the policy's `escalate` model (Card.asking).
type Forms = Lists.List<Form.Form>
record Interpret:
  utterance: String
  offers: Forms
  policy: Plans.Reference
  model: String
# `to` is a principal; "" is the acting principal.
record Offering:
  to: String
  document: Document.Document
# Delegation. `to` (a principal, or an object id) may run `method` of `object` as the
# principal of the direct turn that grants it, while the clock is at most `until`. The
# grant is used by naming its id as `via` in callVia or sendVia: the callee then runs with
# request.subject = the grantor and request.caller = the calling object. Without a grant
# that stands the Plan is answered refused {clause: "noGrant"}. (Records have no optional
# fields, so a call or send under a grant is its own constructor.) grantWith attenuates:
# `fixed` (a record of some of the callee's input fields, as Data) is merged into every
# use's argument (a use giving such a field otherwise is refused grantConflict), and the
# grant serves `uses` (at least 1) admitted calls or sends, then grantSpent. The grantor
# may also revoke with the op world-revoke, outside any object.
record Grant:
  to: String
  object: Plans.Reference
  method: String
  until: Nat
# Listing and cards. `objects` answers one page (64) of the ids the principal may view,
# starting with `prefix`, after `after` in byte order. `card` runs the target's pure
# `render(state, context)` (the reader's context) under the reader's read authority (`denied` otherwise), so an object
# shows one of another state type without viewing its state. `viewDerived {object, view}`
# runs the target's pure `view` (one its `views()` names, of its state and the reader's
# context) the same way and answers `derived {version, value}` (FOUNDATION §16; the host's
# half is HOST-HANDOFF §7 item 6).
record Publish:
  page: String
  section: String
  body: String
sum Plan<E>:
  view: View
  write: {object: Plans.Reference, edits: E}
  call: {object: Plans.Reference, method: String, argument: Data}
  send: {object: Plans.Reference, method: String, argument: Data}
  create: {package: String, seed: Data, law: String, requireAbsent: Plans.Reference}
  createUnder: {package: String, seed: Data, law: String, requireAbsent: Plans.Reference, supervisor: Plans.Reference}
  await: Await
  awaitUntil: {slot: Plans.Slot, until: Nat}
  awaitPost: {post: String, patience: Nat}
  awaitPostUntil: {post: String, until: Nat}
  interpret: Interpret
  offer: Offering
  publish: Publish
  reprogram: {object: Plans.Reference, package: String, migration: String}
  extend: {object: Plans.Reference, package: String, migration: String}
  amend: {object: Plans.Reference, law: String}
  inspect: {object: Plans.Reference}
  check: {package: String}
  grant: Grant
  grantWith: {to: String, object: Plans.Reference, method: String, until: Nat, fixed: Data, uses: Nat}
  revoke: {id: String}
  callVia: {object: Plans.Reference, method: String, argument: Data, via: String}
  sendVia: {object: Plans.Reference, method: String, argument: Data, via: String}
  objects: {prefix: String, after: String}
  card: {object: Plans.Reference}
  run: {object: Plans.Reference, method: String, argument: Data, handler: Plans.Reference}
  judge: {edits: E}
  viewData: {object: Plans.Reference}
  viewDataField: {object: Plans.Reference, field: String}
  viewDerived: {object: Plans.Reference, view: String}
sum Response<S, R>:
  viewed: {version: Nat, state: S}
  denied: {}
  written: {}
  refused: {clause: String}
  returned: {result: R}
  delivery: {id: String}
  created: {object: Plans.Reference}
  reply: {receipt: Plans.Receipt}
  unknown: {}
  timedOut: {}
  broken: {}
  proposal: {method: String, argument: R}
  unclear: {needs: Document.Names}
  replied: {text: String}
  offered: {}
  published: {post: String}
  reprogrammed: {pin: String}
  amended: {}
  inspected: {pin: String, law: String, source: String, methods: Forms}
  checked: {diagnostics: Document.Names}
  granted: {id: String}
  revoked: {}
  listed: {ids: Document.Names, more: Bool}
  carded: {document: Document.Document}
  judged: {admitted: Bool, clause: String}
  viewedData: {version: Nat, state: Data}
  viewedField: {version: Nat, value: Data}
  derived: {version: Nat, value: Data}
# What a handler's `handle(state, plan, context)` answers for a Plan the callee of a `run`
# yields: pass it on to the host, or answer it with a response of the callee's type.
sum Handled<R>:
  pass: {}
  answer: {response: R}
