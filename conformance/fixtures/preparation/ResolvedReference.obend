edition ObjectiveBend 1
import ./Preparation.obend as P
record Checks:
  observed: Bool
  keyPreserved: Bool
  textRefuses: Bool
  mismatchedObjectRefuses: Bool
  absentRefuses: Bool
def resolved(value: P.ReferenceLookup) -> Bool:
  match value:
    case missing(_): false
    case unresolved(_): false
    case found(_): true
def exactKey(read: P.Read, key: String) -> Bool:
  match read:
    case existing(_): false
    case absent(_): false
    case exact(reference): reference.object == "room" && reference.key == key
def checks() -> Checks:
  let key = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  let actual: P.Observation = {object: "room", version: 3n, program: key, state: P.Value.retained({object: "room", key: key}), law: P.Value.none()}
  let text: P.Observation = {object: "room", version: 3n, program: key, state: P.Value.text({value: key}), law: P.Value.none()}
  let wrong: P.Observation = {object: "room", version: 3n, program: key, state: P.Value.retained({object: "other", key: key}), law: P.Value.none()}
  {observed: resolved(P.resolveObservation(actual)), keyPreserved: exactKey(P.referenceRead({object: "room", key: key, program: key}), key), textRefuses: resolved(P.resolveObservation(text)) == false, mismatchedObjectRefuses: resolved(P.resolveObservation(wrong)) == false, absentRefuses: resolved(P.lookupReference(P.Observations.nil(), "room")) == false}
