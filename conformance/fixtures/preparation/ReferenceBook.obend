edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Preparation.obend as P
import ./Encounter.obend as E
record State:
  saved: P.ResolvedReference
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: String
def remember(state: State, input: P.ResolvedReference, context: Abi.Context) -> Decision:
  {accepted: true, reason: "", state: {saved: input}, result: "Reference remembered."}
def prepareCapture(state: State, input: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  match P.lookupReference(observations, "lamp"):
    case missing(_): P.Preparation.refused({message: "Observe the lamp."})
    case unresolved(_): P.Preparation.refused({message: "A retained lamp observation is required."})
    case found(reference):
      P.Preparation.ready({summary: "Remember this exact lamp.", reads: P.Reads.cons({head: P.referenceRead(reference.value), tail: P.Reads.nil()}), calls: P.Effects.cons({head: P.Effect.invoke({object: context.object, command: "remember", input: P.Value.record({fields: P.Fields.cons({head: {name: "object", value: P.Value.text({value: reference.value.object})}, tail: P.Fields.cons({head: {name: "key", value: P.Value.text({value: reference.value.key})}, tail: P.Fields.cons({head: {name: "program", value: P.Value.text({value: reference.value.program})}, tail: P.Fields.nil()})})})})}), tail: P.Effects.nil()})})
def prepareUse(state: State, input: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  P.Preparation.ready({summary: "Light the remembered lamp.", reads: P.Reads.cons({head: P.referenceRead(state.saved), tail: P.Reads.nil()}), calls: P.Effects.cons({head: P.Effect.invoke({object: state.saved.object, command: "shine", input: P.Value.record({fields: P.Fields.nil()})}), tail: P.Effects.nil()})})
record Description:
  name: String
  initial: State
  methods: {remember: {label: String, fields: {object: Abi.StringField, key: Abi.StringField, program: Abi.StringField}}}
  panels: {}
def describe() -> Description:
  {name: "An exact reference book", initial: {saved: {object: "", key: "", program: ""}}, methods: {remember: {label: "Remember", fields: {object: {type: "string", minLength: 0n, maxLength: 128n}, key: {type: "string", minLength: 0n, maxLength: 64n}, program: {type: "string", minLength: 0n, maxLength: 64n}}}}, panels: {}}
record Invitation:
  visible: Bool
  text: String
  prepare: String
  fields: {}
  observations: P.Requests
record View:
  title: String
  prose: String
  actions: {}
  children: E.Children
  invitations: {capture: Invitation, use: Invitation}
def view(state: State, panel: String) -> View:
  {title: "An exact reference book", prose: "Remembering an object does not grant its authority.", actions: {}, children: E.Children.nil(), invitations: {capture: invitation("Remember exact lamp", "prepareCapture"), use: invitation("Use exact lamp", "prepareUse")}}

def invitation(label: String, entry: String) -> Invitation:
  {visible: true, text: label, prepare: entry, fields: {}, observations: P.Requests.cons({head: {object: "lamp", inspectState: false, inspectLaw: false}, tail: P.Requests.nil()})}
