edition ObjectiveBend 1
import ./Preparation.obend as P
import ./Candidate.obend as Candidate
import ./Interpretation.obend as I
import ./GrantPolicy.obend as G
import ./Welcome.obend as W
record Checks:
  absent: Bool
  wrongNatural: Bool
  actualZero: Bool
  actualFalse: Bool
  wrongBoolean: Bool
  emptyText: Bool
  absentObservation: Bool
  actualObservation: Bool
  missingBaseline: Bool
  falseBaseline: Bool
  zeroBaseline: Bool
  malformedBound: Bool
  zeroBound: Bool
  missingPermission: Bool
  falsePermission: Bool
  wrongPermission: Bool
  invalidCommands: Bool
  malformedOfferArray: Bool
  malformedInspectFlag: Bool
  missingAvailability: Bool
  malformedSchema: Bool
  typedPartial: Bool
def naturalResult(value: P.NaturalLookup, kind: String) -> Bool:
  match value:
    case missing(_): kind == "missing"
    case wrongKind(_): kind == "wrong"
    case found(n): kind == "zero" && n.value == 0n
def booleanResult(value: P.BooleanLookup, kind: String) -> Bool:
  match value:
    case missing(_): kind == "missing"
    case wrongKind(_): kind == "wrong"
    case found(b): kind == "false" && b.value == false
def empty(value: P.TextLookup) -> Bool:
  match value:
    case missing(_): false
    case wrongKind(_): false
    case found(t): t.value == ""
def observed(value: P.ObservationLookup, expected: Bool) -> Bool:
  match value:
    case missing(_): expected == false
    case found(o): expected && o.value.object == "target" && o.value.version == 0n
def submission(baseline: P.Fields) -> P.Value:
  P.Value.record({fields: Candidate.pair("proposal", P.Value.record({fields: P.Fields.nil()}), Candidate.pair("migration", P.Value.record({fields: P.Fields.nil()}), Candidate.pair("target", Candidate.text("target"), Candidate.pair("editor", Candidate.text("editor"), Candidate.pair("generation", Candidate.number(1n), baseline)))))})
def submitted(baseline: P.Fields) -> Bool:
  Candidate.submit(Candidate.initial({editorMode: true}), submission(baseline), {object: "candidate", principal: "iris", inputOrigin: {kind: "literal", object: "", command: "", program: "", immediatelyPrevious: false}}).accepted
def spec(lower: P.Value) -> P.Value:
  P.Value.record({fields: Candidate.pair("type", Candidate.text("nat"), Candidate.pair("minimum", lower, Candidate.pair("maximum", Candidate.number(0n), P.Fields.nil())))})
def dynamicFits(specification: P.Value, value: P.Value) -> Bool:
  match I.decodedShape(specification):
    case invalid(_): false
    case found(s): I.fits(s.value, value)
def offered(fields: P.Fields) -> P.Value:
  P.Value.record({fields: Candidate.pair("actions", P.Value.array({values: P.Values.cons({head: P.Value.record({fields: Candidate.pair("id", Candidate.text("pick"), fields)}), tail: P.Values.nil()})}), P.Fields.nil())})
def validOffer() -> P.Fields:
  Candidate.pair("available", P.Value.boolean({value: true}), Candidate.pair("fields", P.Value.array({values: P.Values.nil()}), P.Fields.nil()))
def pick() -> P.Value:
  P.Value.record({fields: Candidate.pair("action", Candidate.text("pick"), Candidate.pair("fields", P.Value.record({fields: P.Fields.nil()}), P.Fields.nil()))})
def typedPartial() -> Bool:
  let card = {token: "capture", offers: I.Offers.cons({head: {id: "pick", available: true, inspectOnly: false, fields: I.Schema.cons({head: I.textSchema("recipient", 1n, 64n), tail: I.Schema.nil()}), children: P.Names.nil()}, tail: I.Offers.nil()})}
  I.proposeTyped(card, pick(), "model").status == "partial"
def checks() -> Checks:
  {absent: naturalResult(P.naturalField(P.Value.record({fields: P.Fields.nil()}), "n"), "missing"), wrongNatural: naturalResult(P.naturalField(P.oneField("n", P.Value.boolean({value: false})), "n"), "wrong"), actualZero: naturalResult(P.naturalField(P.oneField("n", Candidate.number(0n)), "n"), "zero"), actualFalse: booleanResult(P.booleanField(P.oneField("b", P.Value.boolean({value: false})), "b"), "false"), wrongBoolean: booleanResult(P.booleanField(P.oneField("b", Candidate.number(0n)), "b"), "wrong"), emptyText: empty(P.textField(P.oneField("t", Candidate.text("")), "t")), absentObservation: observed(P.lookupObservation(P.Observations.nil(), "target"), false), actualObservation: observed(P.lookupObservation(P.Observations.cons({head: {object: "target", version: 0n, program: "actual", state: P.Value.none(), law: P.Value.none()}, tail: P.Observations.nil()}), "target"), true), missingBaseline: submitted(P.Fields.nil()) == false, falseBaseline: submitted(Candidate.pair("baselineVersion", P.Value.boolean({value: false}), P.Fields.nil())) == false, zeroBaseline: submitted(Candidate.pair("baselineVersion", Candidate.number(0n), P.Fields.nil())), malformedBound: dynamicFits(spec(P.Value.boolean({value: false})), Candidate.number(0n)) == false && dynamicFits(spec(P.Value.none()), Candidate.number(0n)) == false, zeroBound: dynamicFits(spec(Candidate.number(0n)), Candidate.number(0n)), missingPermission: G.optionalBoolean(P.Value.record({fields: P.Fields.nil()}), "reprogram"), falsePermission: G.optionalBoolean(P.oneField("reprogram", P.Value.boolean({value: false})), "reprogram"), wrongPermission: G.optionalBoolean(P.oneField("reprogram", Candidate.number(0n)), "reprogram") == false, invalidCommands: G.commandNames(P.Value.array({values: P.Values.cons({head: Candidate.number(0n), tail: P.Values.nil()})})) == false, malformedOfferArray: I.propose(P.oneField("actions", P.Value.boolean({value: false})), pick(), "model").status == "clarify", malformedInspectFlag: I.propose(offered(Candidate.pair("inspectOnly", Candidate.number(0n), validOffer())), pick(), "model").status == "clarify", missingAvailability: I.propose(offered(Candidate.pair("fields", P.Value.array({values: P.Values.nil()}), P.Fields.nil())), pick(), "model").status == "clarify", malformedSchema: I.propose(offered(Candidate.pair("available", P.Value.boolean({value: true}), Candidate.pair("fields", P.Value.array({values: P.Values.cons({head: P.Value.record({fields: Candidate.pair("name", Candidate.text("n"), Candidate.pair("type", Candidate.text("nat"), Candidate.pair("minimum", P.Value.boolean({value: false}), Candidate.pair("maximum", Candidate.number(0n), P.Fields.nil()))))}), tail: P.Values.nil()})}), P.Fields.nil()))), pick(), "model").status == "clarify", typedPartial: typedPartial()}
