edition ObjectiveBend 1
import ./Work.obend as W
import ./Preparation.obend as P
import ./Encounter.obend as E
record State:
  count: Nat
record Origin:
  kind: String
  object: String
  command: String
  program: String
  immediatelyPrevious: Bool
record Context:
  object: String
  principal: String
  inputOrigin: Origin
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Nat
record Description:
  name: String
  initial: State
  methods: {add: {label: String, fields: {}}}
  panels: {main: String}
record Invitation:
  visible: Bool
  text: String
  prepare: String
  fields: {}
  observations: P.Requests
record View:
  title: String
  prose: String
  actions: {}
  children: E.Children
  invitations: {add: Invitation}
def describe() -> Description:
  {name: "Shared invitation budget", initial: {count: 0n}, methods: {add: {label: "Add", fields: {}}}, panels: {main: "Counter"}}
def add(state: State, input: {}, context: Context) -> Decision:
  {accepted: W.burn(3000n), reason: "", state: {count: state.count + 1n}, result: state.count}
def prepareAdd(state: State, contribution: P.Value, observations: P.Observations, context: P.Context) -> P.Preparation:
  if W.burn(3000n) then P.Preparation.ready({summary: "Add once after bounded preparation.", reads: P.Reads.nil(), calls: P.Effects.cons({head: P.Effect.invoke({object: context.object, command: "add", input: P.Value.record({fields: P.Fields.nil()})}), tail: P.Effects.nil()})}) else P.Preparation.refused({message: "Unreachable finite-work refusal."})
def view(state: State, panel: String) -> View:
  {title: "Shared invitation budget", prose: "A bounded preparation and body share one receiving allowance.", actions: {}, children: E.Children.nil(), invitations: {add: {visible: true, text: "Add", prepare: "prepareAdd", fields: {}, observations: P.Requests.nil()}}}
