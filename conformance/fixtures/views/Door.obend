edition ObjectiveBend 1
record State:
  lit: Bool
record Origin:
  kind: String
  object: String
  command: String
  program: String
  immediatelyPrevious: Bool
record Context:
  object: String
  principal: String
  inputOrigin: Origin
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: String
record Method:
  label: String
  fields: {}
record Description:
  name: String
  initial: State
  methods: {knock: Method}
  panels: {details: String}
record Action:
  visible: Bool
  text: String
  command: String
  input: {}
record Child:
  key: String
  label: String
  object: String
  panel: String
sum Children:
  nil: {}
  cons: {head: Child, tail: Children}
record View:
  title: String
  prose: String
  actions: {knock: Action}
  children: Children
def describe() -> Description:
  {name: "The paper door", initial: {lit: false}, methods: {knock: {label: "Knock", fields: {}}}, panels: {details: "Door details"}}
def knock(state: State, input: {}, context: Context) -> Decision:
  {accepted: true, reason: "", state: {lit: true}, result: "Welcome"}
def view(state: State, panel: String) -> View:
  {title: if panel == "details" then "Door details" else "The paper door", prose: if state.lit then "A lantern glows." else "The room is dark.", actions: {knock: {visible: true, text: "Knock", command: "knock", input: {}}}, children: Children.nil()}
