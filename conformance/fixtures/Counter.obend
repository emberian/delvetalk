edition ObjectiveBend 1
record Origin:
  kind: String
  object: String
  command: String
  program: String
  immediatelyPrevious: Bool
record Context:
  object: String
  principal: String
  inputOrigin: Origin
record State:
  count: Nat
record NatField:
  type: String
  minimum: Nat
  maximum: Nat
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Nat
record Description:
  name: String
  initial: State
  methods: {add: {label: String, fields: {amount: NatField}}}
  panels: {}
def describe() -> Description:
  {name: "Receiving counter", initial: {count: 0n}, methods: {add: {label: "Add an amount", fields: {amount: {type: "nat", minimum: 0n, maximum: 100n}}}}, panels: {}}
def add(state: State, input: {amount: Nat}, context: Context) -> Decision:
  {accepted: true, reason: "", state: {count: state.count + input.amount}, result: state.count + input.amount}
record Child:
  key: String
  label: String
  object: String
  panel: String
sum Children:
  nil: {}
  cons: {head: Child, tail: Children}
def view(state: State, panel: String) -> {title: String, prose: String, actions: {add: {visible: Bool, text: String, command: String, input: {}}}, children: Children}:
  {title: "Receiving counter", prose: "Add an amount through the offered form.", actions: {add: {visible: true, text: "Add an amount", command: "add", input: {}}}, children: Children.nil()}
