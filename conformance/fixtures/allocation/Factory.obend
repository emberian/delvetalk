edition ObjectiveBend 1
import ./List.obend as Lists
import ./Preparation.obend as P
import ./Allocation.obend as A
import ./Abi.obend as Abi
import ./Encounter.obend as E
import ./Writing.obend as W
import ./Counter.obend as C
record Config:
  writer: P.Value
  counter: P.Value
  law: P.Value
record State:
  config: Config
  last: String
sum Child:
  writer: {name: String, protocol: P.Value, law: P.Value, initial: W.State}
  counter: {name: String, protocol: P.Value, law: P.Value, initial: C.State}
  copy: {name: String, protocol: P.Value, law: P.Value}
type Children = Lists.List<Child>
record Input:
  name: String
  kind: String
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: String
  allocations: Children
def initial(config: Config) -> State:
  {config: config, last: ""}
def child(config: Config, input: Input) -> Child:
  if input.kind == "writer" then Child.writer(A.configured::<W.State>(input.name, config.writer, config.law, W.initial({candidate: "candidate", target: "target", syntax: "objective-bend-object"}))) else if input.kind == "copy" then Child.copy({name: input.name, protocol: config.counter, law: config.law}) else Child.counter(A.configured::<C.State>(input.name, config.counter, config.law, {count: 3n}))
def make(state: State, input: Input, context: Abi.Context) -> Decision:
  {accepted: true, reason: "", state: extend(state, {last: input.name}), result: input.name, allocations: Children.cons({head: child(state.config, input), tail: Children.nil()})}
record Description:
  name: String
  initial: State
  methods: {make: {label: String, fields: {name: Abi.StringField, kind: Abi.StringField}}}
  panels: {}
  allocation: {limit: Nat}
def describe() -> Description:
  {name: "Typed prototype factory", initial: initial({writer: P.Value.none(), counter: P.Value.none(), law: P.Value.none()}), methods: {make: {label: "Make", fields: {name: {type: "string", minLength: 1n, maxLength: 64n}, kind: {type: "string", minLength: 1n, maxLength: 16n}}}}, panels: {}, allocation: {limit: 3n}}
def view(state: State, panel: String) -> {title: String, prose: String, actions: {}, children: E.Children}:
  {title: "Typed factory", prose: state.last, actions: {}, children: E.Children.nil()}
