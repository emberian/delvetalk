edition ObjectiveBend 1
import ./Factory.obend as F
import ./Abi.obend as Abi
import ./Encounter.obend as E
record State:
  count: Nat
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: F.Plan
def plan(state: State, input: F.Plan, context: Abi.Context) -> Decision:
  {accepted: true, reason: "", state: {count: state.count + 1n}, result: input}
record Description:
  name: String
  initial: State
  methods: {plan: {label: String, fields: {factory: Abi.StringField, name: Abi.StringField, editor: Abi.StringField, generation: Abi.NatField, target: Abi.StringField, baselineVersion: Abi.NatField}}}
  panels: {}
def text() -> Abi.StringField:
  {type: "string", minLength: 0n, maxLength: 128n}
def number() -> Abi.NatField:
  {type: "nat", minimum: 0n, maximum: 9007199254740991n}
def describe() -> Description:
  {name: "Typed source planner", initial: {count: 0n}, methods: {plan: {label: "Plan", fields: {factory: text(), name: text(), editor: text(), generation: number(), target: text(), baselineVersion: number()}}}, panels: {}}
def view(state: State, panel: String) -> {title: String, prose: String, actions: {}, children: E.Children}:
  {title: "Planner", prose: natText(state.count), actions: {}, children: E.Children.nil()}
