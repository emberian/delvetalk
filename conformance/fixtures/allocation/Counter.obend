edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Encounter.obend as E
record State:
  count: Nat
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Nat
def report(state: State, input: {}, context: Abi.Context) -> Decision:
  {accepted: true, reason: "", state: state, result: state.count}
record Description:
  name: String
  initial: State
  methods: {report: {label: String, fields: {}}}
  panels: {}
def describe() -> Description:
  {name: "Counter prototype", initial: {count: 0n}, methods: {report: {label: "Report", fields: {}}}, panels: {}}
def view(state: State, panel: String) -> {title: String, prose: String, actions: {}, children: E.Children}:
  {title: "Counter", prose: natText(state.count), actions: {}, children: E.Children.nil()}
