edition ObjectiveBend 1
import ./Authority.obend as A
import ./Preparation.obend as P

def ownerNames(owner: String) -> P.Names:
  P.Names.cons({head: owner, tail: P.Names.nil()})
def visitors(owner: String, visitor: String) -> P.Names:
  P.Names.cons({head: owner, tail: ownerNames(visitor)})
def people(names: P.Names) -> P.Value:
  P.Value.array({values: A.people(names)})
def counter(owner: String, visitor: String, public: Bool) -> P.Value:
  let managers = ownerNames(owner)
  let grants = A.Grants.cons({head: {command: "add", principals: if public then visitors(owner, visitor) else managers}, tail: A.Grants.nil()})
  let private = people(managers)
  P.Value.record({fields: A.pair("profile", P.Value.text({value: "delvetalk-scoped-law"}), A.pair("read", private, A.pair("view", P.Value.record({fields: A.pair("main", if public then P.Value.text({value: "public"}) else private, A.pair("private", private, P.Fields.nil()))}), A.pair("invoke", P.Value.record({fields: A.commands(grants)}), A.pair("reprogram", private, A.pair("law", private, P.Fields.nil()))))))})
def directory(owner: String, visitor: String) -> P.Value:
  let managers = ownerNames(owner)
  A.assemble({reading: people(managers), invocation: A.Grants.cons({head: {command: "choose", principals: ownerNames(visitor)}, tail: A.Grants.cons({head: {command: "setDoor", principals: managers}, tail: A.Grants.nil()})}), reprogramming: managers, management: managers, publicPanels: ownerNames("main")})
def desk(owner: String, visitor: String) -> P.Value:
  let managers = ownerNames(owner)
  A.assemble({reading: people(visitors(owner, visitor)), invocation: A.Grants.cons({head: {command: "make", principals: ownerNames(visitor)}, tail: A.Grants.nil()}), reprogramming: managers, management: managers, publicPanels: ownerNames("main")})
