edition ObjectiveBend 1
import ./Preparation.obend as P
import ./Abi.obend as A
import ./Encounter.obend as E
record State:
  value: P.Value
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: P.Value
record Description:
  name: String
  initial: State
  methods: {write: {label: String, fields: {}, inputCodec: String, resultCodec: String}}
  panels: {}
def describe() -> Description:
  {name: "Custody value", initial: {value: P.Value.none()}, methods: {write: {label: "Write", fields: {}, inputCodec: "value", resultCodec: "value"}}, panels: {}}
def initial(value: P.Value) -> State:
  {value: value}
def write(state: State, input: P.Value, context: A.Context) -> Decision:
  {accepted: true, reason: "", state: {value: P.get(input, "value")}, result: P.get(input, "value")}
def view(state: State, panel: String) -> {title: String, prose: String, actions: {}, children: E.Children}:
  {title: "Custody value", prose: "A source-owned value retained locally.", actions: {}, children: E.Children.nil()}
