edition ObjectiveBend 1
import ./ExhibitList.obend as Exhibits
import ./Main.obend as Place
record Preparation:
  found: Bool
  object: String
  observedVersion: Nat
  command: String
def count(entries: Exhibits.Entries) -> Nat:
  Exhibits.length(entries)
def listing(entries: Exhibits.Entries) -> Place.View:
  Place.view({entries: entries}, "main")
def select(entries: Exhibits.Entries, target: String) -> Bool:
  Exhibits.contains(entries, target)
def prepare(entries: Exhibits.Entries, target: String) -> Preparation:
  match entries:
    case nil(_): {found: false, object: "", observedVersion: 0n, command: ""}
    case cons(c): if c.head.object == target then {found: true, object: c.head.object, observedVersion: c.head.observedVersion, command: "inspect"} else prepare(c.tail, target)
def add(entries: Exhibits.Entries) -> Place.Decision:
  Place.add({entries: entries}, {object: "new-object", version: 0n}, {object: "room", principal: "curator", inputOrigin: {kind: "observe", object: "new-object", command: "", immediatelyPrevious: true}})
