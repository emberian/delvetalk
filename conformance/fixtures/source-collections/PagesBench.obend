edition ObjectiveBend 1
import ./Encounter.obend as Encounter
import ./EncounterPages.obend as P
record Request:
  page: Nat
  target: String
def count(pages: P.Pages) -> Nat:
  P.length(pages)
def pages(pages: P.Pages) -> Nat:
  P.pageCount(pages)
def listing(pages: P.Pages, index: Nat) -> Encounter.Children:
  P.page(pages, index)
def select(pages: P.Pages, key: String) -> Bool:
  P.contains(pages, key)
def prepare(pages: P.Pages, request: Request) -> {found: Bool, children: Encounter.Children}:
  {found: P.contains(pages, request.target), children: P.page(pages, request.page)}
def add(pages: P.Pages, child: Encounter.Child, capacity: Nat) -> P.Offered:
  P.offer(pages, child, capacity)
def remove(pages: P.Pages, key: String) -> P.Pages:
  P.remove(pages, key)
