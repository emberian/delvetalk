edition ObjectiveBend 1
record State:
  count: Nat
  secret: String
record Origin:
  kind: String
  object: String
  command: String
  program: String
  immediatelyPrevious: Bool
record Context:
  object: String
  principal: String
  inputOrigin: Origin
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: {count: Nat}
record Field:
  type: String
  minimum: Nat
  maximum: Nat
record Description:
  name: String
  initial: State
  methods: {add: {label: String, fields: {amount: Field}}}
  panels: {main: String}
record Action:
  visible: Bool
  text: String
  command: String
  input: {}
  fields: {amount: Field}
record Child:
  key: String
  label: String
  object: String
  panel: String
sum Children:
  nil: {}
  cons: {head: Child, tail: Children}
record View:
  title: String
  prose: String
  actions: {add: Action}
  children: Children
  extension: {caption: String, nested: {count: Nat}}
def describe() -> Description:
  {name: "Private counter", initial: {count: 0n, secret: "private-counter-state-secret"}, methods: {add: {label: "Add", fields: {amount: {type: "nat", minimum: 0n, maximum: 100n}}}}, panels: {main: "Counter"}}
def add(state: State, input: {amount: Nat}, context: Context) -> Decision:
  {accepted: input.amount <= 100n, reason: if input.amount <= 100n then "" else "private-counter-diagnostic-secret", state: extend(state, {count: state.count + input.amount}), result: {count: state.count + input.amount}}
def view(state: State, panel: String) -> View:
  {title: "Private counter", prose: if panel == "private" then state.secret else textConcat("Count: ", natText(state.count)), actions: {add: {visible: true, text: "Add one", command: "add", input: {}, fields: {amount: {type: "nat", minimum: 0n, maximum: 100n}}}}, children: Children.nil(), extension: {caption: "An editable source extension", nested: {count: state.count}}}
