edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Encounter.obend as E
record State:
  empty: Bool
record Report:
  candidate: String
  editor: String
  generation: Nat
  target: String
  baselineVersion: Nat
  status: String
  program: String
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: Report
def report(state: State, input: {}, context: Abi.Context) -> Decision:
  {accepted: true, reason: "", state: state, result: {candidate: "substitute", editor: "editor", generation: 1n, target: "instrument", baselineVersion: 0n, status: "pending", program: ""}}
def describe() -> {name: String, initial: State, methods: {report: {label: String, fields: {}}}, panels: {}}:
  {name: "A substitute reporter", initial: {empty: true}, methods: {report: {label: "Report the substitute", fields: {}}}, panels: {}}
def view(state: State, panel: String) -> {title: String, prose: String, actions: {}, children: E.Children}:
  {title: "A substitute reporter", prose: "A named report is distinct from the actual planned candidate.", actions: {}, children: E.Children.nil()}
