edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./SceneModel.obend as M
import ./SceneRuntime.obend as Runtime
import ./SceneData.obend as D
def validate(scene: D.Scene) -> M.Validation:
  Runtime.behavior().validate(scene)
def configure(scene: D.Scene) -> M.State:
  Runtime.behavior().describe(scene).initial
def describe() -> M.Description:
  Runtime.behavior().describe(D.empty())
def start(state: M.State, input: {}, context: Abi.Context) -> M.Decision:
  Runtime.behavior().start(state.scene, state, input, context)
def choose(state: M.State, input: M.Choice, context: Abi.Context) -> M.Decision:
  Runtime.behavior().choose(state.scene, state, input, context)
def requirements(state: M.State) -> Bool:
  Runtime.behavior().requirements(state.scene, state)
def view(state: M.State, panel: String) -> M.View:
  Runtime.behavior().view(state.scene, state, panel)
