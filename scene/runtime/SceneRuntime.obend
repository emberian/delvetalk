edition ObjectiveBend 1
import ./Kernel.obend as K
import ./SceneData.obend as D
import ./Handler.obend as H
import ./Abi.obend as Abi
import ./Encounter.obend as Encounter
import ./SceneModel.obend as M
def initial() -> M.State:
  {handler: H.initial(), passage: 0n, visited: K.Visits.nil(), started: false, ended: false}
def updated(step: H.Step, state: H.State) -> H.Step:
  {accepted: step.accepted, reason: step.reason, state: state, emissions: step.emissions}
def rejected(step: H.Step, reason: String) -> H.Step:
  {accepted: false, reason: reason, state: step.state, emissions: step.emissions}
def finish(state: M.State, step: H.Step) -> M.Decision:
  {accepted: step.accepted, reason: step.reason, state: {handler: step.state, passage: state.passage, visited: state.visited, started: state.started, ended: state.ended}, result: {passage: state.passage, ended: state.ended}, emissions: step.emissions}
def refuse(state: M.State, reason: String) -> M.Decision:
  finish(state, rejected(H.begin(state.handler), reason))
def indexed(xs: D.Passages, index: Nat, position: Nat) -> M.FoundPassage:
  match xs:
    case nil(_): M.FoundPassage.missing()
    case cons(c): if index == position then M.FoundPassage.found({index: position, passage: c.head}) else indexed(c.tail, index, position + 1n)
def named(xs: D.Passages, name: String, position: Nat) -> M.FoundPassage:
  match xs:
    case nil(_): M.FoundPassage.missing()
    case cons(c): if c.head.name == name then M.FoundPassage.found({index: position, passage: c.head}) else named(c.tail, name, position + 1n)
def ordered(left: K.Value, right: K.Value, op: String) -> Bool:
  match right:
    case null(_): false
    case boolean(_): false
    case integer(c): K.order(left, c.value, op)
    case string(_): false
def compare(left: K.Value, right: K.Value, op: String) -> Bool:
  if op == "eq" then K.equal(left, right) else if op == "ne" then K.equal(left, right) == false else ordered(left, right, op)
def condition(test: D.Condition, state: H.State) -> Bool:
  match test:
    case always(_): true
    case has(c): H.has(state, c.category, c.key)
    case compare(c): compare(H.get_var(state, c.name), c.value, c.op)
    case negation(c): condition(c.condition, state) == false
    case conjunction(c): condition(c.left, state) && condition(c.right, state)
    case disjunction(c): condition(c.left, state) || condition(c.right, state)
def modified(step: H.Step, name: String, positive: Bool, magnitude: Nat) -> H.Step:
  let change: K.Modified = K.modify(H.get_var(step.state, name), positive, magnitude)
  if change.valid then updated(step, H.set_var(step.state, name, change.value)) else rejected(step, "signed i64 overflow")
def effect(item: D.Effect, step: H.Step, context: Abi.Context) -> H.Step:
  match item:
    case set(c): updated(step, H.set_var(step.state, c.name, c.value))
    case modify(c): modified(step, c.name, c.positive, c.magnitude)
    case call(c): H.call(step, c.name, c.args, context)
def effects(items: D.Effects, step: H.Step, context: Abi.Context) -> H.Step:
  match items:
    case nil(_): step
    case cons(c): if step.accepted then effects(c.tail, effect(c.head, step, context), context) else step
def entryItem(item: D.Content, step: H.Step, context: Abi.Context) -> H.Step:
  match item:
    case prose(_): step
    case choice(_): step
    case effect(c): effect(c.effect, step, context)
def entry(items: D.Contents, step: H.Step, context: Abi.Context) -> H.Step:
  match items:
    case nil(_): step
    case cons(c): if step.accepted then entry(c.tail, entryItem(c.head, step, context), context) else step
def enter(found: M.FoundPassage, state: M.State, step: H.Step, context: Abi.Context) -> M.Decision:
  match found:
    case missing(_): finish(state, rejected(step, "unknown passage target"))
    case found(c): let done: H.Step = if K.visited(state.visited, c.index) then step else entry(c.passage.content, step, context) in finish({handler: state.handler, passage: c.index, visited: K.visit(state.visited, c.index), started: true, ended: false}, done)
def end(state: M.State, step: H.Step) -> M.Decision:
  finish({handler: state.handler, passage: state.passage, visited: state.visited, started: state.started, ended: true}, step)
def navigate(scene: D.Scene, target: D.Target, state: M.State, step: H.Step, context: Abi.Context) -> M.Decision:
  match target:
    case absent(_): end(state, step)
    case named(c): if c.isEnd then end(state, step) else enter(named(scene.passages, c.name, 0n), state, step, context)
def selectedItem(item: D.Content, tail: D.Contents, index: Nat, position: Nat) -> M.FoundChoice:
  match item:
    case prose(_): selected(tail, index, position)
    case effect(_): selected(tail, index, position)
    case choice(c): if index == position then M.FoundChoice.found({choice: c.choice}) else selected(tail, index, position + 1n)
def selected(items: D.Contents, index: Nat, position: Nat) -> M.FoundChoice:
  match items:
    case nil(_): M.FoundChoice.missing()
    case cons(c): selectedItem(c.head, c.tail, index, position)
def chooseFound(scene: D.Scene, found: M.FoundChoice, state: M.State, context: Abi.Context) -> M.Decision:
  match found:
    case missing(_): refuse(state, "choice unavailable")
    case found(c): if condition(c.choice.condition, state.handler) then navigate(scene, c.choice.target, state, effects(c.choice.effects, H.begin(state.handler), context), context) else refuse(state, "choice unavailable")
def choosePassage(scene: D.Scene, found: M.FoundPassage, state: M.State, input: M.Choice, context: Abi.Context) -> M.Decision:
  match found:
    case missing(_): refuse(state, "choice unavailable")
    case found(c): chooseFound(scene, selected(c.passage.content, input.choice, 0n), state, context)
def startPassages(scene: D.Scene, state: M.State, context: Abi.Context) -> M.Decision:
  match scene.passages:
    case nil(_): finish({handler: state.handler, passage: state.passage, visited: state.visited, started: true, ended: true}, H.begin(state.handler))
    case cons(_): enter(indexed(scene.passages, 0n, 0n), state, H.begin(state.handler), context)
def start(scene: D.Scene, state: M.State, input: {}, context: Abi.Context) -> M.Decision:
  if state.started then refuse(state, "scene already started") else startPassages(scene, state, context)
def choose(scene: D.Scene, state: M.State, input: M.Choice, context: Abi.Context) -> M.Decision:
  if state.started && state.ended == false then choosePassage(scene, indexed(scene.passages, state.passage, 0n), state, input, context) else refuse(state, "choice unavailable")
def requirements(scene: D.Scene, state: M.State) -> Bool:
  condition(scene.requires, state.handler)
def itemMenu(item: D.Content, tail: D.Contents, index: Nat, state: M.State) -> M.Actions:
  match item:
    case prose(_): menu(tail, index, state)
    case effect(_): menu(tail, index, state)
    case choice(c): M.Actions.cons({head: M.Action.choice({key: c.choice.key, text: c.choice.text, command: "choose", input: {choice: index}, visible: condition(c.choice.condition, state.handler)}), tail: menu(tail, index + 1n, state)})
def menu(items: D.Contents, index: Nat, state: M.State) -> M.Actions:
  match items:
    case nil(_): M.Actions.nil()
    case cons(c): itemMenu(c.head, c.tail, index, state)
def passageMenu(found: M.FoundPassage, state: M.State) -> M.Actions:
  match found:
    case missing(_): M.Actions.nil()
    case found(c): menu(c.passage.content, 0n, state)
def actions(scene: D.Scene, state: M.State) -> M.Actions:
  if state.started == false then M.Actions.cons({head: M.Action.start({key: "start", text: "Start", command: "start", input: {}, visible: true}), tail: M.Actions.nil()}) else if state.ended then M.Actions.nil() else passageMenu(indexed(scene.passages, state.passage, 0n), state)
def validValue(value: K.Value) -> Bool:
  match value:
    case null(_): true
    case boolean(_): true
    case string(_): true
    case integer(c): c.value <= 18446744073709551615n
def validValues(values: K.Values) -> Bool:
  match values:
    case nil(_): true
    case cons(c): validValue(c.head) && validValues(c.tail)
def validComparison(value: K.Value, op: String) -> Bool:
  match value:
    case null(_): true
    case boolean(_): true
    case integer(c): validValue(value)
    case string(_): op == "eq" || op == "ne"
def validCondition(test: D.Condition) -> Bool:
  match test:
    case always(_): true
    case has(_): true
    case compare(c): (c.op == "eq" || c.op == "ne" || c.op == "lt" || c.op == "le" || c.op == "gt" || c.op == "ge") && validComparison(c.value, c.op)
    case negation(c): validCondition(c.condition)
    case conjunction(c): validCondition(c.left) && validCondition(c.right)
    case disjunction(c): validCondition(c.left) && validCondition(c.right)
def validEffect(item: D.Effect) -> Bool:
  match item:
    case set(c): validValue(c.value)
    case modify(c): if c.positive then c.magnitude <= 9223372036854775807n else c.magnitude <= 9223372036854775808n
    case call(c): validValues(c.args)
def validEffects(items: D.Effects) -> Bool:
  match items:
    case nil(_): true
    case cons(c): validEffect(c.head) && validEffects(c.tail)
def present(found: M.FoundPassage) -> Bool:
  match found:
    case missing(_): false
    case found(_): true
def validTarget(target: D.Target, passages: D.Passages) -> Bool:
  match target:
    case absent(_): true
    case named(c): c.isEnd || present(named(passages, c.name, 0n))
def validContent(item: D.Content, passages: D.Passages) -> Bool:
  match item:
    case prose(_): true
    case effect(c): validEffect(c.effect)
    case choice(c): validCondition(c.choice.condition) && validEffects(c.choice.effects) && validTarget(c.choice.target, passages)
def validContents(items: D.Contents, passages: D.Passages) -> Bool:
  match items:
    case nil(_): true
    case cons(c): validContent(c.head, passages) && validContents(c.tail, passages)
def contentCount(items: D.Contents) -> Nat:
  match items:
    case nil(_): 0n
    case cons(c): 1n + contentCount(c.tail)
def totalContent(passages: D.Passages) -> Nat:
  match passages:
    case nil(_): 0n
    case cons(c): contentCount(c.head.content) + totalContent(c.tail)
def passageCount(passages: D.Passages) -> Nat:
  match passages:
    case nil(_): 0n
    case cons(c): 1n + passageCount(c.tail)
def validPassages(passages: D.Passages, all: D.Passages) -> Bool:
  match passages:
    case nil(_): true
    case cons(c): present(named(c.tail, c.head.name, 0n)) == false && validContents(c.head.content, all) && validPassages(c.tail, all)
def validate(scene: D.Scene) -> M.Validation:
  let ok: Bool = passageCount(scene.passages) <= 32n && totalContent(scene.passages) <= 256n && validCondition(scene.requires) && validPassages(scene.passages, scene.passages)
  {valid: ok, reason: if ok then "" else "Scene requires unique known passages, supported i64 conditions/effects, and at most 32 passages/256 content items; string ordering is unsupported."}
def title(scene: D.Scene) -> String:
  if scene.title == "" then "Spween scene" else scene.title
def describe(scene: D.Scene) -> M.Description:
  {name: title(scene), initial: initial(), methods: {start: {label: "Start", fields: {}}, choose: {label: "Choose", fields: {choice: {type: "nat", minimum: 0n, maximum: 255n}}}}, panels: {}}
def proseItem(item: D.Content, result: M.Prose) -> M.Prose:
  match item:
    case prose(c): {text: if result.seen then textConcat(result.text, textConcat("\n\n", c.text)) else c.text, seen: true}
    case effect(_): result
    case choice(_): result
def prose(items: D.Contents, result: M.Prose) -> String:
  match items:
    case nil(_): result.text
    case cons(c): prose(c.tail, proseItem(c.head, result))
def passageProse(found: M.FoundPassage) -> String:
  match found:
    case missing(_): ""
    case found(c): prose(c.passage.content, {text: "", seen: false})
def view(scene: D.Scene, state: M.State, panel: String) -> M.View:
  {title: title(scene), prose: if state.started == false then "Start this shared scene." else if state.ended then "The scene has ended." else passageProse(indexed(scene.passages, state.passage, 0n)), actions: actions(scene, state), children: Encounter.Children.nil()}
extension Default(self: M.Behavior, super: {}) -> M.Behavior:
  {validate: fn(scene: D.Scene) -> M.Validation: validate(scene), describe: fn(scene: D.Scene) -> M.Description: describe(scene), start: fn(scene: D.Scene, state: M.State, input: {}, context: Abi.Context) -> M.Decision: start(scene, state, input, context), choose: fn(scene: D.Scene, state: M.State, input: M.Choice, context: Abi.Context) -> M.Decision: choose(scene, state, input, context), requirements: fn(scene: D.Scene, state: M.State) -> Bool: requirements(scene, state), view: fn(scene: D.Scene, state: M.State, panel: String) -> M.View: view(scene, state, panel)}
def behavior() -> M.Behavior:
  fix(Default, {})
