edition ObjectiveBend 1
import ./Kernel.obend as K
sum Condition:
  always: {}
  has: {category: String, key: String}
  compare: {name: String, op: String, value: K.Value}
  negation: {condition: Condition}
  conjunction: {left: Condition, right: Condition}
  disjunction: {left: Condition, right: Condition}
sum Effect:
  set: {name: String, value: K.Value}
  modify: {name: String, positive: Bool, magnitude: Nat}
  call: {name: String, args: K.Values}
sum Effects:
  nil: {}
  cons: {head: Effect, tail: Effects}
sum Target:
  absent: {}
  named: {name: String, isEnd: Bool}
record Choice:
  key: String
  text: String
  condition: Condition
  effects: Effects
  target: Target
sum Content:
  prose: {text: String}
  effect: {effect: Effect}
  choice: {choice: Choice}
sum Contents:
  nil: {}
  cons: {head: Content, tail: Contents}
record Passage:
  name: String
  content: Contents
sum Passages:
  nil: {}
  cons: {head: Passage, tail: Passages}
record Scene:
  title: String
  requires: Condition
  passages: Passages
