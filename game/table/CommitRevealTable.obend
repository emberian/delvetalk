edition ObjectiveBend 1
import ./Abi.obend as Abi
import ./Encounter.obend as E
import ./Preparation.obend as P
import ./Automatafl.obend as Game
import ./Validated.obend as Checked

record Seats:
  north: String
  south: String
record Configuration:
  table: String
  north: String
  south: String
record State:
  table: String
  seats: Seats
  round: Nat
  width: Nat
  height: Nat
  game: Game.Result
  commit0: String
  commit1: String
  revealed0: Bool
  revealed1: Bool
  source0: Nat
  target0: Nat
  source1: Nat
  target1: Nat
record Commit:
  round: Nat
  digest: String
record Opening:
  round: Nat
  source: Nat
  target: Nat
  nonce: String
record Round:
  round: Nat
record Decision:
  accepted: Bool
  reason: String
  state: State
  result: String

def initial(config: Configuration) -> State:
  {table: config.table, seats: {north: config.north, south: config.south}, round: 0n, width: 11n, height: 11n, game: {board: 3544482323287199997214430076569557050131592232587036428018782212697626882n, automaton: 60n, marks: 0n, status: 0n, winner: 0n}, commit0: "", commit1: "", revealed0: false, revealed1: false, source0: 0n, target0: 0n, source1: 0n, target1: 0n}

# Canonical framing is source-owned. Each field is its scalar length, colon, text.
# Every field is framed, including the domain. Naturals use canonical decimal.
def framed(text: String) -> String:
  textConcat(natText(textLength(text)), textConcat(":", text))
def commitment(table: String, round: Nat, seat: Nat, source: Nat, target: Nat, nonce: String) -> String:
  sha256Text(textConcat(framed("delvetalk.automatafl.commit.v2"), textConcat(framed(table), textConcat(framed(natText(round)), textConcat(framed(natText(seat)), textConcat(framed(natText(source)), textConcat(framed(natText(target)), framed(nonce))))))))
def hex(text: String) -> Bool:
  textLength(text) == 64n && textSpan(text, "0123456789abcdef") == 64n
def player(state: State, seat: Nat) -> String:
  if seat == 0n then state.seats.north else state.seats.south
def seated(state: State, principal: String) -> Bool:
  state.seats.north != "" && state.seats.south != "" && state.seats.north != state.seats.south && (principal == state.seats.north || principal == state.seats.south)
def live(state: State, round: Nat, context: Abi.Context) -> Bool:
  state.table == context.object && state.round == round && state.game.winner == 0n && seated(state, context.principal)
def refused(state: State) -> Decision:
  {accepted: false, reason: "precondition failed", state: state, result: ""}
def accepted(state: State, result: String) -> Decision:
  {accepted: true, reason: "", state: state, result: result}
def commit(state: State, input: Commit, context: Abi.Context, seat: Nat) -> Decision:
  let prior: String = if seat == 0n then state.commit0 else state.commit1
  if live(state, input.round, context) == false || context.principal != player(state, seat) || prior != "" || hex(input.digest) == false then refused(state) else accepted(if seat == 0n then extend(state, {commit0: input.digest}) else extend(state, {commit1: input.digest}), "committed")
def reveal(state: State, input: Opening, context: Abi.Context, seat: Nat) -> Decision:
  let prior: String = if seat == 0n then state.commit0 else state.commit1
  let opened: Bool = if seat == 0n then state.revealed0 else state.revealed1
  if live(state, input.round, context) == false || context.principal != player(state, seat) || state.commit0 == "" || state.commit1 == "" || opened || hex(input.nonce) == false then refused(state) else if commitment(context.object, state.round, seat, input.source, input.target, input.nonce) != prior then refused(state) else accepted(if seat == 0n then extend(state, {revealed0: true, source0: input.source, target0: input.target}) else extend(state, {revealed1: true, source1: input.source, target1: input.target}), "revealed")
def commit0(state: State, input: Commit, context: Abi.Context) -> Decision:
  commit(state, input, context, 0n)
def commit1(state: State, input: Commit, context: Abi.Context) -> Decision:
  commit(state, input, context, 1n)
def reveal0(state: State, input: Opening, context: Abi.Context) -> Decision:
  reveal(state, input, context, 0n)
def reveal1(state: State, input: Opening, context: Abi.Context) -> Decision:
  reveal(state, input, context, 1n)
def resolve(state: State, input: Round, context: Abi.Context) -> Decision:
  if live(state, input.round, context) == false || state.revealed0 == false || state.revealed1 == false then refused(state) else accepted(extend(state, {game: Checked.play(state.width, state.height, state.game.board, state.game.automaton, state.game.marks, state.source0, state.target0, state.source1, state.target1), round: state.round + 1n, commit0: "", commit1: "", revealed0: false, revealed1: false, source0: 0n, target0: 0n, source1: 0n, target1: 0n}), "resolved")

# Source chooses the grants; the native receiver still applies current law.
def principals(first: String, second: String, both: Bool) -> P.Value:
  P.Value.array({values: P.Values.cons({head: P.Value.text({value: first}), tail: if both then P.Values.cons({head: P.Value.text({value: second}), tail: P.Values.nil()}) else P.Values.nil()})})
def field(name: String, value: P.Value, tail: P.Fields) -> P.Fields:
  P.Fields.cons({head: {name: name, value: value}, tail: tail})
def authority(seats: Seats) -> P.Value:
  let north: P.Value = principals(seats.north, "", false)
  let south: P.Value = principals(seats.south, "", false)
  let both: P.Value = principals(seats.north, seats.south, true)
  let nobody: P.Value = P.Value.array({values: P.Values.nil()})
  let invoke: P.Value = P.Value.record({fields: field("commit0", north, field("reveal0", north, field("commit1", south, field("reveal1", south, field("resolve", both, P.Fields.nil())))))})
  P.Value.record({fields: field("profile", P.Value.text({value: "delvetalk-scoped-law"}), field("invoke", invoke, field("reprogram", nobody, field("law", nobody, P.Fields.nil()))))})


record CommitMethod:
  label: String
  fields: {round: Abi.NatField, digest: Abi.StringField}
record RevealMethod:
  label: String
  fields: {round: Abi.NatField, source: Abi.NatField, target: Abi.NatField, nonce: Abi.StringField}
record ResolveMethod:
  label: String
  fields: {round: Abi.NatField}
record Description:
  name: String
  initial: State
  methods: {commit0: CommitMethod, commit1: CommitMethod, reveal0: RevealMethod, reveal1: RevealMethod, resolve: ResolveMethod}
  panels: {result: String, custody: String, rules: String}
def rounds() -> Abi.NatField:
  {type: "nat", minimum: 0n, maximum: 9007199254740991n}
def cells() -> Abi.NatField:
  {type: "nat", minimum: 0n, maximum: 120n}
def digestField() -> Abi.StringField:
  {type: "string", minLength: 64n, maxLength: 64n}
def commitMethod() -> CommitMethod:
  {label: "Submit my retained commitment", fields: {round: rounds(), digest: digestField()}}
def revealMethod() -> RevealMethod:
  {label: "Open my retained move", fields: {round: rounds(), source: cells(), target: cells(), nonce: digestField()}}
def describe() -> Description:
  {name: "automatafl-two-player-table-v2", initial: initial({table: "", north: "north", south: "south"}), methods: {commit0: commitMethod(), commit1: commitMethod(), reveal0: revealMethod(), reveal1: revealMethod(), resolve: {label: "Resolve both opened moves", fields: {round: rounds()}}}, panels: {result: "Last result", custody: "Before choosing", rules: "The shared board"}}

record Action:
  visible: Bool
  text: String
  command: String
  input: Round
record View:
  title: String
  prose: String
  actions: {resolve: Action}
  children: E.Children
def phase(s: State) -> String:
  if s.game.winner == 1n then "North wins: the automaton reached a top corner. This match is finished." else if s.game.winner == 2n then "South wins: the automaton reached a bottom corner. This match is finished." else if s.commit0 == "" && s.commit1 == "" then "Both seats are choosing. Arrange private move custody with the operator before playing. Keep your source, destination and nonce out of public posts. Only a commitment is submitted first." else if s.commit0 == "" then "South has sealed a move. North still needs to seal privately. Neither opening should be submitted yet." else if s.commit1 == "" then "North has sealed a move. South still needs to seal privately. Neither opening should be submitted yet." else if s.revealed0 && s.revealed1 then "Both moves are open. Either seated player may resolve this round using the offered action." else if s.revealed0 then "North has opened. South may now submit the original opening through its retained private helper." else if s.revealed1 then "South has opened. North may now submit the original opening through its retained private helper." else "Both moves are sealed. Each player may now open the original move and nonce through the private helper. Openings become public when submitted."
def result(s: State) -> String:
  if s.game.status == 1n then "The last pair conflicted. The board stayed put; marked squares cannot be either endpoint in the new commitment round." else if s.game.status == 2n then "The last pair was invalid. The board stayed put. Choose a new pair and seal again." else if s.game.winner != 0n then "The match is finished. No further game action is offered." else "A completed resolution clears marks and lets the automaton take at most one step."
def view(s: State, panel: String) -> View:
  {title: if s.game.winner != 0n then "Automatafl · finished" else if s.revealed0 && s.revealed1 then "Automatafl · ready to resolve" else if s.commit0 != "" && s.commit1 != "" then "Automatafl · opening moves" else "Automatafl · choosing moves", prose: if panel == "result" then result(s) else if panel == "custody" then "This is a facilitated two-player match. The operator can see choices held in its private custody. Public town posts and PDS records are not a private move channel. Agree on an actual private handoff, or play an explicitly open rehearsal. No private handoff or automatic turn-taking is supplied by this card." else if panel == "rules" then "The original 11 by 11 opening is fixed. North aims for A1 or K1; South aims for A11 or K11. Both move the shared + attractor and - repulsor pieces, never @ directly. Empty sources are allowed. Choose distinct endpoints in one row or column, excluding @ and marked squares. The qualified Bend game settles paths, conflicts and the automaton's step. There is no forced opening or automatic timeout winner." else phase(s), actions: {resolve: {visible: s.game.winner == 0n && s.revealed0 && s.revealed1, text: "Resolve both opened moves", command: "resolve", input: {round: s.round}}}, children: E.Children.nil()}

record PrivateOffers:
  commit: Bool
  reveal: Bool
  resolve: Bool
  hint: String
def privateOffers(s: State, principal: String, seat: Nat, retainedDigest: String) -> PrivateOffers:
  let actor: Bool = seat <= 1n && seated(s, principal) && principal == player(s, seat)
  let sealed: String = if seat == 0n then s.commit0 else s.commit1
  let opened: Bool = if seat == 0n then s.revealed0 else s.revealed1
  let active: Bool = actor && s.game.winner == 0n
  let both: Bool = s.commit0 != "" && s.commit1 != ""
  let canOpen: Bool = active && both && opened == false && retainedDigest != "" && retainedDigest == sealed
  {commit: active && sealed == "", reveal: canOpen, resolve: active && s.revealed0 && s.revealed1, hint: if actor == false then "This principal does not hold this seat." else if active == false then "The game has finished." else if sealed == "" then "Seal your move; its opening stays in your private custody." else if both && opened == false && canOpen == false then "Your opening is unavailable here. Recover the original participant custody to reveal." else if canOpen then "Both moves are sealed. You can now open yours." else if s.revealed0 && s.revealed1 then "Both moves are open. Either seat can resolve the round." else if opened then "Waiting for the other seat to open its move." else "Waiting for the other seat to seal its move."}

record PrivateCommit:
  visible: Bool
  label: String
  command: String
  fields: {source: Abi.NatField, target: Abi.NatField}
record PrivateEmpty:
  visible: Bool
  label: String
  command: String
  fields: {}
record PrivateCard:
  actions: {commit: PrivateCommit, reveal: PrivateEmpty, resolve: PrivateEmpty}
  hint: String
def privateCard(s: State, principal: String, seat: Nat, retainedDigest: String) -> PrivateCard:
  let offers: PrivateOffers = privateOffers(s, principal, seat, retainedDigest)
  {actions: {commit: {visible: offers.commit, label: "Seal my move", command: if seat == 0n then "commit0" else "commit1", fields: {source: cells(), target: cells()}}, reveal: {visible: offers.reveal, label: "Open my sealed move", command: if seat == 0n then "reveal0" else "reveal1", fields: {}}, resolve: {visible: offers.resolve, label: "Resolve both moves", command: "resolve", fields: {}}}, hint: offers.hint}
